\subsection{\href{https://beta.lmfdb.org/knowledge/show/cmf.newform_subspace}{Newform subspace}}
\begin{definition}\label{cmf.newform_subspace}
\uses{cmf.newform,cmf.newspace}
The \textbf{newform subspace} of a \hyperref[cmf.newform]{newform} $f$ in $S_k^{\rm new}(N,\chi)$ is the subspace generated by the Galois conjugates of $f$.

Every \hyperref[cmf.newspace]{newspace} has a canonical decomposition into newform subspaces.
\end{definition}


