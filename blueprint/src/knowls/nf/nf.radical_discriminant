\subsection{\href{https://beta.lmfdb.org/knowledge/show/nf.radical_discriminant}{Radical discriminant of a number field}}
\begin{definition}\label{nf.radical_discriminant}
\uses{nf,nf.discriminant}
The \textbf{radical discriminant} of a \hyperref[nf]{number field} $K$ is the product of the primes dividing the \hyperref[nf.discriminant]{discriminant} of $K$, i.e. the product of the primes which ramify in $K$.

\end{definition}


