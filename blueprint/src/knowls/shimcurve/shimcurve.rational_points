\subsection{\href{https://beta.lmfdb.org/knowledge/show/shimcurve.rational_points}{Rational points on a Shimura curve}}
\begin{definition}\label{shimcurve.rational_points}
\uses{ag.jacobian,ec,shimcurve.genus}
\leanok
\hyperref[shimcurve.genus]{Genus} zero curves with a rational point are isomorphic to $\mathbb{P}^1$ and therefore have infinitely many rational points. Genus one curves with a rational point whose \hyperref[ag.jacobian]{Jacobian} has positive Mordell-Weil rank are isomorphic to an \hyperref[ec]{elliptic curve} with infinitely many rational points. In all other cases, the set of rational points is finite.
\end{definition}


