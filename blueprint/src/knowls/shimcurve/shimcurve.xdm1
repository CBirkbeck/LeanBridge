\subsection{\href{https://beta.lmfdb.org/knowledge/show/shimcurve.xdm1}{$X(D,M;1)$}}
\begin{definition}\label{shimcurve.xdm1}
\uses{shimcurve,shimcurve.aut_pm_mu_o,shimcurve.discb,shimcurve.eichler,shimcurve.polarized_order,shimcurve.quaternion_algebra}
\leanok
Let $(O,\mu)$ be a \hyperref[shimcurve.polarized_order]{polarized quaternion order} in an indefinite division
\hyperref[shimcurve.quaternion_algebra]{quaternion algebra} that is \hyperref[shimcurve.eichler]{Eichler} of level $M$
over $\Q$ of \hyperref[shimcurve.discb]{discriminant} $D$. $X(D,M;1)$ is the \hyperref[shimcurve]{Shimura curve} corresponding to $H=\{1\}\leq$ \hyperref[shimcurve.aut_pm_mu_o]{$\Aut_{\pm\mu}(O)$} $\ltimes \widehat{O}^\times$. 
\end{definition}


