\subsection{\href{https://beta.lmfdb.org/knowledge/show/shimcurve.aut_pm_mu_o}{$\Aut_{\pm\mu}(O)$}}
\begin{definition}\label{shimcurve.aut_pm_mu_o}
\uses{shimcurve.polarized_order,shimcurve.quaternion_algebra}
Let $(O,\mu)$ be a \hyperref[shimcurve.polarized_order]{polarized quaternion order} in an indefinite division
\hyperref[shimcurve.quaternion_algebra]{quaternion algebra}
over $\Q$. Let $N_{B^{\times}}(O)=\{\gamma\in B^{\times}:\gamma^{-1}O\gamma=O\}$ be the normalizer of $O$ in $B$. Then the \textbf{automorphisms of $O$ preserving the polarization $\mu$ (up to sign)} is defined by $\Aut_{\pm\mu}(O)=\{\gamma\in N_{B^{\times}}(O)/\Q^{\times}:\gamma^{-1}\mu\gamma=\pm\mu\}$.  
\end{definition}


