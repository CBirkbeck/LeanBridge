\subsection{\href{https://beta.lmfdb.org/knowledge/show/lattice.dimension}{Rank of an integral lattice}}
\begin{definition}\label{lattice.dimension}
\uses{lattice.definition}
The \textbf{rank} of an \hyperref[lattice.definition]{integral lattice} is the rank of its underlying free $\Z$-module. 
\end{definition}


