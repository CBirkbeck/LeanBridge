\subsection{\href{https://beta.lmfdb.org/knowledge/show/lattice.sublattice}{Sublattice}}
\begin{definition}\label{lattice.sublattice}
\uses{lattice.definition,lattice.gram,lattice.minimal_vector,lattice.norm}
Given an \hyperref[lattice.definition]{integral lattice} $L$, a \textbf{sublattice} of $L$ is a subgroup $M \subseteq L$ which is itself a lattice.

There are several special named sublattices of $L$:

\begin{itemize}
\item  \textbf{Norm 1 sublattice} - the sublattice generated by vecotrs of \hyperref[lattice.norm]{norm} $1$.
\item  \textbf{Root sublattice} - the sublattice generated by all vectors of norm $2$.
\item  \textbf{Min vector sublattice} - the sublattice generated by all \hyperref[lattice.minimal_vector]{minimal vectors}.
\item  \textbf{Even sublattice} - the sublattice generated by vectors of even norm.
\item  \textbf{Max diag sublattice} - the maximal sublattice whose \hyperref[lattice.gram]{Gram matrix} is diagonal.
\end{itemize}

\end{definition}


