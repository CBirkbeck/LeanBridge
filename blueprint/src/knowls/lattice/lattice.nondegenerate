\subsection{\href{https://beta.lmfdb.org/knowledge/show/lattice.nondegenerate}{Nondegenerate lattice}}
\begin{definition}\label{lattice.nondegenerate}
\uses{lattice.definition,lattice.gram}
An \hyperref[lattice.definition]{integral lattice} $L$ with bilinear form $B$ is \textbf{nondegenerate} if
\[
\{w \in L : B(v, w) = 0 \text{ for all } v \in L\} = 0.
\]
Otherwise, we call $L$ degenerate.  All lattices in the database are nondegenerate, but some definitions require degenerate lattices.  In particular, the \textbf{signature} of a (possibly degenerate) lattice is a triple $(n_+, n_0, n_-)$ where $n_+$ and $n_-$ are as in the standard \hyperref[lattice.signature]{signature} and $n_0$ is the number of $0$ eigenvalues for a \hyperref[lattice.gram]{Gram matrix}.  A lattice is degenerate if and only if $n_0 > 0$.  We say $L$ is \textbf{positive semidefinite} if $n_-=0$.
\end{definition}


