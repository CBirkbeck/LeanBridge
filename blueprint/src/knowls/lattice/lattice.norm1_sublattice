\subsection{\href{https://beta.lmfdb.org/knowledge/show/lattice.norm1_sublattice}{Norm 1 sublattice}}
\begin{definition}\label{lattice.norm1_sublattice}
\uses{lattice.definition,lattice.norm,lattice.parity,lattice.sublattice}
Given an \hyperref[lattice.definition]{integral lattice} $L$, the \textbf{norm 1 sublattice} is the \hyperref[lattice.sublattice]{sublattice} of $L$ generated by all vectors of \hyperref[lattice.norm]{norm} 1 in $L$.

If $L$ is \hyperref[lattice.parity]{even}, then the norm 1 sublattice is trivial.  If $L =I_n$, then the norm 1 sublattice is the lattice $I_n$ itself.
\end{definition}


