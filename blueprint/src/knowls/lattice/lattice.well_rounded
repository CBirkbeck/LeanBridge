\subsection{\href{https://beta.lmfdb.org/knowledge/show/lattice.well_rounded}{Well-rounded lattice}}
\begin{definition}\label{lattice.well_rounded}
\uses{lattice.minimal_vector}
A lattice $L$ is called \textbf{well-rounded} if its set of \hyperref[lattice.minimal_vector]{minimal vectors} $S(L)$ spans a sublattice $M$ of finite index, and $L$ is said to be \textbf{generated by minimal vectors} if $M = L$. The lattice $L$ is \textbf{strongly well-rounded} if the set $S(L)$ contains a basis for $L$. Being generated by minimal vectors is a strictly stronger condition than well-rounded for lattices of rank $\geq 5$, and a strictly weaker condition than strongly well-rounded for lattices of rank $\geq 10$.
\end{definition}


