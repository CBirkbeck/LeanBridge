\subsection{\href{https://beta.lmfdb.org/knowledge/show/lattice.positive_definite}{Positive definite lattice}}
\begin{definition}\label{lattice.positive_definite}
\uses{lattice.definition,lattice.gram}
An \hyperref[lattice.definition]{integral lattice} $L$ is \textbf{positive definite} if the \hyperref[lattice.gram]{Gram matrix} of the bilinear form $B$ on $L$ is a positive definite matrix. This is equivalent to the condition that $B(u,u)>0$ for all $u \in L \setminus\{0\}$.

The \hyperref[lattice.signature]{signature} of a rank $n$ positive definite integral lattice is $(n, 0)$.
\end{definition}


