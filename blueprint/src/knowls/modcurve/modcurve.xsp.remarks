\subsection{\href{https://beta.lmfdb.org/knowledge/show/modcurve.xsp.remarks}{Remarks on $X_{\mathrm{sp}}(N)$}}
\begin{definition}\label{modcurve.xsp.remarks}
\uses{ag.hyperelliptic_curve}
\leanok
\hyperref[ag.hyperelliptic_curve]{Hyperelliptic curves}:
The modular curve $X_{\mathrm{sp}}(N)$ is isomorphic to $X_0(N^2)$ \cite{https://doi.org/10.1112/S0024611598000392, MR:1625491}.
There are no hyperelliptic curves in this family   \cite{doi:10.24033/bsmf.1789, MR:0364259}.
\end{definition}


