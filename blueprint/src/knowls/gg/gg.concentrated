\subsection{\href{https://beta.lmfdb.org/knowledge/show/gg.concentrated}{Concentrated group}}
\begin{definition}\label{gg.concentrated}
\uses{gg.index,group,group.proper_subgroup}
A transitive permutation \hyperref[group]{group} $G$ is \textbf{concentrated} if the subgroup of $G$ generated by all elements of minimal \hyperref[gg.index]{index} is a \hyperref[group.proper_subgroup]{proper} subgroup of $G$.
\end{definition}


