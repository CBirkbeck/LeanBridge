import TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Point.InfiniteOrder
import TauCeti.AlgebraicGeometry.EllipticCurve.DivisionPolynomial.Torsion.WorkedExamples
import TauCeti.AlgebraicGeometry.EllipticCurve.IntegralReduction
import TauCeti.AlgebraicGeometry.EllipticCurve.PointCount

/-!
# The torsion subgroup of 11.a3, computed by reduction

The elliptic curve with LMFDB label 11.a3 is `E : y² + y = x³ - x²`, the integral Weierstrass
equation `[0, -1, 1, 0, 0]` of discriminant `-11`, Tau Ceti's `TauCeti.WorkedExamples.curve11a3`.
This file computes its rational torsion subgroup by reduction modulo primes, as an explicit example
of how the reduction map computes torsion subgroups (LeanBridge issue #21): `E(ℚ)_tors` is cyclic of
order `5`, generated by `(0, 0)`.

The primes `2` and `3` do not divide `-11`, so `E` has good reduction at both, and the reduced
curves have `5` points each over `𝔽₂` and over `𝔽₃`, the point at infinity included (the instances
that they are elliptic, and the point counts, are checked by `decide`). At a prime `p` of good
reduction, reduction is injective on the torsion of order prime to `p` (Tau Ceti's
`WeierstrassCurve.Affine.Point.injOn_reductionHom_torsionBy`), and this is used at both primes, in
two forms.

* At `3`: a prime `ℓ ≠ 3` dividing the order of a torsion point divides the order of its reduction
  (`WeierstrassCurve.Affine.Point.dvd_addOrderOf_reductionHom`), which divides `#E(𝔽₃) = 5`. So no
  torsion point has even order.
* At `2`: for odd `n`, `E(ℚ)[n]` injects into `E(𝔽₂)`, so `#E(ℚ)[n]` divides `#E(𝔽₂) = 5`
  (`WeierstrassCurve.Affine.Point.card_torsionBy_dvd_card_reduction`).

A torsion point therefore has odd order `n`, and `n` divides `#E(ℚ)[n]`, hence `5`. So `E(ℚ)_tors`
is `E(ℚ)[5]`, which has at most `5` points. The point `(0, 0)` has order `5` (Tau Ceti's
`TauCeti.WorkedExamples.addOrderOf_curve11a3Point`, computed with the group law), so it generates
`E(ℚ)_tors`. Tau Ceti proves the same result with the Nagell–Lutz theorem
(`TauCeti.WorkedExamples.torsion_curve11a3_eq_zmultiples`); the proof here does not use it.

## Main results

* `LeanBridge.Curve11a3.card_point_zmod_two` and `LeanBridge.Curve11a3.card_point_zmod_three`: the
  reductions of `E` modulo `2` and `3` have `5` points.
* `LeanBridge.Curve11a3.not_two_dvd_addOrderOf`: by reduction modulo `3`, a torsion point has odd
  order.
* `LeanBridge.Curve11a3.card_torsionBy_dvd_five`: by reduction modulo `2`, `#E(ℚ)[n]` divides `5`
  for odd `n`.
* `LeanBridge.Curve11a3.torsion_eq_zmultiples`: `E(ℚ)_tors` is generated by `(0, 0)`.
* `LeanBridge.Curve11a3.card_torsion`: `E(ℚ)_tors` has `5` points.
* `LeanBridge.Curve11a3.nonempty_torsion_addEquiv_zmod_five`: `E(ℚ)_tors` is cyclic of order `5`.
-/

open AddSubgroup IsDedekindDomain TauCeti.WorkedExamples WeierstrassCurve Affine

namespace LeanBridge.Curve11a3

variable {P : (curve11a3.baseChange ℚ).toAffine.Point} (hP : IsOfFinAddOrder P)

instance : (curve11a3.map (Int.castRingHom (ZMod 2))).IsElliptic :=
  ⟨by decide⟩

instance : (curve11a3.map (Int.castRingHom (ZMod 3))).IsElliptic :=
  ⟨by decide⟩

lemma card_point_zmod (p : ℕ) [Fact p.Prime]
    [(curve11a3.map (Int.castRingHom (ZMod p))).IsElliptic] : Nat.card (curve11a3.map
    (Int.castRingHom (ZMod p))).toAffine.Point = Fintype.card {xy : ZMod p × ZMod p // xy.2 ^ 2 +
    xy.2 = xy.1 ^ 3 - xy.1 ^ 2} + 1 := by
  rw [← pointCount_eq_card_point, pointCount_def, ← Nat.card_eq_fintype_card]
  simp [equation_iff, sub_eq_add_neg]

/-- **The reduction of 11.a3 modulo `2` has `5` points**, the point at infinity included: all four
points of `𝔽₂ × 𝔽₂` satisfy `y² + y = x³ - x²`. -/
lemma card_point_zmod_two :
    Nat.card (curve11a3.map (Int.castRingHom (ZMod 2))).toAffine.Point = 5 := by
  rw [card_point_zmod]
  decide

/-- **The reduction of 11.a3 modulo `3` has `5` points**, the point at infinity included: the
affine points are `(x, y)` with `x ∈ {0, 1}` and `y ∈ {0, 2}`. -/
lemma card_point_zmod_three :
    Nat.card (curve11a3.map (Int.castRingHom (ZMod 3))).toAffine.Point = 5 := by
  rw [card_point_zmod]
  decide

include hP in
/-- **Reduction modulo `3`: a rational torsion point of 11.a3 has odd order.** Reduction modulo `3`
keeps the prime `2` of the order of a torsion point, but the reduced point is killed by
`#E(𝔽₃) = 5`. -/
lemma not_two_dvd_addOrderOf : ¬2 ∣ addOrderOf P := by
  classical
  let v : HeightOneSpectrum ℤ := .ofPrime <| Ideal.prime_span_singleton_iff.mpr Int.prime_three
  have : (integralModel (v.valuation ℚ).valuationSubring (curve11a3.baseChange ℚ)).IsElliptic :=
    curve11a3.isElliptic_integralModel_baseChange v <| Ideal.mem_span_singleton.not.mpr <| by decide
  exact fun h2 ↦ (by decide : ¬2 ∣ 5) <| (Point.dvd_addOrderOf_reductionHom v hP Nat.prime_two
    (Ideal.mem_span_singleton.not.mpr (by decide)) h2).trans <| addOrderOf_dvd_of_nsmul_eq_zero <|
    card_point_zmod_three ▸ curve11a3.card_nsmul_reductionHom_baseChange_eq_zero v 3 rfl P

/-- **Reduction modulo `2`: for odd `n`, the order of the `n`-torsion subgroup of 11.a3 divides
`5`**, since that subgroup injects into the `5` points of the reduction modulo `2`. -/
lemma card_torsionBy_dvd_five {n : ℕ} (hn : ¬2 ∣ n) :
    Nat.card (torsionBy (curve11a3.baseChange ℚ).toAffine.Point n) ∣ 5 := by
  classical
  let v : HeightOneSpectrum ℤ := .ofPrime <| Ideal.prime_span_singleton_iff.mpr Int.prime_two
  have : (integralModel (v.valuation ℚ).valuationSubring (curve11a3.baseChange ℚ)).IsElliptic :=
    curve11a3.isElliptic_integralModel_baseChange v <| Ideal.mem_span_singleton.not.mpr <| by decide
  rw [← card_point_zmod_two, ← curve11a3.card_point_reduction_baseChange v 2 rfl]
  exact Point.card_torsionBy_dvd_card_reduction v <| Ideal.mem_span_singleton.not.mpr <| by
    exact_mod_cast hn

include hP in
lemma five_nsmul_eq_zero : 5 • P = 0 := by
  rw [← addOrderOf_dvd_iff_nsmul_eq_zero, ← Nat.card_zmultiples]
  exact (card_dvd_of_le <| zmultiples_le.mpr <| torsionBy.nsmul_iff.mpr <|
    addOrderOf_nsmul_eq_zero P).trans <| card_torsionBy_dvd_five <| not_two_dvd_addOrderOf hP

/-- **The rational torsion subgroup of 11.a3 is generated by `(0, 0)`**, a point of order `5`. -/
lemma torsion_eq_zmultiples :
    AddCommGroup.torsion (curve11a3.baseChange ℚ).toAffine.Point = zmultiples curve11a3Point := by
  have h5 : Nat.card (torsionBy (curve11a3.baseChange ℚ).toAffine.Point 5) ∣ 5 :=
    card_torsionBy_dvd_five (by decide)
  have : Finite (torsionBy (curve11a3.baseChange ℚ).toAffine.Point 5) :=
    Nat.finite_of_card_ne_zero <| ne_zero_of_dvd_ne_zero (by decide) h5
  have h : zmultiples curve11a3Point = torsionBy (curve11a3.baseChange ℚ).toAffine.Point 5 := by
    refine eq_of_le_of_card_ge (zmultiples_le.mpr <| torsionBy.nsmul_iff.mpr
      five_nsmul_curve11a3Point) ?_
    rw [Nat.card_zmultiples, addOrderOf_curve11a3Point]
    exact Nat.le_of_dvd (by decide) h5
  exact le_antisymm (fun Q hQ ↦ h.ge <| torsionBy.nsmul_iff.mpr <| five_nsmul_eq_zero hQ) <|
    zmultiples_le.mpr <| isOfFinAddOrder_iff_nsmul_eq_zero.mpr
    ⟨5, by decide, five_nsmul_curve11a3Point⟩

/-- **The rational torsion subgroup of 11.a3 has `5` points.** -/
lemma card_torsion : Nat.card (AddCommGroup.torsion (curve11a3.baseChange ℚ).toAffine.Point) = 5 :=
  torsion_eq_zmultiples ▸ (Nat.card_zmultiples _).trans addOrderOf_curve11a3Point

/-- **The rational torsion subgroup of 11.a3 is cyclic of order `5`.** -/
lemma nonempty_torsion_addEquiv_zmod_five :
    Nonempty (AddCommGroup.torsion (curve11a3.baseChange ℚ).toAffine.Point ≃+ ZMod 5) :=
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  ⟨card_torsion ▸ (zmodAddCyclicAddEquiv (isAddCyclic_of_prime_card card_torsion)).symm⟩

end LeanBridge.Curve11a3
