import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# Homogeneous ideals of polynomial rings over a not necessarily commutative ring

A ring in the sense of the LMFDB (LMFDB `ring`) need not be commutative, and an ideal of a ring
`A` (LMFDB `ring.ideal`) is a two-sided ideal: an additive subgroup `I` of `A` with `r a ∈ I` and
`a r ∈ I` for all `a ∈ I` and `r ∈ A`, Mathlib's `TwoSidedIdeal A`. The polynomial ring
`R[X_i : i ∈ σ]` in commuting variables over such a ring `R` is the monoid algebra
`AddMonoidAlgebra R (σ →₀ ℕ)` of the monomials, of which Mathlib's `MvPolynomial σ R` is the case
of a commutative `R`; the LMFDB's `R[X_1, …, X_n]` is the case `σ = Fin n`. A polynomial is
homogeneous of degree `n` if all its monomials have total degree `n`, and an ideal of the
polynomial ring is homogeneous if it is generated by homogeneous polynomials.

This file defines, for a ring `A` and a family `𝒜` of subsets of `A` whose members are the
homogeneous elements of each degree, the two-sided ideals generated by homogeneous elements, and
the homogeneous polynomials of each degree in `R[X_i : i ∈ σ]`. For a commutative ring `A` graded
by `𝒜`, a two-sided ideal is generated by homogeneous elements exactly when the corresponding
ideal is homogeneous in Mathlib's sense (`Ideal.IsHomogeneous`: it contains the homogeneous
components of its elements). In particular, for a commutative ring `R` the definition is Mathlib's
for `MvPolynomial σ R` graded by degree.

## Main definitions

* `TwoSidedIdeal.IsHomogeneous` (LMFDB `ring.ideal`): a two-sided ideal generated by homogeneous
  elements.
* `AddMonoidAlgebra.homogeneousSubmodule` (LMFDB `ring.ideal`): the homogeneous polynomials of
  degree `n` in the polynomial ring `R[X_i : i ∈ σ]` over a ring `R`.

## Main results

* `TwoSidedIdeal.isHomogeneous_iff_isHomogeneous_asIdeal`: over a commutative graded ring, a
  two-sided ideal is generated by homogeneous elements exactly when it is a homogeneous ideal.
* `TwoSidedIdeal.isHomogeneous_homogeneousSubmodule_iff` (LMFDB `ring.ideal`): for a commutative
  ring `R`, a two-sided ideal of `R[X_i : i ∈ σ]` is generated by homogeneous polynomials exactly
  when it is a homogeneous ideal of `MvPolynomial σ R`.
-/

open SetLike

open scoped AddMonoidAlgebra

namespace AddMonoidAlgebra

variable (R σ : Type*) [Semiring R]

/-- The **homogeneous polynomials of degree `n`** (LMFDB `ring.ideal`) in the polynomial ring
`R[X_i : i ∈ σ] = AddMonoidAlgebra R (σ →₀ ℕ)` over a not necessarily commutative semiring `R`:
the polynomials all of whose monomials have total degree `n`. For `R` commutative this is
Mathlib's `MvPolynomial.homogeneousSubmodule σ R n`
(`AddMonoidAlgebra.homogeneousSubmodule_eq`). -/
noncomputable abbrev homogeneousSubmodule (n : ℕ) : Submodule R R[σ →₀ ℕ] :=
  supported R R {d : σ →₀ ℕ | d.degree = n}

lemma one_mem_homogeneousSubmodule : (1 : R[σ →₀ ℕ]) ∈ homogeneousSubmodule R σ 0 := by
  rw [mem_supported', one_def]
  intro d hd
  rw [coeff_single, Finsupp.single_eq_of_ne]
  rintro rfl
  exact hd (map_zero _)

lemma homogeneousSubmodule_eq {R : Type*} [CommSemiring R] :
    homogeneousSubmodule R σ = MvPolynomial.homogeneousSubmodule σ R :=
  funext fun n ↦ (MvPolynomial.homogeneousSubmodule_eq_finsupp_supported σ R n).symm

end AddMonoidAlgebra

namespace TwoSidedIdeal

section Ring

variable {ι B A : Type*} [Ring A] [SetLike B A] (𝒜 : ι → B)

/-- A two-sided ideal `I` of a ring `A` is **homogeneous** (LMFDB `ring.ideal`) for a family `𝒜` of
subsets of `A`, whose members are the homogeneous elements of each degree, if it is generated as a
two-sided ideal by homogeneous elements. For the polynomial ring `R[X_i : i ∈ σ]` over a ring `R`
graded by degree, `𝒜` is `AddMonoidAlgebra.homogeneousSubmodule R σ`. -/
def IsHomogeneous (I : TwoSidedIdeal A) : Prop :=
  ∃ S : Set A, (∀ x ∈ S, IsHomogeneousElem 𝒜 x) ∧ I = span S

lemma isHomogeneous_span {S : Set A} (hS : ∀ x ∈ S, IsHomogeneousElem 𝒜 x) :
    (span S).IsHomogeneous 𝒜 :=
  ⟨S, hS, rfl⟩

lemma isHomogeneous_bot : (⊥ : TwoSidedIdeal A).IsHomogeneous 𝒜 :=
  ⟨∅, fun _ h ↦ h.elim, (le_bot_iff.mp (span_le.mpr (Set.empty_subset _))).symm⟩

lemma isHomogeneous_top {R σ : Type*} [Ring R] :
    (⊤ : TwoSidedIdeal R[σ →₀ ℕ]).IsHomogeneous (AddMonoidAlgebra.homogeneousSubmodule R σ) := by
  refine ⟨{1}, fun x hx ↦ ⟨0, hx ▸ AddMonoidAlgebra.one_mem_homogeneousSubmodule R σ⟩, ?_⟩
  exact (eq_top_iff.mpr fun x _ ↦ by
    simpa using mul_mem_left _ x 1 (subset_span (Set.mem_singleton 1))).symm

end Ring

section CommRing

variable {ι B A : Type*} [CommRing A] [SetLike B A] [AddSubmonoidClass B A] (𝒜 : ι → B)
  [DecidableEq ι] [AddMonoid ι] [GradedRing 𝒜]

lemma asIdeal_span (S : Set A) : (span S).asIdeal = Ideal.span S := by
  refine le_antisymm (fun x hx ↦ ?_) (Ideal.span_le.mpr fun x hx ↦ mem_asIdeal.mpr (subset_span hx))
  have h : span S ≤ (Ideal.span S).toTwoSided :=
    span_le.mpr fun y hy ↦ Ideal.mem_toTwoSided.mpr (Ideal.subset_span hy)
  exact Ideal.mem_toTwoSided.mp (h (mem_asIdeal.mp hx))

open Ideal IsHomogeneous in
/-- **Over a commutative graded ring, the two-sided ideals generated by homogeneous elements are
the homogeneous ideals**: a two-sided ideal is generated by homogeneous elements exactly when the
corresponding ideal (`TwoSidedIdeal.orderIsoIdeal`) contains the homogeneous components of its
elements. -/
lemma isHomogeneous_iff_isHomogeneous_asIdeal (I : TwoSidedIdeal A) :
    I.IsHomogeneous 𝒜 ↔ I.asIdeal.IsHomogeneous 𝒜 := by
  refine ⟨fun ⟨S, hS, hI⟩ ↦ ?_, fun h ↦ ?_⟩
  · rw [hI, asIdeal_span]
    exact homogeneous_span 𝒜 S hS
  rcases (iff_exists 𝒜 _).mp h with ⟨S, hS⟩
  refine ⟨(↑) '' S, fun _ ⟨x, _, hx⟩ ↦ hx ▸ x.2, ?_⟩
  ext x
  rw [← mem_asIdeal, hS, ← asIdeal_span, mem_asIdeal]

end CommRing

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **Homogeneous ideals of polynomial rings over a commutative ring** (LMFDB `ring.ideal`): for a
commutative ring `R`, a two-sided ideal of `R[X_i : i ∈ σ]` is generated by homogeneous polynomials
exactly when it is a homogeneous ideal of `MvPolynomial σ R` in Mathlib's sense, which contains the
homogeneous components of its elements. -/
lemma isHomogeneous_homogeneousSubmodule_iff {R σ : Type*} [CommRing R]
    (I : TwoSidedIdeal (MvPolynomial σ R)) :
    I.IsHomogeneous (AddMonoidAlgebra.homogeneousSubmodule R σ) ↔
      I.asIdeal.IsHomogeneous (MvPolynomial.homogeneousSubmodule σ R) := by
  rw [AddMonoidAlgebra.homogeneousSubmodule_eq, isHomogeneous_iff_isHomogeneous_asIdeal]

end TwoSidedIdeal
