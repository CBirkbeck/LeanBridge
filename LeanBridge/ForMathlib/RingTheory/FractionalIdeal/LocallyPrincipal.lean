import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.RingTheory.FractionalIdeal.Basic

/-!
# Fractional ideals that are locally principal at a prime

Let `R` be an order in an étale algebra `K` and `I` a fractional `R`-ideal. For every prime `𝔓` of
`R`, the quotient `I / 𝔓I` is a vector space over the residue field `R / 𝔓`; its dimension is `1`
if and only if the localisation `I_𝔓` is a principal `R_𝔓`-ideal, and `I` is invertible if and only
if it is locally principal at every prime.

## Main definitions

* `Submodule.IsLocallyPrincipalAt` (LMFDB `av.fq.singular_dimensions`).
* `Submodule.residueFinrank`: the dimension of `I / 𝔓I` over `R / 𝔓`.

## Main results

* `FractionalIdeal.isLocallyPrincipalAt_of_isUnit`: an invertible fractional ideal is locally
  principal at every proper ideal.
-/

open Submodule

namespace Submodule

variable {R K : Type*} [CommRing R] [CommRing K] [Algebra R K] (I : Submodule R K) (𝔓 : Ideal R)

/-- An `R`-submodule `I` of an `R`-algebra `K`, such as a fractional `R`-ideal, is **locally
principal** at an ideal `𝔓` of `R` (LMFDB `av.fq.singular_dimensions`) if there is `x ∈ I` such that
every `y ∈ I` has a multiple `s y ∈ R x` by some `s ∈ R ∖ 𝔓`.

When `𝔓` is prime, this says that the localisation `I_𝔓` of `I` at `𝔓` is the principal
`R_𝔓`-submodule generated by `x` (not formalised here): `I_𝔓 = R_𝔓 x` means that every `y ∈ I` is
`(r / s) x` in `I_𝔓`, that is `u (s y - r x) = 0` for some `u ∉ 𝔓`, and a generator of `I_𝔓` can be
taken in `I` up to a unit of `R_𝔓`. This element-wise form avoids localised modules. -/
def IsLocallyPrincipalAt : Prop :=
  ∃ x ∈ I, ∀ y ∈ I, ∃ s ∉ 𝔓, s • y ∈ R ∙ x

/-- The **dimension** of `I / 𝔓I` over `R / 𝔓` for an `R`-submodule `I` of an `R`-algebra `K`, such
as a fractional `R`-ideal, and an ideal `𝔓` of `R`. The LMFDB records it for the singular primes
`𝔓` of an order `R` (LMFDB `av.fq.singular_dimensions`); it is `1` if and only if `I` is locally
principal at `𝔓` (`Submodule.IsLocallyPrincipalAt`, not formalised here). -/
noncomputable def residueFinrank : ℕ :=
  Module.finrank (R ⧸ 𝔓) (I ⧸ 𝔓 • (⊤ : Submodule R I))

end Submodule

namespace FractionalIdeal

variable {R K : Type*} [CommRing R] [CommRing K] [Algebra R K] [IsFractionRing R K] {𝔓 : Ideal R}

/-- An **invertible** fractional ideal `I`, a unit of the monoid of fractional ideals (LMFDB
`av.fq.singular_dimensions`), is locally principal at every proper ideal `𝔓`. The converse, for
fractional ideals of an order, is not formalised here. -/
lemma isLocallyPrincipalAt_of_isUnit {I : FractionalIdeal (nonZeroDivisors R) K} (hI : IsUnit I)
    (h𝔓 : 𝔓 ≠ ⊤) : (I : Submodule R K).IsLocallyPrincipalAt 𝔓 := by
  rcases hI.exists_right_inv with ⟨J, hJ⟩
  have hmem :
      ∀ x ∈ (I : Submodule R K), ∀ y ∈ (J : Submodule R K), ∃ r : R, algebraMap R K r = x * y :=
    fun x hx y hy ↦
      mem_one.mp <| by rw [← coe_one, ← hJ, coe_mul]; exact Submodule.mul_mem_mul hx hy
  refine by_contra fun hn ↦ h𝔓 <| (Ideal.eq_top_iff_one 𝔓).mpr ?_
  have hle : (I : Submodule R K) * J ≤ Submodule.map (Algebra.linearMap R K) 𝔓 :=
    Submodule.mul_le.mpr fun x hx y hy ↦ by
      rcases hmem x hx y hy with ⟨r, hr⟩
      refine ⟨r, by_contra fun hr𝔓 ↦ hn ⟨x, hx, fun z hz ↦ ⟨r, hr𝔓, ?_⟩⟩, hr⟩
      rcases hmem z hz y hy with ⟨t, ht⟩
      exact mem_span_singleton.mpr ⟨t, by rw [Algebra.smul_def, Algebra.smul_def, ht, hr]; ring1⟩
  have h1 : (1 : K) ∈ (I : Submodule R K) * J := by
    rw [← coe_mul, hJ, coe_one]
    exact mem_one.mpr ⟨1, map_one _⟩
  rcases Submodule.mem_map.mp (hle h1) with ⟨p, hp, hp1⟩
  rwa [IsFractionRing.injective R K (hp1.trans (map_one _).symm)] at hp

end FractionalIdeal
