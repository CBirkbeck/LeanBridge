import Mathlib.Analysis.AbsoluteValue.Equivalence
import Mathlib.Analysis.Normed.Field.WithAbs
import TauCeti.RingTheory.DedekindDomain.Factorization

/-!
# The completion of a fraction field for the metric of an adic absolute value

Let `R` be a Dedekind domain with fraction field `K`, `v` a height-one prime `𝔓` of `R`, and `b > 1`
a real number. For `x ∈ Kˣ` let `v_𝔓(x)` be the exponent of `𝔓` in the factorization of the
fractional ideal `⟨x⟩`. Mathlib's absolute value `|x| = b ^ (-v_𝔓(x))`
(`IsDedekindDomain.HeightOneSpectrum.adicAbv`) defines the metric `d(x, y) = b ^ (-v_𝔓(x - y))` on
`K`, and this metric defines the topology of the `𝔓`-adic valuation, whatever `b`: the balls around
`0` and the sets `{x | v(x) < γ}`, `γ ≠ 0`, are sets of the form `{x | |x| < |c|}`, `c ≠ 0`, up to
inclusion. So the identity of `K` is a uniform equivalence between `K` with the metric `d` and `K`
with the `𝔓`-adic valuation, and it extends to an isomorphism of topological fields between the
completion of `K` for `d` and Mathlib's completion `K_𝔓`
(`IsDedekindDomain.HeightOneSpectrum.adicCompletion`).

For a number field `K`, `R = 𝒪_K` and `b = p` the prime number below `𝔓`, this is the second
construction of the `𝔓`-adic completion `K_𝔓` in the LMFDB knowl `nf.padic_completion`. The base
`b = N𝔓` gives Mathlib's finite place `NumberField.HeightOneSpectrum.adicAbv`, an equivalent
absolute value.

## Main definitions

* `IsDedekindDomain.HeightOneSpectrum.adicAbvRingEquiv`: the identity of `K`, from `K` with the
  metric of `adicAbv` to `K` with the `𝔓`-adic valuation.
* `IsDedekindDomain.HeightOneSpectrum.adicAbvUniformEquiv` (LMFDB `nf.padic_completion`): it is a
  uniform equivalence.
* `IsDedekindDomain.HeightOneSpectrum.adicAbvCompletionRingEquiv` (LMFDB `nf.padic_completion`):
  the isomorphism between the completion of `K` for the metric of `adicAbv` and `K_𝔓`.

## Main results

* `IsDedekindDomain.HeightOneSpectrum.dist_toAbs_adicAbv` (LMFDB `nf.padic_completion`): the metric
  of `adicAbv` is `d(x, y) = b ^ (-v_𝔓(x - y))` for `x ≠ y`.
* `IsDedekindDomain.HeightOneSpectrum.isEquiv_adicAbv`: the absolute values `adicAbv` for two bases
  are equivalent.
* `IsDedekindDomain.HeightOneSpectrum.adicAbvCompletionRingEquiv_coe`: the isomorphism of
  completions extends the identity of `K`.
* `IsDedekindDomain.HeightOneSpectrum.isHomeomorph_adicAbvCompletionRingEquiv`: it is a
  homeomorphism.
-/

open FractionalIdeal Metric UniformSpace WithAbs WithZero WithZeroMulInt

open scoped NNReal nonZeroDivisors

namespace IsDedekindDomain.HeightOneSpectrum

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] (v : HeightOneSpectrum R) {b : ℝ≥0} (hb : 1 < b)

lemma adicAbv_eq_toNNReal (x : K) :
    v.adicAbv hb x = toNNReal (ne_zero_of_lt hb) (v.valuation K x) :=
  rfl

lemma adicAbv_lt_adicAbv_iff (x y : K) :
    v.adicAbv hb x < v.adicAbv hb y ↔ v.valuation K x < v.valuation K y := by
  rw [adicAbv_eq_toNNReal, adicAbv_eq_toNNReal, NNReal.coe_lt_coe,
    (toNNReal_strictMono hb).lt_iff_lt]

lemma adicAbv_le_adicAbv_iff (x y : K) :
    v.adicAbv hb x ≤ v.adicAbv hb y ↔ v.valuation K x ≤ v.valuation K y := by
  rw [adicAbv_eq_toNNReal, adicAbv_eq_toNNReal, NNReal.coe_le_coe,
    (toNNReal_strictMono hb).le_iff_le]

/-- **The metric of `adicAbv` is `d(x, y) = b ^ (-v_𝔓(x - y))`** (LMFDB `nf.padic_completion`) for
`x ≠ y`, where `v_𝔓(x - y)` is the exponent of `𝔓` in the factorization of the fractional ideal
generated by `x - y`. -/
lemma dist_toAbs_adicAbv {x y : K} (hxy : x ≠ y) : dist (toAbs (v.adicAbv hb) x) (toAbs _ y) =
    (b : ℝ) ^ (-count K v (spanSingleton R⁰ (x - y))) := by
  have h : count K v (spanSingleton R⁰ (x - y)) = -log (v.valuation K (x - y)) := by
    have h' : count K v (toPrincipalIdeal R K (.mk0 _ (sub_ne_zero.mpr hxy))) =
        -log (v.valuation K (x - y)) :=
      count_toPrincipalIdeal_eq_neg_log_valuation K v _
    rwa [coe_toPrincipalIdeal, Units.val_mk0] at h'
  rw [dist_eq_norm, ← toAbs_sub, norm_toAbs_eq, adicAbv_eq_toNNReal,
    toNNReal_neg_apply _ ((v.valuation K).ne_zero_iff.mpr (sub_ne_zero.mpr hxy)), NNReal.coe_zpow,
    h, neg_neg]

variable {b' : ℝ≥0} (hb' : 1 < b') in
/-- **The absolute values `adicAbv` for two bases are equivalent**: for a number field, the
absolute value `p ^ (-v_𝔓(x))` of the knowl `nf.padic_completion` and the absolute value
`N𝔓 ^ (-v_𝔓(x))` of Mathlib's finite place are equivalent. -/
lemma isEquiv_adicAbv : (v.adicAbv (K := K) hb).IsEquiv (v.adicAbv hb') := fun x y ↦ by
  rw [adicAbv_le_adicAbv_iff, adicAbv_le_adicAbv_iff]

variable (K)

/-- The identity of `K`, from `K` with the metric of the absolute value `adicAbv` to `K` with the
`𝔓`-adic valuation. -/
noncomputable def adicAbvRingEquiv : WithAbs (v.adicAbv (K := K) hb) ≃+* WithVal (v.valuation K) :=
  (WithAbs.equiv _).trans (WithVal.equiv _).symm

lemma continuous_adicAbvRingEquiv : Continuous (adicAbvRingEquiv K v hb) := by
  refine continuous_of_continuousAt_zero _ ?_
  rw [ContinuousAt, map_zero,
    nhds_basis_ball.tendsto_iff (IsValuativeTopology.hasBasis_nhds_zero' _)]
  intro γ hγ
  rcases ValuativeRel.valuation_surjective γ with ⟨c, rfl⟩
  have hc : c.ofVal ≠ 0 :=
    (WithVal.ofVal_eq_zero _ c).not.mpr ((ValuativeRel.valuation _).ne_zero_iff.mp hγ)
  refine ⟨v.adicAbv hb c.ofVal, (v.adicAbv hb).pos hc, fun x hx ↦ ?_⟩
  rw [mem_ball, dist_zero_right, norm_eq_apply_ofAbs, adicAbv_lt_adicAbv_iff] at hx
  rw [Set.mem_ofPred_eq, ← (ValuativeRel.valuation _).vlt_iff_lt, (WithVal.valuation _).vlt_iff_lt]
  exact hx

lemma continuous_adicAbvRingEquiv_symm : Continuous (adicAbvRingEquiv K v hb).symm := by
  refine continuous_of_continuousAt_zero _ ?_
  rw [ContinuousAt, map_zero,
    (IsValuativeTopology.hasBasis_nhds_zero' _).tendsto_iff nhds_basis_ball]
  intro ε hε
  rcases v.valuation_exists_uniformizer K with ⟨π, hπ⟩
  rcases exists_pow_lt_of_lt_one hε (inv_lt_one_of_one_lt₀ (NNReal.coe_lt_coe.mpr hb)) with ⟨n, hn⟩
  have hπ0 : π ^ n ≠ 0 := pow_ne_zero n ((v.valuation K).ne_zero_iff.mp (hπ ▸ exp_ne_zero))
  refine ⟨ValuativeRel.valuation _ (WithVal.toVal (v.valuation K) (π ^ n)),
    (ValuativeRel.valuation _).ne_zero_iff.mpr ((WithVal.toVal_eq_zero _ _).not.mpr hπ0),
    fun y hy ↦ ?_⟩
  rw [Set.mem_ofPred_eq, ← (ValuativeRel.valuation _).vlt_iff_lt, (WithVal.valuation _).vlt_iff_lt,
    WithVal.valuation_toVal, WithVal.valuation_apply_eq_ofVal] at hy
  rw [mem_ball, dist_zero_right, norm_eq_apply_ofAbs]
  refine ((adicAbv_lt_adicAbv_iff v hb _ _).mpr hy).trans ?_
  rw [map_pow, adicAbv_eq_toNNReal, hπ, toNNReal_neg_apply _ exp_ne_zero, log_exp, zpow_neg_one,
    NNReal.coe_inv]
  exact hn

/-- **The metric of `adicAbv` defines the uniform structure of the `𝔓`-adic valuation** (LMFDB
`nf.padic_completion`): the identity of `K` is a uniform equivalence between `K` with the metric
`b ^ (-v_𝔓(x - y))` and `K` with the `𝔓`-adic valuation. -/
noncomputable def adicAbvUniformEquiv :
    WithAbs (v.adicAbv (K := K) hb) ≃ᵤ WithVal (v.valuation K) where
  toEquiv := (adicAbvRingEquiv K v hb).toEquiv
  uniformContinuous_toFun :=
    uniformContinuous_addMonoidHom_of_continuous (continuous_adicAbvRingEquiv K v hb)
  uniformContinuous_invFun :=
    uniformContinuous_addMonoidHom_of_continuous (continuous_adicAbvRingEquiv_symm K v hb)

/-- **The completion of `K` for the metric of `adicAbv` is `K_𝔓`** (LMFDB `nf.padic_completion`):
the isomorphism between the completion of `K` for the metric `b ^ (-v_𝔓(x - y))` and Mathlib's
completion `K_𝔓` of `K` for the `𝔓`-adic valuation. It extends the identity of `K`
(`IsDedekindDomain.HeightOneSpectrum.adicAbvCompletionRingEquiv_coe`) and is a homeomorphism
(`IsDedekindDomain.HeightOneSpectrum.isHomeomorph_adicAbvCompletionRingEquiv`). -/
noncomputable def adicAbvCompletionRingEquiv :
    (v.adicAbv (K := K) hb).Completion ≃+* v.adicCompletion K :=
  (Completion.mapRingEquiv (adicAbvRingEquiv K v hb) (continuous_adicAbvRingEquiv K v hb)
    (continuous_adicAbvRingEquiv_symm K v hb)).trans (adicCompletion.equiv K v).symm

variable {K}

/-- **The completion of `K` for the metric of `adicAbv` is `K_𝔓` over `K`**: the isomorphism of
completions extends the identity of `K`. -/
lemma adicAbvCompletionRingEquiv_coe (x : K) : adicAbvCompletionRingEquiv K v hb x = x :=
  congrArg adicCompletion.ofCompletion <|
    Completion.mapRingHom_coe (continuous_adicAbvRingEquiv K v hb) _

variable (K) in
/-- **The completion of `K` for the metric of `adicAbv` is `K_𝔓` as a topological field**: the
isomorphism of completions is a homeomorphism. -/
lemma isHomeomorph_adicAbvCompletionRingEquiv : IsHomeomorph (adicAbvCompletionRingEquiv K v hb) :=
  (Homeomorph.mk (adicAbvCompletionRingEquiv K v hb).toEquiv
    ((adicCompletion.continuous_ofCompletion K v).comp Completion.continuous_map)
    (Completion.continuous_map.comp (adicCompletion.continuous_toCompletion K v))).isHomeomorph

end IsDedekindDomain.HeightOneSpectrum
