import Mathlib.Geometry.Manifold.Algebra.LieGroup
import Mathlib.Topology.Algebra.Module.LocallyConvex
import TauCeti.Geometry.Lie.Exponential.Generation
import TauCeti.Geometry.Lie.Interior
import TauCeti.Geometry.Lie.Subgroup.Embedded

/-!
# Finite-index subgroups and closed subgroups of Lie groups

The identity component of a finite-dimensional real Lie group `G` is generated by the image of its
exponential map (Tau Ceti's `TauCeti.closure_range_lieExp_eq_connectedComponentOfOne`), and every
exponential `exp X = exp (X / n) ^ n` is an `n`th power for every `n ≥ 1`. As `g ^ n` lies in a
normal subgroup of index `n` for every element `g`, the identity component lies in the normal core
of every subgroup of finite index, closed or not: a connected Lie group has no proper subgroup of
finite index.

A closed subgroup `K` of `G` is a Lie group, modelled on its Lie algebra, by Cartan's
closed-subgroup theorem (Tau Ceti's
`TauCeti.Lie.nonempty_embeddedLieSubgroupData_lieSubalgebraOfSubgroup_of_isClosed`). So `K` is
locally path-connected, its model being a real normed space, and its identity component lies in
each of its subgroups of finite index.

## Main results

* `LieGroup.connectedComponentOfOne_le_of_finiteIndex`: a subgroup of finite index of a
  finite-dimensional real Lie group contains its identity component.
* `Subgroup.locallyPathConnectedSpace_of_isClosed`: a closed subgroup of a finite-dimensional real
  Lie group is locally path-connected.
* `Subgroup.connectedComponentOfOne_le_of_isClosed`: a subgroup of finite index of a closed subgroup
  `K` of a finite-dimensional real Lie group contains the identity component of `K`.
-/

open scoped ContDiff Manifold

open Subgroup (connectedComponentOfOne)

open TauCeti Lie

variable {E H G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [TopologicalSpace H] [TopologicalSpace G] [ChartedSpace H G] [Group G]

/-- **A subgroup `K` of finite index of a finite-dimensional real Lie group `G` contains the
identity component `G⁰`**, closed or not: `G⁰` is generated by the exponentials, and an exponential
`exp X = exp (X / n) ^ n`, with `n` the index of the normal core of `K`, lies in that normal core.
In particular a connected Lie group has no proper subgroup of finite index. -/
lemma LieGroup.connectedComponentOfOne_le_of_finiteIndex (I : ModelWithCorners ℝ E H)
    [LieGroup I ∞ G] (K : Subgroup G) [K.FiniteIndex] :
    haveI : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
    connectedComponentOfOne G ≤ K := by
  have _ : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  have _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
  have _ : BoundarylessManifold I G := ContMDiffMul.boundarylessManifold
  rw [← closure_range_lieExp_eq_connectedComponentOfOne (I := I)]
  refine ((Subgroup.closure_le _).mpr ?_).trans K.normalCore_le
  rintro _ ⟨X, rfl⟩
  rw [← lieExp_inv_natCast_smul_pow X K.normalCore.index_ne_zero_of_finite]
  exact K.normalCore.pow_index_mem _

namespace Subgroup

variable {K : Subgroup G}

/-- **A closed subgroup of a finite-dimensional real Lie group is locally path-connected**: it is a
manifold modelled on its Lie algebra, a real normed space, by the closed-subgroup theorem. -/
lemma locallyPathConnectedSpace_of_isClosed (I : ModelWithCorners ℝ E H) [LieGroup I ∞ G]
    (hK : IsClosed (K : Set G)) : LocallyPathConnectedSpace K := by
  have _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
  have _ : BoundarylessManifold I G := ContMDiffMul.boundarylessManifold
  rcases nonempty_embeddedLieSubgroupData_lieSubalgebraOfSubgroup_of_isClosed (I := I) hK with ⟨D⟩
  let _ : ChartedSpace (lieSubalgebraOfSubgroup (I := I) K).toSubmodule K := D.chartedSpace
  exact ChartedSpace.locallyPathConnectedSpace (lieSubalgebraOfSubgroup (I := I) K).toSubmodule K

/-- **A subgroup `L` of finite index of a closed subgroup `K` of a finite-dimensional real Lie group
contains the identity component `K⁰`**, closed or not: `K` is a Lie group by the closed-subgroup
theorem. -/
lemma connectedComponentOfOne_le_of_isClosed (I : ModelWithCorners ℝ E H) [LieGroup I ∞ G]
    (hK : IsClosed (K : Set G)) (L : Subgroup K) [L.FiniteIndex] :
    haveI : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
    connectedComponentOfOne K ≤ L := by
  have _ : T2Space G := t2Space_of_lieGroup (I := I) (n := ∞)
  have _ : BoundarylessManifold I G := ContMDiffMul.boundarylessManifold
  rcases nonempty_embeddedLieSubgroupData_lieSubalgebraOfSubgroup_of_isClosed (I := I) hK with ⟨D⟩
  let _ : ChartedSpace (lieSubalgebraOfSubgroup (I := I) K).toSubmodule K := D.chartedSpace
  have _ : LieGroup 𝓘(ℝ, (lieSubalgebraOfSubgroup (I := I) K).toSubmodule) ∞ K := D.lieGroup
  have _ : FiniteDimensional ℝ (LeftInvariantDerivation I G) :=
    finiteDimensional_leftInvariantDerivation BoundarylessManifold.isInteriorPoint
  exact LieGroup.connectedComponentOfOne_le_of_finiteIndex
    𝓘(ℝ, (lieSubalgebraOfSubgroup (I := I) K).toSubmodule) L

end Subgroup
