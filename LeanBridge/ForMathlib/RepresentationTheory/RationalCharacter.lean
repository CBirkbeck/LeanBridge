import LeanBridge.ForMathlib.NumberTheory.NumberField.AbelianConductor
import Mathlib.RingTheory.RootsOfUnity.Complex
import TauCeti.RepresentationTheory.CharacterTable.FieldOfValues

/-!
# Rational characters, rational groups and the conductor of a character

## Main definitions

* `FDRep.IsRationalCharacter` (LMFDB `group.representation.rational_character`): a complex
  character with values in `ℚ`.
* `FDRep.galoisConjugates`, `FDRep.rationalCharacter` (LMFDB
  `group.representation.rational_character`): the Galois conjugates of a complex character and their
  sum, the irreducible rational character of an irreducible representation.
* `Group.IsRational` (LMFDB `group.rational_group`): a group all of whose complex characters are
  rational valued.
* `FDRep.characterConductor` (LMFDB `group.representation.cyclotomic_n`): the conductor of the
  field of values `ℚ(χ)` of a complex character.

## Main results

* The instance `NumberField (X.characterField ℚ)`: the field of values of a complex character of a
  finite group is a number field.
* `FDRep.finite_galoisConjugates`: a complex character of a finite group has finitely many Galois
  conjugates.
* `FDRep.characterConductor_pos`: the field of values of a complex character of a finite group
  lies in a cyclotomic field, so its conductor is positive.
-/

open IntermediateField

namespace FDRep

variable {G : Type} [Group G] (X : FDRep ℂ G)

/-- A complex character `χ` of `G` is a **rational character** (LMFDB
`group.representation.rational_character`) if it takes values in `ℚ`. -/
def IsRationalCharacter : Prop :=
  ∀ g, ∃ q : ℚ, X.character g = q

/-- The **Galois conjugates** of the character `χ` of `X`: the functions `σ ∘ χ` for the field
automorphisms `σ` of `ℂ`. -/
noncomputable def galoisConjugates : Set (G → ℂ) :=
  Set.range fun σ : ℂ ≃ₐ[ℚ] ℂ ↦ σ ∘ X.character

variable [Finite G]

instance : NumberField (X.characterField ℚ) where

/-- **A complex character of a finite group has finitely many Galois conjugates**: `σ ∘ χ` only
depends on the restriction of `σ` to the number field `ℚ(χ)`. -/
lemma finite_galoisConjugates : X.galoisConjugates.Finite := by
  refine (Set.finite_range fun φ : X.characterField ℚ →ₐ[ℚ] ℂ ↦
    fun g ↦ φ ⟨X.character g, X.character_mem_characterField ℚ g⟩).subset ?_
  rintro - ⟨σ, rfl⟩
  exact ⟨(σ.toAlgHom.comp (X.characterField ℚ).val), rfl⟩

/-- The **irreducible rational character** (LMFDB `group.representation.rational_character`)
attached to an irreducible complex representation `X` with character `χ`: the sum of the distinct
Galois conjugates `σ ∘ χ` of `χ`. It is a rational character (not proved here), though not an
irreducible complex character in general. -/
noncomputable def rationalCharacter : G → ℂ :=
  ∑ᶠ ψ ∈ X.galoisConjugates, ψ

/-- The **conductor** of a complex character `χ` of a finite group (LMFDB
`group.representation.cyclotomic_n`): the conductor of the abelian number field `ℚ(χ)` generated by
the values of `χ`, i.e. the least `n > 0` with `ℚ(χ) ⊆ ℚ(ζ_n)`. -/
noncomputable def characterConductor : ℕ :=
  NumberField.abelianConductor (X.characterField ℚ)

/-- **The conductor of a complex character of a finite group is positive**: `ℚ(χ)` lies in the
cyclotomic field `ℚ(ζ_e)` for `e` the exponent of `G`. -/
lemma characterConductor_pos : 0 < X.characterConductor := by
  have he : Monoid.exponent G ≠ 0 := Monoid.exponent_ne_zero_of_finite
  have : NeZero (Monoid.exponent G) := ⟨he⟩
  let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I / Monoid.exponent G)
  have hζ : IsPrimitiveRoot ζ (Monoid.exponent G) := Complex.isPrimitiveRoot_exp _ he
  have : IsCyclotomicExtension ({Monoid.exponent G} : Set ℕ) ℚ (Algebra.adjoin ℚ {ζ}) :=
    hζ.adjoin_isCyclotomicExtension ℚ
  have : IsCyclotomicExtension ({Monoid.exponent G} : Set ℕ) ℚ
      (CyclotomicField (Monoid.exponent G) ℚ) :=
    CyclotomicField.isCyclotomicExtension _ ℚ
  have hζ' : IsAlgebraic ℚ ζ := (hζ.isIntegral he.bot_lt).tower_top.isAlgebraic
  have : IsCyclotomicExtension ({Monoid.exponent G} : Set ℕ) ℚ (adjoin ℚ {ζ}) :=
    IsCyclotomicExtension.equiv _ ℚ _ <| Subalgebra.equivOfEq _ _
      (adjoin_simple_toSubalgebra_of_isAlgebraic hζ').symm
  exact (NumberField.abelianConductor_pos_iff _).mpr ⟨Monoid.exponent G, he.bot_lt,
    ⟨((IsCyclotomicExtension.algEquiv ({Monoid.exponent G} : Set ℕ) ℚ _
      (CyclotomicField (Monoid.exponent G) ℚ)).toAlgHom.comp
        (inclusion <| X.characterField_le_adjoin_of_isPrimitiveRoot hζ))⟩⟩

end FDRep

/-- A group `G` is **rational** (LMFDB `group.rational_group`) if all of its complex characters
are rational valued. -/
def Group.IsRational (G : Type) [Group G] : Prop :=
  ∀ X : FDRep ℂ G, X.IsRationalCharacter
