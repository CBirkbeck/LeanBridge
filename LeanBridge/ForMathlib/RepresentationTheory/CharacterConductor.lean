import LeanBridge.ForMathlib.NumberTheory.MulChar.GaloisAction
import LeanBridge.ForMathlib.RepresentationTheory.RationalCharacter

/-!
# The conductor of a character as the least level of a cyclotomic field

The conductor of a complex character `χ` of a finite group (LMFDB
`group.representation.cyclotomic_n`), `FDRep.characterConductor`, is the conductor of the number
field `ℚ(χ)` generated by its values: the least `n > 0` such that `ℚ(χ)` embeds in the cyclotomic
field `CyclotomicField n ℚ` (`NumberField.abelianConductor`). The LMFDB reads it inside `ℂ`, as the
least `n` such that `ℚ(χ) ⊆ ℚ(ζ_n)`, where `ℚ(ζ_n)` is the subfield of `ℂ` generated by the `n`-th
roots of unity. The two readings agree because `ℚ(ζ_n)` is a normal extension of `ℚ`: if a subfield
`K` of `ℂ` embeds in `ℚ(ζ_n)` by `ψ`, then every `x ∈ K` is a root of the minimal polynomial of
`ψ x`, which splits in `ℚ(ζ_n)`, so `x ∈ ℚ(ζ_n)`. Hence `ℚ(χ) ⊆ ℚ(ζ_n)` exactly when the conductor
of `χ` divides `n`, and the conductor is the least such `n`. As `ℚ(χ)` embeds in a cyclotomic
field, it is an abelian extension of `ℚ`.

The LMFDB says "a group `G`", but for an infinite group `ℚ(χ)` need not be abelian, or even
algebraic over `ℚ` (`ℤ` acting on `ℂ` by the powers of `π`), so the results are stated for finite
groups.

## Main results

* `IntermediateField.nonempty_algHom_cyclotomicField_iff_le`: a subfield of `ℂ` embeds in the
  `n`-th cyclotomic field exactly when it lies in the subfield `ℚ(ζ_n)` of `ℂ`.
* `FDRep.isAbelianGalois_characterField` (LMFDB `group.representation.cyclotomic_n`): the field of
  values of a complex character of a finite group is an abelian extension of `ℚ`.
* `FDRep.characterField_le_adjoin_nth_roots_iff` (LMFDB `group.representation.cyclotomic_n`):
  `ℚ(χ) ⊆ ℚ(ζ_n)` exactly when the conductor of `χ` divides `n`.
* `FDRep.isLeast_characterConductor` (LMFDB `group.representation.cyclotomic_n`): the conductor of
  `χ` is the least `n > 0` such that `ℚ(χ) ⊆ ℚ(ζ_n)` inside `ℂ`.
-/

open IntermediateField IsCyclotomicExtension Polynomial

variable {n : ℕ}

namespace IntermediateField

variable {K : IntermediateField ℚ ℂ} [NeZero n]

/-- **A subfield of `ℂ` embeds in the `n`-th cyclotomic field exactly when it lies in `ℚ(ζ_n)`**,
the subfield of `ℂ` generated by the `n`-th roots of unity, which is isomorphic to
`CyclotomicField n ℚ`: as `ℚ(ζ_n)` is a normal extension of `ℚ`, an element `x` of a subfield with
an embedding `ψ` into `ℚ(ζ_n)` is a root of the minimal polynomial of `ψ x`, which splits in
`ℚ(ζ_n)`. -/
lemma nonempty_algHom_cyclotomicField_iff_le :
    Nonempty (K →ₐ[ℚ] CyclotomicField n ℚ) ↔ K ≤ adjoin ℚ {b : ℂ | b ^ n = 1} := by
  have : IsCyclotomicExtension {n} ℚ (CyclotomicField n ℚ) :=
    CyclotomicField.isCyclotomicExtension n ℚ
  let e : CyclotomicField n ℚ ≃ₐ[ℚ] adjoin ℚ {b : ℂ | b ^ n = 1} := algEquiv {n} ℚ _ _
  refine ⟨fun ⟨ψ⟩ x hx ↦ ?_, fun h ↦ ⟨e.symm.toAlgHom.comp (inclusion h)⟩⟩
  have hL : Normal ℚ (adjoin ℚ {b : ℂ | b ^ n = 1}) := (isGalois {n} ℚ _).to_normal
  have hψ : minpoly ℚ (e (ψ ⟨x, hx⟩)) = minpoly ℚ x :=
    (minpoly.algHom_eq (e.toAlgHom.comp ψ) (e.injective.comp ψ.injective) _).trans (minpoly_eq _)
  have hx' : ((minpoly ℚ (e (ψ ⟨x, hx⟩))).map (algebraMap ℚ (adjoin ℚ {b : ℂ | b ^ n = 1}))).map
      (algebraMap (adjoin ℚ {b : ℂ | b ^ n = 1}) ℂ) |>.IsRoot x := by
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq, hψ, IsRoot, eval_map_algebraMap,
      minpoly.aeval]
  rcases (hL.splits _).mem_range_of_isRoot (map_ne_zero <| minpoly.ne_zero <|
    Algebra.IsIntegral.isIntegral _) hx' with ⟨z, rfl⟩
  exact z.2

end IntermediateField

namespace FDRep

variable {G : Type} [Group G] [Finite G] (X : FDRep ℂ G)

/-- **The field of values of a complex character of a finite group is abelian** (LMFDB
`group.representation.cyclotomic_n`): it embeds in a cyclotomic field
(`FDRep.characterConductor_pos`). -/
lemma isAbelianGalois_characterField : IsAbelianGalois ℚ (X.characterField ℚ) :=
  NumberField.isAbelianGalois_of_abelianConductor_pos _ X.characterConductor_pos

/-- **`ℚ(χ) ⊆ ℚ(ζ_n)` exactly when the conductor of `χ` divides `n`** (LMFDB
`group.representation.cyclotomic_n`), for `n > 0`, where `ℚ(ζ_n)` is the subfield of `ℂ` generated
by the `n`-th roots of unity. -/
lemma characterField_le_adjoin_nth_roots_iff (hn : 0 < n) :
    X.characterField ℚ ≤ adjoin ℚ {b : ℂ | b ^ n = 1} ↔ X.characterConductor ∣ n :=
  have : NeZero n := ⟨hn.ne'⟩
  nonempty_algHom_cyclotomicField_iff_le.symm.trans <|
    NumberField.nonempty_algHom_cyclotomicField_iff _ hn

/-- **The conductor of a character is the least level of a cyclotomic field containing its values**
(LMFDB `group.representation.cyclotomic_n`): the conductor of a complex character `χ` of a finite
group is the least `n > 0` such that `ℚ(χ) ⊆ ℚ(ζ_n)`, where `ℚ(ζ_n)` is the subfield of `ℂ`
generated by the `n`-th roots of unity. -/
lemma isLeast_characterConductor :
    IsLeast {n | 0 < n ∧ X.characterField ℚ ≤ adjoin ℚ {b : ℂ | b ^ n = 1}} X.characterConductor :=
  ⟨⟨X.characterConductor_pos, (X.characterField_le_adjoin_nth_roots_iff
    X.characterConductor_pos).mpr dvd_rfl⟩, fun _ ⟨hn, h⟩ ↦
      Nat.le_of_dvd hn <| (X.characterField_le_adjoin_nth_roots_iff hn).mp h⟩

end FDRep
