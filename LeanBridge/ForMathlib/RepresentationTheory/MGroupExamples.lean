import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.SupersolvableExamples
import LeanBridge.ForMathlib.RepresentationTheory.MGroupSolvable
import LeanBridge.ForMathlib.RepresentationTheory.MGroupSupersolvable
import Mathlib.GroupTheory.CommutingProbability

/-!
# Monomial groups: examples and non-examples

The LMFDB's knowl on monomial groups (LMFDB `group.monomial`) states that not every monomial
group is supersolvable, that not every solvable A-group is supersolvable, and that not every
solvable group is monomial. The alternating group `A₄` is a solvable A-group, hence monomial, but
is not supersolvable, and `SL₂(𝔽₃)` is solvable but not monomial.

For the last statement: in an M-group the degree of every irreducible character is the index of a
subgroup. A group of order `24` with `7` conjugacy classes has seven irreducible characters, the
squares of whose degrees add up to `24`, so that one of the degrees is `2` (the degrees are
`1, 1, 1, 2, 2, 2, 3`). But `SL₂(𝔽₃)` is such a group and has no subgroup of index `2`, as it is
generated by squares.

## Main results

* `alternatingGroup.isMGroup_fin_four`: the alternating group `A₄` is an M-group.
* `not_forall_isSupersolvable_of_isMGroup` (LMFDB `group.monomial`): not every monomial group is
  supersolvable.
* `not_forall_isSupersolvable_of_isSolvable_of_isAGroup` (LMFDB `group.monomial`): not every
  solvable A-group is supersolvable.
* `not_isMGroup_of_nat_card_eq_twentyFour`: a group of order `24` with `7` conjugacy classes and
  no subgroup of index `2` is not an M-group.
* `Matrix.SpecialLinearGroup.not_isMGroup_fin_two_zmod_three`: `SL₂(𝔽₃)` is not an M-group.
* `not_forall_isMGroup_of_isSolvable` (LMFDB `group.monomial`): not every solvable group is
  monomial.
-/

open Matrix Subgroup TauCeti

open scoped MatrixGroups

/-- **The alternating group `A₄` is an M-group** (LMFDB `group.monomial`): it is a solvable
A-group. -/
lemma alternatingGroup.isMGroup_fin_four : IsMGroup (alternatingGroup (Fin 4)) :=
  have : IsAGroup (alternatingGroup (Fin 4)) := isAGroup_fin_four
  .of_isSolvable_of_isAGroup

/-- **Not every monomial group is supersolvable** (LMFDB `group.monomial`): the alternating group
`A₄` is an M-group but is not supersolvable. -/
lemma not_forall_isSupersolvable_of_isMGroup :
    ¬∀ (G : Type) [Group G] [Finite G], IsMGroup G → Group.IsSupersolvable G :=
  fun h ↦ alternatingGroup.not_isSupersolvable_fin_four <| h _ alternatingGroup.isMGroup_fin_four

/-- **Not every solvable A-group is supersolvable** (LMFDB `group.monomial`): the alternating
group `A₄` is a solvable A-group but is not supersolvable. -/
lemma not_forall_isSupersolvable_of_isSolvable_of_isAGroup : ¬∀ (G : Type) [Group G] [Finite G],
    Group.IsSolvable G → IsAGroup G → Group.IsSupersolvable G :=
  fun h ↦ alternatingGroup.not_isSupersolvable_fin_four <|
    h _ inferInstance alternatingGroup.isAGroup_fin_four

/-- **A group of order `24` with `7` conjugacy classes and no subgroup of index `2` is not an
M-group**: the squares of the degrees of its seven irreducible characters add up to `24`, so one
of the degrees is `2`, and in an M-group every degree is the index of a subgroup. -/
lemma not_isMGroup_of_nat_card_eq_twentyFour {G : Type} [Group G] [Finite G] (hG : Nat.card G = 24)
    (hc : Nat.card (ConjClasses G) = 7) (h2 : ∀ H : Subgroup G, H.index ≠ 2) : ¬IsMGroup G := by
  intro _
  let _ : Invertible (Nat.card G : ℂ) :=
    invertibleOfNonzero <| Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  have hsum : ∑ i : Fin (Nat.card (ConjClasses G)), characterDegree ℂ i ^ 2 = 24 :=
    (sum_characterDegree_sq_eq_card ℂ).trans hG
  have hd (i : Fin (Nat.card (ConjClasses G))) : characterDegree ℂ i ^ 2 =
      8 * (if characterDegree ℂ i = 3 then 1 else 0) +
        15 * (if characterDegree ℂ i = 4 then 1 else 0) + 1 := by
    rcases IsMGroup.exists_index_eq_characterDegree i with ⟨H, hH⟩
    have h0 : 0 < characterDegree ℂ i := characterDegree_pos ℂ i
    have h2' : characterDegree ℂ i ≠ 2 := hH ▸ h2 H
    have h24 : characterDegree ℂ i ^ 2 ≤ 24 := hsum ▸ Finset.single_le_sum
      (f := fun i ↦ characterDegree ℂ i ^ 2) (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ i)
    have h5 : characterDegree ℂ i < 5 := by
      nlinarith
    interval_cases characterDegree ℂ i <;> simp_all
  rw [Finset.sum_congr rfl fun i _ ↦ hd i] at hsum
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, smul_eq_mul] at hsum
  omega

namespace Matrix.SpecialLinearGroup

lemma nat_card_conjClasses_fin_two_zmod_three : Nat.card (ConjClasses SL(2, ZMod 3)) = 7 := by
  have h168 : Nat.card {p : SL(2, ZMod 3) × SL(2, ZMod 3) // p.1 * p.2 = p.2 * p.1} = 168 := by
    rw [Nat.card_eq_fintype_card]
    decide +kernel
  have h : Nat.card (ConjClasses SL(2, ZMod 3)) * Nat.card SL(2, ZMod 3) = 168 :=
    (card_comm_eq_card_conjClasses_mul_card SL(2, ZMod 3)).symm.trans h168
  rw [nat_card_fin_two_zmod_three] at h
  omega

lemma index_ne_two_fin_two_zmod_three (H : Subgroup SL(2, ZMod 3)) : H.index ≠ 2 := by
  intro h
  have hd : ∀ g : SL(2, ZMod 3), ∃ a b : SL(2, ZMod 3), g = a ^ 2 * b ^ 2 := by
    decide +kernel
  have htop : H = ⊤ := eq_top_iff.mpr fun g _ ↦ by
    rcases hd g with ⟨a, b, rfl⟩
    exact mul_mem (sq_mem_of_index_two h a) (sq_mem_of_index_two h b)
  rw [htop, index_top] at h
  omega

/-- **The group `SL₂(𝔽₃)` is not an M-group** (LMFDB `group.monomial`): it has an irreducible
representation of degree `2`, but no subgroup of index `2`. -/
lemma not_isMGroup_fin_two_zmod_three : ¬IsMGroup SL(2, ZMod 3) :=
  not_isMGroup_of_nat_card_eq_twentyFour nat_card_fin_two_zmod_three
    nat_card_conjClasses_fin_two_zmod_three index_ne_two_fin_two_zmod_three

end Matrix.SpecialLinearGroup

/-- **Not every solvable group is monomial** (LMFDB `group.monomial`): the group `SL₂(𝔽₃)` is
solvable but is not an M-group. -/
lemma not_forall_isMGroup_of_isSolvable :
    ¬∀ (G : Type) [Group G] [Finite G], Group.IsSolvable G → IsMGroup G :=
  fun h ↦ SpecialLinearGroup.not_isMGroup_fin_two_zmod_three <|
    h _ SpecialLinearGroup.isSolvable_fin_two_zmod_three
