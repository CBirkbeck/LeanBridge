import LeanBridge.ForMathlib.NumberTheory.LFunction.SymmetricPower
import Mathlib.Algebra.Polynomial.Lifts
import Mathlib.Data.Nat.Factorization.Induction
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed

/-!
# Rational L-functions

An analytic L-function `L(s) = ∑ aₙ n ^ (-s)` is rational (LMFDB `lfunction.rational`) if it is
arithmetic, with a motivic weight `w`, so that the numbers `aₙ n ^ (w / 2)` are algebraic
integers, and its coefficient field, the field generated by these numbers, is `ℚ`. In the
arithmetic normalisation of weight `w`, `L(s - w / 2) = ∑ aₙ n ^ (w / 2) n ^ (-s)`, the Euler
product is `∏ₚ L_p(p ^ (-s))⁻¹` with `L_p(T) = F_p(p ^ (w / 2) T)`, where `F_p` is the Euler factor
in the analytic normalisation, so that `L_p(T) ∑ₖ a_{pᵏ} p ^ (k w / 2) Tᵏ = 1`.

A rational L-function has rational coefficients `aₙ n ^ (w / 2)` that are algebraic integers, hence
integers, so the inverse `L_p(T)` of the power series `∑ₖ a_{pᵏ} p ^ (k w / 2) Tᵏ`, whose constant
term is `1`, has integer coefficients. Conversely, if every `L_p(T)` has integer coefficients, so
does its inverse, and by multiplicativity every `aₙ n ^ (w / 2)` is an integer: the L-function is
arithmetic, `w` is a motivic weight, and the coefficient field is `ℚ`. The Riemann zeta function is
rational.

## Main definitions

* `AnalyticLFunction.arithmeticEulerPolynomial`: the Euler factor `L_p(T) = F_p(p ^ (w / 2) T)` in
  the arithmetic normalisation of weight `w`.
* `AnalyticLFunction.IsRational` (LMFDB `lfunction.rational`): rational L-functions.

## Main results

* `AnalyticLFunction.arithmeticEulerPolynomial_mul_mk`: `L_p(T) ∑ₖ a_{pᵏ} p ^ (k w / 2) Tᵏ = 1`.
* `AnalyticLFunction.IsRational.isAlgebraic_coeff`: a rational L-function is arithmetic.
* `AnalyticLFunction.isRational_iff` (LMFDB `lfunction.rational`): an analytic L-function is
  rational exactly when its Euler factors in the arithmetic normalisation lie in `ℤ[T]`.
* `AnalyticLFunction.isRational_zeta`: the Riemann zeta function is rational.
-/

open Polynomial

open scoped PowerSeries

lemma PowerSeries.exists_coeff_eq_intCast_of_mul_eq_one {P Q : ℂ⟦X⟧} (h : P * Q = 1)
    (hQ : ∀ k, ∃ z : ℤ, coeff k Q = z) (hQ₀ : constantCoeff Q = 1) (k : ℕ) :
    ∃ z : ℤ, coeff k P = z := by
  choose z hz using hQ
  have hmap : map (Int.castRingHom ℂ) (mk z) = Q := by
    ext k
    simp [hz]
  have hz₀ : constantCoeff (mk z) = ((1 : ℤˣ) : ℤ) := by
    rw [← coeff_zero_eq_constantCoeff_apply, coeff_mk, Units.val_one, ← Int.cast_inj (α := ℂ),
      ← hz, coeff_zero_eq_constantCoeff_apply, hQ₀, Int.cast_one]
  have hP : P = map (Int.castRingHom ℂ) (invOfUnit (mk z) 1) := by
    rw [← mul_one P, ← map_one (map (Int.castRingHom ℂ)), ← mul_invOfUnit (mk z) 1 hz₀, map_mul,
      hmap, ← mul_assoc, h, one_mul]
  exact ⟨coeff k (invOfUnit (mk z) 1), by rw [hP, coeff_map, eq_intCast]⟩

namespace AnalyticLFunction

variable (L : AnalyticLFunction) {w p m n : ℕ}

variable (w p) in
/-- The **Euler factor in the arithmetic normalisation** of weight `w` of an analytic L-function at
`p`: `L_p(T) = F_p(p ^ (w / 2) T)`, where `F_p` is the Euler factor in the analytic normalisation
(`AnalyticLFunction.eulerPolynomial`), so that `L(s - w / 2) = ∏ₚ L_p(p ^ (-s))⁻¹`. -/
noncomputable def arithmeticEulerPolynomial : ℂ[X] :=
  (L.eulerPolynomial p).comp (C ((p : ℂ) ^ ((w : ℂ) / 2)) * X)

lemma arithmeticCoeff_one : L.arithmeticCoeff w 1 = 1 := by
  simp [arithmeticCoeff, L.coeff_one]

lemma arithmeticCoeff_mul (h : m.Coprime n) :
    L.arithmeticCoeff w (m * n) = L.arithmeticCoeff w m * L.arithmeticCoeff w n := by
  rw [arithmeticCoeff, arithmeticCoeff, arithmeticCoeff, L.coeff_mul_of_coprime h, Nat.cast_mul,
    Complex.natCast_mul_natCast_cpow]
  ring1

/-- **The Euler factor in the arithmetic normalisation inverts the local series**:
`L_p(T) ∑ₖ a_{pᵏ} p ^ (k w / 2) Tᵏ = 1` at a prime `p`. -/
lemma arithmeticEulerPolynomial_mul_mk (hp : p.Prime) : (L.arithmeticEulerPolynomial w p : ℂ⟦X⟧) *
    PowerSeries.mk (fun k ↦ L.arithmeticCoeff w (p ^ k)) = 1 := by
  have h : L.eulerFactor p * PowerSeries.mk (fun k ↦ L.coeff (p ^ k)) = 1 :=
    PowerSeries.inv_mul_cancel _ (by simp [L.coeff_one])
  have hA : (L.arithmeticEulerPolynomial w p : ℂ⟦X⟧) =
      PowerSeries.rescale ((p : ℂ) ^ ((w : ℂ) / 2)) (L.eulerFactor p) := by
    ext j
    rw [Polynomial.coeff_coe, arithmeticEulerPolynomial, comp_C_mul_X_coeff,
      PowerSeries.coeff_rescale, ← coe_eulerPolynomial hp, Polynomial.coeff_coe, mul_comm]
  have hB : PowerSeries.mk (fun k ↦ L.arithmeticCoeff w (p ^ k)) =
      PowerSeries.rescale ((p : ℂ) ^ ((w : ℂ) / 2)) (PowerSeries.mk fun k ↦ L.coeff (p ^ k)) := by
    rw [PowerSeries.rescale_mk]
    congr 1
    funext k
    rw [arithmeticCoeff, Nat.cast_pow, ← Complex.natCast_cpow_natCast_mul, Complex.cpow_nat_mul,
      mul_comm]
  rw [hA, hB, ← map_mul, h, map_one]

/-- An analytic L-function `L(s) = ∑ aₙ n ^ (-s)` is **rational** (LMFDB `lfunction.rational`) if
it is arithmetic with a motivic weight `w`, that is, the numbers `aₙ n ^ (w / 2)` are algebraic
integers for some `w`, and its coefficient field, the field generated by the `aₙ n ^ (w / 2)` for
the least such `w` (`AnalyticLFunction.motivicWeight`), is `ℚ`. The existence of `w` makes the
coefficients `aₙ` algebraic (`AnalyticLFunction.IsRational.isAlgebraic_coeff`). -/
def IsRational : Prop :=
  (∃ w, ∀ n ≠ 0, IsIntegral ℤ (L.arithmeticCoeff w n)) ∧
    IntermediateField.adjoin ℚ (L.arithmeticCoeff L.motivicWeight '' {n | n ≠ 0}) = ⊥

variable {L} in
/-- **A rational L-function is arithmetic** (LMFDB `lfunction.arithmetic`): its Dirichlet
coefficients `aₙ`, `n ≥ 1`, are algebraic numbers, as `aₙ n ^ (w / 2)` is an algebraic integer
and `n ^ (w / 2)` a square root of `n ^ w`. -/
lemma IsRational.isAlgebraic_coeff (h : L.IsRational) (hn : n ≠ 0) : IsAlgebraic ℚ (L.coeff n) := by
  rcases h.1 with ⟨w, hw⟩
  have hc : ((n : ℂ) ^ ((w : ℂ) / 2)) ^ 2 = ((n ^ w : ℕ) : ℂ) := by
    rw [← Complex.cpow_nat_mul, Nat.cast_pow, ← Complex.cpow_natCast]
    congr 1
    push_cast
    ring1
  rw [← mul_inv_cancel_right₀ (Complex.cpow_ne_zero_iff.mpr (.inl (Nat.cast_ne_zero.mpr hn)))
    (L.coeff n)]
  exact (hw n hn).tower_top.isAlgebraic.mul (IsAlgebraic.of_pow two_pos
    (hc ▸ isAlgebraic_natCast _)).inv

lemma exists_arithmeticCoeff_eq_intCast_of_forall_prime
    (h : ∀ p : ℕ, p.Prime → ∀ k, ∃ z : ℤ, L.arithmeticCoeff w (p ^ k) = z) (hn : n ≠ 0) :
    ∃ z : ℤ, L.arithmeticCoeff w n = z := by
  induction n using Nat.recOnPosPrimePosCoprime with
  | prime_pow p k hp _ => exact h p hp k
  | zero => exact absurd rfl hn
  | one => exact ⟨1, by rw [L.arithmeticCoeff_one, Int.cast_one]⟩
  | coprime a b _ _ hab ha hb =>
    rcases ha (by omega) with ⟨x, hx⟩
    rcases hb (by omega) with ⟨y, hy⟩
    exact ⟨x * y, by rw [L.arithmeticCoeff_mul hab, hx, hy, Int.cast_mul]⟩

/-- **A rational L-function is one whose Euler factors in the arithmetic normalisation lie in
`ℤ[T]`** (LMFDB `lfunction.rational`): `L` is rational exactly when, for its motivic weight `w`,
every Euler factor `L_p(T) = F_p(p ^ (w / 2) T)` of `L(s - w / 2) = ∏ₚ L_p(p ^ (-s))⁻¹` is the image
of a polynomial with integer coefficients. -/
lemma isRational_iff : L.IsRational ↔ ∀ p : ℕ, p.Prime → ∃ G : ℤ[X], G.map (Int.castRingHom ℂ) =
    L.arithmeticEulerPolynomial L.motivicWeight p := by
  refine ⟨fun ⟨hw, hQ⟩ p hp ↦ ?_, fun h ↦ ?_⟩
  · have hint (n : ℕ) (hn : n ≠ 0) : ∃ z : ℤ, L.arithmeticCoeff L.motivicWeight n = z := by
      have hn' : L.arithmeticCoeff L.motivicWeight n ∈ (⊥ : IntermediateField ℚ ℂ) :=
        IntermediateField.adjoin_eq_bot_iff.mp hQ ⟨n, hn, rfl⟩
      rcases IntermediateField.mem_bot.mp hn' with ⟨q, hq⟩
      have hq' : IsIntegral ℤ q := by
        rw [← isIntegral_algebraMap_iff (A := ℚ) (B := ℂ), hq]
        exact L.isIntegral_arithmeticCoeff_motivicWeight hw hn
      rcases IsIntegrallyClosed.isIntegral_iff.mp hq' with ⟨z, rfl⟩
      exact ⟨z, by rw [← hq, eq_intCast, eq_ratCast, Rat.cast_intCast]⟩
    refine (mem_lifts _).mp ((lifts_iff_coeff_lifts _).mpr fun j ↦ ?_)
    rcases PowerSeries.exists_coeff_eq_intCast_of_mul_eq_one
      (L.arithmeticEulerPolynomial_mul_mk hp) (fun k ↦ by
        rw [PowerSeries.coeff_mk]
        exact hint (p ^ k) (pow_ne_zero k hp.ne_zero))
      (by simp [L.arithmeticCoeff_one]) j with ⟨z, hz⟩
    exact ⟨z, by rw [eq_intCast, ← hz, Polynomial.coeff_coe]⟩
  · have hint (n : ℕ) (hn : n ≠ 0) : ∃ z : ℤ, L.arithmeticCoeff L.motivicWeight n = z := by
      refine L.exists_arithmeticCoeff_eq_intCast_of_forall_prime (fun p hp k ↦ ?_) hn
      rcases h p hp with ⟨G, hG⟩
      have hmul : PowerSeries.mk (fun k ↦ L.arithmeticCoeff L.motivicWeight (p ^ k)) *
          (L.arithmeticEulerPolynomial L.motivicWeight p : ℂ⟦X⟧) = 1 :=
        mul_comm (L.arithmeticEulerPolynomial L.motivicWeight p : ℂ⟦X⟧) _ ▸
          L.arithmeticEulerPolynomial_mul_mk hp
      have hG' (j : ℕ) : ∃ z : ℤ,
          PowerSeries.coeff j (L.arithmeticEulerPolynomial L.motivicWeight p : ℂ⟦X⟧) = z :=
        ⟨G.coeff j, by rw [Polynomial.coeff_coe, ← hG, coeff_map, eq_intCast]⟩
      have hG₀ :
          PowerSeries.constantCoeff (L.arithmeticEulerPolynomial L.motivicWeight p : ℂ⟦X⟧) = 1 := by
        rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, Polynomial.coeff_coe,
          arithmeticEulerPolynomial, comp_C_mul_X_coeff, coeff_zero_eulerPolynomial, pow_zero,
          mul_one]
      rcases PowerSeries.exists_coeff_eq_intCast_of_mul_eq_one hmul hG' hG₀ k with ⟨z, hz⟩
      exact ⟨z, by rwa [PowerSeries.coeff_mk] at hz⟩
    refine ⟨⟨L.motivicWeight, fun n hn ↦ ?_⟩, IntermediateField.adjoin_eq_bot_iff.mpr ?_⟩
    · rcases hint n hn with ⟨z, hz⟩
      exact hz ▸ isIntegral_algebraMap
    · rintro _ ⟨n, hn, rfl⟩
      rcases hint n hn with ⟨z, hz⟩
      exact IntermediateField.mem_bot.mpr ⟨z, by rw [hz, eq_ratCast, Rat.cast_intCast]⟩

/-- **The Riemann zeta function is rational**: its coefficients `aₙ = 1` are integers, and its
motivic weight is `0`. -/
lemma isRational_zeta : zeta.IsRational := by
  have h : ∀ n ≠ 0, IsIntegral ℤ (zeta.arithmeticCoeff 0 n) := fun n _ ↦ by
    simpa [arithmeticCoeff, zeta] using isIntegral_one
  have hw : zeta.motivicWeight = 0 :=
    Nat.sInf_eq_zero.mpr (.inl h)
  refine ⟨⟨0, h⟩, IntermediateField.adjoin_eq_bot_iff.mpr ?_⟩
  rintro _ ⟨n, -, rfl⟩
  rw [hw]
  simp [arithmeticCoeff, zeta]

end AnalyticLFunction
