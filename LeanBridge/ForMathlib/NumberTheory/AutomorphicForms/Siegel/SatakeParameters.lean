import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.SatakeIwasawa
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.SatakeSpherical
import Mathlib.NumberTheory.Padics.PadicVal.Basic

/-!
# The Satake map, Satake parameters and Euler factors of Siegel eigenforms

Let `p` be a prime and `𝓗_p` the local Hecke algebra of `Γ = Sp(2g, ℤ)` at `p`
(`SiegelUpperHalfSpace.localSiegelHeckeRing`). Every right coset `Γx`, `x ∈ S_p`, has a
representative `b = (A, B; 0, D)` in the Borel subgroup (`A` upper triangular, `D = r A⁻ᵀ` lower
triangular), unique up to `B ∩ Γ`; with `r(b) = p^δ` and `D_jj = ±p^{d_j}`, the vector
`(δ; d_0, …, d_{g-1})` is the valuation of `Γx`. For `α = (α₀; α_0, …, α_{g-1}) ∈ (ℂˣ)^{g+1}` the
**Satake map** is the spherical map (`HeckeCoset.sphericalMap`) of the unramified character
`b ↦ α₀^δ ∏_j (α_j p^{-(g-j)})^{d_j}`:
`ω_α(ΓαΓ) = ∑_{Γx ⊆ ΓαΓ} α₀^δ ∏_j (α_j p^{-(g-j)})^{d_j}`, a ring homomorphism `𝓗_p → ℂ`. It is
Andrianov's spherical map (*Quadratic forms and Hecke operators*, §3.3.3, with the Borel subgroup of
upper triangular `D`, there `x_0^δ ∏_j (x_j p^{-j})^{d_j}` with `j = 1, …, g`) evaluated at
`(α₀; α_{g-1}, …, α_0)`: conjugating by the reversal of the coordinates, which lies in `Γ`,
exchanges the two Borel subgroups and reverses the indices.

The **Satake parameters** of a Hecke eigenform `F` at `p` are the `α` with `F ∣ T = ω_α(T) F` for
every `T ∈ 𝓗_p`, that is, the points at which the Satake map is the eigencharacter of `F`; by
Satake's theorem (`𝓗_p` is isomorphic through `ω` to the invariants of the Weyl group `W_g` of
signed permutations, Andrianov Theorem 3.3.30) they exist and form one `W_g`-orbit. The isomorphism
is `SiegelUpperHalfSpace.satakeInvariantsHom_bijective` and the existence of Satake parameters
`SiegelUpperHalfSpace.satakeParametersExist`, in every degree; that they form one orbit is not
proved. The **spinor** and **standard Euler factors** are
`Q_p^spin(X) = ∏_{S ⊆ {0, …, g-1}} (1 - α₀ ∏_{i ∈ S} α_i X)`, of degree `2^g`, and
`Q_p^st(X) = (1 - X) ∏_i (1 - α_i X)(1 - α_i⁻¹ X)`, of degree `2g + 1`; both are invariant under
`W_g`, generated by the permutations of the `α_i` and by `(α₀; α) ↦ (α₀ α_j; …, α_j⁻¹, …)`. With the
normalisation `F ∣_k α = r^{gk - g(g+1)/2} det(CZ + D)^{-k} F(αZ)` of the slash operator
(`SiegelUpperHalfSpace.gspSlash`), the Satake parameters of an eigenform of weight `k` satisfy
`α₀² α_0 ⋯ α_{g-1} = p^{gk - g(g+1)/2}`, since `ω` sends `p 1_{2g}` to
`x₀² x_0 ⋯ x_{g-1} p^{-g(g+1)/2}`. In degree `2` this follows from
`SiegelUpperHalfSpace.satakeMap_T₀`, `ω_α(T_0(p²)) = α₀² α_0 α_1 p⁻³`, and
`SiegelUpperHalfSpace.heckeOperator_T₀_detPowerRep`, by which `T_0(p²)` acts by `p^{2k-6}` in weight
`det^k`; in the other degrees it is not proved. The spinor and standard Euler factors of the Satake
parameters are the classical Euler factors of `L^spin(F, s)` and `L^st(F, s)` (in degree `1`,
`Q_p^spin(X) = 1 - a_p X + p^{k-1} X²`; in degree `2`, Andrianov's
`1 - λ(p) X + (λ(p)² - λ(p²) - p^{2k-4}) X² - p^{2k-3} λ(p) X³ + p^{4k-6} X⁴`). In every degree they
are functions of the Satake map (`SiegelUpperHalfSpace.spinorEulerFactor_eq_of_satakeMap_eq`,
`SiegelUpperHalfSpace.standardEulerFactor_eq_of_satakeMap_eq`), and in degree `2` of the eigenvalues
of `T(p)`, `T_1(p²)` and `T_0(p²)` (`SiegelUpperHalfSpace.spinorEulerFactor_eq_satakeMap`,
`SiegelUpperHalfSpace.standardEulerFactor_eq_satakeMap`), which in weight `det^k` gives Andrianov's
coefficients of `X`, `X³` and `X⁴`. The classical forms themselves, the coefficient of `X²` through
`λ(p²)` and the factor of degree `1`, are not proved: they were checked numerically, by enumerating
the right cosets of `T(p)` and `T_i(p²)` in degrees `1` to `3` (whose images under `ω` are
`W_g`-invariant with the shift `p^{-(g-j)}`, and not with `p^{-(j+1)}`), and against the eigenvalues
of `χ₁₀` and of the Siegel Eisenstein series of degree `2` computed from their Fourier coefficients.

## Main definitions

* `SiegelUpperHalfSpace.spinorEulerFactor`, `SiegelUpperHalfSpace.standardEulerFactor`: the
  spinor and standard Euler factors of Satake parameters.
* `SiegelUpperHalfSpace.satakeValuation`: the valuation `(δ; d)` of the Borel subgroup.
* `SiegelUpperHalfSpace.satakeCharacter`: the unramified character
  `(δ; d) ↦ α₀^δ ∏ (α_j p^{-(g-j)})^{d_j}`.
* `SiegelUpperHalfSpace.satakeMap`: the Satake map `ω_α : 𝓗_p → ℂ`.
* `SiegelUpperHalfSpace.IsSatakeParameter`: `α` is a Satake parameter of `F` at `p`.

## Main theorems

* `SiegelUpperHalfSpace.isSatakeParameter_const`: the nonzero constants of trivial weight have the
  Satake parameters `(p^e; p^g, …, p)`.
* `SiegelUpperHalfSpace.isSatakeParameter_iff`: the Satake parameters of a Hecke eigenform are the
  points at which the Satake map is its eigencharacter.
-/

open Matrix hiding one_zpow zpow_add zpow_mul

open Polynomial

namespace SiegelUpperHalfSpace

variable {n : ℕ} (a₀ : ℂ) (a : Fin n → ℂ) (σ : Equiv.Perm (Fin n)) (j : Fin n)

/-! ### The spinor and the standard Euler factors -/

/-- The **spinor Euler factor** `Q_p^spin(X) = ∏_{S ⊆ {0, …, g-1}} (1 - a₀ ∏_{i ∈ S} a_i X)`, of
degree `2^g` (LMFDB `mf.siegel.lift`, `mf.siegel.lift.miyawaki2`), of Satake parameters
`(a₀; a_0, …, a_{g-1})`: `L^spin(F, s) = ∏_p Q_p^spin(F, p^{-s})⁻¹` in the classical normalisation
of the slash operator. -/
noncomputable def spinorEulerFactor : ℂ[X] :=
  ∏ S : Finset (Fin n), (1 - C (a₀ * ∏ i ∈ S, a i) * X)

/-- The **standard Euler factor** `Q_p^st(X) = (1 - X) ∏_i (1 - a_i X)(1 - a_i⁻¹ X)`, of degree
`2g + 1` (LMFDB `mf.siegel.lift`, `mf.siegel.lift.miyawaki2`), of Satake parameters
`(a₀; a_0, …, a_{g-1})`: `L^st(F, s) = ∏_p Q_p^st(F, p^{-s})⁻¹`. -/
noncomputable def standardEulerFactor : ℂ[X] :=
  (1 - X) * ∏ i, (1 - C (a i) * X) * (1 - C (a i)⁻¹ * X)

lemma spinorEulerFactor_fin_one (b : Fin 1 → ℂ) :
    spinorEulerFactor a₀ b = (1 - C a₀ * X) * (1 - C (a₀ * b 0) * X) := by
  have h : (Finset.univ : Finset (Finset (Fin 1))) = {∅, {0}} := by decide
  rw [spinorEulerFactor, h, Finset.prod_insert (by decide), Finset.prod_singleton]
  simp

lemma spinorEulerFactor_fin_two (b : Fin 2 → ℂ) :
    spinorEulerFactor a₀ b = (1 - C a₀ * X) * (1 - C (a₀ * b 0) * X) * (1 - C (a₀ * b 1) * X) *
      (1 - C (a₀ * (b 0 * b 1)) * X) := by
  have h : (Finset.univ : Finset (Finset (Fin 2))) = {∅, {0}, {1}, {0, 1}} := by decide
  rw [spinorEulerFactor, h, Finset.prod_insert (by decide), Finset.prod_insert (by decide),
    Finset.prod_insert (by decide), Finset.prod_singleton]
  simp only [Finset.prod_empty, mul_one, Finset.prod_singleton, Finset.prod_pair Fin.zero_ne_one]
  ring1

lemma spinorEulerFactor_fin_three (b : Fin 3 → ℂ) :
    spinorEulerFactor a₀ b = (1 - C a₀ * X) * (1 - C (a₀ * b 0) * X) * (1 - C (a₀ * b 1) * X) *
      (1 - C (a₀ * b 2) * X) * (1 - C (a₀ * (b 0 * b 1)) * X) * (1 - C (a₀ * (b 0 * b 2)) * X) *
        (1 - C (a₀ * (b 1 * b 2)) * X) * (1 - C (a₀ * (b 0 * (b 1 * b 2))) * X) := by
  have h : (Finset.univ : Finset (Finset (Fin 3))) =
      {∅, {0}, {1}, {2}, {0, 1}, {0, 2}, {1, 2}, {0, 1, 2}} := by
    decide
  rw [spinorEulerFactor, h, Finset.prod_insert (ι := Finset (Fin 3)) (by decide),
    Finset.prod_insert (ι := Finset (Fin 3)) (by decide),
    Finset.prod_insert (ι := Finset (Fin 3)) (by decide),
    Finset.prod_insert (ι := Finset (Fin 3)) (by decide),
    Finset.prod_insert (ι := Finset (Fin 3)) (by decide),
    Finset.prod_insert (ι := Finset (Fin 3)) (by decide),
    Finset.prod_insert (ι := Finset (Fin 3)) (by decide),
    Finset.prod_singleton (fun S : Finset (Fin 3) ↦ 1 - C (a₀ * ∏ i ∈ S, b i) * X)]
  have h₀₁ : ∏ i ∈ ({0, 1} : Finset (Fin 3)), b i = b 0 * b 1 := Finset.prod_pair (by decide)
  have h₀₂ : ∏ i ∈ ({0, 2} : Finset (Fin 3)), b i = b 0 * b 2 := Finset.prod_pair (by decide)
  have h₁₂ : ∏ i ∈ ({1, 2} : Finset (Fin 3)), b i = b 1 * b 2 := Finset.prod_pair (by decide)
  have h₀₁₂ : ∏ i ∈ ({0, 1, 2} : Finset (Fin 3)), b i = b 0 * (b 1 * b 2) := by
    rw [Finset.prod_insert (by decide), h₁₂]
  rw [h₀₁, h₀₂, h₁₂, h₀₁₂, Finset.prod_empty, mul_one, Finset.prod_singleton, Finset.prod_singleton,
    Finset.prod_singleton]
  ring1

/-! ### The Weyl group of type `C_g` -/

lemma spinorEulerFactor_comp_perm : spinorEulerFactor a₀ (a ∘ σ) = spinorEulerFactor a₀ a :=
  Fintype.prod_equiv (Equiv.finsetCongr σ) _ _ fun S ↦ by
    rw [Equiv.finsetCongr_apply, Finset.prod_map]
    rfl

lemma spinorEulerFactor_update_inv (hj : a j ≠ 0) :
    spinorEulerFactor (a₀ * a j) (Function.update a j (a j)⁻¹) = spinorEulerFactor a₀ a := by
  refine Fintype.prod_equiv ((symmDiff_left_involutive {j}).toPerm _) _ _ fun S ↦
    congrArg (fun x ↦ (1 - C x * X : ℂ[X])) ?_
  simp only [(symmDiff_left_involutive ({j} : Finset (Fin n))).coe_toPerm]
  by_cases hjS : j ∈ S
  · rw [symmDiff_of_ge (Finset.singleton_subset_iff.mpr hjS), Finset.prod_update_of_mem hjS,
      mul_assoc, mul_inv_cancel_left₀ hj]
  · have hd : Disjoint S {j} := Finset.disjoint_singleton_right.mpr hjS
    rw [hd.symmDiff_eq_sup, Finset.sup_eq_union, Finset.prod_union hd, Finset.prod_singleton,
      Finset.prod_update_of_notMem hjS]
    ring1

lemma standardEulerFactor_comp_perm : standardEulerFactor (a ∘ σ) = standardEulerFactor a :=
  congrArg ((1 - X) * ·) (Equiv.prod_comp σ fun i ↦ (1 - C (a i) * X) * (1 - C (a i)⁻¹ * X))

lemma standardEulerFactor_update_inv :
    standardEulerFactor (Function.update a j (a j)⁻¹) = standardEulerFactor a := by
  refine congrArg ((1 - X) * ·) (Finset.prod_congr rfl fun i _ ↦ ?_)
  rcases eq_or_ne i j with rfl | hij
  · rw [Function.update_self, inv_inv, mul_comm]
  · rw [Function.update_of_ne hij]

/-! ### The Satake map -/

/-- The multiplier `r(b)` of an element of the Borel subgroup. -/
noncomputable def borelMultiplier (b : siegelBorel n) : ℚ :=
  multiplier (⟨((b : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ), b.2.1⟩ :
    gspPlus (Fin n))

variable (b b' : siegelBorel n)

lemma borelMultiplier_pos : 0 < borelMultiplier b :=
  multiplier_pos _

variable (p : ℕ)

variable {b j} in
lemma padicValRat_borelDiag_eq_zero (hb : (b : GL (Fin n ⊕ Fin n) ℚ) ∈ heckeGamma (Fin n)) :
    padicValRat p (borelDiag b j) = 0 := by
  have hint (c : siegelBorel n) (hc : (c : GL (Fin n ⊕ Fin n) ℚ) ∈ heckeGamma (Fin n)) :
      ∃ z : ℤ, borelDiag c j = z := by
    rcases hc with ⟨γ, -, hγ⟩
    exact ⟨(γ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) (.inl j) (.inl j), by
      rw [borelDiag, ← hγ]
      rfl⟩
  have hmul : borelDiag (b⁻¹ * b) j = borelDiag b⁻¹ j * borelDiag b j := borelDiag_mul b⁻¹ b j
  rw [inv_mul_cancel, borelDiag_one] at hmul
  rcases hint b hb with ⟨z, hz⟩
  rcases hint b⁻¹ (inv_mem hb) with ⟨z', hz'⟩
  rw [hz, hz', ← Int.cast_mul, eq_comm, Int.cast_eq_one] at hmul
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hmul with ⟨-, h⟩ | ⟨-, h⟩ <;> simp [hz, h]

variable [NeZero n]

lemma borelMultiplier_mul : borelMultiplier (b * b') = borelMultiplier b * borelMultiplier b' := by
  have hb : ((b : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ * J (Fin n) ℚ *
      ((b : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ) =
        borelMultiplier b • J (Fin n) ℚ :=
    transpose_mul_J_mul (⟨((b : GL (Fin n ⊕ Fin n) ℚ) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ), b.2.1⟩ : gspPlus (Fin n))
  have hb' : ((b' : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ *
      J (Fin n) ℚ * ((b' : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ) =
        borelMultiplier b' • J (Fin n) ℚ :=
    transpose_mul_J_mul (⟨((b' : GL (Fin n ⊕ Fin n) ℚ) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ), b'.2.1⟩ : gspPlus (Fin n))
  refine multiplier_eq _ ?_
  have e : (((b * b' : siegelBorel n) : GL (Fin n ⊕ Fin n) ℚ) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ * J (Fin n) ℚ *
        ((b * b' : siegelBorel n) : GL (Fin n ⊕ Fin n) ℚ) =
      ((b' : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ *
        ((((b : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ *
          J (Fin n) ℚ * ((b : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)) *
            ((b' : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)) := by
    simp only [Subgroup.coe_mul, Units.val_mul, transpose_mul, Matrix.mul_assoc]
  rw [e, hb, Matrix.smul_mul, Matrix.mul_smul, ← Matrix.mul_assoc, hb', smul_smul, mul_comm]

lemma borelMultiplier_one : borelMultiplier (1 : siegelBorel n) = 1 :=
  multiplier_eq _ (by simp)

variable {b} in
lemma borelMultiplier_eq_one (hb : (b : GL (Fin n ⊕ Fin n) ℚ) ∈ heckeGamma (Fin n)) :
    borelMultiplier b = 1 := by
  have hs : ((b : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ) ∈
      symplecticGroup (Fin n) ℚ := by
    rcases hb with ⟨γ, -, hγ⟩
    rw [← hγ]
    exact SymplecticGroup.map_mem γ.2 (Int.castRingHom ℚ)
  refine multiplier_eq _ ?_
  rw [one_smul]
  exact SymplecticGroup.mem_iff'.mp hs

variable [Fact p.Prime]

/-- The **valuation** `(δ; d_0, …, d_{g-1})` of `b = (A, B; 0, D)` in the Borel subgroup:
`δ = v_p(r(b))` and `d_j = v_p(D_jj) = v_p(r(b)) - v_p(A_jj)`, a homomorphism to `ℤ × ℤ^g`
(LMFDB `mf.siegel.lift`, through the Satake map). -/
noncomputable def satakeValuation : siegelBorel n →* Multiplicative (ℤ × (Fin n → ℤ)) where
  toFun b := .ofAdd (padicValRat p (borelMultiplier b),
    fun j ↦ padicValRat p (borelMultiplier b) - padicValRat p (borelDiag b j))
  map_one' := by
    simp [borelMultiplier_one, borelDiag_one]
    rfl
  map_mul' b b' := by
    have hr : padicValRat p (borelMultiplier (b * b')) =
        padicValRat p (borelMultiplier b) + padicValRat p (borelMultiplier b') := by
      rw [borelMultiplier_mul,
        padicValRat.mul (borelMultiplier_pos b).ne' (borelMultiplier_pos b').ne']
    rw [← ofAdd_add]
    refine congrArg _ (Prod.ext hr (funext fun j ↦ ?_))
    simp only [hr, borelDiag_mul, Prod.snd_add, Pi.add_apply,
      padicValRat.mul (borelDiag_ne_zero b j) (borelDiag_ne_zero b' j)]
    ring1

variable {b} in
lemma satakeValuation_eq_one (hb : (b : GL (Fin n ⊕ Fin n) ℚ) ∈ heckeGamma (Fin n)) :
    satakeValuation p b = 1 := by
  simp [satakeValuation, borelMultiplier_eq_one hb, padicValRat_borelDiag_eq_zero p hb]
  rfl

/-- The prime `p` as a unit of `ℂ`. -/
noncomputable def primeUnit : ℂˣ :=
  Units.mk0 (p : ℂ) (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero)

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ (GL (Fin n) ℂ) V)
  (f : SiegelUpperHalfSpace (Fin n) → V) (α₀ : ℂˣ) (α : Fin n → ℂˣ)

/-- The **unramified character** `(δ; d_0, …, d_{g-1}) ↦ α₀^δ ∏_j (α_j p^{-(g-j)})^{d_j}` of
`ℤ × ℤ^g` with Satake parameters `(α₀; α_0, …, α_{g-1})`, the shift `p^{-(g-j)}` being the
half sum of the positive roots for the Borel subgroup `SiegelUpperHalfSpace.siegelBorel`. -/
noncomputable def satakeCharacter : Multiplicative (ℤ × (Fin n → ℤ)) →* ℂˣ where
  toFun m := α₀ ^ m.toAdd.1 * ∏ i, (α i * (primeUnit p)⁻¹ ^ (n - (i : ℕ))) ^ m.toAdd.2 i
  map_one' := by simp
  map_mul' m m' := by
    simp only [toAdd_mul, Prod.fst_add, Prod.snd_add, Pi.add_apply, zpow_add,
      Finset.prod_mul_distrib]
    exact mul_mul_mul_comm _ _ _ _

attribute [local instance] Fintype.ofFinite

variable {b} in
lemma satakeCharacter_satakeValuation_eq_one
    (hb : (b : GL (Fin n ⊕ Fin n) ℚ) ∈ heckeGamma (Fin n)) :
    (satakeCharacter p α₀ α).comp (satakeValuation p) b = 1 := by
  rw [MonoidHom.comp_apply, satakeValuation_eq_one p hb, map_one]

/-- The **Satake map** `ω_α : 𝓗_p → ℂ` (LMFDB `mf.siegel.lift`) of the local Hecke algebra of
`Sp(2g, ℤ)` at `p`, at the point `α = (α₀; α_0, …, α_{g-1})`: the ring homomorphism with
`ω_α(ΓαΓ) = ∑_{Γx ⊆ ΓαΓ} α₀^δ ∏_j (α_j p^{-(g-j)})^{d_j}` over the right cosets, `(δ; d)` being the
valuation of the representative of `Γx` in the Borel subgroup
(`SiegelUpperHalfSpace.exists_mem_heckeGamma_mul_mem_siegelBorel`). -/
noncomputable def satakeMap : localSiegelHeckeRing (Fin n) p →+* ℂ :=
  HeckeCoset.sphericalMap ((satakeCharacter p α₀ α).comp (satakeValuation p)) ℂ
    (fun _ hx ↦ exists_mem_heckeGamma_mul_mem_siegelBorel
      (heckeMonoid_le_gspPlusGL (heckeMonoidAt_le_heckeMonoid p hx)))
    fun _ hb ↦ satakeCharacter_satakeValuation_eq_one p α₀ α hb

lemma satakeMap_single (D : HeckeCoset (heckeMonoidAt (Fin n) p) (heckeGamma (Fin n))
    (heckeGamma (Fin n))) (c : ℂ) :
    satakeMap p α₀ α (HeckeCosetModule.single ℂ D c) = c • ∑ w : DoubleCoset.DecompQuotient
      (heckeGamma (Fin n)) (heckeGamma (Fin n)) (D.out : GL (Fin n ⊕ Fin n) ℚ)⁻¹,
        HeckeCoset.borelValue (heckeGamma (Fin n)) ((satakeCharacter p α₀ α).comp
          (satakeValuation p)) (DoubleCoset.rightCosetRep D w) :=
  HeckeCoset.sphericalMap_single _ ℂ _ _ D c

/-! ### Satake parameters -/

/-- `α = (α₀; α_0, …, α_{g-1})` is a **Satake parameter** (LMFDB `mf.siegel.lift`, through the
Euler factors) at `p` of a function `f : ℋ_g → V`: `f` is a nonzero `Sp(2g, ℤ)`-invariant function
of weight `ρ`, an eigenvector of every Hecke operator `T ∈ 𝓗_p` with eigenvalue the Satake map
`ω_α(T)` (`SiegelUpperHalfSpace.satakeMap`). For a Hecke eigenform the Satake parameters exist and
form one orbit of the Weyl group of signed permutations, by Satake's theorem. They exist in every
degree (`SiegelUpperHalfSpace.IsHeckeEigenform.exists_satakeParameter`,
`SiegelUpperHalfSpace.satakeParametersExist`); that they form one orbit is not proved. -/
def IsSatakeParameter : Prop :=
  ∃ hf : f ∈ slashInvariantsOf ρ (heckeMonoidAt (Fin n) p) (heckeGamma (Fin n)), f ≠ 0 ∧
    ∀ D, (heckeOperator ρ D ⟨f, hf⟩ : SiegelUpperHalfSpace (Fin n) → V) =
      satakeMap p α₀ α (HeckeCosetModule.single ℂ D 1) • f

private lemma borelValue_const (x : heckeMonoidAt (Fin n) p) (e : ℤ) :
    HeckeCoset.borelValue (heckeGamma (Fin n)) ((satakeCharacter p (primeUnit p ^ e)
      fun i ↦ primeUnit p ^ (n - (i : ℕ))).comp (satakeValuation p)) (x : GL (Fin n ⊕ Fin n) ℚ) =
        (multiplier (submonoidToGSpPlus x) : ℂ) ^ e := by
  rcases exists_mem_heckeGamma_mul_mem_siegelBorel
    (heckeMonoid_le_gspPlusGL (heckeMonoidAt_le_heckeMonoid p x.2)) with ⟨γ, hγ, hb⟩
  rcases x.2.2 with ⟨k, hk⟩
  have hγs : ((γ : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ *
      J (Fin n) ℚ * (γ : GL (Fin n ⊕ Fin n) ℚ) = J (Fin n) ℚ := by
    rcases hγ with ⟨γ', -, rfl⟩
    exact SymplecticGroup.mem_iff'.mp (SymplecticGroup.map_mem γ'.2 (Int.castRingHom ℚ))
  have hm : borelMultiplier ⟨_, hb⟩ = (p : ℚ) ^ k := by
    refine multiplier_eq _ ?_
    have e : (((γ * (x : GL (Fin n ⊕ Fin n) ℚ) : GL (Fin n ⊕ Fin n) ℚ)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ * J (Fin n) ℚ *
          ((γ * (x : GL (Fin n ⊕ Fin n) ℚ) : GL (Fin n ⊕ Fin n) ℚ)) =
          ((x : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ *
            (((γ : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ)ᵀ *
              J (Fin n) ℚ * (γ : GL (Fin n ⊕ Fin n) ℚ)) * (x : GL (Fin n ⊕ Fin n) ℚ) := by
      simp only [Units.val_mul, transpose_mul, Matrix.mul_assoc]
    rw [e, hγs]
    exact hk
  have hr : multiplier (submonoidToGSpPlus x) = (p : ℚ) ^ k := multiplier_eq _ hk
  have hv : padicValRat p ((p : ℚ) ^ k) = k := by
    rw [padicValRat.pow, padicValRat.self (Fact.out : p.Prime).one_lt, mul_one]
  rw [HeckeCoset.borelValue_eq (fun b hb ↦ satakeCharacter_satakeValuation_eq_one p _ _ hb) hγ hb,
    hr]
  simp only [MonoidHom.comp_apply, satakeValuation, MonoidHom.coe_mk, OneHom.coe_mk,
    satakeCharacter, toAdd_ofAdd, hm, hv, ← mul_pow, mul_inv_cancel, one_pow, one_zpow,
    Finset.prod_const_one, mul_one]
  rw [← zpow_natCast, ← zpow_mul, Units.val_zpow_eq_zpow_val, primeUnit, Units.val_mk0]
  push_cast
  rw [← zpow_mul, mul_comm]

/-- **The nonzero constants of trivial weight have the Satake parameters `(p^e; p^g, …, p)`** at
every prime `p`, `e` being the exponent of the multiplier in the slash operator: every right coset
`Γx` of multiplier `r(x) = p^δ` contributes `p^{eδ} ∏_j (p^{g-j} p^{-(g-j)})^{d_j} = r(x)^e` to the
Satake map, which is its contribution to the Hecke operator on a constant. So
`SiegelUpperHalfSpace.IsSatakeParameter` is satisfied in every degree. -/
lemma isSatakeParameter_const {v : V} (hv : v ≠ 0) :
    IsSatakeParameter p (Representation.trivial ℂ (GL (Fin n) ℂ) V) (Function.const _ v)
      (primeUnit p ^ slashExponent (Representation.trivial ℂ (GL (Fin n) ℂ) V))
      fun i ↦ primeUnit p ^ (n - (i : ℕ)) := by
  have hmem : Function.const _ v ∈ slashInvariants (Representation.trivial ℂ (GL (Fin n) ℂ) V) :=
    ((mem_modularForms_iff_slashInvariants _ _).mp
      (const_mem_modularForms (SymplecticGroup.integral (Fin n)) v)).2
  refine ⟨fun γ hγ ↦ hmem γ hγ, fun h ↦ (isHeckeEigenform_const hv).2.1 (Subtype.ext h),
    fun D ↦ ?_⟩
  rw [coe_heckeOperator, satakeMap_single, one_smul, Finset.sum_smul]
  refine Finset.sum_congr rfl fun w _ ↦ ?_
  have h : heckeMonoidSlash (Representation.trivial ℂ (GL (Fin n) ℂ) V) (heckeRep D w)
      (Function.const _ v) = (multiplier (submonoidToGSpPlus (heckeRep D w)) : ℂ) ^
        slashExponent (Representation.trivial ℂ (GL (Fin n) ℂ) V) • Function.const _ v := by
    ext τ
    simp [heckeMonoidSlash, gspSlash]
  rw [h, ← borelValue_const p (heckeRep D w)]
  rfl

variable {α₀ α} {F : slashInvariantsOf ρ (heckeMonoidAt (Fin n) p) (heckeGamma (Fin n))}

/-- **The Satake parameters of a Hecke eigenform are the points at which the Satake map is its
eigencharacter**: `α` is a Satake parameter of `F` at `p` exactly when the eigencharacter
`T ↦ λ_F(T)` of `F` on the local Hecke algebra `𝓗_p` is `ω_α`. -/
lemma isSatakeParameter_iff (hF : IsHeckeEigenform ρ F) :
    IsSatakeParameter p ρ (F : SiegelUpperHalfSpace (Fin n) → V) α₀ α ↔
      hF.eigencharacter = satakeMap p α₀ α := by
  constructor
  · rintro ⟨_, -, h⟩
    refine RingHom.ext fun T ↦ ?_
    induction T using HeckeCosetModule.induction_linear with
    | h0 => rw [map_zero, map_zero]
    | hadd T₁ T₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
    | hsingle D c =>
      have hD : satakeMap p α₀ α (HeckeCosetModule.single ℂ D 1) = hF.eigenvalue D :=
        hF.eq_eigenvalue D (Subtype.ext (h D))
      rw [hF.eigencharacter_single, ← hD, satakeMap_single, satakeMap_single, one_smul, smul_eq_mul]
  · intro h
    refine ⟨F.2, fun h0 ↦ hF.2.1 (Subtype.ext h0), fun D ↦ ?_⟩
    rw [← h, hF.eigencharacter_single, one_mul, hF.heckeOperator_eq D]
    rfl

end SiegelUpperHalfSpace
