import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.DegreeTwoElementaryDivisors
import TauCeti.NumberTheory.HeckeRing.Associativity
import TauCeti.NumberTheory.HeckeRing.Normalizer

/-!
# Generators of the local Hecke algebra of `Sp(4, ℤ)`

The local Hecke algebra `𝓗_p` of `Γ = Sp(4, ℤ)` at a prime `p`, with complex coefficients, is
generated by `T(p)`, `T_1(p²)` and the scalar `T_0(p²) = Γ (p 1₄) Γ` (Andrianov, *Quadratic forms
and Hecke operators*, §3.3, in degree `2`). Its basis is formed by the double cosets
`T(a, s, t) = Γ diag(p^a, p^{a+s}, p^{a+2s+t}, p^{a+s+t}) Γ`
(`SiegelUpperHalfSpace.exists_eq_heckeCosetDiag`, `SiegelUpperHalfSpace.heckeCosetDiag_injective`).
Multiplying by the scalar `T_0(p²)` raises `a` by one. For `a = 0`, the product
`T(p) · T(0, s, t - 1)` (if `t ≥ 1`) or `T_1(p²) · T(0, s - 1, 0)` (if `t = 0`) contains
`T(0, s, t)` with a positive coefficient, the product of the diagonal representatives lying in it,
and every other double coset `T(a', s', t')` it contains has `a' ≥ 1` or `s' > s`: the power `p^s`
divides every `2 × 2` minor of an element of the product, minors being superadditive. An induction
on the multiplier, and for `a = 0` on `t`, concludes.

## Main results

* `SiegelUpperHalfSpace.mem_of_heckeGenerators`: a subspace of `𝓗_p` containing `1`, `T(p)`,
  `T_1(p²)` and `T_0(p²)` and closed under multiplication is all of `𝓗_p`.
* `SiegelUpperHalfSpace.ringHom_ext_of_heckeGenerators`: two `ℂ`-linear ring homomorphisms
  `𝓗_p → ℂ` agreeing on `T(p)`, `T_1(p²)` and `T_0(p²)` are equal.
-/

open DoubleCoset

open HeckeCosetModule (single single_mul_single smul_single_one structureConstants
  structureConstants_apply sum_def sum_single mem_support_iff)

namespace SiegelUpperHalfSpace

local notation "Γ₂" => heckeGamma (Fin 2)

local notation "GL₄" => GL (Fin 2 ⊕ Fin 2) ℚ

local notation "M₄" => Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ℚ

/-! ### Products of basis elements -/

lemma single_mem_of_single_mul_single_mem {G : Type*} [Group G] {Δ : Submonoid G} {Γ : Subgroup G}
    [IsHeckeTriple Δ Γ Γ] (S : Submodule ℂ (HeckeRing Δ Γ ℂ)) {D₁ D₂ D : HeckeCoset Δ Γ Γ}
    (hP : single ℂ D₁ 1 * single ℂ D₂ 1 ∈ S)
    (hD : multiplicity Γ Γ Γ (D₁.rep : G) (D₂.rep : G) (D.rep : G) ≠ 0)
    (hrest : ∀ D', D' ≠ D → multiplicity Γ Γ Γ (D₁.rep : G) (D₂.rep : G) (D'.rep : G) ≠ 0 →
      single ℂ D' 1 ∈ S) : single ℂ D 1 ∈ S := by
  classical
  rw [single_mul_single, one_smul, one_smul] at hP
  have hmem : D ∈ (structureConstants ℂ Γ Γ Γ D₁.rep D₂.rep).support := by
    rw [mem_support_iff, structureConstants_apply]
    exact Nat.cast_ne_zero.mpr hD
  have hsum : (structureConstants ℂ Γ Γ Γ D₁.rep D₂.rep).sum (single ℂ) =
      structureConstants ℂ Γ Γ Γ D₁.rep D₂.rep :=
    sum_single ℂ (structureConstants ℂ Γ Γ Γ D₁.rep D₂.rep)
  rw [sum_def, ← Finset.add_sum_erase _ _ hmem] at hsum
  have hrest' : ∑ D' ∈ (structureConstants ℂ Γ Γ Γ D₁.rep D₂.rep).support.erase D,
      single ℂ D' (structureConstants ℂ Γ Γ Γ D₁.rep D₂.rep D') ∈ S := by
    refine Submodule.sum_mem _ fun D' hD' ↦ ?_
    rcases Finset.mem_erase.mp hD' with ⟨hD'D, hD'⟩
    rw [mem_support_iff, structureConstants_apply] at hD'
    rw [← smul_single_one]
    exact S.smul_mem _ (hrest D' hD'D (Nat.cast_ne_zero.mp hD'))
  have htop : single ℂ D (structureConstants ℂ Γ Γ Γ D₁.rep D₂.rep D) ∈ S := by
    rw [eq_sub_of_add_eq hsum]
    exact S.sub_mem hP hrest'
  rw [← smul_single_one, structureConstants_apply] at htop
  exact (S.smul_mem_iff (Nat.cast_ne_zero.mpr hD)).mp htop

variable {p : ℕ} [Fact p.Prime] {a s t a' s' t' a'' s'' t'' : ℕ}

lemma multiplicity_heckeCosetDiag_ne_zero :
    multiplicity Γ₂ Γ₂ Γ₂ ((heckeCosetDiag p a s t).rep : GL₄)
      ((heckeCosetDiag p a' s' t').rep : GL₄)
        ((heckeCosetDiag p (a + a') (s + s') (t + t')).rep : GL₄) ≠ 0 := by
  rw [multiplicity_ne_zero_iff]
  rcases mem_doubleCoset.mp (symplecticDiag_mem_doubleCoset_rep (p := p) a s t) with
    ⟨γ₁, hγ₁, γ₂, hγ₂, h₁⟩
  rcases mem_doubleCoset.mp (symplecticDiag_mem_doubleCoset_rep (p := p) a' s' t') with
    ⟨γ₃, hγ₃, γ₄, hγ₄, h₂⟩
  rcases mem_doubleCoset.mp (rep_mem_doubleCoset_symplecticDiag (p := p) (a + a') (s + s')
    (t + t')) with ⟨γ₅, hγ₅, γ₆, hγ₆, h₃⟩
  rw [← symplecticDiag_mul, h₁, h₂] at h₃
  refine mem_doubleCoset.mpr ⟨γ₅ * γ₁ * (heckeCosetDiag p a s t).rep * (γ₂ * γ₃),
    mem_doubleCoset.mpr ⟨γ₅ * γ₁, mul_mem hγ₅ hγ₁, γ₂ * γ₃, mul_mem hγ₂ hγ₃, rfl⟩, γ₄ * γ₆,
      mul_mem hγ₄ hγ₆, ?_⟩
  rw [h₃]
  group

lemma le_of_multiplicity_ne_zero (h : multiplicity Γ₂ Γ₂ Γ₂ ((heckeCosetDiag p a s t).rep : GL₄)
    ((heckeCosetDiag p a' s' t').rep : GL₄) ((heckeCosetDiag p a'' s'' t'').rep : GL₄) ≠ 0) :
    2 * a + s + (2 * a' + s') ≤ 2 * a'' + s'' := by
  rcases mem_doubleCoset.mp (multiplicity_ne_zero_iff.mp h) with ⟨w, hw, k, hk, hd⟩
  rcases mem_doubleCoset.mp hw with ⟨γ, hγ, γ', hγ', rfl⟩
  have hG : MinorsDvd p (2 * a + s) ((heckeCosetDiag p a s t).rep : GL₄) :=
    (minorsDvd_symplecticDiag a s t).of_mem_doubleCoset (rep_mem_doubleCoset_symplecticDiag a s t)
  have hH : MinorsDvd p (2 * a' + s') ((heckeCosetDiag p a' s' t').rep : GL₄) :=
    (minorsDvd_symplecticDiag a' s' t').of_mem_doubleCoset
      (rep_mem_doubleCoset_symplecticDiag a' s' t')
  have hD : MinorsDvd p (2 * a + s + (2 * a' + s')) ((heckeCosetDiag p a'' s'' t'').rep : GL₄) := by
    rw [hd]
    simpa using ((((minorsDvd_zero_of_mem hγ).mul hG).mul (minorsDvd_zero_of_mem hγ')).mul
      hH).mul (minorsDvd_zero_of_mem hk)
  exact le_of_minorsDvd_symplecticDiag (hD.of_mem_doubleCoset
    (symplecticDiag_mem_doubleCoset_rep a'' s'' t''))

lemma eq_of_multiplicity_ne_zero (h : multiplicity Γ₂ Γ₂ Γ₂ ((heckeCosetDiag p a s t).rep : GL₄)
    ((heckeCosetDiag p a' s' t').rep : GL₄) ((heckeCosetDiag p a'' s'' t'').rep : GL₄) ≠ 0) :
    2 * a'' + 2 * s'' + t'' = 2 * a + 2 * s + t + (2 * a' + 2 * s' + t') := by
  rcases mem_doubleCoset.mp (multiplicity_ne_zero_iff.mp h) with ⟨w, hw, k, hk, hd⟩
  have hdet : ((symplecticDiag p a'' s'' t'' : GL₄) : M₄).det =
      (((heckeCosetDiag p a'' s'' t'').rep : GL₄) : M₄).det :=
    det_eq_of_mem_doubleCoset (symplecticDiag_mem_doubleCoset_rep a'' s'' t'')
  rw [hd, Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul,
    det_eq_of_mem_doubleCoset hw, det_eq_one_of_mem hk,
    det_eq_of_mem_doubleCoset (rep_mem_doubleCoset_symplecticDiag (p := p) a s t),
    det_eq_of_mem_doubleCoset (rep_mem_doubleCoset_symplecticDiag (p := p) a' s' t'),
    det_symplecticDiag, det_symplecticDiag, det_symplecticDiag, mul_one, ← pow_add] at hdet
  have h' : 4 * a'' + 4 * s'' + 2 * t'' = 4 * a + 4 * s + 2 * t + (4 * a' + 4 * s' + 2 * t') :=
    Nat.pow_right_injective (Fact.out : p.Prime).two_le (by exact_mod_cast hdet)
  omega

lemma coe_symplecticDiag_zero_zero (a : ℕ) :
    ((symplecticDiag p a 0 0 : GL₄) : M₄) = ((p : ℚ) ^ a) • 1 := by
  rw [coe_symplecticDiag]
  ext i j
  rcases eq_or_ne i j with rfl | hij
  · rcases i with i | i <;> fin_cases i <;> simp [diagExp]
  · simp [hij]

variable (p) in
lemma heckeCosetDiag_zero : heckeCosetDiag p 0 0 0 = 1 := by
  refine congrArg (HeckeCoset.mk Γ₂ Γ₂) (Subtype.ext (Units.ext ?_))
  rw [coe_symplecticDiag_zero_zero, pow_zero, one_smul]
  rfl

lemma coe_symplecticDiag_one_zero_zero : ((symplecticDiag p 1 0 0 : GL₄) : M₄) = (p : ℚ) • 1 := by
  rw [coe_symplecticDiag_zero_zero, pow_one]

lemma symplecticDiag_one_zero_zero_mul (g : GL₄) :
    (symplecticDiag p 1 0 0 : GL₄) * g = g * symplecticDiag p 1 0 0 := by
  refine Units.ext ?_
  rw [Units.val_mul, Units.val_mul, coe_symplecticDiag_one_zero_zero, Matrix.smul_mul,
    Matrix.mul_smul, Matrix.one_mul, Matrix.mul_one]

lemma single_heckeCosetDiag_one_mul :
    single ℂ (heckeCosetDiag p 1 0 0) 1 * single ℂ (heckeCosetDiag p a s t) 1 =
      single ℂ (heckeCosetDiag p (a + 1) s t) 1 := by
  have hn : ((symplecticDiag p 1 0 0 : heckeMonoidAt (Fin 2) p) : GL₄) ∈
      Subgroup.normalizer (Γ₂ : Set GL₄) :=
    Subgroup.mem_normalizer_iff.mpr fun h ↦ by
      rw [symplecticDiag_one_zero_zero_mul h, mul_inv_cancel_right]
  rw [heckeCosetDiag, heckeCosetDiag, HeckeCosetModule.single_mul_single_of_mem_normalizer ℂ hn,
    heckeCosetDiag]
  refine congrArg (fun D ↦ single ℂ D 1) (congrArg (HeckeCoset.mk Γ₂ Γ₂) (Subtype.ext ?_))
  rw [Submonoid.coe_mul, symplecticDiag_mul, add_comm 1 a, zero_add, zero_add]

/-- **The local Hecke algebra of `Sp(4, ℤ)` at `p` is generated by `T(p)`, `T_1(p²)` and
`T_0(p²)`**: a subspace of `𝓗_p` containing `1`, `T(p) = T(0, 0, 1)`, `T_1(p²) = T(0, 1, 0)` and
`T_0(p²) = T(1, 0, 0)` and closed under multiplication is all of `𝓗_p`. -/
lemma mem_of_heckeGenerators (S : Submodule ℂ (localSiegelHeckeRing (Fin 2) p)) (h1 : 1 ∈ S)
    (hmul : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ S) (hT : single ℂ (heckeCosetDiag p 0 0 1) 1 ∈ S)
    (hT₁ : single ℂ (heckeCosetDiag p 0 1 0) 1 ∈ S) (hT₀ : single ℂ (heckeCosetDiag p 1 0 0) 1 ∈ S)
    (T : localSiegelHeckeRing (Fin 2) p) : T ∈ S := by
  have key (n : ℕ) : ∀ a s t, 2 * a + 2 * s + t = n → single ℂ (heckeCosetDiag p a s t) 1 ∈ S := by
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      have hA (a s t : ℕ) (h : 2 * (a + 1) + 2 * s + t = n) :
          single ℂ (heckeCosetDiag p (a + 1) s t) 1 ∈ S := by
        rw [← single_heckeCosetDiag_one_mul]
        exact hmul _ hT₀ _ (ih _ (by omega) a s t rfl)
      intro a s t hn
      rcases a with _ | a
      · induction t using Nat.strong_induction_on generalizing s with
        | _ t iht =>
          rcases t with _ | t
          · rcases s with _ | s
            · rw [heckeCosetDiag_zero, ← HeckeCosetModule.one_def]
              exact h1
            · have htop : multiplicity Γ₂ Γ₂ Γ₂ ((heckeCosetDiag p 0 1 0).rep : GL₄)
                  ((heckeCosetDiag p 0 s 0).rep : GL₄)
                    ((heckeCosetDiag p 0 (1 + s) 0).rep : GL₄) ≠ 0 :=
                multiplicity_heckeCosetDiag_ne_zero (a := 0) (t := 0) (a' := 0) (t' := 0)
              rw [add_comm] at htop
              refine single_mem_of_single_mul_single_mem S (hmul _ hT₁ _ (ih _ (by omega) 0 s 0
                rfl)) htop fun D hD hm ↦ ?_
              rcases exists_eq_heckeCosetDiag D with ⟨a', s', t', rfl⟩
              have h₁ : 2 * 0 + 1 + (2 * 0 + s) ≤ 2 * a' + s' := le_of_multiplicity_ne_zero hm
              have h₂ : 2 * a' + 2 * s' + t' = 2 * 0 + 2 * 1 + 0 + (2 * 0 + 2 * s + 0) :=
                eq_of_multiplicity_ne_zero hm
              rcases a' with _ | a'
              · exact absurd (by rw [show s' = s + 1 by omega, show t' = 0 by omega]) hD
              · exact hA a' s' t' (by omega)
          · have htop : multiplicity Γ₂ Γ₂ Γ₂ ((heckeCosetDiag p 0 0 1).rep : GL₄)
                ((heckeCosetDiag p 0 s t).rep : GL₄)
                  ((heckeCosetDiag p 0 (0 + s) (1 + t)).rep : GL₄) ≠ 0 :=
              multiplicity_heckeCosetDiag_ne_zero (a := 0) (a' := 0)
            rw [zero_add, add_comm] at htop
            refine single_mem_of_single_mul_single_mem S (hmul _ hT _ (ih _ (by omega) 0 s t
              rfl)) htop fun D hD hm ↦ ?_
            rcases exists_eq_heckeCosetDiag D with ⟨a', s', t', rfl⟩
            have h₁ : 2 * 0 + 0 + (2 * 0 + s) ≤ 2 * a' + s' := le_of_multiplicity_ne_zero hm
            have h₂ : 2 * a' + 2 * s' + t' = 2 * 0 + 2 * 0 + 1 + (2 * 0 + 2 * s + t) :=
              eq_of_multiplicity_ne_zero hm
            rcases a' with _ | a'
            · rcases eq_or_ne s' s with rfl | hs
              · exact absurd (by rw [show t' = t + 1 by omega]) hD
              · exact iht t' (by omega) s' (by omega)
            · exact hA a' s' t' (by omega)
      · exact hA a s t hn
  induction T using HeckeCosetModule.induction_linear with
  | h0 => exact S.zero_mem
  | hadd f g hf hg => exact S.add_mem hf hg
  | hsingle D c =>
    rcases exists_eq_heckeCosetDiag D with ⟨a, s, t, rfl⟩
    rw [← smul_single_one]
    exact S.smul_mem c (key _ a s t rfl)

/-- **Two `ℂ`-linear ring homomorphisms on the local Hecke algebra of `Sp(4, ℤ)` agreeing on
`T(p)`, `T_1(p²)` and `T_0(p²)` are equal**, by `SiegelUpperHalfSpace.mem_of_heckeGenerators`. -/
lemma ringHom_ext_of_heckeGenerators {f g : localSiegelHeckeRing (Fin 2) p →+* ℂ}
    (hf : ∀ (c : ℂ) x, f (c • x) = c * f x) (hg : ∀ (c : ℂ) x, g (c • x) = c * g x)
    (hT : f (single ℂ (heckeCosetDiag p 0 0 1) 1) = g (single ℂ (heckeCosetDiag p 0 0 1) 1))
    (hT₁ : f (single ℂ (heckeCosetDiag p 0 1 0) 1) = g (single ℂ (heckeCosetDiag p 0 1 0) 1))
    (hT₀ : f (single ℂ (heckeCosetDiag p 1 0 0) 1) = g (single ℂ (heckeCosetDiag p 1 0 0) 1)) :
    f = g := by
  let S : Submodule ℂ (localSiegelHeckeRing (Fin 2) p) :=
    { carrier := {x | f x = g x}
      add_mem' := fun {x y} hx hy ↦ by
        simp only [Set.mem_ofPred_eq, map_add] at hx hy ⊢
        rw [hx, hy]
      zero_mem' := by simp
      smul_mem' := fun c x hx ↦ by
        simp only [Set.mem_ofPred_eq] at hx ⊢
        rw [hf, hg, hx] }
  refine RingHom.ext fun x ↦
    mem_of_heckeGenerators S (by simp [S]) (fun x hx y hy ↦ ?_) hT hT₁ hT₀ x
  simp only [S, Submodule.mem_mk, AddSubmonoid.mem_mk, AddSubsemigroup.mem_mk, Set.mem_ofPred_eq,
    map_mul] at hx hy ⊢
  rw [hx, hy]

end SiegelUpperHalfSpace
