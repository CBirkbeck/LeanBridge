import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.DegreeTwo
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.GaloisOrbit
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.ParamodularLevelRaising
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.PeterssonProduct

/-!
# Old and new subspaces of paramodular cusp forms, and paramodular newforms

The space `S_ρ(K(N))` of paramodular cusp forms of degree `2`, weight `ρ` and level `N` contains
the old subspace `S_ρ^old(K(N))`, generated by the cusp forms of level `N` in the image of the level
raising operators of Roberts and Schmidt from lower levels: `θ` and `θ'` from level `N / p` and `η`
from level `N / p²`, for the primes `p` dividing `N` (resp. with `p² ∣ N`). A composite of these
operators from a lower level ends with one of them, so its image lies in the old subspace, the
operators preserving cusp forms (not proved here). The operators `θ'` and `η` are identified with
those of Roberts and Schmidt without their book at hand (see
`SiegelUpperHalfSpace.levelRaisingThetaPrime`). The new subspace `S_ρ^new(K(N))` is the
orthogonal complement of the old subspace for the Petersson inner product, and the newforms are the
Hecke eigenforms in it. The LMFDB uses weights `ρ = ρ_{k,j} = det^k ⊗ Sym^j`
(`SiegelUpperHalfSpace.rhoKJ`) and trivial character for paramodular forms; the spaces are defined
here for any weight `ρ` and trivial character. That `S_ρ(K(N)) = S_ρ^old(K(N)) ⊕ S_ρ^new(K(N))`
and that the newforms form a basis of the new subspace are theorems which are not proved here.

## Main definitions

* `SiegelUpperHalfSpace.paramodularCuspForms`: the space `S_ρ(K(N))`.
* `SiegelUpperHalfSpace.levelRaisingImage`: the image of the cusp forms of a lower level under a
  level raising operator.
* `SiegelUpperHalfSpace.paramodularOldSubspace` (LMFDB `mf.siegel.newspace`, `mf.siegel.newform`):
  the old subspace `S_ρ^old(K(N))`.
* `SiegelUpperHalfSpace.paramodularNewSubspace` (LMFDB `mf.siegel.newspace`, `mf.siegel.newform`):
  the new subspace `S_ρ^new(K(N))`.
* `SiegelUpperHalfSpace.IsParamodularNewform` (LMFDB `mf.siegel.newform`): paramodular newforms.
* `SiegelUpperHalfSpace.newformSubspace` (LMFDB `mf.siegel.newform_subspace`): the span of the
  Galois conjugates of a form.
* `SiegelUpperHalfSpace.IsNotFromLowerLevel` (LMFDB `mf.siegel.newform.paramodular`): the form is
  not the image of a cusp form of lower level under a level raising operator.

## Main results

* `SiegelUpperHalfSpace.paramodularOldSubspace_one`: there are no old forms in level `1`.
* `SiegelUpperHalfSpace.paramodularNewSubspace_one`: in level `1` every cusp form is new.
-/

namespace SiegelUpperHalfSpace

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ (GL (Fin 2) ℂ) V)
    (N : ℕ+)

/-- The space `S_ρ(K(N))` of **paramodular cusp forms** of degree `2`, weight `ρ` and level `N`,
with trivial character: the cusp forms on the paramodular group `K(N)`. -/
abbrev paramodularCuspForms : Submodule ℂ (SiegelUpperHalfSpace (Fin 2) → V) :=
  cuspForms ρ (paramodularLevel N) 1

variable {N} {M : ℕ+}

/-- The image of the paramodular cusp forms `S_ρ(K(M))` of level `M` under an operator `T` from the
`K(M)`-invariant to the `K(N)`-invariant functions, such as a level raising operator. -/
def levelRaisingImage
    (T : slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel M)) →ₗ[ℂ]
      slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel N))) :
    Submodule ℂ (SiegelUpperHalfSpace (Fin 2) → V) :=
  ((paramodularCuspForms ρ M).comap
    (slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel M))).subtype).map
      ((slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel N))).subtype ∘ₗ T)

variable (N)

/-- The **old subspace** `S_ρ^old(K(N))` (LMFDB `mf.siegel.newspace`, `mf.siegel.newform`) of the
paramodular cusp forms of level `N`: the subspace generated by the cusp forms of level `N` in the
image of the level raising operators `θ`, `θ'` from level `N / p` and `η` from level `N / p²`, for
the primes `p` with `p ∣ N` (resp. `p² ∣ N`) (`SiegelUpperHalfSpace.levelRaisingTheta`,
`SiegelUpperHalfSpace.levelRaisingThetaPrime`, `SiegelUpperHalfSpace.levelRaisingEta`). The
operators preserve cusp forms, which is not proved here; the intersection with `S_ρ(K(N))` follows
the knowl's wording. -/
noncomputable def paramodularOldSubspace : Submodule ℂ (SiegelUpperHalfSpace (Fin 2) → V) :=
  (⨆ (p : ℕ+) (_ : (p : ℕ).Prime) (M : ℕ+) (_ : M * p = N),
    paramodularCuspForms ρ N ⊓ levelRaisingImage ρ (levelRaisingTheta ρ M p) ⊔
      paramodularCuspForms ρ N ⊓ levelRaisingImage ρ (levelRaisingThetaPrime ρ M p)) ⊔
    ⨆ (p : ℕ+) (_ : (p : ℕ).Prime) (M : ℕ+) (_ : M * p * p = N),
      paramodularCuspForms ρ N ⊓ levelRaisingImage ρ (levelRaisingEta ρ M p)

lemma paramodularOldSubspace_le : paramodularOldSubspace ρ N ≤ paramodularCuspForms ρ N :=
  sup_le (iSup₂_le fun _ _ ↦ iSup₂_le fun _ _ ↦ sup_le inf_le_left inf_le_left)
    (iSup₂_le fun _ _ ↦ iSup₂_le fun _ _ ↦ inf_le_left)

private lemma not_prime_of_mul_eq_one {p : ℕ+} (h : M * p = 1) : ¬(p : ℕ).Prime := fun hp ↦
  hp.ne_one <| Nat.eq_one_of_mul_eq_one_left (m := (M : ℕ)) (by exact_mod_cast congrArg PNat.val h)

/-- **There are no old paramodular forms in level `1`**, no prime dividing `1`. -/
lemma paramodularOldSubspace_one : paramodularOldSubspace ρ 1 = ⊥ := by
  refine eq_bot_iff.mpr (sup_le (iSup₂_le fun p hp ↦ iSup₂_le fun M hM ↦ ?_)
    (iSup₂_le fun p hp ↦ iSup₂_le fun M hM ↦ ?_)) <;>
  exact absurd hp (not_prime_of_mul_eq_one hM)

variable (b : V →ₗ[ℂ] V →ₗ⋆[ℂ] ℂ)

/-- The **new subspace** `S_ρ^new(K(N))` (LMFDB `mf.siegel.newspace`, `mf.siegel.newform`) of the
paramodular cusp forms of level `N`: the orthogonal complement of the old subspace
`S_ρ^old(K(N))` in `S_ρ(K(N))` for the Petersson inner product with respect to a Hermitian form `b`
on `V` (`SiegelUpperHalfSpace.peterssonOrthogonal`); for an admissible inner product `b`
(`SiegelUpperHalfSpace.IsAdmissibleForm`), such as `(innerₛₗ ℂ).flip`, `b(v, w) = v w̄`, for scalar
weights, this is the Petersson inner product. For an irreducible `ρ` the admissible inner products
are proportional, so the new subspace does not depend on the choice. -/
noncomputable def paramodularNewSubspace : Submodule ℂ (SiegelUpperHalfSpace (Fin 2) → V) :=
  peterssonOrthogonal (paramodularLevel N) ρ b (paramodularCuspForms ρ N)
    (paramodularOldSubspace ρ N)

lemma paramodularNewSubspace_le : paramodularNewSubspace ρ N b ≤ paramodularCuspForms ρ N :=
  fun _ hf ↦ hf.1

/-- **In level `1` every paramodular cusp form is new**, there being no old forms. -/
lemma paramodularNewSubspace_one : paramodularNewSubspace ρ 1 b = paramodularCuspForms ρ 1 := by
  refine le_antisymm (paramodularNewSubspace_le ρ 1 b) fun f hf ↦ ⟨hf, fun g hg ↦ ?_⟩
  rw [paramodularOldSubspace_one, Submodule.mem_bot] at hg
  rw [hg]
  exact isPeterssonOrthogonal_of_peterssonIntegrand_eq_zero _ (peterssonIntegrand_zero_right f)

/-- A **paramodular newform** (LMFDB `mf.siegel.newform`) of level `N` and weight `ρ`: a Hecke
eigenform `F` on `K(N)` (`SiegelUpperHalfSpace.IsHeckeEigenform`, an eigenvector of every Hecke
operator of `K(N)`) lying in the new subspace `S_ρ^new(K(N))`. The knowl normalises newforms by a
first Fourier coefficient `a_1 = 1`, which is not defined for Siegel modular forms, whose Fourier
coefficients are indexed by half-integral matrices; newforms are taken here up to a scalar. -/
def IsParamodularNewform (F : slashInvariantsOf ρ (heckeMonoidOf (paramodularLevel N))
    (heckeGammaOf (paramodularLevel N))) : Prop :=
  (F : SiegelUpperHalfSpace (Fin 2) → V) ∈ paramodularNewSubspace ρ N b ∧ IsHeckeEigenform ρ F

variable {ι : Type*} (B : Module.Basis ι ℂ V) (f : SiegelUpperHalfSpace (Fin 2) → V)

/-- The **newform subspace** (LMFDB `mf.siegel.newform_subspace`) of a paramodular newform `f` of
level `N`: the subspace generated by the Galois conjugates `σ(f)` of `f`, relative to a basis `B` of
`V` (`SiegelUpperHalfSpace.IsGaloisConjugate`). The knowl also describes it as the subspace
generated by the `T(f)` for the Hecke operators `T(p)`, `T_1(p²)`, `p ∤ N`; read literally this is
`ℂ f`, `f` being an eigenform, and the intended subspace is the span of the Galois conjugates. That
the newspace decomposes into newform subspaces is not proved here. -/
def newformSubspace : Submodule ℂ (SiegelUpperHalfSpace (Fin 2) → V) :=
  Submodule.span ℂ {g | IsGaloisConjugate (paramodularLevel N) B f g}

lemma self_mem_newformSubspace {a : dualLattice (paramodularLevel N) → V}
    (ha : HasSiegelFourierExpansion (paramodularLevel N) f a) : f ∈ newformSubspace N B f :=
  Submodule.subset_span (IsGaloisConjugate.refl B ha)

/-- A function `f : ℋ₂ → V`, such as a paramodular form of level `N`, is **not obtained from a lower
level** (LMFDB `mf.siegel.newform.paramodular`): it is not the image of a cusp form of level `N / p`
under the level raising operators `θ` or `θ'`, nor of a cusp form of level `N / p²` under `η`, for
a prime `p`. A composite of these operators from a lower level ends with one of them, so this
excludes their images too, the operators preserving cusp forms (not proved here). The knowl names
the level raising operators `V_m^±` and `U_m` without defining them; the operators `θ`, `θ'` and
`η` at the primes `p` of Roberts and Schmidt, whom it cites, are used here. -/
def IsNotFromLowerLevel : Prop :=
  (∀ p : ℕ+, (p : ℕ).Prime → ∀ M : ℕ+, M * p = N →
    f ∉ levelRaisingImage ρ (levelRaisingTheta ρ M p) ∧
      f ∉ levelRaisingImage ρ (levelRaisingThetaPrime ρ M p)) ∧
    ∀ p : ℕ+, (p : ℕ).Prime → ∀ M : ℕ+, M * p * p = N →
      f ∉ levelRaisingImage ρ (levelRaisingEta ρ M p)

end SiegelUpperHalfSpace
