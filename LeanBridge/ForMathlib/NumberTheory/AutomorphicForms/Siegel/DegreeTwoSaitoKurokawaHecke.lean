import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.DegreeTwoSatakeTheorem
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.MaassLiftCuspForm

/-!
# The Saito–Kurokawa lifts and the Hecke operators of `Sp(4, ℤ)`

`SiegelUpperHalfSpace.SaitoKurokawaSpinTheorem` asks for the Satake parameters
`(p^{k-1}; γ₊ p^{1-k}, γ₋ p^{1-k})` at every prime `p` of a Saito–Kurokawa lift `F` of a normalised
Hecke eigenform `f ∈ S_{2k}(SL(2, ℤ))`, `γ_±` being those of `f`
(`SiegelUpperHalfSpace.saitoKurokawaSpinTheorem_of_isSatakeParameter`). Since the local Hecke
algebra is generated by `T(p)`, `T_1(p²)` and `T_0(p²)`
(`SiegelUpperHalfSpace.isSatakeParameter_of_heckeGenerators`), they are Satake parameters of `F`
as soon as `F` is a nonzero eigenvector of these three Hecke operators with the eigenvalues of the
Satake map at that point:

* `λ(T(p)) = a_p(f) + p^{k-1} + p^k`;
* `λ(T_1(p²)) = (p + 1) p^{k-2} a_p(f) + p^{2k-2} - p^{2k-4}`;
* `λ(T_0(p²)) = p^{2k-4}`.

The last holds for every `Γ`-invariant function of weight `k + 1`: the Hecke operator of the scalar
`T_0(p²)` is the slash operator of `p 1₄`, which is `p^{2κ-6}` in weight `κ`
(`SiegelUpperHalfSpace.heckeOperator_T₀_detPowerRep`), and a Saito–Kurokawa lift is
`Γ`-invariant of weight `k + 1` by the theorem of Maass. The first two, the Hecke equivariance of
the Maass lift read on Fourier coefficients, and the nonvanishing of the lift are not proved here;
the theorem below reduces `SiegelUpperHalfSpace.SaitoKurokawaSpinTheorem` to them. For `χ₁₀`, the
lift of the newform `Δ E₆` of `S_18` (`a_2 = -528`, `a_3 = -4284`), both agree with the eigenvalues
computed from its Fourier coefficients at `p = 2, 3`: `λ(T(2)) = 240`, `λ(T(3)) = 21960`,
`λ(T_1(4)) = -153600`, `λ(T_1(9)) = 787320`.

## Main results

* `SiegelUpperHalfSpace.heckeOperator_T₀_detPowerRep`: `T_0(p²)` acts by `p^{2κ-6}` in weight `κ`.
* `SiegelUpperHalfSpace.saitoKurokawaSpinTheorem_of_heckeOperator`: the spin `L`-function of the
  Saito–Kurokawa lifts follows from the eigenvalues of `T(p)` and `T_1(p²)`.
-/

open HeckeRing GL2 UpperHalfPlane

namespace SiegelUpperHalfSpace

local notation "Γ₂" => heckeGamma (Fin 2)

variable {p : ℕ} [Fact p.Prime]

/-- **The Hecke operator `T_0(p²)` in scalar weight `κ`** is the multiplication by `p^{2κ-6}`. -/
lemma heckeOperator_T₀_detPowerRep (κ : ℤ)
    (F : slashInvariantsOf (TauCeti.detPowerRep ℂ 2 κ) (heckeMonoidAt (Fin 2) p) Γ₂) :
    heckeOperator (TauCeti.detPowerRep ℂ 2 κ) (heckeCosetDiag p 1 0 0) F =
      ((p : ℂ) ^ 2) ^ (κ - 3) • F :=
  Subtype.ext <| (heckeOperator_T₀ F).trans <| (congrArg (gspSlash (TauCeti.detPowerRep ℂ 2 κ) · F)
    submonoidToGSpPlus_symplecticDiag).trans (heckeMonoidSlash_scalarGSp κ _ F)

lemma IsSaitoKurokawaLift.mem_slashInvariants {k : ℤ} {f : Newform 1 (2 * k)}
    {F : SiegelUpperHalfSpace (Fin 2) → ℂ} (hF : IsSaitoKurokawaLift k f F) :
    F ∈ slashInvariants (TauCeti.detPowerRep ℂ 2 (k + 1)) := by
  rcases hF with ⟨φ, hφ, -, -, rfl⟩
  exact ((mem_modularForms_iff_slashInvariants _ _).mp
    (maassLiftTheorem.mem_modularForms (k + 1) φ hφ.1)).2

/-- **The spin `L`-function of the Saito–Kurokawa lifts from two Hecke eigenvalues**:
`SiegelUpperHalfSpace.SaitoKurokawaSpinTheorem` holds as soon as every Saito–Kurokawa lift `F` of
`f ∈ S_{2k}(SL(2, ℤ))` is, at every prime `p`, a nonzero `Sp(4, ℤ)`-invariant function of weight
`k + 1` with `F ∣ T(p) = (a_p(f) + p^{k-1} + p^k) F` and
`F ∣ T_1(p²) = ((p + 1) p^{k-2} a_p(f) + p^{2k-2} - p^{2k-4}) F`. The membership asked for holds by
the theorem of Maass (`SiegelUpperHalfSpace.IsSaitoKurokawaLift.mem_slashInvariants`); the
nonvanishing and the two eigenvalue identities are not proved. -/
lemma saitoKurokawaSpinTheorem_of_heckeOperator
    (h : ∀ (k : ℤ) (f : Newform 1 (2 * k)) (F : SiegelUpperHalfSpace (Fin 2) → ℂ),
      IsSaitoKurokawaLift k f F → ∀ (p : ℕ) [Fact p.Prime],
        ∃ hF : F ∈ slashInvariantsOf (TauCeti.detPowerRep ℂ 2 (k + 1)) (heckeMonoidAt (Fin 2) p) Γ₂,
          F ≠ 0 ∧ heckeOperator (TauCeti.detPowerRep ℂ 2 (k + 1)) (heckeCosetDiag p 0 0 1)
            ⟨F, hF⟩ = ((qExpansion 1 f.toCuspForm).coeff p + (p : ℂ) ^ (k - 1) + (p : ℂ) ^ k) •
              ⟨F, hF⟩ ∧ heckeOperator (TauCeti.detPowerRep ℂ 2 (k + 1)) (heckeCosetDiag p 0 1 0)
            ⟨F, hF⟩ = (((p : ℂ) + 1) * (p : ℂ) ^ (k - 2) * (qExpansion 1 f.toCuspForm).coeff p +
              (p : ℂ) ^ (2 * k - 2) - (p : ℂ) ^ (2 * k - 4)) • ⟨F, hF⟩) :
    SaitoKurokawaSpinTheorem := by
  refine saitoKurokawaSpinTheorem_of_isSatakeParameter fun k f F hF p _ a b hab ↦ ?_
  rcases h k f F hF p with ⟨hF', hF₀, hT, hT₁⟩
  rcases (f.satakeParameters_eq_pair_iff p).mp hab with ⟨hs, hpr⟩
  rw [f.dirichletLift_natCast_eq_one, one_mul] at hpr
  have hp' : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  have hp : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hp'
  have ht : (p : ℂ) ^ (k - 1) ≠ 0 := zpow_ne_zero _ hp
  have ha : a ≠ 0 := f.ne_zero_of_mem_satakeParameters p hp' (by rw [hab]; simp)
  have hb : b ≠ 0 := f.ne_zero_of_mem_satakeParameters p hp' (by rw [hab]; simp)
  have hu : (p : ℂ) ^ (1 - k) = ((p : ℂ) ^ (k - 1))⁻¹ := by
    rw [← zpow_neg, neg_sub]
  have hk : (p : ℂ) ^ k = p * (p : ℂ) ^ (k - 1) := by
    rw [← zpow_one_add₀ hp, add_sub_cancel]
  have hk₂ : (p : ℂ) ^ (k - 2) = (p : ℂ) ^ (k - 1) * (p : ℂ)⁻¹ := by
    rw [← zpow_sub_one₀ hp]
    exact congrArg _ (by ring1)
  have h₂ : (p : ℂ) ^ (2 * k - 2) = ((p : ℂ) ^ (k - 1)) ^ 2 := by
    rw [← zpow_natCast, ← zpow_mul]
    exact congrArg _ (by push_cast; ring1)
  have h₄ : (p : ℂ) ^ (2 * k - 4) = ((p : ℂ) ^ (k - 1)) ^ 2 * ((p : ℂ) ^ 2)⁻¹ := by
    rw [← zpow_natCast, ← zpow_mul, ← zpow_natCast (p : ℂ) 2, ← zpow_neg, ← zpow_add₀ hp]
    exact congrArg _ (by push_cast; ring1)
  have h₁ : (p : ℂ) ^ (2 * k - 1) = p * ((p : ℂ) ^ (k - 1)) ^ 2 := by
    rw [← zpow_natCast, ← zpow_mul, ← zpow_one_add₀ hp]
    exact congrArg _ (by push_cast; ring1)
  have h₀ : ((p : ℂ) ^ 2) ^ (k + 1 - 3) = ((p : ℂ) ^ (k - 1)) ^ 2 * ((p : ℂ) ^ 2)⁻¹ := by
    rw [← h₄, ← zpow_natCast (p : ℂ) 2, ← zpow_mul]
    exact congrArg _ (by push_cast; ring1)
  have hb' : b = p * ((p : ℂ) ^ (k - 1)) ^ 2 / a := by
    rw [h₁] at hpr
    field_simp
    linear_combination hpr
  refine ⟨Units.mk0 ((p : ℂ) ^ (k - 1)) ht, ![Units.mk0 (a * (p : ℂ) ^ (1 - k))
    (mul_ne_zero ha (zpow_ne_zero _ hp)), Units.mk0 (b * (p : ℂ) ^ (1 - k))
      (mul_ne_zero hb (zpow_ne_zero _ hp))], ?_, rfl, ?_⟩
  · refine isSatakeParameter_of_heckeGenerators (F := ⟨F, hF'⟩) _ _
      (fun h ↦ hF₀ (congrArg Subtype.val h)) ?_ ?_ ?_
    · rw [hT, satakeMap_Tp]
      congr 1
      simp only [Units.val_mk0, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [← hs, hk, hu, hb']
      field_simp
      ring1
    · rw [hT₁, satakeMap_T₁]
      congr 1
      simp only [Units.val_mk0, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [← hs, hk₂, h₂, h₄, hu, hb']
      field_simp
      ring1
    · rw [heckeOperator_T₀_detPowerRep, satakeMap_T₀]
      congr 1
      simp only [Units.val_mk0, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [h₀, hu, hb']
      field_simp
  · funext i
    fin_cases i <;> rfl

end SiegelUpperHalfSpace
