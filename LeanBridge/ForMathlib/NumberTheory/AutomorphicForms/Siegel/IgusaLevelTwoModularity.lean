import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.IbukiyamaGamma0
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.IgusaLevelTwo
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.QuotientSlashRepresentation

/-!
# The fourth powers of the theta constants are modular forms on `Γ[2]`

Igusa's generators `xᵢ = ϑᵢ⁴` of the ring of Siegel modular forms of degree 2 on the principal
congruence subgroup `Γ[2]` of `Sp(4, ℤ)` (LMFDB `mf.siegel.family.gamma_2`) are modular forms of
weight 2 on `Γ[2]`. More generally, `θ_m⁴ ∈ M₂(Γ[2])` for every integral characteristic `m`.

The proof uses normal generators of `Γ[2]` instead of generators: `Γ[2]` is the normal closure in
`Sp(4, ℤ)` of `u = ι₁(1, 0; 2, 1)` and `P(ℤ) ∩ Γ[2]`, where `P(ℤ)` is the Siegel parabolic
subgroup. Indeed `Γ₀(2) ⊇ Γ[2]` is generated by `P(ℤ)` and `u`
(`SymplecticGroup.closure_insert_siegelParabolic_eq_Gamma0`), so for a normal subgroup `N`
containing `u`, every `γ ∈ Γ₀(2)` is a product `hp` with `h ∈ N ∩ Γ[2]` and `p ∈ P(ℤ)`: such
products form a subgroup, since `N ∩ Γ[2]` is normal, and it contains the generators. For
`γ ∈ Γ[2]` the factor `p` lies in `P(ℤ) ∩ Γ[2]`. Let `H` be the subgroup of the `γ ∈ Sp(4, ℤ)` that
fix every `θ_m⁴` under the slash operator of weight 2 (`thetaFourthStabilizer`).
* Every `γ ∈ Sp(4, ℤ)` sends `θ_m⁴` to a constant multiple of some `θ_{m'}⁴`: this holds for the
  generators `P(ℤ)` and `J₁` of `Sp(4, ℤ)` by their transformation laws, where `m'` is the image of
  `m` under the affine action of the generator on the characteristics. So `H` is normal.
* `u ∈ H`, by the transformation law of the fourth powers under `ι₁(1, 0; 2k, 1)`.
* `P(ℤ) ∩ Γ[2] ⊆ H`: such a `p = (A, B; 0, D)` has `A ≡ D ≡ 1` and `B ≡ 0` modulo 2, so it fixes
  the characteristic of `θ_m⁴` modulo 2, on which `θ_m⁴` only depends, and its constant
  `e^{-πi(μᵀSμ + 2μᵀ diag S)}`, `S = BAᵀ ≡ 0`, is `1`.

The same laws make Ibukiyama's form `Z = (θ₀₁₀₀⁴ - θ₀₁₁₀⁴)² / 16384` of the knowl
`mf.siegel.family.gamma0_2` a modular form of weight 4 on `Γ[2]`, and reduce its modularity on
`Γ₀(2)` to its invariance under `P(ℤ)`, that is to the Riemann theta relations, which are not
proved.

## Main definitions

* `SiegelUpperHalfSpace.IgusaLevelTwo.thetaFourthStabilizer`: the subgroup of `Sp(4, ℤ)` fixing
  the fourth powers of all theta constants in weight 2.
* The instance `SiegelUpperHalfSpace.IgusaLevelTwo.thetaFourthStabilizer.Normal`.

## Main results

* `SiegelUpperHalfSpace.IgusaLevelTwo.exists_slash_thetaConstant_pow_four_eq_smul`: `Sp(4, ℤ)`
  permutes the fourth powers of the theta constants up to constants.
* `SiegelUpperHalfSpace.IgusaLevelTwo.Gamma_two_le_of_normal`: `Γ[2]` lies in every normal subgroup
  of `Sp(4, ℤ)` containing `ι₁(1, 0; 2, 1)` and `P(ℤ) ∩ Γ[2]`.
* `SiegelUpperHalfSpace.IgusaLevelTwo.normalClosure_insert_eq_Gamma_two`: `Γ[2]` is the normal
  closure of `ι₁(1, 0; 2, 1)` and `P(ℤ) ∩ Γ[2]`.
* `SiegelUpperHalfSpace.IgusaLevelTwo.Gamma_two_le_thetaFourthStabilizer`: `Γ[2]` fixes the
  fourth powers of all theta constants in weight 2.
* `SiegelUpperHalfSpace.IgusaLevelTwo.thetaConstant_pow_four_mem_scalarModularForms`:
  `θ_m⁴ ∈ M₂(Γ[2])` for every integral characteristic `m`.
* `SiegelUpperHalfSpace.IgusaLevelTwo.x_mem_scalarModularForms`: `xᵢ = ϑᵢ⁴ ∈ M₂(Γ[2])`, the
  field `x_mem` of `SiegelUpperHalfSpace.IgusaLevelTwo.IgusaLevelTwoStructure`.
* `SiegelUpperHalfSpace.Ibukiyama.Z_mem_gamma0_two_of_mem_parabolic`: `Z ∈ M₄(Γ₀(2))` as soon as
  `Z ∈ M₄(P(ℤ))`.
* `SiegelUpperHalfSpace.Ibukiyama.Z_mem_principal`: `Z ∈ M₄(Γ[2])`.
-/

open Complex Matrix Real SymplecticGroup

open SpecialLinearGroup (lowerUnipotent)

namespace SiegelUpperHalfSpace.IgusaLevelTwo

variable (μ ν : Fin 2 → ℤ) {μ' ν' : Fin 2 → ℤ} (k : ℤ) (τ : SiegelUpperHalfSpace (Fin 2))
    {p γ : symplecticGroup (Fin 2) ℤ} {H : Subgroup (symplecticGroup (Fin 2) ℤ)} [H.Normal]

/-- The subgroup of `Sp(4, ℤ)` **fixing the fourth powers of the theta constants** of degree 2 in
weight 2: the `γ` with `θ_m⁴ ∣₂ γ = θ_m⁴`, that is `θ_m(γΩ)⁴ = det(CΩ + D)² θ_m(Ω)⁴`, for every
integral characteristic `m = (μ, ν)`: the intersection of the stabilisers `slashCharStabilizer` of
the `θ_m⁴` in `Sp(4, ℤ)` with the trivial character. -/
noncomputable def thetaFourthStabilizer : Subgroup (symplecticGroup (Fin 2) ℤ) :=
  ⨅ m : (Fin 2 → ℤ) × (Fin 2 → ℤ),
    slashCharStabilizer (TauCeti.detPowerRep ℂ 2 2) (thetaConstant m.1 m.2 ^ 4) ⊤ 1

lemma mem_thetaFourthStabilizer_iff : γ ∈ thetaFourthStabilizer ↔ ∀ μ ν : Fin 2 → ℤ,
    slash (TauCeti.detPowerRep ℂ 2 2) (map (Int.castRingHom ℝ) γ) (thetaConstant μ ν ^ 4) =
      thetaConstant μ ν ^ 4 := by
  simp [thetaFourthStabilizer, slashCharStabilizerOf]

lemma slash_thetaConstant_pow_four_of_mem_siegelParabolic (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    letI S : Matrix (Fin 2) (Fin 2) ℤ := p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ
    slash (TauCeti.detPowerRep ℂ 2 2) (map (Int.castRingHom ℝ) p) (thetaConstant μ ν ^ 4) =
      cexp (-(π * I * ((μ ⬝ᵥ S *ᵥ μ : ℤ) / 4 + (μ ⬝ᵥ S.diag : ℤ) / 2))) ^ 4 •
        thetaConstant (p.1.toBlocks₁₁ᵀ *ᵥ μ) (p.1.toBlocks₂₂ᵀ *ᵥ (ν + S *ᵥ μ + S.diag)) ^ 4 := by
  ext τ
  have h : GeneralLinearGroup.det (denomGL (map (Int.castRingHom ℝ) p) τ) ^ 2 = 1 :=
    Units.ext <| by
      rw [Units.val_pow_eq_pow_val, GeneralLinearGroup.val_det_apply, coe_denomGL,
        Ibukiyama.det_denom_sq_of_mem_siegelParabolic τ hp, Units.val_one]
  rw [slash_apply, Pi.smul_apply, Pi.pow_apply, Pi.pow_apply,
    thetaConstant_smul_of_mem_siegelParabolic μ ν τ hp, TauCeti.detPowerRep_apply, map_inv,
    zpow_ofNat, inv_pow, h, inv_one, Units.val_one, one_mul, mul_pow, smul_eq_mul]

private lemma cons_zero_one_eq (v : Fin 2 → ℤ) : ![v 0, v 1] = v := by
  ext i
  fin_cases i <;> rfl

lemma slash_partialInversion_thetaConstant_pow_four :
    slash (TauCeti.detPowerRep ℂ 2 2) (map (Int.castRingHom ℝ) partialInversion)
      (thetaConstant μ ν ^ 4) = (-1 : ℂ) • thetaConstant ![ν 0, μ 1] ![μ 0, ν 1] ^ 4 := by
  ext τ
  have h : thetaConstant μ ν (map (Int.castRingHom ℝ) partialInversion • τ) ^ 4 =
      -τ.val 0 0 ^ 2 * thetaConstant ![ν 0, μ 1] ![μ 0, ν 1] τ ^ 4 := by
    simpa only [cons_val_zero, cons_val_one, cons_zero_one_eq] using
      thetaConstant_partialInversion_smul_pow_four τ ![ν 0, μ 1] ![μ 0, ν 1]
  rw [slash_apply, Pi.pow_apply, h, Pi.smul_apply, Pi.pow_apply, TauCeti.detPowerRep_apply,
    map_inv, zpow_ofNat, inv_pow, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val,
    GeneralLinearGroup.val_det_apply, coe_denomGL, det_denom_partialInversion, smul_eq_mul]
  field_simp [val_zero_zero_ne_zero τ]

lemma slash_inv_partialInversion_thetaConstant_pow_four :
    slash (TauCeti.detPowerRep ℂ 2 2) (map (Int.castRingHom ℝ) partialInversion⁻¹)
      (thetaConstant μ ν ^ 4) = (-1 : ℂ) • thetaConstant ![ν 0, μ 1] ![μ 0, ν 1] ^ 4 := by
  have h : (-1 : ℂ) • slash (TauCeti.detPowerRep ℂ 2 2) (map (Int.castRingHom ℝ) partialInversion)
      (thetaConstant ![ν 0, μ 1] ![μ 0, ν 1] ^ 4) = thetaConstant μ ν ^ 4 := by
    rw [slash_partialInversion_thetaConstant_pow_four, smul_smul, neg_one_mul, neg_neg, one_smul]
    simp only [cons_val_zero, cons_val_one, cons_zero_one_eq]
  rw [← h, slash_smul, ← slash_mul, ← map_mul, mul_inv_cancel, map_one, slash_one]

variable (γ) in
/-- **`Sp(4, ℤ)` permutes the fourth powers of the theta constants up to constants**: for every
`γ ∈ Sp(4, ℤ)` and every integral characteristic `m`, `θ_m⁴ ∣₂ γ = c θ_{m'}⁴` for a constant `c`
and an integral characteristic `m'`. It holds for the generators `P(ℤ)` and `J₁` of `Sp(4, ℤ)`
and is preserved under products. -/
lemma exists_slash_thetaConstant_pow_four_eq_smul : ∃ c : ℂ, ∃ μ' ν' : Fin 2 → ℤ,
    slash (TauCeti.detPowerRep ℂ 2 2) (map (Int.castRingHom ℝ) γ) (thetaConstant μ ν ^ 4) =
      c • thetaConstant μ' ν' ^ 4 := by
  have hγ : γ ∈ Subgroup.closure (insert partialInversion (siegelParabolic (Fin 2) ℤ)) := by
    rw [closure_insert_partialInversion_eq_top]
    exact Subgroup.mem_top γ
  induction hγ using Subgroup.closure_induction'' generalizing μ ν with
  | mem x hx =>
    rcases hx with rfl | hx
    · exact ⟨-1, _, _, slash_partialInversion_thetaConstant_pow_four μ ν⟩
    · exact ⟨_, _, _, slash_thetaConstant_pow_four_of_mem_siegelParabolic μ ν hx⟩
  | inv_mem x hx =>
    rcases hx with rfl | hx
    · exact ⟨-1, _, _, slash_inv_partialInversion_thetaConstant_pow_four μ ν⟩
    · exact ⟨_, _, _, slash_thetaConstant_pow_four_of_mem_siegelParabolic μ ν (inv_mem hx)⟩
  | one => exact ⟨1, μ, ν, by rw [map_one, slash_one, one_smul]⟩
  | mul x y _ _ hx hy =>
    rcases hx μ ν with ⟨c, μ', ν', h⟩
    rcases hy μ' ν' with ⟨c', μ'', ν'', h'⟩
    exact ⟨c * c', μ'', ν'', by rw [map_mul, slash_mul, h, slash_smul, h', smul_smul]⟩

instance : thetaFourthStabilizer.Normal where
  conj_mem h hh γ := mem_thetaFourthStabilizer_iff.mpr fun μ ν ↦ by
    rcases exists_slash_thetaConstant_pow_four_eq_smul μ ν γ with ⟨c, μ', ν', e⟩
    rw [map_mul, map_mul, slash_mul, slash_mul, e, slash_smul, mem_thetaFourthStabilizer_iff.mp hh,
      ← e, ← slash_mul, ← map_mul, mul_inv_cancel, map_one, slash_one]

lemma embedFirst_lowerUnipotent_mem_thetaFourthStabilizer :
    embedFirst (lowerUnipotent (2 * k)) ∈ thetaFourthStabilizer := by
  refine mem_thetaFourthStabilizer_iff.mpr fun μ ν ↦ ?_
  conv_rhs => rw [← one_smul ℂ (thetaConstant μ ν ^ 4)]
  rw [slash_eq_smul_iff]
  intro τ
  rw [one_smul, detPowerRep_denomGL, Pi.pow_apply, Pi.pow_apply, zpow_ofNat,
    thetaConstant_embedFirst_lowerUnipotent_smul_pow_four]

lemma embedFirst_lowerUnipotent_mem_Gamma_two :
    embedFirst (lowerUnipotent (2 * k)) ∈ SymplecticGroup.Gamma (Fin 2) 2 := by
  have h2 : (2 : ZMod 2) = 0 := by decide
  rw [mem_Gamma_iff]
  ext i j
  rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
    simp [embedFirst, lowerUnipotent, h2]

variable {μ ν} in
lemma thetaConstant_eq_neg_one_zpow_mul (hμ : ∀ i, (μ i : ZMod 2) = μ' i)
    (hν : ∀ i, (ν i : ZMod 2) = ν' i) :
    thetaConstant μ ν τ = (-1) ^ (μ' ⬝ᵥ fun i ↦ (ν i - ν' i) / 2) * thetaConstant μ' ν' τ := by
  have e {a a' : Fin 2 → ℤ} (ha : ∀ i, (a i : ZMod 2) = a' i) :
      a = a' + 2 • fun i ↦ (a i - a' i) / 2 := by
    ext i
    have h : (2 : ℤ) ∣ a i - a' i := by
      exact_mod_cast (ZMod.intCast_eq_intCast_iff_dvd_sub (a' i) (a i) 2).mp (ha i).symm
    rw [Pi.add_apply, Pi.smul_apply, nsmul_eq_mul, Nat.cast_ofNat]
    omega
  conv_lhs => rw [e hμ, thetaConstant_add_two_smul_left, e hν, thetaConstant_add_two_smul_right]

variable {μ ν} in
lemma thetaConstant_pow_four_eq_of_cast_eq (hμ : ∀ i, (μ i : ZMod 2) = μ' i)
    (hν : ∀ i, (ν i : ZMod 2) = ν' i) : thetaConstant μ ν ^ 4 = thetaConstant μ' ν' ^ 4 := by
  ext Ω
  rw [Pi.pow_apply, Pi.pow_apply, thetaConstant_eq_neg_one_zpow_mul Ω hμ hν, mul_pow]
  rcases Int.even_or_odd (μ' ⬝ᵥ fun i ↦ (ν i - ν' i) / 2) with h | h <;> rw [h.neg_one_zpow] <;>
    ring1

lemma map_toBlocks₁₁_eq_one_of_mem_Gamma_two (hp : p ∈ SymplecticGroup.Gamma (Fin 2) 2) :
    p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1 := by
  ext i j
  simpa [toBlocks₁₁, one_apply] using congrFun (congrFun (mem_Gamma_iff.mp hp) (.inl i)) (.inl j)

lemma map_toBlocks₂₂_eq_one_of_mem_Gamma_two (hp : p ∈ SymplecticGroup.Gamma (Fin 2) 2) :
    p.1.toBlocks₂₂.map (Int.castRingHom (ZMod 2)) = 1 := by
  ext i j
  simpa [toBlocks₂₂, one_apply] using congrFun (congrFun (mem_Gamma_iff.mp hp) (.inr i)) (.inr j)

lemma map_mul_transpose_eq_zero_of_mem_Gamma_two (hp : p ∈ SymplecticGroup.Gamma (Fin 2) 2) :
    (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ).map (Int.castRingHom (ZMod 2)) = 0 := by
  have hB : p.1.toBlocks₁₂.map (Int.castRingHom (ZMod 2)) = 0 := by
    ext i j
    simpa [toBlocks₁₂] using congrFun (congrFun (mem_Gamma_iff.mp hp) (.inl i)) (.inr j)
  rw [Matrix.map_mul, hB, Matrix.zero_mul]

lemma intCast_transpose_mulVec_apply {M : Matrix (Fin 2) (Fin 2) ℤ}
    (hM : M.map (Int.castRingHom (ZMod 2)) = 1) (i : Fin 2) : ((Mᵀ *ᵥ μ) i : ZMod 2) = μ i := by
  rw [← eq_intCast (Int.castRingHom _), RingHom.map_mulVec, transpose_map, hM, transpose_one,
    one_mulVec, Function.comp_apply, eq_intCast]

lemma mem_thetaFourthStabilizer_of_mem_siegelParabolic (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (hp₂ : p ∈ SymplecticGroup.Gamma (Fin 2) 2) : p ∈ thetaFourthStabilizer := by
  refine mem_thetaFourthStabilizer_iff.mpr fun μ ν ↦ ?_
  have hS : (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ).map (Int.castRingHom (ZMod 2)) = 0 :=
    map_mul_transpose_eq_zero_of_mem_Gamma_two hp₂
  have hc (M : Matrix (Fin 2) (Fin 2) ℤ) (v : Fin 2 → ℤ) :
      Int.castRingHom (ZMod 2) ∘ (M *ᵥ v) =
        M.map (Int.castRingHom (ZMod 2)) *ᵥ (Int.castRingHom (ZMod 2) ∘ v) :=
    funext <| RingHom.map_mulVec _ M v
  have hq : (2 : ℤ) ∣ μ ⬝ᵥ (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ) *ᵥ μ := by
    rw [← Nat.cast_ofNat, ← ZMod.intCast_zmod_eq_zero_iff_dvd, ← eq_intCast (Int.castRingHom _),
      RingHom.map_dotProduct, hc, hS, zero_mulVec, dotProduct_zero]
  have hd : (2 : ℤ) ∣ μ ⬝ᵥ (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ).diag := by
    rw [← Nat.cast_ofNat, ← ZMod.intCast_zmod_eq_zero_iff_dvd, ← eq_intCast (Int.castRingHom _),
      RingHom.map_dotProduct, ← diag_map, hS, diag_zero, dotProduct_zero]
  rcases hq with ⟨a, ha⟩
  rcases hd with ⟨b, hb⟩
  have he : cexp (-(π * I * ((μ ⬝ᵥ (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ) *ᵥ μ : ℤ) / 4 +
      (μ ⬝ᵥ (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ).diag : ℤ) / 2))) ^ 4 = 1 := by
    rw [ha, hb, ← Complex.exp_nat_mul]
    exact Complex.exp_eq_one_iff.mpr ⟨-(a + 2 * b), by push_cast; ring1⟩
  rw [slash_thetaConstant_pow_four_of_mem_siegelParabolic μ ν hp, he, one_smul]
  refine thetaConstant_pow_four_eq_of_cast_eq
    (intCast_transpose_mulVec_apply μ (map_toBlocks₁₁_eq_one_of_mem_Gamma_two hp₂)) fun i ↦ ?_
  have hSi : Int.castRingHom (ZMod 2) ((p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ) i i) = 0 := by
    simpa using congrFun (congrFun hS i) i
  rw [← eq_intCast (Int.castRingHom _), RingHom.map_mulVec, transpose_map,
    map_toBlocks₂₂_eq_one_of_mem_Gamma_two hp₂, transpose_one, one_mulVec, Function.comp_apply,
    Pi.add_apply, Pi.add_apply, map_add, map_add, RingHom.map_mulVec, hS, zero_mulVec,
    Pi.zero_apply, add_zero, diag_apply, hSi, add_zero, eq_intCast]

lemma exists_mem_siegelParabolic_mul_inv_mem (hu : embedFirst (lowerUnipotent 2) ∈ H)
    (hγ : γ ∈ Gamma0 (Fin 2) 2) :
    ∃ p ∈ siegelParabolic (Fin 2) ℤ, γ * p⁻¹ ∈ H ⊓ SymplecticGroup.Gamma (Fin 2) 2 := by
  have hN : (H ⊓ SymplecticGroup.Gamma (Fin 2) 2).Normal := inferInstance
  rw [← closure_insert_siegelParabolic_eq_Gamma0 two_pos (by norm_num)] at hγ
  induction hγ using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | hx
    · refine ⟨1, one_mem _, ?_⟩
      rw [inv_one, mul_one]
      exact Subgroup.mem_inf.mpr ⟨hu, embedFirst_lowerUnipotent_mem_Gamma_two 1⟩
    · refine ⟨x, hx, ?_⟩
      rw [mul_inv_cancel]
      exact one_mem _
  | one =>
    refine ⟨1, one_mem _, ?_⟩
    rw [inv_one, mul_one]
    exact one_mem _
  | mul x y _ _ hx hy =>
    rcases hx with ⟨p, hp, hxp⟩
    rcases hy with ⟨q, hq, hyq⟩
    have e : x * y * (p * q)⁻¹ = x * p⁻¹ * (p * (y * q⁻¹) * p⁻¹) := by
      group
    refine ⟨p * q, mul_mem hp hq, ?_⟩
    rw [e]
    exact mul_mem hxp (hN.conj_mem _ hyq p)
  | inv x _ hx =>
    rcases hx with ⟨p, hp, hxp⟩
    have e : x⁻¹ * p⁻¹⁻¹ = p⁻¹ * (x * p⁻¹)⁻¹ * p⁻¹⁻¹ := by
      group
    refine ⟨p⁻¹, inv_mem hp, ?_⟩
    rw [e]
    exact hN.conj_mem _ (inv_mem hxp) p⁻¹

/-- **`Γ[2]` lies in every normal subgroup of `Sp(4, ℤ)` containing `ι₁(1, 0; 2, 1)` and
`P(ℤ) ∩ Γ[2]`**: an element `γ ∈ Γ[2] ⊆ Γ₀(2)` is a product `hp` with `h` in the normal subgroup
and in `Γ[2]` and `p` in the Siegel parabolic subgroup `P(ℤ)`, since `Γ₀(2)` is generated by `P(ℤ)`
and `ι₁(1, 0; 2, 1)`, and then `p = h⁻¹γ ∈ P(ℤ) ∩ Γ[2]`. -/
lemma Gamma_two_le_of_normal (hu : embedFirst (lowerUnipotent 2) ∈ H)
    (hP : siegelParabolic (Fin 2) ℤ ⊓ SymplecticGroup.Gamma (Fin 2) 2 ≤ H) :
    SymplecticGroup.Gamma (Fin 2) 2 ≤ H := fun γ hγ ↦ by
  rcases exists_mem_siegelParabolic_mul_inv_mem hu (Gamma_le_Gamma0 2 hγ) with ⟨p, hp, hγp⟩
  have e : γ = γ * p⁻¹ * p := by
    group
  have e' : p = (γ * p⁻¹)⁻¹ * γ := by
    group
  rw [e]
  exact mul_mem (Subgroup.mem_inf.mp hγp).1 <| hP <| Subgroup.mem_inf.mpr
    ⟨hp, e' ▸ mul_mem (inv_mem (Subgroup.mem_inf.mp hγp).2) hγ⟩

/-- **Normal generators of `Γ[2]`**: the principal congruence subgroup `Γ[2]` of `Sp(4, ℤ)` is the
normal closure of `ι₁(1, 0; 2, 1)` and the elements of the Siegel parabolic subgroup congruent to
`1` modulo 2. -/
lemma normalClosure_insert_eq_Gamma_two : Subgroup.normalClosure (insert
    (embedFirst (lowerUnipotent 2)) (siegelParabolic (Fin 2) ℤ ⊓ SymplecticGroup.Gamma (Fin 2) 2 :
      Set (symplecticGroup (Fin 2) ℤ))) = SymplecticGroup.Gamma (Fin 2) 2 :=
  le_antisymm (Subgroup.normalClosure_le_normal (Set.insert_subset
    (embedFirst_lowerUnipotent_mem_Gamma_two 1) fun _ hp ↦ (Subgroup.mem_inf.mp hp).2))
      (Gamma_two_le_of_normal (Subgroup.subset_normalClosure (Set.mem_insert _ _))
        fun _ hp ↦ Subgroup.subset_normalClosure (Set.mem_insert_of_mem _ hp))

/-- **`Γ[2]` fixes the fourth powers of the theta constants in weight 2**: `θ_m⁴ ∣₂ γ = θ_m⁴` for
every `γ ∈ Γ[2]` and every integral characteristic `m`. The stabiliser of the `θ_m⁴` is normal and
contains `ι₁(1, 0; 2, 1)` and `P(ℤ) ∩ Γ[2]`, which fixes the characteristics modulo 2. -/
lemma Gamma_two_le_thetaFourthStabilizer :
    SymplecticGroup.Gamma (Fin 2) 2 ≤ thetaFourthStabilizer :=
  Gamma_two_le_of_normal (embedFirst_lowerUnipotent_mem_thetaFourthStabilizer 1) fun _ hp ↦
    mem_thetaFourthStabilizer_of_mem_siegelParabolic (Subgroup.mem_inf.mp hp).1
      (Subgroup.mem_inf.mp hp).2

variable {k} in
lemma mem_scalarModularForms_of_slash_eq {f : SiegelUpperHalfSpace (Fin 2) → ℂ}
    (hf : IsHolomorphic f) (h : ∀ γ ∈ SymplecticGroup.Gamma (Fin 2) 2,
      slash (TauCeti.detPowerRep ℂ 2 k) (map (Int.castRingHom ℝ) γ) f = f) :
    f ∈ scalarModularForms k principal := by
  have hle : SymplecticGroup.Gamma (Fin 2) 2 ≤
      slashCharStabilizer (TauCeti.detPowerRep ℂ 2 k) f (SymplecticGroup.Gamma (Fin 2) 2) 1 :=
    fun γ hγ ↦ ⟨hγ, by
      rw [MonoidHom.one_apply, Units.val_one, one_smul]
      exact h γ hγ⟩
  simpa using mem_modularForms_map_of_le_slashCharStabilizer _ _ _ 1 hf hle

/-- **The fourth powers of the theta constants are Siegel modular forms of weight 2 on `Γ[2]`**
(LMFDB `mf.siegel.family.gamma_2`): `θ_m⁴ ∈ M₂(Γ[2])` for every integral characteristic `m`. -/
lemma thetaConstant_pow_four_mem_scalarModularForms :
    thetaConstant μ ν ^ 4 ∈ scalarModularForms 2 principal :=
  mem_scalarModularForms_of_slash_eq ((isHolomorphic_thetaConstant μ ν).pow 4) fun _ hγ ↦
    mem_thetaFourthStabilizer_iff.mp (Gamma_two_le_thetaFourthStabilizer hγ) μ ν

/-- **Igusa's generators `xᵢ = ϑᵢ⁴` are Siegel modular forms of weight 2 on `Γ[2]`** (LMFDB
`mf.siegel.family.gamma_2`): the field `x_mem` of `IgusaLevelTwoStructure` holds. -/
lemma x_mem_scalarModularForms (i : Fin 10) : x i ∈ scalarModularForms 2 principal :=
  thetaConstant_pow_four_mem_scalarModularForms _ _

lemma thetaConstant_smul_pow_four_of_mem_Gamma_two (hγ : γ ∈ SymplecticGroup.Gamma (Fin 2) 2) :
    thetaConstant μ ν (map (Int.castRingHom ℝ) γ • τ) ^ 4 =
      (denom (map (Int.castRingHom ℝ) γ) τ.val).det ^ 2 * thetaConstant μ ν τ ^ 4 := by
  have h : (thetaConstant μ ν ^ 4) (map (Int.castRingHom ℝ) γ • τ) = (1 : ℂ) • TauCeti.detPowerRep
      ℂ 2 2 (denomGL (map (Int.castRingHom ℝ) γ) τ) ((thetaConstant μ ν ^ 4) τ) :=
    (slash_eq_smul_iff _ _ _ 1).mp ((mem_thetaFourthStabilizer_iff.mp
      (Gamma_two_le_thetaFourthStabilizer hγ) μ ν).trans (one_smul ℂ _).symm) τ
  rwa [one_smul, detPowerRep_denomGL, zpow_ofNat] at h

end SiegelUpperHalfSpace.IgusaLevelTwo

namespace SiegelUpperHalfSpace.Ibukiyama

lemma Z_embedFirst_lowerUnipotent_smul (Ω : SiegelUpperHalfSpace (Fin 2)) (k : ℤ) :
    Z (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * k))) • Ω) =
      (denom (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * k)))) Ω.val).det ^ 4 *
        Z Ω := by
  simp only [Z, Pi.div_apply, Pi.pow_apply, Pi.sub_apply, Pi.ofNat_apply,
    thetaConstant_embedFirst_lowerUnipotent_smul_pow_four]
  ring1

/-- **The modularity of `Z` on `Γ₀(2)` reduces to the Siegel parabolic subgroup**: `Z` transforms
with weight 4 under `ι₁(1, 0; 2, 1)`, since the fourth powers of the theta constants transform with
weight 2, so `Z ∈ M₄(Γ₀(2))` as soon as `Z ∈ M₄(P(ℤ))`. The latter is the Riemann theta relation
`θ₀₁₀₀⁴ - θ₀₁₁₀⁴ = ±(θ₁₀₀₀⁴ - θ₁₀₀₁⁴)` and its images, which is not proved. -/
lemma Z_mem_gamma0_two_of_mem_parabolic (h : Z ∈ scalarModularForms 4 parabolic) :
    Z ∈ scalarModularForms 4 (gamma0 2) :=
  mem_gamma0_two_of_mem_parabolic h fun τ ↦ by
    rw [zpow_ofNat]
    exact Z_embedFirst_lowerUnipotent_smul τ 1

/-- **`Z` is a Siegel modular form of weight 4 on `Γ[2]`** (LMFDB `mf.siegel.family.gamma0_2`), as
a polynomial in the fourth powers of the theta constants. -/
lemma Z_mem_principal : Z ∈ scalarModularForms 4 IgusaLevelTwo.principal := by
  rw [mem_scalarModularForms_iff]
  refine ⟨isHolomorphic_Z, ?_⟩
  rintro ⟨_, γ, hγ, rfl⟩ τ
  simp only [map_algebraMap_map_intCast, Z, Pi.div_apply, Pi.pow_apply, Pi.sub_apply,
    Pi.ofNat_apply, IgusaLevelTwo.thetaConstant_smul_pow_four_of_mem_Gamma_two _ _ _ hγ, zpow_ofNat]
  ring1

end SiegelUpperHalfSpace.Ibukiyama
