import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.FourierUniqueness
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.HeckeOperator

/-!
# Coefficient fields, Hecke fields and Hecke rings of Siegel modular forms

The coefficient field and ring of a scalar-valued Siegel modular form are
`SiegelUpperHalfSpace.coefficientField` and `SiegelUpperHalfSpace.coefficientRing`. This file adds
their vector-valued analogues, generated by the coordinates of the Fourier coefficients
`a(n) ∈ V` in a fixed basis of `V`, and the Hecke field `ℚ(λ_F(T))` and Hecke ring `ℤ[λ_F(T)]` of
a Hecke eigenform `F`, generated by its Hecke eigenvalues.

The facts stated in the knowls for eigenforms and newforms (the coefficient field is a number field
containing `ℚ(ζ_m)`, Galois conjugate eigenforms share it, the coefficients of a newform are
algebraic integers generating a finite index subring of the integers of the coefficient field) are
not proved here. The knowls' claim that the coefficients and the eigenvalues of an eigenform
generate the same field and ring is false for Siegel forms, so the Hecke field and ring are defined
separately.

## Main definitions

* `SiegelUpperHalfSpace.vectorCoefficientField` (LMFDB `mf.siegel.coefficient_field`): the
  coefficient field of a vector-valued form, relative to a basis of `V`.
* `SiegelUpperHalfSpace.vectorCoefficientRing` (LMFDB `mf.siegel.coefficient_ring`): its
  coefficient ring.
* `SiegelUpperHalfSpace.IsHeckeEigenform.eigenvalue`: the Hecke eigenvalues of an eigenform.
* `SiegelUpperHalfSpace.heckeField` (LMFDB `mf.siegel.coefficient_field`): the Hecke field.
* `SiegelUpperHalfSpace.heckeRing` (LMFDB `mf.siegel.coefficient_ring`): the Hecke ring.

## Main results

* `SiegelUpperHalfSpace.vectorFourierCoeffs_eq_range`: the coordinates of the Fourier coefficients
  of a function with a Fourier expansion `a` are those of the values of `a`.
* `SiegelUpperHalfSpace.vectorFourierCoeffs_singleton`: for `V = ℂ` with its standard basis, they
  are the scalar Fourier coefficients.
* `SiegelUpperHalfSpace.heckeEigenvalues_eq_range`: the eigenvalues of a Hecke eigenform are the
  values of `SiegelUpperHalfSpace.IsHeckeEigenform.eigenvalue`.
-/

open Matrix Module

namespace SiegelUpperHalfSpace

section Fourier

variable {l : Type*} [Fintype l] [DecidableEq l] (Γ : Subgroup (symplecticGroup l ℚ)) {V ι : Type*}
    [AddCommGroup V] [Module ℂ V] (b : Basis ι ℂ V) (f : SiegelUpperHalfSpace l → V)

/-- The set of **coordinates of the Fourier coefficients** of `f : ℋ_g → V` on `Γ` in the basis `b`
of `V`: the coordinates `b^*_i(a(n))` of the Fourier coefficients `a(n) ∈ V` of the Fourier
expansions of `f`, which are unique when `L_Γ` contains `N · Sym_g(ℤ)` for some `N ≠ 0`
(`SiegelUpperHalfSpace.vectorFourierCoeffs_eq_range`). -/
def vectorFourierCoeffs : Set ℂ :=
  {c | ∃ a : dualLattice Γ → V, HasSiegelFourierExpansion Γ f a ∧ ∃ n i, b.repr (a n) i = c}

/-- The **coefficient field** (LMFDB `mf.siegel.coefficient_field`) of a vector-valued Siegel
modular form `f : ℋ_g → V` on `Γ`, relative to a basis `b` of `V`: the subfield of `ℂ` generated by
the coordinates in `b` of its Fourier coefficients `a(n) ∈ V`, `n ∈ L_Γ^∨`. It depends on `b`; the
LMFDB uses the standard monomial basis of `Sym^j(ℂ²) ⊗ det^k`. For `V = ℂ` with its standard basis
it is `SiegelUpperHalfSpace.coefficientField`
(`SiegelUpperHalfSpace.vectorFourierCoeffs_singleton`). If `f` has no Fourier expansion on `Γ`, it
is the junk value `ℚ`. -/
noncomputable def vectorCoefficientField : Subfield ℂ :=
  Subfield.closure (vectorFourierCoeffs Γ b f)

/-- The **coefficient ring** (LMFDB `mf.siegel.coefficient_ring`) of a vector-valued Siegel modular
form `f : ℋ_g → V` on `Γ`, relative to a basis `b` of `V`: the subring of `ℂ` generated by the
coordinates in `b` of its Fourier coefficients. If `f` has no Fourier expansion on `Γ`, it is the
junk value `ℤ`. -/
def vectorCoefficientRing : Subring ℂ :=
  Subring.closure (vectorFourierCoeffs Γ b f)

lemma vectorCoefficientRing_le :
    vectorCoefficientRing Γ b f ≤ (vectorCoefficientField Γ b f).toSubring :=
  Subring.closure_le.mpr Subfield.subset_closure

variable {Γ b f}

/-- The **coordinates of the Fourier coefficients** of `f : ℋ_g → V` with a Fourier expansion `a`
on `Γ` are those of the values of `a`, if `L_Γ` contains `N · Sym_g(ℤ)` with `N ≠ 0`. -/
lemma vectorFourierCoeffs_eq_range {N : ℕ} (hN : N ≠ 0)
    (hΓ : ∀ i j : l, (N : ℚ) • (single i j 1 + single j i 1) ∈ translationLattice Γ)
    {a : dualLattice Γ → V} (ha : HasSiegelFourierExpansion Γ f a) :
    vectorFourierCoeffs Γ b f = Set.range fun p : dualLattice Γ × ι ↦ b.repr (a p.1) p.2 := by
  ext z
  refine ⟨fun ⟨c, hc, n, i, hn⟩ ↦ ⟨(n, i), ?_⟩, fun ⟨p, hp⟩ ↦ ⟨a, ha, p.1, p.2, hp⟩⟩
  rw [ha.unique hN hΓ hc]
  exact hn

variable (Γ) in
/-- For `V = ℂ` with its standard basis, the **coordinates of the Fourier coefficients** are the
Fourier coefficients. -/
lemma vectorFourierCoeffs_singleton (F : SiegelUpperHalfSpace l → ℂ) :
    vectorFourierCoeffs Γ (Basis.singleton Unit ℂ) F = fourierCoeffs Γ F := by
  ext z
  simp [vectorFourierCoeffs, fourierCoeffs]

end Fourier

section Hecke

variable {n : ℕ} [NeZero n] {V : Type*} [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ (GL (Fin n) ℂ) V) {Δ : Submonoid (GL (Fin n ⊕ Fin n) ℚ)}
    [Fact (Δ ≤ gspPlusGL (Fin n))] {Γ : Subgroup (GL (Fin n ⊕ Fin n) ℚ)} [IsHeckeTriple Δ Γ Γ]
    {F : slashInvariantsOf ρ Δ Γ}

variable (F) in
/-- The set of **Hecke eigenvalues** of `F`: the `c ∈ ℂ` with `F ∣_ρ ΓαΓ = c F` for some double
coset `ΓαΓ`, `α ∈ Δ`. -/
def heckeEigenvalues : Set ℂ :=
  {c | ∃ D, heckeOperator ρ D F = c • F}

variable (F) in
/-- The **Hecke field** (LMFDB `mf.siegel.coefficient_field`) `ℚ(λ_F(T))` of a Hecke eigenform `F`
(`SiegelUpperHalfSpace.IsHeckeEigenform`): the subfield of `ℂ` generated by its Hecke eigenvalues,
the values of `SiegelUpperHalfSpace.IsHeckeEigenform.eigenvalue`
(`SiegelUpperHalfSpace.heckeEigenvalues_eq_range`). The knowl calls the coefficient field of an
eigenform its Hecke field, but for Siegel forms the two differ in general: the coefficients of an
eigenform are not determined by its eigenvalues (`c F` has the same eigenvalues for every `c ≠ 0`).
-/
noncomputable def heckeField : Subfield ℂ :=
  Subfield.closure (heckeEigenvalues ρ F)

variable (F) in
/-- The **Hecke ring** (LMFDB `mf.siegel.coefficient_ring`) `ℤ[λ_F(T)]` of a Hecke eigenform `F`:
the subring of `ℂ` generated by its Hecke eigenvalues. The knowl states that it is the coefficient
ring of `F`, which is false in general for Siegel forms (see `SiegelUpperHalfSpace.heckeField`). -/
def heckeRing : Subring ℂ :=
  Subring.closure (heckeEigenvalues ρ F)

variable (F) in
lemma heckeRing_le : heckeRing ρ F ≤ (heckeField ρ F).toSubring :=
  Subring.closure_le.mpr Subfield.subset_closure

variable {ρ}

/-- The **Hecke eigenvalue** `λ_F(ΓαΓ)` of a Hecke eigenform `F`: `F ∣_ρ ΓαΓ = λ_F(ΓαΓ) F`. -/
noncomputable def IsHeckeEigenform.eigenvalue (hF : IsHeckeEigenform ρ F) (D : HeckeCoset Δ Γ Γ) :
    ℂ :=
  (hF.2.2 D).choose

variable (hF : IsHeckeEigenform ρ F) (D : HeckeCoset Δ Γ Γ)

lemma IsHeckeEigenform.heckeOperator_eq : heckeOperator ρ D F = hF.eigenvalue D • F :=
  (hF.2.2 D).choose_spec

lemma IsHeckeEigenform.eq_eigenvalue {c : ℂ} (h : heckeOperator ρ D F = c • F) :
    c = hF.eigenvalue D :=
  smul_left_injective ℂ hF.2.1 <| h.symm.trans <| hF.heckeOperator_eq D

/-- The **Hecke eigenvalues** of a Hecke eigenform are the values of its eigenvalue map. -/
lemma heckeEigenvalues_eq_range : heckeEigenvalues ρ F = Set.range hF.eigenvalue := by
  ext c
  refine ⟨fun ⟨D, hD⟩ ↦ ⟨D, (hF.eq_eigenvalue D hD).symm⟩, ?_⟩
  rintro ⟨D, rfl⟩
  exact ⟨D, hF.heckeOperator_eq D⟩

end Hecke

end SiegelUpperHalfSpace
