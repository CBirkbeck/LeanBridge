import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.ThetaTransformation
import Mathlib.Data.Nat.Prime.Int
import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups

/-!
# Generators of `Sp(4, ℤ)` and of its Siegel congruence subgroups `Γ₀(N)`, `N ≤ 4`

The group `Sp(4, ℤ)` is generated by its Siegel parabolic subgroup `P(ℤ) = {(A, B; 0, D)}` and the
partial inversion `J₁` (`SymplecticGroup.partialInversion`), and for `1 ≤ N ≤ 4` the Siegel
congruence subgroup `Γ₀(N) = {C ≡ 0 (mod N)}` is generated by `P(ℤ)` and the single element
`ι₁(1, 0; N, 1)`, where `ι₁ : SL(2, ℤ) → Sp(4, ℤ)` is the embedding on the first coordinate. These
are the generators on which the transformation laws of theta constants of the knowls
`mf.siegel.family.gamma0_2`, `mf.siegel.family.gamma0_4_psi_4` and `mf.siegel.family.gamma_2`
(`SiegelUpperHalfSpace.thetaConstant_smul_of_mem_siegelParabolic` and
`SiegelUpperHalfSpace.thetaConstant_eq_partialInversion`) can be checked.

The proof reduces an element `γ ∈ Γ₀(N)` to `P(ℤ)` by multiplying on the left by generators, a
Euclidean algorithm on its first two columns. With `c ≡ 0 (mod N)` and `a` prime to `N`, the moves
`a ↦ a + tc` and `c ↦ c + Nsa`, of `ι(1, t; 0, 1) ∈ P(ℤ)` and of `ι(1, 0; Ns, 1)` in either
coordinate, make `c = 0`: replacing `a` by a residue of absolute value at most `|c|/2` and then `c`
by one of absolute value at most `N|a|/2` decreases `|c|` when `N ≤ 4` (for `N = 4`, since `a` is
odd and `4 ∣ c`). A rotation `(U, 0; 0, U⁻ᵀ)` first makes both entries of the first column of `A`
prime to `N`; after the algorithm in both coordinates the first column is `(a₁, a₂, 0, 0)` with
`a₁, a₂` coprime, which a rotation sends to `e₁`; the symplectic relations then make the remaining
block `(a₂₂, b₂₂; c₂₂, d₂₂)` an element of `Γ₀(N)` of `SL(2, ℤ)`, which the algorithm in the second
coordinate reduces to `P(ℤ)`.

## Main definitions

* `SymplecticGroup.embedFirst`, `SymplecticGroup.embedSecond`: the embeddings
  `SL(2, R) → Sp(4, R)` on the two coordinates.
* `SymplecticGroup.rotation`: the element `(U, 0; 0, U⁻ᵀ)` of `P(R)` for `U ∈ SL(2, R)`.
* `SymplecticGroup.coordSwap`: the element of `P(R)` exchanging the two coordinates.
* `SymplecticGroup.upperUnipotent`, `SymplecticGroup.lowerUnipotent`: the elements `(1, b; 0, 1)`
  and `(1, 0; c, 1)` of `SL(2, ℤ)`.

## Main results

* `SymplecticGroup.closure_insert_siegelParabolic_eq_Gamma0`: for `1 ≤ N ≤ 4`, `Γ₀(N)` is
  generated by `P(ℤ)` and `ι₁(1, 0; N, 1)`.
* `SymplecticGroup.closure_insert_partialInversion_eq_top`: `Sp(4, ℤ)` is generated by `P(ℤ)` and
  the partial inversion `J₁`.
-/

open Matrix ModularGroup

open scoped MatrixGroups

namespace SymplecticGroup

section

variable {R : Type*} [CommRing R] (M : SL(2, R)) (γ : symplecticGroup (Fin 2) R) {i : Fin 2}
    (j : Fin 2 ⊕ Fin 2)

private lemma det_eq : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
  rw [← det_fin_two]
  exact M.det_coe

private lemma embedFirst_mem : fromBlocks !![M 0 0, 0; 0, 1] !![M 0 1, 0; 0, 0]
    !![M 1 0, 0; 0, 0] !![M 1 1, 0; 0, 1] ∈ symplecticGroup (Fin 2) R := by
  refine fromBlocks_mem_iff.mpr ⟨?_, ?_, ?_⟩ <;> ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, mul_comm]
  linear_combination det_eq M

private lemma embedSecond_mem : fromBlocks !![1, 0; 0, M 0 0] !![0, 0; 0, M 0 1]
    !![0, 0; 0, M 1 0] !![1, 0; 0, M 1 1] ∈ symplecticGroup (Fin 2) R := by
  refine fromBlocks_mem_iff.mpr ⟨?_, ?_, ?_⟩ <;> ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, mul_comm]
  linear_combination det_eq M

/-- The embedding `(a, b; c, d) ↦ (diag(a, 1), diag(b, 0); diag(c, 0), diag(d, 1))` of `SL(2, R)`
into `Sp(4, R)` on the first coordinate. It sends `(0, -1; 1, 0)` to the partial inversion
`J₁`. -/
def embedFirst : SL(2, R) →* symplecticGroup (Fin 2) R where
  toFun M := ⟨fromBlocks !![M 0 0, 0; 0, 1] !![M 0 1, 0; 0, 0] !![M 1 0, 0; 0, 0]
    !![M 1 1, 0; 0, 1], embedFirst_mem M⟩
  map_one' := Subtype.ext <| by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;> simp
  map_mul' M M' := Subtype.ext <| by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply]

/-- The embedding `(a, b; c, d) ↦ (diag(1, a), diag(0, b); diag(0, c), diag(1, d))` of `SL(2, R)`
into `Sp(4, R)` on the second coordinate, the conjugate of `embedFirst` by `coordSwap`. -/
def embedSecond : SL(2, R) →* symplecticGroup (Fin 2) R where
  toFun M := ⟨fromBlocks !![1, 0; 0, M 0 0] !![0, 0; 0, M 0 1] !![0, 0; 0, M 1 0]
    !![1, 0; 0, M 1 1], embedSecond_mem M⟩
  map_one' := Subtype.ext <| by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;> simp
  map_mul' M M' := Subtype.ext <| by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply]

private lemma rotation_mem : fromBlocks (M : Matrix (Fin 2) (Fin 2) R) 0 0
    !![M 1 1, -M 1 0; -M 0 1, M 0 0] ∈ symplecticGroup (Fin 2) R := by
  refine fromBlocks_mem_iff.mpr ⟨by simp, by simp, ?_⟩
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, mul_comm]
  all_goals linear_combination det_eq M

/-- The **rotation** `(U, 0; 0, U⁻ᵀ)` of `Sp(4, R)` by `U ∈ SL(2, R)`, an element of the Siegel
parabolic subgroup acting on `ℋ₂` by `Ω ↦ UΩUᵀ`. -/
def rotation : symplecticGroup (Fin 2) R :=
  ⟨fromBlocks (M : Matrix (Fin 2) (Fin 2) R) 0 0 !![M 1 1, -M 1 0; -M 0 1, M 0 0], rotation_mem M⟩

/-- The element `(U, 0; 0, U)` of `Sp(4, R)`, `U = (0, 1; 1, 0)`, exchanging the two coordinates. -/
def coordSwap : symplecticGroup (Fin 2) R :=
  ⟨fromBlocks !![0, 1; 1, 0] 0 0 !![0, 1; 1, 0], fromBlocks_mem_iff.mpr ⟨by simp, by simp, by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply]⟩⟩

lemma rotation_mem_siegelParabolic : rotation M ∈ siegelParabolic (Fin 2) R :=
  toBlocks_fromBlocks₂₁ _ _ _ _

lemma coordSwap_mem_siegelParabolic : coordSwap ∈ siegelParabolic (Fin 2) R :=
  toBlocks_fromBlocks₂₁ _ _ _ _

lemma embedSecond_eq : embedSecond M = coordSwap * embedFirst M * coordSwap :=
  Subtype.ext <| by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
      simp [embedFirst, embedSecond, coordSwap, Matrix.mul_apply]

lemma embedFirst_mul_apply_inl_zero :
    (embedFirst M * γ).1 (.inl 0) j = M 0 0 * γ.1 (.inl 0) j + M 0 1 * γ.1 (.inr 0) j := by
  simp [embedFirst, Matrix.mul_apply]

lemma embedFirst_mul_apply_inr_zero :
    (embedFirst M * γ).1 (.inr 0) j = M 1 0 * γ.1 (.inl 0) j + M 1 1 * γ.1 (.inr 0) j := by
  simp [embedFirst, Matrix.mul_apply]

lemma embedFirst_mul_apply_inl_one : (embedFirst M * γ).1 (.inl 1) j = γ.1 (.inl 1) j := by
  simp [embedFirst, Matrix.mul_apply]

lemma embedFirst_mul_apply_inr_one : (embedFirst M * γ).1 (.inr 1) j = γ.1 (.inr 1) j := by
  simp [embedFirst, Matrix.mul_apply]

lemma embedSecond_mul_apply_inl_one :
    (embedSecond M * γ).1 (.inl 1) j = M 0 0 * γ.1 (.inl 1) j + M 0 1 * γ.1 (.inr 1) j := by
  simp [embedSecond, Matrix.mul_apply]

lemma embedSecond_mul_apply_inr_one :
    (embedSecond M * γ).1 (.inr 1) j = M 1 0 * γ.1 (.inl 1) j + M 1 1 * γ.1 (.inr 1) j := by
  simp [embedSecond, Matrix.mul_apply]

lemma embedSecond_mul_apply_inl_zero : (embedSecond M * γ).1 (.inl 0) j = γ.1 (.inl 0) j := by
  simp [embedSecond, Matrix.mul_apply]

lemma embedSecond_mul_apply_inr_zero : (embedSecond M * γ).1 (.inr 0) j = γ.1 (.inr 0) j := by
  simp [embedSecond, Matrix.mul_apply]

variable (i) in
lemma rotation_mul_apply_inl :
    (rotation M * γ).1 (.inl i) j = M i 0 * γ.1 (.inl 0) j + M i 1 * γ.1 (.inl 1) j := by
  simp [rotation, Matrix.mul_apply]

lemma rotation_mul_apply_inr_of_eq_zero (h₀ : γ.1 (.inr 0) j = 0) (h₁ : γ.1 (.inr 1) j = 0) :
    (rotation M * γ).1 (.inr i) j = 0 := by
  fin_cases i <;> simp [rotation, Matrix.mul_apply, h₀, h₁]

private lemma fromBlocks_toBlocks_mem :
    fromBlocks γ.1.toBlocks₁₁ γ.1.toBlocks₁₂ γ.1.toBlocks₂₁ γ.1.toBlocks₂₂ ∈
      symplecticGroup (Fin 2) R := by
  rw [fromBlocks_toBlocks]
  exact γ.2

lemma mul_apply_inr_inl_one_eq : γ.1 (.inl 0) (.inl 0) * γ.1 (.inr 0) (.inl 1) +
    γ.1 (.inl 1) (.inl 0) * γ.1 (.inr 1) (.inl 1) = γ.1 (.inr 0) (.inl 0) * γ.1 (.inl 0) (.inl 1) +
      γ.1 (.inr 1) (.inl 0) * γ.1 (.inl 1) (.inl 1) := by
  simpa [toBlocks₁₁, toBlocks₁₂, toBlocks₂₁, toBlocks₂₂, Matrix.mul_apply] using
    congrFun (congrFun (fromBlocks_mem_iff.mp (fromBlocks_toBlocks_mem γ)).1 0) 1

lemma mul_apply_inr_inr_zero_zero : γ.1 (.inl 0) (.inl 0) * γ.1 (.inr 0) (.inr 0) +
    γ.1 (.inl 1) (.inl 0) * γ.1 (.inr 1) (.inr 0) - (γ.1 (.inr 0) (.inl 0) * γ.1 (.inl 0) (.inr 0) +
      γ.1 (.inr 1) (.inl 0) * γ.1 (.inl 1) (.inr 0)) = 1 := by
  simpa [toBlocks₁₁, toBlocks₁₂, toBlocks₂₁, toBlocks₂₂, Matrix.mul_apply] using
    congrFun (congrFun (fromBlocks_mem_iff.mp (fromBlocks_toBlocks_mem γ)).2.2 0) 0

lemma mul_apply_inr_inr_zero_one : γ.1 (.inl 0) (.inl 0) * γ.1 (.inr 0) (.inr 1) +
    γ.1 (.inl 1) (.inl 0) * γ.1 (.inr 1) (.inr 1) - (γ.1 (.inr 0) (.inl 0) * γ.1 (.inl 0) (.inr 1) +
      γ.1 (.inr 1) (.inl 0) * γ.1 (.inl 1) (.inr 1)) = 0 := by
  simpa [toBlocks₁₁, toBlocks₁₂, toBlocks₂₁, toBlocks₂₂, Matrix.mul_apply] using
    congrFun (congrFun (fromBlocks_mem_iff.mp (fromBlocks_toBlocks_mem γ)).2.2 0) 1

lemma mul_apply_inr_inr_one_one : γ.1 (.inl 0) (.inl 1) * γ.1 (.inr 0) (.inr 1) +
    γ.1 (.inl 1) (.inl 1) * γ.1 (.inr 1) (.inr 1) - (γ.1 (.inr 0) (.inl 1) * γ.1 (.inl 0) (.inr 1) +
      γ.1 (.inr 1) (.inl 1) * γ.1 (.inl 1) (.inr 1)) = 1 := by
  simpa [toBlocks₁₁, toBlocks₁₂, toBlocks₂₁, toBlocks₂₂, Matrix.mul_apply] using
    congrFun (congrFun (fromBlocks_mem_iff.mp (fromBlocks_toBlocks_mem γ)).2.2 1) 1

end

/-- The element `(1, b; 0, 1)` of `SL(2, ℤ)`. -/
def upperUnipotent (b : ℤ) : SL(2, ℤ) :=
  ⟨!![1, b; 0, 1], by simp⟩

/-- The element `(1, 0; c, 1)` of `SL(2, ℤ)`. -/
def lowerUnipotent (c : ℤ) : SL(2, ℤ) :=
  ⟨!![1, 0; c, 1], by simp⟩

lemma lowerUnipotent_add (c c' : ℤ) :
    lowerUnipotent (c + c') = lowerUnipotent c * lowerUnipotent c' :=
  Subtype.ext <| by
    ext i j
    rw [SpecialLinearGroup.coe_mul]
    fin_cases i <;> fin_cases j <;> simp [lowerUnipotent]

lemma S_mul_lowerUnipotent (c : ℤ) : S * lowerUnipotent c = upperUnipotent (-c) * S :=
  Subtype.ext <| by
    ext i j
    rw [SpecialLinearGroup.coe_mul, SpecialLinearGroup.coe_mul]
    fin_cases i <;> fin_cases j <;> simp [lowerUnipotent, upperUnipotent, Matrix.mul_apply]

lemma embedFirst_S : embedFirst S = partialInversion :=
  Subtype.ext <| by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
      simp [embedFirst, partialInversion]

lemma embedFirst_upperUnipotent_mem (b : ℤ) :
    embedFirst (upperUnipotent b) ∈ siegelParabolic (Fin 2) ℤ := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [embedFirst, upperUnipotent]

lemma embedSecond_upperUnipotent_mem (b : ℤ) :
    embedSecond (upperUnipotent b) ∈ siegelParabolic (Fin 2) ℤ := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [embedSecond, upperUnipotent]

lemma lowerUnipotent_zero : lowerUnipotent 0 = 1 :=
  Subtype.ext <| by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [lowerUnipotent]

private lemma exists_two_mul_abs_add_mul_le (a : ℤ) {c : ℤ} (hc : c ≠ 0) :
    ∃ t : ℤ, 2 * |a + t * c| ≤ |c| := by
  have hm : 0 < c.natAbs := Int.natAbs_pos.mpr hc
  have h₁ : -((c.natAbs : ℤ) / 2) ≤ a.bmod c.natAbs := Int.le_bmod hm
  have h₂ : a.bmod c.natAbs < (c.natAbs + 1) / 2 := Int.bmod_lt hm
  refine ⟨-(a.bdiv c.natAbs * c.sign), ?_⟩
  rw [show a + -(a.bdiv c.natAbs * c.sign) * c = a.bmod c.natAbs by
    rw [Int.bmod_eq_self_sub_mul_bdiv, ← Int.sign_mul_self]; ring1, Int.abs_eq_natAbs c]
  rcases abs_cases (a.bmod c.natAbs) with ⟨h, -⟩ | ⟨h, -⟩ <;> rw [h] <;> omega

private lemma natAbs_lt_natAbs {N c c' a : ℤ} (hN : 0 < N) (hN₄ : N ≤ 4) (hc : c ≠ 0)
    (h₁ : 2 * |c'| ≤ N * |a|) (h₂ : 2 * |a| ≤ |c|) (h₃ : N ∣ c') (h₄ : ¬(N = 4 ∧ 2 ∣ a)) :
    c'.natAbs < c.natAbs := by
  rw [← Int.ofNat_lt, Int.natCast_natAbs, Int.natCast_natAbs]
  rcases h₃ with ⟨m, rfl⟩
  rw [abs_mul, abs_of_pos hN] at h₁ ⊢
  interval_cases N <;> rcases abs_cases c with ⟨hc', hc''⟩ | ⟨hc', hc''⟩ <;>
    rcases abs_cases a with ⟨ha, ha'⟩ | ⟨ha, ha'⟩ <;>
      rcases abs_cases m with ⟨hm, hm'⟩ | ⟨hm, hm'⟩ <;> simp only [hc', ha, hm] at h₁ h₂ ⊢ <;>
        omega

private lemma euclid {N : ℤ} (hN : 0 < N) (hN₄ : N ≤ 4) {Q : ℤ → ℤ → Prop} (h₀ : ∀ a, Q a 0)
    (ht : ∀ a c t, Q (a + t * c) c → Q a c) (hs : ∀ a c s, Q a (c + N * s * a) → Q a c)
    (n : ℕ) : ∀ a c, c.natAbs = n → N ∣ c → IsCoprime a N → Q a c := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro a c hn hc ha
    rcases eq_or_ne c 0 with rfl | hc₀
    · exact h₀ a
    rcases exists_two_mul_abs_add_mul_le a hc₀ with ⟨t, hat⟩
    refine ht a c t ?_
    rcases hc with ⟨k, rfl⟩
    have ha' : IsCoprime (a + t * (N * k)) N := by
      rw [show a + t * (N * k) = a + N * (t * k) by ring1]
      exact ha.add_mul_left_left _
    rcases eq_or_ne (a + t * (N * k)) 0 with h | h
    · have hN₁ : N = 1 := by
        rw [h, isCoprime_zero_left, Int.isUnit_iff] at ha'
        omega
      subst hN₁
      rw [h]
      refine ht 0 _ 1 (hs _ _ (-1) ?_)
      simpa using h₀ k
    · rcases exists_two_mul_abs_add_mul_le (N * k) (mul_ne_zero hN.ne' h) with ⟨s, hcs⟩
      refine hs _ _ s (ih _ ?_ _ _ rfl ⟨k + s * (a + t * (N * k)), by ring1⟩ ha')
      rw [← hn]
      refine natAbs_lt_natAbs hN hN₄ hc₀ ?_ hat ⟨k + s * (a + t * (N * k)), by ring1⟩ ?_
      · rw [abs_mul, abs_of_pos hN] at hcs
        rw [show N * k + N * s * (a + t * (N * k)) = N * k + s * (N * (a + t * (N * k))) by
          ring1]
        exact hcs
      · rintro ⟨rfl, h₂⟩
        rcases ha'.of_isCoprime_of_dvd_left h₂ with ⟨u, v, huv⟩
        omega

variable {N : ℕ} {γ : symplecticGroup (Fin 2) ℤ}

lemma embedFirst_lowerUnipotent_mem_Gamma0 (s : ℤ) :
    embedFirst (lowerUnipotent (N * s)) ∈ Gamma0 (Fin 2) N :=
  mem_Gamma0_iff.mpr fun i j ↦ by
    fin_cases i <;> fin_cases j <;> simp [embedFirst, lowerUnipotent]

lemma embedSecond_lowerUnipotent_mem_Gamma0 (s : ℤ) :
    embedSecond (lowerUnipotent (N * s)) ∈ Gamma0 (Fin 2) N :=
  mem_Gamma0_iff.mpr fun i j ↦ by
    fin_cases i <;> fin_cases j <;> simp [embedSecond, lowerUnipotent]

lemma embedFirst_lowerUnipotent_natCast_mem_Gamma0 :
    embedFirst (lowerUnipotent N) ∈ Gamma0 (Fin 2) N := by
  simpa using embedFirst_lowerUnipotent_mem_Gamma0 (N := N) 1

variable (N) in
/-- The subgroup of `Sp(4, ℤ)` generated by the Siegel parabolic subgroup and `ι₁(1, 0; N, 1)`. -/
private abbrev gen : Subgroup (symplecticGroup (Fin 2) ℤ) :=
  Subgroup.closure (insert (embedFirst (lowerUnipotent N)) (siegelParabolic (Fin 2) ℤ))

private lemma mem_gen_of_mem (hγ : γ ∈ siegelParabolic (Fin 2) ℤ) : γ ∈ gen N :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ hγ)

private lemma embedFirst_lowerUnipotent_mem_gen (s : ℤ) :
    embedFirst (lowerUnipotent (N * s)) ∈ gen N := by
  have h₁ : embedFirst (lowerUnipotent N) ∈ gen N := Subgroup.subset_closure (Set.mem_insert _ _)
  refine Int.induction_on s ?_ (fun k ih ↦ ?_) fun k ih ↦ ?_
  · rw [mul_zero, lowerUnipotent_zero, map_one]
    exact one_mem _
  · rw [mul_add_one, lowerUnipotent_add, map_mul]
    exact mul_mem ih h₁
  · have h : lowerUnipotent (N * (-k - 1)) = lowerUnipotent (N * -k) * (lowerUnipotent N)⁻¹ :=
      eq_mul_inv_of_mul_eq <| by
        rw [← lowerUnipotent_add]
        congr 1
        ring1
    rw [h, map_mul, map_inv]
    exact mul_mem ih (inv_mem h₁)

private lemma embedSecond_lowerUnipotent_mem_gen (s : ℤ) :
    embedSecond (lowerUnipotent (N * s)) ∈ gen N := by
  rw [embedSecond_eq]
  exact mul_mem (mul_mem (mem_gen_of_mem coordSwap_mem_siegelParabolic)
    (embedFirst_lowerUnipotent_mem_gen s)) (mem_gen_of_mem coordSwap_mem_siegelParabolic)

private lemma mem_gen_of_firstCol (hN : 0 < N) (hN₄ : N ≤ 4) {δ : symplecticGroup (Fin 2) ℤ}
    (hδ : δ ∈ Gamma0 (Fin 2) N) (h₁ : δ.1 (.inl 0) (.inl 0) = 1) (h₂ : δ.1 (.inl 1) (.inl 0) = 0)
    (h₃ : δ.1 (.inr 0) (.inl 0) = 0) (h₄ : δ.1 (.inr 1) (.inl 0) = 0) : δ ∈ gen N := by
  have hc (δ : symplecticGroup (Fin 2) ℤ) (h₁ : δ.1 (.inl 0) (.inl 0) = 1)
      (h₂ : δ.1 (.inl 1) (.inl 0) = 0) (h₃ : δ.1 (.inr 0) (.inl 0) = 0)
      (h₄ : δ.1 (.inr 1) (.inl 0) = 0) : δ.1 (.inr 0) (.inl 1) = 0 := by
    simpa [h₁, h₂, h₃, h₄] using mul_apply_inr_inl_one_eq δ
  have hd : δ.1 (.inr 0) (.inr 1) = 0 := by
    simpa [h₁, h₂, h₃, h₄] using mul_apply_inr_inr_zero_one δ
  refine euclid (Q := fun a c ↦ ∀ δ ∈ Gamma0 (Fin 2) N, δ.1 (.inl 0) (.inl 0) = 1 →
    δ.1 (.inl 1) (.inl 0) = 0 → δ.1 (.inr 0) (.inl 0) = 0 → δ.1 (.inr 1) (.inl 0) = 0 →
      δ.1 (.inl 1) (.inl 1) = a → δ.1 (.inr 1) (.inl 1) = c → δ ∈ gen N) (by exact_mod_cast hN)
    (by exact_mod_cast hN₄) ?_ ?_ ?_ _ _ _ rfl (mem_Gamma0_iff.mp hδ 1 1) ?_ δ hδ h₁ h₂ h₃ h₄ rfl
      rfl
  · rintro a δ - h₁ h₂ h₃ h₄ - h₆
    refine mem_gen_of_mem ?_
    ext i j
    fin_cases i <;> fin_cases j <;> simp [toBlocks₂₁, h₃, h₄, h₆, hc δ h₁ h₂ h₃ h₄]
  · intro a c t hQ δ hδ h₁ h₂ h₃ h₄ h₅ h₆
    refine (Subgroup.mul_mem_cancel_left _ (mem_gen_of_mem (embedSecond_upperUnipotent_mem t))).mp
      (hQ _ (mul_mem (siegelParabolic_le_Gamma0 (embedSecond_upperUnipotent_mem t)) hδ) ?_ ?_ ?_
        ?_ ?_ ?_) <;>
      simp only [embedSecond_mul_apply_inl_zero, embedSecond_mul_apply_inl_one,
        embedSecond_mul_apply_inr_zero, embedSecond_mul_apply_inr_one] <;>
      simp [upperUnipotent, h₁, h₂, h₃, h₄, h₅, h₆]
  · intro a c s hQ δ hδ h₁ h₂ h₃ h₄ h₅ h₆
    refine (Subgroup.mul_mem_cancel_left _ (embedSecond_lowerUnipotent_mem_gen s)).mp
      (hQ _ (mul_mem (embedSecond_lowerUnipotent_mem_Gamma0 s) hδ) ?_ ?_ ?_ ?_ ?_ ?_) <;>
      simp only [embedSecond_mul_apply_inl_zero, embedSecond_mul_apply_inl_one,
        embedSecond_mul_apply_inr_zero, embedSecond_mul_apply_inr_one] <;>
      simp [lowerUnipotent, h₁, h₂, h₃, h₄, h₅, h₆]
    ring1
  · rcases mem_Gamma0_iff.mp hδ 1 1 with ⟨k, hk⟩
    refine ⟨δ.1 (.inr 1) (.inr 1), -(k * δ.1 (.inl 1) (.inr 1)), ?_⟩
    linear_combination mul_apply_inr_inr_one_one δ - δ.1 (.inl 0) (.inl 1) * hd +
      δ.1 (.inl 0) (.inr 1) * hc δ h₁ h₂ h₃ h₄ + δ.1 (.inl 1) (.inr 1) * hk

private lemma mem_gen_of_inr_eq_zero (hN : 0 < N) (hN₄ : N ≤ 4) (hγ : γ ∈ Gamma0 (Fin 2) N)
    (h₃ : γ.1 (.inr 0) (.inl 0) = 0) (h₄ : γ.1 (.inr 1) (.inl 0) = 0) : γ ∈ gen N := by
  have h : γ.1 (.inl 0) (.inl 0) * γ.1 (.inr 0) (.inr 0) +
      γ.1 (.inl 1) (.inl 0) * γ.1 (.inr 1) (.inr 0) = 1 := by
    simpa [h₃, h₄] using mul_apply_inr_inr_zero_zero γ
  let U : SL(2, ℤ) := ⟨!![γ.1 (.inr 0) (.inr 0), γ.1 (.inr 1) (.inr 0); -γ.1 (.inl 1) (.inl 0),
    γ.1 (.inl 0) (.inl 0)], by
      rw [det_fin_two_of]
      linear_combination h⟩
  refine (Subgroup.mul_mem_cancel_left _ (mem_gen_of_mem (rotation_mem_siegelParabolic U))).mp
    (mem_gen_of_firstCol hN hN₄ (mul_mem (siegelParabolic_le_Gamma0
      (rotation_mem_siegelParabolic U)) hγ) ?_ ?_ (rotation_mul_apply_inr_of_eq_zero _ _ _ h₃ h₄)
        (rotation_mul_apply_inr_of_eq_zero _ _ _ h₃ h₄))
  · rw [rotation_mul_apply_inl]
    simp only [U, of_apply, cons_val', cons_val_zero, cons_val_one, empty_val', cons_val_fin_one]
    linear_combination h
  · rw [rotation_mul_apply_inl]
    simp only [U, of_apply, cons_val', cons_val_zero, cons_val_one, empty_val', cons_val_fin_one]
    ring1

private lemma mem_gen_of_inr_zero_eq_zero (hN : 0 < N) (hN₄ : N ≤ 4) (hγ : γ ∈ Gamma0 (Fin 2) N)
    (h₃ : γ.1 (.inr 0) (.inl 0) = 0) (h₂ : IsCoprime (γ.1 (.inl 1) (.inl 0)) N) : γ ∈ gen N := by
  refine euclid (Q := fun a c ↦ ∀ γ ∈ Gamma0 (Fin 2) N, γ.1 (.inr 0) (.inl 0) = 0 →
    γ.1 (.inl 1) (.inl 0) = a → γ.1 (.inr 1) (.inl 0) = c → γ ∈ gen N) (by exact_mod_cast hN)
    (by exact_mod_cast hN₄) ?_ ?_ ?_ _ _ _ rfl (mem_Gamma0_iff.mp hγ 1 0) h₂ γ hγ h₃ rfl rfl
  · rintro a γ hγ h₃ - h₄
    exact mem_gen_of_inr_eq_zero hN hN₄ hγ h₃ h₄
  · intro a c t hQ γ hγ h₃ h₅ h₆
    refine (Subgroup.mul_mem_cancel_left _ (mem_gen_of_mem (embedSecond_upperUnipotent_mem t))).mp
      (hQ _ (mul_mem (siegelParabolic_le_Gamma0 (embedSecond_upperUnipotent_mem t)) hγ) ?_ ?_
        ?_) <;>
      simp only [embedSecond_mul_apply_inl_one, embedSecond_mul_apply_inr_zero,
        embedSecond_mul_apply_inr_one] <;>
      simp [upperUnipotent, h₃, h₅, h₆]
  · intro a c s hQ γ hγ h₃ h₅ h₆
    refine (Subgroup.mul_mem_cancel_left _ (embedSecond_lowerUnipotent_mem_gen s)).mp
      (hQ _ (mul_mem (embedSecond_lowerUnipotent_mem_Gamma0 s) hγ) ?_ ?_ ?_) <;>
      simp only [embedSecond_mul_apply_inl_one, embedSecond_mul_apply_inr_zero,
        embedSecond_mul_apply_inr_one] <;>
      simp [lowerUnipotent, h₃, h₅, h₆]
    ring1

private lemma mem_gen_of_isCoprime (hN : 0 < N) (hN₄ : N ≤ 4) (hγ : γ ∈ Gamma0 (Fin 2) N)
    (h₁ : IsCoprime (γ.1 (.inl 0) (.inl 0)) N) (h₂ : IsCoprime (γ.1 (.inl 1) (.inl 0)) N) :
    γ ∈ gen N := by
  refine euclid (Q := fun a c ↦ ∀ γ ∈ Gamma0 (Fin 2) N, IsCoprime (γ.1 (.inl 1) (.inl 0)) N →
    γ.1 (.inl 0) (.inl 0) = a → γ.1 (.inr 0) (.inl 0) = c → γ ∈ gen N) (by exact_mod_cast hN)
    (by exact_mod_cast hN₄) ?_ ?_ ?_ _ _ _ rfl (mem_Gamma0_iff.mp hγ 0 0) h₁ γ hγ h₂ rfl rfl
  · rintro a γ hγ h₂ - h₃
    exact mem_gen_of_inr_zero_eq_zero hN hN₄ hγ h₃ h₂
  · intro a c t hQ γ hγ h₂ h₅ h₆
    refine (Subgroup.mul_mem_cancel_left _ (mem_gen_of_mem (embedFirst_upperUnipotent_mem t))).mp
      (hQ _ (mul_mem (siegelParabolic_le_Gamma0 (embedFirst_upperUnipotent_mem t)) hγ) ?_ ?_
        ?_) <;>
      simp only [embedFirst_mul_apply_inl_one, embedFirst_mul_apply_inl_zero,
        embedFirst_mul_apply_inr_zero] <;>
      simp [upperUnipotent, h₂, h₅, h₆]
  · intro a c s hQ γ hγ h₂ h₅ h₆
    refine (Subgroup.mul_mem_cancel_left _ (embedFirst_lowerUnipotent_mem_gen s)).mp
      (hQ _ (mul_mem (embedFirst_lowerUnipotent_mem_Gamma0 s) hγ) ?_ ?_ ?_) <;>
      simp only [embedFirst_mul_apply_inl_one, embedFirst_mul_apply_inl_zero,
        embedFirst_mul_apply_inr_zero] <;>
      simp [lowerUnipotent, h₂, h₅, h₆]
    ring1

private lemma isCoprime_pow_iff {p : ℤ} (hp : Prime p) {k : ℕ} (hk : 0 < k) (z : ℤ) :
    IsCoprime z (p ^ k) ↔ ¬p ∣ z := by
  rw [IsCoprime.pow_right_iff hk, isCoprime_comm, hp.coprime_iff_not_dvd]

private lemma isCoprime_or_of_isCoprime_iff {p n : ℤ} (hn : ∀ z, IsCoprime z n ↔ ¬p ∣ z)
    {a₁ a₂ x y : ℤ} (h : IsCoprime (a₁ * x + a₂ * y) n) : IsCoprime a₁ n ∧ IsCoprime a₂ n ∨
      IsCoprime (a₁ + a₂) n ∧ IsCoprime a₂ n ∨ IsCoprime a₁ n ∧ IsCoprime (a₁ + a₂) n := by
  simp only [hn] at h ⊢
  by_cases h₁ : p ∣ a₁ <;> by_cases h₂ : p ∣ a₂
  · exact absurd ((h₁.mul_right x).add (h₂.mul_right y)) h
  · exact Or.inr (Or.inl ⟨fun h₃ ↦ h₂ ((dvd_add_right h₁).mp h₃), h₂⟩)
  · exact Or.inr (Or.inr ⟨h₁, fun h₃ ↦ h₁ ((dvd_add_left h₂).mp h₃)⟩)
  · exact Or.inl ⟨h₁, h₂⟩

private lemma isCoprime_or (hN : 0 < N) (hN₄ : N ≤ 4) {a₁ a₂ x y : ℤ}
    (h : IsCoprime (a₁ * x + a₂ * y) N) : IsCoprime a₁ N ∧ IsCoprime a₂ N ∨
      IsCoprime (a₁ + a₂) N ∧ IsCoprime a₂ N ∨ IsCoprime a₁ N ∧ IsCoprime (a₁ + a₂) N := by
  interval_cases N
  · exact Or.inl (by simp [isCoprime_one_right])
  · exact isCoprime_or_of_isCoprime_iff (p := 2) (fun z ↦ by
      simpa using isCoprime_pow_iff Int.prime_two one_pos z) h
  · exact isCoprime_or_of_isCoprime_iff (p := 3) (fun z ↦ by
      simpa using isCoprime_pow_iff Int.prime_three one_pos z) h
  · exact isCoprime_or_of_isCoprime_iff (p := 2) (fun z ↦ by
      simpa using isCoprime_pow_iff Int.prime_two two_pos z) h

private lemma mem_gen (hN : 0 < N) (hN₄ : N ≤ 4) (hγ : γ ∈ Gamma0 (Fin 2) N) : γ ∈ gen N := by
  rcases mem_Gamma0_iff.mp hγ 0 0 with ⟨k₀, hk₀⟩
  rcases mem_Gamma0_iff.mp hγ 1 0 with ⟨k₁, hk₁⟩
  have hc : IsCoprime (γ.1 (.inl 0) (.inl 0) * γ.1 (.inr 0) (.inr 0) +
      γ.1 (.inl 1) (.inl 0) * γ.1 (.inr 1) (.inr 0)) N :=
    ⟨1, -(k₀ * γ.1 (.inl 0) (.inr 0) + k₁ * γ.1 (.inl 1) (.inr 0)), by
      linear_combination mul_apply_inr_inr_zero_zero γ + γ.1 (.inl 0) (.inr 0) * hk₀ +
        γ.1 (.inl 1) (.inr 0) * hk₁⟩
  rcases isCoprime_or hN hN₄ hc with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
  · exact mem_gen_of_isCoprime hN hN₄ hγ h₁ h₂
  · refine (Subgroup.mul_mem_cancel_left _ (mem_gen_of_mem (rotation_mem_siegelParabolic
      (upperUnipotent 1)))).mp (mem_gen_of_isCoprime hN hN₄ (mul_mem (siegelParabolic_le_Gamma0
        (rotation_mem_siegelParabolic _)) hγ) ?_ ?_) <;>
      rw [rotation_mul_apply_inl] <;> simpa [upperUnipotent]
  · refine (Subgroup.mul_mem_cancel_left _ (mem_gen_of_mem (rotation_mem_siegelParabolic
      (lowerUnipotent 1)))).mp (mem_gen_of_isCoprime hN hN₄ (mul_mem (siegelParabolic_le_Gamma0
        (rotation_mem_siegelParabolic _)) hγ) ?_ ?_) <;>
      rw [rotation_mul_apply_inl] <;> simpa [lowerUnipotent]

/-- **Generators of `Γ₀(N)` for `1 ≤ N ≤ 4`**: the Siegel congruence subgroup `Γ₀(N)` of
`Sp(4, ℤ)` is generated by the Siegel parabolic subgroup `P(ℤ) = {(A, B; 0, D)}` and the element
`ι₁(1, 0; N, 1)`, the image of `(1, 0; N, 1) ∈ SL(2, ℤ)` on the first coordinate. -/
lemma closure_insert_siegelParabolic_eq_Gamma0 (hN : 0 < N) (hN₄ : N ≤ 4) :
    Subgroup.closure (insert (embedFirst (lowerUnipotent N)) (siegelParabolic (Fin 2) ℤ)) =
      Gamma0 (Fin 2) N :=
  le_antisymm ((Subgroup.closure_le _).mpr <| Set.insert_subset
    embedFirst_lowerUnipotent_natCast_mem_Gamma0 siegelParabolic_le_Gamma0) fun _ ↦ mem_gen hN hN₄

/-- **Generators of `Sp(4, ℤ)`**: the symplectic group `Sp(4, ℤ)` is generated by the Siegel
parabolic subgroup `P(ℤ) = {(A, B; 0, D)}` and the partial inversion `J₁`. Its image
`ι₁(1, 0; 1, 1) = J₁⁻¹ ι₁(1, -1; 0, 1) J₁` lies in the subgroup they generate, which is therefore
`Γ₀(1) = Sp(4, ℤ)`. -/
lemma closure_insert_partialInversion_eq_top :
    Subgroup.closure (insert partialInversion (siegelParabolic (Fin 2) ℤ)) = ⊤ := by
  have h : embedFirst (lowerUnipotent 1) =
      partialInversion⁻¹ * (embedFirst (upperUnipotent (-1)) * partialInversion) := by
    rw [← embedFirst_S, ← map_mul, ← S_mul_lowerUnipotent, map_mul, inv_mul_cancel_left]
  refine eq_top_iff.mpr fun γ _ ↦ (Subgroup.closure_le _).mpr (Set.insert_subset ?_
    (Subgroup.subset_closure.trans (Subgroup.closure_mono (Set.subset_insert _ _))))
    ((closure_insert_siegelParabolic_eq_Gamma0 (N := 1) one_pos (by norm_num)).symm ▸
      mem_Gamma0_iff.mpr fun i j ↦ by simp)
  rw [Nat.cast_one, h]
  exact mul_mem (inv_mem (Subgroup.subset_closure (Set.mem_insert _ _))) (mul_mem
    (Subgroup.subset_closure (Set.mem_insert_of_mem _ (embedFirst_upperUnipotent_mem _)))
      (Subgroup.subset_closure (Set.mem_insert _ _)))

end SymplecticGroup
