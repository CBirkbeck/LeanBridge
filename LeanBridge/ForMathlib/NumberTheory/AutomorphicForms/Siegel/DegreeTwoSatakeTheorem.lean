import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.DegreeTwoSatakeMapT1
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.SatakeEigenform

/-!
# Satake's theorem for `Sp(4, ℤ)`

The local Hecke algebra `𝓗_p` of `Γ = Sp(4, ℤ)` at a prime `p` is generated by `T(p)`,
`T_1(p²)` and `T_0(p²)` (`SiegelUpperHalfSpace.mem_of_heckeGenerators`), on which the Satake map
`ω_α` is `α₀ (1 + α_0)(1 + α_1)`, `α₀² p⁻¹ ((α_0 + α_1)(1 + α_0 α_1) + (1 - p⁻²) α_0 α_1)` and
`α₀² α_0 α_1 p⁻³` (`SiegelUpperHalfSpace.satakeMap_Tp`, `SiegelUpperHalfSpace.satakeMap_T₁`,
`SiegelUpperHalfSpace.satakeMap_T₀`). So, with `e₁ = ω(T(p))`, `m = p³ ω(T_0(p²))` and
`e₂ = p ω(T_1(p²)) + (1 + p⁻²) m`, the numbers `α₀, α₀α_0, α₀α_1, α₀α_0α_1` are the roots of
`X⁴ - e₁ X³ + e₂ X² - m e₁ X + m²`, which come in pairs `β, m/β`.

* Existence: a `ℂ`-linear character `λ` of `𝓗_p` with `λ(T_0(p²)) ≠ 0` is a Satake map, and the
  eigencharacter of a Hecke eigenform does not vanish at the scalar `T_0(p²)`, whose Hecke operator
  is the invertible slash operator of `p 1₄`: the case `g = 2` of
  `SiegelUpperHalfSpace.exists_satakeMap_eq_of_ne_zero` and
  `SiegelUpperHalfSpace.IsHeckeEigenform.eigenvalue_elementaryCoset_two_ne_zero`. So every Siegel
  eigenform of degree `2` has Satake parameters at every prime:
  `SiegelUpperHalfSpace.SatakeParametersExist` in degree `2`.
* Uniqueness: the Satake maps at two Satake parameters of one eigenform agree, and the spinor and
  standard Euler factors are functions of the Satake map, through `e₁, e₂, m`. So the Euler factors
  of a Siegel eigenform of degree `2` are well defined:
  `SiegelUpperHalfSpace.EulerFactorsWellDefined` in degree `2`.

The rest of Satake's theorem in degree `2`, that the universal Satake map is a ring isomorphism onto
the Weyl-invariant Laurent polynomials of the cone, is the case `g = 2` of
`SiegelUpperHalfSpace.satakeInvariantsHom_bijective`; that the Satake parameters of an eigenform
form one orbit of the Weyl group `W₂` is not proved.

## Main results

* `SiegelUpperHalfSpace.exists_satakeMap_eq`: a `ℂ`-linear character of `𝓗_p` not vanishing at
  `T_0(p²)` is a Satake map.
* `SiegelUpperHalfSpace.IsHeckeEigenform.exists_isSatakeParameter`: a Hecke eigenform for `𝓗_p`
  has Satake parameters at `p`.
* `SiegelUpperHalfSpace.SiegelEigenform.exists_isSatakeParameter`: a Siegel eigenform of degree
  `2` has Satake parameters at every prime.
* `SiegelUpperHalfSpace.isSatakeParameter_of_heckeGenerators`: an eigenvector of `T(p)`,
  `T_1(p²)` and `T_0(p²)` with the eigenvalues of `ω_α` has the Satake parameter `α`.
* `SiegelUpperHalfSpace.spinorEulerFactor_eq_satakeMap`,
  `SiegelUpperHalfSpace.standardEulerFactor_eq_satakeMap`: the Euler factors through the Satake
  map.
* `SiegelUpperHalfSpace.SiegelEigenform.eq_of_isEulerFactor`: the Euler factors of a Siegel
  eigenform of degree `2` are unique.
-/

open Module Polynomial

open HeckeCosetModule (single)

namespace SiegelUpperHalfSpace

local notation "GL₄" => GL (Fin 2 ⊕ Fin 2) ℚ

local notation "Γ₂" => heckeGamma (Fin 2)

variable {p : ℕ}

/-! ### Characters of the local Hecke algebra -/

lemma map_smul_of_single {f : localSiegelHeckeRing (Fin 2) p →+* ℂ}
    (hf : ∀ D (c : ℂ), f (single ℂ D c) = c * f (single ℂ D 1)) (c : ℂ)
    (x : localSiegelHeckeRing (Fin 2) p) : f (c • x) = c * f x :=
  map_smul_of_map_single p hf c x

/-! ### Local and global Hecke operators -/

attribute [local instance] Fintype.ofFinite

variable {V : Type*} [AddCommGroup V] [Module ℂ V] {ρ : Representation ℂ (GL (Fin 2) ℂ) V}

lemma heckeOperator_heckeMonoidAt {F : SiegelUpperHalfSpace (Fin 2) → V}
    (hF : F ∈ slashInvariants ρ) (D : HeckeCoset (heckeMonoidAt (Fin 2) p) Γ₂ Γ₂) :
    (heckeOperator ρ D ⟨F, fun γ hγ ↦ hF γ hγ⟩ : SiegelUpperHalfSpace (Fin 2) → V) =
      heckeOperator ρ (HeckeCoset.mk Γ₂ Γ₂
        ⟨(D.out : GL₄), heckeMonoidAt_le_heckeMonoid p D.out.2⟩) ⟨F, hF⟩ :=
  heckeOperator_heckeMonoidAt_eq p hF D

variable [Fact p.Prime]

variable (p) in
lemma symplecticDiag_one_zero_zero_eq_elementaryDiag :
    symplecticDiag p 1 0 0 = elementaryDiag p 2 (fun _ ↦ 1) one_le_two_fun :=
  Subtype.ext <| Units.ext <| coe_symplecticDiag_one_zero_zero.trans (coe_elementaryDiag_two p).symm

variable (p) in
lemma heckeCosetDiag_one_zero_zero_eq_elementaryCoset :
    heckeCosetDiag p 1 0 0 = elementaryCoset p 2 (fun _ ↦ 1) one_le_two_fun :=
  congrArg (HeckeCoset.mk _ _) (symplecticDiag_one_zero_zero_eq_elementaryDiag p)

lemma satakeMap_single_eq_mul (α₀ : ℂˣ) (α : Fin 2 → ℂˣ)
    (D : HeckeCoset (heckeMonoidAt (Fin 2) p) Γ₂ Γ₂) (c : ℂ) :
    satakeMap p α₀ α (single ℂ D c) = c * satakeMap p α₀ α (single ℂ D 1) := by
  rw [satakeMap_single, satakeMap_single, one_smul, smul_eq_mul]

/-- **Satake's theorem in degree `2`, existence**: a `ℂ`-linear character `λ` of the local Hecke
algebra `𝓗_p` of `Sp(4, ℤ)` with `λ(T_0(p²)) ≠ 0` is a Satake map `ω_α`. -/
lemma exists_satakeMap_eq {f : localSiegelHeckeRing (Fin 2) p →+* ℂ}
    (hf : ∀ D (c : ℂ), f (single ℂ D c) = c * f (single ℂ D 1))
    (h₀ : f (single ℂ (heckeCosetDiag p 1 0 0) 1) ≠ 0) :
    ∃ (α₀ : ℂˣ) (α : Fin 2 → ℂˣ), satakeMap p α₀ α = f :=
  exists_satakeMap_eq_of_ne_zero p hf (heckeCosetDiag_one_zero_zero_eq_elementaryCoset p ▸ h₀)

/-! ### The Hecke operator `T_0(p²)` -/

lemma heckeOperator_T₀ (F : slashInvariantsOf ρ (heckeMonoidAt (Fin 2) p) Γ₂) :
    (heckeOperator ρ (heckeCosetDiag p 1 0 0) F : SiegelUpperHalfSpace (Fin 2) → V) =
      heckeMonoidSlash ρ (symplecticDiag p 1 0 0) F := by
  rw [heckeCosetDiag_one_zero_zero_eq_elementaryCoset,
    symplecticDiag_one_zero_zero_eq_elementaryDiag]
  exact heckeOperator_elementaryCoset_two p F

lemma eq_zero_of_gspSlash_eq_zero {β : gspPlus (Fin 2)} (hβ : ∀ τ, gspSmul β τ = τ)
    {f : SiegelUpperHalfSpace (Fin 2) → V} (h : gspSlash ρ β f = 0) : f = 0 :=
  eq_zero_of_gspSlash_eq_zero_of_smul_eq hβ h

lemma submonoidToGSpPlus_symplecticDiag : submonoidToGSpPlus (symplecticDiag p 1 0 0) =
    submonoidToGSpPlus (scalarGSp ⟨p, (Fact.out : p.Prime).pos⟩) :=
  Subtype.ext <| congrArg Units.val (symplecticDiag_one_zero_zero p)

lemma gspSmul_symplecticDiag (τ : SiegelUpperHalfSpace (Fin 2)) :
    gspSmul (submonoidToGSpPlus (symplecticDiag p 1 0 0)) τ = τ :=
  (congrArg (gspSmul · τ) submonoidToGSpPlus_symplecticDiag).trans (gspSmul_scalarGSp _ τ)

lemma IsHeckeEigenform.eigenvalue_T₀_ne_zero {F : slashInvariantsOf ρ (heckeMonoidAt (Fin 2) p) Γ₂}
    (hF : IsHeckeEigenform ρ F) : hF.eigenvalue (heckeCosetDiag p 1 0 0) ≠ 0 :=
  heckeCosetDiag_one_zero_zero_eq_elementaryCoset p ▸ hF.eigenvalue_elementaryCoset_two_ne_zero p

/-! ### Existence of Satake parameters -/

/-- **Satake parameters exist in degree `2`**: a Hecke eigenform for the local Hecke algebra
`𝓗_p` of `Sp(4, ℤ)` has Satake parameters at `p`. -/
lemma IsHeckeEigenform.exists_isSatakeParameter
    {F : slashInvariantsOf ρ (heckeMonoidAt (Fin 2) p) Γ₂} (hF : IsHeckeEigenform ρ F) :
    ∃ (α₀ : ℂˣ) (α : Fin 2 → ℂˣ),
      IsSatakeParameter p ρ (F : SiegelUpperHalfSpace (Fin 2) → V) α₀ α :=
  hF.exists_satakeParameter p

/-- **Satake parameters from the generators**: a nonzero `Γ`-invariant function that is an
eigenvector of `T(p)`, `T_1(p²)` and `T_0(p²)` with the eigenvalues `ω_α(T(p))`, `ω_α(T_1(p²))`,
`ω_α(T_0(p²))` is an eigenvector of the whole local Hecke algebra with eigencharacter `ω_α`, so `α`
is a Satake parameter of it. -/
lemma isSatakeParameter_of_heckeGenerators (α₀ : ℂˣ) (α : Fin 2 → ℂˣ)
    {F : slashInvariantsOf ρ (heckeMonoidAt (Fin 2) p) Γ₂} (hF : F ≠ 0)
    (hT : heckeOperator ρ (heckeCosetDiag p 0 0 1) F =
      satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 0 1) 1) • F)
    (hT₁ : heckeOperator ρ (heckeCosetDiag p 0 1 0) F =
      satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 1 0) 1) • F)
    (hT₀ : heckeOperator ρ (heckeCosetDiag p 1 0 0) F =
      satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1) • F) :
    IsSatakeParameter p ρ (F : SiegelUpperHalfSpace (Fin 2) → V) α₀ α := by
  let S : Submodule ℂ (localSiegelHeckeRing (Fin 2) p) :=
    { carrier := {T | heckeAlgebraActionOf ρ (heckeMonoidAt (Fin 2) p) Γ₂ T F =
        satakeMap p α₀ α T • F}
      add_mem' := fun {x y} hx hy ↦ by
        simp only [Set.mem_ofPred_eq, map_add, LinearMap.add_apply, add_smul] at hx hy ⊢
        rw [hx, hy]
      zero_mem' := by simp
      smul_mem' := fun c x hx ↦ by
        simp only [Set.mem_ofPred_eq, map_smul, LinearMap.smul_apply] at hx ⊢
        rw [hx, map_smul_of_single (satakeMap_single_eq_mul α₀ α), smul_smul] }
  have hgen (D : HeckeCoset (heckeMonoidAt (Fin 2) p) Γ₂ Γ₂)
      (h : heckeOperator ρ D F = satakeMap p α₀ α (single ℂ D 1) • F) : single ℂ D 1 ∈ S := by
    simp only [S, Submodule.mem_mk, AddSubmonoid.mem_mk, AddSubsemigroup.mem_mk,
      Set.mem_ofPred_eq]
    rw [heckeAlgebraActionOf_single, one_smul, h]
  have hS (T : localSiegelHeckeRing (Fin 2) p) : T ∈ S := by
    refine mem_of_heckeGenerators S ?_ (fun x hx y hy ↦ ?_) (hgen _ hT) (hgen _ hT₁) (hgen _ hT₀) T
    · simp only [S, Submodule.mem_mk, AddSubmonoid.mem_mk, AddSubsemigroup.mem_mk,
        Set.mem_ofPred_eq]
      rw [map_one (satakeMap p α₀ α), one_smul, HeckeCosetModule.one_def,
        heckeAlgebraActionOf_single, one_smul, heckeOperator_one]
    · simp only [S, Submodule.mem_mk, AddSubmonoid.mem_mk, AddSubsemigroup.mem_mk,
        Set.mem_ofPred_eq] at hx hy ⊢
      rw [heckeAlgebraActionOf_mul, End.mul_apply, hx, map_smul, hy, smul_smul, map_mul]
  refine ⟨F.2, fun h ↦ hF (Subtype.ext h), fun D ↦ ?_⟩
  have h : heckeAlgebraActionOf ρ (heckeMonoidAt (Fin 2) p) Γ₂ (single ℂ D 1) F =
      satakeMap p α₀ α (single ℂ D 1) • F :=
    hS _
  rw [heckeAlgebraActionOf_single, one_smul] at h
  exact congrArg Subtype.val h

variable (p) in
/-- **Satake parameters exist for the Siegel eigenforms of degree `2`**
(`SiegelUpperHalfSpace.SatakeParametersExist` in degree `2`). -/
lemma SiegelEigenform.exists_isSatakeParameter (G : SiegelEigenform) (hG : G.degree = 2) :
    ∃ α₀ α, IsSatakeParameter p G.ρ (G.form : SiegelUpperHalfSpace (Fin G.degree) → G.V) α₀ α := by
  rcases G with ⟨n, W, σ, F, hF⟩
  subst hG
  have hF' : IsHeckeEigenform σ
      (⟨F, fun γ hγ ↦ F.2 γ hγ⟩ : slashInvariantsOf σ (heckeMonoidAt (Fin 2) p) Γ₂) :=
    ⟨hF.1, fun h ↦ hF.2.1 (Subtype.ext (congrArg Subtype.val h)), fun D ↦ ⟨hF.eigenvalue _,
      Subtype.ext ((heckeOperator_heckeMonoidAt F.2 D).trans
        (congrArg Subtype.val (hF.heckeOperator_eq _)))⟩⟩
  exact hF'.exists_isSatakeParameter

/-! ### Uniqueness of the Euler factors -/

lemma IsSatakeParameter.satakeMap_eq {f : SiegelUpperHalfSpace (Fin 2) → V} {α₀ β₀ : ℂˣ}
    {α β : Fin 2 → ℂˣ} (hα : IsSatakeParameter p ρ f α₀ α) (hβ : IsSatakeParameter p ρ f β₀ β) :
    satakeMap p α₀ α = satakeMap p β₀ β :=
  hα.satakeMap_eq_satakeMap p hβ

variable (α₀ : ℂˣ) (α : Fin 2 → ℂˣ)

variable (p) in
/-- **The spinor Euler factor through the Satake map**: with `e₁ = ω_α(T(p))`,
`m = p³ ω_α(T_0(p²))` and `e₂ = p ω_α(T_1(p²)) + (1 + p⁻²) m`, the spinor Euler factor of `α` is
`1 - e₁ X + e₂ X² - m e₁ X³ + m² X⁴`. -/
lemma spinorEulerFactor_eq_satakeMap : spinorEulerFactor (α₀ : ℂ) (fun i ↦ (α i : ℂ)) =
    1 - C (satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 0 1) 1)) * X +
      C (p * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 1 0) 1) + (1 + ((p : ℂ) ^ 2)⁻¹) *
        ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1))) * X ^ 2 -
      C ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1) *
        satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 0 1) 1)) * X ^ 3 +
      C (((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1)) ^ 2) * X ^ 4 := by
  have hp : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero
  have h₂ : (p : ℂ) * ((α₀ : ℂ) ^ 2 * (p : ℂ)⁻¹ *
      ((α 0 + α 1) * (1 + α 0 * α 1) + (1 - ((p : ℂ) ^ 2)⁻¹) * α 0 * α 1)) +
        (1 + ((p : ℂ) ^ 2)⁻¹) * ((p : ℂ) ^ 3 *
          ((α₀ : ℂ) ^ 2 * ((α 0 : ℂ) * ((p : ℂ) ^ 2)⁻¹) * ((α 1 : ℂ) * (p : ℂ)⁻¹))) =
      (α₀ : ℂ) ^ 2 * (α 0 + α 1 + 2 * α 0 * α 1 + α 0 ^ 2 * α 1 + α 0 * α 1 ^ 2) := by
    field_simp
    ring1
  have h₀ : (p : ℂ) ^ 3 * ((α₀ : ℂ) ^ 2 * ((α 0 : ℂ) * ((p : ℂ) ^ 2)⁻¹) * ((α 1 : ℂ) * (p : ℂ)⁻¹)) =
      (α₀ : ℂ) ^ 2 * α 0 * α 1 := by
    field_simp
  rw [satakeMap_Tp, satakeMap_T₁, satakeMap_T₀, h₂, h₀, spinorEulerFactor_fin_two]
  simp only [map_add, map_mul, map_pow, map_ofNat, map_one]
  ring1

variable (p) in
/-- **The standard Euler factor through the Satake map**: with `e₁, e₂, m` as for the spinor
Euler factor, `s = (e₂ - 2m)/m` and `t = (e₁² - 2e₂)/m`, the standard Euler factor of `α` is
`(1 - X)(1 - s X + (2 + t) X² - s X³ + X⁴)`. -/
lemma standardEulerFactor_eq_satakeMap : standardEulerFactor (fun i ↦ (α i : ℂ)) =
    (1 - X) * (1 - C ((p * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 1 0) 1) +
      (1 + ((p : ℂ) ^ 2)⁻¹) *
        ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1)) -
        2 * ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1))) /
          ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1))) * X +
      C (2 + (satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 0 1) 1) ^ 2 -
        2 * (p * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 1 0) 1) +
          (1 + ((p : ℂ) ^ 2)⁻¹) *
            ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1)))) /
          ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1))) * X ^ 2 -
      C ((p * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 0 1 0) 1) +
        (1 + ((p : ℂ) ^ 2)⁻¹) *
          ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1)) -
        2 * ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1))) /
          ((p : ℂ) ^ 3 * satakeMap p α₀ α (single ℂ (heckeCosetDiag p 1 0 0) 1))) * X ^ 3 +
      X ^ 4) := by
  have hp : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero
  have ha₀ : (α₀ : ℂ) ≠ 0 := α₀.ne_zero
  have ha (i : Fin 2) : (α i : ℂ) ≠ 0 := (α i).ne_zero
  have hs : (p * ((α₀ : ℂ) ^ 2 * (p : ℂ)⁻¹ *
      ((α 0 + α 1) * (1 + α 0 * α 1) + (1 - ((p : ℂ) ^ 2)⁻¹) * α 0 * α 1)) +
        (1 + ((p : ℂ) ^ 2)⁻¹) * ((p : ℂ) ^ 3 *
          ((α₀ : ℂ) ^ 2 * ((α 0 : ℂ) * ((p : ℂ) ^ 2)⁻¹) * ((α 1 : ℂ) * (p : ℂ)⁻¹))) -
        2 * ((p : ℂ) ^ 3 *
          ((α₀ : ℂ) ^ 2 * ((α 0 : ℂ) * ((p : ℂ) ^ 2)⁻¹) * ((α 1 : ℂ) * (p : ℂ)⁻¹)))) /
      ((p : ℂ) ^ 3 * ((α₀ : ℂ) ^ 2 * ((α 0 : ℂ) * ((p : ℂ) ^ 2)⁻¹) * ((α 1 : ℂ) * (p : ℂ)⁻¹))) =
        α 0 + (α 0 : ℂ)⁻¹ + (α 1 + (α 1 : ℂ)⁻¹) := by
    field_simp
    ring1
  have ht : (((α₀ : ℂ) * (1 + α 0) * (1 + α 1)) ^ 2 - 2 * (p * ((α₀ : ℂ) ^ 2 * (p : ℂ)⁻¹ *
      ((α 0 + α 1) * (1 + α 0 * α 1) + (1 - ((p : ℂ) ^ 2)⁻¹) * α 0 * α 1)) +
        (1 + ((p : ℂ) ^ 2)⁻¹) * ((p : ℂ) ^ 3 *
          ((α₀ : ℂ) ^ 2 * ((α 0 : ℂ) * ((p : ℂ) ^ 2)⁻¹) * ((α 1 : ℂ) * (p : ℂ)⁻¹))))) /
      ((p : ℂ) ^ 3 * ((α₀ : ℂ) ^ 2 * ((α 0 : ℂ) * ((p : ℂ) ^ 2)⁻¹) * ((α 1 : ℂ) * (p : ℂ)⁻¹))) =
        (α 0 + (α 0 : ℂ)⁻¹) * (α 1 + (α 1 : ℂ)⁻¹) := by
    field_simp
    ring1
  have hq (i : Fin 2) : (1 - C (α i : ℂ) * X) * (1 - C (α i : ℂ)⁻¹ * X) =
      1 - C ((α i : ℂ) + (α i : ℂ)⁻¹) * X + X ^ 2 := by
    have e : C (α i : ℂ) * C (α i : ℂ)⁻¹ = 1 := by
      rw [← map_mul, mul_inv_cancel₀ (ha i), map_one]
    rw [map_add]
    linear_combination X ^ 2 * e
  rw [satakeMap_Tp, satakeMap_T₁, satakeMap_T₀, hs, ht, standardEulerFactor, Fin.prod_univ_two,
    hq, hq]
  simp only [map_add, map_mul, map_ofNat]
  ring1

/-- **The Euler factors of a Siegel eigenform of degree `2` are well defined**
(`SiegelUpperHalfSpace.EulerFactorsWellDefined` in degree `2`): two Euler factors of one kind of
a Siegel eigenform of degree `2` at `p` are equal. -/
lemma SiegelEigenform.eq_of_isEulerFactor (G : SiegelEigenform) (hG : G.degree = 2)
    (t : EulerFactorKind) {Q Q' : ℂ[X]} (hQ : G.IsEulerFactor t p Q)
    (hQ' : G.IsEulerFactor t p Q') : Q = Q' := by
  rcases G with ⟨n, W, σ, F, hF⟩
  subst hG
  rcases hQ with ⟨β₀, β, hβ, rfl⟩
  rcases hQ' with ⟨γ₀, γ, hγ, rfl⟩
  have h : satakeMap p β₀ β = satakeMap p γ₀ γ := hβ.satakeMap_eq hγ
  rcases t with - | -
  · simp only [EulerFactorKind.eulerFactor]
    rw [spinorEulerFactor_eq_satakeMap p, spinorEulerFactor_eq_satakeMap p, h]
  · simp only [EulerFactorKind.eulerFactor]
    rw [standardEulerFactor_eq_satakeMap p β₀, standardEulerFactor_eq_satakeMap p γ₀, h]

end SiegelUpperHalfSpace
