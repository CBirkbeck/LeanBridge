import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.SatakeIsomorphism
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.SiegelLift
import LeanBridge.ForMathlib.RingTheory.Ideal.GoingUp
import Mathlib.Algebra.Polynomial.Lifts

/-!
# Satake's theorem for `Sp(2g, ℤ)` in every degree

The universal Satake map identifies the local Hecke algebra `𝓗_p` of `Γ = Sp(2g, ℤ)` at a prime
`p` with the Weyl-invariant Laurent polynomials supported on the cone `0 ≤ d_j ≤ δ`
(`SiegelUpperHalfSpace.satakeMapUniv_injective`,
`SiegelUpperHalfSpace.exists_satakeMapUniv_eq_iff`), a ring isomorphism onto its image
(`SiegelUpperHalfSpace.satakeInvariantsHom_bijective`). The algebra `L_g^+` of the cone is
generated by the `2^g` spinor monomials `y_S = x₀ ∏_{i ∈ S} x_i`, each a root of the monic
polynomial `∏_S (X - y_S)`, whose coefficients are Weyl-invariant, so `L_g^+` is integral over the
image of `𝓗_p`. By lying over and the Nullstellensatz (an algebraic extension of `ℂ` is `ℂ`,
`Subalgebra.exists_algHom_eq_of_isIntegral`), every `ℂ`-linear character `λ` of `𝓗_p`
extends to a character `ψ` of `L_g^+`; when `λ(T_0(p²)) ≠ 0`, `T_0(p²) = Γ (p 1_{2g}) Γ` having the
image `c x₀ y_{\{0, …, g-1\}}`, the values `α₀ = ψ(x₀)` and `α₀ α_j = ψ(x₀ x_j)` are nonzero, and
`ψ` is the evaluation at `(α₀; α)`, so `λ = ω_α`
(`SiegelUpperHalfSpace.exists_satakeMap_eq_of_ne_zero`).

The coefficients of the universal spinor polynomial `∏_S (1 - y_S X)` and those of the universal
standard polynomial `(1 - X) ∏_i (1 - x_i X)(1 - x_i⁻¹ X)` times `t^g`, `t = x₀² ∏_i x_i`, are
Weyl-invariant and supported on the cone, hence in the image of `𝓗_p`, which is what the
uniqueness of the Euler factors of an eigenform needs
(`SiegelUpperHalfSpace.eulerFactorsWellDefined`).
That the Satake parameters of an eigenform form one orbit of the Weyl group is not proved here; the
Euler factors only need the image.

## Main definitions

* `SiegelUpperHalfSpace.spinorWeight`, `SiegelUpperHalfSpace.stdWeight`,
  `SiegelUpperHalfSpace.scalarWeight`: the weights of the spinor monomials, of `x_i^{±1}` and of
  `t = x₀² ∏_i x_i`.
* `SiegelUpperHalfSpace.spinorPolyUniv`, `SiegelUpperHalfSpace.standardPolyUniv`: the universal
  spinor and standard Euler factors.
* `SiegelUpperHalfSpace.coneInvariants`: the Weyl invariants of the cone algebra.
* `SiegelUpperHalfSpace.spinorMonomial`, `SiegelUpperHalfSpace.coneMonomial`: monomials of the cone
  algebra.
* `SiegelUpperHalfSpace.satakeInvariantsHom`: the universal Satake map onto the Weyl invariants of
  the cone algebra.

## Main results

* `SiegelUpperHalfSpace.satakeInvariantsHom_bijective`: **Satake's isomorphism**.
* `SiegelUpperHalfSpace.exists_satakeMap_eq_of_ne_zero`: a `ℂ`-linear character of `𝓗_p` not
  vanishing at `T_0(p²)` is a Satake map.
-/

open DoubleCoset MonoidAlgebra Polynomial

open HeckeCosetModule (single)

namespace SiegelUpperHalfSpace

attribute [local instance] Fintype.ofFinite

variable {n : ℕ}

/-! ### The spinor monomials -/

variable (n) in
/-- The weight `(1; 1_S)` of the **spinor monomial** `y_S = x₀ ∏_{i ∈ S} x_i` (LMFDB
`mf.siegel.lift`, through the spinor Euler factor). -/
def spinorWeight (S : Finset (Fin n)) : SatakeWeight n :=
  .ofAdd (1, fun i ↦ if i ∈ S then 1 else 0)

lemma spinorWeight_mem_satakeCone (S : Finset (Fin n)) : spinorWeight n S ∈ satakeCone n :=
  ⟨zero_le_one, fun i ↦ by
    simp only [spinorWeight, toAdd_ofAdd]
    split_ifs <;> simp⟩

lemma weylPerm_spinorWeight (σ : Equiv.Perm (Fin n)) (S : Finset (Fin n)) :
    weylPerm σ (spinorWeight n S) = spinorWeight n (S.map σ.toEmbedding) := by
  simp only [weylPerm, spinorWeight, MulEquiv.coe_mk, Equiv.coe_fn_mk]
  refine congrArg Multiplicative.ofAdd (Prod.ext rfl (funext fun i ↦ ?_))
  simp

lemma weylSign_spinorWeight (j : Fin n) (S : Finset (Fin n)) :
    weylSign j (spinorWeight n S) = spinorWeight n (symmDiff S {j}) := by
  simp only [weylSign, spinorWeight, MulEquiv.coe_mk, Equiv.coe_fn_mk]
  refine congrArg Multiplicative.ofAdd (Prod.ext rfl (funext fun i ↦ ?_))
  rcases eq_or_ne i j with rfl | hi
  · by_cases hiS : i ∈ S <;> simp [hiS, Finset.mem_symmDiff]
  · simp [Finset.mem_symmDiff, hi]

lemma weightCharacter_spinorWeight (α₀ : ℂˣ) (α : Fin n → ℂˣ) (S : Finset (Fin n)) :
    (weightCharacter α₀ α (spinorWeight n S) : ℂ) = α₀ * ∏ i ∈ S, (α i : ℂ) := by
  have h (i : Fin n) : ((α i ^ (if i ∈ S then (1 : ℤ) else 0) : ℂˣ) : ℂ) =
      if i ∈ S then (α i : ℂ) else 1 := by
    split_ifs <;> simp
  simp only [weightCharacter, spinorWeight, MonoidHom.coe_mk, OneHom.coe_mk, toAdd_ofAdd,
    zpow_one, Units.val_mul, Units.coe_prod, h, Finset.prod_ite_mem, Finset.univ_inter]

/-! ### Products over the spinor monomials -/

variable {G : SatakeLaurent n → (SatakeLaurent n)[X]}

lemma map_prod_spinorWeight (hG : ∀ (e : SatakeWeight n ≃* SatakeWeight n) y,
    (G y).map (domCongr ℂ ℂ e : SatakeLaurent n →+* SatakeLaurent n) = G (domCongr ℂ ℂ e y))
    (e : SatakeWeight n ≃* SatakeWeight n) (π : Finset (Fin n) ≃ Finset (Fin n))
    (hπ : ∀ S, e (spinorWeight n S) = spinorWeight n (π S)) :
    (∏ S, G (single (spinorWeight n S) 1)).map
      (domCongr ℂ ℂ e : SatakeLaurent n →+* SatakeLaurent n) =
        ∏ S, G (single (spinorWeight n S) 1) := by
  rw [Polynomial.map_prod]
  exact Fintype.prod_equiv π _ _ fun S ↦ by rw [hG, domCongr_single, hπ]

open Function in
lemma coeff_prod_spinorWeight_mem_weylInvariants (hG : ∀ (e : SatakeWeight n ≃* SatakeWeight n) y,
    (G y).map (domCongr ℂ ℂ e : SatakeLaurent n →+* SatakeLaurent n) = G (domCongr ℂ ℂ e y))
    (k : ℕ) : (∏ S, G (single (spinorWeight n S) 1)).coeff k ∈ weylInvariants n := by
  refine mem_weylInvariants (fun σ ↦ ?_) fun j ↦ ?_
  · exact (Polynomial.coeff_map _ k).symm.trans (congrArg (fun P : (SatakeLaurent n)[X] ↦
      P.coeff k) (map_prod_spinorWeight hG (weylPerm σ) (Equiv.finsetCongr σ) fun S ↦
        weylPerm_spinorWeight σ S))
  · exact (Polynomial.coeff_map _ k).symm.trans (congrArg (fun P : (SatakeLaurent n)[X] ↦
      P.coeff k) (map_prod_spinorWeight hG (weylSign j) (symmDiff_left_involutive {j}).toPerm
        fun S ↦ by rw [weylSign_spinorWeight, Involutive.coe_toPerm, symmDiff_comm]))

/-! ### The universal Euler factors -/

variable (n) in
/-- The **universal spinor Euler factor** `∏_S (1 - x₀ ∏_{i ∈ S} x_i X)` (LMFDB `mf.siegel.lift`),
whose value at a point is `SiegelUpperHalfSpace.spinorEulerFactor`. -/
noncomputable def spinorPolyUniv : (SatakeLaurent n)[X] :=
  ∏ S : Finset (Fin n), (1 - C (single (spinorWeight n S) 1) * X)

variable (n) in
/-- The weight `(0; e e_i)` of `x_i^e` (LMFDB `mf.siegel.lift`, through the **standard Euler
factor**). -/
def stdWeight (i : Fin n) (e : ℤ) : SatakeWeight n :=
  .ofAdd (0, Pi.single i e)

variable (n) in
/-- The **universal standard Euler factor** `(1 - X) ∏_i (1 - x_i X)(1 - x_i⁻¹ X)` (LMFDB
`mf.siegel.lift`), whose value at a point is `SiegelUpperHalfSpace.standardEulerFactor`. -/
noncomputable def standardPolyUniv : (SatakeLaurent n)[X] :=
  (1 - X) * ∏ i, (1 - C (single (stdWeight n i 1) 1) * X) *
    (1 - C (single (stdWeight n i (-1)) 1) * X)

variable (α₀ : ℂˣ) (α : Fin n → ℂˣ)

lemma map_satakeEval_spinorPolyUniv :
    (spinorPolyUniv n).map (satakeEval α₀ α : SatakeLaurent n →+* ℂ) =
      spinorEulerFactor (α₀ : ℂ) fun i ↦ (α i : ℂ) := by
  simp only [spinorPolyUniv, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_one,
    Polynomial.map_mul, map_C, map_X]
  refine Finset.prod_congr rfl fun S _ ↦ ?_
  rw [RingHom.coe_coe, satakeEval_single, one_mul, weightCharacter_spinorWeight]

lemma satakeEval_stdWeight (i : Fin n) (e : ℤ) :
    satakeEval α₀ α (single (stdWeight n i e) 1) = (α i : ℂ) ^ e := by
  rw [satakeEval_single, one_mul]
  simp only [weightCharacter, stdWeight, MonoidHom.coe_mk, OneHom.coe_mk, toAdd_ofAdd, zpow_zero,
    one_mul, Units.coe_prod, Units.val_zpow_eq_zpow_val]
  rw [Finset.prod_eq_single i (fun j _ hj ↦ by rw [Pi.single_eq_of_ne hj, zpow_zero])
    (fun h ↦ absurd (Finset.mem_univ i) h), Pi.single_eq_same]

lemma map_satakeEval_standardPolyUniv :
    (standardPolyUniv n).map (satakeEval α₀ α : SatakeLaurent n →+* ℂ) =
      standardEulerFactor fun i ↦ (α i : ℂ) := by
  simp only [standardPolyUniv, standardEulerFactor, Polynomial.map_mul, Polynomial.map_prod,
    Polynomial.map_sub, Polynomial.map_one, map_C, map_X, RingHom.coe_coe, satakeEval_stdWeight,
    zpow_one, zpow_neg]

lemma weylPerm_stdWeight (σ : Equiv.Perm (Fin n)) (i : Fin n) (e : ℤ) :
    weylPerm σ (stdWeight n i e) = stdWeight n (σ i) e := by
  simp only [weylPerm, stdWeight, MulEquiv.coe_mk, Equiv.coe_fn_mk, toAdd_ofAdd]
  refine congrArg Multiplicative.ofAdd (Prod.ext rfl (funext fun l ↦ ?_))
  dsimp only [Function.comp_apply]
  rcases eq_or_ne l (σ i) with rfl | hl
  · simp
  · rw [Pi.single_eq_of_ne hl, Pi.single_eq_of_ne fun h ↦ hl (by rw [← h, Equiv.apply_symm_apply])]

lemma weylSign_stdWeight (j i : Fin n) (e : ℤ) :
    weylSign j (stdWeight n i e) = stdWeight n i (if i = j then -e else e) := by
  simp only [weylSign, stdWeight, MulEquiv.coe_mk, Equiv.coe_fn_mk, toAdd_ofAdd]
  refine congrArg Multiplicative.ofAdd (Prod.ext rfl (funext fun l ↦ ?_))
  dsimp only
  rcases eq_or_ne l j with rfl | hl
  · rcases eq_or_ne i l with rfl | hil
    · simp
    · simp [hil]
  · rw [Function.update_of_ne hl]
    split_ifs with hij
    · subst hij
      rw [Pi.single_eq_of_ne hl, Pi.single_eq_of_ne hl]
    · rfl

lemma coeff_standardPolyUniv_mem_weylInvariants (k : ℕ) :
    (standardPolyUniv n).coeff k ∈ weylInvariants n := by
  have hF (e : SatakeWeight n ≃* SatakeWeight n) (i : Fin n) :
      ((1 - C (single (stdWeight n i 1) (1 : ℂ)) * X) *
        (1 - C (single (stdWeight n i (-1)) (1 : ℂ)) * X)).map
          (domCongr ℂ ℂ e : SatakeLaurent n →+* SatakeLaurent n) =
          (1 - C (single (e (stdWeight n i 1)) 1) * X) *
            (1 - C (single (e (stdWeight n i (-1))) 1) * X) := by
    simp only [Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_one, map_C, map_X,
      RingHom.coe_coe, domCongr_single]
  refine mem_weylInvariants (fun σ ↦ ?_) fun j ↦ ?_
  · have h : (standardPolyUniv n).map (domCongr ℂ ℂ (weylPerm σ) : SatakeLaurent n →+*
        SatakeLaurent n) = standardPolyUniv n := by
      rw [standardPolyUniv, Polynomial.map_mul, Polynomial.map_prod]
      simp only [hF, weylPerm_stdWeight, Polynomial.map_sub, Polynomial.map_one, map_X]
      exact congrArg _ (Equiv.prod_comp σ fun i ↦ (1 - C (single (stdWeight n i 1) 1) * X) *
        (1 - C (single (stdWeight n i (-1)) 1) * X))
    exact (Polynomial.coeff_map _ k).symm.trans (congrArg (fun P : (SatakeLaurent n)[X] ↦
      P.coeff k) h)
  · have h : (standardPolyUniv n).map (domCongr ℂ ℂ (weylSign j) : SatakeLaurent n →+*
        SatakeLaurent n) = standardPolyUniv n := by
      rw [standardPolyUniv, Polynomial.map_mul, Polynomial.map_prod]
      simp only [hF, weylSign_stdWeight, Polynomial.map_sub, Polynomial.map_one, map_X]
      refine congrArg _ (Finset.prod_congr rfl fun i _ ↦ ?_)
      split_ifs
      · rw [neg_neg, mul_comm]
      · rfl
    exact (Polynomial.coeff_map _ k).symm.trans (congrArg (fun P : (SatakeLaurent n)[X] ↦
      P.coeff k) h)

lemma coeff_spinorPolyUniv_mem_weylInvariants (k : ℕ) :
    (spinorPolyUniv n).coeff k ∈ weylInvariants n :=
  coeff_prod_spinorWeight_mem_weylInvariants (G := fun y ↦ 1 - C y * X) (fun e y ↦ by
    simp only [Polynomial.map_sub, Polynomial.map_one, Polynomial.map_mul, map_C, map_X]
    rfl) k

lemma C_mem_liftsRing {y : SatakeLaurent n} (hy : y ∈ coneAlgebra n) :
    C y ∈ liftsRing (coneAlgebra n).val.toRingHom :=
  (lifts_iff_liftsRing _ _).mp (C_mem_lifts _ (⟨y, hy⟩ : coneAlgebra n))

lemma X_mem_liftsRing : (X : (SatakeLaurent n)[X]) ∈ liftsRing (coneAlgebra n).val.toRingHom :=
  (lifts_iff_liftsRing _ _).mp (X_mem_lifts _)

lemma coeff_mem_coneAlgebra {P : (SatakeLaurent n)[X]}
    (hP : P ∈ liftsRing (coneAlgebra n).val.toRingHom) (k : ℕ) : P.coeff k ∈ coneAlgebra n := by
  rcases (lifts_iff_coeff_lifts P).mp ((lifts_iff_liftsRing _ P).mpr hP) k with ⟨x, hx⟩
  rw [← hx]
  exact x.2

lemma coeff_spinorPolyUniv_mem_coneAlgebra (k : ℕ) : (spinorPolyUniv n).coeff k ∈ coneAlgebra n :=
  coeff_mem_coneAlgebra (Subring.prod_mem _ fun S _ ↦ sub_mem (one_mem _) (mul_mem
    (C_mem_liftsRing (single_mem_coneAlgebra (spinorWeight_mem_satakeCone S) 1)) X_mem_liftsRing)) k

variable (n) in
/-- The weight `(2; 1, …, 1)` of `t = x₀² ∏_i x_i`, the image of `T_0(p²)` up to a constant
(LMFDB `mf.siegel.lift`, through the **scalar Hecke operator**). -/
def scalarWeight : SatakeWeight n :=
  .ofAdd (2, fun _ ↦ 1)

lemma scalarWeight_mem_satakeCone : scalarWeight n ∈ satakeCone n :=
  ⟨zero_le_two, fun _ ↦ ⟨zero_le_one, one_le_two⟩⟩

lemma single_scalarWeight_mem_weylInvariants : single (scalarWeight n) 1 ∈ weylInvariants n := by
  refine mem_weylInvariants (fun σ ↦ ?_) fun j ↦ ?_
  · rw [domCongr_single]
    rfl
  · rw [domCongr_single]
    refine congrArg (single · 1) ?_
    simp only [weylSign, scalarWeight, MulEquiv.coe_mk, Equiv.coe_fn_mk, toAdd_ofAdd]
    refine congrArg Multiplicative.ofAdd (Prod.ext rfl (funext fun i ↦ ?_))
    dsimp only
    rcases eq_or_ne i j with rfl | hi
    · rw [Function.update_self]
      norm_num
    · rw [Function.update_of_ne hi]

lemma mul_stdWeight_mem_satakeCone (i : Fin n) {e : ℤ} (he : e = 1 ∨ e = -1) :
    scalarWeight n * stdWeight n i e ∈ satakeCone n := by
  refine ⟨by simp [scalarWeight, stdWeight], fun l ↦ ?_⟩
  rcases eq_or_ne l i with rfl | hl
  · rcases he with rfl | rfl <;> simp [scalarWeight, stdWeight]
  · simp [scalarWeight, stdWeight, Pi.single_eq_of_ne hl]

lemma single_mul_one_eq (μ ν : SatakeWeight n) :
    single (μ * ν) (1 : ℂ) = single μ 1 * single ν 1 := by
  rw [single_mul_single, one_mul]

lemma C_pow_mul_standardPolyUniv_mem_liftsRing :
    C (single (scalarWeight n) 1 ^ n) * standardPolyUniv n ∈
      liftsRing (coneAlgebra n).val.toRingHom := by
  have h₁ (i : Fin n) : single (stdWeight n i 1) (1 : ℂ) * single (stdWeight n i (-1)) 1 = 1 := by
    have e : stdWeight n i 1 * stdWeight n i (-1) = 1 := by
      apply Multiplicative.toAdd.injective
      simp [stdWeight, ← Pi.single_add]
    rw [single_mul_single, one_mul, e, ← one_def]
  have h₂ (i : Fin n) : C (single (scalarWeight n) (1 : ℂ)) *
      ((1 - C (single (stdWeight n i 1) 1) * X) * (1 - C (single (stdWeight n i (-1)) 1) * X)) =
        C (single (scalarWeight n) 1) - C (single (scalarWeight n * stdWeight n i 1) 1 +
          single (scalarWeight n * stdWeight n i (-1)) 1) * X +
            C (single (scalarWeight n) 1) * X ^ 2 := by
    have e : C (single (scalarWeight n) (1 : ℂ)) * (C (single (stdWeight n i 1) 1) *
        C (single (stdWeight n i (-1)) 1)) = C (single (scalarWeight n) 1) := by
      rw [← map_mul, h₁, map_one, mul_one]
    rw [single_mul_one_eq, single_mul_one_eq, map_add, map_mul, map_mul]
    linear_combination X ^ 2 * e
  have h₃ : C (single (scalarWeight n) 1 ^ n) * standardPolyUniv n = (1 - X) * ∏ i : Fin n,
      C (single (scalarWeight n) (1 : ℂ)) * ((1 - C (single (stdWeight n i 1) 1) * X) *
        (1 - C (single (stdWeight n i (-1)) 1) * X)) := by
    rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin, map_pow,
      standardPolyUniv]
    ring1
  rw [h₃]
  refine mul_mem (sub_mem (one_mem _) X_mem_liftsRing) (Subring.prod_mem _ fun i _ ↦ ?_)
  rw [h₂]
  refine add_mem (sub_mem (C_mem_liftsRing (single_mem_coneAlgebra scalarWeight_mem_satakeCone 1))
    (mul_mem (C_mem_liftsRing (add_mem ?_ ?_)) X_mem_liftsRing)) (mul_mem (C_mem_liftsRing
      (single_mem_coneAlgebra scalarWeight_mem_satakeCone 1)) (pow_mem X_mem_liftsRing 2))
  · exact single_mem_coneAlgebra (mul_stdWeight_mem_satakeCone i (Or.inl rfl)) 1
  · exact single_mem_coneAlgebra (mul_stdWeight_mem_satakeCone i (Or.inr rfl)) 1

lemma coeff_C_pow_mul_standardPolyUniv_mem_weylInvariants (k : ℕ) :
    (C (single (scalarWeight n) 1 ^ n) * standardPolyUniv n).coeff k ∈ weylInvariants n := by
  rw [coeff_C_mul]
  exact mul_mem (pow_mem single_scalarWeight_mem_weylInvariants n)
    (coeff_standardPolyUniv_mem_weylInvariants k)

/-! ### The cone algebra is integral over its Weyl invariants -/

variable (n) in
/-- The **Weyl-invariant Laurent polynomials of the cone** (LMFDB `mf.siegel.lift`, through Satake's
theorem), as a subalgebra of the cone algebra: the image of the universal Satake map. -/
noncomputable def coneInvariants : Subalgebra ℂ (coneAlgebra n) :=
  (weylInvariants n).comap (coneAlgebra n).val

variable (n) in
/-- The **spinor monomial** `y_S = x₀ ∏_{i ∈ S} x_i` in the cone algebra (LMFDB `mf.siegel.lift`,
through the spinor Euler factor). -/
noncomputable def spinorMonomial (S : Finset (Fin n)) : coneAlgebra n :=
  ⟨single (spinorWeight n S) 1, single_mem_coneAlgebra (spinorWeight_mem_satakeCone S) 1⟩

lemma isIntegral_spinorMonomial (S : Finset (Fin n)) :
    IsIntegral (coneInvariants n) (spinorMonomial n S) := by
  let R : (coneAlgebra n)[X] := ∏ S' : Finset (Fin n), (X - C (spinorMonomial n S'))
  have hR : R.map (coneAlgebra n).val.toRingHom = ∏ S' : Finset (Fin n),
      (X - C (single (spinorWeight n S') 1)) := by
    simp only [R, Polynomial.map_prod, Polynomial.map_sub, map_X, map_C]
    rfl
  have hlifts : R ∈ lifts (algebraMap (coneInvariants n) (coneAlgebra n)) :=
    (lifts_iff_coeff_lifts R).mpr fun k ↦ ⟨⟨R.coeff k, by
      have h : (∏ S' : Finset (Fin n), (X - C (single (spinorWeight n S') (1 : ℂ)))).coeff k ∈
          weylInvariants n :=
        coeff_prod_spinorWeight_mem_weylInvariants (G := fun y ↦ X - C y) (fun e y ↦ by
          simp only [Polynomial.map_sub, map_X, map_C]
          rfl) k
      rwa [← hR, Polynomial.coeff_map] at h⟩, rfl⟩
  rcases lifts_and_degree_eq_and_monic hlifts (monic_prod_of_monic _ _ fun S' _ ↦
    monic_X_sub_C _) with ⟨q, hq, -, hqm⟩
  refine ⟨q, hqm, ?_⟩
  rw [← eval_map, hq, eval_prod]
  exact Finset.prod_eq_zero (Finset.mem_univ S) (by rw [eval_sub, eval_X, eval_C, sub_self])

/-! ### Cone monomials as products of spinor monomials -/

lemma prod_spinorWeight_eq {μ : SatakeWeight n} (hμ : μ ∈ satakeCone n) :
    ∏ i ∈ Finset.range μ.toAdd.1.toNat, spinorWeight n (Finset.univ.filter fun j ↦
      (i : ℤ) < μ.toAdd.2 j) = μ := by
  apply_fun Multiplicative.toAdd using Multiplicative.toAdd.injective
  rw [toAdd_prod]
  refine Prod.ext ?_ (funext fun j ↦ ?_)
  · simp [spinorWeight, Prod.fst_sum, Int.toNat_of_nonneg hμ.1]
  · simp only [spinorWeight, toAdd_ofAdd, Prod.snd_sum, Finset.sum_apply, Finset.mem_filter,
      Finset.mem_univ, true_and, Finset.sum_boole]
    have h : (Finset.range μ.toAdd.1.toNat).filter (fun i : ℕ ↦ (i : ℤ) < μ.toAdd.2 j) =
        Finset.range (μ.toAdd.2 j).toNat := by
      ext i
      simp only [Finset.mem_filter, Finset.mem_range]
      have h₁ : 0 ≤ μ.toAdd.2 j := (hμ.2 j).1
      have h₂ : μ.toAdd.2 j ≤ μ.toAdd.1 := (hμ.2 j).2
      omega
    rw [h, Finset.card_range, Int.toNat_of_nonneg (hμ.2 j).1]

variable (n) in
/-- The **monomial `x^μ` of a weight `μ` of the cone** in the cone algebra (LMFDB `mf.siegel.lift`,
through Satake's theorem). -/
noncomputable def coneMonomial (μ : SatakeWeight n) (hμ : μ ∈ satakeCone n) : coneAlgebra n :=
  ⟨single μ 1, single_mem_coneAlgebra hμ 1⟩

lemma coneMonomial_eq_prod {μ : SatakeWeight n} (hμ : μ ∈ satakeCone n) :
    coneMonomial n μ hμ = ∏ i ∈ Finset.range μ.toAdd.1.toNat,
      spinorMonomial n (Finset.univ.filter fun j ↦ (i : ℤ) < μ.toAdd.2 j) := by
  refine Subtype.ext ?_
  rw [SubmonoidClass.coe_finsetProd]
  simp only [coneMonomial, spinorMonomial]
  rw [prod_single, Finset.prod_const_one, prod_spinorWeight_eq hμ]

lemma eq_sum_coneMonomial (x : coneAlgebra n) :
    x = ∑ μ ∈ (x : SatakeLaurent n).coeff.support.attach, (x : SatakeLaurent n).coeff μ •
      coneMonomial n μ (x.2 μ (Finsupp.mem_support_iff.mp μ.2)) := by
  refine Subtype.ext ?_
  rw [AddSubmonoidClass.coe_finsetSum]
  simp only [Subalgebra.coe_smul, coneMonomial, smul_single, smul_eq_mul, mul_one]
  rw [Finset.sum_attach (s := (x : SatakeLaurent n).coeff.support)
    fun μ ↦ single μ ((x : SatakeLaurent n).coeff μ)]
  exact (sum_coeff_single _).symm

lemma isIntegral_coneAlgebra (x : coneAlgebra n) : IsIntegral (coneInvariants n) x := by
  rw [eq_sum_coneMonomial x]
  refine IsIntegral.sum _ fun μ _ ↦ IsIntegral.smul _ ?_
  rw [coneMonomial_eq_prod]
  exact IsIntegral.prod _ fun i _ ↦ isIntegral_spinorMonomial _

/-! ### Characters of the cone algebra -/

lemma spinorWeight_mul_pow (S : Finset (Fin n)) : spinorWeight n S * spinorWeight n ∅ ^ S.card =
    spinorWeight n ∅ * ∏ j ∈ S, spinorWeight n {j} := by
  apply Multiplicative.toAdd.injective
  refine Prod.ext ?_ (funext fun i ↦ ?_)
  · simp [spinorWeight, Prod.fst_sum]
  · simp [spinorWeight, Prod.snd_sum]

lemma spinorMonomial_mul_pow (S : Finset (Fin n)) :
    spinorMonomial n S * spinorMonomial n ∅ ^ S.card =
      spinorMonomial n ∅ * ∏ j ∈ S, spinorMonomial n {j} := by
  refine Subtype.ext ?_
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, SubmonoidClass.coe_finsetProd, spinorMonomial,
    single_pow, single_mul_single, prod_single, one_pow, Finset.prod_const_one,
    spinorWeight_mul_pow]

lemma dominantWeight_two_mem_satakeCone : dominantWeight 2 (fun _ ↦ 1) ∈ satakeCone n :=
  ⟨by simp [dominantWeight], fun i ↦ by simp [dominantWeight]⟩

lemma dominantWeight_two_eq (j : Fin n) :
    dominantWeight 2 (fun _ ↦ 1) = spinorWeight n {j} * spinorWeight n (Finset.univ.erase j) := by
  apply Multiplicative.toAdd.injective
  refine Prod.ext ?_ (funext fun i ↦ ?_)
  · simp [dominantWeight, spinorWeight]
  · rcases eq_or_ne i j with rfl | hi
    · simp [dominantWeight, spinorWeight]
    · simp [dominantWeight, spinorWeight, hi]

lemma dominantWeight_two_eq_empty :
    dominantWeight 2 (fun _ ↦ 1) = spinorWeight n ∅ * spinorWeight n Finset.univ := by
  apply Multiplicative.toAdd.injective
  refine Prod.ext ?_ (funext fun i ↦ ?_)
  · simp [dominantWeight, spinorWeight]
  · simp [dominantWeight, spinorWeight]

lemma coneMonomial_dominantWeight_eq (j : Fin n) :
    coneMonomial n (dominantWeight 2 fun _ ↦ 1) dominantWeight_two_mem_satakeCone =
      spinorMonomial n {j} * spinorMonomial n (Finset.univ.erase j) := by
  refine Subtype.ext ?_
  simp only [Subalgebra.coe_mul, coneMonomial, spinorMonomial, single_mul_single, mul_one,
    dominantWeight_two_eq j]

lemma coneMonomial_dominantWeight_eq_empty :
    coneMonomial n (dominantWeight 2 fun _ ↦ 1) dominantWeight_two_mem_satakeCone =
      spinorMonomial n ∅ * spinorMonomial n Finset.univ := by
  refine Subtype.ext ?_
  simp only [Subalgebra.coe_mul, coneMonomial, spinorMonomial, single_mul_single, mul_one,
    dominantWeight_two_eq_empty]

lemma coe_coneMonomial {μ : SatakeWeight n} (hμ : μ ∈ satakeCone n) :
    (coneMonomial n μ hμ : SatakeLaurent n) = single μ 1 :=
  rfl

/-! ### The scalar `T_0(p²)` -/

lemma one_le_two_fun : ∀ j : Fin n, (fun _ ↦ 1 : Fin n → ℕ) j ≤ 2 :=
  fun _ ↦ one_le_two

variable (p : ℕ)

lemma map_smul_of_map_single {f : localSiegelHeckeRing (Fin n) p →+* ℂ}
    (hf : ∀ D (c : ℂ), f (single ℂ D c) = c * f (single ℂ D 1)) (c : ℂ)
    (T : localSiegelHeckeRing (Fin n) p) : f (c • T) = c * f T := by
  induction T using HeckeCosetModule.induction_linear with
  | h0 => rw [smul_zero, map_zero, mul_zero]
  | hadd x y hx hy => rw [smul_add, map_add, map_add, hx, hy, mul_add]
  | hsingle D b =>
    rw [hf D b, ← mul_assoc, ← hf D (c * b), ← HeckeCosetModule.smul_single_one ℂ D (c * b),
      ← smul_smul, HeckeCosetModule.smul_single_one]

variable [Fact p.Prime]

lemma coe_elementaryDiag_two : (((elementaryDiag p 2 (fun _ ↦ 1) one_le_two_fun :
    heckeMonoidAt (Fin n) p) : GL (Fin n ⊕ Fin n) ℚ) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℚ) =
      (p : ℚ) • 1 := by
  rw [coe_elementaryDiag, Matrix.smul_one_eq_diagonal]
  exact congrArg Matrix.diagonal (funext fun i ↦ by
    rcases i with i | i <;> simp [elementaryEntries])

lemma elementaryDiag_two_mul_comm (g : GL (Fin n ⊕ Fin n) ℚ) :
    ((elementaryDiag p 2 (fun _ ↦ 1) one_le_two_fun : heckeMonoidAt (Fin n) p) :
      GL (Fin n ⊕ Fin n) ℚ) * g =
        g * (elementaryDiag p 2 (fun _ ↦ 1) one_le_two_fun : heckeMonoidAt (Fin n) p) :=
  Units.ext <| by
    rw [Units.val_mul, Units.val_mul, coe_elementaryDiag_two, Matrix.smul_mul, Matrix.one_mul,
      Matrix.mul_smul, Matrix.mul_one]

variable [NeZero n]

lemma satakeValuation_elementaryCoset_two (v : DecompQuotient (heckeGamma (Fin n))
    (heckeGamma (Fin n)) ((elementaryCoset (n := n) p 2 (fun _ ↦ 1) one_le_two_fun).out :
      GL (Fin n ⊕ Fin n) ℚ)⁻¹) :
    satakeValuation p (borelRep (rightCosetRep_mem_gspPlusGL p
      (elementaryCoset p 2 (fun _ ↦ 1) one_le_two_fun) v)) = dominantWeight 2 fun _ ↦ 1 := by
  rcases mem_doubleCoset.mp (mem_doubleCoset_elementaryDiag v) with ⟨γ, hγ, γ', hγ', e⟩
  have hb : ((borelRep (rightCosetRep_mem_gspPlusGL p
      (elementaryCoset p 2 (fun _ ↦ 1) one_le_two_fun) v) *
        (⟨_, elementaryDiag_mem_siegelBorel p one_le_two_fun⟩ : siegelBorel n)⁻¹ :
          siegelBorel n) : GL (Fin n ⊕ Fin n) ℚ) ∈ heckeGamma (Fin n) := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv, e, mul_assoc γ, elementaryDiag_two_mul_comm,
      ← mul_assoc, mul_inv_cancel_right]
    exact mul_mem hγ hγ'
  have h₁ : satakeValuation p (borelRep (rightCosetRep_mem_gspPlusGL p
      (elementaryCoset p 2 (fun _ ↦ 1) one_le_two_fun) v) *
        (⟨_, elementaryDiag_mem_siegelBorel p one_le_two_fun⟩ : siegelBorel n)⁻¹) = 1 :=
    satakeValuation_eq_one p hb
  rw [map_mul, map_inv, mul_inv_eq_one] at h₁
  rw [h₁, satakeValuation_elementaryDiag]

/-! ### The universal Satake map onto the Weyl invariants of the cone -/

/-- The universal Satake map `Ω : 𝓗_p → (L_g^+)^{W_g}` onto the **Weyl invariants of the cone
algebra** (LMFDB `mf.siegel.lift`, through Satake's theorem), a ring isomorphism
(`SiegelUpperHalfSpace.satakeInvariantsHom_bijective`). -/
noncomputable def satakeInvariantsHom : localSiegelHeckeRing (Fin n) p →+* coneInvariants n where
  toFun T := ⟨⟨satakeMapUniv p T, satakeMapUniv_mem_coneAlgebra p T⟩,
    satakeMapUniv_mem_weylInvariants p T⟩
  map_one' := Subtype.ext (Subtype.ext (map_one _))
  map_mul' T T' := Subtype.ext (Subtype.ext (map_mul _ T T'))
  map_zero' := Subtype.ext (Subtype.ext (map_zero _))
  map_add' T T' := Subtype.ext (Subtype.ext (map_add _ T T'))

lemma coe_satakeInvariantsHom (T : localSiegelHeckeRing (Fin n) p) :
    ((satakeInvariantsHom p T : coneAlgebra n) : SatakeLaurent n) = satakeMapUniv p T :=
  rfl

/-- **Satake's isomorphism** (LMFDB `mf.siegel.lift`, through Satake's theorem): the universal
Satake map is a ring isomorphism of the local Hecke algebra `𝓗_p` of `Sp(2g, ℤ)` onto the
Weyl-invariant Laurent polynomials supported on the cone `0 ≤ d_j ≤ δ`. -/
lemma satakeInvariantsHom_bijective : Function.Bijective (satakeInvariantsHom (n := n) p) := by
  refine ⟨fun T T' h ↦ satakeMapUniv_injective p ?_, fun x ↦ ?_⟩
  · rw [← coe_satakeInvariantsHom, h, coe_satakeInvariantsHom]
  · rcases (exists_satakeMapUniv_eq_iff p).mpr ⟨x.2, (x : coneAlgebra n).2⟩ with ⟨T, hT⟩
    exact ⟨T, Subtype.ext (Subtype.ext hT)⟩

lemma satakeInvariantsHom_elementaryCoset_two :
    ((satakeInvariantsHom p (single ℂ (elementaryCoset (n := n) p 2 (fun _ ↦ 1) one_le_two_fun)
      1) : coneInvariants n) : coneAlgebra n) = ((Finset.univ : Finset (DecompQuotient
        (heckeGamma (Fin n)) (heckeGamma (Fin n))
          ((elementaryCoset (n := n) p 2 (fun _ ↦ 1) one_le_two_fun).out :
          GL (Fin n ⊕ Fin n) ℚ)⁻¹)).card * (weightCharacter 1 (fun i : Fin n ↦
            (primeUnit p)⁻¹ ^ (n - (i : ℕ))) (dominantWeight 2 fun _ ↦ 1) : ℂ)) •
              coneMonomial n (dominantWeight 2 fun _ ↦ 1) dominantWeight_two_mem_satakeCone := by
  refine Subtype.ext ?_
  rw [coe_satakeInvariantsHom, satakeMapUniv_single_one, Subalgebra.coe_smul, coe_coneMonomial]
  simp only [satakeValuation_elementaryCoset_two, coe_satakeCharacterUniv]
  rw [Finset.sum_const, smul_single, smul_single, nsmul_eq_mul, smul_eq_mul, mul_one]

/-! ### Satake parameters of characters -/

/-- **Satake's theorem, existence** (LMFDB `mf.siegel.lift`, through the Satake parameters): a
`ℂ`-linear character `λ` of the local Hecke algebra `𝓗_p` of `Sp(2g, ℤ)` with `λ(T_0(p²)) ≠ 0`
is a Satake map `ω_α`. -/
lemma exists_satakeMap_eq_of_ne_zero {f : localSiegelHeckeRing (Fin n) p →+* ℂ}
    (hf : ∀ D (c : ℂ), f (single ℂ D c) = c * f (single ℂ D 1))
    (h₀ : f (single ℂ (elementaryCoset p 2 (fun _ ↦ 1) one_le_two_fun) 1) ≠ 0) :
    ∃ (α₀ : ℂˣ) (α : Fin n → ℂˣ), satakeMap p α₀ α = f := by
  let e : localSiegelHeckeRing (Fin n) p ≃+* coneInvariants n :=
    RingEquiv.ofBijective _ (satakeInvariantsHom_bijective p)
  have he (c : ℂ) : e.symm (algebraMap ℂ (coneInvariants n) c) = c • 1 := by
    rw [RingEquiv.symm_apply_eq]
    refine Subtype.ext (Subtype.ext ?_)
    rw [RingEquiv.ofBijective_apply, coe_satakeInvariantsHom, satakeMapUniv_smul, map_one,
      Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap, Algebra.algebraMap_eq_smul_one]
  let φ : coneInvariants n →ₐ[ℂ] ℂ :=
    { f.comp e.symm.toRingHom with
      commutes' := fun c ↦ (congrArg f (he c)).trans ((map_smul_of_map_single p hf c 1).trans
        (by rw [map_one, mul_one]; rfl)) }
  rcases (coneInvariants n).exists_algHom_eq_of_isIntegral isIntegral_coneAlgebra φ with ⟨ψ, hψ⟩
  have hψT (T : localSiegelHeckeRing (Fin n) p) :
      ψ ((satakeInvariantsHom p T : coneInvariants n) : coneAlgebra n) = f T := by
    have h : ψ (e T) = φ (e T) := hψ (e T)
    rw [RingEquiv.ofBijective_apply] at h
    rw [h]
    exact congrArg f (e.symm_apply_apply T)
  have hT₀ : ψ (coneMonomial n (dominantWeight 2 fun _ ↦ 1) dominantWeight_two_mem_satakeCone) ≠
      0 := by
    have h : ψ ((satakeInvariantsHom p (single ℂ (elementaryCoset p 2 (fun _ ↦ 1)
        one_le_two_fun) 1) : coneInvariants n) : coneAlgebra n) ≠ 0 := by
      rwa [hψT]
    rw [satakeInvariantsHom_elementaryCoset_two, map_smul, smul_eq_mul] at h
    exact right_ne_zero_of_mul h
  have hy₀ : ψ (spinorMonomial n ∅) ≠ 0 := by
    rw [coneMonomial_dominantWeight_eq_empty, map_mul] at hT₀
    exact left_ne_zero_of_mul hT₀
  have hy (j : Fin n) : ψ (spinorMonomial n {j}) ≠ 0 := by
    rw [coneMonomial_dominantWeight_eq j, map_mul] at hT₀
    exact left_ne_zero_of_mul hT₀
  let α₀ : ℂˣ := Units.mk0 _ hy₀
  let α : Fin n → ℂˣ := fun j ↦ Units.mk0 (ψ (spinorMonomial n {j}) / ψ (spinorMonomial n ∅))
    (div_ne_zero (hy j) hy₀)
  have hS (S : Finset (Fin n)) :
      ψ (spinorMonomial n S) = weightCharacter α₀ α (spinorWeight n S) := by
    have h : ψ (spinorMonomial n S) * ψ (spinorMonomial n ∅) ^ S.card =
        ψ (spinorMonomial n ∅) * ∏ j ∈ S, ψ (spinorMonomial n {j}) := by
      rw [← map_pow, ← map_mul, spinorMonomial_mul_pow, map_mul, map_prod]
    rw [weightCharacter_spinorWeight]
    simp only [α₀, α, Units.val_mk0]
    rw [Finset.prod_div_distrib, Finset.prod_const, ← mul_div_assoc, ← h,
      mul_div_cancel_right₀ _ (pow_ne_zero _ hy₀)]
  have hμ (μ : SatakeWeight n) (hμ : μ ∈ satakeCone n) :
      ψ (coneMonomial n μ hμ) = weightCharacter α₀ α μ := by
    rw [coneMonomial_eq_prod, map_prod]
    simp only [hS]
    rw [← Units.coe_prod, ← map_prod, prod_spinorWeight_eq hμ]
  have hev (x : coneAlgebra n) : ψ x = satakeEval α₀ α x := by
    rw [eq_sum_coneMonomial x, map_sum, AddSubmonoidClass.coe_finsetSum, map_sum]
    refine Finset.sum_congr rfl fun μ _ ↦ ?_
    rw [map_smul, hμ, Subalgebra.coe_smul, map_smul, coe_coneMonomial, satakeEval_single,
      one_mul]
  refine ⟨α₀, α, RingHom.ext fun T ↦ ?_⟩
  rw [← satakeEval_satakeMapUniv, ← coe_satakeInvariantsHom, ← hev, hψT]

end SiegelUpperHalfSpace
