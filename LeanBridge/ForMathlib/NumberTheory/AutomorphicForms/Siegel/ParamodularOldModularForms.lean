import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.ParamodularNewform

/-!
# Old paramodular modular forms

The space `M_ρ(K(N))` of paramodular modular forms of degree `2`, weight `ρ` and level `N`
contains the old subspace `M_ρ^old(K(N))` (LMFDB `mf.siegel.newform`), spanned by the forms of
level `N` obtained from modular forms of a lower level `M ∣ N` through the level raising maps
`M_ρ(K(M)) → M_ρ(K(N))`. The knowl leaves these maps unspecified (one for each divisor of `N / M`);
as for the old cusp forms `SiegelUpperHalfSpace.paramodularOldSubspace`, the level raising
operators `θ`, `θ'` (from level `N / p`) and `η` (from level `N / p²`) of Roberts and Schmidt are
used, at the primes `p`. A composite of these operators from a lower level ends with one of them,
so its image lies in `M_ρ^old(K(N))` as soon as the operators preserve modular forms, which is not
proved here.

## Main definitions

* `SiegelUpperHalfSpace.levelRaisingModularImage`: the image of the modular forms of a lower level
  under a level raising operator.
* `SiegelUpperHalfSpace.paramodularOldModularForms` (LMFDB `mf.siegel.newform`): the old subspace
  `M_ρ^old(K(N))`.

## Main results

* `SiegelUpperHalfSpace.paramodularOldSubspace_le_paramodularOldModularForms`: the old cusp forms
  `S_ρ^old(K(N))` are old modular forms.
* `SiegelUpperHalfSpace.paramodularOldModularForms_one`: there are no old forms in level `1`.
-/

namespace SiegelUpperHalfSpace

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ (GL (Fin 2) ℂ) V)
    {N M : ℕ+}
    (T : slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel M)) →ₗ[ℂ]
      slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel N)))

/-- The image of the paramodular modular forms `M_ρ(K(M))` of level `M` (with trivial character)
under an operator `T` from the `K(M)`-invariant to the `K(N)`-invariant functions, such as a level
raising operator. -/
def levelRaisingModularImage : Submodule ℂ (SiegelUpperHalfSpace (Fin 2) → V) :=
  ((modularForms ρ (paramodularLevel M) 1).comap
    (slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel M))).subtype).map
      ((slashInvariantsOf ρ (gspPlusGL (Fin 2)) (heckeGammaOf (paramodularLevel N))).subtype ∘ₗ T)

lemma levelRaisingImage_le_levelRaisingModularImage :
    levelRaisingImage ρ T ≤ levelRaisingModularImage ρ T :=
  Submodule.map_mono <| Submodule.comap_mono <| cuspForms_le_modularForms ρ _ 1

variable (N)

/-- The **old subspace** `M_ρ^old(K(N))` (LMFDB `mf.siegel.newform`) of the paramodular modular
forms of level `N`, with trivial character: the subspace generated by the **old** forms, the
modular forms of level `N` in the image of the modular forms of level `N / p` under the level
raising operators `θ`, `θ'` (`SiegelUpperHalfSpace.levelRaisingTheta`,
`SiegelUpperHalfSpace.levelRaisingThetaPrime`) and of level `N / p²` under `η`
(`SiegelUpperHalfSpace.levelRaisingEta`), for the primes `p` with `p ∣ N` (resp. `p² ∣ N`). The
knowl only says that there are maps `M_ρ(K(M)) → M_ρ(K(N))` for the proper divisors `M` of `N`;
those of Roberts and Schmidt are used, as in `SiegelUpperHalfSpace.paramodularOldSubspace`. -/
noncomputable def paramodularOldModularForms : Submodule ℂ (SiegelUpperHalfSpace (Fin 2) → V) :=
  (⨆ (p : ℕ+) (_ : (p : ℕ).Prime) (M : ℕ+) (_ : M * p = N),
    modularForms ρ (paramodularLevel N) 1 ⊓ levelRaisingModularImage ρ (levelRaisingTheta ρ M p) ⊔
      modularForms ρ (paramodularLevel N) 1 ⊓
        levelRaisingModularImage ρ (levelRaisingThetaPrime ρ M p)) ⊔
    ⨆ (p : ℕ+) (_ : (p : ℕ).Prime) (M : ℕ+) (_ : M * p * p = N),
      modularForms ρ (paramodularLevel N) 1 ⊓ levelRaisingModularImage ρ (levelRaisingEta ρ M p)

lemma paramodularOldModularForms_le :
    paramodularOldModularForms ρ N ≤ modularForms ρ (paramodularLevel N) 1 :=
  sup_le (iSup₂_le fun _ _ ↦ iSup₂_le fun _ _ ↦ sup_le inf_le_left inf_le_left)
    (iSup₂_le fun _ _ ↦ iSup₂_le fun _ _ ↦ inf_le_left)

/-- **The old cusp forms are old modular forms**: `S_ρ^old(K(N)) ⊆ M_ρ^old(K(N))`, the cusp forms
being modular forms. -/
lemma paramodularOldSubspace_le_paramodularOldModularForms :
    paramodularOldSubspace ρ N ≤ paramodularOldModularForms ρ N := by
  have hS : paramodularCuspForms ρ N ≤ modularForms ρ (paramodularLevel N) 1 :=
    cuspForms_le_modularForms ρ _ 1
  refine sup_le_sup (iSup₂_mono fun _ _ ↦ iSup₂_mono fun _ _ ↦ sup_le_sup ?_ ?_)
    (iSup₂_mono fun _ _ ↦ iSup₂_mono fun _ _ ↦ ?_) <;>
  exact inf_le_inf hS (levelRaisingImage_le_levelRaisingModularImage ρ _)

private lemma not_prime_of_mul_eq_one {p : ℕ+} (h : M * p = 1) : ¬(p : ℕ).Prime := fun hp ↦
  hp.ne_one <| Nat.eq_one_of_mul_eq_one_left (m := (M : ℕ)) (by exact_mod_cast congrArg PNat.val h)

/-- **There are no old paramodular modular forms in level `1`**, no prime dividing `1`. -/
lemma paramodularOldModularForms_one : paramodularOldModularForms ρ 1 = ⊥ := by
  refine eq_bot_iff.mpr (sup_le (iSup₂_le fun p hp ↦ iSup₂_le fun M hM ↦ ?_)
    (iSup₂_le fun p hp ↦ iSup₂_le fun M hM ↦ ?_)) <;>
  exact absurd hp (not_prime_of_mul_eq_one hM)

end SiegelUpperHalfSpace
