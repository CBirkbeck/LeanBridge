import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.ChiFiveLevelTwo

/-!
# Siegel modular forms of degree 2 on `Γ₀(4)` with the character `ψ₄`

By the theorem of Hayashida and Ibukiyama (Ibukiyama and Hayashida, RIMS Kôkyûroku 1173 (2000),
Theorem 2.2; Aoki and Ibukiyama, Int. J. Math. 16 (2005), §5, Theorem 5.1), the graded ring of
Siegel modular forms of degree 2 on the subgroup `Γ₀^{ψ₄}(4) = ker ψ₄` of index 2 in `Γ₀(4)`, where
`ψ₄(γ) = (-1 / det D)`, is generated by `f₁(2Ω) = θ₀₀₀₀(2Ω)²` (weight 1, character `ψ₄` on
`Γ₀(4)`), `X` and `X(2Ω)` (weight 2), `f₃(2Ω) = (θ₀₀₀₁ θ₀₀₁₀ θ₀₀₁₁)²(2Ω)` (weight 3, character
`ψ₄`) and the cusp form `f₁₁(2Ω)` of weight 11, the first four being algebraically independent and
generating `⊕_k M_k(Γ₀(4), ψ₄^k)` (LMFDB `mf.siegel.family.gamma0_4_psi_4`). This file proves the
modularity of the two generators that were not covered before, through the generators `P(ℤ)` and
`ι₁(1, 0; 4, 1)` of `Γ₀(4)`:

* `ι₁(1, 0; 4, 1)` acts on `2Ω` as `ι₁(1, 0; 2, 1) ∈ Γ[2]`, under which `θ_m⁴` has weight 2, `χ₅`
  weight 5, and `θ₀₀₀₁²`, `θ₀₀₁₀²`, `θ₀₀₁₁²` weight 1 with the signs `1, -1, -1`;
* `(A, B; 0, D) ∈ P(ℤ)` acts on `2Ω` as `(A, 2B; 0, D)`. When `A ≡ 1 (mod 2)`, this fixes `θ₀₀₀₁`,
  `θ₀₀₁₀`, `θ₀₀₁₁` and multiplies `χ₅` by `det(D)⁵`, by the sign bookkeeping of `χ₅` under
  `P(ℤ) ∩ Γ[2]`. The swap `σ` of the coordinates and the rotation `ε` by `(1, 1; 0, 1)` act on the
  characteristics by `(a, b, c, d) ↦ (b, a, d, c)` and `(a, b, c, d) ↦ (a, a + b, c - d, d)`: `σ`
  fixes `χ₅` and `f₃` and negates `f₆`, and `ε` negates `χ₅` (through `θ_{(1,1),(-1,1)} = -θ₁₁₁₁`)
  and `f₆` and fixes `f₃`. These elements generate `P(ℤ)`, since `σ` and `ε` reduce to generators
  of `GL(2, ℤ/2ℤ)`.

Hence `f₁₁(2Ω) ∈ M₁₁(Γ₀(4))` and `f₃(2Ω) ∈ M₃(Γ₀(4), ψ₄)`. The cusp condition for `f₁₁(2Ω)`, the
algebraic independence and the structure theorem are stated, not proved, in
`SiegelUpperHalfSpace.Ibukiyama.Gamma0FourPsiFourStructure`, which also corrects the knowl's
decomposition of `⊕_k M_{2k}(Γ₀(4), ψ₄)`; the cusp condition at the standard cusp is proved in
`LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.IbukiyamaPsiFourCusp`.

## Main definitions

* `SiegelUpperHalfSpace.Ibukiyama.f3` (LMFDB `mf.siegel.family.gamma0_4_psi_4`): the form
  `f₃ = (θ₀₀₀₁ θ₀₀₁₀ θ₀₀₁₁)²`.
* `SiegelUpperHalfSpace.Ibukiyama.gamma0Psi4`: the group `Γ₀^{ψ₄}(4) = ker ψ₄`.
* `SiegelUpperHalfSpace.Ibukiyama.Gamma0FourPsiFourStructure` (LMFDB
  `mf.siegel.family.gamma0_4_psi_4`): the structure theorem, as a statement.

## Main results

* `SymplecticGroup.mem_of_mem_siegelParabolic`: `P(ℤ)` is generated by its elements with
  `A ≡ 1 (mod 2)`, the coordinate swap and the rotation by `(1, 1; 0, 1)`.
* `SiegelUpperHalfSpace.Ibukiyama.f11_comp_double_mem_gamma0_four`: `f₁₁(2Ω) ∈ M₁₁(Γ₀(4))`.
* `SiegelUpperHalfSpace.Ibukiyama.f3_comp_double_mem_gamma0_four`: `f₃(2Ω) ∈ M₃(Γ₀(4), ψ₄)`.
-/

open Complex Matrix Real SymplecticGroup

open SpecialLinearGroup (lowerUnipotent)

namespace SymplecticGroup

variable {p q : symplecticGroup (Fin 2) ℤ} {H : Subgroup (symplecticGroup (Fin 2) ℤ)}

lemma toBlocks₁₁_mul_of_mem_siegelParabolic (hq : q ∈ siegelParabolic (Fin 2) ℤ) :
    (p * q).1.toBlocks₁₁ = p.1.toBlocks₁₁ * q.1.toBlocks₁₁ := by
  have h (k j : Fin 2) : q.1 (.inr k) (.inl j) = 0 := congrFun (congrFun hq k) j
  ext i j
  simp [toBlocks₁₁, Matrix.mul_apply, h]

lemma isUnit_det_map_toBlocks₁₁ (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    IsUnit (p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2))).det := by
  rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]
  exact (isUnit_det_of_left_inverse (transpose_toBlocks₂₂_mul_toBlocks₁₁ hp)).map _

private lemma glTwo_cases : ∀ M : Matrix (Fin 2) (Fin 2) (ZMod 2), M.det ≠ 0 → M = 1 ∨
    M = !![0, 1; 1, 0] ∨ M = !![1, 1; 0, 1] ∨ M = !![0, 1; 1, 1] ∨ M = !![1, 1; 1, 0] ∨
    M = !![1, 0; 1, 1] := by
  decide

private lemma mem_of_toBlocks₁₁_eq (hK : ∀ p ∈ siegelParabolic (Fin 2) ℤ,
      p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1 → p ∈ H)
    (hp : p ∈ siegelParabolic (Fin 2) ℤ) (hqH : q ∈ H) (hq : q ∈ siegelParabolic (Fin 2) ℤ)
    (h : q.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) =
      p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2))) : p ∈ H := by
  have hu : IsUnit (p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2))).det :=
    isUnit_det_map_toBlocks₁₁ hp
  have he : (p * q⁻¹).1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) *
      q.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) =
        p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) := by
    rw [← Matrix.map_mul, ← toBlocks₁₁_mul_of_mem_siegelParabolic hq, inv_mul_cancel_right]
  rw [h] at he
  have hA : (p * q⁻¹).1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1 := by
    simpa only [Matrix.mul_assoc, Matrix.mul_nonsing_inv _ hu, Matrix.mul_one] using
      congrArg (· * (p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)))⁻¹) he
  simpa using H.mul_mem (hK _ (mul_mem hp (inv_mem hq)) hA) hqH

/-- **Generators of the Siegel parabolic subgroup over its elements with `A ≡ 1 (mod 2)`**: a
subgroup of `Sp(4, ℤ)` that contains the elements `(A, B; 0, D)` of `P(ℤ)` with `A ≡ 1 (mod 2)`,
the swap of the two coordinates and the rotation by `(1, 1; 0, 1)` contains `P(ℤ)`, since the
reductions `(0, 1; 1, 0)` and `(1, 1; 0, 1)` of the last two generate `GL(2, ℤ/2ℤ)`. -/
lemma mem_of_mem_siegelParabolic (hK : ∀ p ∈ siegelParabolic (Fin 2) ℤ,
      p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1 → p ∈ H) (hσ : coordSwap ∈ H)
    (hε : rotation (upperUnipotent 1) ∈ H) (hp : p ∈ siegelParabolic (Fin 2) ℤ) : p ∈ H := by
  have hσP : (coordSwap : symplecticGroup (Fin 2) ℤ) ∈ siegelParabolic (Fin 2) ℤ :=
    coordSwap_mem_siegelParabolic
  have hεP : rotation (upperUnipotent 1) ∈ siegelParabolic (Fin 2) ℤ :=
    rotation_mem_siegelParabolic _
  have hσA : (coordSwap : symplecticGroup (Fin 2) ℤ).1.toBlocks₁₁ = !![0, 1; 1, 0] :=
    toBlocks_fromBlocks₁₁ _ _ _ _
  have hεA : (rotation (upperUnipotent 1)).1.toBlocks₁₁ = !![1, 1; 0, 1] :=
    toBlocks_fromBlocks₁₁ _ _ _ _
  rcases glTwo_cases _ (isUnit_det_map_toBlocks₁₁ hp).ne_zero with h | h | h | h | h | h
  · exact hK p hp h
  · exact mem_of_toBlocks₁₁_eq hK hp hσ hσP (by rw [h, hσA]; decide)
  · exact mem_of_toBlocks₁₁_eq hK hp hε hεP (by rw [h, hεA]; decide)
  · exact mem_of_toBlocks₁₁_eq hK hp (mul_mem hσ hε) (mul_mem hσP hεP)
      (by rw [h, toBlocks₁₁_mul_of_mem_siegelParabolic hεP, hσA, hεA]; decide)
  · exact mem_of_toBlocks₁₁_eq hK hp (mul_mem hε hσ) (mul_mem hεP hσP)
      (by rw [h, toBlocks₁₁_mul_of_mem_siegelParabolic hσP, hεA, hσA]; decide)
  · exact mem_of_toBlocks₁₁_eq hK hp (mul_mem (mul_mem hσ hε) hσ) (mul_mem (mul_mem hσP hεP) hσP)
      (by rw [h, toBlocks₁₁_mul_of_mem_siegelParabolic hσP,
        toBlocks₁₁_mul_of_mem_siegelParabolic hεP, hσA, hεA]; decide)

end SymplecticGroup

namespace SiegelUpperHalfSpace.Ibukiyama

variable (Ω : SiegelUpperHalfSpace (Fin 2)) (a b c d k : ℤ) {p γ : symplecticGroup (Fin 2) ℤ}
    {F : SiegelUpperHalfSpace (Fin 2) → ℂ} {ψ : Gamma0 (Fin 2) 4 →* ℂˣ} (μ ν : Fin 2 → ℤ)

/-- The form `f₃ = (θ₀₀₀₁ θ₀₀₁₀ θ₀₀₁₁)²` (LMFDB `mf.siegel.family.gamma0_4_psi_4`; Aoki and
Ibukiyama, §5): `f₃(2Ω)` is a Siegel modular form of weight 3 and character `ψ₄` on `Γ₀(4)`. The
knowl writes `f₃ = (θ₀₀₀₀ θ₀₀₀₁ θ₀₀₁₁)²`, which is not modular at `2Ω`: the swap of the two
coordinates, which lies in `Γ₀(4)`, sends it to `(θ₀₀₀₀ θ₀₀₁₀ θ₀₀₁₁)²(2Ω)`. -/
noncomputable def f3 : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  (theta 0 0 0 1 * theta 0 0 1 0 * theta 0 0 1 1) ^ 2

lemma isHolomorphic_f3 : IsHolomorphic f3 :=
  (((isHolomorphic_theta 0 0 0 1).mul (isHolomorphic_theta 0 0 1 0)).mul
    (isHolomorphic_theta 0 0 1 1)).pow 2

variable {μ ν} in
private lemma thetaConstant_smul_of_toBlocks₁₂_eq_zero (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (h : p.1.toBlocks₁₂ = 0) :
    thetaConstant μ ν (map (Int.castRingHom ℝ) p • Ω) =
      thetaConstant (p.1.toBlocks₁₁ᵀ *ᵥ μ) (p.1.toBlocks₂₂ᵀ *ᵥ ν) Ω := by
  rw [thetaConstant_smul_of_mem_siegelParabolic μ ν Ω hp, h]
  simp

lemma theta_coordSwap_smul :
    theta a b c d (map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ) • Ω) =
      theta b a d c Ω := by
  rw [theta, thetaConstant_smul_of_toBlocks₁₂_eq_zero Ω coordSwap_mem_siegelParabolic
    (toBlocks_fromBlocks₁₂ _ _ _ _)]
  congr 1 <;> ext i <;> fin_cases i <;> simp [coordSwap, mulVec]

lemma theta_rotation_smul :
    theta a b c d (map (Int.castRingHom ℝ) (rotation (upperUnipotent 1)) • Ω) =
      thetaConstant ![a, a + b] ![c - d, d] Ω := by
  rw [theta, thetaConstant_smul_of_toBlocks₁₂_eq_zero Ω (rotation_mem_siegelParabolic _)
    (toBlocks_fromBlocks₁₂ _ _ _ _)]
  congr 1 <;> ext i <;> fin_cases i <;> simp [rotation, upperUnipotent, mulVec, sub_eq_add_neg]

private lemma thetaConstant_neg_one_one :
    thetaConstant μ ![-1, 1] Ω = (-1) ^ (μ ⬝ᵥ ![-1, 0]) * thetaConstant μ ![1, 1] Ω := by
  rw [show (![-1, 1] : Fin 2 → ℤ) = ![1, 1] + 2 • ![-1, 0] by ext i; fin_cases i <;> rfl,
    thetaConstant_add_two_smul_right]

private lemma thetaConstant_zero_neg_one : thetaConstant ![0, 0] ![-1, 1] Ω = theta 0 0 1 1 Ω := by
  simp [thetaConstant_neg_one_one]

private lemma thetaConstant_one_neg_one : thetaConstant ![1, 1] ![-1, 1] Ω = -theta 1 1 1 1 Ω := by
  simp [thetaConstant_neg_one_one]

private lemma thetaConstant_one_two :
    thetaConstant ![1, 2] ![c, d] Ω = thetaConstant ![1, 0] ![c, d] Ω := by
  rw [show (![1, 2] : Fin 2 → ℤ) = ![1, 0] + 2 • ![0, 1] by ext i; fin_cases i <;> rfl,
    thetaConstant_add_two_smul_left]

lemma chi5_coordSwap_smul :
    chi5 (map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ) • Ω) = chi5 Ω := by
  simp only [chi5, Pi.mul_apply, theta_coordSwap_smul]
  ring1

lemma chi5_rotation_smul :
    chi5 (map (Int.castRingHom ℝ) (rotation (upperUnipotent 1)) • Ω) = -chi5 Ω := by
  simp only [chi5, Pi.mul_apply, theta_rotation_smul, add_zero, zero_add, sub_zero, sub_self,
    zero_sub, one_add_one_eq_two, thetaConstant_zero_neg_one, thetaConstant_one_neg_one,
    thetaConstant_one_two]
  ring1

lemma f6_coordSwap_smul :
    f6 (map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ) • Ω) = -f6 Ω := by
  simp only [f6, Pi.mul_apply, Pi.sub_apply, Pi.pow_apply, theta_coordSwap_smul]
  ring1

lemma f6_rotation_smul :
    f6 (map (Int.castRingHom ℝ) (rotation (upperUnipotent 1)) • Ω) = -f6 Ω := by
  simp only [f6, Pi.mul_apply, Pi.sub_apply, Pi.pow_apply, theta_rotation_smul, add_zero, sub_zero,
    sub_self, zero_sub, thetaConstant_zero_neg_one]
  ring1

lemma f3_coordSwap_smul :
    f3 (map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ) • Ω) = f3 Ω := by
  simp only [f3, Pi.mul_apply, Pi.pow_apply, theta_coordSwap_smul]
  ring1

lemma f3_rotation_smul :
    f3 (map (Int.castRingHom ℝ) (rotation (upperUnipotent 1)) • Ω) = f3 Ω := by
  simp only [f3, Pi.mul_apply, Pi.pow_apply, theta_rotation_smul, add_zero, sub_zero, sub_self,
    zero_sub, thetaConstant_zero_neg_one]
  ring1

lemma f11_coordSwap_smul :
    f11 (map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ) • Ω) = -f11 Ω := by
  rw [f11, Pi.mul_apply, Pi.mul_apply, f6_coordSwap_smul, chi5_coordSwap_smul, neg_mul]

lemma f11_rotation_smul :
    f11 (map (Int.castRingHom ℝ) (rotation (upperUnipotent 1)) • Ω) = f11 Ω := by
  rw [f11, Pi.mul_apply, Pi.mul_apply, f6_rotation_smul, chi5_rotation_smul, neg_mul_neg]

private lemma twiceUpper_toBlocks₁₁ (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    (twiceUpper hp).1.toBlocks₁₁ = p.1.toBlocks₁₁ :=
  toBlocks_fromBlocks₁₁ _ _ _ _

private lemma twiceUpper_toBlocks₁₂ (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    (twiceUpper hp).1.toBlocks₁₂ = p.1.toBlocks₁₂ + p.1.toBlocks₁₂ :=
  toBlocks_fromBlocks₁₂ _ _ _ _

private lemma twiceUpper_toBlocks₂₂ (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    (twiceUpper hp).1.toBlocks₂₂ = p.1.toBlocks₂₂ :=
  toBlocks_fromBlocks₂₂ _ _ _ _

private lemma twiceUpper_eq_self (hp : p ∈ siegelParabolic (Fin 2) ℤ) (h : p.1.toBlocks₁₂ = 0) :
    twiceUpper hp = p :=
  Subtype.ext <| by
    rw [eq_fromBlocks_of_mem_siegelParabolic (twiceUpper_mem hp), twiceUpper_toBlocks₁₁,
      twiceUpper_toBlocks₁₂, twiceUpper_toBlocks₂₂, h, add_zero]
    conv_rhs => rw [eq_fromBlocks_of_mem_siegelParabolic hp, h]

private lemma double_smul_of_toBlocks₁₂_eq_zero (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (h : p.1.toBlocks₁₂ = 0) :
    double (map (Int.castRingHom ℝ) p • Ω) = map (Int.castRingHom ℝ) p • double Ω := by
  rw [← twiceUpper_smul_double Ω hp, twiceUpper_eq_self hp h]

private lemma transpose_toBlocks₂₂_eq (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (hA : p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1) :
    (twiceUpper hp).1.toBlocks₂₂ᵀ = 1 + 2 • of fun i j ↦ (p.1.toBlocks₂₂ᵀ - 1) i j / 2 := by
  have hD : (p.1.toBlocks₂₂ᵀ - 1).map (Int.castRingHom (ZMod 2)) = 0 := by
    have h : (p.1.toBlocks₂₂ᵀ * p.1.toBlocks₁₁).map (Int.castRingHom (ZMod 2)) = 1 := by
      rw [transpose_toBlocks₂₂_mul_toBlocks₁₁ hp, Matrix.map_one _ (map_zero _) (map_one _)]
    rw [Matrix.map_mul, hA, Matrix.mul_one] at h
    rw [Matrix.map_sub _ (map_sub (Int.castRingHom (ZMod 2))), h,
      Matrix.map_one _ (map_zero _) (map_one _), sub_self]
  rw [twiceUpper_toBlocks₂₂]
  ext i j
  have h : (2 : ℤ) ∣ (p.1.toBlocks₂₂ᵀ - 1) i j :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).mp (by simpa using congrFun (congrFun hD i) j)
  rw [Matrix.sub_apply] at h
  rw [Matrix.add_apply, Matrix.smul_apply, of_apply, nsmul_eq_mul, Nat.cast_ofNat,
    Matrix.sub_apply]
  omega

private lemma twiceUpper_mul_transpose (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    (twiceUpper hp).1.toBlocks₁₂ * (twiceUpper hp).1.toBlocks₁₁ᵀ =
      2 • (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ) := by
  rw [twiceUpper_toBlocks₁₂, twiceUpper_toBlocks₁₁, Matrix.add_mul, two_nsmul]

lemma chi5_twiceUpper_smul (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (hA : p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1) :
    chi5 (map (Int.castRingHom ℝ) (twiceUpper hp) • Ω) =
      (p.1.toBlocks₂₂.det : ℂ) ^ 5 * chi5 Ω := by
  have hS : (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ) 1 0 = (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ) 0 1 := by
    rw [← transpose_apply (p.1.toBlocks₁₂ * p.1.toBlocks₁₁ᵀ) 0 1, transpose_mul,
      transpose_transpose, ← toBlocks₁₂_mul_transpose_toBlocks₁₁ hp]
  rw [chi5_smul_of_mem_siegelParabolic_of_eq Ω (twiceUpper_mem hp)
    (by rwa [twiceUpper_toBlocks₁₁]) (twiceUpper_mul_transpose hp) hS
      (transpose_toBlocks₂₂_eq hp hA),
    cexp_pi_mul_I_eq_det_pow (twiceUpper_mem hp) (transpose_toBlocks₂₂_eq hp hA),
    twiceUpper_toBlocks₂₂]

variable {c d} in
lemma theta_twiceUpper_smul (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (hA : p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1) :
    theta 0 0 c d (map (Int.castRingHom ℝ) (twiceUpper hp) • Ω) = theta 0 0 c d Ω := by
  rw [theta, thetaConstant_smul_of_mem_siegelParabolic_of_eq Ω (twiceUpper_mem hp)
    (by rwa [twiceUpper_toBlocks₁₁]) (twiceUpper_mul_transpose hp)
      (transpose_toBlocks₂₂_eq hp hA)]
  simp

lemma f11_twiceUpper_smul (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (hA : p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1) :
    f11 (map (Int.castRingHom ℝ) (twiceUpper hp) • Ω) = (p.1.toBlocks₂₂.det : ℂ) ^ 5 * f11 Ω := by
  simp only [f11, f6, Pi.mul_apply, Pi.sub_apply, Pi.pow_apply, theta_twiceUpper_smul Ω hp hA,
    chi5_twiceUpper_smul Ω hp hA]
  ring1

lemma f3_twiceUpper_smul (hp : p ∈ siegelParabolic (Fin 2) ℤ)
    (hA : p.1.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) = 1) :
    f3 (map (Int.castRingHom ℝ) (twiceUpper hp) • Ω) = f3 Ω := by
  simp only [f3, Pi.mul_apply, Pi.pow_apply, theta_twiceUpper_smul Ω hp hA]

lemma f11_embedFirst_lowerUnipotent_smul :
    f11 (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * k))) • Ω) =
      (denom (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * k)))) Ω.val).det ^ 11 *
        f11 Ω := by
  simp only [f11, f6, Pi.mul_apply, Pi.sub_apply, Pi.pow_apply,
    thetaConstant_embedFirst_lowerUnipotent_smul_pow_four, chi5_embedFirst_lowerUnipotent_smul]
  ring1

lemma f3_embedFirst_lowerUnipotent_smul :
    f3 (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * k))) • Ω) =
      (denom (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * k)))) Ω.val).det ^ 3 *
        f3 Ω := by
  have he : cexp (-(π * I * k * 1 ^ 2)) * cexp (-(π * I * k * 1 ^ 2)) = 1 := by
    rw [← Complex.exp_add]
    exact Complex.exp_eq_one_iff.mpr ⟨-k, by push_cast; ring1⟩
  simp only [f3, Pi.pow_apply, Pi.mul_apply, mul_pow,
    thetaConstant_embedFirst_lowerUnipotent_smul_sq, cons_val_zero, Int.cast_zero, Int.cast_one,
    zero_pow two_ne_zero, mul_zero, neg_zero, Complex.exp_zero]
  linear_combination (denom (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * k))))
    Ω.val).det ^ 3 * thetaConstant ![0, 0] ![0, 1] Ω ^ 2 * thetaConstant ![0, 0] ![1, 0] Ω ^ 2 *
      thetaConstant ![0, 0] ![1, 1] Ω ^ 2 * he

private lemma det_denom_eq_det (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    (denom (map (Int.castRingHom ℝ) p) Ω.val).det = (p.1.toBlocks₂₂.det : ℂ) := by
  rw [denom_of_mem_siegelParabolic Ω hp, Int.cast_det]
  rfl

private lemma det_denom_coordSwap :
    (denom (map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ)) Ω.val).det = -1 := by
  rw [det_denom_eq_det Ω coordSwap_mem_siegelParabolic]
  simp [coordSwap]

private lemma det_denom_rotation :
    (denom (map (Int.castRingHom ℝ) (rotation (upperUnipotent 1))) Ω.val).det = 1 := by
  rw [det_denom_eq_det Ω (rotation_mem_siegelParabolic _)]
  simp [rotation, upperUnipotent]

private lemma det_pow_eq (hp : p ∈ siegelParabolic (Fin 2) ℤ) (n : ℕ) :
    (p.1.toBlocks₂₂.det : ℂ) ^ (n + 2) = (p.1.toBlocks₂₂.det : ℂ) ^ n := by
  rcases Int.isUnit_iff.mp (isUnit_det_toBlocks₂₂ ⟨p, hp⟩ : IsUnit p.1.toBlocks₂₂.det) with
    h | h <;> simp [h, pow_add]

private lemma psi4_of_mem_siegelParabolic (hp : p ∈ siegelParabolic (Fin 2) ℤ) :
    (psi4 (Fin 2) ⟨p, siegelParabolic_le_Gamma0 hp⟩ : ℂ) = (p.1.toBlocks₂₂.det : ℂ) := by
  have e : ((Gamma0 (Fin 2) 4).equivMapOfInjective _ map_intCast_injective).symm
      ⟨map (Int.castRingHom ℚ) p, p, siegelParabolic_le_Gamma0 hp, rfl⟩ =
        ⟨p, siegelParabolic_le_Gamma0 hp⟩ := by
    rw [MulEquiv.symm_apply_eq]
    exact Subtype.ext rfl
  rw [← psi4Rat_map_of_mem_siegelParabolic hp ⟨p, siegelParabolic_le_Gamma0 hp, rfl⟩, psi4Rat,
    MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, e]

variable {k} in
private lemma mem_slashCharStabilizer_of_apply (hγ : γ ∈ Gamma0 (Fin 2) 4)
    (h : ∀ τ, F (map (Int.castRingHom ℝ) γ • τ) =
      ψ ⟨γ, hγ⟩ * (denom (map (Int.castRingHom ℝ) γ) τ.val).det ^ k * F τ) :
    γ ∈ slashCharStabilizer (TauCeti.detPowerRep ℂ 2 k) F (Gamma0 (Fin 2) 4) ψ :=
  ⟨hγ, (slash_eq_smul_iff _ _ _ _).mpr fun τ ↦ by
    rw [h τ, detPowerRep_denomGL, smul_eq_mul, mul_assoc]⟩

private lemma comp_double_embedFirst_lowerUnipotent_smul {n : ℕ}
    (h : ∀ W, F (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * 1))) • W) =
      (denom (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent (2 * 1)))) W.val).det ^ n *
        F W) :
    (F ∘ double) (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent ((4 : ℕ) : ℤ))) • Ω) =
      (denom (map (Int.castRingHom ℝ) (embedFirst (lowerUnipotent ((4 : ℕ) : ℤ)))) Ω.val).det ^ n *
        (F ∘ double) Ω := by
  rw [Function.comp_apply, Function.comp_apply, show ((4 : ℕ) : ℤ) = 2 * (2 * 1) by rfl,
    double_embedFirst_lowerUnipotent_smul, denom_embedFirst_lowerUnipotent_two_mul, h]

private lemma double_coordSwap_smul :
    double (map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ) • Ω) =
      map (Int.castRingHom ℝ) (coordSwap : symplecticGroup (Fin 2) ℤ) • double Ω :=
  double_smul_of_toBlocks₁₂_eq_zero Ω coordSwap_mem_siegelParabolic (toBlocks_fromBlocks₁₂ _ _ _ _)

private lemma double_rotation_smul :
    double (map (Int.castRingHom ℝ) (rotation (upperUnipotent 1)) • Ω) =
      map (Int.castRingHom ℝ) (rotation (upperUnipotent 1)) • double Ω :=
  double_smul_of_toBlocks₁₂_eq_zero Ω (rotation_mem_siegelParabolic _)
    (toBlocks_fromBlocks₁₂ _ _ _ _)

/-- **`f₁₁(2Ω)` is a Siegel modular form of weight 11 on `Γ₀(4)`** (LMFDB
`mf.siegel.family.gamma0_4_psi_4`; Aoki and Ibukiyama, §5), with trivial character. The element
`ι₁(1, 0; 4, 1)` acts on `2Ω` as `ι₁(1, 0; 2, 1) ∈ Γ[2]`, which fixes `θ_m⁴` in weight 2 and `χ₅` in
weight 5. An element `(A, B; 0, D)` of `P(ℤ)` acts on `2Ω` as `(A, 2B; 0, D)`: if `A ≡ 1 (mod 2)`,
this fixes `θ₀₀₀₁`, `θ₀₀₁₀`, `θ₀₀₁₁` and multiplies `χ₅` by `det(D)⁵ = det(D)¹¹`; the swap of the
coordinates and the rotation by `(1, 1; 0, 1)` send `f₆` to `-f₆` and `χ₅` to `χ₅` and `-χ₅`, with
`det D = -1` and `1`; and these elements generate `P(ℤ)`, which with `ι₁(1, 0; 4, 1)` generates
`Γ₀(4)`. That `f₁₁(2Ω)` is a cusp form is proved only at the standard cusp. -/
lemma f11_comp_double_mem_gamma0_four : f11 ∘ double ∈ scalarModularForms 11 (gamma0 4) := by
  have hle : Gamma0 (Fin 2) 4 ≤ slashCharStabilizer (TauCeti.detPowerRep ℂ 2 11) (f11 ∘ double)
      (Gamma0 (Fin 2) 4) 1 := by
    refine (closure_insert_siegelParabolic_eq_Gamma0 four_pos le_rfl).ge.trans
      ((Subgroup.closure_le _).mpr (Set.insert_subset ?_ fun p hp ↦ ?_))
    · refine mem_slashCharStabilizer_of_apply embedFirst_lowerUnipotent_natCast_mem_Gamma0
        fun τ ↦ ?_
      rw [MonoidHom.one_apply, Units.val_one, one_mul, zpow_ofNat,
        comp_double_embedFirst_lowerUnipotent_smul τ fun W ↦ f11_embedFirst_lowerUnipotent_smul W 1]
    refine mem_of_mem_siegelParabolic (fun q hq hA ↦ ?_) ?_ ?_ hp
    · refine mem_slashCharStabilizer_of_apply (siegelParabolic_le_Gamma0 hq) fun τ ↦ ?_
      rw [MonoidHom.one_apply, Units.val_one, one_mul, Function.comp_apply, Function.comp_apply,
        ← twiceUpper_smul_double τ hq, f11_twiceUpper_smul _ hq hA, det_denom_eq_det τ hq,
        zpow_ofNat, det_pow_eq hq 9, det_pow_eq hq 7, det_pow_eq hq 5]
    · refine mem_slashCharStabilizer_of_apply (siegelParabolic_le_Gamma0
        coordSwap_mem_siegelParabolic) fun τ ↦ ?_
      rw [MonoidHom.one_apply, Units.val_one, one_mul, Function.comp_apply, Function.comp_apply,
        double_coordSwap_smul, f11_coordSwap_smul, det_denom_coordSwap]
      norm_num
    · refine mem_slashCharStabilizer_of_apply (siegelParabolic_le_Gamma0
        (rotation_mem_siegelParabolic _)) fun τ ↦ ?_
      rw [MonoidHom.one_apply, Units.val_one, one_mul, Function.comp_apply, Function.comp_apply,
        double_rotation_smul, f11_rotation_smul, det_denom_rotation, zpow_ofNat, one_pow, one_mul]
  simpa using mem_modularForms_map_of_le_slashCharStabilizer _ _ _ 1 isHolomorphic_f11.comp_double
    hle

/-- **`f₃(2Ω) = (θ₀₀₀₁ θ₀₀₁₀ θ₀₀₁₁)²(2Ω)` is a Siegel modular form of weight 3 and character `ψ₄`
on `Γ₀(4)`** (LMFDB `mf.siegel.family.gamma0_4_psi_4`; Aoki and Ibukiyama, §5). The element
`ι₁(1, 0; 4, 1)`, on which `ψ₄` is trivial, acts on `2Ω` as `ι₁(1, 0; 2, 1)`, which multiplies
`θ₀₀₁₀²` and `θ₀₀₁₁²` by `-det(CΩ + D)` and `θ₀₀₀₁²` by `det(CΩ + D)`; the elements `(A, B; 0, D)`
of `P(ℤ)` permute the three theta constants up to signs, and `ψ₄(γ) det(D)³ = det(D)⁴ = 1`. -/
lemma f3_comp_double_mem_gamma0_four :
    f3 ∘ double ∈ modularForms (TauCeti.detPowerRep ℂ 2 3) (gamma0 4) (psi4Rat (Fin 2)) := by
  have hle : Gamma0 (Fin 2) 4 ≤ slashCharStabilizer (TauCeti.detPowerRep ℂ 2 3) (f3 ∘ double)
      (Gamma0 (Fin 2) 4) (psi4 (Fin 2)) := by
    refine (closure_insert_siegelParabolic_eq_Gamma0 four_pos le_rfl).ge.trans
      ((Subgroup.closure_le _).mpr (Set.insert_subset ?_ fun p hp ↦ ?_))
    · refine mem_slashCharStabilizer_of_apply embedFirst_lowerUnipotent_natCast_mem_Gamma0
        fun τ ↦ ?_
      rw [psi4_embedFirst_lowerUnipotent, Units.val_one, one_mul, zpow_ofNat,
        comp_double_embedFirst_lowerUnipotent_smul τ fun W ↦ f3_embedFirst_lowerUnipotent_smul W 1]
    refine mem_of_mem_siegelParabolic (fun q hq hA ↦ ?_) ?_ ?_ hp
    · refine mem_slashCharStabilizer_of_apply (siegelParabolic_le_Gamma0 hq) fun τ ↦ ?_
      rw [psi4_of_mem_siegelParabolic hq, Function.comp_apply, Function.comp_apply,
        ← twiceUpper_smul_double τ hq, f3_twiceUpper_smul _ hq hA, det_denom_eq_det τ hq,
        zpow_ofNat, ← pow_succ', det_pow_eq hq 2, det_pow_eq hq 0, pow_zero, one_mul]
    · refine mem_slashCharStabilizer_of_apply (siegelParabolic_le_Gamma0
        coordSwap_mem_siegelParabolic) fun τ ↦ ?_
      rw [psi4_of_mem_siegelParabolic coordSwap_mem_siegelParabolic, Function.comp_apply,
        Function.comp_apply, double_coordSwap_smul, f3_coordSwap_smul, det_denom_coordSwap]
      norm_num [coordSwap]
    · refine mem_slashCharStabilizer_of_apply (siegelParabolic_le_Gamma0
        (rotation_mem_siegelParabolic _)) fun τ ↦ ?_
      rw [psi4_of_mem_siegelParabolic (rotation_mem_siegelParabolic _), Function.comp_apply,
        Function.comp_apply, double_rotation_smul, f3_rotation_smul, det_denom_rotation]
      norm_num [rotation, upperUnipotent]
  exact mem_modularForms_map_of_le_slashCharStabilizer _ _ _ _ isHolomorphic_f3.comp_double hle

/-- The group **`Γ₀^{ψ₄}(4) = ker ψ₄`** (LMFDB `mf.siegel.family.gamma0_4_psi_4`; Aoki and
Ibukiyama, §5), of index 2 in `Γ₀(4)`, as a subgroup of `Sp(4, ℚ)`. -/
noncomputable abbrev gamma0Psi4 : Subgroup (symplecticGroup (Fin 2) ℚ) :=
  (psi4Rat (Fin 2)).ker.map (gamma0 4).subtype

/-- **The theorem of Hayashida and Ibukiyama on `Γ₀(4)` with the character `ψ₄`** (LMFDB
`mf.siegel.family.gamma0_4_psi_4`), as a statement, after Ibukiyama and Hayashida (RIMS Kôkyûroku
1173 (2000), Theorem 2.2) and Aoki and Ibukiyama (Int. J. Math. 16 (2005), §5, Theorem 5.1):
`f₁(2Ω) = θ₀₀₀₀(2Ω)²` and `f₃(2Ω) = (θ₀₀₀₁ θ₀₀₁₀ θ₀₀₁₁)²(2Ω)` are modular forms on `Γ₀(4)` of
weights 1 and 3 and character `ψ₄(γ) = (-1 / det D)`, `X` and `X(2Ω)` of weight 2, `f₁₁(2Ω)` is a
cusp form of weight 11; `f₁(2Ω)`, `X`, `X(2Ω)`, `f₃(2Ω)` are algebraically independent and generate
`⊕_k M_k(Γ₀(4), ψ₄^k)`, and with `f₁₁(2Ω)` the graded ring of modular forms on
`Γ₀^{ψ₄}(4) = ker ψ₄`. The sources write `f₁`, `f₃` for our `f₁(2Ω)`, `f₃(2Ω)`, and use
`G₂ = g₂ = Σ_μ θ_{μ,0}(2Ω)⁴`, `h₂ = 4X(2Ω)` and `χ₁₁ = f₁₁(2Ω)/2¹⁸` (their `χ₅` is the product of
the ten theta constants divided by 64, as their `a(3, 2, 1; χ₁₁) = -1` shows); `g₂ = X` by the
duplication formula `θ_{0,ν}(Ω)² = Σ_μ (-1)^{μ·ν} θ_{μ,0}(2Ω)²`, which is not proved here.

The last field is the decomposition of the knowl, corrected: with `B = ℂ[X, X(2Ω), f₂(2Ω), K(2Ω)]`,
`⊕_k M_{2k}(Γ₀(4), ψ₄) = f₁₁(2Ω) f₁(2Ω) B ⊕ f₁₁(2Ω) f₃(2Ω) B`. The knowl adds a summand
`Y(2Ω) B`, whose forms have trivial character, and takes `f₃ = (θ₀₀₀₀ θ₀₀₀₁ θ₀₀₁₁)²`, which is not
modular at `2Ω`. The decomposition follows from the two theorems: a monomial in
`f₁, g₂, h₂, f₃, χ₁₁` has even weight and character `ψ₄` exactly when its degrees in `f₁` and `f₃`
add up to an odd number and its degree in `χ₁₁` is odd, and `χ₁₁² ∈ ℂ[f₁, g₂, h₂, f₃]` (weight 22,
character `ψ₄²²`), so the module is `χ₁₁ (f₁ C + f₃ C)`, where `C` is the ring of forms of even
weight and trivial character. As `C = B ⊕ Y(2Ω) B`
(`SiegelUpperHalfSpace.Ibukiyama.Gamma0FourStructure`), `Y(2Ω) = f₁ f₃`, `f₁² = f₂(2Ω) ∈ B` and
`f₃² ∈ C`, the module is `χ₁₁ (f₁ B + f₃ B)`; the sum is direct, since the Hilbert series
`(t¹² + t¹⁴)/((1 - t²)³ (1 - t⁶))` of the module is the sum of those of the two summands. The first
four fields are proved; the rest is not proved here. -/
structure Gamma0FourPsiFourStructure : Prop where
  f1_comp_double_mem :
    f1 ∘ double ∈ modularForms (TauCeti.detPowerRep ℂ 2 1) (gamma0 4) (psi4Rat (Fin 2))
  X_mem : X ∈ scalarModularForms 2 (gamma0 4)
  X_comp_double_mem : X ∘ double ∈ scalarModularForms 2 (gamma0 4)
  f3_comp_double_mem :
    f3 ∘ double ∈ modularForms (TauCeti.detPowerRep ℂ 2 3) (gamma0 4) (psi4Rat (Fin 2))
  f11_comp_double_mem : f11 ∘ double ∈ cuspForms (TauCeti.detPowerRep ℂ 2 11) (gamma0 4) 1
  algebraicIndependent : AlgebraicIndependent ℂ ![f1 ∘ double, X, X ∘ double, f3 ∘ double]
  iSup_modularForms_psi4_pow_eq :
    ⨆ k : ℕ, modularForms (TauCeti.detPowerRep ℂ 2 k) (gamma0 4) (psi4Rat (Fin 2) ^ k) =
      (Algebra.adjoin ℂ {f1 ∘ double, X, X ∘ double, f3 ∘ double}).toSubmodule
  gradedModularForms_eq : gradedModularForms gamma0Psi4 =
    (Algebra.adjoin ℂ {f1 ∘ double, X, X ∘ double, f3 ∘ double, f11 ∘ double}).toSubmodule
  isFreeOverAdjoin : IsFreeOverAdjoin (evenWeightModularForms (gamma0 4) (psi4Rat (Fin 2)))
    ![X, X ∘ double, f2 ∘ double, K ∘ double] ![(f11 * f1) ∘ double, (f11 * f3) ∘ double]

end SiegelUpperHalfSpace.Ibukiyama
