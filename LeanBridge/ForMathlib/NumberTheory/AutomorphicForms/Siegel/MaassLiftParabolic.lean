import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.IbukiyamaGamma0
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.MaassLiftInvariance

/-!
# The Maass lift under the Siegel parabolic subgroup

The Maass lift `F(Z) = ∑ a(n, r, m) e^{2πi(nτ + rz + mω)}` of a Jacobi form `φ ∈ J_{k,1}`
(`SiegelUpperHalfSpace.maassLift`, LMFDB `mf.siegel.lift.maass`) transforms like a Siegel modular
form of weight `k` under the whole Siegel parabolic subgroup `P(ℤ) = {(A, B; 0, D)}` of `Sp(4, ℤ)`,
as a sum of series, without any convergence. An element of `P(ℤ)` acts by `Z ↦ AZAᵀ + BAᵀ`, which
replaces the exponential of `T = (n, r/2; r/2, m)` by that of `AᵀTA`. In index `1` the coefficient
`a(T) = ∑_{d ∣ (n, r, m)} d^{k-1} c(nm/d², r/d)` only depends on the content `gcd(n, r, m)` and
the discriminant `4nm - r²` of `T`, as `c(n, r)` only depends on `4n - r²`, and it vanishes unless
`T` is positive semidefinite; all three are invariant under `T ↦ AᵀTA` for `A ∈ GL(2, ℤ)`. This
covers at once the translations, the swap, the parity `z ↦ -z` and the Heisenberg part
`(τ, z, ω) ↦ (τ, z + λτ, ω + 2λz + λ²τ)` of the embedded Jacobi group. As
`Sp(4, ℤ)` is generated by `P(ℤ)` and the partial inversion `J₁`
(`SymplecticGroup.closure_insert_partialInversion_eq_top`), the theorem of Maass reduces to the
holomorphy of the lift and its transformation law under `J₁`.

## Main results

* `SiegelUpperHalfSpace.maassLift_smul_of_mem_siegelParabolic`: the transformation law of the
  Maass lift of `φ ∈ J_{k,1}` under the Siegel parabolic subgroup.
* `SiegelUpperHalfSpace.maassLift_mem_scalarModularForms`: a holomorphic Maass lift of
  `φ ∈ J_{k,1}` that transforms correctly under `J₁` is a Siegel modular form of weight `k` on
  `Sp(4, ℤ)`.
-/

open Matrix hiding one_zpow zpow_mul

open Complex ModularForm SymplecticGroup

open scoped UpperHalfPlane

namespace SiegelUpperHalfSpace

variable {k : ℤ} {φ : ℍ × ℂ → ℂ} (A A' : Matrix (Fin 2) (Fin 2) ℤ) (p : ℤ × ℤ × ℤ)
    (n r m : ℤ) (Z : SiegelUpperHalfSpace (Fin 2))

/-- The coefficients `(n', r', m')` of the binary quadratic form `Q(Ax)`, for
`Q(x) = nx₁² + rx₁x₂ + mx₂²` and `p = (n, r, m)`: the matrix `T = (n, r/2; r/2, m)` becomes
`AᵀTA`. -/
private def formTransform : ℤ × ℤ × ℤ :=
  (p.1 * A 0 0 ^ 2 + p.2.1 * A 0 0 * A 1 0 + p.2.2 * A 1 0 ^ 2,
    2 * p.1 * A 0 0 * A 0 1 + p.2.1 * (A 0 0 * A 1 1 + A 0 1 * A 1 0) + 2 * p.2.2 * A 1 0 * A 1 1,
    p.1 * A 0 1 ^ 2 + p.2.1 * A 0 1 * A 1 1 + p.2.2 * A 1 1 ^ 2)

private lemma formTransform_formTransform :
    formTransform A' (formTransform A p) = formTransform (A * A') p := by
  simp only [formTransform, Matrix.mul_apply, Fin.sum_univ_two, Prod.mk.injEq]
  refine ⟨?_, ?_, ?_⟩ <;> ring1

private lemma formTransform_one : formTransform 1 p = p := by
  simp [formTransform]

private lemma formTransform_zero : formTransform A 0 = 0 := by
  simp [formTransform]

private lemma formTransform_disc : 4 * (formTransform A p).1 * (formTransform A p).2.2 -
    (formTransform A p).2.1 ^ 2 = A.det ^ 2 * (4 * p.1 * p.2.2 - p.2.1 ^ 2) := by
  simp only [formTransform, det_fin_two]
  ring1

variable {A A'} in
/-- The bijection `p ↦ AᵀpA` of `ℤ³`, for `A` invertible over `ℤ` with inverse `A'`. -/
private def formTransformEquiv (h : A * A' = 1) (h' : A' * A = 1) : ℤ × ℤ × ℤ ≃ ℤ × ℤ × ℤ where
  toFun := formTransform A
  invFun := formTransform A'
  left_inv p := by rw [formTransform_formTransform, h, formTransform_one]
  right_inv p := by rw [formTransform_formTransform, h', formTransform_one]

private lemma content_dvd : (p.1.gcd p.2.1 : ℤ).gcd p.2.2 ∣
    ((formTransform A p).1.gcd (formTransform A p).2.1 : ℤ).gcd (formTransform A p).2.2 := by
  have hg : (((p.1.gcd p.2.1 : ℤ).gcd p.2.2 : ℕ) : ℤ) ∣ (p.1.gcd p.2.1 : ℤ) :=
    Int.gcd_dvd_left _ _
  have hn : (((p.1.gcd p.2.1 : ℤ).gcd p.2.2 : ℕ) : ℤ) ∣ p.1 := hg.trans <| Int.gcd_dvd_left _ _
  have hr : (((p.1.gcd p.2.1 : ℤ).gcd p.2.2 : ℕ) : ℤ) ∣ p.2.1 := hg.trans <| Int.gcd_dvd_right _ _
  have hm : (((p.1.gcd p.2.1 : ℤ).gcd p.2.2 : ℕ) : ℤ) ∣ p.2.2 := Int.gcd_dvd_right _ _
  refine Int.dvd_gcd (Int.dvd_coe_gcd ?_ ?_) ?_
  · exact ((hn.mul_right _).add ((hr.mul_right _).mul_right _)).add (hm.mul_right _)
  · exact ((((hn.mul_left 2).mul_right _).mul_right _).add (hr.mul_right _)).add
      (((hm.mul_left 2).mul_right _).mul_right _)
  · exact ((hn.mul_right _).add ((hr.mul_right _).mul_right _)).add (hm.mul_right _)

variable {A A'} in
private lemma content_formTransform (h : A * A' = 1) :
    ((formTransform A p).1.gcd (formTransform A p).2.1 : ℤ).gcd (formTransform A p).2.2 =
      (p.1.gcd p.2.1 : ℤ).gcd p.2.2 := by
  refine Nat.dvd_antisymm ?_ (content_dvd A p)
  simpa only [formTransform_formTransform, h, formTransform_one] using
    content_dvd A' (formTransform A p)

lemma sq_mul_disc_of_mem_divisors {d : ℕ} (hd : d ∈ ((n.gcd r : ℤ).gcd m).divisors) :
    (d : ℤ) ^ 2 * (4 * (n * m / (d : ℤ) ^ 2) - (r / d) ^ 2) = 4 * n * m - r ^ 2 := by
  simpa using sq_mul_disc_level 1 n r m hd

variable {n r m} in
private lemma liftDivisorSum_eq (hφ : φ ∈ jacobiFormSpace k 1) {n' r' m' : ℤ}
    (hg : (n'.gcd r' : ℤ).gcd m' = (n.gcd r : ℤ).gcd m)
    (hD : 4 * n' * m' - r' ^ 2 = 4 * n * m - r ^ 2) :
    liftDivisorSum k (jacobiCoeff φ) n' r' m' = liftDivisorSum k (jacobiCoeff φ) n r m := by
  rw [liftDivisorSum, liftDivisorSum, hg]
  refine Finset.sum_congr rfl fun d hd ↦ ?_
  congr 1
  exact jacobiCoeff_eq_of_mem_jacobiFormSpace_one hφ <| mul_left_cancel₀
    (pow_ne_zero 2 (Nat.cast_ne_zero.mpr (Nat.pos_of_mem_divisors hd).ne')) <|
      (sq_mul_disc_of_mem_divisors n' r' m' (hg ▸ hd)).trans
        (hD.trans (sq_mul_disc_of_mem_divisors n r m hd).symm)

lemma liftDivisorSum_eq_zero (hφ : φ ∈ jacobiFormSpace k 1) (h : 4 * n * m < r ^ 2) :
    liftDivisorSum k (jacobiCoeff φ) n r m = 0 :=
  Finset.sum_eq_zero fun d hd ↦ by
    rw [jacobiCoeff_eq_zero_of_mem_jacobiFourierSupported hφ.2.2, mul_zero]
    rintro ⟨-, hle⟩
    have h₁ : (d : ℤ) ^ 2 * (4 * (n * m / (d : ℤ) ^ 2) - (r / d) ^ 2) = 4 * n * m - r ^ 2 :=
      sq_mul_disc_of_mem_divisors n r m hd
    simp only [Nat.cast_one] at hle
    linarith [mul_nonneg (sq_nonneg (d : ℤ)) (sub_nonneg.mpr hle)]

/-- The binary quadratic form `nx₁² + rx₁x₂ + mx₂²` of `p = (n, r, m)` is positive semidefinite. -/
private def PosSemidefForm : Prop :=
  0 ≤ p.1 ∧ 0 ≤ p.2.2 ∧ p.2.1 ^ 2 ≤ 4 * p.1 * p.2.2

variable {p} in
private lemma PosSemidefForm.nonneg (hp : PosSemidefForm p) (x y : ℤ) :
    0 ≤ p.1 * x ^ 2 + p.2.1 * x * y + p.2.2 * y ^ 2 := by
  rcases hp with ⟨hn, hm, hd⟩
  rcases hn.eq_or_lt with h0 | hpos
  · have hr : p.2.1 = 0 := by
      nlinarith
    rw [← h0, hr]
    nlinarith [sq_nonneg y]
  · nlinarith [sq_nonneg (2 * p.1 * x + p.2.1 * y), mul_nonneg (sub_nonneg.mpr hd) (sq_nonneg y)]

variable {p} in
private lemma PosSemidefForm.formTransform (hp : PosSemidefForm p) :
    PosSemidefForm (formTransform A p) :=
  ⟨hp.nonneg _ _, hp.nonneg _ _, sub_nonneg.mp <| by
    rw [formTransform_disc]
    exact mul_nonneg (sq_nonneg _) (sub_nonneg.mpr hp.2.2)⟩

private lemma maassCoeff_eq_zero (hφ : φ ∈ jacobiFormSpace k 1) (hp : ¬PosSemidefForm p) :
    maassCoeff k (jacobiCoeff φ) p.1 p.2.1 p.2.2 = 0 := by
  rw [maassCoeff, ite_eq_right fun h ↦ hp ⟨h.1.ge, h.2.2.ge, by simp [h.1, h.2.1]⟩]
  split_ifs with h
  · exact liftDivisorSum_eq_zero _ _ _ hφ (not_le.mp fun h' ↦ hp ⟨h.1, h.2, h'⟩)
  · rfl

lemma maassCoeff_eq_zero_of_not_posSemidef (hφ : φ ∈ jacobiFormSpace k 1)
    (h : ¬(0 ≤ n ∧ 0 ≤ m ∧ r ^ 2 ≤ 4 * n * m)) : maassCoeff k (jacobiCoeff φ) n r m = 0 :=
  maassCoeff_eq_zero (n, r, m) hφ h

variable {A A'} in
private lemma maassCoeff_formTransform (hφ : φ ∈ jacobiFormSpace k 1) (h : A * A' = 1) :
    maassCoeff k (jacobiCoeff φ) (formTransform A p).1 (formTransform A p).2.1
      (formTransform A p).2.2 = maassCoeff k (jacobiCoeff φ) p.1 p.2.1 p.2.2 := by
  have hinv : formTransform A' (formTransform A p) = p := by
    rw [formTransform_formTransform, h, formTransform_one]
  by_cases hp : PosSemidefForm p
  · rcases eq_or_ne p 0 with rfl | hp0
    · rw [formTransform_zero]
    · have hq0 : ¬((formTransform A p).1 = 0 ∧ (formTransform A p).2.1 = 0 ∧
          (formTransform A p).2.2 = 0) := fun h₀ ↦ hp0 <| by
        rw [← hinv, (Prod.ext h₀.1 (Prod.ext h₀.2.1 h₀.2.2) : formTransform A p = 0),
          formTransform_zero]
      have hp0' : ¬(p.1 = 0 ∧ p.2.1 = 0 ∧ p.2.2 = 0) := fun h₀ ↦
        hp0 (Prod.ext h₀.1 (Prod.ext h₀.2.1 h₀.2.2))
      have hq : PosSemidefForm (formTransform A p) := hp.formTransform A
      have hdet : A.det ^ 2 = 1 :=
        Int.isUnit_sq <| IsUnit.of_mul_eq_one A'.det <| by rw [← det_mul, h, det_one]
      rw [maassCoeff, maassCoeff, ite_eq_right hq0, ite_eq_right hp0', ite_eq_left ⟨hq.1, hq.2.1⟩,
        ite_eq_left ⟨hp.1, hp.2.1⟩]
      exact liftDivisorSum_eq hφ (content_formTransform p h) <| by
        rw [formTransform_disc, hdet, one_mul]
  · rw [maassCoeff_eq_zero _ hφ hp,
      maassCoeff_eq_zero _ hφ fun hq ↦ hp <| hinv ▸ hq.formTransform A']

variable {γ : symplecticGroup (Fin 2) ℤ}

private lemma liftExp_smul_of_mem_siegelParabolic (hγ : γ ∈ siegelParabolic (Fin 2) ℤ) :
    liftExp 1 p.1 p.2.1 p.2.2 (map (Int.castRingHom ℝ) γ • Z) = liftExp 1
      (formTransform γ.1.toBlocks₁₁ p).1 (formTransform γ.1.toBlocks₁₁ p).2.1
        (formTransform γ.1.toBlocks₁₁ p).2.2 Z := by
  have h10 : Z.val 1 0 = Z.val 0 1 := congrFun (congrFun Z.transpose_val 0) 1
  rw [liftExp, liftExp, val_smul_of_mem_siegelParabolic Z hγ]
  refine Complex.exp_eq_exp_iff_exists_int.mpr ⟨p.1 * (γ.1.toBlocks₁₂ * γ.1.toBlocks₁₁ᵀ) 0 0 +
    p.2.1 * (γ.1.toBlocks₁₂ * γ.1.toBlocks₁₁ᵀ) 0 1 + p.2.2 * (γ.1.toBlocks₁₂ * γ.1.toBlocks₁₁ᵀ) 1 1,
    ?_⟩
  simp [Matrix.mul_apply, formTransform, h10]
  ring1

/-- **The Maass lift transforms like a Siegel modular form of weight `k` under the Siegel parabolic
subgroup** `P(ℤ) = {(A, B; 0, D)}` of `Sp(4, ℤ)`, for every Jacobi form `φ ∈ J_{k,1}`: `γ` acts by
`Z ↦ AZAᵀ + BAᵀ`, which sends the exponential of `T = (n, r/2; r/2, m)` to that of `AᵀTA`, and
`a(AᵀTA) = a(T)`, since `a(T)` only depends on the content `gcd(n, r, m)` and the discriminant
`4nm - r²` of `T`, which `GL(2, ℤ)` preserves, and vanishes unless `T` is positive semidefinite;
`det(cZ + d)^k = (det D)^k = 1` in even weight, and there are no Jacobi forms of odd weight and
index `1`. -/
lemma maassLift_smul_of_mem_siegelParabolic (hφ : φ ∈ jacobiFormSpace k 1)
    (hγ : γ ∈ siegelParabolic (Fin 2) ℤ) : maassLift k φ (map (Int.castRingHom ℝ) γ • Z) =
      (denom (map (Int.castRingHom ℝ) γ) Z.val).det ^ k * maassLift k φ Z := by
  rcases Int.even_or_odd k with hk | hk
  · have hdet : (denom (map (Int.castRingHom ℝ) γ) Z.val).det ^ k = 1 := by
      rcases hk with ⟨j, rfl⟩
      rw [← two_mul, zpow_mul, zpow_ofNat, Ibukiyama.det_denom_sq_of_mem_siegelParabolic Z hγ,
        one_zpow]
    have hA : γ.1.toBlocks₁₁ * γ.1.toBlocks₂₂ᵀ = 1 := toBlocks₁₁_mul_transpose_toBlocks₂₂ hγ
    rw [hdet, one_mul, maassLift, maassLift]
    refine (tsum_congr fun q ↦ ?_).trans ((formTransformEquiv hA (mul_eq_one_comm.mp hA)).tsum_eq
      fun q ↦ maassCoeff k (jacobiCoeff φ) q.1 q.2.1 q.2.2 * liftExp 1 q.1 q.2.1 q.2.2 Z)
    rw [liftExp_smul_of_mem_siegelParabolic _ _ hγ, ← maassCoeff_formTransform q hφ hA]
    rfl
  · rw [maassLift_eq_zero_of_odd hφ hk, Pi.zero_apply, Pi.zero_apply, mul_zero]

/-- **The Maass lift of `φ ∈ J_{k,1}` is a Siegel modular form of weight `k` on `Sp(4, ℤ)` as soon
as it is holomorphic and transforms correctly under the partial inversion**
`J₁ : (τ, z; z, ω) ↦ (-1/τ, z/τ; z/τ, ω - z²/τ)`, whose automorphy factor is `τ`: `Sp(4, ℤ)` is
generated by `J₁` and the Siegel parabolic subgroup, under which the Maass lift transforms
correctly (`maassLift_smul_of_mem_siegelParabolic`). So the theorem of Maass (`MaassLiftTheorem`)
reduces to the holomorphy of the series and its law `F(J₁Z) = τ^k F(Z)`. -/
lemma maassLift_mem_scalarModularForms (hφ : φ ∈ jacobiFormSpace k 1)
    (hF : IsHolomorphic (maassLift k φ)) (h : ∀ Z : SiegelUpperHalfSpace (Fin 2),
      maassLift k φ (map (Int.castRingHom ℝ) partialInversion • Z) =
        Z.val 0 0 ^ k * maassLift k φ Z) :
    maassLift k φ ∈ scalarModularForms k (integral (Fin 2)) := by
  have hle : ⊤ ≤ slashCharStabilizer (TauCeti.detPowerRep ℂ 2 k) (maassLift k φ) ⊤ 1 := by
    refine closure_insert_partialInversion_eq_top.ge.trans ((Subgroup.closure_le _).mpr
      (Set.insert_subset ⟨trivial, ?_⟩ fun γ hγ ↦ ⟨trivial, ?_⟩)) <;>
      rw [MonoidHom.one_apply, Units.val_one, slash_eq_smul_iff] <;> intro Z <;>
      rw [one_smul, detPowerRep_denomGL]
    · rw [det_denom_partialInversion, h]
    · exact maassLift_smul_of_mem_siegelParabolic Z hφ hγ
  exact mem_modularForms_map_of_le_slashCharStabilizer _ _ _ 1 hF hle

end SiegelUpperHalfSpace
