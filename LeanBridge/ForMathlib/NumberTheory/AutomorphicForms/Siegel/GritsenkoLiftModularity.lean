import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Jacobi.IndexRaising
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Maass.HeckeFourier
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.GritsenkoLiftSummable
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.IbukiyamaGamma0
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.ParamodularGenerators

/-!
# The Gritsenko lift is a paramodular form

The Gritsenko lift `F = Grit(φ)` (`SiegelUpperHalfSpace.gritsenkoLift`, LMFDB
`mf.siegel.lift.gritsenko`) of a Jacobi cusp form `φ ∈ J_{k,N}^cusp`, `N ≥ 1`, has the
Fourier–Jacobi expansion `F(Z) = ∑_{m ≥ 1} (φ ∣ V_m)(τ, z) e^{2πiNmω}`, where `φ ∣ V_m` is the image
of `φ` under the index raising operator of Eichler and Zagier (`ModularForm.indexRaising`), whose
Fourier coefficients are the divisor sums `∑_{d ∣ (n, r, m)} d^{k-1} c(nm/d², r/d)`. The paramodular
group `K(N)` is generated by the translations `Z ↦ Z + (a, b; b, d/N)`, the partial inversion `J₁`
and its conjugate `J₂ = V_N J₁ V_N` by the involution `V_N : (τ, z, ω) ↦ (Nω, z, τ/N)`
(`SiegelUpperHalfSpace.closure_paramodularGenerators`). The series is invariant under the
translations term by term; `F ∘ V_N = F`, as `a(n, r, m) = a(m, r, n)`; and `F(J₁Z) = τ^k F(Z)`,
since `φ ∣ V_m` transforms under `(0, -1; 1, 0)` like a Jacobi form of weight `k` and index `Nm`,
the factor `e^{2πiNmz²/τ}` cancelling against the shift `ω ↦ ω - z²/τ`. So `F ∈ M_k(K(N))`
(Gritsenko).

The transformation of `φ ∣ V_m` in index `N` follows from that in index `1`
(`ModularForm.indexRaising_S`), which only uses the transformation law of `φ`, through the scaling
`φ(τ, z/√N)`, which turns the index `N` into `1`. The Fourier expansion of `φ ∣ V_m` and the law
under `J₁` also serve the Maass lift `N = 1`, in
`LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.MaassLiftFourierJacobi` and
`LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.MaassLiftIndexRaising`.

## Main definitions

* `SiegelUpperHalfSpace.toJacobiPoint`: the point `(τ, z)` of `Z = (τ, z; z, ω)`.
* `SiegelUpperHalfSpace.gritsenkoFourierJacobi` (LMFDB `mf.siegel.lift.gritsenko`): the
  Fourier–Jacobi coefficients of the Gritsenko lift.
* `SiegelUpperHalfSpace.paramodularSwap`: the involution `V_N` of `ℋ₂`.
* `SiegelUpperHalfSpace.slashStabilizerRat`: the elements of `Sp(2g, ℚ)` fixing a function under the
  slash operator.

## Main results

* `ModularForm.indexRaising_S_of_index`: the transformation law of `φ ∣ V_m` under
  `(0, -1; 1, 0)`, in index `N`.
* `SiegelUpperHalfSpace.hasSum_liftDivisorSum_indexRaising`: the Fourier expansion of `φ ∣ V_m`.
* `SiegelUpperHalfSpace.gritsenkoLift_eq_tsum_fourierJacobi`: the Fourier–Jacobi expansion of the
  lift.
* `SiegelUpperHalfSpace.gritsenkoFourierJacobi_eq_indexRaising`: its coefficients are the `φ ∣ V_m`.
* `SiegelUpperHalfSpace.tsum_mul_liftExp_partialInversion_smul`: `F(J₁Z) = τ^k F(Z)` for a series in
  the exponentials of the lift, whose Fourier–Jacobi coefficients transform like Jacobi forms under
  `(0, -1; 1, 0)`.
* `SiegelUpperHalfSpace.gritsenkoLift_partialInversion_smul`: `F(J₁Z) = τ^k F(Z)`.
* `SiegelUpperHalfSpace.gritsenkoLift_paramodularSwap`: `F(V_N Z) = F(Z)`.
* `SiegelUpperHalfSpace.gritsenkoLift_paramodularTranslation_smul`: `F` is invariant under the
  translations of `K(N)`.
* `SiegelUpperHalfSpace.gritsenkoLift_paramodularInversion_smul`: `F(J₂Z) = (Nω)^k F(Z)`.
* `SiegelUpperHalfSpace.gritsenkoLift_mem_modularForms`: `F ∈ M_k(K(N))`.
-/

open Matrix hiding one_zpow

open Complex ModularForm ModularGroup Real SymplecticGroup

open scoped MatrixGroups UpperHalfPlane

namespace ModularForm

variable {k : ℤ} {N m : ℕ} {φ : ℍ × ℂ → ℂ}

/-- **The index raising operator `V_m` in index `N`**: if `φ` transforms like a Jacobi form of
weight `k` and index `N ≥ 1` under `SL(2, ℤ)`, then `φ ∣ V_m` transforms like a Jacobi form of
weight `k` and index `Nm` under `S = (0, -1; 1, 0)`. This is the case `N = 1`
(`ModularForm.indexRaising_S`) for `(τ, z) ↦ φ(τ, z/√N)`, which transforms like a Jacobi form of
index `1`. -/
lemma indexRaising_S_of_index (hN : 0 < N) (hφ : ∀ (γ : SL(2, ℤ)) x,
    φ (γ • x.1, x.2 / UpperHalfPlane.denom γ x.1) = jacobiFactor k N x γ * φ x) (hm : 0 < m)
    (x : ℍ × ℂ) : indexRaising k φ m (S • x.1, x.2 / UpperHalfPlane.denom S x.1) =
      jacobiFactor k (N * m) x S * indexRaising k φ m x := by
  have hs : ((√(N : ℝ) : ℝ) : ℂ) ^ 2 = N := by
    rw [← ofReal_pow, Real.sq_sqrt (Nat.cast_nonneg N), ofReal_natCast]
  have hN' : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hN.ne'
  have hs₀ : ((√(N : ℝ) : ℝ) : ℂ) ≠ 0 := fun h ↦ hN' <| by rw [← hs, h]; ring1
  generalize ((√(N : ℝ) : ℝ) : ℂ) = s at hs hs₀
  have hψ (γ : SL(2, ℤ)) (y : ℍ × ℂ) :
      (fun w : ℍ × ℂ ↦ φ (w.1, w.2 / s)) (γ • y.1, y.2 / UpperHalfPlane.denom γ y.1) =
        jacobiFactor k 1 y γ * (fun w : ℍ × ℂ ↦ φ (w.1, w.2 / s)) y := by
    have h : φ (γ • y.1, y.2 / s / UpperHalfPlane.denom γ y.1) =
        jacobiFactor k N (y.1, y.2 / s) γ * φ (y.1, y.2 / s) :=
      hφ γ (y.1, y.2 / s)
    dsimp only at h ⊢
    rw [div_right_comm, h, jacobiFactor, jacobiFactor]
    dsimp only
    have hJ : UpperHalfPlane.denom γ y.1 ≠ 0 := UpperHalfPlane.denom_ne_zero γ y.1
    congr 3
    rw [← hs]
    push_cast
    field_simp
  have hrel (y : ℍ × ℂ) : indexRaising k (fun w : ℍ × ℂ ↦ φ (w.1, w.2 / s)) m y =
      indexRaising k φ m (y.1, y.2 / s) := by
    simp only [indexRaising, cosetTerm, mul_div_assoc]
  have h : indexRaising k (fun w : ℍ × ℂ ↦ φ (w.1, w.2 / s)) m
      (S • x.1, s * x.2 / UpperHalfPlane.denom S x.1) = jacobiFactor k m (x.1, s * x.2) S *
        indexRaising k (fun w : ℍ × ℂ ↦ φ (w.1, w.2 / s)) m (x.1, s * x.2) :=
    indexRaising_S (x.1, s * x.2) hψ hm
  rw [hrel, hrel] at h
  dsimp only at h
  have h₁ : s * x.2 / UpperHalfPlane.denom S x.1 / s = x.2 / UpperHalfPlane.denom S x.1 := by
    field_simp
  have h₂ : s * x.2 / s = x.2 := by
    field_simp
  rw [h₁, h₂] at h
  rw [h]
  congr 1
  rw [jacobiFactor, jacobiFactor]
  dsimp only
  congr 2
  rw [ModularGroup.denom_S]
  push_cast
  rw [← hs]
  ring1

end ModularForm

namespace SiegelUpperHalfSpace

variable {k : ℤ} {φ : ℍ × ℂ → ℂ} {c : ℤ × ℤ → ℂ} {m a : ℕ} (x : ℍ × ℂ)

private lemma sum_cosetReps (hm : 0 < m) (f : ℕ × ℕ × ℕ → ℂ) :
    ∑ t ∈ cosetReps m, f t = ∑ a ∈ m.divisors, ∑ b ∈ Finset.range (m / a), f (a, b, m / a) := by
  rw [Finset.sum_finset_product (cosetReps m) m.divisors
    (fun a ↦ Finset.range (m / a) ×ˢ {m / a}) fun t ↦ ?_]
  · refine Finset.sum_congr rfl fun a _ ↦ ?_
    rw [Finset.sum_product, Finset.sum_congr rfl fun b _ ↦ Finset.sum_singleton _ _]
  · rw [mem_cosetReps hm, Nat.mem_divisors, Finset.mem_product, Finset.mem_range,
      Finset.mem_singleton]
    constructor
    · rintro ⟨h1, h2⟩
      have ha : 0 < t.1 := Nat.pos_of_ne_zero fun h ↦ hm.ne <| by rw [← h1, h, zero_mul]
      have hd : t.2.2 = m / t.1 := by
        rw [← h1, Nat.mul_div_cancel_left _ ha]
      exact ⟨⟨⟨t.2.2, h1.symm⟩, hm.ne'⟩, hd ▸ h2, hd⟩
    · rintro ⟨⟨h1, -⟩, h2, h3⟩
      exact ⟨by rw [h3, Nat.mul_div_cancel' h1], h3 ▸ h2⟩

private lemma hasSum_coset (hc : HasJacobiFourierExpansion φ c) (ha : a ∈ m.divisors) : HasSum
    (fun q : ℤ × ℤ ↦ if ((m / a : ℕ) : ℤ) ∣ q.1 then (a : ℂ) ^ (k - 1) * c q *
      cexp (2 * π * I * (q.1 * a * x.1 / (m / a : ℕ) + q.2 * a * x.2)) else 0)
      ((m : ℂ)⁻¹ * ∑ b ∈ Finset.range (m / a),
        (a : ℂ) ^ k * φ (affinePoint a b (m / a : ℕ) x.1, a * x.2)) := by
  have ha0 : 0 < a := Nat.pos_of_mem_divisors ha
  have hd0 : 0 < m / a := Nat.div_pos (Nat.divisor_le ha) ha0
  have hmad : (m : ℂ) = a * (m / a : ℕ) := by
    exact_mod_cast (Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors ha)).symm
  have ha' : (a : ℂ) ≠ 0 := by exact_mod_cast ha0.ne'
  have hd' : ((m / a : ℕ) : ℂ) ≠ 0 := by exact_mod_cast hd0.ne'
  rw [← Finset.mul_sum, ← mul_assoc]
  refine ((hasSum_sum fun (b : ℕ) _ ↦ hc (affinePoint a b (m / a : ℕ) x.1, a * x.2)).mul_left
      ((m : ℂ)⁻¹ * (a : ℂ) ^ k)).congr_fun fun q ↦ ?_
  have hexp (b : ℕ) : jacobiFourierExp q (affinePoint a b (m / a : ℕ) x.1, a * x.2) =
      cexp (2 * π * I * (q.1 * a * x.1 / (m / a : ℕ) + q.2 * a * x.2)) *
        cexp (2 * π * I * q.1 * b / (m / a : ℕ)) := by
    rw [jacobiFourierExp, coe_affinePoint _ _ (by exact_mod_cast ha0) (by exact_mod_cast hd0),
      ← Complex.exp_add]
    congr 1
    simp only [Int.cast_natCast]
    field_simp
    ring1
  simp only [hexp, ← Finset.mul_sum, UpperHalfPlane.sum_range_exp_two_pi_I_mul_div hd0.ne']
  split_ifs with h
  · rw [hmad, zpow_sub_one₀ ha']
    field_simp
  · simp

private lemma hasSum_coset_reindex (hc : HasJacobiFourierExpansion φ c) (ha : a ∈ m.divisors) :
    HasSum (fun q : ℤ × ℤ ↦ if (a : ℤ) ∣ q.1 ∧ (a : ℤ) ∣ q.2 then (a : ℂ) ^ (k - 1) *
      c (q.1 / a * (m / a : ℕ), q.2 / a) * jacobiFourierExp q x else 0)
      ((m : ℂ)⁻¹ * ∑ b ∈ Finset.range (m / a),
        (a : ℂ) ^ k * φ (affinePoint a b (m / a : ℕ) x.1, a * x.2)) := by
  have ha0 : 0 < a := Nat.pos_of_mem_divisors ha
  have hd0 : 0 < m / a := Nat.div_pos (Nat.divisor_le ha) ha0
  have ha' : (a : ℤ) ≠ 0 := by exact_mod_cast ha0.ne'
  have hd' : ((m / a : ℕ) : ℤ) ≠ 0 := by exact_mod_cast hd0.ne'
  have hι : Function.Injective fun p : ℤ × ℤ ↦ (((m / a : ℕ) : ℤ) * p.1, p.2) :=
    (mul_right_injective₀ hd').prodMap Function.injective_id
  have hκ : Function.Injective fun p : ℤ × ℤ ↦ ((a : ℤ) * p.1, (a : ℤ) * p.2) :=
    (mul_right_injective₀ ha').prodMap (mul_right_injective₀ ha')
  refine (hκ.hasSum_iff fun q hq ↦ ite_eq_right fun h ↦ hq ?_).mp
    (((hι.hasSum_iff fun q hq ↦ ite_eq_right fun h ↦ hq ?_).mpr
      (hasSum_coset x hc ha)).congr_fun fun p ↦ ?_)
  · rcases h with ⟨⟨u, hu⟩, ⟨v, hv⟩⟩
    exact ⟨(u, v), Prod.ext hu.symm hv.symm⟩
  · rcases h with ⟨u, hu⟩
    exact ⟨(u, q.2), Prod.ext hu.symm rfl⟩
  · simp only [Function.comp_apply]
    rw [ite_eq_left ⟨dvd_mul_right _ _, dvd_mul_right _ _⟩, ite_eq_left (dvd_mul_right _ _),
      Int.mul_ediv_cancel_left _ ha', Int.mul_ediv_cancel_left _ ha', mul_comm p.1,
      jacobiFourierExp]
    congr 2
    have hdC : ((m / a : ℕ) : ℂ) ≠ 0 := by exact_mod_cast hd0.ne'
    simp only [Int.cast_mul, Int.cast_natCast]
    field_simp

private lemma sum_divisors_liftDivisorSum (hm : 0 < m) (q : ℤ × ℤ) : ∑ a ∈ m.divisors,
    (if (a : ℤ) ∣ q.1 ∧ (a : ℤ) ∣ q.2 then (a : ℂ) ^ (k - 1) *
      c (q.1 / a * (m / a : ℕ), q.2 / a) * jacobiFourierExp q x else 0) =
        liftDivisorSum k c q.1 q.2 m * jacobiFourierExp q x := by
  have hm0 : m ≠ 0 := hm.ne'
  have hfilter : m.divisors.filter (fun a : ℕ ↦ (a : ℤ) ∣ q.1 ∧ (a : ℤ) ∣ q.2) =
      ((q.1.gcd q.2 : ℤ).gcd m).divisors := by
    ext a
    simp only [Finset.mem_filter, Nat.mem_divisors, Int.dvd_gcd_iff, Int.natCast_dvd_natCast,
      ne_eq, Int.gcd_eq_zero_iff, Nat.cast_eq_zero]
    tauto
  rw [← Finset.sum_filter, hfilter, liftDivisorSum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun a ha ↦ ?_
  have hg : (a : ℤ) ∣ ((q.1.gcd q.2 : ℤ).gcd m : ℤ) :=
    Int.natCast_dvd_natCast.mpr (Nat.dvd_of_mem_divisors ha)
  have ha0 : (a : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.pos_of_mem_divisors ha).ne'
  have h1 : q.1 / a * ((m / a : ℕ) : ℤ) = q.1 * m / (a : ℤ) ^ 2 := by
    rcases (hg.trans (Int.gcd_dvd_left _ _)).trans (Int.gcd_dvd_left _ _) with ⟨u, hu⟩
    rcases hg.trans (Int.gcd_dvd_right _ _) with ⟨w, hw⟩
    have h2 : (a : ℤ) * u * ((a : ℤ) * w) = (a : ℤ) ^ 2 * (u * w) := by
      ring1
    rw [Int.natCast_div, hu, hw, Int.mul_ediv_cancel_left _ ha0, Int.mul_ediv_cancel_left _ ha0, h2,
      Int.mul_ediv_cancel_left _ (pow_ne_zero 2 ha0)]
  rw [h1]

/-- **The Fourier expansion of the image of `φ` under the index raising operator `V_m`**: if `φ` has
the Fourier expansion `∑ c(n, r) e^{2πi(nτ + rz)}`, then, for `m ≥ 1`,
`(φ ∣ V_m)(τ, z) = ∑_{n, r} (∑_{d ∣ (n, r, m)} d^{k-1} c(nm/d², r/d)) e^{2πi(nτ + rz)}` (Eichler and
Zagier, Theorem 4.2), in every weight and whatever the index of `φ`. -/
lemma hasSum_liftDivisorSum_indexRaising (hc : HasJacobiFourierExpansion φ c) (hm : 0 < m) : HasSum
    (fun q : ℤ × ℤ ↦ liftDivisorSum k c q.1 q.2 m * jacobiFourierExp q x)
      (indexRaising k φ m x) := by
  rw [indexRaising, sum_cosetReps hm, Finset.mul_sum]
  exact (hasSum_sum fun a ha ↦ hasSum_coset_reindex x hc ha).congr_fun fun q ↦
    (sum_divisors_liftDivisorSum x hm q).symm

variable {N : ℕ} (Z : SiegelUpperHalfSpace (Fin 2)) (q : ℤ × ℤ) (n r : ℤ) (l : ℤ)

/-- The point `(τ, z) ∈ ℍ × ℂ` of `Z = (τ, z; z, ω) ∈ ℋ₂`. -/
noncomputable def toJacobiPoint : ℍ × ℂ :=
  (UpperHalfPlane.mk (Z.val 0 0) Z.posDef_im.diag_pos, Z.val 0 1)

variable (N) in
private lemma liftExp_eq_mul : liftExp N q.1 q.2 l Z = jacobiFourierExp q (toJacobiPoint Z) *
    cexp (2 * π * I * (N * l) * Z.val 1 1) := by
  rw [liftExp, jacobiFourierExp, ← Complex.exp_add]
  congr 1
  simp [toJacobiPoint]
  ring1

variable (k φ) in
/-- The `m`-th **Fourier–Jacobi coefficient** `φ_m(τ, z) = ∑_{n, r} a(n, r, m) e^{2πi(nτ + rz)}` of
the Gritsenko lift `Grit(φ)(τ, z, ω) = ∑_m φ_m(τ, z) e^{2πiNmω}` (LMFDB `mf.siegel.lift.gritsenko`),
where `a(n, r, m)` are its Fourier coefficients (`gritsenkoCoeff`). It is `φ ∣ V_m` for `m ≥ 1`,
whatever the index of `φ` (`gritsenkoFourierJacobi_eq_indexRaising`), and `0` for `m ≤ 0`. -/
noncomputable def gritsenkoFourierJacobi : ℂ :=
  ∑' q : ℤ × ℤ, gritsenkoCoeff k (jacobiCoeff φ) q.1 q.2 l * jacobiFourierExp q x

/-- The bijection `ℤ × ℤ² ≃ ℤ³`, `(m, (n, r)) ↦ (n, r, m)`. -/
private def fiberEquiv : ℤ × (ℤ × ℤ) ≃ ℤ × ℤ × ℤ :=
  (Equiv.prodComm ℤ (ℤ × ℤ)).trans (Equiv.prodAssoc ℤ ℤ ℤ)

variable {g : ℤ × ℤ × ℤ → ℂ}

private lemma tsum_mul_liftExp_eq_tsum (hs : Summable fun p : ℤ × ℤ × ℤ ↦
    g p * liftExp N p.1 p.2.1 p.2.2 Z) : ∑' p : ℤ × ℤ × ℤ, g p * liftExp N p.1 p.2.1 p.2.2 Z =
    ∑' l : ℤ, (∑' q : ℤ × ℤ, g (q.1, q.2, l) * jacobiFourierExp q (toJacobiPoint Z)) *
      cexp (2 * π * I * (N * l) * Z.val 1 1) := by
  rw [← fiberEquiv.tsum_eq]
  refine (fiberEquiv.summable_iff.mpr hs).tsum_prod.trans <| tsum_congr fun l ↦ ?_
  rw [← tsum_mul_right]
  refine tsum_congr fun q ↦ ?_
  rw [mul_assoc, ← liftExp_eq_mul]
  rfl

/-- **The Fourier–Jacobi expansion of the Gritsenko lift**: where the series of the lift converges
absolutely, `Grit(φ)(Z) = ∑_m φ_m(τ, z) e^{2πiNmω}` for `Z = (τ, z; z, ω)`. -/
lemma gritsenkoLift_eq_tsum_fourierJacobi (hs : Summable fun p : ℤ × ℤ × ℤ ↦
    gritsenkoCoeff k (jacobiCoeff φ) p.1 p.2.1 p.2.2 * liftExp N p.1 p.2.1 p.2.2 Z) :
    gritsenkoLift k N φ Z = ∑' l : ℤ, gritsenkoFourierJacobi k φ (toJacobiPoint Z) l *
      cexp (2 * π * I * (N * l) * Z.val 1 1) :=
  tsum_mul_liftExp_eq_tsum Z hs

lemma gritsenkoFourierJacobi_of_nonpos (hl : l ≤ 0) : gritsenkoFourierJacobi k φ x l = 0 := by
  rw [gritsenkoFourierJacobi]
  refine (tsum_congr fun q ↦ ?_).trans tsum_zero
  rw [gritsenkoCoeff, ite_eq_right (by omega), zero_mul]

/-- **The Fourier–Jacobi coefficients of the Gritsenko lift are the images of `φ` under the index
raising operators**: for `φ ∈ J_{k,N}` and `m ≥ 1`, `φ_m = φ ∣ V_m`. -/
lemma gritsenkoFourierJacobi_eq_indexRaising (hφ : φ ∈ jacobiFormSpace k N) (hm : 0 < m) :
    gritsenkoFourierJacobi k φ x m = indexRaising k φ m x := by
  have hm' : (0 : ℤ) < m := by exact_mod_cast hm
  rw [gritsenkoFourierJacobi]
  refine ((hasSum_liftDivisorSum_indexRaising x
    (hasJacobiFourierExpansion_jacobiCoeff_of_mem_jacobiFormSpace hφ) hm).congr_fun
      fun q ↦ ?_).tsum_eq
  rw [gritsenkoCoeff, ite_eq_left hm']

private lemma toJacobiPoint_partialInversion_smul :
    toJacobiPoint (map (Int.castRingHom ℝ) partialInversion • Z) = (S • (toJacobiPoint Z).1,
      (toJacobiPoint Z).2 / UpperHalfPlane.denom S (toJacobiPoint Z).1) := by
  refine Prod.ext (UpperHalfPlane.ext ?_) ?_
  · rw [UpperHalfPlane.modular_S_smul]
    simp [toJacobiPoint, val_partialInversion_smul]
  · rw [ModularGroup.denom_S]
    simp [toJacobiPoint, val_partialInversion_smul]

/-- **The transformation law under the partial inversion of a series in the exponentials of the
lift**: let `F(Z) = ∑ g(n, r, m) e^{2πi(nτ + rz + Nmω)}`, converging absolutely on `ℋ₂`, with
`g(n, r, m) = 0` for `m < 0`. If every `φ_m(τ, z) = ∑_{n, r} g(n, r, m) e^{2πi(nτ + rz)}` transforms
like a Jacobi form of weight `k` and index `Nm` under `(0, -1; 1, 0)`, then
`J₁ : (τ, z; z, ω) ↦ (-1/τ, z/τ; z/τ, ω - z²/τ)` satisfies `F(J₁Z) = τ^k F(Z)`: in the expansion
`F(Z) = ∑_m φ_m(τ, z) e^{2πiNmω}`, the factor `e^{2πiNmz²/τ}` cancels against the shift
`ω ↦ ω - z²/τ`. -/
lemma tsum_mul_liftExp_partialInversion_smul (hs : ∀ Z : SiegelUpperHalfSpace (Fin 2),
    Summable fun p : ℤ × ℤ × ℤ ↦ g p * liftExp N p.1 p.2.1 p.2.2 Z)
    (hg : ∀ l < 0, ∀ q : ℤ × ℤ, g (q.1, q.2, l) = 0) (hS : ∀ (m : ℕ) (x : ℍ × ℂ),
      ∑' q : ℤ × ℤ, g (q.1, q.2, m) *
          jacobiFourierExp q (S • x.1, x.2 / UpperHalfPlane.denom S x.1) =
        jacobiFactor k (N * m) x S * ∑' q : ℤ × ℤ, g (q.1, q.2, m) * jacobiFourierExp q x) :
    ∑' p : ℤ × ℤ × ℤ, g p * liftExp N p.1 p.2.1 p.2.2
        (map (Int.castRingHom ℝ) partialInversion • Z) =
      Z.val 0 0 ^ k * ∑' p : ℤ × ℤ × ℤ, g p * liftExp N p.1 p.2.1 p.2.2 Z := by
  rw [tsum_mul_liftExp_eq_tsum _ (hs _), tsum_mul_liftExp_eq_tsum _ (hs _), ← tsum_mul_left,
    toJacobiPoint_partialInversion_smul]
  refine tsum_congr fun l ↦ ?_
  rcases lt_or_ge l 0 with hl | hl
  · simp [hg l hl]
  · rcases Int.eq_ofNat_of_zero_le hl with ⟨m, rfl⟩
    rw [hS m (toJacobiPoint Z), jacobiFactor, ModularGroup.denom_S, val_partialInversion_smul]
    generalize ∑' q : ℤ × ℤ, g (q.1, q.2, (m : ℤ)) * jacobiFourierExp q (toJacobiPoint Z) = v
    have he : cexp (2 * π * I * (N * m) * Z.val 0 1 ^ 2 / Z.val 0 0) *
        cexp (2 * π * I * (N * m) * (Z.val 1 1 - Z.val 0 1 ^ 2 / Z.val 0 0)) =
          cexp (2 * π * I * (N * m) * Z.val 1 1) := by
      rw [← Complex.exp_add]
      congr 1
      ring1
    simp [toJacobiPoint]
    linear_combination (Z.val 0 0 ^ k * v) * he

variable (m) in
private lemma gritsenkoFourierJacobi_S (hN : 0 < N) (hφ : φ ∈ jacobiCuspFormSpace k N) :
    gritsenkoFourierJacobi k φ (S • x.1, x.2 / UpperHalfPlane.denom S x.1) m =
      jacobiFactor k (N * m) x S * gritsenkoFourierJacobi k φ x m := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · rw [gritsenkoFourierJacobi_of_nonpos _ _ (by simp),
      gritsenkoFourierJacobi_of_nonpos _ _ (by simp), mul_zero]
  · rw [gritsenkoFourierJacobi_eq_indexRaising _ hφ.1 hm,
      gritsenkoFourierJacobi_eq_indexRaising _ hφ.1 hm, indexRaising_S_of_index hN hφ.1.2.1 hm]

/-- **The transformation law of the Gritsenko lift under the partial inversion**
`J₁ : (τ, z; z, ω) ↦ (-1/τ, z/τ; z/τ, ω - z²/τ)`: `F(J₁Z) = τ^k F(Z)`. In the Fourier–Jacobi
expansion `F(Z) = ∑_m (φ ∣ V_m)(τ, z) e^{2πiNmω}`, the function `φ ∣ V_m` transforms like a Jacobi
form of weight `k` and index `Nm` under `(0, -1; 1, 0)`, and the factor `e^{2πiNmz²/τ}` cancels
against the shift `ω ↦ ω - z²/τ`. -/
lemma gritsenkoLift_partialInversion_smul (hN : 0 < N) (hφ : φ ∈ jacobiCuspFormSpace k N) :
    gritsenkoLift k N φ (map (Int.castRingHom ℝ) partialInversion • Z) = Z.val 0 0 ^ k *
      gritsenkoLift k N φ Z :=
  tsum_mul_liftExp_partialInversion_smul Z (fun Z ↦ summable_gritsenkoLift Z hN hφ)
    (fun _ hl _ ↦ ite_eq_right hl.not_gt) fun m x ↦ gritsenkoFourierJacobi_S m x hN hφ

variable (L : ℕ+)

private lemma posDef_im_swap :
    ((!![(L : ℂ) * Z.val 1 1, Z.val 0 1; Z.val 0 1, Z.val 0 0 / L] : Matrix (Fin 2) (Fin 2) ℂ).map
      im).PosDef := by
  have hL : (0 : ℝ) < L := by exact_mod_cast L.pos
  rw [posDef_iff_dotProduct_mulVec]
  refine ⟨?_, fun x hx ↦ ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;> simp
  have hx' : ![x 1, (L : ℝ) * x 0] ≠ 0 := fun h ↦ hx <| by
    have h₀ : x 1 = 0 := by simpa using congrFun h 0
    have h₁ : (L : ℝ) * x 0 = 0 := by simpa using congrFun h 1
    funext i
    fin_cases i
    · simpa using h₁
    · exact h₀
  have h : 0 < star ![x 1, (L : ℝ) * x 0] ⬝ᵥ Z.val.map im *ᵥ ![x 1, (L : ℝ) * x 0] :=
    (posDef_iff_dotProduct_mulVec.mp Z.posDef_im).2 hx'
  simp only [dotProduct, mulVec, Fin.sum_univ_two, map_apply, val_one_zero] at h
  simp [mulVec]
  refine pos_of_mul_pos_right ?_ hL.le
  convert h using 1
  simp
  field_simp
  ring1

/-- The involution `V_N : (τ, z, ω) ↦ (Nω, z, τ/N)` of the Siegel upper half-space `ℋ₂`. It is the
action of `(0, √N; 1/√N, 0)`, an element of `GL(2, ℝ)`, by `Z ↦ AZAᵀ`; so it normalises the
paramodular group `K(N)` of level `N` without lying in `Sp(4, ℚ)` unless `N` is a square. -/
noncomputable def paramodularSwap : SiegelUpperHalfSpace (Fin 2) where
  val := !![(L : ℂ) * Z.val 1 1, Z.val 0 1; Z.val 0 1, Z.val 0 0 / L]
  transpose_val := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  posDef_im := posDef_im_swap Z L

private lemma liftExp_paramodularSwap :
    liftExp L n r l (paramodularSwap Z L) = liftExp L l r n Z := by
  have hL : (L : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr L.ne_zero
  rw [liftExp, liftExp]
  congr 1
  simp [paramodularSwap]
  field_simp
  ring1

private lemma gritsenkoCoeff_symm (hφ : φ ∈ jacobiCuspFormSpace k N) :
    gritsenkoCoeff k (jacobiCoeff φ) n r l = gritsenkoCoeff k (jacobiCoeff φ) l r n := by
  by_cases h : 0 < n ∧ 0 < l
  · exact gritsenkoCoeff_comm k (jacobiCoeff φ) n r l h.1 h.2
  · rw [gritsenkoCoeff_eq_zero n r l hφ (fun h' ↦ h ⟨h'.1, h'.2.1⟩),
      gritsenkoCoeff_eq_zero l r n hφ (fun h' ↦ h ⟨h'.2.1, h'.1⟩)]

/-- **The Gritsenko lift is invariant under the involution `V_N`**: `F(Nω, z, τ/N) = F(τ, z, ω)`, as
its Fourier coefficients are symmetric, `a(n, r, m) = a(m, r, n)`. -/
lemma gritsenkoLift_paramodularSwap (hφ : φ ∈ jacobiCuspFormSpace k L) :
    gritsenkoLift k L φ (paramodularSwap Z L) = gritsenkoLift k L φ Z := by
  rw [gritsenkoLift, gritsenkoLift]
  refine Eq.trans ?_ (swapIndex.tsum_eq _)
  refine tsum_congr fun p ↦ ?_
  rw [liftExp_paramodularSwap, gritsenkoCoeff_symm _ _ _ hφ]
  rfl

variable (u b d : ℤ)

lemma val_paramodularTranslation_smul :
    (map (algebraMap ℚ ℝ) (paramodularTranslation L u b d) • Z).val = Z.val +
      !![(u : ℂ), b; b, (d : ℂ) / L] := by
  rw [val_smul]
  simp [num, denom, paramodularTranslation, fromBlocks_map]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

private lemma liftExp_paramodularTranslation :
    liftExp L n r l (map (algebraMap ℚ ℝ) (paramodularTranslation L u b d) • Z) =
      liftExp L n r l Z := by
  have hL : (L : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr L.ne_zero
  have h : 2 * π * I * (n * (Z.val 0 0 + u) + r * (Z.val 0 1 + b) +
      L * l * (Z.val 1 1 + (d : ℂ) / L)) =
        2 * π * I * (n * Z.val 0 0 + r * Z.val 0 1 + L * l * Z.val 1 1) +
          ((n * u + r * b + l * d : ℤ) : ℂ) * (2 * π * I) := by
    push_cast
    field_simp
    ring1
  rw [liftExp, liftExp, val_paramodularTranslation_smul]
  simp only [Matrix.add_apply, of_apply, cons_val_zero, cons_val_one]
  rw [h, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

lemma denom_paramodularTranslation :
    denom (map (algebraMap ℚ ℝ) (paramodularTranslation L u b d)) Z.val = 1 := by
  simp [denom, paramodularTranslation, fromBlocks_map]

/-- **The Gritsenko lift is invariant under the translations** `Z ↦ Z + (a, b; b, d/N)` of `K(N)`,
for every `φ`, as all the exponentials `e^{2πi(nτ + rz + Nmω)}` are. -/
lemma gritsenkoLift_paramodularTranslation_smul :
    gritsenkoLift k L φ (map (algebraMap ℚ ℝ) (paramodularTranslation L u b d) • Z) =
      gritsenkoLift k L φ Z :=
  tsum_congr fun p ↦ by
    rw [liftExp_paramodularTranslation]

private lemma denom_paramodularInversion :
    denom (map (algebraMap ℚ ℝ) (paramodularInversion L)) Z.val =
      !![1, 0; (L : ℂ) * Z.val 0 1, (L : ℂ) * Z.val 1 1] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [denom, paramodularInversion, embedSecond, coe_scaleSL2, Matrix.mul_apply, val_one_zero,
      toBlocks₂₁, toBlocks₂₂]

lemma det_denom_paramodularInversion :
    (denom (map (algebraMap ℚ ℝ) (paramodularInversion L)) Z.val).det = (L : ℂ) * Z.val 1 1 := by
  rw [denom_paramodularInversion, det_fin_two_of]
  ring1

private lemma val_one_one_ne_zero : Z.val 1 1 ≠ 0 := by
  intro h
  simpa [h] using Z.posDef_im.diag_pos (i := 1)

private lemma val_paramodularInversion_smul :
    (map (algebraMap ℚ ℝ) (paramodularInversion L) • Z).val =
      (paramodularSwap (map (Int.castRingHom ℝ) partialInversion • paramodularSwap Z L) L).val := by
  have hL : (L : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr L.ne_zero
  have hω : Z.val 1 1 ≠ 0 := val_one_one_ne_zero Z
  have hinv : (!![1, 0; (L : ℂ) * Z.val 0 1, (L : ℂ) * Z.val 1 1])⁻¹ =
      !![1, 0; -(Z.val 0 1 / Z.val 1 1), ((L : ℂ) * Z.val 1 1)⁻¹] := by
    refine inv_eq_right_inv ?_
    ext i j
    fin_cases i <;> fin_cases j <;> simp
    · field_simp
      ring1
    · field_simp
  have hnum : num (map (algebraMap ℚ ℝ) (paramodularInversion L)) Z.val =
      !![Z.val 0 0, Z.val 0 1; 0, -1 / (L : ℂ)] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [num, paramodularInversion, embedSecond, coe_scaleSL2, Matrix.mul_apply, toBlocks₁₁,
        toBlocks₁₂]
  have hs (W : SiegelUpperHalfSpace (Fin 2)) :
      (paramodularSwap W L).val = !![(L : ℂ) * W.val 1 1, W.val 0 1; W.val 0 1, W.val 0 0 / L] :=
    rfl
  rw [val_smul, hnum, denom_paramodularInversion, hinv, hs, val_partialInversion_smul, hs]
  ext i j
  fin_cases i <;> fin_cases j <;> simp <;> field_simp
  ring1

/-- **The transformation law of the Gritsenko lift under `J₂`**:
`F(τ - z²/ω, z/(Nω), -1/(N²ω)) = (Nω)^k F(τ, z, ω)`, as `J₂ = V_N J₁ V_N` and `F ∘ V_N = F`. -/
lemma gritsenkoLift_paramodularInversion_smul (hφ : φ ∈ jacobiCuspFormSpace k L) :
    gritsenkoLift k L φ (map (algebraMap ℚ ℝ) (paramodularInversion L) • Z) =
      ((L : ℂ) * Z.val 1 1) ^ k * gritsenkoLift k L φ Z := by
  have h : map (algebraMap ℚ ℝ) (paramodularInversion L) • Z =
      paramodularSwap (map (Int.castRingHom ℝ) partialInversion • paramodularSwap Z L) L :=
    SiegelUpperHalfSpace.ext (val_paramodularInversion_smul Z L)
  rw [h, gritsenkoLift_paramodularSwap _ _ hφ, gritsenkoLift_partialInversion_smul _ L.pos hφ,
    gritsenkoLift_paramodularSwap _ _ hφ]
  rfl

/-- The **stabiliser** of a function `f : ℋ_g → V` in `Sp(2g, ℚ)`: the elements `γ` with
`f ∣_ρ γ = f`, so that `f` is invariant under a subgroup of `Sp(2g, ℚ)` as soon as it is invariant
under generators of it. -/
noncomputable abbrev slashStabilizerRat {ι : Type*} [Fintype ι] [DecidableEq ι] {V : Type*}
    [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ (GL ι ℂ) V)
    (f : SiegelUpperHalfSpace ι → V) : Subgroup (symplecticGroup ι ℚ) :=
  slashCharStabilizerOf ρ f (algebraMap ℚ ℝ) ⊤ 1

private lemma mem_slashStabilizerRat_of {F : SiegelUpperHalfSpace (Fin 2) → ℂ}
    {γ : symplecticGroup (Fin 2) ℚ} (h : ∀ Z, F (map (algebraMap ℚ ℝ) γ • Z) =
      (denom (map (algebraMap ℚ ℝ) γ) Z.val).det ^ k * F Z) :
    γ ∈ slashStabilizerRat (TauCeti.detPowerRep ℂ 2 k) F :=
  ⟨trivial, (slash_eq_smul_iff (TauCeti.detPowerRep ℂ 2 k) F (map (algebraMap ℚ ℝ) γ) _).mpr
    fun Z ↦ by simp [h]⟩

/-- **Gritsenko's theorem, without the cusp condition** (LMFDB `mf.siegel.lift.gritsenko`): the
Gritsenko lift of a Jacobi cusp form `φ ∈ J_{k,N}^cusp`, `N ≥ 1`, is a paramodular form of weight
`k` and level `N`: `Grit(φ) ∈ M_k(K(N))`. It is holomorphic, and it transforms correctly under the
translations `Z ↦ Z + (a, b; b, d/N)`, the partial inversion `J₁` and its conjugate `J₂`, which
generate `K(N)`. -/
lemma gritsenkoLift_mem_modularForms (hφ : φ ∈ jacobiCuspFormSpace k L) :
    gritsenkoLift k L φ ∈ modularForms (TauCeti.detPowerRep ℂ 2 k) (paramodularLevel L) 1 := by
  have hle : paramodularLevel L ≤
      slashStabilizerRat (TauCeti.detPowerRep ℂ 2 k) (gritsenkoLift k L φ) := by
    rw [← closure_paramodularGenerators, Subgroup.closure_le]
    refine Set.insert_subset ?_ <| Set.insert_subset ?_ ?_
    · refine mem_slashStabilizerRat_of fun Z ↦ ?_
      rw [map_algebraMap_map_intCast, det_denom_partialInversion,
        gritsenkoLift_partialInversion_smul _ L.pos hφ]
    · refine mem_slashStabilizerRat_of fun Z ↦ ?_
      rw [det_denom_paramodularInversion, gritsenkoLift_paramodularInversion_smul _ _ hφ]
    · rintro _ ⟨x, rfl⟩
      refine mem_slashStabilizerRat_of fun Z ↦ ?_
      rw [denom_paramodularTranslation, gritsenkoLift_paramodularTranslation_smul]
      simp
  refine (mem_modularForms_iff_slash _ _ _ _).mpr
    ⟨isHolomorphic_gritsenkoLift L.pos hφ, fun γ ↦ ?_⟩
  rcases hle γ.2 with ⟨_, h⟩
  simpa using h

end SiegelUpperHalfSpace
