import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.GritsenkoLift

/-!
# Transformation of the Maass lift under translations and the swap

The Maass lift `(Vφ)(Z) = ∑ a(n, r, m) e^{2πi(nτ + rz + mω)}` of a Jacobi form `φ ∈ J_{k,1}`
(`SiegelUpperHalfSpace.maassLift`, LMFDB `mf.siegel.lift.maass`) is a Siegel modular form of weight
`k` on `Sp(4, ℤ)` (Maass; Eichler and Zagier, Theorem 6.2), which is generated by the translations
`Z ↦ Z + S`, `S` integral symmetric, the swap `(τ, z; z, ω) ↦ (ω, z; z, τ)` and the embedded Jacobi
group. This file proves the transformation law `F(γZ) = det(cZ + d)^k F(Z)` of the Maass lift, as a
sum of series, for the first two kinds of generators: for the translations it holds for every `φ`,
the exponentials being periodic, and for the swap, whose automorphy factor has determinant `-1`, it
holds in even weight `k`, the coefficients `a(n, r, m)` being symmetric in `n` and `m`, and for all
Jacobi forms of index `1`, as there are none of odd weight. The invariance under the Jacobi group,
which needs the index raising operators `V_m` of Eichler and Zagier, the convergence of the series
and the generation of `Sp(4, ℤ)` are not proved here.

## Main definitions

* `SiegelUpperHalfSpace.swapMatrix`: the matrix `U = (0, 1; 1, 0)`.
* `SiegelUpperHalfSpace.swapSp`: the element `(U, 0; 0, U)` of `Sp(4, ℤ)`.
* `SiegelUpperHalfSpace.translationMatrix`: the integral symmetric matrix `S = (a, b; b, d)`.
* `SiegelUpperHalfSpace.translationSp`: the element `(1, S; 0, 1)` of `Sp(4, ℤ)`.

## Main results

* `ModularForm.eq_zero_of_mem_jacobiFormSpace_one_of_odd`: there are no Jacobi forms of odd weight
  and index `1`.
* `SiegelUpperHalfSpace.maassLift_translationSp_eq_det_zpow_mul`: the transformation law of the
  Maass lift under the translations.
* `SiegelUpperHalfSpace.maassLift_swapSp_eq_det_zpow_mul`: the transformation law of the Maass
  lift of even weight under the swap.
* `SiegelUpperHalfSpace.maassLift_swapSp_eq_det_zpow_mul_of_mem_jacobiFormSpace`: the
  transformation law of the Maass lift of a Jacobi form of index `1` under the swap.
-/

open Matrix hiding one_zpow

open Complex ModularForm

open scoped UpperHalfPlane

namespace ModularForm

variable {k : ℤ} {φ : ℍ × ℂ → ℂ} (n r : ℤ)

lemma apply_neg_of_mem_jacobiFormSpace (hφ : φ ∈ jacobiFormSpace k 1) (τ : ℍ) (z : ℂ) :
    φ (τ, -z) = (-1) ^ k * φ (τ, z) := by
  have hd : UpperHalfPlane.denom (SpecialLinearGroup.toGL (-1)) τ = -1 := by
    simp [UpperHalfPlane.denom]
  simpa [jacobiFactor, hd, div_neg] using hφ.2.1 (-1) (τ, z)

/-- The reflection `(n, r) ↦ (n, -r)` of `ℤ²`. -/
private def negIndex : ℤ × ℤ ≃ ℤ × ℤ where
  toFun p := (p.1, -p.2)
  invFun p := (p.1, -p.2)
  left_inv p := by simp
  right_inv p := by simp

lemma jacobiCoeff_neg_of_mem_jacobiFormSpace (hφ : φ ∈ jacobiFormSpace k 1) :
    jacobiCoeff φ (n, -r) = (-1) ^ k * jacobiCoeff φ (n, r) := by
  have hc : HasJacobiFourierExpansion φ (jacobiCoeff φ) :=
    hasJacobiFourierExpansion_jacobiCoeff_of_mem_jacobiFormSpace hφ
  have h₁ : HasJacobiFourierExpansion (fun x ↦ φ (x.1, -x.2)) (jacobiCoeff φ ∘ negIndex) :=
    fun x ↦ negIndex.hasSum_iff.mp <| (hc (x.1, -x.2)).congr_fun fun p ↦ by
      simp [negIndex, jacobiFourierExp]
  have h₂ : HasJacobiFourierExpansion (fun x ↦ φ (x.1, -x.2)) ((-1 : ℂ) ^ k • jacobiCoeff φ) :=
    fun x ↦ by
      simpa [apply_neg_of_mem_jacobiFormSpace hφ, mul_assoc] using
        (hc x).mul_left ((-1 : ℂ) ^ k)
  simpa [negIndex] using congrFun (h₁.unique h₂) (n, r)

lemma jacobiCoeff_eq_zero_of_odd (hφ : φ ∈ jacobiFormSpace k 1) (hk : Odd k) :
    jacobiCoeff φ = 0 := by
  funext p
  have h : jacobiCoeff φ (p.1, -p.2) = jacobiCoeff φ (p.1, p.2) :=
    jacobiCoeff_eq_of_mem_jacobiFormSpace_one hφ <| by ring1
  rw [jacobiCoeff_neg_of_mem_jacobiFormSpace p.1 p.2 hφ, hk.neg_one_zpow, neg_one_mul,
    CharZero.neg_eq_self_iff] at h
  exact h

/-- **There are no Jacobi forms of odd weight and index `1`** (Eichler and Zagier): `-1 ∈ SL(2, ℤ)`
gives `φ(τ, -z) = (-1)^k φ(τ, z)`, so `c(n, -r) = (-1)^k c(n, r)`, while `c(n, r)` only depends on
`4n - r²` in index `1`. -/
lemma eq_zero_of_mem_jacobiFormSpace_one_of_odd (hφ : φ ∈ jacobiFormSpace k 1) (hk : Odd k) :
    φ = 0 :=
  funext fun x ↦ (hasJacobiFourierExpansion_jacobiCoeff_of_mem_jacobiFormSpace hφ x).unique <| by
    simp [jacobiCoeff_eq_zero_of_odd hφ hk]

end ModularForm

namespace SiegelUpperHalfSpace

variable (k : ℤ) (c : ℤ × ℤ → ℂ) (n r m : ℤ)

lemma liftDivisorSum_comm : liftDivisorSum k c n r m = liftDivisorSum k c m r n := by
  have h : (n.gcd r : ℤ).gcd m = (m.gcd r : ℤ).gcd n := by
    rw [Int.gcd_assoc, Int.gcd_comm, Int.gcd_comm r]
  rw [liftDivisorSum, liftDivisorSum, h, mul_comm n]

lemma maassCoeff_comm : maassCoeff k c n r m = maassCoeff k c m r n := by
  rw [maassCoeff, maassCoeff, liftDivisorSum_comm]
  split_ifs <;> first | rfl | omega

/-- The matrix `U = (0, 1; 1, 0)`. -/
def swapMatrix : Matrix (Fin 2) (Fin 2) ℚ :=
  !![0, 1; 1, 0]

lemma swapMatrix_mul_swapMatrix : swapMatrix * swapMatrix = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [swapMatrix]

lemma transpose_swapMatrix : swapMatrixᵀ = swapMatrix := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

/-- The symplectic matrix `(U, 0; 0, U)` of `Sp(4, ℤ)`, acting on `ℋ₂` by
`(τ, z; z, ω) ↦ (ω, z; z, τ)`. -/
def swapSp : symplecticGroup (Fin 2) ℚ :=
  ⟨fromBlocks swapMatrix 0 0 swapMatrix, by
    rw [SymplecticGroup.mem_iff', fromBlocks_transpose]
    simp [J, fromBlocks_multiply, transpose_swapMatrix, swapMatrix_mul_swapMatrix]⟩

variable (Z : SiegelUpperHalfSpace (Fin 2)) (M : Matrix (Fin 2) (Fin 2) ℂ) (φ : ℍ × ℂ → ℂ)

lemma num_swapSp :
    num (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp) M = swapMatrix.map (↑) * M := by
  simp [num, swapSp, fromBlocks_map, Function.comp_def]

lemma denom_swapSp :
    denom (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp) M = swapMatrix.map (↑) := by
  simp [denom, swapSp, fromBlocks_map, Function.comp_def]

lemma val_swapSp_smul : (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp • Z).val =
    swapMatrix.map (↑) * Z.val * swapMatrix.map (↑) := by
  have h : (swapMatrix.map ((↑) : ℚ → ℂ))⁻¹ = swapMatrix.map (↑) :=
    inv_eq_left_inv <| by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [swapMatrix, Matrix.mul_apply]
  rw [val_smul, num_swapSp, denom_swapSp, h]

lemma liftExp_swapSp :
    liftExp 1 n r m (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp • Z) = liftExp 1 m r n Z := by
  have h10 : Z.val 1 0 = Z.val 0 1 :=
    congrFun (congrFun Z.transpose_val 0) 1
  rw [liftExp, liftExp, val_swapSp_smul]
  simp [Matrix.mul_apply, swapMatrix, h10]
  congr 1
  ring1

/-- The involution `(n, r, m) ↦ (m, r, n)` of `ℤ³`. -/
private def swapIndex : ℤ × ℤ × ℤ ≃ ℤ × ℤ × ℤ where
  toFun p := (p.2.2, p.2.1, p.1)
  invFun p := (p.2.2, p.2.1, p.1)
  left_inv _ := rfl
  right_inv _ := rfl

lemma maassLift_swapSp :
    maassLift k φ (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp • Z) = maassLift k φ Z := by
  rw [maassLift, maassLift]
  refine Eq.trans ?_ (swapIndex.tsum_eq _)
  refine tsum_congr fun p ↦ ?_
  rw [liftExp_swapSp, maassCoeff_comm]
  rfl

variable (a b d : ℤ)

/-- The integral symmetric matrix `S = (a, b; b, d)`. -/
def translationMatrix : Matrix (Fin 2) (Fin 2) ℚ :=
  !![(a : ℚ), b; b, d]

lemma transpose_translationMatrix : (translationMatrix a b d)ᵀ = translationMatrix a b d := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

/-- The translation `(1, S; 0, 1)` of `Sp(4, ℤ)` by the integral symmetric matrix
`S = (a, b; b, d)`, acting on `ℋ₂` by `Z ↦ Z + S`. -/
def translationSp : symplecticGroup (Fin 2) ℚ :=
  ⟨fromBlocks 1 (translationMatrix a b d) 0 1, by
    rw [SymplecticGroup.mem_iff', fromBlocks_transpose, transpose_translationMatrix]
    simp [J, fromBlocks_multiply]⟩

lemma val_translationSp_smul :
    (SymplecticGroup.map (algebraMap ℚ ℝ) (translationSp a b d) • Z).val =
      Z.val + (translationMatrix a b d).map (↑) := by
  rw [val_smul]
  simp [num, denom, translationSp, fromBlocks_map, Function.comp_def]

lemma liftExp_translationSp :
    liftExp 1 n r m (SymplecticGroup.map (algebraMap ℚ ℝ) (translationSp a b d) • Z) =
      liftExp 1 n r m Z := by
  rw [liftExp, liftExp, val_translationSp_smul]
  simp [translationMatrix]
  have h : 2 * Real.pi * I * (n * (Z.val 0 0 + a) + r * (Z.val 0 1 + b) + m * (Z.val 1 1 + d)) =
      2 * Real.pi * I * (n * Z.val 0 0 + r * Z.val 0 1 + m * Z.val 1 1) +
        ((n * a + r * b + m * d : ℤ) : ℂ) * (2 * Real.pi * I) := by
    push_cast
    ring1
  rw [h, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

lemma denom_translationSp :
    denom (SymplecticGroup.map (algebraMap ℚ ℝ) (translationSp a b d)) M = 1 := by
  simp [denom, translationSp, fromBlocks_map]

lemma det_denom_swapSp : (denom (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp) M).det = -1 := by
  rw [denom_swapSp]
  simp [swapMatrix, det_fin_two]

lemma maassLift_translationSp :
    maassLift k φ (SymplecticGroup.map (algebraMap ℚ ℝ) (translationSp a b d) • Z) =
      maassLift k φ Z :=
  tsum_congr fun p ↦ by
    rw [liftExp_translationSp]

/-- **The Maass lift transforms like a Siegel modular form of weight `k` under the translations**
`Z ↦ Z + S` of `Sp(4, ℤ)`, `S` integral symmetric: `F(Z + S) = det(0 Z + 1)^k F(Z)`, for every
function `φ`, as all the exponentials `e^{2πi(nτ + rz + mω)}` with integral `n, r, m` are. -/
lemma maassLift_translationSp_eq_det_zpow_mul :
    maassLift k φ (SymplecticGroup.map (algebraMap ℚ ℝ) (translationSp a b d) • Z) =
      (denom (SymplecticGroup.map (algebraMap ℚ ℝ) (translationSp a b d)) Z.val).det ^ k *
        maassLift k φ Z := by
  rw [denom_translationSp, det_one, one_zpow, one_mul, maassLift_translationSp]

/-- **The Maass lift of even weight `k` transforms like a Siegel modular form of weight `k` under
the swap** `(τ, z; z, ω) ↦ (ω, z; z, τ)` of `Sp(4, ℤ)`, whose automorphy factor
`(0, 1; 1, 0)` has determinant `-1`: its Fourier coefficients `a(n, r, m)` are symmetric in `n`
and `m`. -/
lemma maassLift_swapSp_eq_det_zpow_mul (hk : Even k) :
    maassLift k φ (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp • Z) =
      (denom (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp) Z.val).det ^ k * maassLift k φ Z := by
  rw [det_denom_swapSp, hk.neg_one_zpow, one_mul, maassLift_swapSp]

variable {k φ}

lemma maassLift_eq_zero_of_odd (hφ : φ ∈ jacobiFormSpace k 1) (hk : Odd k) : maassLift k φ = 0 := by
  funext Z
  rw [maassLift, jacobiCoeff_eq_zero_of_odd hφ hk]
  simp [maassCoeff, liftDivisorSum]

/-- **The Maass lift of a Jacobi form of index `1` transforms like a Siegel modular form of weight
`k` under the swap** `(τ, z; z, ω) ↦ (ω, z; z, τ)` of `Sp(4, ℤ)`: in even weight by the symmetry of
its coefficients, and in odd weight because there are no Jacobi forms of odd weight and index
`1`. -/
lemma maassLift_swapSp_eq_det_zpow_mul_of_mem_jacobiFormSpace (hφ : φ ∈ jacobiFormSpace k 1) :
    maassLift k φ (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp • Z) =
      (denom (SymplecticGroup.map (algebraMap ℚ ℝ) swapSp) Z.val).det ^ k * maassLift k φ Z := by
  rcases Int.even_or_odd k with hk | hk
  · exact maassLift_swapSp_eq_det_zpow_mul k Z φ hk
  · rw [maassLift_eq_zero_of_odd hφ hk, Pi.zero_apply, Pi.zero_apply, mul_zero]

end SiegelUpperHalfSpace
