import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.CoefficientField
import LeanBridge.ForMathlib.NumberTheory.NumberField.Polredabs

/-!
# Defining polynomials of coefficient fields of Siegel modular forms

The LMFDB records, for a Siegel modular form, a defining polynomial `p ∈ ℚ[X]` of its coefficient
field `K`: `K ≅ ℚ[X] / (p)`, generated by a root of `p`
(`SiegelUpperHalfSpace.IsDefiningPolynomial` for scalar-valued forms). This file adds the
vector-valued analogue, relative to a basis of `V`, and the defining polynomials of the Hecke field
of an eigenform, and shows that the notion is the right one: a subfield of `ℂ` has a nonzero
defining polynomial exactly when it is a number field, and then every defining polynomial of the
number field in the sense of the LMFDB knowl `nf.polredabs` (`NumberField.IsDefiningPolynomial`) is
one. Which defining polynomial the LMFDB records is a database choice.

That the coefficient field of a Siegel Hecke eigenform is a number field, which the knowl asserts,
is a deep theorem (the algebraicity of the Fourier coefficients of suitably normalised eigenforms)
which is not proved here; the results below reduce the existence of a defining polynomial to it.

## Main definitions

* `SiegelUpperHalfSpace.IsVectorDefiningPolynomial` (LMFDB `mf.siegel.defining_polynomial`): a
  defining polynomial of the coefficient field of a vector-valued form.
* `SiegelUpperHalfSpace.IsHeckeDefiningPolynomial` (LMFDB `mf.siegel.defining_polynomial`): a
  defining polynomial of the Hecke field of a Hecke eigenform.

## Main results

* `IsAdjoinRoot.numberField`: a field generated over `ℚ` by a root of a nonzero polynomial is a
  number field.
* `NumberField.IsDefiningPolynomial.nonempty_isAdjoinRoot`: a defining polynomial of a number field
  in the sense of `nf.polredabs` generates it.
* `SiegelUpperHalfSpace.isVectorDefiningPolynomial_singleton_iff`: for `V = ℂ` with its standard
  basis, the vector-valued notion is the scalar-valued one.
* `SiegelUpperHalfSpace.IsVectorDefiningPolynomial.numberField` and
  `SiegelUpperHalfSpace.isVectorDefiningPolynomial_map`: the coefficient field has a nonzero
  defining polynomial exactly when it is a number field, and then every defining polynomial of the
  number field in the sense of `nf.polredabs` is one.
-/

open Matrix Module Polynomial

/-- **A field generated over `ℚ` by a root of a nonzero polynomial is a number field**: it is
`ℚ[X] / (p)`, of dimension `deg p` over `ℚ`. -/
lemma IsAdjoinRoot.numberField {K : Type*} [Field K] [CharZero K] {p : ℚ[X]}
    (h : IsAdjoinRoot K p) (hp : p ≠ 0) : NumberField K :=
  have : FiniteDimensional ℚ K :=
    (AdjoinRoot.powerBasis hp).finite.equiv h.adjoinRootAlgEquiv.toLinearEquiv
  ⟨⟩

namespace NumberField.IsDefiningPolynomial

/-- **A defining polynomial of a number field generates it**: if `P ∈ ℤ[X]` is a defining
polynomial of `K` in the sense of `nf.polredabs` (`K ≅ ℚ[X] / (P)`), then `K` is generated over `ℚ`
by a root of `P`. -/
lemma nonempty_isAdjoinRoot {K : Type*} [Field K] [NumberField K] {P : ℤ[X]}
    (h : IsDefiningPolynomial K P) : Nonempty (IsAdjoinRoot K (P.map (Int.castRingHom ℚ))) :=
  h.2.elim fun e ↦ ⟨IsAdjoinRoot.ofAdjoinRootEquiv e⟩

end NumberField.IsDefiningPolynomial

namespace SiegelUpperHalfSpace

variable {l : Type*} [Fintype l] [DecidableEq l] (Γ : Subgroup (symplecticGroup l ℚ)) {V ι : Type*}
    [AddCommGroup V] [Module ℂ V] (b : Basis ι ℂ V) (f : SiegelUpperHalfSpace l → V) {p : ℚ[X]}
    {n : ℕ} [NeZero n] {W : Type*} [AddCommGroup W] [Module ℂ W]
    (ρ : Representation ℂ (GL (Fin n) ℂ) W) {Δ : Submonoid (GL (Fin n ⊕ Fin n) ℚ)}
    [Fact (Δ ≤ gspPlusGL (Fin n))] {Γ' : Subgroup (GL (Fin n ⊕ Fin n) ℚ)} [IsHeckeTriple Δ Γ' Γ']
    (F : slashInvariantsOf ρ Δ Γ')

variable (p) in
/-- The polynomial `p ∈ ℚ[X]` is a **defining polynomial** (LMFDB `mf.siegel.defining_polynomial`)
of the coefficient field `K` of a vector-valued form `f : ℋ_g → V` on `Γ`, relative to a basis `b`
of `V` (`SiegelUpperHalfSpace.vectorCoefficientField`): `K` is generated over `ℚ` by a root of
`p`, with `K ≅ ℚ[X]/(p)`. For `V = ℂ` with its standard basis this is
`SiegelUpperHalfSpace.IsDefiningPolynomial` (`isVectorDefiningPolynomial_singleton_iff`). Which
defining polynomial the LMFDB records is a database choice. -/
def IsVectorDefiningPolynomial : Prop :=
  Nonempty (IsAdjoinRoot (vectorCoefficientField Γ b f) p)

/-- **For scalar-valued forms, defining polynomials of the coefficient field** relative to the
standard basis of `ℂ` are those of `SiegelUpperHalfSpace.IsDefiningPolynomial`. -/
lemma isVectorDefiningPolynomial_singleton_iff (G : SiegelUpperHalfSpace l → ℂ) :
    IsVectorDefiningPolynomial Γ (Basis.singleton Unit ℂ) G p ↔ IsDefiningPolynomial Γ G p :=
  (congrArg (fun K : Subfield ℂ ↦ Nonempty (IsAdjoinRoot K p)) <| congrArg Subfield.closure <|
    vectorFourierCoeffs_singleton Γ G).to_iff

variable (p) in
/-- The polynomial `p ∈ ℚ[X]` is a **defining polynomial** (LMFDB `mf.siegel.defining_polynomial`)
of the Hecke field `ℚ(λ_F(T))` of a Hecke eigenform `F` (`SiegelUpperHalfSpace.heckeField`), the
field the LMFDB calls the coefficient field of an eigenform: it is generated over `ℚ` by a root of
`p`. -/
def IsHeckeDefiningPolynomial : Prop :=
  Nonempty (IsAdjoinRoot (heckeField ρ F) p)

variable {Γ b f}

/-- **A coefficient field with a nonzero defining polynomial is a number field.** -/
lemma IsVectorDefiningPolynomial.numberField (h : IsVectorDefiningPolynomial Γ b f p)
    (hp : p ≠ 0) : NumberField (vectorCoefficientField Γ b f) :=
  h.elim fun h ↦ h.numberField hp

/-- **A coefficient field that is a number field has defining polynomials**: every defining
polynomial `P ∈ ℤ[X]` of the number field in the sense of `nf.polredabs` (monic, with
`K ≅ ℚ[X] / (P)`) is one, such as its reduced defining polynomial `NumberField.polredabs`. -/
lemma isVectorDefiningPolynomial_map [NumberField (vectorCoefficientField Γ b f)] {P : ℤ[X]}
    (hP : NumberField.IsDefiningPolynomial (vectorCoefficientField Γ b f) P) :
    IsVectorDefiningPolynomial Γ b f (P.map (Int.castRingHom ℚ)) :=
  hP.nonempty_isAdjoinRoot

end SiegelUpperHalfSpace
