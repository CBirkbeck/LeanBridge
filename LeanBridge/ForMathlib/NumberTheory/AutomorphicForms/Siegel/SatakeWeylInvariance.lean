import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.SatakeLongRoot

/-!
# The Weyl invariance of the Satake map of `Sp(2g, ℤ)`

The universal Satake map `Ω : 𝓗_p → L_g` of the local Hecke algebra of `Sp(2g, ℤ)` at a prime `p`
takes its values in the invariants `L_g^{W_g}` of the Weyl group of signed permutations
(`SiegelUpperHalfSpace.satakeMapUniv_mem_weylInvariants`), the first half of Satake's theorem. The
permutations are generated by the transpositions of consecutive coordinates, under which `Ω` is
invariant by `SiegelUpperHalfSpace.domCongr_weylPerm_swap_satakeMapUniv`, and the sign change at
`j` is the conjugate of the sign change at the last coordinate, under which `Ω` is invariant by
`SiegelUpperHalfSpace.domCongr_weylSign_last_satakeMapUniv`, by the transposition of `j` and
`g - 1`.

Evaluated at a point, this says that the Satake map `ω_α` (`SiegelUpperHalfSpace.satakeMap`) only
depends on the orbit of `α` under the Weyl group: `ω_{α ∘ σ} = ω_α`
(`SiegelUpperHalfSpace.satakeMap_comp_perm`) and `ω_{(α₀ α_j; …, α_j⁻¹, …)} = ω_α`
(`SiegelUpperHalfSpace.satakeMap_update_inv`).

## Main results

* `SiegelUpperHalfSpace.satakeMapUniv_mem_weylInvariants`: `Ω` takes values in `L_g^{W_g}`.
* `SiegelUpperHalfSpace.satakeMap_comp_perm`, `SiegelUpperHalfSpace.satakeMap_update_inv`: the
  Satake map is invariant under the Weyl group.
-/

open Equiv MonoidAlgebra

open HeckeCosetModule (single)

namespace SiegelUpperHalfSpace

variable {n : ℕ} (f : SatakeLaurent n)

lemma domCongr_weylPerm_one : domCongr ℂ ℂ (weylPerm (1 : Equiv.Perm (Fin n))) f = f := by
  induction f using MonoidAlgebra.induction_on with
  | of m =>
    rw [of_apply, domCongr_single]
    rfl
  | add f g hf hg => rw [map_add, hf, hg]
  | smul c f hf => rw [map_smul, hf]

lemma domCongr_weylPerm_mul (σ τ : Equiv.Perm (Fin n)) : domCongr ℂ ℂ (weylPerm (σ * τ)) f =
    domCongr ℂ ℂ (weylPerm σ) (domCongr ℂ ℂ (weylPerm τ) f) := by
  induction f using MonoidAlgebra.induction_on with
  | of m =>
    rw [of_apply, domCongr_single, domCongr_single, domCongr_single]
    rfl
  | add f g hf hg => rw [map_add, hf, hg, map_add, map_add]
  | smul c f hf => rw [map_smul, hf, map_smul, map_smul]

lemma domCongr_weylSign_eq (j j₀ : Fin n) : domCongr ℂ ℂ (weylSign j) f =
    domCongr ℂ ℂ (weylPerm (Equiv.swap j j₀)) (domCongr ℂ ℂ (weylSign j₀)
      (domCongr ℂ ℂ (weylPerm (Equiv.swap j j₀)) f)) := by
  induction f using MonoidAlgebra.induction_on with
  | of m =>
    rw [of_apply, domCongr_single, domCongr_single, domCongr_single, domCongr_single]
    congr 1
    simp only [weylSign, weylPerm, MulEquiv.coe_mk, Equiv.coe_fn_mk]
    congr 2
    funext i
    rcases eq_or_ne i j with rfl | hi
    · simp
    · rcases eq_or_ne i j₀ with rfl | hi'
      · simp [Function.update_of_ne hi, Function.update_of_ne hi.symm]
      · simp [Function.update_of_ne hi, Function.update_of_ne hi',
          Equiv.swap_apply_of_ne_of_ne hi hi']
  | add f g hf hg => rw [map_add, hf, hg, map_add, map_add, map_add]
  | smul c f hf => rw [map_smul, hf, map_smul, map_smul, map_smul]

variable (p : ℕ) [Fact p.Prime] [NeZero n]

lemma satakeMapUniv_single (D : HeckeCoset (heckeMonoidAt (Fin n) p) (heckeGamma (Fin n))
    (heckeGamma (Fin n))) (c : ℂ) :
    satakeMapUniv p (single ℂ D c) = c • satakeMapUniv p (single ℂ D 1) := by
  rw [satakeMapUniv, HeckeCoset.sphericalMap_single, HeckeCoset.sphericalMap_single, one_smul]

lemma domCongr_weylPerm_satakeMapUniv (D : HeckeCoset (heckeMonoidAt (Fin n) p) (heckeGamma (Fin n))
    (heckeGamma (Fin n))) (σ : Equiv.Perm (Fin n)) :
    domCongr ℂ ℂ (weylPerm σ) (satakeMapUniv p (single ℂ D 1)) =
      satakeMapUniv p (single ℂ D 1) := by
  rcases Nat.exists_eq_add_one.mpr (NeZero.pos n) with ⟨m, rfl⟩
  have hS (τ : Equiv.Perm (Fin (m + 1)))
      (hτ : τ ∈ Submonoid.closure (Set.range fun i : Fin m ↦ Equiv.swap i.castSucc i.succ)) :
      domCongr ℂ ℂ (weylPerm τ) (satakeMapUniv p (single ℂ D 1)) =
        satakeMapUniv p (single ℂ D 1) := by
    induction hτ using Submonoid.closure_induction with
    | mem τ hτ =>
      rcases hτ with ⟨i, rfl⟩
      exact domCongr_weylPerm_swap_satakeMapUniv p D (by simp)
    | one => exact domCongr_weylPerm_one _
    | mul τ τ' _ _ hτ hτ' => rw [domCongr_weylPerm_mul, hτ', hτ]
  exact hS σ (by rw [Perm.mclosure_swap_castSucc_succ]; trivial)

lemma domCongr_weylSign_satakeMapUniv (D : HeckeCoset (heckeMonoidAt (Fin n) p) (heckeGamma (Fin n))
    (heckeGamma (Fin n))) (j : Fin n) :
    domCongr ℂ ℂ (weylSign j) (satakeMapUniv p (single ℂ D 1)) =
      satakeMapUniv p (single ℂ D 1) := by
  rcases Nat.exists_eq_add_one.mpr (NeZero.pos n) with ⟨m, rfl⟩
  rw [domCongr_weylSign_eq _ j (Fin.last m), domCongr_weylPerm_satakeMapUniv,
    domCongr_weylSign_last_satakeMapUniv p D (by simp), domCongr_weylPerm_satakeMapUniv]

/-- **The Satake map of `Sp(2g, ℤ)` at `p` takes its values in the Weyl invariants** (LMFDB
`mf.siegel.lift`, through Satake's theorem): the universal Satake map `Ω(T)` of every element `T`
of the local Hecke algebra is a Laurent polynomial invariant under the Weyl group `W_g` of signed
permutations of `x_0, …, x_{g-1}` (with `x₀ ↦ x₀ x_j` for the sign change at `j`). -/
lemma satakeMapUniv_mem_weylInvariants (T : localSiegelHeckeRing (Fin n) p) :
    satakeMapUniv p T ∈ weylInvariants n := by
  induction T using HeckeCosetModule.induction_linear with
  | h0 => rw [map_zero]; exact zero_mem _
  | hadd x y hx hy => rw [map_add]; exact add_mem hx hy
  | hsingle D c =>
    rw [satakeMapUniv_single]
    exact Subalgebra.smul_mem _ (mem_weylInvariants (domCongr_weylPerm_satakeMapUniv p D)
      (domCongr_weylSign_satakeMapUniv p D)) c

variable (α₀ : ℂˣ) (α : Fin n → ℂˣ)

/-- **The Satake map is invariant under the permutations of the coordinates** (LMFDB
`mf.siegel.lift`, through Satake's theorem): `ω_{(α₀; α ∘ σ)} = ω_{(α₀; α)}`. -/
lemma satakeMap_comp_perm (σ : Equiv.Perm (Fin n)) : satakeMap p α₀ (α ∘ σ) = satakeMap p α₀ α :=
  RingHom.ext fun T ↦ by
    rw [← satakeEval_satakeMapUniv, ← satakeEval_satakeMapUniv, ← satakeEval_weylPerm,
      domCongr_weylPerm_of_mem σ (satakeMapUniv_mem_weylInvariants p T)]

/-- **The Satake map is invariant under the sign changes** (LMFDB `mf.siegel.lift`, through
Satake's theorem): `ω_{(α₀ α_j; …, α_j⁻¹, …)} = ω_{(α₀; α)}`. -/
lemma satakeMap_update_inv (j : Fin n) :
    satakeMap p (α₀ * α j) (Function.update α j (α j)⁻¹) = satakeMap p α₀ α :=
  RingHom.ext fun T ↦ by
    rw [← satakeEval_satakeMapUniv, ← satakeEval_satakeMapUniv, ← satakeEval_weylSign,
      domCongr_weylSign_of_mem j (satakeMapUniv_mem_weylInvariants p T)]

end SiegelUpperHalfSpace
