import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.Level
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Siegel.SiegelEisensteinSeries

/-!
# The ring of Siegel modular forms of degree 2 on `Sp(4, ℤ)`

Igusa proved that the graded ring of Siegel modular forms of degree 2 and even weight on `Sp(4, ℤ)`
is the polynomial ring in the algebraically independent Siegel Eisenstein series `ψ₄, ψ₆, ψ₁₀, ψ₁₂`,
or equivalently in `ψ₄, ψ₆, χ₁₀, χ₁₂`, where the cusp forms
`χ₁₀ = -43867 · 2⁻¹² 3⁻⁵ 5⁻² 7⁻¹ 53⁻¹ (ψ₄ψ₆ - ψ₁₀)` and
`χ₁₂ = 131 · 593 · 2⁻¹³ 3⁻⁷ 5⁻³ 7⁻² 337⁻¹ (441ψ₄³ + 250ψ₆² - 691ψ₁₂)` replace `ψ₁₀` and `ψ₁₂`
(`adjoin_psi_eq_adjoin_chi`). The cusp forms of even weight are the ideal generated by `χ₁₀` and
`χ₁₂`, and the forms of odd weight are `χ₃₅ ℂ[ψ₄, ψ₆, χ₁₀, χ₁₂]` for a cusp form `χ₃₅` of weight 35.
The structure theorem is stated here (`IgusaStructure`), not proved.

The knowl does not give `χ₃₅`. It is taken here to be the Jacobian
`det(kᵢFᵢ, ∂Fᵢ/∂τ, ∂Fᵢ/∂z, ∂Fᵢ/∂ω) / (2πi)³` of `(F₁, F₂, F₃, F₄) = (ψ₄, ψ₆, χ₁₀, χ₁₂)`, of weights
`kᵢ = 4, 6, 10, 12`: a cusp form of weight `4 + 6 + 10 + 12 + 3 = 35` (Aoki and Ibukiyama), which is
nonzero, and so spans `M₃₅(Sp(4, ℤ))`, of dimension 1 by Igusa's theorem. Any normalisation of the
knowl's `χ₃₅` is a multiple of it, and the structure theorem does not depend on the normalisation.

The formulas of the knowl were checked exactly on Fourier coefficients `a(n, r, m)` (of
`e^{2πi(nτ + rz + mω)}`), those of `ψ_k` being `-2k / B_k` times those of the Maass lift of the
Jacobi Eisenstein series `E_{k,1}`, whose coefficients are given by Cohen's function: `χ₁₀` and
`χ₁₂` have no coefficient at a singular `T`, and `a(1, 1, 1) = -1/4`, `a(1, 0, 1) = 1/2` for `χ₁₀`,
`a(1, 1, 1) = 1/12`, `a(1, 0, 1) = 5/6` for `χ₁₂`. So `C = -4χ₁₀` and `D = 12χ₁₂`, the knowl's names
on the modular form pages, are the Maass lifts of the Jacobi cusp forms `φ_{10,1}` and `φ_{12,1}`
normalised by `c(1, 1) = 1`, the Saito–Kurokawa lifts of the cusp forms of weight 18 and 22. The
Jacobian above has `a(2, 1, 3) = -864` and `a(3, 1, 2) = 864`.

## Main definitions

* `SiegelUpperHalfSpace.Igusa.gamma2`: the full modular group `Sp(4, ℤ)` in `Sp(4, ℚ)`.
* `SiegelUpperHalfSpace.Igusa.psi` (LMFDB `mf.siegel.family.sp4z`): the Siegel Eisenstein series
  `ψ_k` of degree 2.
* `SiegelUpperHalfSpace.Igusa.chi10`, `SiegelUpperHalfSpace.Igusa.chi12`,
  `SiegelUpperHalfSpace.Igusa.chi35` (LMFDB `mf.siegel.family.sp4z`): Igusa's cusp forms.
* `SiegelUpperHalfSpace.Igusa.A`, `SiegelUpperHalfSpace.Igusa.B`, `SiegelUpperHalfSpace.Igusa.C`,
  `SiegelUpperHalfSpace.Igusa.D` (LMFDB `mf.siegel.family.sp4z`): the names of the generators on the
  LMFDB's modular form pages.
* `SiegelUpperHalfSpace.Igusa.IgusaStructure` (LMFDB `mf.siegel.family.sp4z`): Igusa's structure
  theorem, as a statement.

## Main results

* `SiegelUpperHalfSpace.Igusa.adjoin_psi_eq_adjoin_chi`:
  `ℂ[ψ₄, ψ₆, ψ₁₀, ψ₁₂] = ℂ[ψ₄, ψ₆, χ₁₀, χ₁₂]`.
-/

open Complex Real

namespace SiegelUpperHalfSpace.Igusa

/-- The full modular group `Γ₂ = Sp(4, ℤ)`, as a subgroup of `Sp(4, ℚ)`. -/
abbrev gamma2 : Subgroup (Matrix.symplecticGroup (Fin 2) ℚ) :=
  SymplecticGroup.integral (Fin 2)

/-- The Siegel Eisenstein series `ψ_k` of degree 2 (LMFDB `mf.siegel.family.sp4z`,
`mf.siegel.eisenstein_series`), a Siegel modular form of weight `k` on `Sp(4, ℤ)` for even
`k ≥ 4`. -/
noncomputable abbrev psi (k : ℤ) : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  siegelEisensteinSeries k

/-- The cusp form `χ₁₀ = -43867 · 2⁻¹² 3⁻⁵ 5⁻² 7⁻¹ 53⁻¹ (ψ₄ψ₆ - ψ₁₀)` of weight 10 on `Sp(4, ℤ)`
(LMFDB `mf.siegel.family.sp4z`). -/
noncomputable def chi10 : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  (-43867 / (2 ^ 12 * 3 ^ 5 * 5 ^ 2 * 7 * 53) : ℂ) • (psi 4 * psi 6 - psi 10)

/-- The cusp form `χ₁₂ = 131 · 593 · 2⁻¹³ 3⁻⁷ 5⁻³ 7⁻² 337⁻¹ (441ψ₄³ + 250ψ₆² - 691ψ₁₂)` of weight 12
on `Sp(4, ℤ)` (LMFDB `mf.siegel.family.sp4z`). -/
noncomputable def chi12 : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  (131 * 593 / (2 ^ 13 * 3 ^ 7 * 5 ^ 3 * 7 ^ 2 * 337) : ℂ) •
    ((441 : ℂ) • psi 4 ^ 3 + (250 : ℂ) • psi 6 ^ 2 - (691 : ℂ) • psi 12)

/-- The cusp form `χ₃₅` of weight 35 on `Sp(4, ℤ)` (LMFDB `mf.siegel.family.sp4z`), which the knowl
does not give explicitly: taken here to be the Jacobian
`det(kᵢFᵢ, ∂Fᵢ/∂τ, ∂Fᵢ/∂z, ∂Fᵢ/∂ω) / (2πi)³` of `(ψ₄, ψ₆, χ₁₀, χ₁₂)`, of weights
`kᵢ = 4, 6, 10, 12`, which spans the one-dimensional space `M₃₅(Sp(4, ℤ))` (Aoki and Ibukiyama; not
proved here). Its Fourier coefficient at `e^{2πi(2τ + z + 3ω)}` is `-864`. -/
noncomputable def chi35 : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  ((2 * π * I) ^ 3)⁻¹ • jacobianDet ![psi 4, psi 6, chi10, chi12] ![4, 6, 10, 12]

/-- The generator `A = ψ₄` (LMFDB `mf.siegel.family.sp4z`), as named on the LMFDB's modular form
pages. -/
noncomputable def A : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  psi 4

/-- The generator `B = ψ₆` (LMFDB `mf.siegel.family.sp4z`), as named on the LMFDB's modular form
pages. -/
noncomputable def B : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  psi 6

/-- The generator `C = -4χ₁₀` (LMFDB `mf.siegel.family.sp4z`), as named on the LMFDB's modular form
pages: the Maass lift of `φ_{10,1}`, with Fourier coefficient `1` at `e^{2πi(τ + z + ω)}`. -/
noncomputable def C : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  (-4 : ℂ) • chi10

/-- The generator `D = 12χ₁₂` (LMFDB `mf.siegel.family.sp4z`), as named on the LMFDB's modular form
pages: the Maass lift of `φ_{12,1}`, with Fourier coefficient `1` at `e^{2πi(τ + z + ω)}`. -/
noncomputable def D : SiegelUpperHalfSpace (Fin 2) → ℂ :=
  (12 : ℂ) • chi12

/-- **`ψ₁₀` and `ψ₁₂` can be replaced by `χ₁₀` and `χ₁₂`**:
`ℂ[ψ₄, ψ₆, ψ₁₀, ψ₁₂] = ℂ[ψ₄, ψ₆, χ₁₀, χ₁₂]`, by the formulas defining `χ₁₀` and `χ₁₂`. -/
lemma adjoin_psi_eq_adjoin_chi : Algebra.adjoin ℂ {psi 4, psi 6, psi 10, psi 12} =
    Algebra.adjoin ℂ {psi 4, psi 6, chi10, chi12} := by
  refine eq_of_forall_ge_iff fun S ↦ ?_
  simp only [Algebra.adjoin_le_iff, Set.insert_subset_iff, Set.singleton_subset_iff]
  refine and_congr_right fun h4 ↦ and_congr_right fun h6 ↦ and_congr ?_ ?_
  · have e :
        psi 10 = psi 4 * psi 6 - (-43867 / (2 ^ 12 * 3 ^ 5 * 5 ^ 2 * 7 * 53) : ℂ)⁻¹ • chi10 := by
      rw [chi10]
      module
    have h46 : psi 4 * psi 6 ∈ S := mul_mem h4 h6
    exact ⟨fun h ↦ S.smul_mem (sub_mem h46 h) _, fun h ↦ e ▸ sub_mem h46 (S.smul_mem h _)⟩
  · have key {x : SiegelUpperHalfSpace (Fin 2) → ℂ} (hx : x ∈ S) (u v : ℂ) :
        u • ((441 : ℂ) • psi 4 ^ 3 + (250 : ℂ) • psi 6 ^ 2 - v • x) ∈ S :=
      S.smul_mem (sub_mem (add_mem (S.smul_mem (pow_mem h4 3) _) (S.smul_mem (pow_mem h6 2) _))
        (S.smul_mem hx _)) _
    have e : psi 12 = (691 : ℂ)⁻¹ • ((441 : ℂ) • psi 4 ^ 3 + (250 : ℂ) • psi 6 ^ 2 -
        (131 * 593 / (2 ^ 13 * 3 ^ 7 * 5 ^ 3 * 7 ^ 2 * 337) : ℂ)⁻¹ • chi12) := by
      rw [chi12]
      module
    exact ⟨fun h ↦ key h _ _, fun h ↦ e ▸ key h _ _⟩

/-- **Igusa's theorem** (LMFDB `mf.siegel.family.sp4z`), as a statement: `ψ₄, ψ₆, ψ₁₀, ψ₁₂` are
Siegel modular forms on `Sp(4, ℤ)` of weights 4, 6, 10, 12 and are algebraically independent,
`χ₁₀, χ₁₂, χ₃₅` are cusp forms of weights 10, 12, 35, the graded ring of Siegel modular forms on
`Sp(4, ℤ)` is `M_*(Sp(4, ℤ)) = ℂ[ψ₄, ψ₆, χ₁₀, χ₁₂] ⊕ χ₃₅ ℂ[ψ₄, ψ₆, χ₁₀, χ₁₂]`, the summands being
the forms of even and of odd weight, with `ψ₄, ψ₆, χ₁₀, χ₁₂` algebraically independent, and the cusp
forms of even weight are the ideal `χ₁₀ ℂ[ψ₄, ψ₆, χ₁₀, χ₁₂] + χ₁₂ ℂ[ψ₄, ψ₆, χ₁₀, χ₁₂]`. It is a
theorem of Igusa, which is not proved here. -/
structure IgusaStructure : Prop where
  psi4_mem : psi 4 ∈ scalarModularForms 4 gamma2
  psi6_mem : psi 6 ∈ scalarModularForms 6 gamma2
  psi10_mem : psi 10 ∈ scalarModularForms 10 gamma2
  psi12_mem : psi 12 ∈ scalarModularForms 12 gamma2
  algebraicIndependent : AlgebraicIndependent ℂ ![psi 4, psi 6, psi 10, psi 12]
  chi10_mem : chi10 ∈ cuspForms (TauCeti.detPowerRep ℂ 2 10) gamma2 1
  chi12_mem : chi12 ∈ cuspForms (TauCeti.detPowerRep ℂ 2 12) gamma2 1
  chi35_mem : chi35 ∈ cuspForms (TauCeti.detPowerRep ℂ 2 35) gamma2 1
  isFreeOverAdjoin :
    IsFreeOverAdjoin (gradedModularForms gamma2) ![psi 4, psi 6, chi10, chi12] ![1, chi35]
  iSup_cuspForms_eq : ⨆ k : ℕ, cuspForms (TauCeti.detPowerRep ℂ 2 (2 * k)) gamma2 1 =
    (Algebra.adjoin ℂ {psi 4, psi 6, chi10, chi12}).toSubmodule.map (LinearMap.mulLeft ℂ chi10) ⊔
      (Algebra.adjoin ℂ {psi 4, psi 6, chi10, chi12}).toSubmodule.map (LinearMap.mulLeft ℂ chi12)

end SiegelUpperHalfSpace.Igusa
