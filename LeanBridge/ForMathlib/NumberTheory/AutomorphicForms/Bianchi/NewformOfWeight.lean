import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Bianchi.Newform
import Mathlib.Analysis.SpecialFunctions.Pow.Real

/-!
# Bianchi newforms of every weight

Let `K` be an imaginary quadratic field of class number `1`, embedded in `ℂ` by `σ`, with
discriminant `Δ`, and `𝔑` a nonzero ideal of `𝒪_K`. A Bianchi cusp form `F : ℋ₃ → ℂ^{k+1}` of
weight `k` and level `Γ₀(𝔑)`, in the convention of `bianchiSlash`, has a Fourier–Bessel (Whittaker)
expansion `F(x, y) = ∑_{0 ≠ α ∈ 𝒪_K} c(α) y W_k(u, 4π|μ|y) ψ(μx)`, where `μ = α / √Δ`,
`u = μ / |μ|`, `ψ(z) = e^{2πi(z + z̄)}` and `W_k(u, t) = ((iu)^{k/2 - j} K_{j - k/2}(t))_j` is the
vector of `K`-Bessel functions for which `y W_k(u, 4π|μ|y) ψ(μx)` is harmonic: both Casimir
operators act on its lift by `(k² - 4) / 8` (`IsBianchiHarmonic`; not proved here). In weight `2`
it is the vector `bianchiBesselVector` of LMFDB `mf.bianchi.fourierbessell`, the knowl's function
being `y F` (`bianchiWhittakerVector_two`); the LMFDB states no expansion in other weights.

A **Bianchi newform** of weight `k` (LMFDB `mf.bianchi.newform`, `mf.bianchi.spaces`) is a form of
the newspace `S_k(𝔑)^new` (`bianchiNewSubspace`) which is an eigenform of the Hecke operators `T_𝔭`
and is normalised by `c(1) = 1`. The Hecke operators of `bianchiHeckeTPrime` are normalised through
`PSL(2, ℂ)`; the eigenvalues `a_𝔭` of the LMFDB, algebraic integers equal to the Fourier
coefficients `c(𝔭)` of the newform, are those of the **arithmetic** Hecke operators
`N(𝔭)^{(k - 2) / 4} T_𝔭`, which agree with `T_𝔭` in weight `2`: for an upper triangular
`g = (1, b; 0, π) / √π`, `F ∣_k g` multiplies the coefficient `c(πβ)` by `|π|^{-k/2 - 1}`, and the
`N(𝔭)` translates `b` give `T_𝔭 c(β) = |π|^{1 - k/2} c(πβ) + …`, so `c(𝔭) = N(𝔭)^{(k - 2) / 4} λ_𝔭`
for the eigenvalue `λ_𝔭` of `T_𝔭`. The **Hecke field** is generated by the `a_𝔭`, `𝔭 ∤ 𝔑`, and the
**dimension** is its degree.

That the newspace has a basis of newforms, that `a_𝔭 = c(𝔭)`, that the `a_𝔭` are totally real
algebraic integers, that the Hecke field is a number field whose degree is the dimension of the
irreducible component of the rational newspace containing `F`, and that every cusp form has such an
expansion are theorems, not proved here; the knowl's claim that the Hecke field is Galois over `ℚ`
is false in general.

## Main definitions

* `HyperbolicThreeSpace.bianchiWhittakerVector` (LMFDB `mf.bianchi.spaces`): the vector `W_k(u, t)`.
* `HyperbolicThreeSpace.bianchiWhittakerTerm`: the terms of the expansion in weight `k`.
* `HyperbolicThreeSpace.HasBianchiWhittakerExpansion` (LMFDB `mf.bianchi.spaces`): `F` has the
  Fourier–Bessel expansion of weight `k` with coefficients `c`.
* `HyperbolicThreeSpace.bianchiHeckeTPrimeArith` (LMFDB `mf.bianchi.newform`): the arithmetic
  Hecke operator `N(𝔭)^{(k - 2) / 4} T_𝔭`.
* `HyperbolicThreeSpace.BianchiNewformOfWeight` (LMFDB `mf.bianchi.newform`, `mf.bianchi.spaces`):
  Bianchi newforms of weight `k`.
* `HyperbolicThreeSpace.BianchiNewformOfWeight.heckeField` (LMFDB `mf.bianchi.newform`,
  `mf.bianchi.spaces`): the Hecke field.
* `HyperbolicThreeSpace.BianchiNewformOfWeight.dimension` (LMFDB `mf.bianchi.newform`,
  `mf.bianchi.spaces`): the dimension.
* `HyperbolicThreeSpace.BianchiNewformOfWeight.toBianchiModularForm`: a newform as an element of
  `M_k(Γ₀(𝔑))`.
* `HyperbolicThreeSpace.BianchiNewform.toBianchiNewformOfWeight`: a weight `2` Bianchi newform
  (`BianchiNewform`) as a newform of weight `2`.
* `HyperbolicThreeSpace.BianchiNewformOfWeight.toBianchiNewform`: conversely, a newform of weight
  `2` as a `BianchiNewform`.

## Main results

* `HyperbolicThreeSpace.bianchiWhittakerVector_two`: in weight `2`, `W_2(u, t)` is the vector of
  LMFDB `mf.bianchi.fourierbessell`.
* `HyperbolicThreeSpace.hasBianchiWhittakerExpansion_two_iff`: in weight `2`, `F` has the expansion
  of weight `2` exactly when `y F` has the expansion of LMFDB `mf.bianchi.fourierbessell`.
* `HyperbolicThreeSpace.BianchiNewform.heckeField_toBianchiNewformOfWeight`: the Hecke field of a
  weight `2` newform is unchanged.
-/

open Complex NumberField Real

open scoped ComplexConjugate

namespace HyperbolicThreeSpace

variable {K : Type*} [Field K] (σ : K →+* ℂ) (δ : ℂ) (k : ℕ) (u : ℂ) (t : ℝ)

/-- The **Whittaker vector** `W_k(u, t) = ((iu)^{k/2 - j} K_{j - k/2}(t))_{0 ≤ j ≤ k}` (LMFDB
`mf.bianchi.spaces`) of `K`-Bessel functions (`Complex.besselK`), in the basis `X^{k-j} Y^j` of
`ℂ^{k+1} = Sym^k(ℂ²)` of `bianchiSlash`, for the phase `u = μ / |μ|` of a frequency `μ ∈ ℂ`: the
function `y W_k(u, 4π|μ|y) e^{2πi(μx + conj(μx))}` is the harmonic one, of moderate growth, among
the functions of `(x, y)` of this frequency (facts not proved here), which gives the Fourier–Bessel
expansion of Bianchi cusp forms of weight `k`. It is meant for even `k`, the weights with nonzero
forms; in weight `2` it is the vector of LMFDB `mf.bianchi.fourierbessell`
(`bianchiWhittakerVector_two`). -/
noncomputable def bianchiWhittakerVector : Fin (k + 1) → ℂ :=
  fun j ↦ (I * u) ^ ((k / 2 : ℕ) - (j : ℕ) : ℤ) * besselK ((j : ℕ) - (k : ℂ) / 2) t

/-- **In weight `2`, the Whittaker vector is the vector of LMFDB `mf.bianchi.fourierbessell`**:
`W_2(u, t) = (iu K₁(t), K₀(t), -iū K₁(t))` for `|u| = 1`. -/
lemma bianchiWhittakerVector_two (hu : ‖u‖ = 1) :
    bianchiWhittakerVector 2 u t = bianchiBesselVector u t := by
  have hu' : (I * u)⁻¹ = -(I * conj u) := by
    rw [mul_inv, inv_I, inv_def, normSq_eq_norm_sq, hu]
    simp
  ext j
  fin_cases j <;> norm_num [bianchiWhittakerVector, bianchiBesselVector, hu', besselK_neg]

variable [NumberField K]

/-- The term `c(α) y W_k(u, 4π|α|y / √|Δ|) ψ(αx / δ)` at `p = (x, y)` of the **Fourier–Bessel
expansion** of weight `k` (LMFDB `mf.bianchi.spaces`) of a Bianchi cusp form over `K`, embedded in
`ℂ` by `σ`, in the convention of `bianchiSlash`, with coefficients `c`, where `Δ` is the
discriminant of `K`, `δ` the chosen square root `√Δ`, `u = μ / |μ|` the phase of `μ = α / δ` and
`ψ(z) = e^{2πi(z + z̄)}`. It is `y⁻¹` times the term `bianchiFourierBesselTerm` of LMFDB
`mf.bianchi.fourierbessell` in weight `2`; it is only meaningful for `α ≠ 0`. -/
noncomputable def bianchiWhittakerTerm (c : 𝓞 K → ℂ) (p : ℂ × ℝ) (α : 𝓞 K) : Fin (k + 1) → ℂ :=
  letI a : ℂ := σ α
  (c α * (p.2 : ℂ) * exp (2 * π * I * (a * p.1 / δ + conj (a * p.1 / δ)))) •
    bianchiWhittakerVector k (a / δ / ‖a / δ‖) (4 * π * ‖a‖ * p.2 / √|(discr K : ℝ)|)

/-- A function `F : ℋ₃ → ℂ^{k+1}`, given on `ℂ × ℝ`, has the **Fourier–Bessel expansion** of weight
`k` (LMFDB `mf.bianchi.spaces`) `F(x, y) = ∑_{0 ≠ α ∈ 𝒪_K} c(α) y W_k(u, 4π|μ|y) ψ(μx)`,
`μ = α / δ`, over the imaginary quadratic field `K` embedded in `ℂ` by `σ`, with coefficients `c`
and the square root `δ` of the discriminant, the series converging (unconditionally) at every
point of `ℋ₃`. In weight `2` this is the expansion of LMFDB `mf.bianchi.fourierbessell` of `y F`
(`hasBianchiWhittakerExpansion_two_iff`). That every Bianchi cusp form of weight `k` has such an
expansion is a theorem, not proved here. -/
def HasBianchiWhittakerExpansion (F : ℂ × ℝ → Fin (k + 1) → ℂ) (c : 𝓞 K → ℂ) : Prop :=
  ∀ p : ℂ × ℝ, 0 < p.2 →
    HasSum (fun α : {α : 𝓞 K // α ≠ 0} ↦ bianchiWhittakerTerm σ δ k c p α) (F p)

variable {σ δ} {c : 𝓞 K → ℂ}

variable (K) in
lemma discr_cpow_ne_zero : (discr K : ℂ) ^ (2⁻¹ : ℂ) ≠ 0 :=
  (cpow_ne_zero_iff_of_exponent_ne_zero (by norm_num)).mpr <|
    Int.cast_ne_zero.mpr <| discr_ne_zero K

lemma norm_div_norm_eq_one {z : ℂ} (hz : z ≠ 0) : ‖z / ‖z‖‖ = 1 := by
  rw [norm_div, norm_real, norm_norm, div_self (norm_ne_zero_iff.mpr hz)]

lemma bianchiFourierBesselTerm_eq_smul (hδ : δ ≠ 0) (p : ℂ × ℝ) {α : 𝓞 K} (hα : α ≠ 0) :
    bianchiFourierBesselTerm σ δ c p α = (p.2 : ℂ) • bianchiWhittakerTerm σ δ 2 c p α := by
  have hu : ‖σ α / δ / ‖σ α / δ‖‖ = 1 := norm_div_norm_eq_one <|
    div_ne_zero ((map_ne_zero σ).mpr <| RingOfIntegers.coe_ne_zero_iff.mpr hα) hδ
  rw [bianchiWhittakerTerm, bianchiWhittakerVector_two _ _ hu, smul_smul, bianchiFourierBesselTerm]
  congr 1
  ring1

/-- **In weight `2`, the expansion is that of LMFDB `mf.bianchi.fourierbessell`**: `F` has the
Fourier–Bessel expansion of weight `2` with coefficients `c` exactly when `y F(x, y)`, the form in
the convention of the knowl, has the expansion of `HasBianchiFourierBesselExpansion`. -/
lemma hasBianchiWhittakerExpansion_two_iff (hδ : δ ≠ 0) (F : ℂ × ℝ → Fin 3 → ℂ) :
    HasBianchiWhittakerExpansion σ δ 2 F c ↔
      HasBianchiFourierBesselExpansion σ δ (fun p ↦ (p.2 : ℂ) • F p) c := by
  refine forall₂_congr fun p hp ↦ ?_
  have hy : (p.2 : ℂ) ≠ 0 := ofReal_ne_zero.mpr hp.ne'
  have h : (fun α : {α : 𝓞 K // α ≠ 0} ↦ bianchiFourierBesselTerm σ δ c p α) =
      fun α : {α : 𝓞 K // α ≠ 0} ↦ (p.2 : ℂ) • bianchiWhittakerTerm σ δ 2 c p α :=
    funext fun α ↦ bianchiFourierBesselTerm_eq_smul hδ p α.2
  rw [h]
  refine ⟨fun h ↦ h.const_smul _, fun h ↦ ?_⟩
  simpa only [inv_smul_smul₀ hy] using h.const_smul (p.2 : ℂ)⁻¹

variable (σ) [IsTotallyComplex K] [IsPrincipalIdealRing (𝓞 K)] (𝔑 : Ideal (𝓞 K)) [NeZero 𝔑]

section

variable (𝔭 : Ideal (𝓞 K)) (h𝔭 : 𝔭 ≠ ⊥)

/-- The **arithmetic Hecke operator** `N(𝔭)^{(k - 2) / 4} T_𝔭` (LMFDB `mf.bianchi.newform`) on the
space `M_k(Γ₀(𝔑))` of Bianchi modular forms of weight `k` and level `Γ₀(𝔑)`, for a nonzero prime
`𝔭` of `𝒪_K`, where `T_𝔭` (`bianchiHeckeTPrime`) is the operator of the double coset
`Γ₀(𝔑) diag(1, π) Γ₀(𝔑)` acting through `PSL(2, ℂ)`. This is the normalisation of the LMFDB's
eigenvalues `a_𝔭`, which are algebraic integers and the Fourier–Bessel coefficients `c(𝔭)` of a
newform normalised by `c(1) = 1` (theorems, not proved here): the coefficient system of weight `k`
is `Sym^n ⊗ conj(Sym^n)`, `k = 2n + 2`, on which `diag(1, π)` acts with the factor `|π|^n` that the
action through `PSL(2, ℂ)` omits. In weight `2` it is `T_𝔭` (`bianchiHeckeTPrimeArith_two`). -/
noncomputable def bianchiHeckeTPrimeArith : Module.End ℂ (bianchiModularForms σ 𝔑.gamma0GL k) :=
  (((Ideal.absNorm 𝔭 : ℝ) ^ (((k : ℝ) - 2) / 4) : ℝ) : ℂ) • bianchiHeckeTPrime σ k 𝔑 𝔭 h𝔭

lemma bianchiHeckeTPrimeArith_two :
    bianchiHeckeTPrimeArith σ 2 𝔑 𝔭 h𝔭 = bianchiHeckeTPrime σ 2 𝔑 𝔭 h𝔭 := by
  simp [bianchiHeckeTPrimeArith]

end

/-- A **Bianchi newform** of weight `k` (LMFDB `mf.bianchi.newform`, `mf.bianchi.spaces`) and level
`Γ₀(𝔑)` over a totally complex field `K` (imaginary quadratic for the LMFDB) whose ring of integers
is a principal ideal domain, embedded in `ℂ` by `σ`: a form `F : ℋ₃ → ℂ^{k+1}` of the newspace
`S_k(𝔑)^new` (`bianchiNewSubspace`) which is an eigenform of the arithmetic Hecke operator `T_𝔭`
(`bianchiHeckeTPrimeArith`) of every nonzero prime `𝔭` of `𝒪_K`, with eigenvalue `a_𝔭`, normalised
so that the coefficient of `(1)` in its Fourier–Bessel expansion of weight `k`
(`HasBianchiWhittakerExpansion`) is `1`. The expansion is taken with the principal square root
`√Δ` of the discriminant `Δ` of `K`; the other root gives the coefficients `α ↦ c(-α)`. In weight
`2` these are the newforms `BianchiNewform` (`BianchiNewform.toBianchiNewformOfWeight`), with the
same eigenvalues and coefficients.

The normalisation rests on a fact not proved here: that `y W_k(u, 4π|μ|y) ψ(μx)` is, up to a
scalar, the only harmonic function of moderate growth of frequency `μ` (`bianchiWhittakerVector`),
so that every cusp form of weight `k` has such an expansion. In weight `k > 2` the vector `W_k` was
only checked numerically; were it wrong, there would be no newforms of weight `k`. -/
structure BianchiNewformOfWeight where
  /-- The newform `F : ℋ₃ → ℂ^{k+1}`. -/
  toFun : HyperbolicThreeSpace → Fin (k + 1) → ℂ
  /-- `F` lies in the newspace. -/
  mem_bianchiNewSubspace : toFun ∈ bianchiNewSubspace σ k 𝔑
  /-- The Hecke eigenvalue `a_𝔭` of a nonzero prime `𝔭`, in the arithmetic normalisation. -/
  eigenvalue : {𝔭 : Ideal (𝓞 K) // 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} → ℂ
  /-- `F` is an eigenform of the arithmetic `T_𝔭` with eigenvalue `a_𝔭`. -/
  isEigen (𝔭 : {𝔭 : Ideal (𝓞 K) // 𝔭.IsPrime ∧ 𝔭 ≠ ⊥}) : (bianchiHeckeTPrimeArith σ k 𝔑 𝔭.1 𝔭.2.2
      ⟨toFun, bianchiNewSubspace_le_bianchiModularForms σ k 𝔑 mem_bianchiNewSubspace⟩ :
        HyperbolicThreeSpace → Fin (k + 1) → ℂ) = eigenvalue 𝔭 • toFun
  /-- The Fourier–Bessel coefficients `c(α)`, `α ∈ 𝒪_K`. -/
  coeff : 𝓞 K → ℂ
  /-- `F` has the Fourier–Bessel expansion of weight `k` with coefficients `c`. -/
  hasWhittakerExpansion :
    HasBianchiWhittakerExpansion σ ((discr K : ℂ) ^ (2⁻¹ : ℂ)) k (extend toFun) coeff
  /-- The coefficient of `(1)` is `1`. -/
  coeff_one : coeff 1 = 1

namespace BianchiNewformOfWeight

variable {σ k 𝔑} (F : BianchiNewformOfWeight σ k 𝔑)

/-- A Bianchi newform of weight `k` and level `Γ₀(𝔑)` as an element of the space `M_k(Γ₀(𝔑))` of
Bianchi modular forms. -/
def toBianchiModularForm : bianchiModularForms σ 𝔑.gamma0GL k :=
  ⟨F.toFun, bianchiNewSubspace_le_bianchiModularForms σ k 𝔑 F.mem_bianchiNewSubspace⟩

lemma bianchiHeckeTPrimeArith_toBianchiModularForm (𝔭 : {𝔭 : Ideal (𝓞 K) // 𝔭.IsPrime ∧ 𝔭 ≠ ⊥}) :
    bianchiHeckeTPrimeArith σ k 𝔑 𝔭.1 𝔭.2.2 F.toBianchiModularForm =
      F.eigenvalue 𝔭 • F.toBianchiModularForm :=
  Subtype.ext <| F.isEigen 𝔭

lemma eq_eigenvalue (hF : F.toFun ≠ 0) (𝔭 : {𝔭 : Ideal (𝓞 K) // 𝔭.IsPrime ∧ 𝔭 ≠ ⊥}) {a : ℂ}
    (h : bianchiHeckeTPrimeArith σ k 𝔑 𝔭.1 𝔭.2.2 F.toBianchiModularForm =
      a • F.toBianchiModularForm) : a = F.eigenvalue 𝔭 :=
  smul_left_injective ℂ hF <| (congrArg Subtype.val h).symm.trans (F.isEigen 𝔭)

/-- The **Hecke field** (LMFDB `mf.bianchi.newform`, `mf.bianchi.spaces`) of a Bianchi newform of
weight `k`: the subfield of `ℂ` generated by its Hecke eigenvalues `a_𝔭`, in the arithmetic
normalisation, at the primes `𝔭 ∤ 𝔑`. That it is a totally real number field containing the `a_𝔭`
as algebraic integers is a theorem, not proved here; the LMFDB also calls it a Galois extension of
`ℚ`, which is not true in general. -/
noncomputable def heckeField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (F.eigenvalue '' {𝔭 | ¬𝔑 ≤ 𝔭.1})

/-- The **dimension** (LMFDB `mf.bianchi.newform`, `mf.bianchi.spaces`) of a Bianchi newform of
weight `k`: the degree over `ℚ` of its Hecke field, which is the dimension of the irreducible
component of the rational newspace containing `F` (a theorem, not proved here). -/
noncomputable def dimension : ℕ :=
  Module.finrank ℚ F.heckeField

end BianchiNewformOfWeight

namespace BianchiNewform

variable {σ 𝔑} (F : BianchiNewform σ 𝔑)

/-- A Bianchi newform of weight `2` (`BianchiNewform`) as a **Bianchi newform of weight `2`** in the
sense of `BianchiNewformOfWeight`: the arithmetic Hecke operators are the `T_𝔭` in weight `2`
(`bianchiHeckeTPrimeArith_two`), and `F` has the expansion of weight `2` with the coefficients of
the expansion of `y F` of LMFDB `mf.bianchi.fourierbessell`
(`hasBianchiWhittakerExpansion_two_iff`). -/
noncomputable def toBianchiNewformOfWeight : BianchiNewformOfWeight σ 2 𝔑 where
  toFun := F.toFun
  mem_bianchiNewSubspace := F.mem_bianchiNewSubspace
  eigenvalue := F.eigenvalue
  isEigen 𝔭 := by
    rw [bianchiHeckeTPrimeArith_two]
    exact F.isEigen 𝔭
  coeff := F.coeff
  hasWhittakerExpansion :=
    (hasBianchiWhittakerExpansion_two_iff (discr_cpow_ne_zero K) _).mpr F.hasFourierBesselExpansion
  coeff_one := F.coeff_one

/-- **The Hecke field of a weight `2` newform does not change** when it is seen as a newform of
weight `2` in the sense of `BianchiNewformOfWeight`. -/
lemma heckeField_toBianchiNewformOfWeight : F.toBianchiNewformOfWeight.heckeField = F.heckeField :=
  rfl

end BianchiNewform

variable {σ 𝔑} in
/-- A Bianchi newform of weight `2` in the sense of `BianchiNewformOfWeight` as a newform
`BianchiNewform` of weight `2`, the inverse of `BianchiNewform.toBianchiNewformOfWeight`. -/
noncomputable def BianchiNewformOfWeight.toBianchiNewform (G : BianchiNewformOfWeight σ 2 𝔑) :
    BianchiNewform σ 𝔑 where
  toFun := G.toFun
  mem_bianchiNewSubspace := G.mem_bianchiNewSubspace
  eigenvalue := G.eigenvalue
  isEigen 𝔭 := by
    rw [← bianchiHeckeTPrimeArith_two]
    exact G.isEigen 𝔭
  coeff := G.coeff
  hasFourierBesselExpansion :=
    (hasBianchiWhittakerExpansion_two_iff (discr_cpow_ne_zero K) _).mp G.hasWhittakerExpansion
  coeff_one := G.coeff_one

end HyperbolicThreeSpace
