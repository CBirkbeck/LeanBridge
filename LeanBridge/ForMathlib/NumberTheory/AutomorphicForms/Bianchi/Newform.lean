import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Bianchi.FourierBessel
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Bianchi.HeckeAlgebra
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.MeasureTheory.Group.FundamentalDomain

/-!
# Bianchi newforms

Let `K` be an imaginary quadratic field of class number `1`, embedded in `ℂ` by `σ`, and `𝔑` a
nonzero ideal of `𝒪_K`. The space `S_k(Γ₀(𝔑))` of Bianchi cusp forms carries an inner product
analogous to the Petersson inner product (LMFDB `mf.bianchi.spaces`):
`⟨F, G⟩ = ∫_{Γ₀(𝔑) \ ℋ₃} y^k ⟨F(z), G(z)⟩_k dx₁ dx₂ dy / y³`, where `⟨v, w⟩_k = ∑ᵢ C(k, i) vᵢ w̄ᵢ`
is the Hermitian form on `ℂ^{k+1} = Sym^k(ℂ²)` invariant under `Sym^k(SU(2))`, and the integral is
over a fundamental domain of the image of `Γ₀(𝔑)` in `PSL(2, ℂ)`, which acts faithfully on `ℋ₃`.
The integrand is invariant, as `F(γ z) = Sym^k(J(γ, z)) F(z)` with `J(γ, z)` a multiple of a matrix
of `SU(2)` of determinant `y / y(γ z)`.

The **oldforms** of level `𝔑` are the forms `G ∣_k diag(δ, 1)`, `G(δ z)` up to a factor, of the
cusp forms `G` of the levels `𝔐 ⊋ 𝔑` (`N(𝔐) < N(𝔑)`) and the `δ` with `δ𝔐 ⊇ 𝔑`; the **newspace**
`S_k(𝔑)^new` is the orthogonal complement of the oldforms in `S_k(Γ₀(𝔑))`. A **Bianchi newform**
(LMFDB `mf.bianchi.newform`) is a form of the newspace which is an eigenform of the Hecke operators
`T_𝔭` (`bianchiHeckeTPrime`), normalised by its Fourier–Bessel coefficient at `(1)`; its **Hecke
field** is the field generated by its eigenvalues `a_𝔭`, `𝔭 ∤ 𝔑`, and its **dimension** the degree
of the Hecke field.

The normalisation uses the Fourier–Bessel expansion of LMFDB `mf.bianchi.fourierbessell`, which is
only formalised in weight `2` (`HasBianchiFourierBesselExpansion`), the weight of the LMFDB's
Bianchi newforms, so newforms are defined in weight `2` only, while the knowl defines them in every
weight: for `F` in the convention of `bianchiSlash`, the function `y F` is the one of the knowl. The
orthogonality conditions include the integrability of the integrands, which holds for cusp forms.
That the integrals do not depend on the fundamental domain, that the newspace has a basis of
newforms, that the eigenvalues `a_𝔭` are totally real algebraic integers and the coefficients of
index `𝔭`, that the Hecke field is a totally real number field and that its degree is the dimension
of the irreducible component of the rational newspace containing `F` are theorems, not proved here.
The LMFDB also calls the Hecke field a Galois extension of `ℚ`, which is not true in general.

## Main definitions

* The instance `MulAction (ProjectiveSpecialLinearGroup (Fin 2) ℂ) HyperbolicThreeSpace`.
* `HyperbolicThreeSpace.slRepresentatives`: the representatives in `SL(2, ℂ)` of a subgroup of
  `GL₂(K)`.
* `HyperbolicThreeSpace.bianchiPSLGroup`: the image of `Γ₀(𝔑)` in `PSL(2, ℂ)`.
* `HyperbolicThreeSpace.symPowInner`: the `SU(2)`-invariant Hermitian form on `ℂ^{k+1}`.
* `HyperbolicThreeSpace.IsBianchiPeterssonOrthogonal` (LMFDB `mf.bianchi.spaces`): orthogonality
  for the Petersson-type inner product.
* `HyperbolicThreeSpace.bianchiOldforms` (LMFDB `mf.bianchi.spaces`): the oldforms.
* `HyperbolicThreeSpace.bianchiNewSubspace` (LMFDB `mf.bianchi.spaces`, `mf.bianchi.newform`): the
  newspace `S_k(𝔑)^new`.
* `HyperbolicThreeSpace.BianchiNewform` (LMFDB `mf.bianchi.newform`): Bianchi newforms of weight
  `2`.
* `HyperbolicThreeSpace.BianchiNewform.heckeField` (LMFDB `mf.bianchi.newform`): the Hecke field.
* `HyperbolicThreeSpace.BianchiNewform.dimension` (LMFDB `mf.bianchi.newform`): the dimension.
-/

open Complex Matrix MeasureTheory NumberField HilbertModularGroup

open scoped ComplexConjugate MatrixGroups Pointwise

namespace HyperbolicThreeSpace

variable {K : Type*} [Field K] (σ : K →+* ℂ) (k : ℕ) (Γ : Subgroup (GL (Fin 2) K))
  (v v' w : Fin (k + 1) → ℂ) (z : HyperbolicThreeSpace)

lemma smul_eq_of_inv_mul_mem_center {a b : SL(2, ℂ)} (hab : a⁻¹ * b ∈ Subgroup.center SL(2, ℂ)) :
    b • z = a • z := by
  rw [SpecialLinearGroup.mem_center_iff] at hab
  rcases hab with ⟨r, hr, hrab⟩
  refine coords_injective ?_
  rw [coords_smul, coords_smul]
  refine moebius_eq_of_coe_eq_smul z.coords (s := r) ?_ ?_
  · have h2 : normSq r ^ 2 = 1 := by
      rw [← map_pow, ← Fintype.card_fin 2, hr, map_one]
    exact (pow_eq_one_iff_of_nonneg (normSq_nonneg _) two_ne_zero).mp h2
  · have hb : (b : Matrix (Fin 2) (Fin 2) ℂ) = a * scalar (Fin 2) r := by
      rw [hrab, ← SpecialLinearGroup.coe_mul, mul_inv_cancel_left]
    rw [hb]
    ext i j
    simp [mul_comm]

noncomputable instance :
    MulAction (ProjectiveSpecialLinearGroup (Fin 2) ℂ) HyperbolicThreeSpace where
  smul g z := Quotient.liftOn' g (· • z) fun _ _ hab ↦
    (smul_eq_of_inv_mul_mem_center z (QuotientGroup.leftRel_apply.mp hab)).symm
  one_smul z := one_smul SL(2, ℂ) z
  mul_smul g h z := Quotient.inductionOn₂' g h fun a b ↦ mul_smul a b z

lemma mk_smul_eq (g : SL(2, ℂ)) :
    (QuotientGroup.mk g : ProjectiveSpecialLinearGroup (Fin 2) ℂ) • z = g • z :=
  rfl

/-- The subgroup of `SL(2, ℂ)` of the representatives of the elements of a subgroup `Γ` of
`GL₂(K)`, for `K` embedded in `ℂ` by `σ`. -/
def slRepresentatives : Subgroup SL(2, ℂ) where
  carrier := {g | ∃ γ ∈ Γ, IsSLRepresentative σ γ g}
  mul_mem' := fun ⟨γ, hγ, hg⟩ ⟨γ', hγ', hg'⟩ ↦ ⟨γ * γ', mul_mem hγ hγ', hg.mul hg'⟩
  one_mem' := ⟨1, one_mem Γ, 1, by simp⟩
  inv_mem' := fun ⟨γ, hγ, hg⟩ ↦ ⟨γ⁻¹, inv_mem hγ, hg.inv⟩

/-- The image `Γ̄` of a subgroup `Γ` of `GL₂(K)`, such as the level `Γ₀(𝔑)`, in `PSL(2, ℂ)`, for `K`
embedded in `ℂ` by `σ`: the group of the transformations of `ℋ₃` given by `Γ`, which acts on `ℋ₃`
faithfully. -/
def bianchiPSLGroup : Subgroup (ProjectiveSpecialLinearGroup (Fin 2) ℂ) :=
  (slRepresentatives σ Γ).map (QuotientGroup.mk' _)

/-- The Hermitian form `⟨v, w⟩_k = ∑ᵢ C(k, i) vᵢ w̄ᵢ` on `ℂ^{k+1}`, the symmetric power
`Sym^k(ℂ²)` in the basis `X^{k-i} Y^i`: it is invariant under `Sym^k(U)` for `U ∈ SU(2)`, as
`⟨(x^{k-i} y^i)_i, (x'^{k-i} y'^i)_i⟩_k = (x x̄' + y ȳ')^k`. -/
def symPowInner : ℂ :=
  ∑ i : Fin (k + 1), (k.choose i : ℂ) * v i * conj (w i)

variable {k} in
lemma symPowInner_add_left : symPowInner k (v + v') w = symPowInner k v w + symPowInner k v' w := by
  simp only [symPowInner, Pi.add_apply, mul_add, add_mul, Finset.sum_add_distrib]

variable {k} in
lemma symPowInner_smul_left (c : ℂ) : symPowInner k (c • v) w = c * symPowInner k v w := by
  simp only [symPowInner, Pi.smul_apply, Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ ↦ by ring1

/-- `F` and `G` are **orthogonal** for the Petersson-type inner product (LMFDB
`mf.bianchi.spaces`) of the level `Γ ≤ GL₂(K)` in weight `k`:
`∫_{Γ \ ℋ₃} y^k ⟨F(z), G(z)⟩_k dμ = 0`, the integrand being integrable, on every fundamental domain
of the image `Γ̄` of `Γ` in `PSL(2, ℂ)` for the hyperbolic volume `dμ = dx₁ dx₂ dy / y³`. For an
imaginary quadratic `K` and a congruence subgroup `Γ`, `Γ̄` is discrete, so that fundamental domains
exist and the condition is not vacuous; for cusp forms the integrand is integrable and
`Γ`-invariant, so that the integral does not depend on the fundamental domain. These facts are not
proved here. -/
def IsBianchiPeterssonOrthogonal (F G : HyperbolicThreeSpace → Fin (k + 1) → ℂ) : Prop :=
  ∀ s : Set HyperbolicThreeSpace, IsFundamentalDomain (bianchiPSLGroup σ Γ) s hyperbolicVolume →
    IntegrableOn (fun z ↦ (z.height ^ k : ℂ) * symPowInner k (F z) (G z)) s hyperbolicVolume ∧
      ∫ z in s, (z.height ^ k : ℂ) * symPowInner k (F z) (G z) ∂hyperbolicVolume = 0

variable (𝔑 : Ideal (𝓞 K))

/-- The **oldforms** (LMFDB `mf.bianchi.spaces`) of level `𝔑` and weight `k`: the span of the forms
`G ∣_k diag(δ, 1)` (`diag(δ, 1)` being `Matrix.GeneralLinearGroup.rowScale 0 δ`) coming from the
cusp forms `G` of the lower levels `Γ₀(𝔐)`, `𝔐 ⊋ 𝔑` (that is `𝔐 ∣ 𝔑` and `N(𝔐) < N(𝔑)`), for
`δ ∈ 𝒪_K` with `δ𝔐 ⊇ 𝔑`, through which `G` is invariant under `Γ₀(𝔑)`. -/
def bianchiOldforms : Submodule ℂ (HyperbolicThreeSpace → Fin (k + 1) → ℂ) :=
  Submodule.span ℂ {G' | ∃ 𝔐 : Ideal (𝓞 K), 𝔑 < 𝔐 ∧ ∃ δ : 𝓞 K, ∃ hδ : δ ≠ 0,
    𝔑 ≤ Ideal.span {δ} * 𝔐 ∧ ∃ G ∈ bianchiCuspForms σ 𝔐.gamma0GL k,
      G' = bianchiSlash k (slRepresentative σ (GeneralLinearGroup.rowScale 0 (Units.mk0
        (algebraMap (𝓞 K) K δ) ((map_ne_zero_iff _ RingOfIntegers.coe_injective).mpr hδ)))) G}

/-- The **newspace** `S_k(𝔑)^new` (LMFDB `mf.bianchi.spaces`, `mf.bianchi.newform`) of level `𝔑`
and weight `k`: the cusp forms of level `Γ₀(𝔑)` orthogonal to all oldforms for the Petersson-type
inner product. -/
def bianchiNewSubspace : Submodule ℂ (HyperbolicThreeSpace → Fin (k + 1) → ℂ) where
  carrier := {F | F ∈ bianchiCuspForms σ 𝔑.gamma0GL k ∧
    ∀ G ∈ bianchiOldforms σ k 𝔑, IsBianchiPeterssonOrthogonal σ k (bianchiGammaZero 𝔑) F G}
  add_mem' := fun ⟨hF, hF'⟩ ⟨hG, hG'⟩ ↦ ⟨add_mem hF hG, fun H hH s hs ↦ by
    rcases hF' H hH s hs with ⟨h₁, h₂⟩
    rcases hG' H hH s hs with ⟨h₃, h₄⟩
    simp only [Pi.add_apply, symPowInner_add_left, mul_add]
    exact ⟨h₁.add h₃, by rw [integral_add h₁ h₃, h₂, h₄, add_zero]⟩⟩
  zero_mem' := ⟨zero_mem _, fun H _ s _ ↦ by simp [symPowInner]⟩
  smul_mem' c F := fun ⟨hF, hF'⟩ ↦ ⟨Submodule.smul_mem _ c hF, fun H hH s hs ↦ by
    rcases hF' H hH s hs with ⟨h₁, h₂⟩
    simp only [Pi.smul_apply, symPowInner_smul_left, mul_left_comm _ c]
    exact ⟨h₁.const_mul c, by rw [integral_const_mul, h₂, mul_zero]⟩⟩

lemma bianchiNewSubspace_le : bianchiNewSubspace σ k 𝔑 ≤ bianchiCuspForms σ 𝔑.gamma0GL k :=
  fun _ hF ↦ hF.1

lemma bianchiNewSubspace_le_bianchiModularForms :
    bianchiNewSubspace σ k 𝔑 ≤ bianchiModularForms σ 𝔑.gamma0GL k :=
  (bianchiNewSubspace_le σ k 𝔑).trans (bianchiCuspForms_le σ _ k)

variable [NumberField K] [IsTotallyComplex K] [IsPrincipalIdealRing (𝓞 K)] [NeZero 𝔑]

/-- A **Bianchi newform** (LMFDB `mf.bianchi.newform`) of weight `2` and level `Γ₀(𝔑)` over a
totally complex field `K` (imaginary quadratic for the LMFDB) whose ring of integers is a principal
ideal domain, embedded in `ℂ` by `σ`: a form `F : ℋ₃ → ℂ³` of the newspace `S_2(𝔑)^new` which is an
eigenform of every Hecke operator `T_𝔭` (`bianchiHeckeTPrime`), `𝔭` a nonzero prime of `𝒪_K`, with
eigenvalue `a_𝔭`, normalised so that the coefficient of `(1)` in its Fourier–Bessel expansion
(LMFDB `mf.bianchi.fourierbessell`) is `1`. As `F` follows the convention of `bianchiSlash`, the
function with the knowl's Fourier–Bessel expansion is `y F(x, y)`. The expansion is taken with the
principal square root `√Δ` of the discriminant `Δ` of `K`; the other square root gives the
coefficients `α ↦ c(-α)`, which are the same since `diag(-1, 1) ∈ Γ₀(𝔑)` (not proved here).

Newforms are only defined here in weight `2`, the weight of the LMFDB's Bianchi newforms, as the
Fourier–Bessel expansion is only formalised there; the LMFDB defines them in every weight. -/
structure BianchiNewform where
  /-- The newform `F : ℋ₃ → ℂ³`. -/
  toFun : HyperbolicThreeSpace → Fin 3 → ℂ
  /-- `F` lies in the newspace. -/
  mem_bianchiNewSubspace : toFun ∈ bianchiNewSubspace σ 2 𝔑
  /-- The Hecke eigenvalue `a_𝔭` of a nonzero prime `𝔭`. -/
  eigenvalue : {𝔭 : Ideal (𝓞 K) // 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} → ℂ
  /-- `F` is an eigenform of `T_𝔭` with eigenvalue `a_𝔭`. -/
  isEigen (𝔭 : {𝔭 : Ideal (𝓞 K) // 𝔭.IsPrime ∧ 𝔭 ≠ ⊥}) : (bianchiHeckeTPrime σ 2 𝔑 𝔭.1 𝔭.2.2
      ⟨toFun, bianchiNewSubspace_le_bianchiModularForms σ 2 𝔑 mem_bianchiNewSubspace⟩ :
        HyperbolicThreeSpace → Fin 3 → ℂ) = eigenvalue 𝔭 • toFun
  /-- The Fourier–Bessel coefficients `c(α)`, `α ∈ 𝒪_K`. -/
  coeff : 𝓞 K → ℂ
  /-- `y F(x, y)` has the Fourier–Bessel expansion with coefficients `c`. -/
  hasFourierBesselExpansion : HasBianchiFourierBesselExpansion σ ((discr K : ℂ) ^ (2⁻¹ : ℂ))
      (fun p ↦ (p.2 : ℂ) • extend toFun p) coeff
  /-- The coefficient of `(1)` is `1`. -/
  coeff_one : coeff 1 = 1

namespace BianchiNewform

variable {σ 𝔑} (F : BianchiNewform σ 𝔑)

/-- The **Hecke field** (LMFDB `mf.bianchi.newform`) of a Bianchi newform: the subfield of `ℂ`
generated by its Hecke eigenvalues `a_𝔭` at the primes `𝔭 ∤ 𝔑`. That it is a totally real number
field containing the `a_𝔭` as algebraic integers is a theorem, not proved here; the LMFDB also calls
it a Galois extension of `ℚ`, which is not true in general. -/
noncomputable def heckeField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (F.eigenvalue '' {𝔭 | ¬𝔑 ≤ 𝔭.1})

/-- The **dimension** (LMFDB `mf.bianchi.newform`) of a Bianchi newform: the degree over `ℚ` of its
Hecke field, which is the dimension of the irreducible component of the rational newspace
containing `F` (a theorem, not proved here). -/
noncomputable def dimension : ℕ :=
  Module.finrank ℚ F.heckeField

end BianchiNewform

end HyperbolicThreeSpace
