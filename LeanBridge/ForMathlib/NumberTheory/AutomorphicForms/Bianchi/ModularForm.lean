import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Bianchi.Casimir
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Bianchi.Level

/-!
# Bianchi modular forms

Let `K` be an imaginary quadratic field, embedded in `ℂ` by `σ`, and `Γ` a subgroup of `GL₂(𝓞_K)`,
such as the level `Γ₀(𝔑)` of an integral ideal `𝔑`. A Bianchi modular form of weight `k` and level
`Γ` is a real analytic function `F : ℋ₃ → ℂ^{k+1}` such that `F ∣_k γ = F` for `γ ∈ Γ`, `F` is
harmonic and `F` has at worst polynomial growth at the cusps. It is a cusp form if the constant
term of `F ∣_k g` vanishes for every `g ∈ SL(2, K)`, that is at every cusp.

## Main definitions

* `HyperbolicThreeSpace.IsBianchiSlashInvariant` (LMFDB `mf.bianchi`): `F ∣_k γ = F` on `Γ`.
* `HyperbolicThreeSpace.HasPolynomialGrowthAtCusps` (LMFDB `mf.bianchi`): polynomial growth.
* `HyperbolicThreeSpace.IsBianchiModularForm` (LMFDB `mf.bianchi`, `mf.bianchi.weight`): Bianchi
  modular forms of weight `k` and level `Γ`.
* `HyperbolicThreeSpace.cuspTranslations`: the lattice of translations fixing a cusp.
* `HyperbolicThreeSpace.IsBianchiCuspidal` (LMFDB `mf.bianchi`, `mf.bianchi.spaces`): cuspidality.
* `HyperbolicThreeSpace.bianchiModularForms` (LMFDB `mf.bianchi.spaces`): the space `M_k(Γ)`.
* `HyperbolicThreeSpace.bianchiCuspForms` (LMFDB `mf.bianchi.spaces`): the space `S_k(Γ)`.
* `HyperbolicThreeSpace.HasBianchiSign` (LMFDB `mf.bianchi.sign`): the sign, minus the eigenvalue
  of the Fricke involution.
-/

open Complex Matrix MeasureTheory NumberField
open scoped MatrixGroups

namespace HyperbolicThreeSpace

variable {K : Type*} [Field K] (σ : K →+* ℂ) (Γ : Subgroup (GL (Fin 2) (𝓞 K))) (k : ℕ)
  (F : HyperbolicThreeSpace → Fin (k + 1) → ℂ)

/-- `F : ℋ₃ → ℂ^{k+1}` is **invariant under `Γ`** (LMFDB `mf.bianchi`), a subgroup of `GL₂(𝓞_K)`
such as the level `Γ₀(𝔑)` (`Ideal.gamma0GL`): `F ∣_k g = F` for every `γ ∈ Γ` and every
`g ∈ SL(2, ℂ)` representing the image of `γ` in `PGL₂(ℂ) ≅ PSL₂(ℂ)`, that is `g = s⁻¹ σ(γ)` with
`s² = det σ(γ)`, `K` being embedded in `ℂ` by `σ`.

Both representatives `±g` are required to fix `F`, and `-1 ∈ SL(2, ℂ)` represents `1 ∈ Γ` and acts
by `(-1)^k`, so for odd `k` only the zero function is invariant: the slash operator is only defined
on `PSL₂(ℂ)` for even `k`, as the LMFDB requires. -/
def IsBianchiSlashInvariant : Prop :=
  ∀ γ ∈ Γ, ∀ (g : SL(2, ℂ)) (s : ℂ),
    (g : Matrix (Fin 2) (Fin 2) ℂ) = s⁻¹ • (γ : Matrix (Fin 2) (Fin 2) (𝓞 K)).map
      (σ.comp (algebraMap (𝓞 K) K)) → bianchiSlash k g F = F

/-- `F : ℋ₃ → ℂ^{k+1}` has **at worst polynomial growth at the cusps** (LMFDB `mf.bianchi`) of
`K`, embedded in `ℂ` by `σ`: for every `g ∈ SL(2, K)`, which moves `∞` to the cusp `g ∞ ∈ ℙ¹(K)`,
`‖(F ∣_k g)(x, y)‖ ≤ C yⁿ` for some `C` and `n` and all `x ∈ ℂ` and `y ≥ 1`. For a form, `F ∣_k g`
is periodic in `x` under a lattice, so the bound need only hold on a compact set of `x`. -/
def HasPolynomialGrowthAtCusps : Prop :=
  ∀ g : SL(2, K), ∃ (C : ℝ) (n : ℕ), ∀ z : HyperbolicThreeSpace, 1 ≤ z.height →
    ‖bianchiSlash k (SpecialLinearGroup.map σ g) F z‖ ≤ C * z.height ^ n

/-- A **Bianchi modular form** (LMFDB `mf.bianchi`) of **weight** `k` (LMFDB `mf.bianchi.weight`)
and level `Γ ⊆ GL₂(𝓞_K)` (such as `Γ₀(𝔑)`, `Ideal.gamma0GL`), for `K` embedded in `ℂ` by `σ`: a
function `F : ℋ₃ → ℂ^{k+1}` which is real analytic, invariant under the weight `k` slash operator
of `Γ`, harmonic (the Casimir operators of `SL(2, ℂ)` act on its lift by the scalar of the weight,
which is `0` in weight `2`), and of at worst polynomial growth at every cusp.

The LMFDB asks `K` to be imaginary quadratic of class number `1` and `Γ` to be a congruence
subgroup; the definition makes sense for every imaginary quadratic `K` (the cusps are reached by
`SL(2, K)`) and every subgroup `Γ`, and is meant for those. -/
structure IsBianchiModularForm : Prop where
  /-- `F` is real analytic. -/
  analyticAt (z : HyperbolicThreeSpace) : AnalyticAt ℝ (extend F) z.coords
  /-- `F ∣_k γ = F` for `γ ∈ Γ`. -/
  invariant : IsBianchiSlashInvariant σ Γ k F
  /-- `F` is harmonic. -/
  harmonic : IsBianchiHarmonic k F
  /-- `F` has at worst polynomial growth at the cusps. -/
  growth : HasPolynomialGrowthAtCusps σ k F

/-- The **translations fixing the cusp** `g ∞` of `Γ`, for `g ∈ SL(2, K)`, moved to `∞`: the
subgroup of `ℂ` generated by the `σ(a)`, `a ∈ K`, such that `g (1, a; 0, 1) g⁻¹ ∈ Γ`. The function
`F ∣_k g` is periodic under it when `F` is invariant under `Γ`; for imaginary quadratic `K` and a
congruence subgroup `Γ`, such as `Γ₀(𝔑)`, it is a lattice in `ℂ`. -/
def cuspTranslations (g : SL(2, K)) : AddSubgroup ℂ :=
  .closure <| σ '' {a | ∃ γ ∈ Γ,
    (γ : Matrix (Fin 2) (Fin 2) (𝓞 K)).map (algebraMap (𝓞 K) K) =
      (g : Matrix (Fin 2) (Fin 2) K) * !![1, a; 0, 1] * (g⁻¹ : SL(2, K))}

/-- `F : ℋ₃ → ℂ^{k+1}` is **cuspidal** (LMFDB `mf.bianchi`, `mf.bianchi.spaces`) for the level
`Γ`: it vanishes at every cusp, that is the constant term of `F ∣_k g` vanishes for every
`g ∈ SL(2, K)`: `∫_{ℂ / Λ} (F ∣_k g)(x, y) dx = 0` for every `y > 0`, where `Λ` is the lattice of
translations fixing the cusp `g ∞`, the integral being over any fundamental domain of `Λ` (on which
`x ↦ (F ∣_k g)(x, y)` is integrable, as it is continuous and periodic for a form). -/
def IsBianchiCuspidal : Prop :=
  ∀ (g : SL(2, K)) (y : ℝ) (P : Set ℂ), 0 < y → IsAddFundamentalDomain (cuspTranslations σ Γ g) P →
    IntegrableOn (fun x ↦ extend (bianchiSlash k (SpecialLinearGroup.map σ g) F) (x, y)) P ∧
      ∫ x in P, extend (bianchiSlash k (SpecialLinearGroup.map σ g) F) (x, y) = 0

variable {k F} {G : HyperbolicThreeSpace → Fin (k + 1) → ℂ}

lemma extend_add : extend (F + G) = extend F + extend G := by
  ext p : 1
  by_cases hp : 0 < p.2 <;> simp [extend, hp]

lemma extend_smul (c : ℂ) : extend (c • F) = c • extend F := by
  ext p : 1
  by_cases hp : 0 < p.2 <;> simp [extend, hp]

lemma extend_zero : extend (0 : HyperbolicThreeSpace → Fin (k + 1) → ℂ) = 0 := by
  simpa using extend_smul (F := 0) 0

lemma bianchiSlash_zero (g : SL(2, ℂ)) : bianchiSlash k g 0 = 0 := by
  simpa using bianchiSlash_smul k g 0 0

lemma IsBianchiModularForm.add (hF : IsBianchiModularForm σ Γ k F)
    (hG : IsBianchiModularForm σ Γ k G) : IsBianchiModularForm σ Γ k (F + G) where
  analyticAt z := by
    rw [extend_add]
    exact (hF.analyticAt z).add (hG.analyticAt z)
  invariant γ hγ g s hg := by
    rw [bianchiSlash_add, hF.invariant γ hγ g s hg, hG.invariant γ hγ g s hg]
  harmonic := hF.harmonic.add hF.analyticAt hG.analyticAt hG.harmonic
  growth g := by
    rcases hF.growth g with ⟨C₁, n₁, h₁⟩
    rcases hG.growth g with ⟨C₂, n₂, h₂⟩
    refine ⟨|C₁| + |C₂|, n₁ + n₂, fun z hz ↦ ?_⟩
    have hy₁ : z.height ^ n₁ ≤ z.height ^ (n₁ + n₂) := pow_le_pow_right₀ hz (by omega)
    have hy₂ : z.height ^ n₂ ≤ z.height ^ (n₁ + n₂) := pow_le_pow_right₀ hz (by omega)
    have hp₁ : 0 ≤ z.height ^ n₁ := pow_nonneg z.height_pos.le n₁
    have hp₂ : 0 ≤ z.height ^ n₂ := pow_nonneg z.height_pos.le n₂
    rw [bianchiSlash_add]
    refine (norm_add_le _ _).trans ?_
    nlinarith [h₁ z hz, h₂ z hz, le_abs_self C₁, le_abs_self C₂, abs_nonneg C₁, abs_nonneg C₂]

lemma IsBianchiModularForm.const_smul (c : ℂ) (hF : IsBianchiModularForm σ Γ k F) :
    IsBianchiModularForm σ Γ k (c • F) where
  analyticAt z := by
    rw [extend_smul]
    exact (hF.analyticAt z).const_smul
  invariant γ hγ g s hg := by
    rw [bianchiSlash_smul, hF.invariant γ hγ g s hg]
  harmonic := hF.harmonic.const_smul c hF.analyticAt
  growth g := by
    rcases hF.growth g with ⟨C, n, h⟩
    refine ⟨‖c‖ * C, n, fun z hz ↦ ?_⟩
    rw [bianchiSlash_smul, Pi.smul_apply, norm_smul, mul_assoc]
    exact mul_le_mul_of_nonneg_left (h z hz) (norm_nonneg c)

lemma isBianchiModularForm_zero : IsBianchiModularForm σ Γ k 0 where
  analyticAt z := by
    rw [extend_zero]
    exact analyticAt_const
  invariant _ _ g _ _ := bianchiSlash_zero g
  harmonic := isBianchiHarmonic_zero k
  growth _ := ⟨0, 0, fun _ _ ↦ by simp [bianchiSlash_zero]⟩

lemma IsBianchiCuspidal.add (hF : IsBianchiCuspidal σ Γ k F) (hG : IsBianchiCuspidal σ Γ k G) :
    IsBianchiCuspidal σ Γ k (F + G) := by
  intro g y P hy hP
  rcases hF g y P hy hP with ⟨hiF, hF₀⟩
  rcases hG g y P hy hP with ⟨hiG, hG₀⟩
  simp only [bianchiSlash_add, extend_add, Pi.add_apply]
  exact ⟨hiF.add hiG, by rw [integral_add hiF hiG, hF₀, hG₀, add_zero]⟩

lemma IsBianchiCuspidal.const_smul (c : ℂ) (hF : IsBianchiCuspidal σ Γ k F) :
    IsBianchiCuspidal σ Γ k (c • F) := by
  intro g y P hy hP
  rcases hF g y P hy hP with ⟨hi, h₀⟩
  simp only [bianchiSlash_smul, extend_smul, Pi.smul_apply]
  exact ⟨hi.smul c, by rw [integral_smul, h₀, smul_zero]⟩

lemma isBianchiCuspidal_zero : IsBianchiCuspidal σ Γ k 0 := by
  intro _ _ _ _ _
  simp [bianchiSlash_zero, extend_zero]

variable (k)

/-- The space **`M_k(Γ)` of Bianchi modular forms** (LMFDB `mf.bianchi.spaces`) of weight `k` and
level `Γ`, such as `Γ₀(𝔑)`, over `K`, embedded in `ℂ` by `σ`, as a complex vector space. Its finite
dimension is a theorem, not proved here. -/
def bianchiModularForms : Submodule ℂ (HyperbolicThreeSpace → Fin (k + 1) → ℂ) where
  carrier := {F | IsBianchiModularForm σ Γ k F}
  add_mem' := IsBianchiModularForm.add σ Γ
  zero_mem' := isBianchiModularForm_zero σ Γ
  smul_mem' c _ hF := hF.const_smul σ Γ c

/-- The **cuspidal subspace `S_k(Γ)`** (LMFDB `mf.bianchi.spaces`) of the space of Bianchi modular
forms of weight `k` and level `Γ`: the forms that vanish at every cusp. -/
def bianchiCuspForms : Submodule ℂ (HyperbolicThreeSpace → Fin (k + 1) → ℂ) where
  carrier := {F | IsBianchiModularForm σ Γ k F ∧ IsBianchiCuspidal σ Γ k F}
  add_mem' hF hG := ⟨hF.1.add σ Γ hG.1, hF.2.add σ Γ hG.2⟩
  zero_mem' := ⟨isBianchiModularForm_zero σ Γ, isBianchiCuspidal_zero σ Γ⟩
  smul_mem' c _ hF := ⟨hF.1.const_smul σ Γ c, hF.2.const_smul σ Γ c⟩

lemma bianchiCuspForms_le : bianchiCuspForms σ Γ k ≤ bianchiModularForms σ Γ k :=
  fun _ hF ↦ hF.1

/-- `F : ℋ₃ → ℂ^{k+1}` has **sign** `ε` (LMFDB `mf.bianchi.sign`) at the principal level `(n)`,
`n ∈ 𝓞_K`, over `K` embedded in `ℂ` by `σ`: `F` is an eigenform of the **Fricke involution** `W_n`,
given by the matrix `(0, -1; n, 0)`, with eigenvalue `-ε`, that is `F ∣_k g = -ε F` for every
`g ∈ SL(2, ℂ)` representing the image of `W_n` in `PSL₂(ℂ)`. The LMFDB defines the sign for Bianchi
newforms of level `(n)`, which are eigenforms of `W_n`; newforms are not formalised here. -/
def HasBianchiSign (n : 𝓞 K) (ε : ℂ) : Prop :=
  ∀ (g : SL(2, ℂ)) (s : ℂ), (g : Matrix (Fin 2) (Fin 2) ℂ) = s⁻¹ • !![0, -1; σ n, 0] →
    bianchiSlash k g F = -ε • F

end HyperbolicThreeSpace
