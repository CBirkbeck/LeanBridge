import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Bianchi.HeckeOperator
import Mathlib.Analysis.Analytic.Constructions
import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# The Hecke algebra of Bianchi modular forms

Let `K` be an imaginary quadratic field, embedded in `ℂ` by `σ`, and `𝔑` a nonzero ideal of `𝒪_K`.
The Hecke operators of the double cosets `Γ₀(𝔑) α Γ₀(𝔑)`, `α ∈ GL₂(K)`, act on the functions
invariant under `Γ₀(𝔑)` (`Bianchi/HeckeOperator.lean`); this file shows that they map Bianchi
modular forms (LMFDB `mf.bianchi`) of weight `k` and level `Γ₀(𝔑)` to Bianchi modular forms, so that
they act on the space `M_k(Γ₀(𝔑))` (`bianchiModularForms`). Each slash operator `F ↦ F ∣_k g`
preserves real analyticity, as `g` acts on `ℋ₃` by a real analytic map; it preserves harmonicity,
as the lift of `F ∣_k g` to `SL(2, ℂ)` is the left translate by `g` of the lift of `F` and the
Casimir operators are left invariant; and it preserves polynomial growth at the cusps, as for
`β ∈ GL₂(K)` some `g' ∈ SL₂(K)` with first column proportional to that of `β` makes
`g'⁻¹β` upper triangular with a lower right entry of absolute value at most `1` after
normalisation, which does not lower heights.

The **Hecke algebra** `𝕋` (LMFDB `mf.bianchi.hecke_algebra`) of level `𝔑` is the subalgebra of the
endomorphisms of `M_k(Γ₀(𝔑))` generated by the Hecke operators `T_𝔭` of the nonzero primes `𝔭` of
`𝒪_K`, the operators of the double cosets `Γ₀(𝔑) diag(1, π) Γ₀(𝔑)` with `𝔭 = (π)`, following the
LMFDB's convention that `K` has class number `1`, that is that `𝒪_K` is a principal ideal domain.
For `𝔭 ∣ 𝔑` the operator `T_𝔭` is `U_𝔭`. The operators are normalised through `PSL(2, ℂ)`, which is
the arithmetic normalisation in weight `2`; in the knowl's weight `k > 2` the arithmetic `T_𝔭`
differs from this one by a power of `N𝔭`, which does not change `𝕋`. That `𝕋` is commutative and
preserves the cusp forms and the newspace, that in weight `2` it preserves the rational and integral
structures, that the `T_𝔭` with `𝔭 ∤ 𝔑` are self-adjoint on the cusp forms, with totally real
eigenvalues (algebraic integers in weight `2`), and that the newspace has a basis of eigenforms are
theorems, not proved here; `U_𝔭` is not self-adjoint in general.

## Main definitions

* `HyperbolicThreeSpace.bianchiHeckeOperatorModularForms` (LMFDB `mf.bianchi.hecke_algebra`): the
  Hecke operator of a double coset on `M_k(Γ₀(𝔑))`.
* `HyperbolicThreeSpace.bianchiIdealGenerator`: a generator of a nonzero ideal of `𝒪_K`.
* `HyperbolicThreeSpace.bianchiHeckeTPrime` (LMFDB `mf.bianchi.hecke_algebra`): the Hecke operator
  `T_𝔭` on `M_k(Γ₀(𝔑))`.
* `HyperbolicThreeSpace.bianchiHeckeAlgebra` (LMFDB `mf.bianchi.hecke_algebra`): the Hecke
  algebra `𝕋`.

## Main results

* `HyperbolicThreeSpace.analyticAt_extend_bianchiSlash`: the slash operators preserve real
  analyticity.
* `HyperbolicThreeSpace.IsBianchiHarmonic.bianchiSlash`: the slash operators preserve
  harmonicity.
* `HyperbolicThreeSpace.HasPolynomialGrowthAtCusps.bianchiSlash`: the slash operators of `GL₂(K)`
  preserve polynomial growth at the cusps.
* `HyperbolicThreeSpace.isBianchiModularForm_bianchiHeckeOperator`: the Hecke operators map Bianchi
  modular forms of level `Γ₀(𝔑)` to Bianchi modular forms of level `Γ₀(𝔑)`.
-/

open Complex Matrix NumberField HilbertModularGroup

open Submodule (IsPrincipal)

open scoped ComplexConjugate MatrixGroups Topology

namespace HyperbolicThreeSpace

variable {E E₁ E₂ V K : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup E₁]
  [NormedSpace ℝ E₁] [NormedAddCommGroup E₂] [NormedSpace ℝ E₂] [NormedAddCommGroup V]
  [NormedSpace ℂ V] [Field K] {e : E} {f : E → ℂ} {f₂ : E → E₁ × E₂} (b : Fin 3) (w : ℂ)
  (φ : SL(2, ℂ) → V) {σ : K →+* ℂ} {k : ℕ} (g : SL(2, ℂ)) {p : ℂ × ℝ}
  {F : HyperbolicThreeSpace → Fin (k + 1) → ℂ}

@[fun_prop]
private lemma analyticAt_conj_comp (hf : AnalyticAt ℝ f e) : AnalyticAt ℝ (fun y ↦ conj (f y)) e :=
  (conjCLE.toContinuousLinearMap.analyticAt (f e)).comp hf

@[fun_prop]
private lemma analyticAt_ofReal_comp {r : E → ℝ} (hr : AnalyticAt ℝ r e) :
    AnalyticAt ℝ (fun y ↦ (r y : ℂ)) e :=
  (ofRealCLM.analyticAt (r e)).comp hr

@[fun_prop]
private lemma analyticAt_normSq_comp (hf : AnalyticAt ℝ f e) :
    AnalyticAt ℝ (fun y ↦ normSq (f y)) e := by
  have hre : AnalyticAt ℝ (fun y ↦ (f y).re) e := (reCLM.analyticAt (f e)).comp hf
  have him : AnalyticAt ℝ (fun y ↦ (f y).im) e := (imCLM.analyticAt (f e)).comp hf
  simp only [normSq_apply]
  fun_prop

@[fun_prop]
private lemma analyticAt_fst_comp (hf₂ : AnalyticAt ℝ f₂ e) : AnalyticAt ℝ (fun y ↦ (f₂ y).1) e :=
  analyticAt_fst.comp hf₂

@[fun_prop]
private lemma analyticAt_snd_comp (hf₂ : AnalyticAt ℝ f₂ e) : AnalyticAt ℝ (fun y ↦ (f₂ y).2) e :=
  analyticAt_snd.comp hf₂

@[fun_prop]
lemma analyticAt_moebiusDenom : AnalyticAt ℝ (moebiusDenom g) p := by
  unfold moebiusDenom
  fun_prop

lemma analyticAt_moebius (hp : 0 < p.2) : AnalyticAt ℝ (moebius g) p := by
  have hN : moebiusDenom g p ≠ 0 := (moebiusDenom_pos g hp).ne'
  unfold moebius
  refine .prod ?_ ?_
  · fun_prop (disch := first | exact hN | exact ofReal_ne_zero.mpr hN)
  · fun_prop (disch := exact hN)

variable (k) in
lemma analyticAt_symPowMatrix_inv_automorphyFactor (hp : 0 < p.2) (i j : Fin (k + 1)) :
    AnalyticAt ℝ (fun q ↦ symPowMatrix k (automorphyFactor g q)⁻¹ i j) p := by
  have hN : moebiusDenom g p ≠ 0 := (moebiusDenom_pos g hp).ne'
  simp only [inv_automorphyFactor, symPowMatrix, of_apply, Matrix.smul_apply, cons_val_zero,
    cons_val_one]
  fun_prop (disch := first | exact hN | exact ofReal_ne_zero.mpr hN)

lemma extend_bianchiSlash_of_pos (hp : 0 < p.2) : extend (bianchiSlash k g F) p =
    symPowMatrix k (automorphyFactor g p)⁻¹ *ᵥ extend F (moebius g p) := by
  rw [extend, dite_eq_left hp, bianchiSlash, ← extend_coords (g • _) F, coords_smul]
  rfl

/-- **The slash operators preserve real analyticity**: if `F` is real analytic on `ℋ₃`, so is
`F ∣_k g`, as `g` acts on `ℋ₃` by a real analytic map. -/
lemma analyticAt_extend_bianchiSlash
    (hF : ∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend F) z.coords) :
    ∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend (bianchiSlash k g F)) z.coords := by
  intro z
  have hp : 0 < z.coords.2 := coords_snd_pos z
  have heq : extend (bianchiSlash k g F) =ᶠ[𝓝 z.coords] fun q ↦
      symPowMatrix k (automorphyFactor g q)⁻¹ *ᵥ extend F (moebius g q) := by
    filter_upwards [(isOpen_lt continuous_const continuous_snd).mem_nhds hp] with q hq
    exact extend_bianchiSlash_of_pos g hq
  refine .congr ?_ heq.symm
  have hE : AnalyticAt ℝ (fun q ↦ extend F (moebius g q)) z.coords := by
    have h₁ : AnalyticAt ℝ (extend F) (moebius g z.coords) := hF (g • z)
    exact h₁.comp (analyticAt_moebius g hp)
  refine analyticAt_pi_iff.mpr fun i ↦ ?_
  have hS (j : Fin (k + 1)) :
      AnalyticAt ℝ (fun q ↦ symPowMatrix k (automorphyFactor g q)⁻¹ i j) z.coords :=
    analyticAt_symPowMatrix_inv_automorphyFactor k g hp i j
  have hE' (j : Fin (k + 1)) : AnalyticAt ℝ (fun q ↦ extend F (moebius g q) j) z.coords :=
    analyticAt_pi_iff.mp hE j
  simp only [mulVec, dotProduct]
  fun_prop

lemma lieDeriv_mul_left : lieDeriv b w (fun h ↦ φ (g * h)) = fun h ↦ lieDeriv b w φ (g * h) := by
  ext h
  simp only [lieDeriv, mul_assoc]

lemma lieDerivOne_mul_left :
    lieDerivOne b (fun h ↦ φ (g * h)) = fun h ↦ lieDerivOne b φ (g * h) := by
  rw [lieDerivOne, lieDeriv_mul_left, lieDeriv_mul_left]
  rfl

lemma lieDerivTwo_mul_left :
    lieDerivTwo b (fun h ↦ φ (g * h)) = fun h ↦ lieDerivTwo b φ (g * h) := by
  rw [lieDerivTwo, lieDeriv_mul_left, lieDeriv_mul_left]
  rfl

lemma casimirOne_mul_left : casimirOne (fun h ↦ φ (g * h)) = fun h ↦ casimirOne φ (g * h) := by
  simp only [casimirOne, lieDerivOne_mul_left]
  rfl

lemma casimirTwo_mul_left : casimirTwo (fun h ↦ φ (g * h)) = fun h ↦ casimirTwo φ (g * h) := by
  simp only [casimirTwo, lieDerivTwo_mul_left]
  rfl

lemma bianchiLift_bianchiSlash :
    bianchiLift k (bianchiSlash k g F) = fun h ↦ bianchiLift k F (g * h) := by
  ext h : 1
  rw [bianchiLift, bianchiLift, bianchiSlash_mul]

/-- **The slash operators preserve harmonicity**: the lift of `F ∣_k g` to `SL(2, ℂ)` is the left
translate by `g` of the lift of `F`, and the Casimir operators commute with left translations. -/
lemma IsBianchiHarmonic.bianchiSlash (hF : IsBianchiHarmonic k F) :
    IsBianchiHarmonic k (bianchiSlash k g F) := by
  rw [IsBianchiHarmonic, bianchiLift_bianchiSlash, casimirOne_mul_left, casimirTwo_mul_left, hF.1,
    hF.2]
  exact ⟨rfl, rfl⟩

lemma height_smul_of_apply_one_zero (h₁₀ : g 1 0 = 0) (z : HyperbolicThreeSpace) :
    (g • z).height = z.height / normSq (g 1 1) := by
  have h₁ : (g • z).height = (moebius g z.coords).2 := rfl
  rw [h₁, moebius, moebiusDenom, h₁₀]
  simp only [zero_mul, zero_add, map_zero, add_zero]
  rfl

variable (p) in
lemma automorphyFactor_of_apply_one_zero (h₁₀ : g 1 0 = 0) :
    automorphyFactor g p = !![g 1 1, 0; 0, conj (g 1 1)] := by
  simp [automorphyFactor, h₁₀]

lemma exists_bound_bianchiSlash (h₁₀ : g 1 0 = 0) (h₁₁ : normSq (g 1 1) ≤ 1)
    (hF : ∃ (C : ℝ) (n : ℕ), ∀ z : HyperbolicThreeSpace, 1 ≤ z.height → ‖F z‖ ≤ C * z.height ^ n) :
    ∃ (C : ℝ) (n : ℕ), ∀ z : HyperbolicThreeSpace, 1 ≤ z.height →
      ‖bianchiSlash k g F z‖ ≤ C * z.height ^ n := by
  rcases hF with ⟨C, n, hC⟩
  have hd : g 1 1 ≠ 0 := fun hd ↦ by
    simpa [h₁₀, hd] using g.fin_two_mul_sub_mul_eq_one
  have hN : 0 < normSq (g 1 1) := normSq_pos.mpr hd
  let L : (Fin (k + 1) → ℂ) →L[ℂ] Fin (k + 1) → ℂ :=
    LinearMap.toContinuousLinearMap <| mulVecLin <| symPowMatrix k !![g 1 1, 0; 0, conj (g 1 1)]⁻¹
  refine ⟨‖L‖ * C / normSq (g 1 1) ^ n, n, fun z hz ↦ ?_⟩
  have hz' : 1 ≤ (g • z).height := by
    rw [height_smul_of_apply_one_zero g h₁₀]
    exact hz.trans (le_div_self (zero_le_one.trans hz) hN h₁₁)
  have h₁ : bianchiSlash k g F z = L (F (g • z)) := by
    rw [bianchiSlash, automorphyFactor_of_apply_one_zero g _ h₁₀]
    rfl
  rw [h₁]
  refine ((L.le_opNorm _).trans (mul_le_mul_of_nonneg_left (hC _ hz') (norm_nonneg L))).trans_eq ?_
  rw [height_smul_of_apply_one_zero g h₁₀, div_pow]
  ring1

lemma HasPolynomialGrowthAtCusps.add {G : HyperbolicThreeSpace → Fin (k + 1) → ℂ}
    (hF : HasPolynomialGrowthAtCusps σ k F) (hG : HasPolynomialGrowthAtCusps σ k G) :
    HasPolynomialGrowthAtCusps σ k (F + G) := by
  intro g
  rcases hF g with ⟨C₁, n₁, h₁⟩
  rcases hG g with ⟨C₂, n₂, h₂⟩
  refine ⟨|C₁| + |C₂|, n₁ + n₂, fun z hz ↦ ?_⟩
  have hy₁ : z.height ^ n₁ ≤ z.height ^ (n₁ + n₂) := pow_le_pow_right₀ hz (by omega)
  have hy₂ : z.height ^ n₂ ≤ z.height ^ (n₁ + n₂) := pow_le_pow_right₀ hz (by omega)
  have hp₁ : 0 ≤ z.height ^ n₁ := pow_nonneg z.height_pos.le n₁
  have hp₂ : 0 ≤ z.height ^ n₂ := pow_nonneg z.height_pos.le n₂
  rw [bianchiSlash_add]
  refine (norm_add_le _ _).trans ?_
  nlinarith [h₁ z hz, h₂ z hz, le_abs_self C₁, le_abs_self C₂, abs_nonneg C₁, abs_nonneg C₂]

/-- **The slash operators of `GL₂(K)` preserve polynomial growth at the cusps**: for `M ∈ SL(2, ℂ)`
representing `x ∈ GL₂(K)` and a cusp `g ∈ SL₂(K)`, a matrix `g' ∈ SL₂(K)` whose first column is a
small multiple of that of `β = xg` makes `g'⁻¹ M g` upper triangular with lower right entry of
absolute value at most `1`, which does not lower heights. -/
lemma HasPolynomialGrowthAtCusps.bianchiSlash (hF : HasPolynomialGrowthAtCusps σ k F)
    {x : GL (Fin 2) K} {M : SL(2, ℂ)} (hM : IsSLRepresentative σ x M) :
    HasPolynomialGrowthAtCusps σ k (bianchiSlash k M F) := by
  intro g
  rw [← bianchiSlash_mul]
  have hg : IsSLRepresentative σ (SpecialLinearGroup.toGL g) (SpecialLinearGroup.map σ g) :=
    ⟨1, by ext i j; simp⟩
  rcases hM.mul hg with ⟨s, hs⟩
  set β : GL (Fin 2) K := x * SpecialLinearGroup.toGL g
  have hs0 : s ≠ 0 := ne_zero_of_coe_eq_inv_smul hs
  have hs2 : σ (β 0 0 * β 1 1 - β 0 1 * β 1 0) = s ^ 2 := by
    have h₁ : ((M * SpecialLinearGroup.map σ g : SL(2, ℂ)) : Matrix (Fin 2) (Fin 2) ℂ).det = 1 :=
      SpecialLinearGroup.det_coe _
    rw [hs, det_smul, det_fin_two] at h₁
    simp only [map_apply, Fintype.card_fin] at h₁
    rw [map_sub, map_mul, map_mul]
    field_simp at h₁
    linear_combination h₁
  set m : ℕ := ⌈normSq s⌉₊ + 1 with hm
  have hm0 : (m : K) ≠ 0 := fun h ↦
    Nat.cast_add_one_ne_zero ⌈normSq s⌉₊ (by simpa [hm] using congrArg σ h)
  have hdet : β 0 0 * β 1 1 - β 0 1 * β 1 0 ≠ 0 := by
    rw [← det_fin_two]
    simpa using β.det.ne_zero
  have hcop : IsCoprime (β 0 0) (β 1 0) :=
    ⟨β 1 1 / (β 0 0 * β 1 1 - β 0 1 * β 1 0), -β 0 1 / (β 0 0 * β 1 1 - β 0 1 * β 1 0),
      by linear_combination mul_inv_cancel₀ hdet⟩
  have hu : IsUnit (m : K)⁻¹ := (inv_ne_zero hm0).isUnit
  rcases ((isCoprime_mul_units_left hu hu _ _).mpr hcop).exists_SL2_col 0 with ⟨g', h₀₀, h₁₀⟩
  rw [← mul_inv_cancel_left (SpecialLinearGroup.map σ g') (M * SpecialLinearGroup.map σ g),
    bianchiSlash_mul]
  have hent (i j : Fin 2) :
      ((M * SpecialLinearGroup.map σ g : SL(2, ℂ)) : Matrix (Fin 2) (Fin 2) ℂ) i j =
        s⁻¹ * σ (β i j) := by
    rw [hs]
    rfl
  have h₁ : ((SpecialLinearGroup.map σ g')⁻¹ * (M * SpecialLinearGroup.map σ g) : SL(2, ℂ)) 1 0 =
      0 := by
    rw [SpecialLinearGroup.coe_mul, SpecialLinearGroup.coe_inv, mul_apply, Fin.sum_univ_two,
      adjugate_fin_two, hent, hent]
    simp [h₀₀, h₁₀]
    ring1
  have h₂ : ((SpecialLinearGroup.map σ g')⁻¹ * (M * SpecialLinearGroup.map σ g) : SL(2, ℂ)) 1 1 =
      σ (m : K)⁻¹ * s := by
    rw [SpecialLinearGroup.coe_mul, SpecialLinearGroup.coe_inv, mul_apply, Fin.sum_univ_two,
      adjugate_fin_two, hent, hent]
    simp [h₀₀, h₁₀]
    rw [map_sub, map_mul, map_mul] at hs2
    linear_combination (norm := skip) (m : ℂ)⁻¹ * s⁻¹ * hs2
    field_simp
    ring1
  refine exists_bound_bianchiSlash _ h₁ ?_ (hF g')
  have hm1 : (1 : ℝ) ≤ m := by simp [hm]
  have hle : normSq s ≤ m := (Nat.le_ceil _).trans (by simp [hm])
  rw [h₂, normSq_mul, map_inv₀, map_natCast, normSq_inv, normSq_natCast,
    inv_mul_le_iff₀ (by positivity), mul_one]
  nlinarith

variable [IsTotallyComplex K] {𝔑 : Ideal (𝓞 K)}

lemma IsBianchiModularForm.mem_bianchiSlashInvariants (hF : IsBianchiModularForm σ 𝔑.gamma0GL k F) :
    F ∈ bianchiSlashInvariants σ k (bianchiGammaZero 𝔑) :=
  (isBianchiSlashInvariant_iff_mem 𝔑).mp hF.invariant

variable (σ k 𝔑) in
lemma bianchiModularForms_le_bianchiSlashInvariants :
    bianchiModularForms σ 𝔑.gamma0GL k ≤ bianchiSlashInvariants σ k (bianchiGammaZero 𝔑) :=
  fun _ hF ↦ IsBianchiModularForm.mem_bianchiSlashInvariants hF

variable (σ k 𝔑) [NumberField K] [NeZero 𝔑]
  (D : HeckeCoset (glTotallyPositive K) (bianchiGammaZero 𝔑) (bianchiGammaZero 𝔑))

attribute [local instance] Fintype.ofFinite

/-- **The Hecke operators preserve Bianchi modular forms**: the Hecke operator of a double coset
`Γ₀(𝔑) α Γ₀(𝔑)` maps a Bianchi modular form of weight `k` and level `Γ₀(𝔑)` to one, as each slash
operator of `GL₂(K)` preserves real analyticity, harmonicity and polynomial growth at the cusps. -/
lemma isBianchiModularForm_bianchiHeckeOperator (hF : IsBianchiModularForm σ 𝔑.gamma0GL k F) :
    IsBianchiModularForm σ 𝔑.gamma0GL k (bianchiHeckeOperator σ k (bianchiGammaZero 𝔑)
      (glTotallyPositive K) D ⟨F, hF.mem_bianchiSlashInvariants⟩) := by
  have hP : (∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend (bianchiHeckeOperator σ k
      (bianchiGammaZero 𝔑) (glTotallyPositive K) D ⟨F, hF.mem_bianchiSlashInvariants⟩ :
        HyperbolicThreeSpace → Fin (k + 1) → ℂ)) z.coords) ∧
      IsBianchiHarmonic k (bianchiHeckeOperator σ k (bianchiGammaZero 𝔑) (glTotallyPositive K) D
        ⟨F, hF.mem_bianchiSlashInvariants⟩ : HyperbolicThreeSpace → Fin (k + 1) → ℂ) ∧
      HasPolynomialGrowthAtCusps σ k (bianchiHeckeOperator σ k (bianchiGammaZero 𝔑)
        (glTotallyPositive K) D ⟨F, hF.mem_bianchiSlashInvariants⟩ :
          HyperbolicThreeSpace → Fin (k + 1) → ℂ) := by
    rw [coe_bianchiHeckeOperator]
    refine Finset.sum_induction _ (fun G : HyperbolicThreeSpace → Fin (k + 1) → ℂ ↦
      (∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend G) z.coords) ∧ IsBianchiHarmonic k G ∧
        HasPolynomialGrowthAtCusps σ k G) (fun G H hG hH ↦ ⟨fun z ↦ ?_,
          hG.2.1.add hG.1 hH.1 hH.2.1, hG.2.2.add hH.2.2⟩)
      ⟨fun z ↦ ?_, isBianchiHarmonic_zero k, fun _ ↦ ⟨0, 0, fun _ _ ↦ by simp [bianchiSlash_zero]⟩⟩
      fun v _ ↦ ⟨analyticAt_extend_bianchiSlash _ hF.analyticAt, hF.harmonic.bianchiSlash _,
        hF.growth.bianchiSlash (isSLRepresentative_slRepresentative _)⟩
    · rw [extend_add]
      exact (hG.1 z).add (hH.1 z)
    · rw [extend_zero]
      exact analyticAt_const
  exact ⟨hP.1, (isBianchiSlashInvariant_iff_mem 𝔑).mpr (bianchiHeckeOperator σ k
    (bianchiGammaZero 𝔑) (glTotallyPositive K) D ⟨F, hF.mem_bianchiSlashInvariants⟩).2, hP.2.1,
    hP.2.2⟩

/-- The **Hecke operator** (LMFDB `mf.bianchi.hecke_algebra`) of a double coset
`D = Γ₀(𝔑) α Γ₀(𝔑)`, `α ∈ GL₂(K)`, on the space `M_k(Γ₀(𝔑))` of Bianchi modular forms of weight `k`
and level `Γ₀(𝔑)` over a totally complex `K` embedded in `ℂ` by `σ`: `F ↦ ∑ᵢ F ∣_k gᵢ`, with
`D = ⊔ᵢ Γ₀(𝔑) αᵢ` and `gᵢ ∈ SL(2, ℂ)` representing `αᵢ`
(`isBianchiModularForm_bianchiHeckeOperator`). -/
noncomputable def bianchiHeckeOperatorModularForms :
    Module.End ℂ (bianchiModularForms σ 𝔑.gamma0GL k) :=
  LinearMap.codRestrict (bianchiModularForms σ 𝔑.gamma0GL k)
    ((bianchiSlashInvariants σ k (bianchiGammaZero 𝔑)).subtype ∘ₗ
      bianchiHeckeOperator σ k (bianchiGammaZero 𝔑) (glTotallyPositive K) D ∘ₗ
        Submodule.inclusion (bianchiModularForms_le_bianchiSlashInvariants σ k 𝔑))
    fun F ↦ isBianchiModularForm_bianchiHeckeOperator σ k 𝔑 D F.2

lemma coe_bianchiHeckeOperatorModularForms (Φ : bianchiModularForms σ 𝔑.gamma0GL k) :
    (bianchiHeckeOperatorModularForms σ k 𝔑 D Φ : HyperbolicThreeSpace → Fin (k + 1) → ℂ) =
      ∑ v, bianchiSlash k (slRepresentative σ (DoubleCoset.rightCosetRep D v)) Φ :=
  rfl

variable [IsPrincipalIdealRing (𝓞 K)] (𝔭 : Ideal (𝓞 K)) (h𝔭 : 𝔭 ≠ ⊥)

/-- A generator `π ∈ Kˣ` of a nonzero ideal `𝔭` of `𝒪_K`, a principal ideal domain. -/
noncomputable def bianchiIdealGenerator : Kˣ :=
  Units.mk0 (algebraMap (𝓞 K) K (IsPrincipal.generator 𝔭)) <|
    (map_ne_zero_iff _ RingOfIntegers.coe_injective).mpr fun h ↦
      h𝔭 ((IsPrincipal.eq_bot_iff_generator_eq_zero 𝔭).mpr h)

/-- The **Hecke operator `T_𝔭`** (LMFDB `mf.bianchi.hecke_algebra`) on the space `M_k(Γ₀(𝔑))` of
Bianchi modular forms of weight `k` and level `Γ₀(𝔑)`, for a nonzero prime `𝔭 = (π)` of `𝒪_K`, a
principal ideal domain as for the LMFDB's fields of class number `1`: the Hecke operator of the
double coset `Γ₀(𝔑) diag(1, π) Γ₀(𝔑)`, which only depends on `𝔭` (`bianchiHeckeT_mul_unit`). For
`𝔭 ∣ 𝔑` it is the operator `U_𝔭`. It is defined for every nonzero ideal `𝔭`, and is the Hecke
operator `T_𝔭` for the prime ones; it is normalised through `PSL(2, ℂ)`, which is the arithmetic
normalisation in weight `2` (`bianchiHeckeOperator`). -/
noncomputable def bianchiHeckeTPrime : Module.End ℂ (bianchiModularForms σ 𝔑.gamma0GL k) :=
  bianchiHeckeOperatorModularForms σ k 𝔑
    (heckeT 1 𝔑 (bianchiIdealGenerator 𝔭 h𝔭) (isTotallyPositive_of_isTotallyComplex _))

/-- The **Hecke algebra** `𝕋` (LMFDB `mf.bianchi.hecke_algebra`) of level `𝔑` and weight `k`: the
subalgebra of the endomorphisms of the space `M_k(Γ₀(𝔑))` of Bianchi modular forms generated by the
Hecke operators `T_𝔭` (`bianchiHeckeTPrime`) of the nonzero primes `𝔭` of `𝒪_K`, for a totally
complex `K` (imaginary quadratic for the LMFDB) whose ring of integers is a principal ideal domain,
as the LMFDB assumes. It does not depend on the normalisation of the `T_𝔭`. That it is commutative
and preserves the cusp forms and the newspace, and that the `T_𝔭` with `𝔭 ∤ 𝔑` are self-adjoint on
the cusp forms, are theorems not proved here. -/
noncomputable def bianchiHeckeAlgebra :
    Subalgebra ℂ (Module.End ℂ (bianchiModularForms σ 𝔑.gamma0GL k)) :=
  Algebra.adjoin ℂ (Set.range fun 𝔭 : {𝔭 : Ideal (𝓞 K) // 𝔭.IsPrime ∧ 𝔭 ≠ ⊥} ↦
    bianchiHeckeTPrime σ k 𝔑 𝔭.1 𝔭.2.2)

lemma bianchiHeckeTPrime_mem_bianchiHeckeAlgebra [𝔭.IsPrime] :
    bianchiHeckeTPrime σ k 𝔑 𝔭 h𝔭 ∈ bianchiHeckeAlgebra σ k 𝔑 :=
  Algebra.subset_adjoin ⟨⟨𝔭, inferInstance, h𝔭⟩, rfl⟩

end HyperbolicThreeSpace
