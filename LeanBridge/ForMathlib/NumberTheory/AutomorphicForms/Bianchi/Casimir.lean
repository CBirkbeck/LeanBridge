import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.Bianchi.Slash
import Mathlib.Analysis.Calculus.ContDiff.Operations
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.Calculus.Deriv.Prod
import Mathlib.Analysis.SpecialFunctions.ExpDeriv

/-!
# The Casimir operators of `SL(2, ℂ)` and harmonicity

The real Lie group `SL(2, ℂ)` has Lie algebra `𝔰𝔩₂(ℂ)`, viewed as a real Lie algebra of dimension
`6` with basis `H, E, F, iH, iE, iF`, where `H = (1, 0; 0, -1)`, `E = (0, 1; 0, 0)` and
`F = (0, 0; 1, 0)`. A vector `X` of it acts on functions `Φ` on `SL(2, ℂ)` by the left-invariant
differential operator `(XΦ)(g) = d/dt Φ(g exp(tX))|_{t=0}` (the right regular action). Its
complexification is `𝔰𝔩₂(ℂ) × 𝔰𝔩₂(ℂ)`, through `X ⊗ c ↦ (cX, cX̄)`; for a real matrix `B` of
`𝔰𝔩₂(ℂ)`, the elements `B₁ = (B ⊗ 1 - iB ⊗ i) / 2` and `B₂ = (B ⊗ 1 + iB ⊗ i) / 2` are `(B, 0)` and
`(0, B)`. The centre of the universal enveloping algebra is generated by the two **Casimir
operators** `Ψ = H₁² / 2 + E₁F₁ + F₁E₁` and `Ψ' = H₂² / 2 + E₂F₂ + F₂E₂`.

A function `F : ℋ₃ → ℂ^{k+1}` lifts to `Φ_F(g) = (F ∣_k g)(j)` on `SL(2, ℂ)`, where `j = (0, 1)`,
and is **harmonic** when `Ψ` and `Ψ'` act on `Φ_F` by the scalars by which they act on the
coefficient system of weight `k` forms.

## Main definitions

* `HyperbolicThreeSpace.lieDeriv`: the derivative of `Φ` along a one-parameter subgroup.
* `HyperbolicThreeSpace.casimirOne`, `HyperbolicThreeSpace.casimirTwo` (LMFDB `mf.bianchi`): the
  Casimir operators `Ψ` and `Ψ'`.
* `HyperbolicThreeSpace.bianchiLift`: the lift `Φ_F` of `F : ℋ₃ → ℂ^{k+1}` to `SL(2, ℂ)`.
* `HyperbolicThreeSpace.harmonicEigenvalue`: the scalar `(k² - 4) / 8` of the Casimir operators.
* `HyperbolicThreeSpace.IsBianchiHarmonic` (LMFDB `mf.bianchi`): harmonicity.
* `HyperbolicThreeSpace.IsLieSmooth`, `HyperbolicThreeSpace.IsLieDifferentiable`: smoothness and
  differentiability along one-parameter subgroups, which make the Casimir operators linear.

## Main results

* `HyperbolicThreeSpace.isLieSmooth_bianchiLift`: the lift of a real analytic function on `ℋ₃` is
  smooth along one-parameter subgroups, so harmonic real analytic functions form a vector space.
-/

open Complex Matrix TauCeti WithLp
open scoped ComplexConjugate MatrixGroups

namespace HyperbolicThreeSpace

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℂ V] (b : Fin 3) (w : ℂ)
  (Φ Φ₁ Φ₂ : SL(2, ℂ) → V)

/-- The one-parameter subgroups `w ↦ exp(wX)` of `SL(2, ℂ)` for the basis `X = H, E, F` of
`𝔰𝔩₂(ℂ)`: `exp(wH) = (e^w, 0; 0, e^{-w})`, `exp(wE) = (1, w; 0, 1)` and `exp(wF) = (1, 0; w, 1)`. -/
noncomputable def sl2Exp : Fin 3 → ℂ → SL(2, ℂ)
  | 0, w => ⟨!![exp w, 0; 0, exp (-w)], by simp [det_fin_two_of, ← exp_add]⟩
  | 1, w => ⟨!![1, w; 0, 1], by simp [det_fin_two_of]⟩
  | 2, w => ⟨!![1, 0; w, 1], by simp [det_fin_two_of]⟩

/-- The derivative `(XΦ)(g) = d/dt Φ(g exp(tX))|_{t=0}` of `Φ : SL(2, ℂ) → V` along `X = wB`, for
`w ∈ ℂ` and `B = H, E, F`: the action of the real Lie algebra `𝔰𝔩₂(ℂ)` on functions on `SL(2, ℂ)`
by left-invariant differential operators (the right regular action). -/
noncomputable def lieDeriv : SL(2, ℂ) → V :=
  fun g ↦ deriv (fun t : ℝ ↦ Φ (g * sl2Exp b (t * w))) 0

/-- The action `B₁Φ = (BΦ - i (iB)Φ) / 2` of the element `B₁ = (B ⊗ 1 - iB ⊗ i) / 2` of the
complexified Lie algebra, which is `(B, 0)` in `𝔰𝔩₂(ℂ) × 𝔰𝔩₂(ℂ)`, for `B = H, E, F`. -/
noncomputable def lieDerivOne : SL(2, ℂ) → V :=
  (2⁻¹ : ℂ) • (lieDeriv b 1 Φ - I • lieDeriv b I Φ)

/-- The action `B₂Φ = (BΦ + i (iB)Φ) / 2` of the element `B₂ = (B ⊗ 1 + iB ⊗ i) / 2` of the
complexified Lie algebra, which is `(0, B)` in `𝔰𝔩₂(ℂ) × 𝔰𝔩₂(ℂ)`, for `B = H, E, F`. -/
noncomputable def lieDerivTwo : SL(2, ℂ) → V :=
  (2⁻¹ : ℂ) • (lieDeriv b 1 Φ + I • lieDeriv b I Φ)

/-- The **Casimir operator** `Ψ = H₁² / 2 + E₁F₁ + F₁E₁` (LMFDB `mf.bianchi`) of the first factor
of the complexified Lie algebra `𝔰𝔩₂(ℂ) × 𝔰𝔩₂(ℂ)` of `SL(2, ℂ)`, acting on functions on `SL(2, ℂ)`
as a differential operator. With `Ψ'`, it generates the centre of the universal enveloping
algebra. -/
noncomputable def casimirOne : SL(2, ℂ) → V :=
  (2⁻¹ : ℂ) • lieDerivOne 0 (lieDerivOne 0 Φ) + lieDerivOne 1 (lieDerivOne 2 Φ) +
    lieDerivOne 2 (lieDerivOne 1 Φ)

/-- The **Casimir operator** `Ψ' = H₂² / 2 + E₂F₂ + F₂E₂` (LMFDB `mf.bianchi`) of the second
factor of the complexified Lie algebra `𝔰𝔩₂(ℂ) × 𝔰𝔩₂(ℂ)` of `SL(2, ℂ)`, acting on functions on
`SL(2, ℂ)` as a differential operator. -/
noncomputable def casimirTwo : SL(2, ℂ) → V :=
  (2⁻¹ : ℂ) • lieDerivTwo 0 (lieDerivTwo 0 Φ) + lieDerivTwo 1 (lieDerivTwo 2 Φ) +
    lieDerivTwo 2 (lieDerivTwo 1 Φ)

lemma sl2Exp_zero : sl2Exp b 0 = 1 := by
  fin_cases b <;> ext i j <;> fin_cases i <;> fin_cases j <;> simp [sl2Exp]

/-- `Φ : SL(2, ℂ) → V` is **smooth along one-parameter subgroups**: `(s, t) ↦ Φ(g e^{sX} e^{tY})` is
`C²` for all `g` and all `X, Y` in `ℂH ∪ ℂE ∪ ℂF`. This is what the Casimir operators need to be
linear; the lifts of real analytic functions on `ℋ₃` have it. -/
def IsLieSmooth : Prop :=
  ∀ (g : SL(2, ℂ)) (b₁ : Fin 3) (w₁ : ℂ) (b₂ : Fin 3) (w₂ : ℂ),
    ContDiff ℝ 2 fun st : ℝ × ℝ ↦ Φ (g * sl2Exp b₁ (st.1 * w₁) * sl2Exp b₂ (st.2 * w₂))

/-- `Φ : SL(2, ℂ) → V` is **differentiable along one-parameter subgroups** at the identity. -/
def IsLieDifferentiable : Prop :=
  ∀ (g : SL(2, ℂ)) (b : Fin 3) (w : ℂ), DifferentiableAt ℝ (fun t : ℝ ↦ Φ (g * sl2Exp b (t * w))) 0

variable {Φ Φ₁ Φ₂}

lemma IsLieDifferentiable.add (h₁ : IsLieDifferentiable Φ₁) (h₂ : IsLieDifferentiable Φ₂) :
    IsLieDifferentiable (Φ₁ + Φ₂) :=
  fun g b w ↦ (h₁ g b w).add (h₂ g b w)

lemma IsLieDifferentiable.const_smul (c : ℂ) (h : IsLieDifferentiable Φ) :
    IsLieDifferentiable (c • Φ) :=
  fun g b w ↦ (h g b w).const_smul c

lemma lieDeriv_add (h₁ : IsLieDifferentiable Φ₁) (h₂ : IsLieDifferentiable Φ₂) :
    lieDeriv b w (Φ₁ + Φ₂) = lieDeriv b w Φ₁ + lieDeriv b w Φ₂ :=
  funext fun g ↦ deriv_add (h₁ g b w) (h₂ g b w)

lemma lieDeriv_smul (c : ℂ) (h : IsLieDifferentiable Φ) :
    lieDeriv b w (c • Φ) = c • lieDeriv b w Φ :=
  funext fun g ↦ deriv_const_smul c (h g b w)

lemma lieDerivOne_add (h₁ : IsLieDifferentiable Φ₁) (h₂ : IsLieDifferentiable Φ₂) :
    lieDerivOne b (Φ₁ + Φ₂) = lieDerivOne b Φ₁ + lieDerivOne b Φ₂ := by
  rw [lieDerivOne, lieDerivOne, lieDerivOne, lieDeriv_add _ _ h₁ h₂, lieDeriv_add _ _ h₁ h₂]
  module

lemma lieDerivTwo_add (h₁ : IsLieDifferentiable Φ₁) (h₂ : IsLieDifferentiable Φ₂) :
    lieDerivTwo b (Φ₁ + Φ₂) = lieDerivTwo b Φ₁ + lieDerivTwo b Φ₂ := by
  rw [lieDerivTwo, lieDerivTwo, lieDerivTwo, lieDeriv_add _ _ h₁ h₂, lieDeriv_add _ _ h₁ h₂]
  module

lemma lieDerivOne_smul (c : ℂ) (h : IsLieDifferentiable Φ) :
    lieDerivOne b (c • Φ) = c • lieDerivOne b Φ := by
  rw [lieDerivOne, lieDerivOne, lieDeriv_smul _ _ c h, lieDeriv_smul _ _ c h]
  module

lemma lieDerivTwo_smul (c : ℂ) (h : IsLieDifferentiable Φ) :
    lieDerivTwo b (c • Φ) = c • lieDerivTwo b Φ := by
  rw [lieDerivTwo, lieDerivTwo, lieDeriv_smul _ _ c h, lieDeriv_smul _ _ c h]
  module

lemma IsLieSmooth.isLieDifferentiable (h : IsLieSmooth Φ) : IsLieDifferentiable Φ := by
  intro g b w
  have hd : DifferentiableAt ℝ (fun t : ℝ ↦ Φ (g * sl2Exp b (0 * 0) * sl2Exp b (t * w))) 0 :=
    ((h g b 0 b w).comp (contDiff_prodMk_right 0)).differentiable two_ne_zero 0
  simpa [sl2Exp_zero] using hd

lemma IsLieSmooth.isLieDifferentiable_lieDeriv (h : IsLieSmooth Φ) :
    IsLieDifferentiable (lieDeriv b w Φ) := by
  intro g b' w'
  have hΨ : ContDiff ℝ 2 fun st : ℝ × ℝ ↦ Φ (g * sl2Exp b' (st.1 * w') * sl2Exp b (st.2 * w)) :=
    h g b' w' b w
  have he : (fun s : ℝ ↦ lieDeriv b w Φ (g * sl2Exp b' (s * w'))) = fun s ↦ fderiv ℝ
      (fun st : ℝ × ℝ ↦ Φ (g * sl2Exp b' (st.1 * w') * sl2Exp b (st.2 * w))) (s, 0) (0, 1) :=
    funext fun s ↦ (((hΨ.differentiable two_ne_zero) (s, 0)).hasFDerivAt.comp_hasDerivAt (0 : ℝ)
      ((hasDerivAt_const (0 : ℝ) s).prodMk (hasDerivAt_id (0 : ℝ)))).deriv
  rw [he]
  exact (((hΨ.fderiv_right le_rfl).comp (contDiff_prodMk_left 0)).clm_apply
    contDiff_const).differentiable one_ne_zero 0

lemma IsLieDifferentiable.sub (h₁ : IsLieDifferentiable Φ₁) (h₂ : IsLieDifferentiable Φ₂) :
    IsLieDifferentiable (Φ₁ - Φ₂) :=
  fun g b w ↦ (h₁ g b w).sub (h₂ g b w)

lemma IsLieSmooth.add (h₁ : IsLieSmooth Φ₁) (h₂ : IsLieSmooth Φ₂) : IsLieSmooth (Φ₁ + Φ₂) :=
  fun g b₁ w₁ b₂ w₂ ↦ (h₁ g b₁ w₁ b₂ w₂).add (h₂ g b₁ w₁ b₂ w₂)

lemma IsLieSmooth.const_smul (c : ℂ) (h : IsLieSmooth Φ) : IsLieSmooth (c • Φ) :=
  fun g b₁ w₁ b₂ w₂ ↦ (h g b₁ w₁ b₂ w₂).const_smul c

lemma IsLieSmooth.isLieDifferentiable_lieDerivOne (h : IsLieSmooth Φ) :
    IsLieDifferentiable (lieDerivOne b Φ) :=
  ((h.isLieDifferentiable_lieDeriv b 1).sub
    ((h.isLieDifferentiable_lieDeriv b I).const_smul I)).const_smul _

lemma IsLieSmooth.isLieDifferentiable_lieDerivTwo (h : IsLieSmooth Φ) :
    IsLieDifferentiable (lieDerivTwo b Φ) :=
  ((h.isLieDifferentiable_lieDeriv b 1).add
    ((h.isLieDifferentiable_lieDeriv b I).const_smul I)).const_smul _

lemma casimirOne_add (h₁ : IsLieSmooth Φ₁) (h₂ : IsLieSmooth Φ₂) :
    casimirOne (Φ₁ + Φ₂) = casimirOne Φ₁ + casimirOne Φ₂ := by
  have hi (b : Fin 3) : lieDerivOne b (Φ₁ + Φ₂) = lieDerivOne b Φ₁ + lieDerivOne b Φ₂ :=
    lieDerivOne_add b h₁.isLieDifferentiable h₂.isLieDifferentiable
  have ho (b b' : Fin 3) : lieDerivOne b (lieDerivOne b' Φ₁ + lieDerivOne b' Φ₂) =
      lieDerivOne b (lieDerivOne b' Φ₁) + lieDerivOne b (lieDerivOne b' Φ₂) :=
    lieDerivOne_add b (h₁.isLieDifferentiable_lieDerivOne b')
      (h₂.isLieDifferentiable_lieDerivOne b')
  simp only [casimirOne, hi, ho]
  module

lemma casimirTwo_add (h₁ : IsLieSmooth Φ₁) (h₂ : IsLieSmooth Φ₂) :
    casimirTwo (Φ₁ + Φ₂) = casimirTwo Φ₁ + casimirTwo Φ₂ := by
  have hi (b : Fin 3) : lieDerivTwo b (Φ₁ + Φ₂) = lieDerivTwo b Φ₁ + lieDerivTwo b Φ₂ :=
    lieDerivTwo_add b h₁.isLieDifferentiable h₂.isLieDifferentiable
  have ho (b b' : Fin 3) : lieDerivTwo b (lieDerivTwo b' Φ₁ + lieDerivTwo b' Φ₂) =
      lieDerivTwo b (lieDerivTwo b' Φ₁) + lieDerivTwo b (lieDerivTwo b' Φ₂) :=
    lieDerivTwo_add b (h₁.isLieDifferentiable_lieDerivTwo b')
      (h₂.isLieDifferentiable_lieDerivTwo b')
  simp only [casimirTwo, hi, ho]
  module

lemma casimirOne_smul (c : ℂ) (h : IsLieSmooth Φ) : casimirOne (c • Φ) = c • casimirOne Φ := by
  have hi (b : Fin 3) : lieDerivOne b (c • Φ) = c • lieDerivOne b Φ :=
    lieDerivOne_smul b c h.isLieDifferentiable
  have ho (b b' : Fin 3) :
      lieDerivOne b (c • lieDerivOne b' Φ) = c • lieDerivOne b (lieDerivOne b' Φ) :=
    lieDerivOne_smul b c (h.isLieDifferentiable_lieDerivOne b')
  simp only [casimirOne, hi, ho]
  module

lemma casimirTwo_smul (c : ℂ) (h : IsLieSmooth Φ) : casimirTwo (c • Φ) = c • casimirTwo Φ := by
  have hi (b : Fin 3) : lieDerivTwo b (c • Φ) = c • lieDerivTwo b Φ :=
    lieDerivTwo_smul b c h.isLieDifferentiable
  have ho (b b' : Fin 3) :
      lieDerivTwo b (c • lieDerivTwo b' Φ) = c • lieDerivTwo b (lieDerivTwo b' Φ) :=
    lieDerivTwo_smul b c (h.isLieDifferentiable_lieDerivTwo b')
  simp only [casimirTwo, hi, ho]
  module

variable (k : ℕ) (F : HyperbolicThreeSpace → Fin (k + 1) → ℂ)

/-- The point `j = (0, 1)` of hyperbolic 3-space, fixed by `SU(2)`. -/
noncomputable def basePoint : HyperbolicThreeSpace :=
  .mk (toLp 2 (0, 1)) one_pos

/-- The **lift** `Φ_F(g) = (F ∣_k g)(j)` of `F : ℋ₃ → ℂ^{k+1}` to `SL(2, ℂ)`. It is left invariant
under `γ` when `F ∣_k γ = F`, and `Φ_F(gu) = Sym^k(J(u, j)⁻¹) Φ_F(g)` for `u ∈ SU(2)`. -/
noncomputable def bianchiLift : SL(2, ℂ) → Fin (k + 1) → ℂ :=
  fun g ↦ bianchiSlash k g F basePoint

/-- The scalar `(k² - 4) / 8` by which the Casimir operators act on the lifts of Bianchi modular
forms of weight `k`. For even `k`, these lifts generate automorphic representations with the
infinitesimal character of the coefficient system `Sym^n ⊗ conj(Sym^n)`, `n = (k - 2) / 2`, whose
minimal `SU(2)`-type is `Sym^{2n+2} = Sym^k`, and each Casimir operator acts on `Sym^n` by
`n (n + 2) / 2 = (k² - 4) / 8`. -/
noncomputable def harmonicEigenvalue : ℂ :=
  ((k : ℂ) ^ 2 - 4) / 8

/-- A function `F : ℋ₃ → ℂ^{k+1}` is **harmonic** (LMFDB `mf.bianchi`) when the Casimir operators
`Ψ` and `Ψ'` act on its lift `Φ_F` to `SL(2, ℂ)` by the scalar `(k² - 4) / 8`, that is
`(Ψ - (k² - 4) / 8) Φ_F = (Ψ' - (k² - 4) / 8) Φ_F = 0`.

The LMFDB writes `ΨF = Ψ'F = 0`, which is this condition in weight `2`, the weight of all its
Bianchi forms. In weight `k > 2`, the Casimir operators do not annihilate the lifts of cohomological
forms but act by the scalar of the coefficient system, so `Ψ` and `Ψ'` are shifted by it here. -/
def IsBianchiHarmonic : Prop :=
  casimirOne (bianchiLift k F) = harmonicEigenvalue k • bianchiLift k F ∧
    casimirTwo (bianchiLift k F) = harmonicEigenvalue k • bianchiLift k F

lemma bianchiLift_apply (g : SL(2, ℂ)) : bianchiLift k F g =
    symPowMatrix k (automorphyFactor g (0, 1))⁻¹ *ᵥ extend F (moebius g (0, 1)) := by
  rw [bianchiLift, bianchiSlash, ← extend_coords (g • basePoint) F, coords_smul]
  rfl

lemma bianchiLift_add (G : HyperbolicThreeSpace → Fin (k + 1) → ℂ) :
    bianchiLift k (F + G) = bianchiLift k F + bianchiLift k G :=
  funext fun g ↦ congrFun (bianchiSlash_add k g F G) basePoint

lemma bianchiLift_smul (c : ℂ) : bianchiLift k (c • F) = c • bianchiLift k F :=
  funext fun g ↦ congrFun (bianchiSlash_smul k g F c) basePoint

@[fun_prop]
private lemma contDiff_conj {n : WithTop ℕ∞} : ContDiff ℝ n fun z : ℂ ↦ conj z :=
  conjCLE.contDiff

@[fun_prop]
private lemma contDiff_normSq {n : WithTop ℕ∞} : ContDiff ℝ n fun z : ℂ ↦ normSq z := by
  simpa [normSq_eq_norm_sq] using contDiff_norm_sq ℝ (E := ℂ) (n := n)

@[fun_prop]
private lemma contDiff_ofReal {n : WithTop ℕ∞} : ContDiff ℝ n fun x : ℝ ↦ (x : ℂ) :=
  ofRealCLM.contDiff

private lemma contDiff_sl2Exp_apply (i j : Fin 2) :
    ContDiff ℝ 2 fun s : ℝ ↦ (sl2Exp b (s * w) : Matrix (Fin 2) (Fin 2) ℂ) i j := by
  fin_cases b <;> fin_cases i <;> fin_cases j <;> simp [sl2Exp] <;> fun_prop

private lemma contDiff_mul_apply {γ₁ γ₂ : ℝ × ℝ → SL(2, ℂ)}
    (h₁ : ∀ i j, ContDiff ℝ 2 fun st ↦ (γ₁ st : Matrix (Fin 2) (Fin 2) ℂ) i j)
    (h₂ : ∀ i j, ContDiff ℝ 2 fun st ↦ (γ₂ st : Matrix (Fin 2) (Fin 2) ℂ) i j) (i j : Fin 2) :
    ContDiff ℝ 2 fun st ↦ ((γ₁ st * γ₂ st : SL(2, ℂ)) : Matrix (Fin 2) (Fin 2) ℂ) i j := by
  simp only [SpecialLinearGroup.coe_mul, mul_apply, Fin.sum_univ_two]
  exact ((h₁ i 0).mul (h₂ 0 j)).add ((h₁ i 1).mul (h₂ 1 j))

variable {k F} in
private lemma contDiff_bianchiLift_comp
    (hF : ∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend F) z.coords) (γ : ℝ × ℝ → SL(2, ℂ))
    (hγ : ∀ i j, ContDiff ℝ 2 fun st ↦ (γ st : Matrix (Fin 2) (Fin 2) ℂ) i j) :
    ContDiff ℝ 2 fun st ↦ bianchiLift k F (γ st) := by
  have h₀₀ : ContDiff ℝ 2 fun st ↦ (γ st : Matrix (Fin 2) (Fin 2) ℂ) 0 0 := hγ 0 0
  have h₀₁ : ContDiff ℝ 2 fun st ↦ (γ st : Matrix (Fin 2) (Fin 2) ℂ) 0 1 := hγ 0 1
  have h₁₀ : ContDiff ℝ 2 fun st ↦ (γ st : Matrix (Fin 2) (Fin 2) ℂ) 1 0 := hγ 1 0
  have h₁₁ : ContDiff ℝ 2 fun st ↦ (γ st : Matrix (Fin 2) (Fin 2) ℂ) 1 1 := hγ 1 1
  have hN (st : ℝ × ℝ) : moebiusDenom (γ st) (0, 1) ≠ 0 :=
    (moebiusDenom_pos (γ st) (p := (0, 1)) one_pos).ne'
  have hD : ContDiff ℝ 2 fun st ↦ moebiusDenom (γ st) (0, 1) := by
    simp only [moebiusDenom]
    fun_prop
  have hM : ContDiff ℝ 2 fun st ↦ moebius (γ st) (0, 1) := by
    simp only [moebius, div_eq_mul_inv, ← ofReal_inv]
    fun_prop (disch := first | exact hN | exact hN _)
  have hE : ContDiff ℝ 2 fun st ↦ extend F (moebius (γ st) (0, 1)) :=
    contDiff_iff_contDiffAt.2 fun x ↦
      ContDiffAt.comp (g := extend F) x (hF (γ x • basePoint)).contDiffAt hM.contDiffAt
  simp only [bianchiLift_apply, inv_automorphyFactor]
  refine contDiff_pi.2 fun i ↦ ?_
  simp only [mulVec, dotProduct]
  refine ContDiff.sum fun j _ ↦ ContDiff.mul ?_ (contDiff_pi.1 hE j)
  simp only [symPowMatrix, of_apply, Matrix.smul_apply, cons_val_zero, cons_val_one, ← ofReal_inv]
  fun_prop (disch := first | exact hN | exact hN _)

variable {k F} in
/-- The lift of a real analytic function on `ℋ₃` to `SL(2, ℂ)` is smooth along one-parameter
subgroups, so that the Casimir operators act linearly on such lifts. -/
lemma isLieSmooth_bianchiLift (hF : ∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend F) z.coords) :
    IsLieSmooth (bianchiLift k F) := by
  intro g b₁ w₁ b₂ w₂
  exact contDiff_bianchiLift_comp hF _ <| contDiff_mul_apply
    (contDiff_mul_apply (fun _ _ ↦ contDiff_const) fun i j ↦
      (contDiff_sl2Exp_apply b₁ w₁ i j).comp contDiff_fst)
    fun i j ↦ (contDiff_sl2Exp_apply b₂ w₂ i j).comp contDiff_snd

lemma isBianchiHarmonic_zero : IsBianchiHarmonic k 0 := by
  have h : bianchiLift k 0 = 0 := by
    simpa using bianchiLift_smul k 0 0
  have h₀ (b : Fin 3) (w : ℂ) : lieDeriv b w (0 : SL(2, ℂ) → Fin (k + 1) → ℂ) = 0 :=
    funext fun _ ↦ deriv_const 0 0
  simp [IsBianchiHarmonic, h, casimirOne, casimirTwo, lieDerivOne, lieDerivTwo, h₀]

variable {k F} {G : HyperbolicThreeSpace → Fin (k + 1) → ℂ}

lemma IsBianchiHarmonic.add (hF : ∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend F) z.coords)
    (hG : ∀ z : HyperbolicThreeSpace, AnalyticAt ℝ (extend G) z.coords) (h₁ : IsBianchiHarmonic k F)
    (h₂ : IsBianchiHarmonic k G) : IsBianchiHarmonic k (F + G) := by
  rw [IsBianchiHarmonic, bianchiLift_add,
    casimirOne_add (isLieSmooth_bianchiLift hF) (isLieSmooth_bianchiLift hG),
    casimirTwo_add (isLieSmooth_bianchiLift hF) (isLieSmooth_bianchiLift hG), h₁.1, h₁.2, h₂.1,
    h₂.2, smul_add]
  exact ⟨rfl, rfl⟩

lemma IsBianchiHarmonic.const_smul (c : ℂ) (hF : ∀ z : HyperbolicThreeSpace,
    AnalyticAt ℝ (extend F) z.coords) (h : IsBianchiHarmonic k F) :
    IsBianchiHarmonic k (c • F) := by
  rw [IsBianchiHarmonic, bianchiLift_smul, casimirOne_smul c (isLieSmooth_bianchiLift hF),
    casimirTwo_smul c (isLieSmooth_bianchiLift hF), h.1, h.2, smul_comm c]
  exact ⟨rfl, rfl⟩

end HyperbolicThreeSpace
