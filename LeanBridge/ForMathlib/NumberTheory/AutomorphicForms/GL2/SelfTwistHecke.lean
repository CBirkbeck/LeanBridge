import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.GL2.ComplexMultiplication
import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.GL2.SphericalAverage

/-!
# The spherical vectors of the representation generated by a Hecke eigenform

Let `φ` be a function on `GL₂(𝔸_F)`, smooth at infinity and spherical at a finite place `v`, and let
`π_φ` be the representation it generates. The operator `T_v` acts on every vector of `π_φ` spherical
at `v` by the eigenvalue of `φ`. This gives the implication "equal to its twist implies
`a_v = χ(v) a_v`" of LMFDB `mf.cm`.

The proof is local at `v`. If a set `𝒰` of functions spherical at `v` contains `φ` and is stable
under the operators generating `π_φ` away from `v`, then `π_φ` lies in the span `𝒜(𝒰)` of the
translates of `𝒰` by `GL₂(F_v)`. On `𝒜(𝒰)` one averages over `K = GL₂(𝒪_v)`.

* The average twisted by `k ↦ χ_v(det k)` vanishes on `𝒜(𝒰)` if `χ` is ramified at `v`, whereas it
  fixes the twist `φ ⊗ χ`. So a self twist is unramified at `v`.
* The Hecke sum commutes with the spherical averages by Gelfand's trick: the transpose preserves
  each double coset `K y K`, which forces the averaging operators to commute (see
  `Subgroup.sphericalAverage_comm`). So if `T_v u = a u` on `𝒰`, then `T_v (E w) = a E w` for
  `E w : g ↦ ∫_K w(g k) dk` and `w ∈ 𝒜(𝒰)`, and `E w = w` when `w` is spherical at `v`.

## Main definitions

* `AdelicGL2.localSpan`: the span `𝒜(𝒰)`.
* `AdelicGL2.IsStableAwayFrom`: the stability conditions on `𝒰`.
* `AdelicGL2.sphericalFunctions`, `AdelicGL2.sphericalEigenfunctions`: the two choices of `𝒰`.
* `AdelicGL2.localAverage`: the average `E w`.
* `AdelicGL2.detCharacter`: the character `k ↦ χ_v(det k)` of `GL₂(𝒪_v)`.

## Main results

* `AdelicGL2.generatedRep_le_localSpan`: `π_φ ≤ 𝒜(𝒰)`.
* `AdelicGL2.heckeOp_eq_smul_of_mem_generatedRep`: `T_v` acts on the spherical vectors of `π_φ` by
  the eigenvalue of `φ`.
* `AdelicGL2.IsSelfTwist.conductorExponent_eq_zero`: a self twist is unramified at the good
  primes.
* `AdelicGL2.IsSelfTwist.heckeEigenvalue_eq` (LMFDB `mf.cm`): `a_v = χ(v) a_v`.
* `AdelicGL2.IsSelfTwist.heckeEigenvalue_eq_zero` (LMFDB `mf.cm`): `a_v = 0` where `χ(v) ≠ 1`.
* `AdelicGL2.HasCMBy.hasCMEigenvalues` (LMFDB `mf.cm`): complex multiplication by `χ` implies the
  condition on the eigenvalues.
-/

open IsDedekindDomain HeightOneSpectrum Matrix NumberField MeasureTheory TauCeti GlobalNumberFields
  ValuationSubring

open mixedEmbedding (mixedSpace)

open scoped AdeleRing MatrixGroups Classical

namespace AdelicGL2

variable {F : Type*} [Field F] [NumberField F] {v : HeightOneSpectrum (𝓞 F)}
  {χ ω : HeckeCharacter F} {φ u w : AdelicGL2 F → ℂ} {a : ℂ} {𝔑 : Ideal (𝓞 F)} (b : Fin 3)
  (x₀ : GL (Fin 2) (mixedSpace F))

lemma IsSmoothOnGL.mul_right {Φ : GL (Fin 2) (mixedSpace F) → ℂ} (hΦ : IsSmoothOnGL Φ) :
    IsSmoothOnGL fun x ↦ Φ (x * x₀) := by
  have hmul : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      fun (m : Fin 2 → Fin 2 → mixedSpace F) (i j : Fin 2) ↦
        (of m * (x₀ : Matrix (Fin 2) (Fin 2) (mixedSpace F))) i j := by
    refine contDiff_pi.mpr fun i ↦ contDiff_pi.mpr fun j ↦ ?_
    simp only [Matrix.mul_apply, of_apply]
    exact ContDiff.sum fun l _ ↦ (contDiff_apply_apply ℝ i l).mul contDiff_const
  have hmaps : Set.MapsTo (fun (m : Fin 2 → Fin 2 → mixedSpace F) (i j : Fin 2) ↦
      (of m * (x₀ : Matrix (Fin 2) (Fin 2) (mixedSpace F))) i j) {m | IsUnit (of m)}
      {m | IsUnit (of m)} :=
    fun _ hm ↦ IsUnit.mul hm x₀.isUnit
  refine (hΦ.comp hmul.contDiffOn hmaps).congr fun m hm ↦ ?_
  rw [extendGL_of_isUnit _ hm, Function.comp, extendGL_of_isUnit _ (hmaps hm)]
  exact congrArg Φ (Units.ext rfl)

lemma IsSmoothAtInfinity.rightTranslate_ofInf (h : IsSmoothAtInfinity φ) :
    IsSmoothAtInfinity (rightTranslate (ofInf F x₀) φ) := fun g ↦ by
  have he : (fun x ↦ rightTranslate (ofInf F x₀) φ (g * ofInf F x)) =
      fun x ↦ φ (g * ofInf F (x * x₀)) :=
    funext fun x ↦ by
      rw [rightTranslate, map_mul, mul_assoc]
  rw [he]
  exact (h g).mul_right x₀

lemma lieDeriv_sum (y : mixedSpace F) {ι : Type*} (s : Finset ι) {f : ι → AdelicGL2 F → ℂ}
    (hf : ∀ i ∈ s, IsSmoothAtInfinity (f i)) :
    lieDeriv b y (∑ i ∈ s, f i) = ∑ i ∈ s, lieDeriv b y (f i) :=
  funext fun g ↦ by
    simp only [lieDeriv, Finset.sum_apply]
    exact (HasDerivAt.fun_sum fun i hi ↦ (hf i hi).hasDerivAt b y g).deriv

lemma IsSphericalAt.rightTranslate_ofFin {y : GL (Fin 2) 𝔸ᶠ[F]} (hy : atPlace v y = 1)
    (h : IsSphericalAt v u) : IsSphericalAt v (rightTranslate (ofFin F y) u) := fun k hk g ↦ by
  rw [rightTranslate, mul_assoc, ← map_mul, localGL_commute hy, map_mul, ← mul_assoc, h k hk]
  rfl

lemma IsSphericalAt.rightTranslate_ofInf (h : IsSphericalAt v u) :
    IsSphericalAt v (rightTranslate (ofInf F x₀) u) := fun k hk g ↦ by
  rw [rightTranslate, mul_assoc, ofFin_mul_ofInf, ← mul_assoc, h k hk]
  rfl

lemma IsSphericalAt.lieDeriv (y : mixedSpace F) (h : IsSphericalAt v u) :
    IsSphericalAt v (lieDeriv b y u) := fun k hk g ↦ by
  simp only [AdelicGL2.lieDeriv]
  refine congrArg (deriv · 0) (funext fun t ↦ ?_)
  rw [mul_assoc, ofFin_mul_ofInf, ← mul_assoc, h k hk]

lemma heckeOp_rightTranslate_ofInf (ψ : AdelicGL2 F → ℂ) :
    heckeOp v (rightTranslate (ofInf F x₀) ψ) = rightTranslate (ofInf F x₀) (heckeOp v ψ) :=
  funext fun g ↦ by
    simp only [heckeOp, heckeSum, rightTranslate, mul_assoc, ofFin_mul_ofInf]

lemma heckeOp_lieDeriv (y : mixedSpace F) (h : IsSmoothAtInfinity φ) :
    heckeOp v (lieDeriv b y φ) = lieDeriv b y (heckeOp v φ) := by
  rw [heckeOp_eq_sum_rightTranslate, heckeOp_eq_sum_rightTranslate,
    lieDeriv_sum b y _ fun o _ ↦ h.rightTranslate_ofFin _]
  exact Finset.sum_congr rfl fun o _ ↦ (lieDeriv_rightTranslate_ofFin b y _ φ).symm

lemma heckeOp_add (φ₁ φ₂ : AdelicGL2 F → ℂ) : heckeOp v (φ₁ + φ₂) = heckeOp v φ₁ + heckeOp v φ₂ :=
  funext fun g ↦ by
    simp only [heckeOp, heckeSum, Pi.add_apply, Finset.sum_add_distrib]

variable (φ) in
lemma heckeOp_smul (c : ℂ) : heckeOp v (c • φ) = c • heckeOp v φ :=
  funext fun g ↦ by
    simp only [heckeOp, heckeSum, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]

variable (v) in
/-- The span **`𝒜(𝒰)`** of the right translates `g ↦ u(g m)` of a set `𝒰` of functions on
`GL₂(𝔸_F)` by the matrices `m` of `GL₂(F_v)`. -/
noncomputable def localSpan (𝒰 : Set (AdelicGL2 F → ℂ)) : Submodule ℂ (AdelicGL2 F → ℂ) :=
  Submodule.span ℂ {w | ∃ u ∈ 𝒰, ∃ m : GL (Fin 2) (v.adicCompletion F),
    w = rightTranslate (ofFin F (localGL v m)) u}

variable (v) in
/-- A set `𝒰` of functions on `GL₂(𝔸_F)` is **stable away from `v`** if its members are smooth at
infinity, and it is stable under the right translations by the matrices of `GL₂(𝔸_F^f)` trivial at
`v` and by `K_∞`, and under the Lie algebra. -/
structure IsStableAwayFrom (𝒰 : Set (AdelicGL2 F → ℂ)) : Prop where
  /-- The members are smooth at infinity. -/
  smooth : ∀ u ∈ 𝒰, IsSmoothAtInfinity u
  /-- Stability under the right translations by the matrices trivial at `v`. -/
  rightTranslate_ofFin : ∀ y : GL (Fin 2) 𝔸ᶠ[F], atPlace v y = 1 → ∀ u ∈ 𝒰,
    rightTranslate (ofFin F y) u ∈ 𝒰
  /-- Stability under the right translations by `K_∞`. -/
  rightTranslate_ofInf : ∀ k : unitaryGroup (Fin 2) (mixedSpace F), ∀ u ∈ 𝒰,
    rightTranslate (ofInf F (Unitary.toUnits k)) u ∈ 𝒰
  /-- Stability under the Lie algebra. -/
  lieDeriv : ∀ (b : Fin 3) (y : mixedSpace F), ∀ u ∈ 𝒰, lieDeriv b y u ∈ 𝒰

variable {𝒰 : Set (AdelicGL2 F → ℂ)}

variable (v) in
private lemma mul_localGL_eq (y : GL (Fin 2) 𝔸ᶠ[F]) (m : GL (Fin 2) (v.adicCompletion F)) :
    y * localGL v m = localGL v (atPlace v y * m) * awayFrom v y := by
  rw [map_mul, mul_assoc, localGL_commute (atPlace_awayFrom v y), ← mul_assoc, localGL_mul_awayFrom]

private lemma rightTranslate_mem_localSpan (h𝒰 : IsStableAwayFrom v 𝒰) (y : GL (Fin 2) 𝔸ᶠ[F])
    (hw : w ∈ localSpan v 𝒰) : rightTranslate (ofFin F y) w ∈ localSpan v 𝒰 := by
  refine (Submodule.span_le (p := (localSpan v 𝒰).comap (rightTranslateₗ F (ofFin F y)))).mpr ?_ hw
  rintro _ ⟨u, hu, m, rfl⟩
  have he : rightTranslate (ofFin F y) (rightTranslate (ofFin F (localGL v m)) u) =
      rightTranslate (ofFin F (localGL v (atPlace v y * m)))
        (rightTranslate (ofFin F (awayFrom v y)) u) :=
    funext fun g ↦ by
      simp only [rightTranslate, mul_assoc, ← map_mul, mul_localGL_eq v y m]
  have hm : rightTranslate (ofFin F y) (rightTranslate (ofFin F (localGL v m)) u) ∈ localSpan v 𝒰 :=
    he.symm ▸ Submodule.subset_span
      ⟨_, h𝒰.rightTranslate_ofFin _ (atPlace_awayFrom v y) u hu, _, rfl⟩
  exact hm

private lemma rightTranslate_ofInf_mem_localSpan (h𝒰 : IsStableAwayFrom v 𝒰)
    (k : unitaryGroup (Fin 2) (mixedSpace F)) (hw : w ∈ localSpan v 𝒰) :
    rightTranslate (ofInf F (Unitary.toUnits k)) w ∈ localSpan v 𝒰 := by
  refine (Submodule.span_le (p := (localSpan v 𝒰).comap
    (rightTranslateₗ F (ofInf F (Unitary.toUnits k))))).mpr ?_ hw
  rintro _ ⟨u, hu, m, rfl⟩
  exact Submodule.subset_span ⟨_, h𝒰.rightTranslate_ofInf k u hu, m,
    rightTranslate_comm (ofFin_mul_ofInf _ _).symm u⟩

private lemma isSmoothAtInfinity_of_mem_localSpan (h𝒰 : IsStableAwayFrom v 𝒰)
    (hw : w ∈ localSpan v 𝒰) : IsSmoothAtInfinity w := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    rcases hw with ⟨u, hu, m, rfl⟩
    exact (h𝒰.smooth u hu).rightTranslate_ofFin _
  | zero => exact isSmoothAtInfinity_const 0
  | add x z _ _ hx hz => exact hx.add hz
  | smul c x _ hx => exact hx.const_smul c

private lemma lieDeriv_mem_localSpan (h𝒰 : IsStableAwayFrom v 𝒰) (y : mixedSpace F)
    (hw : w ∈ localSpan v 𝒰) : lieDeriv b y w ∈ localSpan v 𝒰 := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    rcases hw with ⟨u, hu, m, rfl⟩
    rw [lieDeriv_rightTranslate_ofFin]
    exact Submodule.subset_span ⟨_, h𝒰.lieDeriv b y u hu, m, rfl⟩
  | zero =>
    rw [(isSmoothOperator_lieDeriv b y).map_zero]
    exact zero_mem _
  | add x z hx hz ihx ihz =>
    rw [lieDeriv_add b y (isSmoothAtInfinity_of_mem_localSpan h𝒰 hx)
      (isSmoothAtInfinity_of_mem_localSpan h𝒰 hz)]
    exact add_mem ihx ihz
  | smul c x hx ihx =>
    rw [lieDeriv_const_smul b y c (isSmoothAtInfinity_of_mem_localSpan h𝒰 hx)]
    exact Submodule.smul_mem _ c ihx

/-- **The representation generated by a member of a stable family `𝒰` lies in `𝒜(𝒰)`.** -/
lemma generatedRep_le_localSpan (h𝒰 : IsStableAwayFrom v 𝒰) (hφ : φ ∈ 𝒰) :
    generatedRep φ ≤ localSpan v 𝒰 := by
  refine generatedRep_le (Submodule.subset_span ⟨φ, hφ, 1, ?_⟩)
    (fun y _ hψ ↦ rightTranslate_mem_localSpan h𝒰 y hψ)
    (fun k _ hψ ↦ rightTranslate_ofInf_mem_localSpan h𝒰 k hψ)
    fun b y _ hψ ↦ lieDeriv_mem_localSpan b h𝒰 y hψ
  refine (funext fun g ↦ ?_)
  simp [rightTranslate]

variable (v) in
/-- The functions on `GL₂(𝔸_F)` smooth at infinity and spherical at `v`. -/
def sphericalFunctions : Set (AdelicGL2 F → ℂ) :=
  {u | IsSmoothAtInfinity u ∧ IsSphericalAt v u}

variable (v a) in
/-- The functions on `GL₂(𝔸_F)` smooth at infinity, spherical at `v`, and eigenvectors of `T_v` with
eigenvalue `a`. -/
def sphericalEigenfunctions : Set (AdelicGL2 F → ℂ) :=
  {u | IsSmoothAtInfinity u ∧ IsSphericalAt v u ∧ heckeOp v u = a • u}

variable (v) in
lemma isStableAwayFrom_sphericalFunctions : IsStableAwayFrom v (sphericalFunctions v) where
  smooth _ h := h.1
  rightTranslate_ofFin _ hy _ h := ⟨h.1.rightTranslate_ofFin _, h.2.rightTranslate_ofFin hy⟩
  rightTranslate_ofInf _ _ h := ⟨h.1.rightTranslate_ofInf _, h.2.rightTranslate_ofInf _⟩
  lieDeriv b y _ h := ⟨h.1.lieDeriv b y, h.2.lieDeriv b y⟩

variable (v a) in
lemma isStableAwayFrom_sphericalEigenfunctions :
    IsStableAwayFrom v (sphericalEigenfunctions v a) where
  smooth _ h := h.1
  rightTranslate_ofFin _ hy _ h := ⟨h.1.rightTranslate_ofFin _, h.2.1.rightTranslate_ofFin hy, by
    rw [heckeOp_rightTranslate hy, h.2.2]
    rfl⟩
  rightTranslate_ofInf _ _ h := ⟨h.1.rightTranslate_ofInf _, h.2.1.rightTranslate_ofInf _, by
    rw [heckeOp_rightTranslate_ofInf, h.2.2]
    rfl⟩
  lieDeriv b y _ h := ⟨h.1.lieDeriv b y, h.2.1.lieDeriv b y, by
    rw [heckeOp_lieDeriv b y h.1, h.2.2, lieDeriv_const_smul b y a h.1]⟩

variable (v) in
private lemma isOpen_adicCompletionIntegers :
    IsOpen (v.adicCompletionIntegers F : Set (v.adicCompletion F)) :=
  Valued.isOpen_valuationSubring _

private lemma continuous_of_mem_localSpan (h𝒰 : ∀ u ∈ 𝒰, IsSphericalAt v u)
    (hw : w ∈ localSpan v 𝒰) (g : AdelicGL2 F) :
    Continuous fun k : (v.adicCompletionIntegers F).gl2 ↦ w (g * ofFin F (localGL v k)) := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    rcases hw with ⟨u, hu, m, rfl⟩
    have hc : Continuous fun x : GL (Fin 2) (v.adicCompletion F) ↦
        u (g * ofFin F (localGL v x)) :=
      (Subring.isOpen_gl (isOpen_adicCompletionIntegers v)).continuous_of_forall_mul_eq
        fun x _ hk ↦ (h𝒰 u hu).mul_localGL g x hk
    have he : (fun k : (v.adicCompletionIntegers F).gl2 ↦
        rightTranslate (ofFin F (localGL v m)) u (g * ofFin F (localGL v k))) =
        fun k : (v.adicCompletionIntegers F).gl2 ↦ u (g * ofFin F (localGL v (k * m))) :=
      funext fun k ↦ by
        simp only [rightTranslate, map_mul, mul_assoc]
    rw [he]
    exact hc.comp (continuous_subtype_val.mul continuous_const)
  | zero => exact continuous_const
  | add x z _ _ hx hz => exact hx.add hz
  | smul c x _ hx => exact hx.const_smul c

variable (v w) in
/-- The average `g ↦ ∫_{GL₂(𝒪_v)} w(g k) dk` over the maximal compact subgroup at `v` of a function
`w` on `GL₂(𝔸_F)`. -/
noncomputable def localAverage (g : AdelicGL2 F) : ℂ :=
  haarMean fun k : (v.adicCompletionIntegers F).gl2 ↦ w (g * ofFin F (localGL v k))

lemma localAverage_of_isSphericalAt (h : IsSphericalAt v w) : localAverage v w = w :=
  funext fun g ↦ by
    simp only [localAverage, h _ (Subtype.prop _)]
    exact haarMean_const _

private lemma heckeOp_localAverage_rightTranslate (hu : IsSphericalAt v u)
    (ha : heckeOp v u = a • u) (m : GL (Fin 2) (v.adicCompletion F)) :
    heckeOp v (localAverage v (rightTranslate (ofFin F (localGL v m)) u)) =
      a • localAverage v (rightTranslate (ofFin F (localGL v m)) u) :=
  funext fun g ↦ by
    let ψ : GL (Fin 2) (v.adicCompletion F) → ℂ := fun x ↦ u (g * ofFin F (localGL v x))
    have hψ : ∀ x, ∀ k ∈ (v.adicCompletionIntegers F).gl2, ψ (x * k) = ψ x :=
      fun x _ hk ↦ hu.mul_localGL g x hk
    have h₁ : (fun x ↦ localAverage v (rightTranslate (ofFin F (localGL v m)) u)
        (g * ofFin F (localGL v x))) = (v.adicCompletionIntegers F).gl2.sphericalAverage m ψ :=
      funext fun x ↦ congrArg haarMean <| funext fun k ↦ by
        simp only [rightTranslate, ψ, map_mul, mul_assoc]
    have h₂ : heckeSum (uniformizer v) (residueRep v) ψ = fun x ↦ a * ψ x :=
      funext fun x ↦ by
        have he : heckeOp v u (g * ofFin F (localGL v x)) = (a • u) (g * ofFin F (localGL v x)) :=
          congrFun ha _
        simp only [heckeOp, heckeSum, one_mul, Pi.smul_apply, smul_eq_mul] at he
        simp only [heckeSum, ψ, ← he, map_mul, mul_assoc]
    rw [heckeOp, h₁, heckeSum_sphericalAverage (isOpen_adicCompletionIntegers v)
      (isUniformizer_uniformizer v) (isResidueSystem_residueRep v (valued_uniformizer v)) hψ, h₂]
    refine (haarMean_const_mul _ a).trans (congrArg (a * ·) ?_)
    refine congrArg haarMean (funext fun k ↦ ?_)
    simp only [rightTranslate, ψ, one_mul, map_mul, mul_assoc]

private lemma heckeOp_localAverage (hw : w ∈ localSpan v (sphericalEigenfunctions v a)) :
    heckeOp v (localAverage v w) = a • localAverage v w := by
  have hs : ∀ u ∈ sphericalEigenfunctions v a, IsSphericalAt v u := fun _ h ↦ h.2.1
  induction hw using Submodule.span_induction with
  | mem w hw =>
    rcases hw with ⟨u, hu, m, rfl⟩
    exact heckeOp_localAverage_rightTranslate hu.2.1 hu.2.2 m
  | zero =>
    have he : localAverage v (0 : AdelicGL2 F → ℂ) = 0 :=
      funext fun g ↦ haarMean_const 0
    rw [he, smul_zero]
    have hz : heckeOp v ((0 : ℂ) • (0 : AdelicGL2 F → ℂ)) = (0 : ℂ) • heckeOp v 0 :=
      heckeOp_smul 0 0
    simpa using hz
  | add x z hx hz ihx ihz =>
    have he : localAverage v (x + z) = localAverage v x + localAverage v z :=
      funext fun g ↦ haarMean_add (continuous_of_mem_localSpan hs hx g)
        (continuous_of_mem_localSpan hs hz g)
    rw [he, heckeOp_add, ihx, ihz, smul_add]
  | smul c x _ hx =>
    have he : localAverage v (c • x) = c • localAverage v x :=
      funext fun g ↦ haarMean_const_mul _ c
    rw [he, heckeOp_smul, hx, smul_comm]

/-- **`T_v` acts on every `GL₂(𝒪_v)`-spherical vector of `π_φ` by the eigenvalue of `φ`**: if `φ` is
smooth at infinity, spherical at `v`, and `T_v φ = a φ`, then `T_v w = a w` for every vector `w` of
the representation generated by `φ` which is spherical at `v`. -/
lemma heckeOp_eq_smul_of_mem_generatedRep (hs : IsSmoothAtInfinity φ) (hv : IsSphericalAt v φ)
    (ha : heckeOp v φ = a • φ) (hw : w ∈ generatedRep φ) (hw' : IsSphericalAt v w) :
    heckeOp v w = a • w := by
  have h : heckeOp v (localAverage v w) = a • localAverage v w := heckeOp_localAverage <|
    generatedRep_le_localSpan (isStableAwayFrom_sphericalEigenfunctions v a) ⟨hs, hv, ha⟩ hw
  rwa [localAverage_of_isSphericalAt hw'] at h

variable (v χ) in
/-- The character `k ↦ χ_v(det k)` of `GL₂(𝒪_v)`. -/
noncomputable def detCharacter : (v.adicCompletionIntegers F).gl2 →* ℂˣ :=
  (χ.finiteComponent v).toMonoidHom.comp (GeneralLinearGroup.det.comp (Subgroup.subtype _))

variable (v χ) in
private lemma continuous_detCharacter : Continuous (detCharacter v χ) :=
  (χ.finiteComponent v).continuous_toFun.comp
    (GeneralLinearGroup.continuous_det.comp continuous_subtype_val)

private lemma diagGL_mem_gl2 {t : (v.adicCompletion F)ˣ}
    (ht : Valued.v (t : v.adicCompletion F) = 1) :
    diagGL ![t, 1] ∈ (v.adicCompletionIntegers F).gl2 := by
  refine mem_gl2_of_apply_mem_of_det (fun i j ↦ ?_) ?_
  · fin_cases i <;> fin_cases j <;> simp [mem_adicCompletionIntegers, ht]
  · simp [mem_adicCompletionIntegers, ht]

private lemma haarMean_detCharacter_eq_zero {t : (v.adicCompletion F)ˣ}
    (ht : Valued.v (t : v.adicCompletion F) = 1) (hχ : χ.finiteComponent v t ≠ 1)
    (hw : w ∈ localSpan v (sphericalFunctions v)) (g : AdelicGL2 F) :
    haarMean (fun k : (v.adicCompletionIntegers F).gl2 ↦
      ((detCharacter v χ k)⁻¹ : ℂˣ) * w (g * ofFin F (localGL v k))) = 0 := by
  have hs : ∀ u ∈ sphericalFunctions v, IsSphericalAt v u := fun _ h ↦ h.2
  have hρ : detCharacter v χ ⟨_, diagGL_mem_gl2 ht⟩ ≠ 1 := by
    have he : GeneralLinearGroup.det (diagGL ![t, 1]) = t :=
      Units.ext <| by simp
    rw [detCharacter]
    simpa [he] using hχ
  have hc : Continuous fun k : (v.adicCompletionIntegers F).gl2 ↦
      (((detCharacter v χ k)⁻¹ : ℂˣ) : ℂ) :=
    Units.continuous_coe_inv.comp (continuous_detCharacter v χ)
  induction hw using Submodule.span_induction with
  | mem w hw =>
    rcases hw with ⟨u, hu, m, rfl⟩
    refine Eq.trans (congrArg haarMean (funext fun k ↦ ?_))
      (haarMean_inv_mul_eq_zero (detCharacter v χ) (diagGL_mem_gl2 ht) hρ
        (ψ := fun x ↦ u (g * ofFin F (localGL v x))) (h := 1) (m := m)
        fun x _ hk ↦ hu.2.mul_localGL g x hk)
    simp only [rightTranslate, one_mul, map_mul, mul_assoc]
  | zero =>
    simp only [Pi.zero_apply, mul_zero]
    exact haarMean_const 0
  | add x z hx hz ihx ihz =>
    simp only [Pi.add_apply, mul_add]
    rw [haarMean_add (hc.fun_mul (continuous_of_mem_localSpan hs hx g))
      (hc.fun_mul (continuous_of_mem_localSpan hs hz g)), ihx, ihz, add_zero]
  | smul c x _ hx =>
    simp only [Pi.smul_apply, smul_eq_mul, mul_left_comm _ c]
    rw [haarMean_const_mul, hx, mul_zero]

/-- **A self twist is unramified at the good primes**: if `φ ≠ 0` is smooth at infinity, spherical
at `v`, and equal to its twist by `χ`, then `χ` is unramified at `v`, its conductor exponent there
being `0`. -/
lemma IsSelfTwist.conductorExponent_eq_zero (hs : IsSmoothAtInfinity φ) (hv : IsSphericalAt v φ)
    (hφ : φ ≠ 0) (hχ : IsSelfTwist χ φ) : χ.conductorExponent v = 0 := by
  refine conductorExponent_eq_zero_of_forall fun t ht ↦ ?_
  by_contra hχt
  have hw : twist χ φ ∈ localSpan v (sphericalFunctions v) :=
    generatedRep_le_localSpan (isStableAwayFrom_sphericalFunctions v) ⟨hs, hv⟩ hχ
  refine hφ (funext fun g ↦ ?_)
  have h₁ : haarMean (fun k : (v.adicCompletionIntegers F).gl2 ↦
      ((detCharacter v χ k)⁻¹ : ℂˣ) * twist χ φ (g * ofFin F (localGL v k))) = 0 :=
    haarMean_detCharacter_eq_zero ht hχt hw g
  have h₂ (k : (v.adicCompletionIntegers F).gl2) : ((detCharacter v χ k)⁻¹ : ℂˣ) *
      twist χ φ (g * ofFin F (localGL v k)) = twist χ φ g := by
    have he : (((detCharacter v χ k)⁻¹ : ℂˣ) : ℂ) *
        (χ.finiteComponent v (GeneralLinearGroup.det (k : GL (Fin 2) (v.adicCompletion F))) : ℂ) =
          1 := by
      rw [← Units.val_mul]
      simp [detCharacter]
    rw [twist, charDet_mul, charDet_ofFin_localGL, hv _ k.2, twist]
    linear_combination (charDet χ g * φ g) * he
  simp only [h₂] at h₁
  rw [haarMean_const] at h₁
  exact (mul_eq_zero.mp h₁).resolve_left (charDet_ne_zero χ g)

/-- **`a_v = χ(v) a_v`** (LMFDB `mf.cm`) at a good prime `v` of a Hecke eigenform equal to its twist
by `χ`. -/
lemma IsSelfTwist.heckeEigenvalue_eq (h : IsHeckeEigenform ω 𝔑 φ) (hχ : IsSelfTwist χ φ)
    (hv : ¬𝔑 ≤ v.asIdeal) : heckeEigenvalue v φ = (characterAt v χ : ℂ) * heckeEigenvalue v φ := by
  have hs : IsSmoothAtInfinity φ := h.isAutomorphicForm.smooth
  have hsph : IsSphericalAt v φ := h.spherical v hv
  have h₁ : heckeOp v (twist χ φ) = heckeEigenvalue v φ • twist χ φ :=
    heckeOp_eq_smul_of_mem_generatedRep hs hsph (h.heckeOp_eq hv) hχ
      (hsph.twist (hχ.conductorExponent_eq_zero hs hsph h.ne_zero))
  have h₂ : twist χ φ ≠ 0 := fun h₀ ↦ h.ne_zero <| funext fun g ↦
    (mul_eq_zero.mp (congrFun h₀ g)).resolve_left (charDet_ne_zero χ g)
  exact smul_left_injective ℂ h₂ (h₁.symm.trans (heckeOp_twist_of_eq (h.heckeOp_eq hv)))

/-- **The eigenvalues of a Hecke eigenform equal to its twist by `χ` vanish where `χ` is not `1`**
(LMFDB `mf.cm`): `a_v = 0` at a good prime `v` with `χ(v) ≠ 1`. -/
lemma IsSelfTwist.heckeEigenvalue_eq_zero (h : IsHeckeEigenform ω 𝔑 φ) (hχ : IsSelfTwist χ φ)
    (hv : ¬𝔑 ≤ v.asIdeal) (h₁ : (characterAt v χ : ℂ) ≠ 1) : heckeEigenvalue v φ = 0 :=
  (mul_left_eq_self₀.mp (hχ.heckeEigenvalue_eq h hv).symm).resolve_left h₁

/-- **A Hecke eigenform with complex multiplication by `χ` satisfies `a_𝔭 = χ(𝔭) a_𝔭`** at all the
good primes (LMFDB `mf.cm`). -/
lemma HasCMBy.hasCMEigenvalues (h : IsHeckeEigenform ω 𝔑 φ) (hχ : HasCMBy χ φ) :
    HasCMEigenvalues χ 𝔑 φ :=
  ⟨hχ.1, fun _ hv _ ↦ hχ.2.heckeEigenvalue_eq h hv⟩

end AdelicGL2
