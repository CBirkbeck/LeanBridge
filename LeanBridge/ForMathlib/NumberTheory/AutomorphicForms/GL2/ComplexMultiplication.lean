import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.GL2.CharacterForm
import Mathlib.NumberTheory.LegendreSymbol.ZModChar
import TauCeti.NumberTheory.NumberField.Global.HeckeCharacter.Dirichlet

/-!
# Complex multiplication of automorphic forms on `GL(2)`

A modular form `f` for `GL(2)` over a number field `F` has **complex multiplication** (LMFDB
`mf.cm`) if it is equal to its twist by a nontrivial Hecke character `χ` of `F` (Tau Ceti's
`TauCeti.GlobalNumberFields.HeckeCharacter`), or equivalently `a_𝔭 = χ(𝔭) a_𝔭` for all good
primes.

In the adelic language the twist is `φ ⊗ χ = φ · (χ ∘ det)`. For a newform, "equal to its twist"
cannot mean the literal equality `φ ⊗ χ = φ` of functions: if `φ ≠ 0` is right invariant under
`K₁(𝔑)`, that equality forces `χ` to be unramified at every finite place
(`AdelicGL2.conductorExponent_eq_zero_of_twist_eq_self_of_levelOne`), which with `χ² = 1` excludes
every nontrivial `χ` over `ℚ`. Indeed `φ ⊗ χ` is not the newform of `π ⊗ χ`, only a vector of
that representation. What the knowl means is that the automorphic representations agree,
`π_φ ⊗ χ ≅ π_φ`, and here `π_φ` is the subspace `AdelicGL2.generatedRep φ` generated by `φ` under
the right translations by `GL₂(𝔸_F^f)` and `K_∞` and under the Lie algebra of `GL₂(F_∞)`. So `φ`
**is equal to its twist by `χ`** (`AdelicGL2.IsSelfTwist`) if `φ ⊗ χ ∈ π_φ`, that is
(`AdelicGL2.IsSelfTwist.map_twist_generatedRep`) if the twist maps the subspace `π_φ` onto
itself. For a cuspidal Hecke eigenform `π_φ` is irreducible, by multiplicity one and strong
multiplicity one, and then this is `π_φ ⊗ χ ≅ π_φ`; that identification is not formalised. The
literal equality is a special case.

Comparing central characters gives `χ² = 1` at once (`AdelicGL2.IsSelfTwist.sq_eq_one`), the
knowl's "such a character is necessarily quadratic". The condition on the eigenvalues
(`AdelicGL2.HasCMEigenvalues`) gives `a_𝔭 = 0` wherever `χ(𝔭) ≠ 1`. That equality with the twist
implies the condition on the eigenvalues is `AdelicGL2.HasCMBy.hasCMEigenvalues`, in the next file
`SelfTwistHecke.lean`.

That the condition on the eigenvalues implies equality with the twist, the other direction of the
knowl's "or equivalently", is strong multiplicity one for `GL(2)` over `F` (Jacquet-Langlands,
Piatetski-Shapiro), which is not proved here, nor at the pins of Mathlib and Tau Ceti. Neither is
"`χ` is quadratic" from the condition on the eigenvalues alone.

The concrete objects here are `1 + χ ∘ det` for a quadratic `χ`, for instance `χ₄` over `ℚ`. They
are nonzero automorphic forms with complex multiplication, but neither cuspidal nor Hecke
eigenforms: no concrete Hecke eigenform with complex multiplication is formalised.

## Main definitions

* `AdelicGL2.generatedRep`: the representation `π_φ` generated by `φ`.
* `AdelicGL2.IsSelfTwist` (LMFDB `mf.cm`): `φ` is equal to its twist by `χ`.
* `AdelicGL2.HasCMBy`, `AdelicGL2.HasCM` (LMFDB `mf.cm`): complex multiplication.
* `AdelicGL2.HasCMEigenvalues` (LMFDB `mf.cm`): the condition `a_𝔭 = χ(𝔭) a_𝔭` at the good primes.

## Main results

* `AdelicGL2.IsSelfTwist.sq_eq_one` (LMFDB `mf.cm`): the character of a self twist is quadratic.
* `AdelicGL2.conductorExponent_eq_zero_of_twist_eq_self_of_levelOne`: the literal equality
  `φ ⊗ χ = φ` at level `K₁(𝔑)` forces `χ` to be unramified at every finite place.
* `AdelicGL2.HasCMEigenvalues.heckeEigenvalue_eq_zero` (LMFDB `mf.cm`): `a_𝔭 = 0` where `χ(𝔭) ≠ 1`.
* `AdelicGL2.IsSelfTwist.twist_mem`: the representation generated by a self twist is stable under
  the twist.
* `AdelicGL2.IsSelfTwist.map_twist_generatedRep` (LMFDB `mf.cm`): `π_φ ⊗ χ = π_φ`.
* `AdelicGL2.isAutomorphicForm_one_add_charDet`: `1 + χ ∘ det` is automorphic for a quadratic `χ`.
* `AdelicGL2.hasCMBy_one_add_charDet` (LMFDB `mf.cm`): it has complex multiplication by `χ`.
* `AdelicGL2.hasCM_one_add_charDet_heckeChiFour` (LMFDB `mf.cm`): a concrete instance over `ℚ`.
-/

open IsDedekindDomain HeightOneSpectrum Matrix NumberField Polynomial TauCeti GlobalNumberFields

open mixedEmbedding (mixedSpace)

open scoped AdeleRing MatrixGroups Classical

namespace AdelicGL2

variable {F : Type*} [Field F] [NumberField F] {χ ω : HeckeCharacter F} {𝔑 : Ideal (𝓞 F)}
  {φ : AdelicGL2 F → ℂ}

variable (φ) in
/-- The **automorphic representation `π_φ` generated by** a function `φ` on `GL₂(𝔸_F)`: the
smallest subspace containing `φ` stable under the right translations by `GL₂(𝔸_F^f)` and by `K_∞`,
and under the operators of the Lie algebra `𝔰𝔩₂(F_∞)`. For an automorphic form, the centre of the
Lie algebra of `GL₂(F_∞)` acts on it by scalars, through the central character, so that this is
the `(𝔤, K_∞) × GL₂(𝔸_F^f)`-module generated by `φ`. -/
def generatedRep : Submodule ℂ (AdelicGL2 F → ℂ) :=
  sInf {W | φ ∈ W ∧ (∀ y : GL (Fin 2) 𝔸ᶠ[F], ∀ ψ ∈ W, rightTranslate (ofFin F y) ψ ∈ W) ∧
    (∀ k : unitaryGroup (Fin 2) (mixedSpace F), ∀ ψ ∈ W,
      rightTranslate (ofInf F (Unitary.toUnits k)) ψ ∈ W) ∧
    ∀ (b : Fin 3) (y : mixedSpace F), ∀ ψ ∈ W, lieDeriv b y ψ ∈ W}

variable (φ) in
lemma mem_generatedRep_self : φ ∈ generatedRep φ :=
  Submodule.mem_sInf.mpr fun _ hW ↦ hW.1

lemma generatedRep_le {W : Submodule ℂ (AdelicGL2 F → ℂ)} (hφ : φ ∈ W)
    (h₁ : ∀ y : GL (Fin 2) 𝔸ᶠ[F], ∀ ψ ∈ W, rightTranslate (ofFin F y) ψ ∈ W)
    (h₂ : ∀ k : unitaryGroup (Fin 2) (mixedSpace F), ∀ ψ ∈ W,
      rightTranslate (ofInf F (Unitary.toUnits k)) ψ ∈ W)
    (h₃ : ∀ (b : Fin 3) (y : mixedSpace F), ∀ ψ ∈ W, lieDeriv b y ψ ∈ W) : generatedRep φ ≤ W :=
  sInf_le ⟨hφ, h₁, h₂, h₃⟩

lemma rightTranslate_ofFin_mem_generatedRep (y : GL (Fin 2) 𝔸ᶠ[F]) {ψ : AdelicGL2 F → ℂ}
    (hψ : ψ ∈ generatedRep φ) : rightTranslate (ofFin F y) ψ ∈ generatedRep φ :=
  Submodule.mem_sInf.mpr fun W hW ↦ hW.2.1 y ψ <| Submodule.mem_sInf.mp hψ W hW

lemma rightTranslate_ofInf_mem_generatedRep (k : unitaryGroup (Fin 2) (mixedSpace F))
    {ψ : AdelicGL2 F → ℂ} (hψ : ψ ∈ generatedRep φ) :
    rightTranslate (ofInf F (Unitary.toUnits k)) ψ ∈ generatedRep φ :=
  Submodule.mem_sInf.mpr fun W hW ↦ hW.2.2.1 k ψ <| Submodule.mem_sInf.mp hψ W hW

lemma lieDeriv_mem_generatedRep (b : Fin 3) (y : mixedSpace F) {ψ : AdelicGL2 F → ℂ}
    (hψ : ψ ∈ generatedRep φ) : lieDeriv b y ψ ∈ generatedRep φ :=
  Submodule.mem_sInf.mpr fun W hW ↦ hW.2.2.2 b y ψ <| Submodule.mem_sInf.mp hψ W hW

variable (χ φ) in
/-- A function `φ` on `GL₂(𝔸_F)` **is equal to its twist by `χ`** (LMFDB `mf.cm`): the twist
`φ ⊗ χ` lies in `π_φ`, which for a nonzero automorphic form means that the twist maps `π_φ` onto
itself (`IsSelfTwist.map_twist_generatedRep`). The literal equality `φ ⊗ χ = φ` of functions is a
special case, not the meaning of the knowl's sentence: see
`conductorExponent_eq_zero_of_twist_eq_self_of_levelOne`. -/
def IsSelfTwist : Prop :=
  twist χ φ ∈ generatedRep φ

variable (χ φ) in
/-- A function `φ` on `GL₂(𝔸_F)` has **complex multiplication by `χ`** (LMFDB `mf.cm`): `χ` is a
nontrivial Hecke character and `φ` is a nonzero function equal to its twist by `χ`. The zero
function, which is equal to all its twists, is excluded, as the knowl is about modular forms with
Hecke eigenvalues. -/
def HasCMBy : Prop :=
  χ ≠ 1 ∧ IsSelfTwist χ φ ∧ φ ≠ 0

variable (φ) in
/-- A function `φ` on `GL₂(𝔸_F)` has **complex multiplication**, or **CM** (LMFDB `mf.cm`), if it
is nonzero and equal to its twist by a nontrivial Hecke character of `F`. -/
def HasCM : Prop :=
  ∃ χ : HeckeCharacter F, HasCMBy χ φ

variable (χ 𝔑 φ) in
/-- The condition **`a_𝔭 = χ(𝔭) a_𝔭`** (LMFDB `mf.cm`) of a nontrivial Hecke character `χ` on the
Hecke eigenvalues of `φ`, at the good primes `𝔭 ∤ 𝔑` where `χ` is unramified, `χ(𝔭)` being the
value `characterAt 𝔭 χ` of the ideal character. At a good prime where `χ` is ramified the knowl's
convention `χ(𝔭) = 0` would force `a_𝔭 = 0`; this is not asked for, and for a self twist there is
no such prime (`IsSelfTwist.conductorExponent_eq_zero`). -/
def HasCMEigenvalues : Prop :=
  χ ≠ 1 ∧ ∀ v : HeightOneSpectrum (𝓞 F), ¬𝔑 ≤ v.asIdeal → χ.conductorExponent v = 0 →
    heckeEigenvalue v φ = (characterAt v χ : ℂ) * heckeEigenvalue v φ

/-- **The eigenvalues of a form with complex multiplication vanish where the character is not `1`**
(LMFDB `mf.cm`): if `a_𝔭 = χ(𝔭) a_𝔭` at the good primes, then `a_𝔭 = 0` at a good prime with
`χ(𝔭) ≠ 1`, in particular with `χ(𝔭) = -1`. -/
lemma HasCMEigenvalues.heckeEigenvalue_eq_zero (h : HasCMEigenvalues χ 𝔑 φ)
    {v : HeightOneSpectrum (𝓞 F)} (hv : ¬𝔑 ≤ v.asIdeal) (hχ : χ.conductorExponent v = 0)
    (h₁ : (characterAt v χ : ℂ) ≠ 1) : heckeEigenvalue v φ = 0 :=
  (mul_left_eq_self₀.mp (h.2 v hv hχ).symm).resolve_left h₁

variable (ω) in
/-- The functions with central character `ω`, a subspace stable under the operators generating
`π_φ`. -/
private def centralSubspace : Submodule ℂ (AdelicGL2 F → ℂ) where
  carrier := {ψ | ∀ (z : IdeleGroup (𝓞 F) F) (g : AdelicGL2 F),
    ψ (scalar F z * g) = (ω (QuotientGroup.mk z) : ℂ) * ψ g}
  add_mem' {a b} ha hb z g := by
    rw [Pi.add_apply, ha, hb, Pi.add_apply, mul_add]
  zero_mem' z g := by
    simp
  smul_mem' c a ha z g := by
    rw [Pi.smul_apply, ha, Pi.smul_apply, smul_eq_mul, smul_eq_mul, mul_left_comm]

private lemma generatedRep_le_centralSubspace (h : IsAutomorphicForm ω φ) :
    generatedRep φ ≤ centralSubspace ω := by
  refine generatedRep_le (W := centralSubspace ω) h.central (fun y ψ hψ z g ↦ ?_)
    (fun k ψ hψ z g ↦ ?_) fun b y ψ hψ z g ↦ ?_
  · simp only [rightTranslate, mul_assoc]
    exact hψ z _
  · simp only [rightTranslate, mul_assoc]
    exact hψ z _
  · simp only [lieDeriv, mul_assoc]
    have he : (fun t : ℝ ↦ ψ (scalar F z * (g * ofInf F (sl2Exp b (t • y))))) =
        fun t ↦ (ω (QuotientGroup.mk z) : ℂ) * ψ (g * ofInf F (sl2Exp b (t • y))) :=
      funext fun t ↦ hψ z _
    rw [he]
    exact deriv_const_mul_field _

/-- **The character of a self twist is quadratic** (LMFDB `mf.cm`): if `φ ≠ 0` has central
character `ω` and is equal to its twist by `χ`, then `χ² = 1`, by comparing the central characters
`ω` of `π_φ` and `ω χ²` of `φ ⊗ χ`. -/
lemma IsSelfTwist.sq_eq_one (h : IsAutomorphicForm ω φ) (hφ : φ ≠ 0) (hχ : IsSelfTwist χ φ) :
    χ ^ 2 = 1 := by
  rcases Function.ne_iff.mp hφ with ⟨g, hg⟩
  refine ContinuousMonoidHom.ext fun c ↦ ?_
  induction c using QuotientGroup.induction_on with | H z => ?_
  have h₁ : twist χ φ (scalar F z * g) = (ω (QuotientGroup.mk z) : ℂ) * twist χ φ g :=
    generatedRep_le_centralSubspace h hχ z g
  simp only [twist, charDet_mul, charDet_scalar, h.central] at h₁
  have hω : (ω (QuotientGroup.mk z) : ℂ) ≠ 0 := Units.ne_zero _
  have hd : charDet χ g ≠ 0 := charDet_ne_zero χ g
  have h₂ : (χ (QuotientGroup.mk z) : ℂ) ^ 2 = 1 := by
    field_simp at h₁
    exact (mul_left_eq_self₀.mp h₁).resolve_right hg
  refine Units.ext ?_
  simpa using h₂

/-- **The literal equality `φ ⊗ χ = φ` is not what a self twist of a newform means**: if `φ ≠ 0`
is right invariant under `K₁(𝔑)`, and `φ ⊗ χ = φ` as functions, then `χ` is unramified at every
finite place, its conductor exponent vanishing everywhere. Over `ℚ`, with `χ² = 1`
(`IsSelfTwist.sq_eq_one`), this only leaves `χ = 1`. -/
lemma conductorExponent_eq_zero_of_twist_eq_self_of_levelOne (hφ : φ ≠ 0)
    (hK : ∀ u ∈ levelOne 𝔑, ∀ g, φ (g * ofFin F u) = φ g) (h : twist χ φ = φ)
    (v : HeightOneSpectrum (𝓞 F)) : χ.conductorExponent v = 0 := by
  refine conductorExponent_eq_zero_of_forall fun u hu ↦ ?_
  rcases Function.ne_iff.mp hφ with ⟨g, hg⟩
  let m : GL (Fin 2) (v.adicCompletion F) :=
    ValuationSubring.heckeRep u (fun _ : Unit ↦ 0) (some ())
  have hm : m ∈ (v.adicCompletionIntegers F).gl2 := by
    refine ValuationSubring.mem_gl2_of_apply_mem_of_det (fun i j ↦ ?_) ?_
    · have hu' : (u : v.adicCompletion F) ∈ v.adicCompletionIntegers F :=
        (mem_adicCompletionIntegers _ _ v).mpr hu.le
      fin_cases i <;> fin_cases j <;> simp [m, ValuationSubring.heckeRep, hu']
    · rw [mem_adicCompletionIntegers]
      simp [m, ValuationSubring.heckeRep, hu]
  have hy : localGL v m ∈ levelOne 𝔑 := by
    refine ⟨localGL_mem_integralGL hm, ?_, ?_⟩
    · have h₀ : (localGL v m : Matrix (Fin 2) (Fin 2) 𝔸ᶠ[F]) 1 0 = 0 :=
        FiniteAdeleRing.ext F fun w ↦ by
          rw [localGL_apply]
          rcases eq_or_ne w v with rfl | hw
          · rw [localMat_apply_self]
            simp [m, ValuationSubring.heckeRep]
          · rw [localMat_apply_of_ne hw]
            simp
      rw [h₀]
      exact zero_mem _
    · have h₀ : (localGL v m : Matrix (Fin 2) (Fin 2) 𝔸ᶠ[F]) 1 1 = 1 :=
        FiniteAdeleRing.ext F fun w ↦ by
          rw [localGL_apply]
          rcases eq_or_ne w v with rfl | hw
          · rw [localMat_apply_self]
            simp [m, ValuationSubring.heckeRep]
          · rw [localMat_apply_of_ne hw]
            simp
      rw [h₀, sub_self]
      exact zero_mem _
  have h₁ : charDet χ g = 1 :=
    (mul_left_eq_self₀.mp (congrFun h g)).resolve_right hg
  have h₂ : charDet χ (g * ofFin F (localGL v m)) = 1 := by
    have he : twist χ φ (g * ofFin F (localGL v m)) = φ (g * ofFin F (localGL v m)) :=
      congrFun h _
    rw [twist, hK _ hy] at he
    exact (mul_left_eq_self₀.mp he).resolve_right hg
  rw [charDet_mul, h₁, one_mul, charDet_ofFin_localGL, det_heckeRep] at h₂
  exact Units.ext h₂

lemma IsSelfTwist.of_twist_eq (h : twist χ φ = φ) : IsSelfTwist χ φ := by
  rw [IsSelfTwist, h]
  exact mem_generatedRep_self φ

private lemma twistₗ_apply (ψ : AdelicGL2 F → ℂ) : twistₗ χ ψ = twist χ ψ :=
  rfl

variable (χ) in
private lemma rightTranslate_twist (h : AdelicGL2 F) (ψ : AdelicGL2 F → ℂ) :
    twist χ (rightTranslate h ψ) = (charDet χ h)⁻¹ • rightTranslate h (twist χ ψ) :=
  funext fun g ↦ by
    simp only [rightTranslate, twist, charDet_mul, Pi.smul_apply, smul_eq_mul]
    field_simp [charDet_ne_zero χ h]

/-- **The representation generated by a self twist is stable under the twist.** -/
lemma IsSelfTwist.twist_mem (hχ : IsSelfTwist χ φ) {ψ : AdelicGL2 F → ℂ}
    (hψ : ψ ∈ generatedRep φ) : twist χ ψ ∈ generatedRep φ := by
  refine generatedRep_le (W := (generatedRep φ).comap (twistₗ χ)) hχ (fun y ψ hψ ↦ ?_)
    (fun k ψ hψ ↦ ?_) (fun b y ψ hψ ↦ ?_) hψ
  · rw [Submodule.mem_comap, twistₗ_apply, rightTranslate_twist]
    exact Submodule.smul_mem _ _ <| rightTranslate_ofFin_mem_generatedRep y hψ
  · rw [Submodule.mem_comap, twistₗ_apply, rightTranslate_twist]
    exact Submodule.smul_mem _ _ <| rightTranslate_ofInf_mem_generatedRep k hψ
  · rw [Submodule.mem_comap, twistₗ_apply, ← lieDeriv_twist]
    exact lieDeriv_mem_generatedRep b y hψ

private lemma twist_twist_of_sq_eq_one (h₂ : χ ^ 2 = 1) (ψ : AdelicGL2 F → ℂ) :
    twist χ (twist χ ψ) = ψ :=
  funext fun g ↦ by
    have he : ((χ (QuotientGroup.mk (GeneralLinearGroup.det g)) ^ 2 : ℂˣ) : ℂ) = 1 := by
      rw [← ContinuousMonoidHom.pow_apply, h₂]
      rfl
    rw [twist, twist, ← mul_assoc, charDet, ← Units.val_mul, ← sq, he, one_mul]

/-- **`π_φ ⊗ χ = π_φ`** for a nonzero automorphic form `φ` equal to its twist by `χ`: the subspace
`π_φ` is the image of itself under the twist, which is what the knowl's sentence means (LMFDB
`mf.cm`). -/
lemma IsSelfTwist.map_twist_generatedRep (h : IsAutomorphicForm ω φ) (hφ : φ ≠ 0)
    (hχ : IsSelfTwist χ φ) : (generatedRep φ).map (twistₗ χ) = generatedRep φ :=
  le_antisymm (Submodule.map_le_iff_le_comap.mpr fun _ hψ ↦ hχ.twist_mem hψ) fun ψ hψ ↦
    ⟨twist χ ψ, hχ.twist_mem hψ, twist_twist_of_sq_eq_one (hχ.sq_eq_one h hφ) ψ⟩

private lemma twist_one_add_charDet (h₂ : χ ^ 2 = 1) :
    twist χ ((fun _ ↦ 1) + charDet χ) = (fun _ ↦ 1) + charDet χ := by
  have he : twist χ (twist χ fun _ ↦ 1) = fun _ ↦ 1 := twist_twist_of_sq_eq_one h₂ _
  rw [twist_one] at he
  have ha : twist χ ((fun _ ↦ 1) + charDet χ) = twist χ (fun _ ↦ 1) + twist χ (charDet χ) :=
    map_add (twistₗ χ) _ _
  rw [ha, he, twist_one, add_comm]

/-- **`1 + χ ∘ det` is an automorphic form** with trivial central character, for a quadratic
character `χ`. It is literally equal to its twist by `χ`, but it is neither cuspidal nor a Hecke
eigenform when `χ ≠ 1`. -/
lemma isAutomorphicForm_one_add_charDet (h₂ : χ ^ 2 = 1) :
    IsAutomorphicForm 1 ((fun _ ↦ 1) + charDet χ) :=
  isAutomorphicForm_one.add <| h₂ ▸ isAutomorphicForm_charDet χ

lemma one_add_charDet_ne_zero : (fun _ ↦ 1) + charDet χ ≠ 0 := fun h ↦ by
  have he : (1 : ℂ) + charDet χ 1 = 0 := congrFun h 1
  rw [charDet_one] at he
  norm_num at he

/-- **`1 + χ ∘ det` has complex multiplication by `χ`** for a nontrivial quadratic character `χ`
(LMFDB `mf.cm`). -/
lemma hasCMBy_one_add_charDet (h₁ : χ ≠ 1) (h₂ : χ ^ 2 = 1) :
    HasCMBy χ ((fun _ ↦ 1) + charDet χ) :=
  ⟨h₁, IsSelfTwist.of_twist_eq <| twist_one_add_charDet h₂, one_add_charDet_ne_zero⟩

/-- The nontrivial quadratic Hecke character of `ℚ` of conductor `4`: the Dirichlet character `χ₄`,
which is the character of `ℚ(i)`, through Tau Ceti's `HeckeCharacter.ofDirichletCharacter`. -/
noncomputable def heckeChiFour : HeckeCharacter ℚ :=
  HeckeCharacter.ofDirichletCharacter 4 four_ne_zero <| ZMod.χ₄.ringHomComp (Int.castRingHom ℂ)

lemma heckeChiFour_ne_one : heckeChiFour ≠ 1 := fun h ↦ by
  have he : ZMod.χ₄.ringHomComp (Int.castRingHom ℂ) = 1 :=
    HeckeCharacter.ofDirichletCharacter_injective (h.trans (map_one _).symm)
  have h₃ : (ZMod.χ₄.ringHomComp (Int.castRingHom ℂ)) 3 = (1 : MulChar (ZMod 4) ℂ) 3 := by
    rw [he]
  have h₄ : ZMod.χ₄ (3 : ZMod 4) = -1 := by
    decide
  rw [MulChar.one_apply (by decide), MulChar.ringHomComp_apply, h₄] at h₃
  norm_num at h₃

lemma heckeChiFour_sq : heckeChiFour ^ 2 = 1 := by
  rw [heckeChiFour, ← map_pow, (ZMod.isQuadratic_χ₄.comp _).sq_eq_one, map_one]

/-- **A concrete automorphic form over `ℚ` with complex multiplication** (LMFDB `mf.cm`):
`1 + χ₄ ∘ det`, which is nonzero and automorphic, so that `AdelicGL2.HasCM` is satisfiable. It is
neither cuspidal nor a Hecke eigenform, so it is not an example of the knowl's notion, which is
about eigenforms: no Hecke eigenform with complex multiplication is formalised. -/
lemma hasCM_one_add_charDet_heckeChiFour : HasCM ((fun _ ↦ 1) + charDet heckeChiFour) :=
  ⟨heckeChiFour, hasCMBy_one_add_charDet heckeChiFour_ne_one heckeChiFour_sq⟩

end AdelicGL2
