import Mathlib.Basic.Complex.Basic
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
import Mathlib.RingTheory.Valuation.ValuationSubring
import Mathlib.Topology.Instances.Matrix

/-!
# The Hecke coset decomposition of `GL₂` over a discretely valued field

Let `L` be a field with a valuation subring `O` whose maximal ideal is generated by `ϖ`, and
`K = GL₂(O)`. The double coset `K diag(ϖ, 1) K`, the set of matrices with entries in `O` whose
determinant is `ϖ` times a unit, is the disjoint union of the cosets `(ϖ, r; 0, 1) K`, for `r` in a
system of representatives of the residue field `O / ϖ`, and of `(1, 0; 0, ϖ) K`. This is the
decomposition behind the spherical Hecke operator `T_𝔭` of `GL(2)` at a finite place.

## Main definitions

* `Subring.gl`: the group `GL_n(O)` inside `GL_n(R)`, for a subring `O`.
* `ValuationSubring.IsUniformizer`: an element generating the maximal ideal.
* `ValuationSubring.IsResidueSystem`: a system of representatives of the residue field.
* `ValuationSubring.heckeSet`: the set `K diag(ϖ, 1) K`.
* `ValuationSubring.heckeRep`: the representatives `(ϖ, r; 0, 1)` and `(1, 0; 0, ϖ)`.
* `ValuationSubring.heckeSum`: the sum of a function over these representatives.

## Main results

* `Subring.isOpen_gl`: `GL_n(O)` is open in `GL_n(R)` when `O` is open in `R`.
* `ValuationSubring.IsUniformizer.existsUnique_heckeRep`: each matrix of `K diag(ϖ, 1) K` lies in
  exactly one of the cosets.
* `ValuationSubring.IsUniformizer.heckeSum_mul`: for a function `ψ` right invariant under `K`, the
  sum `h ↦ ∑ ψ(h x)` over the representatives is again right invariant under `K`.
* `ValuationSubring.IsUniformizer.heckeSum_eq`: for such a `ψ`, the sum does not depend on the
  uniformizer nor on the representatives.
-/

open Matrix hiding mul_inv_rev

namespace Subring

variable {R : Type*} [CommRing R] (O : Subring R) (n : Type*) [DecidableEq n] [Fintype n]

/-- The group **`GL_n(O)`** as a subgroup of `GL_n(R)`, for a subring `O` of `R`: the invertible
matrices whose entries, and those of their inverses, lie in `O`. -/
def gl : Subgroup (GL n R) where
  carrier := {k | ∀ i j, (k : Matrix n n R) i j ∈ O ∧ ((k⁻¹ : GL n R) : Matrix n n R) i j ∈ O}
  mul_mem' {a b} ha hb i j := by
    refine ⟨?_, ?_⟩
    · rw [Units.val_mul, mul_apply]
      exact sum_mem fun l _ ↦ mul_mem (ha i l).1 (hb l j).1
    · rw [mul_inv_rev, Units.val_mul, mul_apply]
      exact sum_mem fun l _ ↦ mul_mem (hb i l).2 (ha l j).2
  one_mem' i j := by
    rw [inv_one, Units.val_one, one_apply]
    split_ifs
    · exact ⟨one_mem _, one_mem _⟩
    · exact ⟨zero_mem _, zero_mem _⟩
  inv_mem' {a} ha i j := by
    rw [inv_inv]
    exact (ha i j).symm

variable {O n} {k : GL n R}

lemma mem_gl_iff : k ∈ O.gl n ↔
    ∀ i j, (k : Matrix n n R) i j ∈ O ∧ ((k⁻¹ : GL n R) : Matrix n n R) i j ∈ O :=
  Iff.rfl

lemma apply_mem_of_mem_gl (hk : k ∈ O.gl n) (i j : n) : (k : Matrix n n R) i j ∈ O :=
  (hk i j).1

lemma det_mem_of_mem_gl (hk : k ∈ O.gl n) : (k : Matrix n n R).det ∈ O := by
  rw [det_apply]
  refine sum_mem fun σ _ ↦ ?_
  rw [Units.smul_def, zsmul_eq_mul]
  exact mul_mem (intCast_mem O _) <| prod_mem fun i _ ↦ (hk _ _).1

/-- **`GL_n(O)` is open** in `GL_n(R)` when the subring `O` is open in `R`. -/
lemma isOpen_gl [TopologicalSpace R] (hO : IsOpen (O : Set R)) :
    IsOpen (O.gl n : Set (GL n R)) := by
  have h : (O.gl n : Set (GL n R)) = ⋂ (i : n) (j : n),
      ((fun k : GL n R ↦ (k : Matrix n n R) i j) ⁻¹' O ∩
        (fun k : GL n R ↦ ((k⁻¹ : GL n R) : Matrix n n R) i j) ⁻¹' O) := by
    ext k
    simp only [Set.mem_iInter, Set.mem_inter_iff, Set.mem_preimage]
    rfl
  rw [h]
  exact isOpen_iInter_of_finite fun i ↦ isOpen_iInter_of_finite fun j ↦
    (hO.preimage ((continuous_id.matrix_elem i j).comp Units.continuous_val)).inter
      (hO.preimage ((continuous_id.matrix_elem i j).comp Units.continuous_coe_inv))

end Subring

namespace ValuationSubring

variable {L : Type*} [Field L] (O : ValuationSubring L)

/-- The group **`GL₂(O)`** of a valuation subring `O` of `L`, a subgroup of `GL₂(L)`. -/
abbrev gl2 : Subgroup (GL (Fin 2) L) :=
  O.toSubring.gl (Fin 2)

variable {O}

lemma mem_gl2_of_apply_mem_of_det {k : GL (Fin 2) L}
    (hk : ∀ i j, (k : Matrix (Fin 2) (Fin 2) L) i j ∈ O)
    (hd : (k : Matrix (Fin 2) (Fin 2) L).det⁻¹ ∈ O) : k ∈ O.gl2 := by
  refine fun i j ↦ ⟨hk i j, ?_⟩
  rw [GeneralLinearGroup.coe_inv, inv_def, adjugate_fin_two, Ring.inverse_eq_inv']
  have h₀₀ : (k : Matrix (Fin 2) (Fin 2) L) 0 0 ∈ O := hk 0 0
  have h₀₁ : (k : Matrix (Fin 2) (Fin 2) L) 0 1 ∈ O := hk 0 1
  have h₁₀ : (k : Matrix (Fin 2) (Fin 2) L) 1 0 ∈ O := hk 1 0
  have h₁₁ : (k : Matrix (Fin 2) (Fin 2) L) 1 1 ∈ O := hk 1 1
  fin_cases i <;> fin_cases j <;>
    simp only [Matrix.smul_apply, of_apply, cons_val', cons_val_zero, cons_val_one, smul_eq_mul,
      Fin.zero_eta, Fin.mk_one, cons_val_fin_one] <;>
    first
      | exact O.mul_mem _ _ hd ‹_›
      | exact O.mul_mem _ _ hd (O.neg_mem _ ‹_›)

variable (O)

/-- An element `ϖ` is a **uniformizer** of the valuation subring `O` if it is a non-unit of `O`
dividing all the non-units. -/
structure IsUniformizer (ϖ : L) : Prop where
  /-- A uniformizer lies in `O`. -/
  mem : ϖ ∈ O
  /-- A uniformizer is not a unit of `O`. -/
  inv_notMem : ϖ⁻¹ ∉ O
  /-- A uniformizer divides all the non-units of `O`. -/
  dvd (x : L) : x ∈ O → x⁻¹ ∉ O → ϖ⁻¹ * x ∈ O

/-- A family `r` is a **system of representatives of the residue field** of `O`, with uniformizer
`ϖ`: its members lie in `O`, and every element of `O` is congruent modulo `ϖ` to exactly one
member. -/
structure IsResidueSystem (ϖ : L) {ι : Type*} (r : ι → L) : Prop where
  /-- The representatives lie in `O`. -/
  mem (i : ι) : r i ∈ O
  /-- Every element of `O` is congruent modulo `ϖ` to exactly one representative. -/
  existsUnique (x : L) : x ∈ O → ∃! i, ϖ⁻¹ * (x - r i) ∈ O

/-- The double coset **`K diag(ϖ, 1) K`**, for `K = GL₂(O)`: the matrices with entries in `O` whose
determinant is `ϖ` times a unit of `O`. -/
def heckeSet (ϖ : L) : Set (GL (Fin 2) L) :=
  {y | (∀ i j, (y : Matrix (Fin 2) (Fin 2) L) i j ∈ O) ∧
    ϖ⁻¹ * (y : Matrix (Fin 2) (Fin 2) L).det ∈ O ∧ ϖ * (y : Matrix (Fin 2) (Fin 2) L).det⁻¹ ∈ O}

variable {ι : Type*} (ϖ : Lˣ) (r : ι → L)

/-- The **Hecke representatives**: `(ϖ, r i; 0, 1)` for the members `r i` of a family, and
`(1, 0; 0, ϖ)`. -/
def heckeRep : Option ι → GL (Fin 2) L
  | some i => ⟨!![(ϖ : L), r i; 0, 1], !![((ϖ⁻¹ : Lˣ) : L), -(((ϖ⁻¹ : Lˣ) : L) * r i); 0, 1],
      by ext a b; fin_cases a <;> fin_cases b <;> simp,
      by ext a b; fin_cases a <;> fin_cases b <;> simp⟩
  | none => ⟨!![1, 0; 0, (ϖ : L)], !![1, 0; 0, ((ϖ⁻¹ : Lˣ) : L)],
      by ext a b; fin_cases a <;> fin_cases b <;> simp,
      by ext a b; fin_cases a <;> fin_cases b <;> simp⟩

/-- The **Hecke sum** `h ↦ ∑ ψ(h x)` of a function `ψ` on `GL₂(L)` over the Hecke representatives
`x`. For `ψ` right invariant under `K = GL₂(O)` it is the action of the double coset
`K diag(ϖ, 1) K`. -/
def heckeSum [Fintype ι] (ψ : GL (Fin 2) L → ℂ) (h : GL (Fin 2) L) : ℂ :=
  ∑ o : Option ι, ψ (h * heckeRep ϖ r o)

variable {O ϖ r}

lemma det_gl2_inv_mem {k : GL (Fin 2) L} (hk : k ∈ O.gl2) :
    (k : Matrix (Fin 2) (Fin 2) L).det⁻¹ ∈ O := by
  have h : ((k⁻¹ : GL (Fin 2) L) : Matrix (Fin 2) (Fin 2) L).det ∈ O :=
    Subring.det_mem_of_mem_gl (Subgroup.inv_mem _ hk)
  rwa [GeneralLinearGroup.coe_inv, det_nonsing_inv, Ring.inverse_eq_inv'] at h

lemma mul_mem_heckeSet {k y : GL (Fin 2) L} (hk : k ∈ O.gl2) (hy : y ∈ O.heckeSet ϖ) :
    k * y ∈ O.heckeSet ϖ := by
  have hd : (k : Matrix (Fin 2) (Fin 2) L).det ∈ O := Subring.det_mem_of_mem_gl hk
  have hd' : (k : Matrix (Fin 2) (Fin 2) L).det⁻¹ ∈ O := det_gl2_inv_mem hk
  refine ⟨fun i j ↦ ?_, ?_, ?_⟩
  · rw [Units.val_mul, mul_apply]
    exact sum_mem fun l _ ↦ O.mul_mem _ _ (hk i l).1 (hy.1 l j)
  · rw [Units.val_mul, det_mul, mul_left_comm]
    exact O.mul_mem _ _ hd hy.2.1
  · rw [Units.val_mul, det_mul, mul_inv, mul_left_comm]
    exact O.mul_mem _ _ hd' hy.2.2

lemma IsUniformizer.heckeRep_mem_heckeSet (hϖ : O.IsUniformizer ϖ) (hr : O.IsResidueSystem ϖ r)
    (o : Option ι) : heckeRep ϖ r o ∈ O.heckeSet ϖ := by
  cases o with
  | some i =>
    refine ⟨fun a b ↦ ?_, ?_, ?_⟩
    · fin_cases a <;> fin_cases b
      · exact hϖ.mem
      · exact hr.mem i
      · exact zero_mem _
      · exact one_mem _
    · simp [heckeRep]
    · simp [heckeRep]
  | none =>
    refine ⟨fun a b ↦ ?_, ?_, ?_⟩
    · fin_cases a <;> fin_cases b
      · exact one_mem _
      · exact zero_mem _
      · exact zero_mem _
      · exact hϖ.mem
    · simp [heckeRep]
    · simp [heckeRep]

private lemma det_heckeRep_inv (o : Option ι) :
    (((heckeRep ϖ r o)⁻¹ : GL (Fin 2) L) : Matrix (Fin 2) (Fin 2) L).det = (ϖ : L)⁻¹ := by
  cases o <;> simp [heckeRep]

private lemma IsResidueSystem.eq_of_inv_mul_sub_mem (hr : O.IsResidueSystem ϖ r) {i j : ι}
    (h : (ϖ : L)⁻¹ * (r i - r j) ∈ O) : i = j := by
  refine (hr.existsUnique _ (hr.mem i)).unique ?_ h
  simp

private lemma IsUniformizer.eq_of_heckeRep_inv_mul_mem (hϖ : O.IsUniformizer ϖ)
    (hr : O.IsResidueSystem ϖ r) {o o' : Option ι}
    (h : (heckeRep ϖ r o')⁻¹ * heckeRep ϖ r o ∈ O.gl2) : o = o' := by
  have hentry (a b : Fin 2) : (((heckeRep ϖ r o')⁻¹ * heckeRep ϖ r o : GL (Fin 2) L) :
      Matrix (Fin 2) (Fin 2) L) a b ∈ O :=
    (h a b).1
  cases o with
  | some i =>
    cases o' with
    | some j =>
      have h₀₁ : (ϖ : L)⁻¹ * r i + -((ϖ : L)⁻¹ * r j) ∈ O := by
        simpa only [Units.val_mul, heckeRep, Units.inv_mk, mul_apply, Fin.sum_univ_two, of_apply,
          cons_val', cons_val_zero, cons_val_one, cons_val_fin_one, Units.val_inv_eq_inv_val,
          mul_one] using hentry 0 1
      refine congrArg some <| hr.eq_of_inv_mul_sub_mem ?_
      have he : (ϖ : L)⁻¹ * (r i - r j) = (ϖ : L)⁻¹ * r i + -((ϖ : L)⁻¹ * r j) := by
        ring1
      rw [he]
      exact h₀₁
    | none =>
      have h₁₁ : (ϖ : L)⁻¹ ∈ O := by
        simpa only [Units.val_mul, heckeRep, Units.inv_mk, mul_apply, Fin.sum_univ_two, of_apply,
          cons_val', cons_val_zero, cons_val_one, cons_val_fin_one, Units.val_inv_eq_inv_val,
          mul_one, zero_mul, zero_add] using hentry 1 1
      exact absurd h₁₁ hϖ.inv_notMem
  | none =>
    cases o' with
    | some j =>
      have h₀₀ : (ϖ : L)⁻¹ ∈ O := by
        simpa only [Units.val_mul, heckeRep, Units.inv_mk, mul_apply, Fin.sum_univ_two, of_apply,
          cons_val', cons_val_zero, cons_val_one, cons_val_fin_one, Units.val_inv_eq_inv_val,
          mul_one, mul_zero, add_zero] using hentry 0 0
      exact absurd h₀₀ hϖ.inv_notMem
    | none => rfl

/-- **The Hecke coset decomposition**: a matrix of `K diag(ϖ, 1) K` lies in exactly one of the
cosets `(ϖ, r i; 0, 1) K` and `(1, 0; 0, ϖ) K`, where `K = GL₂(O)` and `r` is a system of
representatives of the residue field. -/
lemma IsUniformizer.existsUnique_heckeRep (hϖ : O.IsUniformizer ϖ) (hr : O.IsResidueSystem ϖ r)
    {y : GL (Fin 2) L} (hy : y ∈ O.heckeSet ϖ) : ∃! o, (heckeRep ϖ r o)⁻¹ * y ∈ O.gl2 := by
  have hu (o o' : Option ι) (ho : (heckeRep ϖ r o)⁻¹ * y ∈ O.gl2)
      (ho' : (heckeRep ϖ r o')⁻¹ * y ∈ O.gl2) : o = o' := by
    refine hϖ.eq_of_heckeRep_inv_mul_mem hr ?_
    have hm : (heckeRep ϖ r o')⁻¹ * y * ((heckeRep ϖ r o)⁻¹ * y)⁻¹ ∈ O.gl2 :=
      O.gl2.mul_mem ho' (O.gl2.inv_mem ho)
    rwa [mul_inv_rev, inv_inv, mul_assoc, mul_inv_cancel_left] at hm
  have hdet : ((y : Matrix (Fin 2) (Fin 2) L) 0 0 * (y : Matrix (Fin 2) (Fin 2) L) 1 1 -
      (y : Matrix (Fin 2) (Fin 2) L) 0 1 * (y : Matrix (Fin 2) (Fin 2) L) 1 0) =
      (y : Matrix (Fin 2) (Fin 2) L).det := (det_fin_two _).symm
  have hdet₀ : (y : Matrix (Fin 2) (Fin 2) L).det ≠ 0 := y.det_ne_zero
  have hϖ₀ : (ϖ : L) ≠ 0 := ϖ.ne_zero
  rcases hy with ⟨hent, hd₁, hd₂⟩
  have hd₃ (o : Option ι) :
      (((heckeRep ϖ r o)⁻¹ * y : GL (Fin 2) L) : Matrix (Fin 2) (Fin 2) L).det⁻¹ ∈ O := by
    rw [Units.val_mul, det_mul, det_heckeRep_inv, mul_inv, inv_inv]
    exact hd₂
  generalize hα : (y : Matrix (Fin 2) (Fin 2) L) 0 0 = α at hdet
  generalize hβ : (y : Matrix (Fin 2) (Fin 2) L) 0 1 = β at hdet
  generalize hγ : (y : Matrix (Fin 2) (Fin 2) L) 1 0 = γ at hdet
  generalize hδ : (y : Matrix (Fin 2) (Fin 2) L) 1 1 = δ at hdet
  have hαO : α ∈ O := hα ▸ hent 0 0
  have hβO : β ∈ O := hβ ▸ hent 0 1
  have hγO : γ ∈ O := hγ ▸ hent 1 0
  have hδO : δ ∈ O := hδ ▸ hent 1 1
  by_cases hc : (ϖ : L)⁻¹ * γ ∈ O ∧ (ϖ : L)⁻¹ * δ ∈ O
  · refine ⟨none, ?_, fun o ho ↦ hu o none ho ?_⟩ <;>
    · refine mem_gl2_of_apply_mem_of_det (fun a b ↦ ?_) (hd₃ none)
      fin_cases a <;> fin_cases b <;>
        simp [heckeRep, mul_apply, hα, hβ, hγ, hδ, hαO, hβO, hc.1, hc.2]
  · have ht : ∃ t ∈ O, (ϖ : L)⁻¹ * (α - t * γ) ∈ O ∧ (ϖ : L)⁻¹ * (β - t * δ) ∈ O := by
      by_cases hc₁ : (ϖ : L)⁻¹ * δ ∈ O
      · have hc₂ : (ϖ : L)⁻¹ * γ ∉ O := fun h ↦ hc ⟨h, hc₁⟩
        have hγinv : γ⁻¹ ∈ O := by
          by_contra hn
          exact hc₂ (hϖ.dvd γ hγO hn)
        have hγ₀ : γ ≠ 0 := by
          rintro rfl
          simp at hc₂
        refine ⟨α * γ⁻¹, O.mul_mem _ _ hαO hγinv, ?_, ?_⟩
        · rw [inv_mul_cancel_right₀ hγ₀, sub_self, mul_zero]
          exact zero_mem _
        · have he : (ϖ : L)⁻¹ * (β - α * γ⁻¹ * δ) =
              -(γ⁻¹ * ((ϖ : L)⁻¹ * (y : Matrix (Fin 2) (Fin 2) L).det)) := by
            rw [← hdet]
            field_simp
            ring1
          rw [he]
          exact O.neg_mem _ (O.mul_mem _ _ hγinv hd₁)
      · have hδinv : δ⁻¹ ∈ O := by
          by_contra hn
          exact hc₁ (hϖ.dvd δ hδO hn)
        have hδ₀ : δ ≠ 0 := by
          rintro rfl
          simp at hc₁
        refine ⟨β * δ⁻¹, O.mul_mem _ _ hβO hδinv, ?_, ?_⟩
        · have he : (ϖ : L)⁻¹ * (α - β * δ⁻¹ * γ) =
              δ⁻¹ * ((ϖ : L)⁻¹ * (y : Matrix (Fin 2) (Fin 2) L).det) := by
            rw [← hdet]
            field_simp
          rw [he]
          exact O.mul_mem _ _ hδinv hd₁
        · rw [inv_mul_cancel_right₀ hδ₀, sub_self, mul_zero]
          exact zero_mem _
    rcases ht with ⟨t, htO, ht₁, ht₂⟩
    rcases (hr.existsUnique t htO).exists with ⟨i, hi⟩
    have hi₁ : (ϖ : L)⁻¹ * (α - r i * γ) ∈ O := by
      have he : (ϖ : L)⁻¹ * (α - r i * γ) =
          (ϖ : L)⁻¹ * (α - t * γ) + (ϖ : L)⁻¹ * (t - r i) * γ := by
        ring1
      rw [he]
      exact O.add_mem _ _ ht₁ (O.mul_mem _ _ hi hγO)
    have hi₂ : (ϖ : L)⁻¹ * (β - r i * δ) ∈ O := by
      have he : (ϖ : L)⁻¹ * (β - r i * δ) =
          (ϖ : L)⁻¹ * (β - t * δ) + (ϖ : L)⁻¹ * (t - r i) * δ := by
        ring1
      rw [he]
      exact O.add_mem _ _ ht₂ (O.mul_mem _ _ hi hδO)
    have he₁ : (ϖ : L)⁻¹ * α + -((ϖ : L)⁻¹ * r i * γ) = (ϖ : L)⁻¹ * (α - r i * γ) := by
      ring1
    have he₂ : (ϖ : L)⁻¹ * β + -((ϖ : L)⁻¹ * r i * δ) = (ϖ : L)⁻¹ * (β - r i * δ) := by
      ring1
    refine ⟨some i, ?_, fun o ho ↦ hu o (some i) ho ?_⟩ <;>
    · refine mem_gl2_of_apply_mem_of_det (fun a b ↦ ?_) (hd₃ (some i))
      fin_cases a <;> fin_cases b <;>
        simp [heckeRep, mul_apply, hα, hβ, hγ, hδ, hγO, hδO, he₁, he₂, hi₁, hi₂]

private lemma sum_eq_sum_of_cosetSystems {G α β : Type*} [Group G] [Fintype α] [Fintype β]
    {K : Subgroup G} {S : Set G} {x : α → G} {x' : β → G}
    (hx : ∀ y ∈ S, ∃! a, (x a)⁻¹ * y ∈ K) (hx' : ∀ y ∈ S, ∃! b, (x' b)⁻¹ * y ∈ K)
    (hxS : ∀ a, x a ∈ S) (hxS' : ∀ b, x' b ∈ S) {ψ : G → ℂ}
    (hψ : ∀ h, ∀ k ∈ K, ψ (h * k) = ψ h) : ∑ a, ψ (x a) = ∑ b, ψ (x' b) := by
  choose f hf hf' using fun a ↦ hx' (x a) (hxS a)
  choose g hg hg' using fun b ↦ hx (x' b) (hxS' b)
  have hgf (a : α) : g (f a) = a := by
    refine (hg' (f a) a ?_).symm
    simpa using Subgroup.inv_mem _ (hf a)
  have hfg (b : β) : f (g b) = b := by
    refine (hf' (g b) b ?_).symm
    simpa using Subgroup.inv_mem _ (hg b)
  refine Fintype.sum_equiv ⟨f, g, hgf, hfg⟩ _ _ fun a ↦ ?_
  have h : ψ (x' (f a) * ((x' (f a))⁻¹ * x a)) = ψ (x' (f a)) := hψ _ _ (hf a)
  rw [mul_inv_cancel_left] at h
  exact h

variable {ψ : GL (Fin 2) L → ℂ}

/-- **The Hecke sum of a right `K`-invariant function is right `K`-invariant**, for `K = GL₂(O)`:
left multiplication by `k ∈ K` permutes the cosets of `K diag(ϖ, 1) K / K`. -/
lemma IsUniformizer.heckeSum_mul [Fintype ι] (hϖ : O.IsUniformizer ϖ) (hr : O.IsResidueSystem ϖ r)
    (hψ : ∀ h, ∀ k ∈ O.gl2, ψ (h * k) = ψ h) (h : GL (Fin 2) L) {k : GL (Fin 2) L}
    (hk : k ∈ O.gl2) : heckeSum ϖ r ψ (h * k) = heckeSum ϖ r ψ h := by
  simp only [heckeSum, mul_assoc]
  refine sum_eq_sum_of_cosetSystems (K := O.gl2) (S := O.heckeSet ϖ)
    (x := fun o ↦ k * heckeRep ϖ r o) (x' := heckeRep ϖ r) (ψ := fun z ↦ ψ (h * z))
    (fun y hy ↦ ?_) (fun y hy ↦ hϖ.existsUnique_heckeRep hr hy)
    (fun o ↦ mul_mem_heckeSet hk (hϖ.heckeRep_mem_heckeSet hr o))
    (fun o ↦ hϖ.heckeRep_mem_heckeSet hr o) fun z l hl ↦ ?_
  · simpa only [mul_inv_rev, mul_assoc] using
      hϖ.existsUnique_heckeRep hr (mul_mem_heckeSet (Subgroup.inv_mem _ hk) hy)
  · rw [← mul_assoc]
    exact hψ _ l hl

private lemma IsUniformizer.heckeSet_subset {ϖ₁ ϖ₂ : L} (h₁ : O.IsUniformizer ϖ₁)
    (h₂ : O.IsUniformizer ϖ₂) : O.heckeSet ϖ₁ ⊆ O.heckeSet ϖ₂ := by
  intro y hy
  have h₃ : ϖ₂⁻¹ * ϖ₁ ∈ O := h₂.dvd ϖ₁ h₁.mem h₁.inv_notMem
  have h₄ : ϖ₁⁻¹ * ϖ₂ ∈ O := h₁.dvd ϖ₂ h₂.mem h₂.inv_notMem
  have hϖ₁ : ϖ₁ ≠ 0 := by
    rintro rfl
    exact h₁.inv_notMem (by simp)
  refine ⟨hy.1, ?_, ?_⟩
  · have he : ϖ₂⁻¹ * (y : Matrix (Fin 2) (Fin 2) L).det =
        ϖ₂⁻¹ * ϖ₁ * (ϖ₁⁻¹ * (y : Matrix (Fin 2) (Fin 2) L).det) := by
      field_simp
    rw [he]
    exact O.mul_mem _ _ h₃ hy.2.1
  · have he : ϖ₂ * (y : Matrix (Fin 2) (Fin 2) L).det⁻¹ =
        ϖ₁⁻¹ * ϖ₂ * (ϖ₁ * (y : Matrix (Fin 2) (Fin 2) L).det⁻¹) := by
      field_simp
    rw [he]
    exact O.mul_mem _ _ h₄ hy.2.2

/-- **The Hecke sum of a right `K`-invariant function does not depend on the choices**: of the
uniformizer `ϖ` nor of the system of representatives `r` of the residue field. -/
lemma IsUniformizer.heckeSum_eq {ι' : Type*} [Fintype ι] [Fintype ι'] {r' : ι' → L}
    (hϖ : O.IsUniformizer ϖ) (hr : O.IsResidueSystem ϖ r) {ϖ' : Lˣ} (hϖ' : O.IsUniformizer ϖ')
    (hr' : O.IsResidueSystem ϖ' r') (hψ : ∀ h, ∀ k ∈ O.gl2, ψ (h * k) = ψ h) (h : GL (Fin 2) L) :
    heckeSum ϖ r ψ h = heckeSum ϖ' r' ψ h := by
  refine sum_eq_sum_of_cosetSystems (K := O.gl2) (S := O.heckeSet ϖ)
    (x := heckeRep ϖ r) (x' := heckeRep ϖ' r') (ψ := fun z ↦ ψ (h * z))
    (fun y hy ↦ hϖ.existsUnique_heckeRep hr hy)
    (fun y hy ↦ hϖ'.existsUnique_heckeRep hr' (hϖ.heckeSet_subset hϖ' hy))
    (fun o ↦ hϖ.heckeRep_mem_heckeSet hr o)
    (fun o ↦ hϖ'.heckeSet_subset hϖ (hϖ'.heckeRep_mem_heckeSet hr' o)) fun z l hl ↦ ?_
  rw [← mul_assoc]
  exact hψ _ l hl

end ValuationSubring
