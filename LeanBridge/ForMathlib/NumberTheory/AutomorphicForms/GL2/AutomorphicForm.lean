import LeanBridge.ForMathlib.NumberTheory.AutomorphicForms.GL2.Level
import Mathlib.Analysis.Calculus.ContDiff.Operations
import Mathlib.Analysis.Calculus.Deriv.Comp
import Mathlib.Analysis.Calculus.FDeriv.Comp
import Mathlib.Analysis.Complex.Exponential
import Mathlib.Analysis.Normed.Ring.Units
import Mathlib.Analysis.SpecialFunctions.ExpDeriv
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.LinearAlgebra.UnitaryGroup
import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.MeasureTheory.Measure.Haar.Basic
import TauCeti.NumberTheory.NumberField.Global.Adeles.CompactQuotient
import TauCeti.NumberTheory.NumberField.Global.Adeles.Discrete
import TauCeti.NumberTheory.NumberField.Global.HeckeCharacter.Basic

/-!
# Automorphic forms on `GL₂(𝔸_F)`

Let `F` be a number field. An **automorphic form** on `GL(2)` over `F` with central character `ω`, a
Hecke character of `F` (Tau Ceti's `TauCeti.GlobalNumberFields.HeckeCharacter`, a continuous
character of the idele class group), is a function `φ : GL₂(𝔸_F) → ℂ` such that

* `φ(γ g) = φ(g)` for `γ ∈ GL₂(F)`,
* `φ(z g) = ω(z) φ(g)` for `z ∈ 𝔸_Fˣ`,
* `φ` is smooth in the archimedean variable,
* `φ` is invariant on the right under an open subgroup of `GL₂(𝔸_F^f)` (locally constant in the
  finite variable, uniformly),
* the right translates of `φ` by the maximal compact subgroup
  `K_∞ = ∏_{v real} O(2) × ∏_{v complex} U(2)` of `GL₂(F_∞)` span a finite dimensional space,
* `φ` is finite under the centre of the universal enveloping algebra of the complexified Lie algebra
  of `GL₂(F_∞)`, which is generated by the central elements, which act through `ω`, and by the
  Casimir operators: one at a real place, two at a complex place,
* `φ` is of moderate growth: for every `y ∈ GL₂(𝔸_F^f)`, the function `x ↦ φ(x y)` on `GL₂(F_∞)` is
  slowly increasing (Borel-Jacquet, *Automorphic forms and automorphic representations*, Corvallis,
  §4.2).

It is **cuspidal** if its constant term `∫_{F \ 𝔸_F} φ(n(x) g) dx` vanishes for all `g`, where
`n(x) = (1, x; 0, 1)` and `dx` is a Haar measure.

The archimedean calculus is done over the mixed space `E = ℝ^{r₁} × ℂ^{r₂}`, identified with
`F_∞ = ∏_v F_v`, with `GL₂(F_∞) = GL₂(E)` an open subset of the normed space of `2 × 2` matrices
over `E`.

## Main definitions

* `AdelicGL2.mixedExp`: the exponential of the mixed space.
* `AdelicGL2.sl2Exp`: the one-parameter subgroups of `SL₂(E)`.
* `AdelicGL2.lieDeriv`: the action `(Xφ)(g) = d/dt φ(g exp(tX))|_{t=0}` of the basis `y H`, `y E`,
  `y F` of the Lie algebra `𝔰𝔩₂(E)`, for `y ∈ E`.
* `AdelicGL2.casimirReal`, `AdelicGL2.casimirHolo`, `AdelicGL2.casimirAntiholo`: the Casimir
  operators at a real place and the two Casimir operators at a complex place.
* `AdelicGL2.kInfSpan`: the span of the right translates by `K_∞`.
* `AdelicGL2.IsSmoothAtInfinity`, `AdelicGL2.IsKFinite`, `AdelicGL2.IsCasimirFinite`,
  `AdelicGL2.HasModerateGrowth`: the analytic conditions.
* `AdelicGL2.IsAutomorphicForm`: automorphic forms with a given central character.
* `AdelicGL2.constantTerm`, `AdelicGL2.IsCuspidal`: the constant term and cuspidality.

## Main results

* `AdelicGL2.IsSmoothOnGL.hasDerivAt_mul_sl2Exp`: the derivative along a one-parameter subgroup of a
  smooth function.
* `AdelicGL2.IsSmoothAtInfinity.lieDeriv`: the Lie algebra preserves smooth functions.
-/

open Filter IsDedekindDomain Matrix NumberField MeasureTheory TauCeti GlobalNumberFields

open mixedEmbedding (mixedSpace)

open scoped AdeleRing MatrixGroups Classical

namespace AdelicGL2

variable {F : Type*} [Field F]

/-- The **exponential** `E → Eˣ` of the mixed space `E = ℝ^{r₁} × ℂ^{r₂}`, coordinatewise. -/
noncomputable def mixedExp (w : mixedSpace F) : (mixedSpace F)ˣ where
  val := (fun v ↦ Real.exp (w.1 v), fun v ↦ Complex.exp (w.2 v))
  inv := (fun v ↦ Real.exp (-w.1 v), fun v ↦ Complex.exp (-w.2 v))
  val_inv := by
    refine Prod.ext (funext fun v ↦ ?_) (funext fun v ↦ ?_)
    · simp [← Real.exp_add]
    · simp [← Complex.exp_add]
  inv_val := by
    refine Prod.ext (funext fun v ↦ ?_) (funext fun v ↦ ?_)
    · simp [← Real.exp_add]
    · simp [← Complex.exp_add]

/-- The **one-parameter subgroups** `w ↦ exp(wX)` of `SL₂(E)`, inside `GL₂(E)`, for the basis
`X = H, E, F` of `𝔰𝔩₂`: `exp(wH) = (e^w, 0; 0, e^{-w})`, `exp(wE) = (1, w; 0, 1)` and
`exp(wF) = (1, 0; w, 1)`. -/
noncomputable def sl2Exp : Fin 3 → mixedSpace F → GL (Fin 2) (mixedSpace F)
  | 0, w => ⟨!![(mixedExp w : mixedSpace F), 0; 0, ((mixedExp w)⁻¹ : (mixedSpace F)ˣ)],
      !![((mixedExp w)⁻¹ : (mixedSpace F)ˣ), 0; 0, (mixedExp w : mixedSpace F)],
      Matrix.ext fun a b ↦ by fin_cases a <;> fin_cases b <;> simp,
      Matrix.ext fun a b ↦ by fin_cases a <;> fin_cases b <;> simp⟩
  | 1, w => ⟨!![1, w; 0, 1], !![1, -w; 0, 1],
      Matrix.ext fun a b ↦ by fin_cases a <;> fin_cases b <;> simp,
      Matrix.ext fun a b ↦ by fin_cases a <;> fin_cases b <;> simp⟩
  | 2, w => ⟨!![1, 0; w, 1], !![1, 0; -w, 1],
      Matrix.ext fun a b ↦ by fin_cases a <;> fin_cases b <;> simp,
      Matrix.ext fun a b ↦ by fin_cases a <;> fin_cases b <;> simp⟩

/-- The matrix `y B ∈ 𝔰𝔩₂(E)`, for `y ∈ E` and `B = H, E, F`, the derivative at `0` of
`t ↦ exp(t y B)`. -/
def lieMatrix : Fin 3 → mixedSpace F → Matrix (Fin 2) (Fin 2) (mixedSpace F)
  | 0, y => !![y, 0; 0, -y]
  | 1, y => !![0, y; 0, 0]
  | 2, y => !![0, 0; y, 0]

/-- The element of `E` equal to `1` at the real place `v` and to `0` at the other places. -/
noncomputable def realUnit (v : {v : InfinitePlace F // v.IsReal}) : mixedSpace F :=
  (Pi.single v 1, 0)

/-- The element of `E` equal to `c` at the complex place `v` and to `0` at the other places. -/
noncomputable def complexPoint (v : {v : InfinitePlace F // v.IsComplex}) (c : ℂ) : mixedSpace F :=
  (0, Pi.single v c)

/-- The extension by zero to all `2 × 2` matrices over `E` of a function on `GL₂(E)`. -/
noncomputable def extendGL (Φ : GL (Fin 2) (mixedSpace F) → ℂ)
    (m : Fin 2 → Fin 2 → mixedSpace F) : ℂ :=
  if h : IsUnit (of m) then Φ h.unit else 0

private lemma mixedExp_zero : mixedExp (0 : mixedSpace F) = 1 :=
  Units.ext <| Prod.ext (funext fun _ ↦ by simp [mixedExp]) (funext fun _ ↦ by simp [mixedExp])

lemma sl2Exp_zero (b : Fin 3) : sl2Exp b (0 : mixedSpace F) = 1 := by
  refine GeneralLinearGroup.ext fun i j ↦ ?_
  fin_cases b <;> fin_cases i <;> fin_cases j <;> simp [sl2Exp, mixedExp_zero]

lemma det_sl2Exp (b : Fin 3) (w : mixedSpace F) : GeneralLinearGroup.det (sl2Exp b w) = 1 := by
  refine Units.ext ?_
  fin_cases b <;> simp [sl2Exp, GeneralLinearGroup.det]

lemma extendGL_of_isUnit (Φ : GL (Fin 2) (mixedSpace F) → ℂ) {m : Fin 2 → Fin 2 → mixedSpace F}
    (h : IsUnit (of m)) : extendGL Φ m = Φ h.unit := by
  simp [extendGL, h]

lemma extendGL_coe (Φ : GL (Fin 2) (mixedSpace F) → ℂ) (x : GL (Fin 2) (mixedSpace F)) :
    extendGL Φ (fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j) = Φ x := by
  have h : IsUnit (of fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j) := x.isUnit
  rw [extendGL_of_isUnit Φ h]
  exact congrArg Φ (Units.ext rfl)

private lemma extendGL_add (Φ₁ Φ₂ : GL (Fin 2) (mixedSpace F) → ℂ) :
    extendGL (Φ₁ + Φ₂) = extendGL Φ₁ + extendGL Φ₂ := by
  ext m
  by_cases h : IsUnit (of m) <;> simp [extendGL, h]

private lemma extendGL_smul (c : ℂ) (Φ : GL (Fin 2) (mixedSpace F) → ℂ) :
    extendGL (c • Φ) = c • extendGL Φ := by
  ext m
  by_cases h : IsUnit (of m) <;> simp [extendGL, h]

variable [NumberField F]

/-- The action `(Xφ)(g) = d/dt φ(g exp(tX))|_{t=0}` of the element `X = y B` of the Lie algebra
`𝔰𝔩₂(E)` on functions on `GL₂(𝔸_F)`, for `y ∈ E` and `B = H, E, F`: the derivative for the right
regular representation of the archimedean factor. -/
noncomputable def lieDeriv (b : Fin 3) (y : mixedSpace F) (φ : AdelicGL2 F → ℂ) : AdelicGL2 F → ℂ :=
  fun g ↦ deriv (fun t : ℝ ↦ φ (g * ofInf F (sl2Exp b (t • y)))) 0

/-- The **quadratic form of the Casimir operator**, `H² / 2 + E F + F E`, in terms of the actions
`D 0`, `D 1`, `D 2` of `H`, `E`, `F`. -/
noncomputable def casimirOf (D : Fin 3 → (AdelicGL2 F → ℂ) → AdelicGL2 F → ℂ)
    (φ : AdelicGL2 F → ℂ) : AdelicGL2 F → ℂ :=
  (2⁻¹ : ℂ) • D 0 (D 0 φ) + D 1 (D 2 φ) + D 2 (D 1 φ)

/-- The **Casimir operator** `Ω_v = H² / 2 + E F + F E` of `GL₂(F_v) = GL₂(ℝ)` at a real place `v`,
which with the centre of the Lie algebra generates the centre of the universal enveloping algebra of
the complexified Lie algebra of `GL₂(F_v)`. -/
noncomputable def casimirReal (v : {v : InfinitePlace F // v.IsReal}) :
    (AdelicGL2 F → ℂ) → AdelicGL2 F → ℂ :=
  casimirOf fun b ↦ lieDeriv b (realUnit v)

/-- The action of the element `B₁ = (B ⊗ 1 - iB ⊗ i) / 2` of the complexified Lie algebra of
`SL₂(F_v) = SL₂(ℂ)` at a complex place `v`, for `B = H, E, F`: it is `(B, 0)` in
`𝔰𝔩₂(ℂ) ⊗_ℝ ℂ = 𝔰𝔩₂(ℂ) × 𝔰𝔩₂(ℂ)`. -/
noncomputable def lieDerivHolo (v : {v : InfinitePlace F // v.IsComplex}) (b : Fin 3)
    (φ : AdelicGL2 F → ℂ) : AdelicGL2 F → ℂ :=
  (2⁻¹ : ℂ) • (lieDeriv b (complexPoint v 1) φ -
    Complex.I • lieDeriv b (complexPoint v Complex.I) φ)

/-- The action of the element `B₂ = (B ⊗ 1 + iB ⊗ i) / 2` of the complexified Lie algebra of
`SL₂(F_v) = SL₂(ℂ)` at a complex place `v`, for `B = H, E, F`: it is `(0, B)` in
`𝔰𝔩₂(ℂ) ⊗_ℝ ℂ = 𝔰𝔩₂(ℂ) × 𝔰𝔩₂(ℂ)`. -/
noncomputable def lieDerivAntiholo (v : {v : InfinitePlace F // v.IsComplex}) (b : Fin 3)
    (φ : AdelicGL2 F → ℂ) : AdelicGL2 F → ℂ :=
  (2⁻¹ : ℂ) • (lieDeriv b (complexPoint v 1) φ +
    Complex.I • lieDeriv b (complexPoint v Complex.I) φ)

/-- The **first Casimir operator** `H₁² / 2 + E₁ F₁ + F₁ E₁` of `GL₂(F_v) = GL₂(ℂ)` at a complex
place `v`. With the second one and the centre of the Lie algebra, it generates the centre of the
universal enveloping algebra of the complexified Lie algebra of `GL₂(F_v)`. -/
noncomputable def casimirHolo (v : {v : InfinitePlace F // v.IsComplex}) :
    (AdelicGL2 F → ℂ) → AdelicGL2 F → ℂ :=
  casimirOf (lieDerivHolo v)

/-- The **second Casimir operator** `H₂² / 2 + E₂ F₂ + F₂ E₂` of `GL₂(F_v) = GL₂(ℂ)` at a complex
place `v`. -/
noncomputable def casimirAntiholo (v : {v : InfinitePlace F // v.IsComplex}) :
    (AdelicGL2 F → ℂ) → AdelicGL2 F → ℂ :=
  casimirOf (lieDerivAntiholo v)

/-- A function on `GL₂(E)` is **smooth** if it is `C^∞` on the open subset `GL₂(E)` of the real
vector space of `2 × 2` matrices over `E`. -/
def IsSmoothOnGL (Φ : GL (Fin 2) (mixedSpace F) → ℂ) : Prop :=
  ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (extendGL Φ) {m | IsUnit (of m)}

/-- A function on `GL₂(𝔸_F)` is **smooth in the archimedean variable** if `x ↦ φ(g x)` is smooth on
`GL₂(E) = GL₂(F_∞)` for every `g`. -/
def IsSmoothAtInfinity (φ : AdelicGL2 F → ℂ) : Prop :=
  ∀ g : AdelicGL2 F, IsSmoothOnGL fun x ↦ φ (g * ofInf F x)

/-- The right translate `g ↦ φ(g h)` of a function on `GL₂(𝔸_F)`. -/
noncomputable def rightTranslate (h : AdelicGL2 F) (φ : AdelicGL2 F → ℂ) : AdelicGL2 F → ℂ :=
  fun g ↦ φ (g * h)

/-- The span of the right translates of a function on `GL₂(𝔸_F)` by the maximal compact subgroup
`K_∞` of `GL₂(F_∞)`, the unitary group of `E`, which is `∏_{v real} O(2) × ∏_{v complex} U(2)`. -/
noncomputable def kInfSpan (φ : AdelicGL2 F → ℂ) : Submodule ℂ (AdelicGL2 F → ℂ) :=
  Submodule.span ℂ (Set.range fun k : unitaryGroup (Fin 2) (mixedSpace F) ↦
    rightTranslate (ofInf F (Unitary.toUnits k)) φ)

/-- A function on `GL₂(𝔸_F)` is **`K_∞`-finite** if its right translates by the maximal compact
subgroup `K_∞` of `GL₂(F_∞)` span a finite dimensional space. -/
def IsKFinite (φ : AdelicGL2 F → ℂ) : Prop :=
  FiniteDimensional ℂ (kInfSpan φ)

/-- A function on `GL₂(𝔸_F)` is **finite under the Casimir operators** if it lies in a finite
dimensional space of smooth functions stable under the Casimir operators at all the infinite places,
one at a real place and two at a complex place. -/
def IsCasimirFinite (φ : AdelicGL2 F → ℂ) : Prop :=
  ∃ W : Submodule ℂ (AdelicGL2 F → ℂ), FiniteDimensional ℂ W ∧ φ ∈ W ∧
    (∀ ψ ∈ W, IsSmoothAtInfinity ψ) ∧ (∀ v, ∀ ψ ∈ W, casimirReal v ψ ∈ W) ∧
      (∀ v, ∀ ψ ∈ W, casimirHolo v ψ ∈ W) ∧ ∀ v, ∀ ψ ∈ W, casimirAntiholo v ψ ∈ W

/-- A norm on `GL₂(E)`, the sum of the absolute values of the entries of `x` and `x⁻¹`, with `1`
added. -/
noncomputable def infHeight (x : GL (Fin 2) (mixedSpace F)) : ℝ :=
  1 + ∑ i, ∑ j, (‖(x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j‖ +
    ‖((x⁻¹ : GL (Fin 2) (mixedSpace F)) : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j‖)

/-- A function on `GL₂(𝔸_F)` has **moderate growth** if for every `y ∈ GL₂(𝔸_F^f)`, the function
`x ↦ φ(x y)` on `GL₂(F_∞)` is slowly increasing (Borel-Jacquet, Corvallis, §4.2). -/
def HasModerateGrowth (φ : AdelicGL2 F → ℂ) : Prop :=
  ∀ y : GL (Fin 2) 𝔸ᶠ[F], ∃ (C : ℝ) (n : ℕ), ∀ x,
    ‖φ (ofInf F x * ofFin F y)‖ ≤ C * infHeight x ^ n

/-- An **automorphic form** on `GL(2)` over the number field `F` with central character `ω`: see the
module docstring. No holomorphy or cuspidality is imposed; holomorphy at a real place is a condition
on the `K_∞`-type (the weight) and on a lowering operator. -/
structure IsAutomorphicForm (ω : HeckeCharacter F) (φ : AdelicGL2 F → ℂ) : Prop where
  /-- `φ` is left invariant under `GL₂(F)`. -/
  left_invariant (γ : GL (Fin 2) F) (g : AdelicGL2 F) : φ (ofGlobal F γ * g) = φ g
  /-- `φ` has central character `ω`. -/
  central (z : IdeleGroup (𝓞 F) F) (g : AdelicGL2 F) :
    φ (scalar F z * g) = (ω (QuotientGroup.mk z) : ℂ) * φ g
  /-- `φ` is smooth in the archimedean variable. -/
  smooth : IsSmoothAtInfinity φ
  /-- `φ` is right invariant under an open subgroup of `GL₂(𝔸_F^f)`. -/
  exists_openSubgroup : ∃ U : OpenSubgroup (GL (Fin 2) 𝔸ᶠ[F]),
    ∀ u ∈ U, ∀ g, φ (g * ofFin F u) = φ g
  /-- `φ` is `K_∞`-finite. -/
  kFinite : IsKFinite φ
  /-- `φ` is finite under the Casimir operators. -/
  casimirFinite : IsCasimirFinite φ
  /-- `φ` has moderate growth. -/
  moderateGrowth : HasModerateGrowth φ

variable (F) in
/-- The compact quotient `𝔸_F / F`. -/
abbrev AdeleQuotient : Type _ :=
  𝔸[F] ⧸ AdeleRing.principalSubgroup (𝓞 F) F

/-- The Borel `σ`-algebra of `𝔸_F / F`, scoped to `AdelicGL2`: Mathlib and Tau Ceti give none. -/
noncomputable scoped instance : MeasurableSpace (AdeleQuotient F) := borel _

scoped instance : BorelSpace (AdeleQuotient F) := ⟨rfl⟩

/-- The **constant term** `∫_{F \ 𝔸_F} φ(n(x) g) dx` at `g` of a function `φ` on `GL₂(𝔸_F)` which is
left invariant under the matrices `n(x)`, `x ∈ F`, for a Haar measure on the compact group
`F \ 𝔸_F`. For such a `φ` the integrand does not depend on the representative chosen for `x`. -/
noncomputable def constantTerm (φ : AdelicGL2 F → ℂ) (g : AdelicGL2 F) : ℂ :=
  ∫ x : AdeleQuotient F, φ (unipotent (Quotient.out x) * g) ∂Measure.addHaar

/-- A function on `GL₂(𝔸_F)` is **cuspidal** if its constant term vanishes everywhere. -/
def IsCuspidal (φ : AdelicGL2 F → ℂ) : Prop :=
  ∀ g, constantTerm φ g = 0

/-! ### The calculus on `GL₂(E)` -/

private lemma hasDerivAt_mixedExp (y : mixedSpace F) :
    HasDerivAt (fun t : ℝ ↦ (mixedExp (t • y) : mixedSpace F)) y 0 := by
  refine HasDerivAt.prodMk (hasDerivAt_pi.mpr fun v ↦ ?_) (hasDerivAt_pi.mpr fun v ↦ ?_)
  · simpa [mixedExp] using ((hasDerivAt_id (0 : ℝ)).mul_const (y.1 v)).exp
  · simpa [mixedExp] using ((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const (y.2 v)).cexp

private lemma hasDerivAt_mixedExp_inv (y : mixedSpace F) :
    HasDerivAt (fun t : ℝ ↦ (((mixedExp (t • y))⁻¹ : (mixedSpace F)ˣ) : mixedSpace F)) (-y) 0 := by
  refine HasDerivAt.prodMk (hasDerivAt_pi.mpr fun v ↦ ?_) (hasDerivAt_pi.mpr fun v ↦ ?_)
  · simpa [mixedExp] using ((hasDerivAt_id (0 : ℝ)).mul_const (y.1 v)).neg.exp
  · simpa [mixedExp] using ((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const (y.2 v)).neg.cexp

variable (b : Fin 3) (y : mixedSpace F)

lemma hasDerivAt_sl2Exp : HasDerivAt
    (fun t : ℝ ↦ fun i j ↦ (sl2Exp b (t • y) : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j)
    (fun i j ↦ lieMatrix b y i j) 0 := by
  refine hasDerivAt_pi.mpr fun i ↦ hasDerivAt_pi.mpr fun j ↦ ?_
  fin_cases b <;> fin_cases i <;> fin_cases j <;>
    simp only [sl2Exp, lieMatrix, Fin.zero_eta, Fin.mk_one, of_apply, cons_val', cons_val_zero,
      cons_val_one, cons_val_fin_one] <;>
    first
      | exact hasDerivAt_const _ _
      | exact hasDerivAt_mixedExp y
      | exact hasDerivAt_mixedExp_inv y
      | simpa using (hasDerivAt_id (0 : ℝ)).smul_const y

variable (F) in
lemma isOpen_setOf_isUnit : IsOpen {m : Fin 2 → Fin 2 → mixedSpace F | IsUnit (of m)} := by
  have h : {m : Fin 2 → Fin 2 → mixedSpace F | IsUnit (of m)} =
      (fun m ↦ (of m).det) ⁻¹' {z | IsUnit z} := by
    ext m
    simp [isUnit_iff_isUnit_det]
  rw [h]
  exact Units.isOpen.preimage (Continuous.matrix_det continuous_id)

variable {Φ Φ₁ Φ₂ : GL (Fin 2) (mixedSpace F) → ℂ}

/-- The composite of `Φ` with the curve `t ↦ x exp(t y B)` has a derivative at `0`, given by the
Fréchet derivative of the extension of `Φ` in the direction of `x (y B)`. -/
lemma IsSmoothOnGL.hasDerivAt_mul_sl2Exp (hΦ : IsSmoothOnGL Φ) (x : GL (Fin 2) (mixedSpace F)) :
    HasDerivAt (fun t : ℝ ↦ Φ (x * sl2Exp b (t • y)))
      (fderiv ℝ (extendGL Φ) (fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j)
        (fun i j ↦ ((x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) * lieMatrix b y) i j)) 0 := by
  have hm : (fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j) ∈
      {m : Fin 2 → Fin 2 → mixedSpace F | IsUnit (of m)} := x.isUnit
  have hd : HasFDerivAt (extendGL Φ) (fderiv ℝ (extendGL Φ)
      (fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j))
      (fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j) :=
    ((hΦ.contDiffAt ((isOpen_setOf_isUnit F).mem_nhds hm)).differentiableAt (by simp)).hasFDerivAt
  have hc : HasDerivAt (fun (t : ℝ) (i j : Fin 2) ↦
      ((x * sl2Exp b (t • y) : GL (Fin 2) (mixedSpace F)) :
        Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j)
      (fun i j ↦ ((x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) * lieMatrix b y) i j) 0 := by
    refine hasDerivAt_pi.mpr fun i ↦ hasDerivAt_pi.mpr fun j ↦ ?_
    simp only [Units.val_mul, Matrix.mul_apply]
    exact HasDerivAt.fun_sum fun l _ ↦
      (hasDerivAt_pi.mp (hasDerivAt_pi.mp (hasDerivAt_sl2Exp b y) l) j).const_mul _
  have h₀ : (fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j) =
      fun (i j : Fin 2) ↦ ((x * sl2Exp b ((0 : ℝ) • y) : GL (Fin 2) (mixedSpace F)) :
        Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j := by
    rw [zero_smul, sl2Exp_zero, mul_one]
  exact (hd.comp_hasDerivAt_of_eq 0 hc h₀).congr_of_eventuallyEq <| Eventually.of_forall fun t ↦
    (extendGL_coe Φ (x * sl2Exp b (t • y))).symm

lemma IsSmoothOnGL.continuous (hΦ : IsSmoothOnGL Φ) : Continuous Φ := by
  have h : Φ = extendGL Φ ∘
      fun (x : GL (Fin 2) (mixedSpace F)) i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j :=
    funext fun x ↦ (extendGL_coe Φ x).symm
  rw [h]
  have hv : Continuous fun (x : GL (Fin 2) (mixedSpace F)) (i j : Fin 2) ↦
      (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j :=
    continuous_pi fun i ↦ continuous_pi fun j ↦
      (continuous_id.matrix_elem i j).comp Units.continuous_val
  exact hΦ.continuousOn.comp_continuous hv fun x ↦ x.isUnit

lemma IsSmoothOnGL.add (h₁ : IsSmoothOnGL Φ₁) (h₂ : IsSmoothOnGL Φ₂) : IsSmoothOnGL (Φ₁ + Φ₂) := by
  rw [IsSmoothOnGL, extendGL_add]
  exact ContDiffOn.add h₁ h₂

lemma IsSmoothOnGL.const_smul (c : ℂ) (h : IsSmoothOnGL Φ) : IsSmoothOnGL (c • Φ) := by
  rw [IsSmoothOnGL, extendGL_smul]
  exact ContDiffOn.const_smul c h

lemma isSmoothOnGL_const (c : ℂ) : IsSmoothOnGL (fun _ : GL (Fin 2) (mixedSpace F) ↦ c) :=
  contDiffOn_const.congr fun _ hm ↦ extendGL_of_isUnit _ hm

variable {φ φ₁ φ₂ : AdelicGL2 F → ℂ}

lemma IsSmoothAtInfinity.add (h₁ : IsSmoothAtInfinity φ₁) (h₂ : IsSmoothAtInfinity φ₂) :
    IsSmoothAtInfinity (φ₁ + φ₂) :=
  fun g ↦ (h₁ g).add (h₂ g)

lemma IsSmoothAtInfinity.const_smul (c : ℂ) (h : IsSmoothAtInfinity φ) :
    IsSmoothAtInfinity (c • φ) :=
  fun g ↦ (h g).const_smul c

lemma isSmoothAtInfinity_const (c : ℂ) : IsSmoothAtInfinity (fun _ : AdelicGL2 F ↦ c) :=
  fun _ ↦ isSmoothOnGL_const c

lemma IsSmoothAtInfinity.hasDerivAt (h : IsSmoothAtInfinity φ) (g : AdelicGL2 F) :
    HasDerivAt (fun t : ℝ ↦ φ (g * ofInf F (sl2Exp b (t • y)))) (lieDeriv b y φ g) 0 := by
  have hd : DifferentiableAt ℝ (fun t : ℝ ↦ φ (g * ofInf F (sl2Exp b (t • y)))) 0 := by
    simpa only [one_mul] using ((h g).hasDerivAt_mul_sl2Exp b y 1).differentiableAt
  exact hd.hasDerivAt

lemma lieDeriv_mul_ofInf (h : IsSmoothAtInfinity φ) (g : AdelicGL2 F)
    (x : GL (Fin 2) (mixedSpace F)) : lieDeriv b y φ (g * ofInf F x) =
      fderiv ℝ (extendGL fun x ↦ φ (g * ofInf F x))
        (fun i j ↦ (x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) i j)
        (fun i j ↦ ((x : Matrix (Fin 2) (Fin 2) (mixedSpace F)) * lieMatrix b y) i j) := by
  simp only [lieDeriv, mul_assoc, ← map_mul]
  exact ((h g).hasDerivAt_mul_sl2Exp b y x).deriv

/-- **`Xφ` is smooth when `φ` is**: the operators `X` of the Lie algebra preserve smoothness. -/
lemma IsSmoothAtInfinity.lieDeriv (h : IsSmoothAtInfinity φ) :
    IsSmoothAtInfinity (lieDeriv b y φ) := fun g ↦ by
  have hmul : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) fun (m : Fin 2 → Fin 2 → mixedSpace F)
      (i j : Fin 2) ↦ (of m * lieMatrix b y) i j := by
    refine contDiff_pi.mpr fun i ↦ contDiff_pi.mpr fun j ↦ ?_
    simp only [Matrix.mul_apply, of_apply]
    exact ContDiff.sum fun l _ ↦ (contDiff_apply_apply ℝ i l).mul contDiff_const
  have hf : ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun m : Fin 2 → Fin 2 → mixedSpace F ↦
      fderiv ℝ (extendGL fun x ↦ φ (g * ofInf F x)) m (fun i j ↦ (of m * lieMatrix b y) i j))
      {m | IsUnit (of m)} :=
    ((h g).fderiv_of_isOpen (isOpen_setOf_isUnit F) (by simp)).clm_apply hmul.contDiffOn
  refine hf.congr fun m hm ↦ ?_
  rw [extendGL_of_isUnit _ hm, lieDeriv_mul_ofInf b y h]
  rfl

lemma lieDeriv_add (h₁ : IsSmoothAtInfinity φ₁) (h₂ : IsSmoothAtInfinity φ₂) :
    lieDeriv b y (φ₁ + φ₂) = lieDeriv b y φ₁ + lieDeriv b y φ₂ :=
  funext fun g ↦ ((h₁.hasDerivAt b y g).add (h₂.hasDerivAt b y g)).deriv

lemma lieDeriv_const_smul (c : ℂ) (h : IsSmoothAtInfinity φ) :
    lieDeriv b y (c • φ) = c • lieDeriv b y φ :=
  funext fun g ↦ ((h.hasDerivAt b y g).const_mul c).deriv

/-- A **linear operator on smooth functions**: an operator on the functions on `GL₂(𝔸_F)` which
preserves smoothness in the archimedean variable and is linear on smooth functions. -/
structure IsSmoothOperator (D : (AdelicGL2 F → ℂ) → AdelicGL2 F → ℂ) : Prop where
  /-- The operator preserves smoothness. -/
  smooth (ψ : AdelicGL2 F → ℂ) : IsSmoothAtInfinity ψ → IsSmoothAtInfinity (D ψ)
  /-- The operator is additive on smooth functions. -/
  add (ψ₁ ψ₂ : AdelicGL2 F → ℂ) :
    IsSmoothAtInfinity ψ₁ → IsSmoothAtInfinity ψ₂ → D (ψ₁ + ψ₂) = D ψ₁ + D ψ₂
  /-- The operator is homogeneous on smooth functions. -/
  smul (c : ℂ) (ψ : AdelicGL2 F → ℂ) : IsSmoothAtInfinity ψ → D (c • ψ) = c • D ψ

lemma isSmoothOperator_lieDeriv : IsSmoothOperator (lieDeriv b y : (AdelicGL2 F → ℂ) → _) where
  smooth _ h := h.lieDeriv b y
  add _ _ h₁ h₂ := lieDeriv_add b y h₁ h₂
  smul c _ h := lieDeriv_const_smul b y c h

private lemma isSmoothOperator_add_smul {D₁ D₂ : (AdelicGL2 F → ℂ) → AdelicGL2 F → ℂ}
    (h₁ : IsSmoothOperator D₁) (h₂ : IsSmoothOperator D₂) (a c : ℂ) :
    IsSmoothOperator fun φ ↦ a • D₁ φ + c • D₂ φ where
  smooth φ h := ((h₁.smooth φ h).const_smul a).add ((h₂.smooth φ h).const_smul c)
  add φ₁ φ₂ hφ₁ hφ₂ := by
    simp only [h₁.add φ₁ φ₂ hφ₁ hφ₂, h₂.add φ₁ φ₂ hφ₁ hφ₂, smul_add]
    abel
  smul c' φ hφ := by
    simp only [h₁.smul c' φ hφ, h₂.smul c' φ hφ, smul_add, smul_comm c']

lemma isSmoothOperator_lieDerivHolo (v : {v : InfinitePlace F // v.IsComplex}) :
    IsSmoothOperator (lieDerivHolo v b) := by
  have h : IsSmoothOperator fun φ ↦ (2⁻¹ : ℂ) • lieDeriv b (complexPoint v 1) φ +
      -(2⁻¹ * Complex.I) • lieDeriv b (complexPoint v Complex.I) φ :=
    isSmoothOperator_add_smul (isSmoothOperator_lieDeriv b _) (isSmoothOperator_lieDeriv b _) _ _
  convert h using 2
  simp only [lieDerivHolo, sub_eq_add_neg, smul_add, smul_neg, smul_smul, neg_smul]

lemma isSmoothOperator_lieDerivAntiholo (v : {v : InfinitePlace F // v.IsComplex}) :
    IsSmoothOperator (lieDerivAntiholo v b) := by
  have h : IsSmoothOperator fun φ ↦ (2⁻¹ : ℂ) • lieDeriv b (complexPoint v 1) φ +
      (2⁻¹ * Complex.I) • lieDeriv b (complexPoint v Complex.I) φ :=
    isSmoothOperator_add_smul (isSmoothOperator_lieDeriv b _) (isSmoothOperator_lieDeriv b _) _ _
  convert h using 2
  simp only [lieDerivAntiholo, smul_add, smul_smul]

lemma isSmoothOperator_casimirOf {D : Fin 3 → (AdelicGL2 F → ℂ) → AdelicGL2 F → ℂ}
    (hD : ∀ b, IsSmoothOperator (D b)) : IsSmoothOperator (casimirOf D) where
  smooth φ h := (((hD 0).smooth _ ((hD 0).smooth φ h)).const_smul _).add
    ((hD 1).smooth _ ((hD 2).smooth φ h)) |>.add ((hD 2).smooth _ ((hD 1).smooth φ h))
  add φ₁ φ₂ h₁ h₂ := by
    simp only [casimirOf, (hD 0).add φ₁ φ₂ h₁ h₂, (hD 1).add φ₁ φ₂ h₁ h₂, (hD 2).add φ₁ φ₂ h₁ h₂,
      (hD 0).add _ _ ((hD 0).smooth φ₁ h₁) ((hD 0).smooth φ₂ h₂),
      (hD 1).add _ _ ((hD 2).smooth φ₁ h₁) ((hD 2).smooth φ₂ h₂),
      (hD 2).add _ _ ((hD 1).smooth φ₁ h₁) ((hD 1).smooth φ₂ h₂), smul_add]
    abel
  smul c φ h := by
    simp only [casimirOf, (hD 0).smul c φ h, (hD 1).smul c φ h, (hD 2).smul c φ h,
      (hD 0).smul c _ ((hD 0).smooth φ h), (hD 1).smul c _ ((hD 2).smooth φ h),
      (hD 2).smul c _ ((hD 1).smooth φ h), smul_add, smul_comm c]

lemma isSmoothOperator_casimirReal (v : {v : InfinitePlace F // v.IsReal}) :
    IsSmoothOperator (casimirReal v) :=
  isSmoothOperator_casimirOf fun b ↦ isSmoothOperator_lieDeriv b _

lemma isSmoothOperator_casimirHolo (v : {v : InfinitePlace F // v.IsComplex}) :
    IsSmoothOperator (casimirHolo v) :=
  isSmoothOperator_casimirOf fun b ↦ isSmoothOperator_lieDerivHolo b v

lemma isSmoothOperator_casimirAntiholo (v : {v : InfinitePlace F // v.IsComplex}) :
    IsSmoothOperator (casimirAntiholo v) :=
  isSmoothOperator_casimirOf fun b ↦ isSmoothOperator_lieDerivAntiholo b v

end AdelicGL2
