import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.ExceptionalDeterminant
import LeanBridge.ForMathlib.LinearAlgebra.Projectivization.ProjGenLinAction
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.GammaZeroOneGroups
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.PSL2Index
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.S4Curve
import Mathlib.NumberTheory.LegendreSymbol.QuadraticReciprocity
import Mathlib.Topology.Compactification.OnePoint.ProjectiveLine

/-!
# The determinant of the group of `X_{S₄}(ℓ)`

For an odd prime `ℓ`, the group `H ≤ GL₂(ℤ̂)` of the modular curve `X_{S₄}(ℓ)` (LMFDB
`modcurve.xs4`) is the inverse image of the inverse image `H_ℓ ≤ GL₂(𝔽_ℓ)` of a subgroup `S ≅ S₄`
of `PGL₂(𝔽_ℓ)`. LMFDB `modcurve.xs4.remarks` states that `H` contains `-I` and has surjective
determinant when `ℓ ≡ ±3 mod 8`, but not otherwise. We prove both statements, for `H` and for
`H_ℓ`, for every prime `ℓ` and every such subgroup `S`: `H` always contains `-I`, and its
determinant is surjective exactly when `ℓ ≡ ±3 mod 8`. For `ℓ = 2` there is no such `S`, as
`PGL₂(𝔽₂)` has order `6`; for `ℓ = 3`, `S = PGL₂(𝔽₃)` and `H = GL₂(ℤ̂)`.

The determinant of `H_ℓ` contains the squares, the determinants of the scalar matrices, so it is
surjective exactly when `H_ℓ` contains a matrix with nonsquare determinant, that is, when the
quadratic character of the determinant, which factors through `PGL₂(𝔽_ℓ)`
(`Matrix.ProjGenLinGroup.quadraticCharDet`), is nontrivial on `S`.
A matrix `g` whose image in `PGL₂(F)` has order `4` satisfies `tr(g)² = 2 det(g)`: by
Cayley–Hamilton `g² = tr(g) g - det(g)` is not scalar, so `tr(g) ≠ 0`, while
`g⁴ = (tr(g)³ - 2 tr(g) det(g)) g + det(g)² - tr(g)² det(g)` is scalar and `g` is not, so
`tr(g)³ = 2 tr(g) det(g)`. Hence the quadratic character of `det(g)` is that of `2`, which is `1`
exactly when `ℓ ≡ ±1 mod 8`. As `S₄` is generated by its elements of order `4`, the quadratic
character of the determinant is trivial on `S` when `ℓ ≡ ±1 mod 8`, and nontrivial on the elements
of order `4` of `S` when `ℓ ≡ ±3 mod 8`. Finally, the inverse image in `GL₂(ℤ̂)` of a subgroup of
`GL₂(ℤ/Nℤ)` has surjective determinant exactly when the subgroup has, since `SL₂(ℤ)` maps onto
`SL₂(ℤ/Nℤ)` and is dense in `SL₂(ℤ̂)`
(`Matrix.GeneralLinearGroup.map_adelicDet_adelicPreimage_eq_top_iff`).

## Main results

* `Equiv.Perm.closure_orderOf_eq_four`: `S₄` is generated by its elements of order `4`.
* `Matrix.GeneralLinearGroup.sq_trace_eq_two_mul_det_of_orderOf_eq_four`: `tr(g)² = 2 det(g)` for
  `g ∈ GL₂(F)` whose image in `PGL₂(F)` has order `4`.
* `Matrix.GeneralLinearGroup.isS4Preimage_top_three`: `PGL₂(𝔽₃) ≅ S₄`, so `GL₂(𝔽₃)` is such an
  inverse image.
* `Matrix.GeneralLinearGroup.IsS4Preimage.map_det_eq_top_iff` (LMFDB `modcurve.xs4.remarks`): the
  inverse image in `GL₂(𝔽_ℓ)` of a subgroup of `PGL₂(𝔽_ℓ)` isomorphic to `S₄` has surjective
  determinant exactly when `ℓ ≡ ±3 mod 8`.
* `Matrix.GeneralLinearGroup.IsAdelicS4.neg_one_mem` (LMFDB `modcurve.xs4.remarks`): the group of
  `X_{S₄}(ℓ)` contains `-I`.
* `Matrix.GeneralLinearGroup.IsAdelicS4.map_adelicDet_eq_top_iff` (LMFDB `modcurve.xs4.remarks`):
  the group of `X_{S₄}(ℓ)` has surjective determinant exactly when `ℓ ≡ ±3 mod 8`.
* `Matrix.GeneralLinearGroup.IsAdelicS4.neg_one_mem_and_map_adelicDet_eq_top_iff` (LMFDB
  `modcurve.xs4.remarks`): the knowl's sentence, it contains `-I` and has surjective determinant
  exactly when `ℓ ≡ ±3 mod 8`.
-/

open Equiv Matrix Polynomial

open scoped LinearAlgebra.Projectivization MatrixGroups

namespace Equiv.Perm

/-- **`S₄` is generated by its elements of order `4`**: the subgroup they generate contains the
`4`-cycle `(0 1 2 3)` and the transposition `(0 1) = (0 1 2 3)² (0 3 1 2)`, which generate `S₄`. -/
lemma closure_orderOf_eq_four : Subgroup.closure {σ : Perm (Fin 4) | orderOf σ = 4} = ⊤ := by
  have h4 (σ : Perm (Fin 4)) (hσ₂ : ¬σ ^ 2 = 1) (hσ₄ : σ ^ 4 = 1) : orderOf σ = 4 :=
    orderOf_eq_prime_pow (p := 2) (n := 1) hσ₂ hσ₄
  have hσ : finRotate 4 ∈ Subgroup.closure {σ : Perm (Fin 4) | orderOf σ = 4} :=
    Subgroup.subset_closure (h4 _ (by decide) (by decide))
  have hτ : (finRotate 4)⁻¹ * ((finRotate 4)⁻¹ * swap 0 1) ∈
      Subgroup.closure {σ : Perm (Fin 4) | orderOf σ = 4} :=
    Subgroup.subset_closure (h4 _ (by decide) (by decide))
  have hswap : swap 0 1 ∈ Subgroup.closure {σ : Perm (Fin 4) | orderOf σ = 4} := by
    simpa only [mul_inv_cancel_left] using mul_mem hσ (mul_mem hσ hτ)
  rw [eq_top_iff, ← closure_cycle_adjacent_swap (isCycle_finRotate (n := 2))
    (support_finRotate (n := 2)) 0, Subgroup.closure_le]
  rintro σ (rfl | rfl)
  · exact hσ
  · exact hswap

end Equiv.Perm

namespace Matrix.GeneralLinearGroup

variable {F : Type*} [Field F] {g : GL (Fin 2) F} {ℓ N : ℕ} [Fact ℓ.Prime] [NeZero N]
  {H : Subgroup (GL (Fin 2) (ZMod ℓ))} {G : Subgroup (∀ p : Nat.Primes, GL (Fin 2) ℤ_[p])}

/-- **A matrix whose image in `PGL₂(F)` has order `4` satisfies `tr(g)² = 2 det(g)`**: by
Cayley–Hamilton `g² = tr(g) g - det(g)`, which is not scalar, so `tr(g) ≠ 0`, and
`g⁴ = (tr(g)³ - 2 tr(g) det(g)) g + det(g)² - tr(g)² det(g)` is scalar while `g` is not. -/
lemma sq_trace_eq_two_mul_det_of_orderOf_eq_four (hg : orderOf (ProjGenLinGroup.mk g) = 4) :
    (g : Matrix (Fin 2) (Fin 2) F).trace ^ 2 = 2 * (g : Matrix (Fin 2) (Fin 2) F).det := by
  set M : Matrix (Fin 2) (Fin 2) F := g.val
  set t : F := M.trace
  set d : F := M.det
  have hsc (a : F) : Matrix.scalar (Fin 2) a = algebraMap F (Matrix (Fin 2) (Fin 2) F) a := by
    rw [scalar_apply, algebraMap_eq_diagonal]
    rfl
  have h4 : ProjGenLinGroup.mk (g ^ 4) = 1 := by
    rw [map_pow, ← hg]
    exact pow_orderOf_eq_one _
  have h2 : ProjGenLinGroup.mk (g ^ 2) ≠ 1 := fun h ↦ by
    have h' : orderOf (ProjGenLinGroup.mk g) ∣ 2 := orderOf_dvd_of_pow_eq_one (by rwa [← map_pow])
    rw [hg] at h'
    exact absurd h' (by decide)
  rw [ProjGenLinGroup.mk_eq_one, mem_center_iff_val_mem_range_scalar,
    Units.val_pow_eq_pow_val] at h4
  rw [Ne, ProjGenLinGroup.mk_eq_one, mem_center_iff_val_mem_range_scalar,
    Units.val_pow_eq_pow_val] at h2
  have hχ : aeval M (X ^ 2 - C t * X + C d) = 0 := by
    rw [← charpoly_fin_two]
    exact aeval_self_charpoly M
  have hM2 : M ^ 2 = t • M - algebraMap F _ d := by
    simp only [map_add, map_sub, map_mul, map_pow, aeval_X, aeval_C] at hχ
    rw [Algebra.smul_def, ← sub_eq_zero, ← hχ]
    abel
  have hM4 : M ^ 4 = (t ^ 3 - 2 * t * d) • M + algebraMap F _ (d ^ 2 - t ^ 2 * d) := by
    have hpoly : (X ^ 4 : F[X]) = (X ^ 2 + C t * X + C (t ^ 2 - d)) * (X ^ 2 - C t * X + C d) +
        (C (t ^ 3 - 2 * t * d) * X + C (d ^ 2 - t ^ 2 * d)) := by
      simp only [map_sub, map_mul, map_pow, map_ofNat]
      ring1
    rw [← aeval_X_pow (R := F) M, hpoly, map_add, map_mul, hχ, mul_zero, zero_add]
    simp only [map_add, map_mul, aeval_C, aeval_X]
    rw [Algebra.smul_def]
  have ht0 : t ≠ 0 := fun ht0 ↦ h2 ⟨-d, by rw [hM2, ht0, zero_smul, zero_sub, hsc, map_neg]⟩
  have hc : t ^ 3 - 2 * t * d = 0 := by
    by_contra hc
    rcases h4 with ⟨a, ha⟩
    have hMs : M = algebraMap F _ ((t ^ 3 - 2 * t * d)⁻¹ * (a - (d ^ 2 - t ^ 2 * d))) := by
      rw [hsc, hM4] at ha
      rw [map_mul, map_sub, ha, add_sub_cancel_right, ← Algebra.smul_def, smul_smul,
        inv_mul_cancel₀ hc, one_smul]
    exact h2 ⟨((t ^ 3 - 2 * t * d)⁻¹ * (a - (d ^ 2 - t ^ 2 * d))) ^ 2, by
      rw [hsc, map_pow, ← hMs]⟩
  have h' : t * (t ^ 2 - 2 * d) = 0 := by linear_combination hc
  rcases mul_eq_zero.mp h' with h | h
  · exact absurd h ht0
  · linear_combination h

variable [Fintype F] [DecidableEq F] in
lemma quadraticChar_det_eq_of_orderOf_eq_four (hF : ringChar F ≠ 2)
    (hg : orderOf (ProjGenLinGroup.mk g) = 4) : quadraticChar F (det g) = quadraticChar F 2 := by
  have h : (g : Matrix (Fin 2) (Fin 2) F).trace ^ 2 = 2 * (det g : F) := by
    rw [val_det_apply]
    exact sq_trace_eq_two_mul_det_of_orderOf_eq_four hg
  have h2 : (2 : F) ≠ 0 := Ring.two_ne_zero hF
  have ht : (g : Matrix (Fin 2) (Fin 2) F).trace ≠ 0 := fun ht ↦ by
    rw [ht, zero_pow two_ne_zero] at h
    exact mul_ne_zero h2 (det g).ne_zero h.symm
  have hχ : quadraticChar F 2 * quadraticChar F (det g) = 1 := by
    rw [← map_mul, ← h, quadraticChar_sq_one' ht]
  have h2' : quadraticChar F 2 ^ 2 = 1 := quadraticChar_sq_one h2
  linear_combination quadraticChar F 2 * hχ - quadraticChar F (det g) * h2'

/-- **`GL₂(𝔽₃)` is the inverse image of a subgroup of `PGL₂(𝔽₃)` isomorphic to `S₄`**:
`PGL₂(𝔽₃)` acts faithfully on the four points of the projective line `ℙ¹(𝔽₃)` and has
`3³ - 3 = 24` elements, so it is isomorphic to `S₄`. So the inverse images of `S₄` exist for
`ℓ = 3`, where the determinant is surjective, as `3 ≡ 3 mod 8`. -/
lemma isS4Preimage_top_three : IsS4Preimage (⊤ : Subgroup (GL (Fin 2) (ZMod 3))) := by
  have hcard : Nat.card (OnePoint (ZMod 3)) = 4 :=
    (Finite.card_option (α := ZMod 3)).trans (by rw [Nat.card_zmod])
  let e₀ : ℙ (ZMod 3) (Fin 2 → ZMod 3) ≃ Fin 4 :=
    (OnePoint.equivProjectivization (ZMod 3)).symm.trans (Finite.equivFinOfCardEq hcard)
  let ψ : PGL(2, ZMod 3) →* Perm (Fin 4) := e₀.permCongrHom.toMonoidHom.comp
    (MulAction.toPermHom PGL(2, ZMod 3) (ℙ (ZMod 3) (Fin 2 → ZMod 3)))
  have hbij : Function.Bijective ψ := (Nat.bijective_iff_injective_and_card ψ).mpr
    ⟨(permCongrHom _).injective.comp ProjGenLinGroup.toPermHom_injective, by
      rw [TauCeti.natCard_PGL_fin_two, ZMod.card, Nat.card_perm, Nat.card_fin]
      rfl⟩
  exact ⟨⊤, ⟨Subgroup.topEquiv.trans (MulEquiv.ofBijective ψ hbij)⟩, (Subgroup.comap_top _).symm⟩

/-- **The inverse image of `S₄` has surjective determinant exactly when `ℓ ≡ ±3 mod 8`** (LMFDB
`modcurve.xs4.remarks`): the inverse image `H` in `GL₂(𝔽_ℓ)` of a subgroup `S` of `PGL₂(𝔽_ℓ)`
isomorphic to `S₄` satisfies `det(H) = 𝔽_ℓˣ` if and only if `ℓ ≡ 3` or `5 mod 8`. The quadratic
character of the determinant factors through `PGL₂(𝔽_ℓ)`; on the elements of order `4`, which
generate `S`, it is the quadratic character of `2`, trivial exactly when `ℓ ≡ ±1 mod 8`; and the
determinants of the scalars in `H` are the squares. -/
lemma IsS4Preimage.map_det_eq_top_iff (hH : IsS4Preimage H) :
    H.map det = ⊤ ↔ ℓ % 8 = 3 ∨ ℓ % 8 = 5 := by
  have hℓ : ℓ ≠ 2 := by
    rintro rfl
    have h : 24 * H.index = 2 ^ 3 - 2 := hH.twenty_four_mul_index
    omega
  have hchar : ringChar (ZMod ℓ) ≠ 2 := by
    rwa [ZMod.ringChar_zmod_n]
  have hodd : ℓ % 2 = 1 := Nat.odd_iff.mp ((Fact.out : ℓ.Prime).odd_of_ne_two hℓ)
  have hsq : IsSquare (2 : ZMod ℓ) ↔ ℓ % 8 = 1 ∨ ℓ % 8 = 7 := ZMod.exists_sq_eq_two_iff hℓ
  have hcen : Subgroup.center (GL (Fin 2) (ZMod ℓ)) ≤ H := (isS4Preimage_iff.mp hH).2
  rcases hH with ⟨S, ⟨e⟩, rfl⟩
  have hord (σ : Perm (Fin 4)) : orderOf (e.symm σ) = orderOf σ :=
    orderOf_injective e.symm.toMonoidHom e.symm.injective σ
  have hclos : Subgroup.closure {x : S | orderOf x = 4} = ⊤ := by
    have hset : {x : S | orderOf x = 4} = e.symm '' {σ | orderOf σ = 4} :=
      Set.ext fun x ↦ ⟨fun hx ↦ ⟨e x, (hord (e x)).symm.trans
        ((congrArg orderOf (e.symm_apply_apply x)).trans hx), e.symm_apply_apply x⟩,
        fun ⟨σ, hσ, h⟩ ↦ (congrArg orderOf h).symm.trans ((hord σ).trans hσ)⟩
    rw [hset, ← MulEquiv.coe_toMonoidHom, ← MonoidHom.map_closure,
      Perm.closure_orderOf_eq_four, ← MonoidHom.range_eq_map]
    exact MonoidHom.range_eq_top.mpr e.symm.surjective
  have hmk (x : S) : ∃ g : GL (Fin 2) (ZMod ℓ), ProjGenLinGroup.mk g = x :=
    ProjGenLinGroup.mk_surjective _
  have horder {x : S} (hx : orderOf x = 4) {g : GL (Fin 2) (ZMod ℓ)}
      (hg : ProjGenLinGroup.mk g = x) : orderOf (ProjGenLinGroup.mk g) = 4 := by
    rw [hg, Subgroup.orderOf_coe, hx]
  by_cases h2 : IsSquare (2 : ZMod ℓ)
  · have h2' : quadraticChar (ZMod ℓ) 2 = 1 :=
      (quadraticChar_one_iff_isSquare (Ring.two_ne_zero hchar)).mpr h2
    have hf : (ProjGenLinGroup.quadraticCharDet ℓ).comp S.subtype = 1 :=
      MonoidHom.eq_of_eqOn_dense hclos fun x hx ↦ by
        rcases hmk x with ⟨g, hg⟩
        refine Units.ext ?_
        rw [MonoidHom.comp_apply, Subgroup.coe_subtype, ← hg,
          ProjGenLinGroup.coe_quadraticCharDet_mk,
          quadraticChar_det_eq_of_orderOf_eq_four hchar (horder hx hg), h2']
        rfl
    rcases quadraticChar_exists_neg_one' hchar with ⟨u, hu⟩
    have hne : (S.comap ProjGenLinGroup.mk).map det ≠ ⊤ := fun htop ↦ by
      rcases (htop ▸ Subgroup.mem_top u : u ∈ (S.comap ProjGenLinGroup.mk).map det) with
        ⟨h, hh, rfl⟩
      have h1 : (ProjGenLinGroup.quadraticCharDet ℓ (ProjGenLinGroup.mk h) : ℤ) = 1 :=
        congrArg Units.val (DFunLike.congr_fun hf ⟨ProjGenLinGroup.mk h, hh⟩)
      rw [ProjGenLinGroup.coe_quadraticCharDet_mk, hu] at h1
      exact absurd h1 (by decide)
    have h8 : ℓ % 8 = 1 ∨ ℓ % 8 = 7 := hsq.mp h2
    simp only [hne, false_iff]
    omega
  · have h2' : quadraticChar (ZMod ℓ) 2 = -1 := quadraticChar_neg_one_iff_not_isSquare.mpr h2
    have hx₀ : orderOf (e.symm (finRotate 4)) = 4 := by
      rw [hord]
      exact orderOf_eq_prime_pow (p := 2) (n := 1) (by decide) (by decide)
    rcases hmk (e.symm (finRotate 4)) with ⟨g₀, hg₀⟩
    have hg₀H : g₀ ∈ S.comap ProjGenLinGroup.mk := by
      rw [Subgroup.mem_comap, hg₀]
      exact (e.symm (finRotate 4)).2
    have hd₀ : quadraticChar (ZMod ℓ) (det g₀) = -1 := by
      rw [quadraticChar_det_eq_of_orderOf_eq_four hchar (horder hx₀ hg₀), h2']
    have hd₀' : quadraticChar (ZMod ℓ) ((det g₀)⁻¹ : (ZMod ℓ)ˣ) = -1 := by
      have h : quadraticChar (ZMod ℓ) ((det g₀)⁻¹ : (ZMod ℓ)ˣ) * quadraticChar (ZMod ℓ) (det g₀) =
          1 := by
        rw [← map_mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, map_one]
      rw [hd₀] at h
      linear_combination -h
    have hsqr (v : (ZMod ℓ)ˣ) (hv : quadraticChar (ZMod ℓ) v = 1) : ∃ a : (ZMod ℓ)ˣ, a ^ 2 = v := by
      rcases (quadraticChar_one_iff_isSquare v.ne_zero).mp hv with ⟨r, hr⟩
      have hr0 : r ≠ 0 := fun hr0 ↦ v.ne_zero (by rw [hr, hr0, mul_zero])
      exact ⟨Units.mk0 r hr0, Units.ext (by rw [Units.val_pow_eq_pow_val, Units.val_mk0, sq, hr])⟩
    have hscal (a : (ZMod ℓ)ˣ) : scalar (Fin 2) a ∈ S.comap ProjGenLinGroup.mk :=
      hcen (by rw [center_eq_range_scalar]; exact ⟨a, rfl⟩)
    have htop : (S.comap ProjGenLinGroup.mk).map det = ⊤ := by
      refine eq_top_iff.mpr fun u _ ↦ ?_
      rcases quadraticChar_dichotomy u.ne_zero with hu | hu
      · rcases hsqr u hu with ⟨a, ha⟩
        exact ⟨scalar (Fin 2) a, hscal a, by rw [det_scalar, Fintype.card_fin, ha]⟩
      · rcases hsqr (u * (det g₀)⁻¹) (by rw [Units.val_mul, map_mul, hu, hd₀']; rfl) with ⟨a, ha⟩
        exact ⟨scalar (Fin 2) a * g₀, mul_mem (hscal a) hg₀H, by
          rw [map_mul, det_scalar, Fintype.card_fin, ha, inv_mul_cancel_right]⟩
    have h8 : ¬(ℓ % 8 = 1 ∨ ℓ % 8 = 7) := hsq.not.mp h2
    simp only [htop, true_iff]
    omega

/-- **The group of `X_{S₄}(ℓ)` contains `-I`** (LMFDB `modcurve.xs4.remarks`): its reduction modulo
`ℓ`, the inverse image of a subgroup of `PGL₂(𝔽_ℓ)`, contains the scalar matrix `-I`. -/
lemma IsAdelicS4.neg_one_mem (hG : IsAdelicS4 ℓ G) : -1 ∈ G := by
  rcases hG with ⟨H, hH, rfl⟩
  rw [adelicPreimage, Subgroup.mem_comap, adelicReductionZMod_neg, map_one]
  exact hH.neg_one_mem

/-- **The group of `X_{S₄}(ℓ)` has surjective determinant exactly when `ℓ ≡ ±3 mod 8`** (LMFDB
`modcurve.xs4.remarks`): for the group `G ≤ GL₂(ℤ̂)` of `X_{S₄}(ℓ)`, `det(G) = ℤ̂ˣ` if and only if
`ℓ ≡ 3` or `5 mod 8`. -/
lemma IsAdelicS4.map_adelicDet_eq_top_iff (hG : IsAdelicS4 ℓ G) :
    G.map adelicDet = ⊤ ↔ ℓ % 8 = 3 ∨ ℓ % 8 = 5 := by
  rcases hG with ⟨H, hH, rfl⟩
  rw [map_adelicDet_adelicPreimage_eq_top_iff]
  exact hH.map_det_eq_top_iff

/-- **The group of `X_{S₄}(ℓ)` contains `-I` and has surjective determinant exactly when
`ℓ ≡ ±3 mod 8`** (LMFDB `modcurve.xs4.remarks`): the knowl's sentence, for the group `G ≤ GL₂(ℤ̂)`
of `X_{S₄}(ℓ)`. As `G` always contains `-I`, the condition bears on the determinant. -/
lemma IsAdelicS4.neg_one_mem_and_map_adelicDet_eq_top_iff (hG : IsAdelicS4 ℓ G) :
    -1 ∈ G ∧ G.map adelicDet = ⊤ ↔ ℓ % 8 = 3 ∨ ℓ % 8 = 5 :=
  (and_iff_right hG.neg_one_mem).trans hG.map_adelicDet_eq_top_iff

end Matrix.GeneralLinearGroup
