import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.NonsplitCartan
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.AdelicPreimage
import Mathlib.GroupTheory.IndexNormal

/-!
# The groups of the modular curves `X_ns(N)` and `X_ns⁺(N)`

Let `A` be a free étale `ℤ/Nℤ`-algebra of rank `2`. At a prime `ℓ` dividing `N`, the knowl
`gl2.cartan` calls `A` split or non-split according as its component `A ⊗ ℤ / ℓ ^ v_ℓ(N) ℤ` is the
split algebra or the non-split one, `𝒪 / ℓ ^ v_ℓ(N) 𝒪` for an order `𝒪` in which `ℓ` is inert; that
is, according as the reduction `A/ℓA` of `A` modulo `ℓ`, an étale `𝔽_ℓ`-algebra of rank `2`, is
`𝔽_ℓ × 𝔽_ℓ` or the field `𝔽_{ℓ²}`. Here `A` is non-split at `ℓ` when `A/ℓA` is a field.

The modular curve `X_ns(N)` is the modular curve `X_H` for `H ≤ GL₂(ℤ̂)` the inverse image of a
Cartan subgroup of `GL₂(ℤ/Nℤ)` that is non-split at every prime dividing `N`, the image of `Aˣ` for
such an algebra `A` with a basis, and `X_ns⁺(N)` is `X_H` for `H` the inverse image of the extended
Cartan subgroup of such an `A`. The inverse images in `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` are taken under the
reduction modulo `N` (`Matrix.GeneralLinearGroup.adelicPreimage`); they are open subgroups of level
at most `N`. The knowls define the curves through a choice of such a subgroup, as these subgroups
are all conjugate; this is not formalised, and the subgroups are defined here by predicates.

The knowl `ag.modcurve.xnsp` instead defines `X_ns⁺(N)` by the normalizer of the non-split Cartan
subgroup. The extended Cartan subgroup lies in the normalizer, and for a prime `N = p` the two
coincide: `Nn` is both. When `N` has `r ≥ 2` distinct prime factors they differ: the normalizer of a
Cartan subgroup of `GL₂(ℤ/Nℤ) = ∏_ℓ GL₂(ℤ / ℓ ^ v_ℓ(N) ℤ)` is the product of the normalizers of its
components, so it contains the Cartan subgroup with index `2 ^ r`, while the extended Cartan
subgroup, generated by the Cartan subgroup and a single involution, contains it with index `2`
(neither index is formalised for composite `N`). Both groups are formalised, each for the knowl
that defines it.

The modular curves themselves are not formalised. For a prime `N = p` the necklaces of the moduli
interpretations of `X_ns(p)` and `X_ns⁺(p)` are defined in
`LeanBridge.ForMathlib.NumberTheory.ModularCurve.Necklace`.

## Main definitions

* `Matrix.GeneralLinearGroup.IsNonsplitCartanSubgroupMod` (LMFDB `modcurve.xns`): a Cartan subgroup
  of `GL₂(ℤ/Nℤ)` non-split at every prime dividing `N`.
* `Matrix.GeneralLinearGroup.IsNonsplitExtendedCartanSubgroupMod` (LMFDB `modcurve.xns_plus`): the
  extended Cartan subgroup of such a Cartan subgroup.
* `Matrix.GeneralLinearGroup.IsNonsplitCartanNormalizerMod` (LMFDB `ag.modcurve.xnsp`): the
  normalizer of such a Cartan subgroup.
* `Matrix.GeneralLinearGroup.IsAdelicNonsplitCartan` (LMFDB `modcurve.xns`),
  `Matrix.GeneralLinearGroup.IsAdelicNonsplitExtendedCartan` (LMFDB `modcurve.xns_plus`) and
  `Matrix.GeneralLinearGroup.IsAdelicNonsplitCartanNormalizer` (LMFDB `ag.modcurve.xnsp`): their
  inverse images in `GL₂(ℤ̂)`, the groups of `X_ns(N)` and `X_ns⁺(N)`.

## Main results

* `Matrix.GeneralLinearGroup.isNonsplitCartanSubgroupMod_labelCn`,
  `Matrix.GeneralLinearGroup.isNonsplitExtendedCartanSubgroupMod_labelNn` and
  `Matrix.GeneralLinearGroup.isNonsplitCartanNormalizerMod_labelNn`: for a prime `N = p`, `Cn` is a
  non-split Cartan subgroup, and `Nn` is both its extended Cartan subgroup and its normalizer.
* `Matrix.GeneralLinearGroup.IsNonsplitExtendedCartanSubgroupMod.exists_le`: an extended non-split
  Cartan subgroup lies in the normalizer of a non-split Cartan subgroup.
* `Matrix.GeneralLinearGroup.IsNonsplitCartanSubgroupMod.isNonsplitCartanSubgroup`: for `N = p`
  prime, a Cartan subgroup non-split at `p` is non-split in the sense of `gl2.nonsplit_cartan`.
* `Matrix.GeneralLinearGroup.index_adelicPreimage_labelCn` and
  `Matrix.GeneralLinearGroup.two_mul_index_adelicPreimage_labelNn`: for a prime `p`, the groups of
  `X_ns(p)` and `X_ns⁺(p)` have index `p (p - 1)` and `p (p - 1) / 2` in `GL₂(ℤ̂)`.
-/

open TauCeti

namespace Matrix.GeneralLinearGroup

variable {N : ℕ} (H : Subgroup (GL (Fin 2) (ZMod N))) (p : ℕ) [Fact p.Prime]
  (G : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))

/-- A subgroup of `GL₂(ℤ/Nℤ)` is a **Cartan subgroup non-split at every prime dividing `N`** (LMFDB
`modcurve.xns`, `gl2.cartan`): it is the Cartan subgroup `cartanSubgroup b` of a free étale
`ℤ/Nℤ`-algebra `A` of rank `2` with a basis `b` such that, for every prime `ℓ ∣ N`, the reduction
`A/ℓA` of `A` modulo `ℓ` is a field, `𝔽_{ℓ²}`. The modular curve `X_ns(N)` is `X_G` for `G` the
inverse image of such a subgroup in `GL₂(ℤ̂)` (`IsAdelicNonsplitCartan`). For `N = p` prime, `Cn`
is one (`isNonsplitCartanSubgroupMod_labelCn`). -/
def IsNonsplitCartanSubgroupMod : Prop :=
  ∃ (A : Type) (_ : CommRing A) (_ : Algebra (ZMod N) A) (_ : Algebra.Etale (ZMod N) A)
    (b : Module.Basis (Fin 2) (ZMod N) A),
    (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ N → IsField (A ⧸ Ideal.span {(ℓ : A)})) ∧ H = cartanSubgroup b

/-- A subgroup of `GL₂(ℤ/Nℤ)` is an **extended Cartan subgroup non-split at every prime dividing
`N`** (LMFDB `modcurve.xns_plus`, `gl2.cartan`): it is the extended Cartan subgroup
`extendedCartanSubgroup b` of a free étale `ℤ/Nℤ`-algebra `A` of rank `2` with a basis `b` such
that, for every prime `ℓ ∣ N`, `A/ℓA` is a field. The modular curve `X_ns⁺(N)` is `X_G` for `G` the
inverse image of such a subgroup in `GL₂(ℤ̂)` (`IsAdelicNonsplitExtendedCartan`). For `N = p`
prime, `Nn` is one (`isNonsplitExtendedCartanSubgroupMod_labelNn`). -/
def IsNonsplitExtendedCartanSubgroupMod : Prop :=
  ∃ (A : Type) (_ : CommRing A) (_ : Algebra (ZMod N) A) (_ : Algebra.Etale (ZMod N) A)
    (b : Module.Basis (Fin 2) (ZMod N) A),
    (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ N → IsField (A ⧸ Ideal.span {(ℓ : A)})) ∧ H = extendedCartanSubgroup b

/-- A subgroup of `GL₂(ℤ/Nℤ)` is the **normalizer of a non-split Cartan subgroup** `Γ_ns(N)` (LMFDB
`ag.modcurve.xnsp`): the normalizer in `GL₂(ℤ/Nℤ)` of a Cartan subgroup non-split at every prime
dividing `N`. The knowl `ag.modcurve.xnsp` defines `X_ns⁺(N)` as `X_G` for `G` its inverse image in
`GL₂(ℤ̂)` (`IsAdelicNonsplitCartanNormalizer`). It contains the extended Cartan subgroup of the same
algebra (`IsNonsplitExtendedCartanSubgroupMod.exists_le`), and for a prime `N = p` both are `Nn`
for the Cartan subgroup `Cn` (`isNonsplitCartanNormalizerMod_labelNn`). For `N` with `r ≥ 2`
distinct prime factors the normalizer contains the Cartan subgroup with index `2 ^ r` and the
extended Cartan subgroup with index `2 ^ (r - 1)`, so that the two differ (not formalised). -/
def IsNonsplitCartanNormalizerMod : Prop :=
  ∃ C : Subgroup (GL (Fin 2) (ZMod N)), IsNonsplitCartanSubgroupMod C ∧
    H = Subgroup.normalizer (C : Set (GL (Fin 2) (ZMod N)))

variable {H}

lemma IsNonsplitCartanSubgroupMod.isCartanSubgroup (hH : IsNonsplitCartanSubgroupMod H) :
    IsCartanSubgroup H :=
  hH.imp fun _ ⟨i₁, i₂, i₃, b, _, hb⟩ ↦ ⟨i₁, i₂, i₃, b, hb⟩

lemma IsNonsplitExtendedCartanSubgroupMod.isExtendedCartanSubgroup
    (hH : IsNonsplitExtendedCartanSubgroupMod H) : IsExtendedCartanSubgroup H :=
  hH.imp fun _ ⟨i₁, i₂, i₃, b, _, hb⟩ ↦ ⟨i₁, i₂, i₃, b, hb⟩

/-- **An extended non-split Cartan subgroup lies in the normalizer of a non-split Cartan subgroup**:
the extended Cartan subgroup of `A` normalizes the Cartan subgroup of `A`. -/
lemma IsNonsplitExtendedCartanSubgroupMod.exists_le (hH : IsNonsplitExtendedCartanSubgroupMod H) :
    ∃ H' : Subgroup (GL (Fin 2) (ZMod N)), IsNonsplitCartanNormalizerMod H' ∧ H ≤ H' :=
  hH.elim fun A ⟨i₁, i₂, i₃, b, hA, hb⟩ ↦ ⟨_, ⟨_, ⟨A, i₁, i₂, i₃, b, hA, rfl⟩, rfl⟩,
    hb ▸ extendedCartanSubgroup_le_normalizer b⟩

lemma isField_quotient_span_natCast_nonsplitCartanAlgebra (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓp : ℓ ∣ p) :
    IsField (NonsplitCartanAlgebra p ⧸ Ideal.span {(ℓ : NonsplitCartanAlgebra p)}) := by
  have hp : (ℓ : NonsplitCartanAlgebra p) = 0 := by
    rw [(Nat.prime_dvd_prime_iff_eq hℓ Fact.out).mp hℓp, ← map_natCast
      (algebraMap (ZMod p) (NonsplitCartanAlgebra p)), ZMod.natCast_self, map_zero]
  rw [hp, Ideal.span_singleton_eq_bot.mpr rfl]
  exact (RingEquiv.quotientBot _).toMulEquiv.isField (Field.toIsField _)

/-- **`Cn` is a Cartan subgroup of `GL₂(𝔽_p)` non-split at `p`**: it is the Cartan subgroup of the
field `𝔽_{p²}`. -/
lemma isNonsplitCartanSubgroupMod_labelCn : IsNonsplitCartanSubgroupMod (labelCn p) :=
  ⟨NonsplitCartanAlgebra p, inferInstance, inferInstance, inferInstance, nonsplitCartanBasis p,
    isField_quotient_span_natCast_nonsplitCartanAlgebra p, rfl⟩

/-- **`Nn` is an extended Cartan subgroup of `GL₂(𝔽_p)` non-split at `p`**: it is the extended
Cartan subgroup of the field `𝔽_{p²}`. -/
lemma isNonsplitExtendedCartanSubgroupMod_labelNn :
    IsNonsplitExtendedCartanSubgroupMod (labelNn p) :=
  ⟨NonsplitCartanAlgebra p, inferInstance, inferInstance, inferInstance, nonsplitCartanBasis p,
    isField_quotient_span_natCast_nonsplitCartanAlgebra p, rfl⟩

variable {p} in
/-- **A Cartan subgroup of `GL₂(𝔽_p)` non-split at `p` is non-split** in the sense of
`IsNonsplitCartanSubgroup` (LMFDB `gl2.nonsplit_cartan`): its algebra `A` is a field with `p²`
elements, so it has `p² - 1` elements, more than the `(p - 1)²` diagonal matrices, and no conjugate
of it is diagonal. The converse, that a non-diagonalizable Cartan subgroup comes from a field, is
not formalised. -/
lemma IsNonsplitCartanSubgroupMod.isNonsplitCartanSubgroup {C : Subgroup (GL (Fin 2) (ZMod p))}
    (hC : IsNonsplitCartanSubgroupMod C) : IsNonsplitCartanSubgroup C := by
  refine ⟨hC.isCartanSubgroup, fun g hg ↦ ?_⟩
  rcases hC with ⟨A, _, _, _, b, hA, rfl⟩
  have hp : (p : A) = 0 := by
    rw [← map_natCast (algebraMap (ZMod p) A), ZMod.natCast_self, map_zero]
  have hAf : IsField A := by
    have h : IsField (A ⧸ Ideal.span {(p : A)}) := hA p Fact.out dvd_rfl
    rw [hp, Ideal.span_singleton_eq_bot.mpr rfl] at h
    exact (RingEquiv.quotientBot A).symm.toMulEquiv.isField h
  let hF : Field A := hAf.toField
  have hcard : Nat.card (cartanSubgroup b) = p ^ 2 - 1 := by
    rw [cartanSubgroup,
      ← Nat.card_congr (MonoidHom.ofInjective (unitsLeftMulMatrix_injective b)).toEquiv,
      Nat.card_units, Nat.card_congr b.equivFun.toEquiv, Nat.card_fun, Nat.card_zmod, Nat.card_fin]
  have hle : Nat.card ((cartanSubgroup b).map (MulAut.conj g).toMonoidHom) ≤
      Nat.card (diagonalTorus (ZMod p) 2) :=
    Subgroup.card_le_of_le hg
  rw [Subgroup.card_map_of_injective (MulAut.conj g).injective, hcard, natCard_diagonalTorus,
    Nat.card_zmod] at hle
  have h₂ : 2 ≤ p := (Fact.out : p.Prime).two_le
  zify [Nat.one_le_pow 2 p (by omega), (by omega : 1 ≤ p)] at hle
  nlinarith

/-- **`Nn` is the normalizer of the non-split Cartan subgroup `Cn`** of `GL₂(𝔽_p)`, for every prime
`p`: for `p > 2` by `labelNn_eq_normalizer`, and for `p = 2`, where `Cn` has index `2`, so is
normal, both are `GL₂(𝔽₂)`. -/
lemma isNonsplitCartanNormalizerMod_labelNn : IsNonsplitCartanNormalizerMod (labelNn p) := by
  refine ⟨labelCn p, isNonsplitCartanSubgroupMod_labelCn p, ?_⟩
  by_cases hp : p = 2
  · subst hp
    have : (labelCn 2).Normal := Subgroup.normal_of_index_eq_two (index_labelCn 2)
    rw [labelNn_two, Subgroup.normalizer_eq_top]
  · exact labelNn_eq_normalizer p hp

/-- **The group of `X_ns(p)` has index `p (p - 1)`** in `GL₂(ℤ̂)`, for a prime `p`: it is the
inverse image of `Cn`, which has `p² - 1` elements. -/
lemma index_adelicPreimage_labelCn : (adelicPreimage p (labelCn p)).index = p * (p - 1) :=
  (index_adelicPreimage p _).trans (index_labelCn p)

/-- **The group of `X_ns⁺(p)` has index `p (p - 1) / 2`** in `GL₂(ℤ̂)`, for a prime `p`: it is the
inverse image of `Nn`, which contains `Cn` with index `2`. -/
lemma two_mul_index_adelicPreimage_labelNn :
    2 * (adelicPreimage p (labelNn p)).index = p * (p - 1) := by
  rw [← index_adelicPreimage_labelCn,
    ← Subgroup.relIndex_mul_index (adelicPreimage_mono p (labelCn_le_labelNn p)),
    relIndex_adelicPreimage, relIndex_labelCn_labelNn]

variable (N) [NeZero N]

/-- A subgroup `G` of `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` is **the group of `X_ns(N)`** (LMFDB `modcurve.xns`):
the inverse image under reduction modulo `N` of a Cartan subgroup of `GL₂(ℤ/Nℤ)` non-split at every
prime dividing `N`, so that `X_ns(N) = X_G`. -/
def IsAdelicNonsplitCartan : Prop :=
  ∃ C : Subgroup (GL (Fin 2) (ZMod N)), IsNonsplitCartanSubgroupMod C ∧ G = adelicPreimage N C

/-- A subgroup `G` of `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` is **the group of `X_ns⁺(N)`** (LMFDB
`modcurve.xns_plus`): the inverse image under reduction modulo `N` of an extended Cartan subgroup of
`GL₂(ℤ/Nℤ)` non-split at every prime dividing `N`, so that `X_ns⁺(N) = X_G`. -/
def IsAdelicNonsplitExtendedCartan : Prop :=
  ∃ C : Subgroup (GL (Fin 2) (ZMod N)), IsNonsplitExtendedCartanSubgroupMod C ∧
    G = adelicPreimage N C

/-- A subgroup `G` of `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` is **the group `Γ_ns⁺(N)` of `X_ns⁺(N)` in the knowl
`ag.modcurve.xnsp`**: the inverse image under reduction modulo `N` of the normalizer of a Cartan
subgroup of `GL₂(ℤ/Nℤ)` non-split at every prime dividing `N`. -/
def IsAdelicNonsplitCartanNormalizer : Prop :=
  ∃ C : Subgroup (GL (Fin 2) (ZMod N)), IsNonsplitCartanNormalizerMod C ∧ G = adelicPreimage N C

end Matrix.GeneralLinearGroup
