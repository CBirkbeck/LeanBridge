import LeanBridge.ForMathlib.NumberTheory.ModularCurve.AdelicPreimage
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.CongruenceSubgroupOfOpen
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Borel

/-!
# The groups of the modular curves `X₀(N)`, `X₁(N)` and `X_{±1}(N)`

The LMFDB defines `X₀(N)`, `X₁(N)` and `X_{±1}(N)` as the modular curves `X_H` (LMFDB `modcurve`)
of the inverse images `H ≤ GL₂(ℤ̂)` of the subgroups `!![*, *; 0, *]`, `!![1, *; 0, *]` and
`!![±1, *; 0, *]` of `GL₂(ℤ/Nℤ)`. As in `LeanBridge.ForMathlib.NumberTheory.ModularCurve.ArithCurve`
the inverse image is taken under the reduction `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ) → GL₂(ℤ/Nℤ)`
(`Matrix.GeneralLinearGroup.adelicPreimage`), and the first group is Tau Ceti's upper triangular
subgroup `TauCeti.GL2Borel`.

The upper left entry `!![a, b; 0, d] ↦ a` is a surjective character of the upper triangular
subgroup `B ≤ GL₂(R)`, with kernel `!![1, *; 0, *]`; so `!![1, *; 0, *]` is normal in `B` with
quotient `Rˣ`, and `!![±1, *; 0, *]` is its preimage of `{±1}`, the subgroup generated by
`!![1, *; 0, *]` and `-1`. In the adelic groups this says that `H₁ = H(X₁(N))` is normal in
`H₀ = H(X₀(N))` with quotient `(ℤ/Nℤ)ˣ`, the group of the covering `X₁(N) → X₀(N)`, acting through
`d ↦ !![d, 0; 0, 1]` on the moduli `(E, P) ↦ (E, dP)`, and that `H_{±1} = ±H₁`: for `N ≥ 3`,
`-1 ∉ H₁`, so `X₁(N)` is an index `2` refinement (LMFDB `modcurve.quadratic_refinements`) of
`X_{±1}(N)`, the same curve with a finer moduli problem; for `N ≤ 2` the two groups coincide.

On the analytic side, the congruence subgroups `Γ_H = H ∩ SL₂(ℤ)` of these groups are `Γ₀(N)`,
`Γ₁(N)` and `±Γ₁(N)`; by the description of the complex points of `X_H` in the knowl `modcurve`,
this is how `X₀(N)(ℂ)` and `X₁(N)(ℂ)` are the compactified quotients `Γ₀(N) \ ℍ*` and
`Γ₁(N) \ ℍ*` (LMFDB `ag.modcurve.x0`, `ag.modcurve.x1`). The curves themselves are not constructed
here.

## Main definitions

* `Matrix.GeneralLinearGroup.borelFirstDiag`: the character `!![a, b; 0, d] ↦ a` of `B`.
* `Matrix.GeneralLinearGroup.gammaOneSubgroup`: the subgroup `!![1, *; 0, *]` of `GL₂(R)`.
* `Matrix.GeneralLinearGroup.gammaPMOneSubgroup`: the subgroup `!![±1, *; 0, *]` of `GL₂(R)`.
* `Matrix.GeneralLinearGroup.adelicGammaZero` (LMFDB `modcurve.x0`, `ag.modcurve.x0`): the group of
  `X₀(N)`.
* `Matrix.GeneralLinearGroup.adelicGammaOne` (LMFDB `modcurve.x1`, `ag.modcurve.x1`): the group of
  `X₁(N)`.
* `Matrix.GeneralLinearGroup.adelicGammaPMOne` (LMFDB `modcurve.xpm1`): the group of `X_{±1}(N)`.
* `Matrix.GeneralLinearGroup.quotientGammaOneSubgroupEquiv`: `B / !![1, *; 0, *] ≃ Rˣ`.
* `Matrix.GeneralLinearGroup.adelicGammaZeroFirstDiag`: the character `H₀ → (ℤ/Nℤ)ˣ`, the first
  diagonal entry modulo `N`.
* `Matrix.GeneralLinearGroup.adelicGammaZeroQuotientEquiv`: `H₀ / H₁ ≃ (ℤ/Nℤ)ˣ`, the group of the
  covering `X₁(N) → X₀(N)`.

## Main results

* `Matrix.GeneralLinearGroup.mem_gammaOneSubgroup_iff` and
  `Matrix.GeneralLinearGroup.mem_gammaPMOneSubgroup_iff`: the two subgroups are the matrices
  `!![1, *; 0, *]` and `!![±1, *; 0, *]`.
* `Matrix.GeneralLinearGroup.relIndex_adelicGammaOne_adelicGammaZero`: `[H₀ : H₁] = φ(N)`.
* `Matrix.GeneralLinearGroup.adelicGammaPMOne_eq_adjoinNegOne`: `H_{±1} = ±H₁`.
* `Matrix.GeneralLinearGroup.neg_one_mem_adelicGammaOne_iff`: `-1 ∈ H₁` if and only if `N ≤ 2`.
* `Matrix.GeneralLinearGroup.adelicGammaPMOne_eq_adelicGammaOne`: for `N ≤ 2`, `H_{±1} = H₁`.
* `Matrix.GeneralLinearGroup.relIndex_adelicGammaOne_adelicGammaPMOne`: for `N ≥ 3`, `H₁` has index
  `2` in `H_{±1}`.
* `Matrix.GeneralLinearGroup.modularGamma_adelicGammaZero`,
  `Matrix.GeneralLinearGroup.modularGamma_adelicGammaOne` and
  `Matrix.GeneralLinearGroup.modularGamma_adelicGammaPMOne`: `Γ_H` is `Γ₀(N)`, `Γ₁(N)` and
  `±Γ₁(N)`.
* `Matrix.GeneralLinearGroup.index_adelicGammaZero` and
  `Matrix.GeneralLinearGroup.index_adelicGammaOne`: for a prime `p`, the groups of `X₀(p)` and
  `X₁(p)` have index `p + 1` and `p² - 1` in `GL₂(ℤ̂)`.
-/

open TauCeti

open scoped MatrixGroups

namespace Matrix.GeneralLinearGroup

variable (R : Type*) [CommRing R] {g : GL (Fin 2) R} (N p : ℕ) [Fact p.Prime]

/-- The character `!![a, b; 0, d] ↦ a` of the upper triangular subgroup `B` of `GL₂(R)`
(`TauCeti.GL2Borel`), the first diagonal entry. It is surjective, and its kernel is the subgroup
`!![1, *; 0, *]` (`gammaOneSubgroup`). -/
noncomputable def borelFirstDiag : GL2Borel R →* Rˣ :=
  (MonoidHom.fst Rˣ Rˣ).comp GL2Borel.diag

/-- The subgroup **`!![1, *; 0, *]`** of `GL₂(R)`, the kernel of the first diagonal entry of the
upper triangular subgroup: the invertible matrices with first column `(1, 0)`
(`mem_gammaOneSubgroup_iff`), that is, the stabilizer of the first basis vector. For `R = ℤ/Nℤ` it
defines `X₁(N)` (`adelicGammaOne`). -/
noncomputable def gammaOneSubgroup : Subgroup (GL (Fin 2) R) :=
  (borelFirstDiag R).ker.map (GL2Borel R).subtype

/-- The subgroup **`!![±1, *; 0, *]`** of `GL₂(R)`: the subgroup generated by `!![1, *; 0, *]` and
`-1`, the invertible matrices with first column `(±1, 0)` (`mem_gammaPMOneSubgroup_iff`). For
`R = ℤ/Nℤ` it defines `X_{±1}(N)` (`adelicGammaPMOne`). -/
noncomputable def gammaPMOneSubgroup : Subgroup (GL (Fin 2) R) :=
  (gammaOneSubgroup R).adjoinNegOne

variable {R}

lemma borelFirstDiag_apply (b : GL2Borel R) : (borelFirstDiag R b : R) = b.1 0 0 :=
  GL2Borel.diag_fst_val b

lemma borelFirstDiag_surjective : Function.Surjective (borelFirstDiag R) :=
  fun u ↦ ⟨GL2Borel.torusHom (u, 1), by simp [borelFirstDiag]⟩

/-- **The elements of `gammaOneSubgroup R` are the invertible matrices `!![1, *; 0, *]`.** -/
lemma mem_gammaOneSubgroup_iff : g ∈ gammaOneSubgroup R ↔ g 0 0 = 1 ∧ g 1 0 = 0 := by
  refine ⟨?_, fun ⟨h₀₀, h₁₀⟩ ↦ ⟨⟨g, GL2Borel.mem_iff.mpr h₁₀⟩, Units.ext ?_, rfl⟩⟩
  · rintro ⟨b, hb, rfl⟩
    exact ⟨(borelFirstDiag_apply b).symm.trans (congrArg Units.val hb), GL2Borel.mem_iff.mp b.2⟩
  · exact (borelFirstDiag_apply _).trans h₀₀

/-- **The elements of `gammaPMOneSubgroup R` are the invertible matrices `!![±1, *; 0, *]`.** -/
lemma mem_gammaPMOneSubgroup_iff :
    g ∈ gammaPMOneSubgroup R ↔ (g 0 0 = 1 ∨ g 0 0 = -1) ∧ g 1 0 = 0 := by
  rw [gammaPMOneSubgroup, Subgroup.mem_adjoinNegOne_iff, mem_gammaOneSubgroup_iff,
    mem_gammaOneSubgroup_iff]
  simp only [Units.val_neg, neg_apply, neg_eq_iff_eq_neg, neg_zero]
  tauto

lemma gammaOneSubgroup_le_gammaPMOneSubgroup : gammaOneSubgroup R ≤ gammaPMOneSubgroup R :=
  (gammaOneSubgroup R).le_adjoinNegOne

lemma gammaPMOneSubgroup_le_gl2Borel : gammaPMOneSubgroup R ≤ GL2Borel R :=
  fun _ hg ↦ GL2Borel.mem_iff.mpr (mem_gammaPMOneSubgroup_iff.mp hg).2

variable (R) in
lemma subgroupOf_gammaOneSubgroup :
    (gammaOneSubgroup R).subgroupOf (GL2Borel R) = (borelFirstDiag R).ker :=
  (Subgroup.comap_subtype _ _).symm.trans <|
    Subgroup.comap_map_eq_self_of_injective (GL2Borel R).subtype_injective _

instance : ((gammaOneSubgroup R).subgroupOf (GL2Borel R)).Normal :=
  subgroupOf_gammaOneSubgroup R ▸ MonoidHom.normal_ker _

/-- **The upper triangular subgroup modulo `!![1, *; 0, *]` is `Rˣ`**, through the first diagonal
entry: for `R = ℤ/Nℤ`, the group of the covering `X₁(N) → X₀(N)` is `(ℤ/Nℤ)ˣ`. -/
noncomputable def quotientGammaOneSubgroupEquiv :
    GL2Borel R ⧸ (gammaOneSubgroup R).subgroupOf (GL2Borel R) ≃* Rˣ :=
  (QuotientGroup.quotientMulEquivOfEq (subgroupOf_gammaOneSubgroup R)).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ borelFirstDiag_surjective)

variable (R) in
lemma neg_one_mem_gammaOneSubgroup_iff : -1 ∈ gammaOneSubgroup R ↔ (-1 : R) = 1 := by
  simp [mem_gammaOneSubgroup_iff]

lemma adelicReduction_neg (x : ∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :
    adelicReduction N (-x) = -adelicReduction N x :=
  funext fun ℓ ↦ Units.ext <| Matrix.ext fun i j ↦ by simp [adelicReduction, padicReduction]

lemma chineseRemainder_neg (x : GL (Fin 2) (ZMod N)) :
    chineseRemainder N (-x) = -chineseRemainder N x :=
  funext fun ℓ ↦ Units.ext <| Matrix.ext fun i j ↦ by
    simp [chineseRemainder, ZMod.cast_neg (Nat.ordProj_dvd N ℓ)]

variable [NeZero N]

/-- The group `H` of the modular curve **`X₀(N)`** (LMFDB `modcurve.x0`, `ag.modcurve.x0`): the
inverse image in `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` of the upper triangular subgroup `!![*, *; 0, *]` of
`GL₂(ℤ/Nℤ)`. Its congruence subgroup `Γ_H = H ∩ SL₂(ℤ)` is `Γ₀(N)`
(`modularGamma_adelicGammaZero`). -/
noncomputable def adelicGammaZero : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :=
  adelicPreimage N (GL2Borel (ZMod N))

/-- The group `H` of the modular curve **`X₁(N)`** (LMFDB `modcurve.x1`, `ag.modcurve.x1`): the
inverse image in `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` of the subgroup `!![1, *; 0, *]` of `GL₂(ℤ/Nℤ)`. Its
congruence subgroup `Γ_H = H ∩ SL₂(ℤ)` is `Γ₁(N)` (`modularGamma_adelicGammaOne`). -/
noncomputable def adelicGammaOne : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :=
  adelicPreimage N (gammaOneSubgroup (ZMod N))

/-- The group `H` of the modular curve **`X_{±1}(N)`** (LMFDB `modcurve.xpm1`): the inverse image
in `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` of the subgroup `!![±1, *; 0, *]` of `GL₂(ℤ/Nℤ)`. It is `±H` for the
group `H` of `X₁(N)` (`adelicGammaPMOne_eq_adjoinNegOne`), and its congruence subgroup is
`±Γ₁(N)` (`modularGamma_adelicGammaPMOne`). -/
noncomputable def adelicGammaPMOne : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :=
  adelicPreimage N (gammaPMOneSubgroup (ZMod N))

lemma adelicGammaOne_le_adelicGammaPMOne : adelicGammaOne N ≤ adelicGammaPMOne N :=
  adelicPreimage_mono N gammaOneSubgroup_le_gammaPMOneSubgroup

lemma adelicGammaPMOne_le_adelicGammaZero : adelicGammaPMOne N ≤ adelicGammaZero N :=
  adelicPreimage_mono N gammaPMOneSubgroup_le_gl2Borel

lemma adelicReductionZMod_neg (x : ∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :
    adelicReductionZMod N (-x) = -adelicReductionZMod N x :=
  chineseRemainder_injective N <| by
    rw [chineseRemainder_adelicReductionZMod, adelicReduction_neg, chineseRemainder_neg,
      chineseRemainder_adelicReductionZMod]

lemma adelicPreimage_adjoinNegOne (K : Subgroup (GL (Fin 2) (ZMod N))) :
    adelicPreimage N K.adjoinNegOne = (adelicPreimage N K).adjoinNegOne :=
  Subgroup.ext fun x ↦ by simp [adelicPreimage, adelicReductionZMod_neg]

/-- **The group of `X_{±1}(N)` is `±H` for the group `H` of `X₁(N)`**: `X₁(N)` is an index `2`
refinement of `X_{±1}(N)` (LMFDB `modcurve.quadratic_refinements`) as soon as `-1 ∉ H`, that is,
for `N ≥ 3` (`relIndex_adelicGammaOne_adelicGammaPMOne`). -/
lemma adelicGammaPMOne_eq_adjoinNegOne : adelicGammaPMOne N = (adelicGammaOne N).adjoinNegOne :=
  adelicPreimage_adjoinNegOne N _

/-- **`-1` lies in the group of `X₁(N)` if and only if `N ≤ 2`**, when `-1 = 1` in `ℤ/Nℤ`. -/
lemma neg_one_mem_adelicGammaOne_iff : -1 ∈ adelicGammaOne N ↔ N ≤ 2 := by
  rw [adelicGammaOne, adelicPreimage, Subgroup.mem_comap, adelicReductionZMod_neg, map_one,
    neg_one_mem_gammaOneSubgroup_iff, neg_eq_iff_add_eq_zero, one_add_one_eq_two,
    ← Nat.cast_ofNat, ZMod.natCast_eq_zero_iff, Nat.dvd_prime Nat.prime_two]
  have : N ≠ 0 := NeZero.ne N
  omega

/-- **For `N ≤ 2` the groups of `X_{±1}(N)` and `X₁(N)` coincide**, as `-1 = 1` in `ℤ/Nℤ`. -/
lemma adelicGammaPMOne_eq_adelicGammaOne (hN : N ≤ 2) : adelicGammaPMOne N = adelicGammaOne N := by
  rw [adelicGammaPMOne_eq_adjoinNegOne, Subgroup.adjoinNegOne_eq_self_iff]
  exact (neg_one_mem_adelicGammaOne_iff N).mpr hN

/-- **For `N ≥ 3` the group of `X₁(N)` has index `2` in the group of `X_{±1}(N)`.** -/
lemma relIndex_adelicGammaOne_adelicGammaPMOne (hN : 2 < N) :
    (adelicGammaOne N).relIndex (adelicGammaPMOne N) = 2 := by
  rw [adelicGammaPMOne_eq_adjoinNegOne]
  exact Subgroup.relIndex_adjoinNegOne_eq_two <| (neg_one_mem_adelicGammaOne_iff N).not.mpr <| by
    omega

lemma adelicReductionZMod_sl2zToAdelic (γ : SL(2, ℤ)) :
    adelicReductionZMod N (sl2zToAdelic γ) = SpecialLinearGroup.mapGL (ZMod N) γ := by
  refine chineseRemainder_injective N <| (chineseRemainder_adelicReductionZMod N _).trans <|
    funext fun ℓ ↦ Units.ext <| Matrix.ext fun i j ↦ ?_
  simp [adelicReduction, padicReduction, sl2zToAdelic, chineseRemainder]

lemma mem_modularGamma_adelicPreimage_iff {K : Subgroup (GL (Fin 2) (ZMod N))} {γ : SL(2, ℤ)} :
    γ ∈ modularGamma (adelicPreimage N K) ↔ SpecialLinearGroup.mapGL (ZMod N) γ ∈ K := by
  rw [modularGamma, adelicPreimage, Subgroup.mem_comap, Subgroup.mem_comap,
    adelicReductionZMod_sl2zToAdelic]

/-- **The congruence subgroup `Γ_H = H ∩ SL₂(ℤ)` of the group `H` of `X₀(N)` is `Γ₀(N)`**, so that
`X₀(N)(ℂ)` is the compactified quotient `Γ₀(N) \ ℍ*`. -/
lemma modularGamma_adelicGammaZero :
    modularGamma (adelicGammaZero N) = CongruenceSubgroup.Gamma0 N :=
  Subgroup.ext fun γ ↦ by
    rw [adelicGammaZero, mem_modularGamma_adelicPreimage_iff, GL2Borel.mem_iff,
      CongruenceSubgroup.Gamma0_mem]
    simp

/-- **The congruence subgroup `Γ_H = H ∩ SL₂(ℤ)` of the group `H` of `X₁(N)` is `Γ₁(N)`**, so that
`X₁(N)(ℂ)` is the compactified quotient `Γ₁(N) \ ℍ*`. -/
lemma modularGamma_adelicGammaOne : modularGamma (adelicGammaOne N) = CongruenceSubgroup.Gamma1 N :=
  Subgroup.ext fun γ ↦ by
    have hdet : (γ 0 0 : ZMod N) * γ 1 1 - γ 0 1 * γ 1 0 = 1 := by
      exact_mod_cast congrArg (Int.cast : ℤ → ZMod N) ((Matrix.det_fin_two _).symm.trans γ.det_coe)
    rw [adelicGammaOne, mem_modularGamma_adelicPreimage_iff, mem_gammaOneSubgroup_iff,
      CongruenceSubgroup.Gamma1_mem]
    simp only [SpecialLinearGroup.mapGL_coe_matrix, algebraMap_int_eq, SL_reduction_mod_hom_val]
    refine ⟨fun ⟨h₀₀, h₁₀⟩ ↦ ⟨h₀₀, ?_, h₁₀⟩, fun h ↦ ⟨h.1, h.2.2⟩⟩
    linear_combination hdet - (γ 1 1 : ZMod N) * h₀₀ + (γ 0 1 : ZMod N) * h₁₀

/-- **The congruence subgroup `Γ_H = H ∩ SL₂(ℤ)` of the group `H` of `X_{±1}(N)` is `±Γ₁(N)`**. -/
lemma modularGamma_adelicGammaPMOne :
    modularGamma (adelicGammaPMOne N) = (CongruenceSubgroup.Gamma1 N).adjoinNegOne := by
  rw [adelicGammaPMOne_eq_adjoinNegOne, modularGamma_adjoinNegOne, modularGamma_adelicGammaOne]

/-- The first diagonal entry modulo `N` of the group `H₀` of `X₀(N)`: the composite of the
reduction `H₀ → B(ℤ/Nℤ)` modulo `N` and of the character `!![a, b; 0, d] ↦ a`. It is surjective,
with kernel the group `H₁` of `X₁(N)`. -/
noncomputable def adelicGammaZeroFirstDiag : adelicGammaZero N →* (ZMod N)ˣ :=
  (borelFirstDiag (ZMod N)).comp ((adelicReductionZMod N).subgroupComap (GL2Borel (ZMod N)))

lemma adelicGammaZeroFirstDiag_apply (x : adelicGammaZero N) :
    (adelicGammaZeroFirstDiag N x : ZMod N) = adelicReductionZMod N x.1 0 0 :=
  borelFirstDiag_apply _

lemma ker_adelicGammaZeroFirstDiag :
    (adelicGammaZeroFirstDiag N).ker = (adelicGammaOne N).subgroupOf (adelicGammaZero N) := by
  ext x
  rw [MonoidHom.mem_ker, ← Units.val_eq_one, adelicGammaZeroFirstDiag_apply,
    Subgroup.mem_subgroupOf, adelicGammaOne, adelicPreimage, Subgroup.mem_comap,
    mem_gammaOneSubgroup_iff]
  exact (and_iff_left (GL2Borel.mem_iff.mp x.2)).symm

lemma adelicGammaZeroFirstDiag_surjective : Function.Surjective (adelicGammaZeroFirstDiag N) :=
  borelFirstDiag_surjective.comp <|
    (adelicReductionZMod N).subgroupComap_surjective _ (adelicReductionZMod_surjective N)

instance : ((adelicGammaOne N).subgroupOf (adelicGammaZero N)).Normal :=
  ker_adelicGammaZeroFirstDiag N ▸ MonoidHom.normal_ker _

/-- **The group of `X₀(N)` modulo the group of `X₁(N)` is `(ℤ/Nℤ)ˣ`**, through the first diagonal
entry modulo `N`: the covering `X₁(N) → X₀(N)` is the quotient by `(ℤ/Nℤ)ˣ`, which acts on the
moduli `(E, P)` by `(E, P) ↦ (E, dP)`; `±1` act trivially, as `X_{±1}(N)` and `X₁(N)` are the same
curve (`adelicGammaPMOne_eq_adjoinNegOne`). -/
noncomputable def adelicGammaZeroQuotientEquiv :
    adelicGammaZero N ⧸ (adelicGammaOne N).subgroupOf (adelicGammaZero N) ≃* (ZMod N)ˣ :=
  (QuotientGroup.quotientMulEquivOfEq (ker_adelicGammaZeroFirstDiag N).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ (adelicGammaZeroFirstDiag_surjective N))

/-- **The group of `X₁(N)` has index `φ(N)` in the group of `X₀(N)`**: for `N ≥ 3`, twice the
degree `φ(N) / 2` of the covering `X₁(N) = X_{±1}(N) → X₀(N)`. -/
lemma relIndex_adelicGammaOne_adelicGammaZero :
    (adelicGammaOne N).relIndex (adelicGammaZero N) = N.totient := by
  rw [Subgroup.relIndex, Subgroup.index, Nat.card_congr (adelicGammaZeroQuotientEquiv N).toEquiv,
    Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]

/-- **The group of `X₀(p)` has index `p + 1`** in `GL₂(ℤ̂)`, for a prime `p`: the number of lines
of `𝔽_p²`, the cyclic subgroups of order `p` of `E[p]`. -/
lemma index_adelicGammaZero : (adelicGammaZero p).index = p + 1 := by
  rw [adelicGammaZero, index_adelicPreimage, GL2Borel.index_eq, ZMod.card]

/-- **The group of `X₁(p)` has index `p² - 1`** in `GL₂(ℤ̂)`, for a prime `p`: the number of points
of order `p` of `E[p]`. -/
lemma index_adelicGammaOne : (adelicGammaOne p).index = p ^ 2 - 1 := by
  rw [← Subgroup.relIndex_mul_index (adelicGammaOne_le_adelicGammaPMOne p |>.trans
    (adelicGammaPMOne_le_adelicGammaZero p)), relIndex_adelicGammaOne_adelicGammaZero,
    index_adelicGammaZero, Nat.totient_prime Fact.out, mul_comm, ← mul_self_tsub_one, sq]

end Matrix.GeneralLinearGroup
