import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.SplitCartan
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.AdelicPreimage
import TauCeti.GroupTheory.Index.Basic
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Card

/-!
# The groups of the modular curves `X_sp(N)` and `X_sp⁺(N)`

The modular curve `X_sp(N)` is the modular curve `X_H` for `H ≤ GL₂(ℤ̂)` the inverse image of the
split Cartan subgroup `Cs(N)` of `GL₂(ℤ/Nℤ)`, the group of invertible diagonal matrices: the
Cartan subgroup of the split algebra `ℤ/Nℤ × ℤ/Nℤ` in its standard basis
(`Matrix.GeneralLinearGroup.cartanSubgroup_piBasisFun`), which is split at every prime `ℓ` dividing
`N`, as its reduction `𝔽_ℓ × 𝔽_ℓ` modulo `ℓ` is not a field. The modular curve `X_sp⁺(N)` is `X_H`
for `H` the inverse image of the extended Cartan subgroup `Ns(N)` of the same algebra, generated by
`Cs(N)` and `!![0, 1; 1, 0]`, the matrix of its canonical involution; its elements are the
invertible diagonal and antidiagonal matrices
(`Matrix.GeneralLinearGroup.mem_extendedCartanSubgroup_piBasisFun_iff`), and it contains `Cs(N)`
with index `2` for `N > 1`. For a prime `N = p`, `Cs(p)` and `Ns(p)` are the LMFDB's groups `Cs`
and `Ns` (`Matrix.GeneralLinearGroup.labelNs`).

The inverse images in `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` are taken under the reduction modulo `N`
(`Matrix.GeneralLinearGroup.adelicPreimage`); they are open subgroups of level at most `N`, the
second containing the first with index `2` for `N > 1`. For a prime `p` their indices in `GL₂(ℤ̂)`
are `p (p + 1)` and `p (p + 1) / 2`. The modular curves themselves are not formalised. The data
of the moduli interpretations of their non-cuspidal points, ordered and unordered pairs of cyclic
subgroups of `E[N]`, are in
`LeanBridge.ForMathlib.AlgebraicGeometry.EllipticCurve.SplitCartanStructure`.

## Main definitions

* `Matrix.GeneralLinearGroup.adelicSplitCartan` (LMFDB `modcurve.xsp`): the group `H` of
  `X_sp(N)`.
* `Matrix.GeneralLinearGroup.adelicExtendedSplitCartan` (LMFDB `modcurve.xsp_plus`): the group `H`
  of `X_sp⁺(N)`.

## Main results

* `Matrix.GeneralLinearGroup.not_isField_quotient_span_natCast`: the split algebra
  `ℤ/Nℤ × ℤ/Nℤ` is split at every prime dividing `N`.
* `Matrix.GeneralLinearGroup.adelicSplitCartan_le_adelicExtendedSplitCartan` and
  `Matrix.GeneralLinearGroup.relIndex_adelicSplitCartan_adelicExtendedSplitCartan`: the group of
  `X_sp(N)` lies in that of `X_sp⁺(N)`, with index `2` for `N > 1`.
* `Matrix.GeneralLinearGroup.index_adelicSplitCartan` and
  `Matrix.GeneralLinearGroup.two_mul_index_adelicExtendedSplitCartan`: for a prime `p`, the groups
  of `X_sp(p)` and `X_sp⁺(p)` have index `p (p + 1)` and `p (p + 1) / 2`.
-/

open Ideal TauCeti

namespace Matrix.GeneralLinearGroup

variable (N p : ℕ) [Fact p.Prime]

/-- **The split algebra `ℤ/Nℤ × ℤ/Nℤ` is split at every prime `ℓ` dividing `N`** (LMFDB
`gl2.cartan`): its reduction `𝔽_ℓ × 𝔽_ℓ` modulo `ℓ` is not a field, as the two idempotents
`(1, 0)` and `(0, 1)` have product `0` but are not divisible by `ℓ`. -/
lemma not_isField_quotient_span_natCast {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓN : ℓ ∣ N) :
    ¬IsField ((Fin 2 → ZMod N) ⧸ span {(ℓ : Fin 2 → ZMod N)}) := by
  intro h
  have hmem (i : Fin 2) : Pi.single i 1 ∉ span {(ℓ : Fin 2 → ZMod N)} := fun hi ↦ by
    rcases mem_span_singleton'.mp hi with ⟨a, ha⟩
    have h₁ : a i * ℓ = 1 := by simpa using congr_fun ha i
    exact hℓ.one_lt.ne' <|
      ((ZMod.isUnit_iff_coprime ℓ N).mp (.of_mul_eq_one_right _ h₁)).eq_one_of_dvd hℓN
  have h₀₁ : (Pi.single 0 1 : Fin 2 → ZMod N) * Pi.single 1 1 ∈ span {(ℓ : Fin 2 → ZMod N)} := by
    simp [← Pi.single_mul_left]
  exact (((Quotient.maximal_ideal_iff_isField_quotient _).mpr h).isPrime.mem_or_mem h₀₁).elim
    (hmem 0) (hmem 1)

variable [NeZero N]

/-- The group `H` of the modular curve **`X_sp(N)`** (LMFDB `modcurve.xsp`): the inverse image in
`GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` of the split Cartan subgroup `Cs(N)` of `GL₂(ℤ/Nℤ)`, the group of
invertible diagonal matrices, Tau Ceti's `TauCeti.diagonalTorus (ZMod N) 2`. It is the Cartan
subgroup of the split algebra `ℤ/Nℤ × ℤ/Nℤ` (`cartanSubgroup_piBasisFun`), which is split at every
prime dividing `N` (`not_isField_quotient_span_natCast`). -/
noncomputable def adelicSplitCartan : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :=
  adelicPreimage N (diagonalTorus (ZMod N) 2)

/-- The group `H` of the modular curve **`X_sp⁺(N)`** (LMFDB `modcurve.xsp_plus`): the inverse image
in `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` of the extended Cartan subgroup `Ns(N)` of the split algebra
`ℤ/Nℤ × ℤ/Nℤ` in its standard basis, which consists of the invertible diagonal and antidiagonal
matrices of `GL₂(ℤ/Nℤ)` (`mem_extendedCartanSubgroup_piBasisFun_iff`). For a prime
`N = p` this subgroup of `GL₂(𝔽_p)` is the LMFDB's `Ns` (`labelNs_eq_extendedCartanSubgroup`). -/
noncomputable def adelicExtendedSplitCartan : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :=
  adelicPreimage N (extendedCartanSubgroup (Pi.basisFun (ZMod N) (Fin 2)))

/-- **The group of `X_sp(N)` lies in that of `X_sp⁺(N)`**, so that `X_sp(N)` covers `X_sp⁺(N)`. -/
lemma adelicSplitCartan_le_adelicExtendedSplitCartan :
    adelicSplitCartan N ≤ adelicExtendedSplitCartan N :=
  adelicPreimage_mono N <| cartanSubgroup_piBasisFun (ZMod N) ▸
    cartanSubgroup_le_extendedCartanSubgroup _

variable [Fact (1 < N)] in
/-- **The group of `X_sp(N)` has index `2` in that of `X_sp⁺(N)`** for `N > 1`, so that `X_sp(N)`
is a double cover of `X_sp⁺(N)`: `Cs(N)` has index `2` in `Ns(N)`. -/
lemma relIndex_adelicSplitCartan_adelicExtendedSplitCartan :
    (adelicSplitCartan N).relIndex (adelicExtendedSplitCartan N) = 2 := by
  rw [adelicSplitCartan, adelicExtendedSplitCartan, relIndex_adelicPreimage, extendedCartanSubgroup,
    cartanSubgroup_piBasisFun, canonicalInvolutionGL_piBasisFun]
  exact relIndex_diagonalTorus_sup_zpowers_swapGL (ZMod N)

lemma index_diagonalTorus_zmod : (diagonalTorus (ZMod p) 2).index = p * (p + 1) :=
  index_eq_of_natCard_eq_mul (pow_pos (Nat.sub_pos_of_lt (Fact.out : p.Prime).one_lt) 2)
    (by rw [natCard_diagonalTorus, Nat.card_zmod]) (by rw [natCard_GL_fin_two, ZMod.card])

/-- **The group of `X_sp(p)` has index `p (p + 1)`** in `GL₂(ℤ̂)`, for a prime `p`. -/
lemma index_adelicSplitCartan : (adelicSplitCartan p).index = p * (p + 1) :=
  (index_adelicPreimage p _).trans (index_diagonalTorus_zmod p)

/-- **The group of `X_sp⁺(p)` has index `p (p + 1) / 2`** in `GL₂(ℤ̂)`, for a prime `p`. -/
lemma two_mul_index_adelicExtendedSplitCartan :
    2 * (adelicExtendedSplitCartan p).index = p * (p + 1) := by
  rw [← index_adelicSplitCartan,
    ← Subgroup.relIndex_mul_index (adelicSplitCartan_le_adelicExtendedSplitCartan p),
    relIndex_adelicSplitCartan_adelicExtendedSplitCartan]

end Matrix.GeneralLinearGroup
