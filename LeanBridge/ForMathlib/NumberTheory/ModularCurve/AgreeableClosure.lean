/-!
# The agreeable closure of an open subgroup of `GL₂(ℤ̂)`

Let `H` be an open subgroup of `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` with `det(H) = ℤ̂ˣ`, the groups of the
LMFDB's modular curves. Following Zywina (*Explicit open images for elliptic curves over `ℚ`*,
Prop. 8.1), its agreeable closure `H̃`, the intersection of the agreeable subgroups containing `H`
(LMFDB `modcurve.agreeable`), is the group `𝒢 = ℤ̂ˣ · H · ∏_{ℓ ∉ P} GL₂(ℤ_ℓ)`, where `P` consists of
`2` and the primes dividing the level of the commutator subgroup `[H, H]` in `SL₂(ℤ̂)`; that is,
`𝒢 = (ℤ_Nˣ · H_N) × ∏_{ℓ ∤ N} GL₂(ℤ_ℓ)` for `N = ∏_{ℓ ∈ P} ℓ`. Moreover `[H̃, H̃] = [H, H]`, so `H`
is normal in `H̃` and `H̃ / H` is abelian, and finite as `H` is open.

The proof follows Zywina, without his group-theoretic classification results:

* the level of an open subgroup `K` of `GL₂(ℤ̂)` or `SL₂(ℤ̂)` is prime to `ℓ` exactly when `K`
  contains the elements of the ambient group supported at `ℓ`;
* the commutator subgroup `[H, H]` is open in `SL₂(ℤ̂)`: if `H` contains the kernel of reduction
  modulo `M`, then `[H, H]` contains the elements of `SL₂(ℤ̂)` congruent to `1` modulo `(2M)⁴`, each
  of which is, at every prime, a product of five commutators of elements congruent to `1` modulo
  `ℓ^{v_ℓ(2M)}`, uniformly in `ℓ`;
* modulo the elements trivial at the primes of `P`, the commutators of `𝒢` are those of `H`, the
  scalars being central, and the elements of `SL₂(ℤ̂)` trivial at the primes of `P` lie in
  `[H, H]`; so `[𝒢, 𝒢] = [H, H]`;
* `𝒢` is agreeable: if an odd prime `ℓ` divides the level of `𝒢` but not that of `𝒢 ∩ SL₂(ℤ̂)`,
  then `𝒢` contains `SL₂(ℤ_ℓ)` (at `ℓ`), generated by unipotent matrices, each a commutator of a
  unipotent matrix and an element of `𝒢` with component `diag(2, 1)` or `diag(1, 2)` at `ℓ`; so
  `[𝒢, 𝒢] = [H, H]` contains `SL₂(ℤ_ℓ)`, and `ℓ` does not divide the level of `[H, H]`;
* every agreeable `K ⊇ H` contains `𝒢`: the level of `K ∩ SL₂(ℤ̂) ⊇ [K, K] ⊇ [H, H]` has its
  prime divisors in `P`, hence so does the level of `K`.

The commutator subgroup is Mathlib's, the subgroup generated by the commutators; as it is open in
`SL₂(ℤ̂)`, it is also the closed commutator subgroup. Zywina's Prop. 8.1, like the LMFDB's groups,
assumes `det(H) = ℤ̂ˣ`, which only the statements about `[H̃, H̃]` and the normality use.

## Main definitions

* `Matrix.GeneralLinearGroup.adelicAwayFrom`: the elements of `GL₂(ℤ̂)` trivial at a finite set of
  primes.
* `Matrix.GeneralLinearGroup.agreeableClosurePrimes`: the primes of Zywina's construction.

## Main results

* `Matrix.GeneralLinearGroup.primeFactors_adelicLevel_subset_iff`: the level of an open subgroup
  has its prime divisors in a finite set `S` exactly when the subgroup contains the elements
  trivial at the primes of `S`.
* `Matrix.GeneralLinearGroup.adelicSL_inf_ker_le_commutator`: the commutator subgroup of an open
  subgroup of `GL₂(ℤ̂)` is open in `SL₂(ℤ̂)`.
* `Matrix.GeneralLinearGroup.commutator_adelicScalars_sup_sup_adelicAwayFrom`,
  `Matrix.GeneralLinearGroup.isAgreeable_adelicScalars_sup_sup_adelicAwayFrom` and
  `Matrix.GeneralLinearGroup.adelicScalars_sup_sup_adelicAwayFrom_le`: Zywina's group has the same
  commutator subgroup as `H`, is agreeable, and lies in every agreeable subgroup containing `H`.
* `Matrix.GeneralLinearGroup.agreeableClosure_eq` and
  `Matrix.GeneralLinearGroup.isAgreeable_agreeableClosure`: the agreeable closure is Zywina's group,
  and is agreeable.
* `Matrix.GeneralLinearGroup.commutator_agreeableClosure` (LMFDB `modcurve.agreeable`): the
  agreeable closure has the same commutator subgroup as `H`.
* `Matrix.GeneralLinearGroup.normal_subgroupOf_agreeableClosure` (LMFDB `modcurve.agreeable`): `H`
  is normal in its agreeable closure.
* `Matrix.GeneralLinearGroup.isMulCommutative_agreeableQuotient` and
  `Matrix.GeneralLinearGroup.finite_agreeableQuotient` (LMFDB `modcurve.agreeable`): the agreeable
  quotient is abelian and finite.

## References

* D. Zywina, *Explicit open images for elliptic curves over `ℚ`*, arXiv:2206.14959, §8.
-/

open Matrix Ideal

open scoped commutatorElement

namespace Subgroup

variable {Γ : Type*} [Group Γ] {K L Z : Subgroup Γ}

lemma inf_comap_map_eq_iff {Q : Type*} [Group Q] {f : Γ →* Q} (hLK : L ≤ K) :
    K ⊓ (L.map f).comap f = L ↔ K ⊓ f.ker ≤ L := by
  refine ⟨fun h ↦ h ▸ inf_le_inf_left K (f.ker_le_comap (L.map f)), fun hker ↦ ?_⟩
  refine le_antisymm (fun g hg ↦ ?_) (le_inf hLK (le_comap_map f L))
  rcases mem_inf.mp hg with ⟨hgK, hg⟩
  rcases mem_map.mp (mem_comap.mp hg) with ⟨h, hh, hgh⟩
  have hk : h⁻¹ * g ∈ L := hker (mem_inf.mpr ⟨mul_mem (inv_mem (hLK hh)) hgK, by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hgh, inv_mul_cancel]⟩)
  simpa using mul_mem hh hk

lemma commutator_sup_of_le_center (hZ : Z ≤ center Γ) : ⁅Z ⊔ K, Z ⊔ K⁆ = ⁅K, K⁆ := by
  have : Z.Normal := normal_of_le_center hZ
  refine le_antisymm (commutator_le.mpr fun x hx y hy ↦ ?_)
    (commutator_mono le_sup_right le_sup_right)
  rw [← SetLike.mem_coe, normal_mul, Set.mem_mul] at hx hy
  rcases hx with ⟨z, hz, h, hh, rfl⟩
  rcases hy with ⟨z', hz', h', hh', rfl⟩
  have h₁ : ⁅z * h, z' * h'⁆ = ⁅h, z' * h'⁆ := by
    have e : z * h * (z' * h') * (z * h)⁻¹ = z * (h * (z' * h') * h⁻¹) * z⁻¹ := by group
    rw [commutatorElement_def, commutatorElement_def, e, ← mem_center_iff.mp (hZ hz),
      mul_inv_cancel_right]
  have h₂ : ⁅h, z' * h'⁆ = ⁅h, h'⁆ := by
    have e : h * (z' * h') * h⁻¹ * (z' * h')⁻¹ = h * z' * h' * h⁻¹ * h'⁻¹ * z'⁻¹ := by group
    rw [commutatorElement_def, commutatorElement_def, e, mem_center_iff.mp (hZ hz') h,
      mul_assoc z', mul_assoc z', mul_assoc z', ← mem_center_iff.mp (hZ hz'), mul_assoc,
      mul_inv_cancel, mul_one]
  rw [h₁, h₂]
  exact commutator_mem_commutator hh hh'

end Subgroup

namespace PadicInt

lemma isUnit_one_add_pow {ℓ : ℕ} [Fact ℓ.Prime] {k : ℕ} (hk : k = 0 → ℓ ≠ 2) :
    IsUnit (1 + (ℓ : ℤ_[ℓ]) ^ k) := by
  have h : 1 + (ℓ : ℤ_[ℓ]) ^ k = ((1 + ℓ ^ k : ℕ) : ℤ_[ℓ]) := by
    push_cast
    rfl
  rw [h, isUnit_iff, norm_natCast_eq_one_iff]
  rcases k with _ | k
  · exact (Nat.coprime_primes Fact.out Nat.prime_two).mpr (hk rfl)
  · rw [pow_succ, Nat.coprime_add_mul_right_right]
    exact Nat.coprime_one_right ℓ

end PadicInt

namespace Matrix.GeneralLinearGroup

variable (S : Finset ℕ)

/-- The subgroup of `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)` of the elements trivial at the primes of a finite set
`S`, the product of the `GL₂(ℤ_ℓ)` over the primes `ℓ ∉ S`. -/
noncomputable def adelicAwayFrom : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) :=
  Subgroup.pi {ℓ | (ℓ : ℕ) ∈ S} fun _ ↦ ⊥

lemma normal_adelicAwayFrom : (adelicAwayFrom S).Normal :=
  ⟨fun g hg x ℓ hℓ ↦ by simp [Subgroup.mem_bot.mp (hg ℓ hℓ)]⟩

variable {G H K : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ])} {N : ℕ} {ℓ : Nat.Primes}
  {g : ∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]} {x : GL (Fin 2) ℤ_[ℓ]}

variable (H) in
/-- The primes of **Zywina's construction of the agreeable closure** of `H`: `2` and the primes
dividing the level of the commutator subgroup `[H, H]` of `H` in `SL₂(ℤ̂)`. (Zywina shows that `2`
divides that level; this is not needed here.) -/
noncomputable def agreeableClosurePrimes : Finset ℕ :=
  insert 2 (adelicLevel adelicSL ⁅H, H⁆).primeFactors

/-! ### Levels and the elements supported away from a set of primes -/

lemma isCongrOne_iff_map_toZModPow_eq_one {p : ℕ} [Fact p.Prime] (e : ℕ) (a : GL (Fin 2) ℤ_[p]) :
    IsCongrOne ((p : ℤ_[p]) ^ e) a ↔ map (PadicInt.toZModPow e) a = 1 := by
  rw [Units.ext_iff, Units.val_one,
    ← Matrix.map_one _ (map_zero (PadicInt.toZModPow e)) (map_one _), ← Matrix.ext_iff]
  refine forall₂_congr fun i j ↦ ?_
  rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero]
  rfl

lemma adelicReduction_eq_one_iff : adelicReduction N g = 1 ↔
    ∀ ℓ : Nat.Primes, IsCongrOne ((ℓ : ℤ_[ℓ]) ^ N.factorization ℓ) (g ℓ) :=
  funext_iff.trans <| forall_congr' fun _ ↦ (isCongrOne_iff_map_toZModPow_eq_one _ _).symm

lemma adelicLevel_pos_of_exists (hHG : H ≤ G) (hex : ∃ N, 0 < N ∧ G ⊓ (adelicReduction N).ker ≤ H) :
    0 < adelicLevel G H :=
  (Nat.sInf_mem (hex.imp fun _ hN ↦ ⟨hN.1, (Subgroup.inf_comap_map_eq_iff hHG).mpr hN.2⟩) :
    adelicLevel G H ∈ _).1

lemma inf_ker_adelicReduction_adelicLevel_le (hHG : H ≤ G)
    (hex : ∃ N, 0 < N ∧ G ⊓ (adelicReduction N).ker ≤ H) :
    G ⊓ (adelicReduction (adelicLevel G H)).ker ≤ H :=
  (Subgroup.inf_comap_map_eq_iff hHG).mp (Nat.sInf_mem (hex.imp fun _ hN ↦
    ⟨hN.1, (Subgroup.inf_comap_map_eq_iff hHG).mpr hN.2⟩) : adelicLevel G H ∈ _).2

lemma adelicLevel_le (hHG : H ≤ G) (hN : 0 < N) (hker : G ⊓ (adelicReduction N).ker ≤ H) :
    adelicLevel G H ≤ N :=
  Nat.sInf_le ⟨hN, (Subgroup.inf_comap_map_eq_iff hHG).mpr hker⟩

lemma inf_ker_adelicReduction_ordCompl_le (hG : ∀ g ∈ G, ∀ ℓ, Pi.mulSingle ℓ (g ℓ) ∈ G)
    (hN : G ⊓ (adelicReduction N).ker ≤ H) (hℓ : G ⊓ Subgroup.pi {p | p ≠ ℓ} (fun _ ↦ ⊥) ≤ H) :
    G ⊓ (adelicReduction (ordCompl[(ℓ : ℕ)] N)).ker ≤ H := by
  intro g hg
  rcases Subgroup.mem_inf.mp hg with ⟨hgG, hg⟩
  rw [MonoidHom.mem_ker, adelicReduction_eq_one_iff] at hg
  have ha : Pi.mulSingle ℓ (g ℓ) ∈ H :=
    hℓ ⟨hG g hgG ℓ, fun p hp ↦ Subgroup.mem_bot.mpr (Pi.mulSingle_eq_of_ne hp _)⟩
  have hb : (Pi.mulSingle ℓ (g ℓ))⁻¹ * g ∈ H := by
    refine hN (Subgroup.mem_inf.mpr ⟨mul_mem (inv_mem (hG g hgG ℓ)) hgG, ?_⟩)
    rw [MonoidHom.mem_ker, adelicReduction_eq_one_iff]
    intro p
    by_cases hp : p = ℓ
    · subst hp
      simpa using isCongrOne_one
    · have h : IsCongrOne ((p : ℤ_[p]) ^ (ordCompl[(ℓ : ℕ)] N).factorization p) (g p) := hg p
      rw [Nat.factorization_ordCompl, Finsupp.erase_ne fun h ↦ hp (Subtype.ext h)] at h
      simpa [Pi.mulSingle_eq_of_ne hp] using h
  simpa using mul_mem ha hb

lemma not_dvd_adelicLevel (hG : ∀ g ∈ G, ∀ ℓ, Pi.mulSingle ℓ (g ℓ) ∈ G) (hHG : H ≤ G)
    (hex : ∃ N, 0 < N ∧ G ⊓ (adelicReduction N).ker ≤ H)
    (hℓ : G ⊓ Subgroup.pi {p | p ≠ ℓ} (fun _ ↦ ⊥) ≤ H) : ¬(ℓ : ℕ) ∣ adelicLevel G H := by
  intro hdvd
  have hpos : 0 < adelicLevel G H := adelicLevel_pos_of_exists hHG hex
  have hle : adelicLevel G H ≤ ordCompl[(ℓ : ℕ)] (adelicLevel G H) :=
    adelicLevel_le hHG (Nat.ordCompl_pos ℓ hpos.ne')
      (inf_ker_adelicReduction_ordCompl_le hG (inf_ker_adelicReduction_adelicLevel_le hHG hex) hℓ)
  have hlt : ordCompl[(ℓ : ℕ)] (adelicLevel G H) < adelicLevel G H := by
    conv_rhs => rw [← Nat.ordProj_mul_ordCompl_eq_self (adelicLevel G H) ℓ]
    exact lt_mul_of_one_lt_left (Nat.ordCompl_pos ℓ hpos.ne') <| Nat.one_lt_pow
      (ℓ.prop.factorization_pos_of_dvd hpos.ne' hdvd).ne' ℓ.prop.one_lt
  omega

lemma inf_pi_le_of_not_dvd (hHG : H ≤ G) (hex : ∃ N, 0 < N ∧ G ⊓ (adelicReduction N).ker ≤ H)
    (hℓ : ¬(ℓ : ℕ) ∣ adelicLevel G H) : G ⊓ Subgroup.pi {p | p ≠ ℓ} (fun _ ↦ ⊥) ≤ H := by
  refine (inf_le_inf_left G fun g hg ↦ ?_).trans (inf_ker_adelicReduction_adelicLevel_le hHG hex)
  rw [MonoidHom.mem_ker, adelicReduction_eq_one_iff]
  intro p
  by_cases hp : p = ℓ
  · subst hp
    rw [Nat.factorization_eq_zero_of_not_dvd hℓ, pow_zero]
    exact isCongrOne_of_isUnit isUnit_one
  · rw [Subgroup.mem_bot.mp (hg p hp)]
    exact isCongrOne_one

variable {S} in
/-- **The level of a subgroup has its prime divisors in `S` exactly when the subgroup contains the
elements trivial at the primes of `S`**: for a subgroup `H` of `G ≤ GL₂(ℤ̂)` with a level, where
`G` is a product of subgroups of the `GL₂(ℤ_ℓ)` (such as `GL₂(ℤ̂)` or `SL₂(ℤ̂)`), and a finite set
`S` of primes. -/
lemma primeFactors_adelicLevel_subset_iff (hG : ∀ g ∈ G, ∀ ℓ, Pi.mulSingle ℓ (g ℓ) ∈ G)
    (hHG : H ≤ G) (hex : ∃ N, 0 < N ∧ G ⊓ (adelicReduction N).ker ≤ H) :
    (adelicLevel G H).primeFactors ⊆ S ↔ G ⊓ adelicAwayFrom S ≤ H := by
  have hpos : 0 < adelicLevel G H := adelicLevel_pos_of_exists hHG hex
  refine ⟨fun hS ↦ (inf_le_inf_left G fun g hg ↦ ?_).trans
    (inf_ker_adelicReduction_adelicLevel_le hHG hex), fun hS ℓ hℓ ↦ ?_⟩
  · rw [MonoidHom.mem_ker, adelicReduction_eq_one_iff]
    intro p
    by_cases hp : (p : ℕ) ∈ S
    · rw [Subgroup.mem_bot.mp (hg p hp)]
      exact isCongrOne_one
    · have h : ¬(p : ℕ) ∣ adelicLevel G H :=
        fun h ↦ hp (hS (Nat.mem_primeFactors.mpr ⟨p.prop, h, hpos.ne'⟩))
      rw [Nat.factorization_eq_zero_of_not_dvd h, pow_zero]
      exact isCongrOne_of_isUnit isUnit_one
  · by_contra hℓS
    refine not_dvd_adelicLevel (ℓ := ⟨ℓ, Nat.prime_of_mem_primeFactors hℓ⟩) hG hHG hex
      ((inf_le_inf_left G fun g hg p hp ↦ hg p ?_).trans hS) (Nat.dvd_of_mem_primeFactors hℓ)
    rintro rfl
    exact hℓS hp

/-! ### The commutator subgroup is open in `SL₂(ℤ̂)` -/

lemma commutator_le_adelicSL : ⁅H, H⁆ ≤ adelicSL :=
  Subgroup.commutator_le.mpr fun g _ h _ ↦ by
    rw [adelicSL, MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
    exact mul_comm _ _

variable (ℓ) in
lemma det_apply_eq_one_of_mem_adelicSL (hg : g ∈ adelicSL) : det (g ℓ) = 1 := by
  rw [adelicSL, MonoidHom.mem_ker] at hg
  simpa [adelicDet] using congrFun hg ℓ

/-- **The commutator subgroup of an open subgroup of `GL₂(ℤ̂)` is open in `SL₂(ℤ̂)`** (as in Zywina,
§7): if `H` contains the kernel of reduction modulo `M > 0`, then `[H, H]` contains the
elements of `SL₂(ℤ̂)` congruent to `1` modulo `(2M)⁴`. At each prime `ℓ` such an element is a
product of five commutators of elements of `GL₂(ℤ_ℓ)` congruent to `1` modulo `ℓ^{v_ℓ(2M)}`. -/
lemma adelicSL_inf_ker_le_commutator {M : ℕ} (hM : 0 < M) (hH : (adelicReduction M).ker ≤ H) :
    adelicSL ⊓ (adelicReduction ((2 * M) ^ 4)).ker ≤ ⁅H, H⁆ := by
  intro x hx
  rcases Subgroup.mem_inf.mp hx with ⟨hxSL, hxker⟩
  rw [MonoidHom.mem_ker, adelicReduction_eq_one_iff] at hxker
  have key (ℓ : Nat.Primes) : ∃ y z : Fin 5 → GL (Fin 2) ℤ_[ℓ],
      (∀ k, IsCongrOne ((ℓ : ℤ_[ℓ]) ^ (2 * M).factorization ℓ) (y k)) ∧
        (∀ k, IsCongrOne ((ℓ : ℤ_[ℓ]) ^ (2 * M).factorization ℓ) (z k)) ∧
          x ℓ = (List.ofFn fun k ↦ ⁅y k, z k⁆).prod := by
    refine exists_eq_prod_commutatorElement (PadicInt.isUnit_one_add_pow fun h0 h2 ↦ ?_)
      (by simpa using congrArg Units.val (det_apply_eq_one_of_mem_adelicSL ℓ hxSL)) ?_
    · have h : (2 * M).factorization 2 ≠ 0 :=
        (Nat.prime_two.factorization_pos_of_dvd (by positivity) (dvd_mul_right 2 M)).ne'
      exact h (h2 ▸ h0)
    · have h : IsCongrOne ((ℓ : ℤ_[ℓ]) ^ ((2 * M) ^ 4).factorization ℓ) (x ℓ) := hxker ℓ
      rwa [Nat.factorization_pow, Finsupp.smul_apply, smul_eq_mul, mul_comm, pow_mul] at h
  choose y z hy hz hxyz using key
  have hdvd (ℓ : Nat.Primes) :
      (ℓ : ℤ_[ℓ]) ^ M.factorization ℓ ∣ (ℓ : ℤ_[ℓ]) ^ (2 * M).factorization ℓ :=
    pow_dvd_pow _ ((Nat.factorization_le_iff_dvd hM.ne' (by positivity)).mpr
      (dvd_mul_left M 2) ℓ)
  -- The adelic elements with components `w ℓ k` lie in the kernel of reduction modulo `M`.
  have hker (w : ∀ ℓ : Nat.Primes, Fin 5 → GL (Fin 2) ℤ_[ℓ])
      (hw : ∀ (ℓ : Nat.Primes) k, IsCongrOne ((ℓ : ℤ_[ℓ]) ^ (2 * M).factorization ℓ) (w ℓ k))
      (k : Fin 5) : (fun ℓ ↦ w ℓ k) ∈ (adelicReduction M).ker := by
    rw [MonoidHom.mem_ker, adelicReduction_eq_one_iff]
    exact fun ℓ ↦ (hw ℓ k).of_dvd (hdvd ℓ)
  have hx' : x = (List.ofFn fun k ↦ ⁅fun ℓ ↦ y ℓ k, fun ℓ ↦ z ℓ k⁆).prod := by
    refine funext fun ℓ ↦ (hxyz ℓ).trans ?_
    rw [Pi.list_prod_apply, List.map_ofFn]
    rfl
  rw [hx']
  refine list_prod_mem fun c hc ↦ ?_
  rcases List.mem_ofFn.mp hc with ⟨k, rfl⟩
  exact Subgroup.commutator_mono hH hH
    (Subgroup.commutator_mem_commutator (hker y hy k) (hker z hz k))

lemma exists_adelicSL_inf_ker_le_commutator
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) :
    ∃ N, 0 < N ∧ adelicSL ⊓ (adelicReduction N).ker ≤ ⁅H, H⁆ := by
  have hpos : 0 < adelicLevel ⊤ H := adelicLevel_pos ⊤ le_top (hH.preimage continuous_subtype_val)
  exact ⟨_, pow_pos (mul_pos two_pos hpos) 4,
    adelicSL_inf_ker_le_commutator hpos (ker_adelicReduction_adelicLevel_le hH)⟩

/-! ### Commutators at a single prime -/

lemma mulSingle_mem_adelicSL_of_det_eq_one (hx : det x = 1) : Pi.mulSingle ℓ x ∈ adelicSL := by
  rw [adelicSL, MonoidHom.mem_ker]
  refine funext fun p ↦ ?_
  by_cases hp : p = ℓ
  · subst hp
    simpa [adelicDet] using hx
  · simp [adelicDet, Pi.mulSingle_eq_of_ne hp]

variable (ℓ) in
lemma mulSingle_mem_adelicSL (hg : g ∈ adelicSL) : Pi.mulSingle ℓ (g ℓ) ∈ adelicSL :=
  mulSingle_mem_adelicSL_of_det_eq_one (det_apply_eq_one_of_mem_adelicSL ℓ hg)

lemma mulSingle_mem_commutator (hdet : K.map adelicDet = ⊤) (hℓ : (ℓ : ℕ) ≠ 2)
    (hSL : adelicSL ⊓ Subgroup.pi {p | p ≠ ℓ} (fun _ ↦ ⊥) ≤ K) (hx : det x = 1) :
    Pi.mulSingle ℓ x ∈ ⁅K, K⁆ := by
  have hsingle {g : GL (Fin 2) ℤ_[ℓ]} (hg : det g = 1) : Pi.mulSingle ℓ g ∈ K :=
    hSL ⟨mulSingle_mem_adelicSL_of_det_eq_one hg,
      fun p hp ↦ Subgroup.mem_bot.mpr (Pi.mulSingle_eq_of_ne hp _)⟩
  let u : ℤ_[ℓ]ˣ := (PadicInt.isUnit_one_add_pow (k := 0) fun _ ↦ hℓ).unit
  have hu : (1 : ℤ_[ℓ]) - u = -1 := by simp [u]
  -- Elements of `K` whose component at `ℓ` is `diag(u, 1)` or `diag(1, u)`.
  have hdiag (v w : ℤ_[ℓ]ˣ) (hvw : v * w = u) : ∃ d ∈ K, d ℓ = diagUnits v w := by
    rcases Subgroup.mem_map.mp (hdet ▸ Subgroup.mem_top (Pi.mulSingle ℓ u)) with ⟨d, hd, hdu⟩
    have hdℓ : det (d ℓ) = u := by simpa [adelicDet] using congrFun hdu ℓ
    refine ⟨d * Pi.mulSingle ℓ ((d ℓ)⁻¹ * diagUnits v w), mul_mem hd (hsingle ?_), ?_⟩
    · rw [map_mul, map_inv, hdℓ, det_diagUnits, hvw, inv_mul_cancel]
    · simp
  rcases hdiag u 1 (mul_one u) with ⟨dU, hdU, hdUℓ⟩
  rcases hdiag 1 u (one_mul u) with ⟨dL, hdL, hdLℓ⟩
  have hU (w : ℤ_[ℓ]) : Pi.mulSingle ℓ (upperRightHom w) ∈ ⁅K, K⁆ := by
    have h : Pi.mulSingle ℓ (upperRightHom w) =
        ⁅(Pi.mulSingle ℓ (upperRightHom (-w)) : ∀ p : Nat.Primes, GL (Fin 2) ℤ_[p]), dU⁆ := by
      refine funext fun p ↦ ?_
      by_cases hp : p = ℓ
      · subst hp
        rw [Pi.mulSingle_eq_same, commutatorElement_def, Pi.mul_apply, Pi.mul_apply, Pi.mul_apply,
          Pi.inv_apply, Pi.inv_apply, Pi.mulSingle_eq_same, hdUℓ, ← commutatorElement_def,
          commutatorElement_upperRightHom_diagUnits, hu, neg_one_mul, neg_neg]
      · simp [commutatorElement_def, Pi.mulSingle_eq_of_ne hp]
    rw [h]
    exact Subgroup.commutator_mem_commutator (hsingle (det_upperRightHom _)) hdU
  have hL (w : ℤ_[ℓ]) : Pi.mulSingle ℓ (lowerUnipotent w) ∈ ⁅K, K⁆ := by
    have h : Pi.mulSingle ℓ (lowerUnipotent w) =
        ⁅(Pi.mulSingle ℓ (lowerUnipotent (-w)) : ∀ p : Nat.Primes, GL (Fin 2) ℤ_[p]), dL⁆ := by
      refine funext fun p ↦ ?_
      by_cases hp : p = ℓ
      · subst hp
        rw [Pi.mulSingle_eq_same, commutatorElement_def, Pi.mul_apply, Pi.mul_apply, Pi.mul_apply,
          Pi.inv_apply, Pi.inv_apply, Pi.mulSingle_eq_same, hdLℓ, ← commutatorElement_def,
          commutatorElement_lowerUnipotent_diagUnits, hu, neg_one_mul, neg_neg]
      · simp [commutatorElement_def, Pi.mulSingle_eq_of_ne hp]
    rw [h]
    exact Subgroup.commutator_mem_commutator (hsingle (det_lowerUnipotent _)) hdL
  have hle : (Subgroup.closure (Set.range upperRightHom ∪ Set.range lowerUnipotent)).map
      (MonoidHom.mulSingle (fun p : Nat.Primes ↦ GL (Fin 2) ℤ_[p]) ℓ) ≤ ⁅K, K⁆ := by
    rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
    rintro _ (⟨w, rfl⟩ | ⟨w, rfl⟩)
    exacts [hU w, hL w]
  exact hle (Subgroup.mem_map_of_mem _
    (mem_closure_range_upperRightHom_union_range_lowerUnipotent (by
      simpa using congrArg Units.val hx)))

/-! ### Zywina's agreeable closure -/

lemma adelicScalars_le_center :
    adelicScalars ≤ Subgroup.center (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]) := by
  rintro _ ⟨u, rfl⟩
  refine Subgroup.mem_center_iff.mpr fun g ↦ funext fun ℓ ↦ ?_
  have h : scalar (Fin 2) (u ℓ) ∈ Subgroup.center (GL (Fin 2) ℤ_[ℓ]) :=
    center_eq_range_scalar (n := Fin 2) (R := ℤ_[ℓ]) ▸ ⟨u ℓ, rfl⟩
  exact Subgroup.mem_center_iff.mp h (g ℓ)

lemma adelicSL_inf_adelicAwayFrom_le_commutator
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) :
    adelicSL ⊓ adelicAwayFrom (agreeableClosurePrimes H) ≤ ⁅H, H⁆ :=
  (primeFactors_adelicLevel_subset_iff (fun _ hg ℓ ↦ mulSingle_mem_adelicSL ℓ hg)
    commutator_le_adelicSL (exists_adelicSL_inf_ker_le_commutator hH)).mp
      (Finset.subset_insert _ _)

/-- **Zywina's group has the same commutator subgroup as `H`** (Zywina, §8.3): for an open
subgroup `H` of `GL₂(ℤ̂)`, the group `ℤ̂ˣ · H · ∏_{ℓ ∉ P} GL₂(ℤ_ℓ)`, where `P` consists of `2` and
the primes dividing the level of `[H, H]`, has commutator subgroup `[H, H]`. -/
lemma commutator_adelicScalars_sup_sup_adelicAwayFrom
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) :
    ⁅adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H),
      adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H)⁆ = ⁅H, H⁆ := by
  have : (adelicAwayFrom (agreeableClosurePrimes H)).Normal := normal_adelicAwayFrom _
  refine le_antisymm (fun x hx ↦ ?_)
    (Subgroup.commutator_mono (le_sup_right.trans le_sup_left) (le_sup_right.trans le_sup_left))
  -- Modulo the elements trivial at the primes of `P`, the commutators are those of `H`, the
  -- scalars being central.
  have h₁ : ⁅adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H),
      adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H)⁆ ≤
        adelicAwayFrom (agreeableClosurePrimes H) ⊔ ⁅H, H⁆ := by
    rw [← QuotientGroup.comap_map_mk' (adelicAwayFrom (agreeableClosurePrimes H)) ⁅H, H⁆,
      ← Subgroup.map_le_iff_le_comap, Subgroup.map_commutator,
      Subgroup.map_sup (adelicScalars ⊔ H), QuotientGroup.map_mk'_self, sup_bot_eq,
      ← Subgroup.map_commutator, Subgroup.commutator_sup_of_le_center adelicScalars_le_center]
  have h₂ : x ∈ adelicAwayFrom (agreeableClosurePrimes H) ⊔ ⁅H, H⁆ := h₁ hx
  rw [← SetLike.mem_coe, Subgroup.normal_mul, Set.mem_mul] at h₂
  rcases h₂ with ⟨a, ha, k, hk, rfl⟩
  have haSL : a ∈ adelicSL := by
    have h : a * k * k⁻¹ ∈ adelicSL :=
      mul_mem (commutator_le_adelicSL hx) (inv_mem (commutator_le_adelicSL hk))
    rwa [mul_inv_cancel_right] at h
  exact mul_mem (adelicSL_inf_adelicAwayFrom_le_commutator hH ⟨haSL, ha⟩) hk

/-- **Zywina's group is agreeable** (Zywina, §8.3): for an open subgroup `H` of `GL₂(ℤ̂)` with
`det(H) = ℤ̂ˣ`, the group `ℤ̂ˣ · H · ∏_{ℓ ∉ P} GL₂(ℤ_ℓ)` is agreeable. -/
lemma isAgreeable_adelicScalars_sup_sup_adelicAwayFrom
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) (hdet : H.map adelicDet = ⊤) :
    IsAgreeable (adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H)) := by
  have hle : H ≤ adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H) :=
    le_sup_right.trans le_sup_left
  have hdet' : (adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H)).map adelicDet = ⊤ :=
    top_le_iff.mp (hdet ▸ Subgroup.map_mono hle)
  refine ⟨Subgroup.isOpen_mono hle hH, hdet', le_sup_left.trans le_sup_left, ?_⟩
  have hpos : 0 < adelicLevel ⊤ H := adelicLevel_pos ⊤ le_top (hH.preimage continuous_subtype_val)
  have hker : (adelicReduction (adelicLevel ⊤ H)).ker ≤ H := ker_adelicReduction_adelicLevel_le hH
  have hex₁ : ∃ N, 0 < N ∧ ⊤ ⊓ (adelicReduction N).ker ≤
      adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H) :=
    ⟨_, hpos, inf_le_right.trans (hker.trans hle)⟩
  have hex₂ : ∃ N, 0 < N ∧ adelicSL ⊓ (adelicReduction N).ker ≤
      (adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H)) ⊓ adelicSL :=
    ⟨_, hpos, fun _ hx ↦ ⟨hle (hker hx.2), hx.1⟩⟩
  ext ℓ
  rw [Finset.mem_erase, Finset.mem_erase]
  refine ⟨fun ⟨h2, hℓ⟩ ↦ ⟨h2, ?_⟩, fun ⟨h2, hℓ⟩ ↦ ⟨h2, ?_⟩⟩
  · -- An odd prime dividing the level of the group divides the level of the commutator subgroup,
    -- so it divides the level of the intersection with `SL₂(ℤ̂)`.
    have hℓK : ℓ ∈ (adelicLevel adelicSL ⁅H, H⁆).primeFactors :=
      (Finset.mem_insert.mp ((primeFactors_adelicLevel_subset_iff (fun _ _ _ ↦ Subgroup.mem_top _)
        le_top hex₁).mpr (inf_le_right.trans le_sup_right) hℓ)).resolve_left h2
    rcases (⟨⟨ℓ, Nat.prime_of_mem_primeFactors hℓ⟩, rfl⟩ : ∃ q : Nat.Primes, (q : ℕ) = ℓ) with
      ⟨q, rfl⟩
    refine Nat.mem_primeFactors.mpr ⟨q.prop, by_contra fun hnd ↦ ?_,
      (adelicLevel_pos_of_exists inf_le_right hex₂).ne'⟩
    have h₁ : adelicSL ⊓ Subgroup.pi {p | p ≠ q} (fun _ ↦ ⊥) ≤
        (adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H)) ⊓ adelicSL :=
      inf_pi_le_of_not_dvd inf_le_right hex₂ hnd
    refine not_dvd_adelicLevel (fun _ hg ℓ ↦ mulSingle_mem_adelicSL ℓ hg) commutator_le_adelicSL
      (exists_adelicSL_inf_ker_le_commutator hH) (fun x hx ↦ ?_) (Nat.dvd_of_mem_primeFactors hℓK)
    have hx' : x = Pi.mulSingle q (x q) := by
      refine funext fun p ↦ ?_
      by_cases h : p = q
      · rw [h, Pi.mulSingle_eq_same]
      · rw [Pi.mulSingle_eq_of_ne h]
        exact Subgroup.mem_bot.mp (hx.2 p h)
    rw [← commutator_adelicScalars_sup_sup_adelicAwayFrom hH, hx']
    exact mulSingle_mem_commutator hdet' h2 (h₁.trans inf_le_left)
      (det_apply_eq_one_of_mem_adelicSL q hx.1)
  · -- A prime dividing the level of the intersection with `SL₂(ℤ̂)` divides the level of the group.
    rcases (⟨⟨ℓ, Nat.prime_of_mem_primeFactors hℓ⟩, rfl⟩ : ∃ q : Nat.Primes, (q : ℕ) = ℓ) with
      ⟨q, rfl⟩
    refine Nat.mem_primeFactors.mpr ⟨q.prop, by_contra fun hnd ↦ ?_,
      (adelicLevel_pos_of_exists le_top hex₁).ne'⟩
    have h₁ : ⊤ ⊓ Subgroup.pi {p | p ≠ q} (fun _ ↦ ⊥) ≤
        adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H) :=
      inf_pi_le_of_not_dvd le_top hex₁ hnd
    exact not_dvd_adelicLevel (fun _ hg ℓ ↦ mulSingle_mem_adelicSL ℓ hg) inf_le_right hex₂
      (fun x hx ↦ ⟨h₁ ⟨Subgroup.mem_top x, hx.2⟩, hx.1⟩) (Nat.dvd_of_mem_primeFactors hℓ)

/-- **Zywina's group lies in every agreeable group containing `H`** (Zywina, proof of Prop. 8.1):
for an open subgroup `H` of `GL₂(ℤ̂)` and an agreeable `K ⊇ H`, the level of `K` has its prime
divisors in `P`, as `K ∩ SL₂(ℤ̂) ⊇ [H, H]`, so `K` contains `ℤ̂ˣ · H · ∏_{ℓ ∉ P} GL₂(ℤ_ℓ)`. -/
lemma adelicScalars_sup_sup_adelicAwayFrom_le
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) (hK : IsAgreeable K)
    (hHK : H ≤ K) : adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H) ≤ K := by
  have hpos : 0 < adelicLevel ⊤ K :=
    adelicLevel_pos ⊤ le_top (hK.isOpen.preimage continuous_subtype_val)
  have hker : (adelicReduction (adelicLevel ⊤ K)).ker ≤ K :=
    ker_adelicReduction_adelicLevel_le hK.isOpen
  have hex₁ : ∃ N, 0 < N ∧ ⊤ ⊓ (adelicReduction N).ker ≤ K := ⟨_, hpos, inf_le_right.trans hker⟩
  have hex₂ : ∃ N, 0 < N ∧ adelicSL ⊓ (adelicReduction N).ker ≤ K ⊓ adelicSL :=
    ⟨_, hpos, fun _ hx ↦ ⟨hker hx.2, hx.1⟩⟩
  have h₁ : adelicSL ⊓ adelicAwayFrom (agreeableClosurePrimes H) ≤ K ⊓ adelicSL :=
    fun _ hx ↦ ⟨Subgroup.commutator_le_self K (Subgroup.commutator_mono hHK hHK
      (adelicSL_inf_adelicAwayFrom_le_commutator hH hx)), hx.1⟩
  have h₂ : (adelicLevel adelicSL (K ⊓ adelicSL)).primeFactors ⊆ agreeableClosurePrimes H :=
    (primeFactors_adelicLevel_subset_iff (fun _ hg ℓ ↦ mulSingle_mem_adelicSL ℓ hg) inf_le_right
      hex₂).mpr h₁
  have h₃ : (adelicLevel ⊤ K).primeFactors ⊆ agreeableClosurePrimes H := by
    intro ℓ hℓ
    by_cases h2 : ℓ = 2
    · exact h2 ▸ Finset.mem_insert_self _ _
    · exact h₂ (Finset.mem_of_mem_erase (hK.primeFactors_erase_two ▸ Finset.mem_erase.mpr ⟨h2, hℓ⟩))
  exact sup_le (sup_le hK.adelicScalars_le hHK) ((le_inf le_top le_rfl).trans
    ((primeFactors_adelicLevel_subset_iff (fun _ _ _ ↦ Subgroup.mem_top _) le_top hex₁).mp h₃))

/-- **The agreeable closure is Zywina's group** (Zywina, Prop. 8.1): for an open subgroup `H` of
`GL₂(ℤ̂)` with `det(H) = ℤ̂ˣ`, the intersection of the agreeable subgroups containing `H` is
`ℤ̂ˣ · H · ∏_{ℓ ∉ P} GL₂(ℤ_ℓ)`, where `P` consists of `2` and the primes dividing the level of
`[H, H]` in `SL₂(ℤ̂)`. -/
lemma agreeableClosure_eq (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ])))
    (hdet : H.map adelicDet = ⊤) :
    agreeableClosure H = adelicScalars ⊔ H ⊔ adelicAwayFrom (agreeableClosurePrimes H) :=
  le_antisymm (sInf_le ⟨isAgreeable_adelicScalars_sup_sup_adelicAwayFrom hH hdet,
    le_sup_right.trans le_sup_left⟩)
    (le_sInf fun _ hK ↦ adelicScalars_sup_sup_adelicAwayFrom_le hH hK.1 hK.2)

/-- **The agreeable closure is agreeable** (Zywina, Prop. 8.1): for an open subgroup `H` of
`GL₂(ℤ̂)` with `det(H) = ℤ̂ˣ`, the agreeable closure is the smallest agreeable subgroup containing
`H`. -/
lemma isAgreeable_agreeableClosure (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ])))
    (hdet : H.map adelicDet = ⊤) : IsAgreeable (agreeableClosure H) :=
  agreeableClosure_eq hH hdet ▸ isAgreeable_adelicScalars_sup_sup_adelicAwayFrom hH hdet

/-- **The agreeable closure has the same commutator subgroup** (LMFDB `modcurve.agreeable`,
Zywina, Prop. 8.1): for an open subgroup `H` of `GL₂(ℤ̂)` with `det(H) = ℤ̂ˣ`, its agreeable
closure `H̃` satisfies `[H̃, H̃] = [H, H]`. -/
lemma commutator_agreeableClosure (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ])))
    (hdet : H.map adelicDet = ⊤) : ⁅agreeableClosure H, agreeableClosure H⁆ = ⁅H, H⁆ := by
  rw [agreeableClosure_eq hH hdet, commutator_adelicScalars_sup_sup_adelicAwayFrom hH]

lemma commutator_le_subgroupOf_agreeableClosure
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) (hdet : H.map adelicDet = ⊤) :
    commutator (agreeableClosure H) ≤ H.subgroupOf (agreeableClosure H) :=
  Subgroup.map_le_iff_le_comap.mp <| (Subgroup.map_subtype_commutator _).trans_le <|
    (commutator_agreeableClosure hH hdet).trans_le (Subgroup.commutator_le_self H)

/-- **`H` is normal in its agreeable closure** (LMFDB `modcurve.agreeable`, Zywina, Prop. 8.1), for
an open subgroup `H` of `GL₂(ℤ̂)` with `det(H) = ℤ̂ˣ`: it contains `[H̃, H̃] = [H, H]`. -/
lemma normal_subgroupOf_agreeableClosure
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) (hdet : H.map adelicDet = ⊤) :
    (H.subgroupOf (agreeableClosure H)).Normal :=
  Subgroup.Normal.of_commutator_le _ (commutator_le_subgroupOf_agreeableClosure hH hdet)

/-- **The agreeable quotient is abelian** (LMFDB `modcurve.agreeable`, Zywina, Prop. 8.1): for an
open subgroup `H` of `GL₂(ℤ̂)` with `det(H) = ℤ̂ˣ`, the quotient group `H̃ / H` is commutative, as
`[H̃, H̃] = [H, H] ≤ H`. -/
lemma isMulCommutative_agreeableQuotient
    (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) (hdet : H.map adelicDet = ⊤) :
    haveI : (H.subgroupOf (agreeableClosure H)).Normal := normal_subgroupOf_agreeableClosure hH hdet
    IsMulCommutative (AgreeableQuotient H) := by
  have : (H.subgroupOf (agreeableClosure H)).Normal := normal_subgroupOf_agreeableClosure hH hdet
  exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr
    (commutator_le_subgroupOf_agreeableClosure hH hdet)

/-- **The agreeable quotient is finite** (LMFDB `modcurve.agreeable`): an open subgroup of the
compact group `GL₂(ℤ̂)` has finite index in its agreeable closure. -/
lemma finite_agreeableQuotient (hH : IsOpen (H : Set (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))) :
    Finite (AgreeableQuotient H) := by
  have (ℓ : Nat.Primes) : CompactSpace (Matrix (Fin 2) (Fin 2) ℤ_[ℓ]) :=
    inferInstanceAs (CompactSpace (Fin 2 → Fin 2 → ℤ_[ℓ]))
  exact Subgroup.quotient_finite_of_isOpen' _ _ (Subgroup.isOpen_mono (le_agreeableClosure H) hH)
    (hH.preimage continuous_subtype_val)

end Matrix.GeneralLinearGroup
