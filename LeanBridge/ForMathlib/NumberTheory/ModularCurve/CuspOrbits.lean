import LeanBridge.ForMathlib.NumberTheory.ModularCurve.CuspWidth
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.NumberTheory.Cyclotomic.CyclotomicCharacter

/-!
# Galois orbits of the cusps of an open subgroup of `GL₂(ℤ̂)`

Let `H` be an open subgroup of `GL₂(ℤ̂)` with `det(H) = ℤ̂ˣ`, whose cusps are the double cosets
`±H \ GL₂(ℤ̂) / ⟨δ⟩` for `δ = [[1, 1], [0, 1]]` (`Matrix.GeneralLinearGroup.adelicCusps`). An
element `σ ∈ Gal(ℚ̄/ℚ)` acts on them by `±Hg⟨δ⟩ ↦ ±Hgχ(σ)⟨δ⟩`, where `χ(σ) = [[e, 0], [0, 1]]` and
`e ∈ ℤ̂ˣ` is the cyclotomic character of `σ`, given by `σ(ζ_N) = ζ_N ^ e` for every `N`. As in
`LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.Level`, `ℤ̂ˣ = ∏_ℓ ℤ_ℓˣ` and
`GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)`, and `e` is the family of Mathlib's `ℓ`-adic cyclotomic characters.

The action is well defined because `H` is open, which is not formalised. We define the Galois
orbits of the cusps as the classes of the equivalence relation generated by `c ~ c'` whenever
`c' = ±Hgχ(σ)⟨δ⟩` for a representative `g` of `c` and some `σ`; for open `H` these are exactly the
orbits of the action. The cusp orbits of the LMFDB are the multiset of the sizes of the orbits,
recorded here as the number of orbits of each size.

## Main definitions

* `Matrix.GeneralLinearGroup.adelicCyclotomicCharacter`: the cyclotomic character
  `Gal(ℚ̄/ℚ) → ℤ̂ˣ`.
* `Matrix.GeneralLinearGroup.adelicDiag`: the homomorphism `ℤ̂ˣ → GL₂(ℤ̂)`, `e ↦ [[e, 0], [0, 1]]`.
* `Matrix.GeneralLinearGroup.cuspGaloisRel`: the relation `c ~ ±Hgχ(σ)⟨δ⟩` on the cusps.
* `Matrix.GeneralLinearGroup.CuspOrbit` (LMFDB `modcurve.cusp_orbits`): the Galois orbits of the
  cusps.
* `Matrix.GeneralLinearGroup.cuspOrbitSize` (LMFDB `modcurve.cusp_orbits`): the size of an orbit.
* `Matrix.GeneralLinearGroup.numCuspOrbitsOfSize` (LMFDB `modcurve.cusp_orbits`): the number of
  orbits of a given size, the exponents of the multiset of cusp orbit sizes.
-/

namespace Matrix.GeneralLinearGroup

variable (H : Subgroup (∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ]))

/-- The **cyclotomic character** `Gal(ℚ̄/ℚ) → ℤ̂ˣ = ∏_ℓ ℤ_ℓˣ`, the family of the `ℓ`-adic cyclotomic
characters: `σ(ζ_N) = ζ_N ^ e` for every `N`, where `e` is the image of `σ`. -/
noncomputable def adelicCyclotomicCharacter :
    Gal(AlgebraicClosure ℚ/ℚ) →* ∀ ℓ : Nat.Primes, ℤ_[ℓ]ˣ :=
  (MonoidHom.pi fun ℓ : Nat.Primes ↦
    haveI : Fact (ℓ : ℕ).Prime := ⟨ℓ.2⟩
    cyclotomicCharacter (AlgebraicClosure ℚ) ℓ).comp
    { toFun σ := AlgEquiv.toRingEquiv σ
      map_one' := rfl
      map_mul' _ _ := rfl }

/-- The homomorphism `ℤ̂ˣ → GL₂(ℤ̂)`, `e ↦ [[e, 0], [0, 1]]`, componentwise over the primes `ℓ`. -/
noncomputable def adelicDiag : (∀ ℓ : Nat.Primes, ℤ_[ℓ]ˣ) →* ∀ ℓ : Nat.Primes, GL (Fin 2) ℤ_[ℓ] :=
  MonoidHom.pi fun ℓ ↦ (Units.map (diagonalRingHom (Fin 2) ℤ_[ℓ]).toMonoidHom).comp <|
    MulEquiv.piUnits.symm.toMonoidHom.comp <| (MonoidHom.mulSingle _ 0).comp <|
      Pi.evalMonoidHom _ ℓ

/-- The relation on the cusps `±H \ GL₂(ℤ̂) / ⟨δ⟩` of a subgroup `H` of `GL₂(ℤ̂)` relating a cusp
`±Hg⟨δ⟩` to `±Hgχ(σ)⟨δ⟩` for every `σ ∈ Gal(ℚ̄/ℚ)`, where `χ(σ) = [[e, 0], [0, 1]]` for the
cyclotomic character `e` of `σ`. For open `H` this is the graph of the Galois action. -/
def cuspGaloisRel (c c' : adelicCusps H) : Prop :=
  ∃ g σ, Quotient.mk _ g = c ∧ Quotient.mk _ (g * adelicDiag (adelicCyclotomicCharacter σ)) = c'

/-- The **Galois orbits of the cusps** (LMFDB `modcurve.cusp_orbits`) of a subgroup `H` of
`GL₂(ℤ̂)`: the classes of the cusps `±H \ GL₂(ℤ̂) / ⟨δ⟩` under the equivalence relation generated
by `±Hg⟨δ⟩ ~ ±Hgχ(σ)⟨δ⟩` for `σ ∈ Gal(ℚ̄/ℚ)`. For open `H` with `det(H) = ℤ̂ˣ` these are the orbits
of the Galois action on the cusps of `X_H`. -/
abbrev CuspOrbit : Type :=
  Quot (cuspGaloisRel H)

/-- The **size** (LMFDB `modcurve.cusp_orbits`) of a Galois orbit of cusps: the number of cusps in
it. -/
noncomputable def cuspOrbitSize (o : CuspOrbit H) : ℕ :=
  Nat.card {c : adelicCusps H // Quot.mk _ c = o}

/-- The **number of cusp orbits of size `n`** (LMFDB `modcurve.cusp_orbits`): the exponent of `n`
in the multiset of the sizes of the Galois orbits of the cusps, written `2^2⋅4^3` for two orbits of
size `2` and three of size `4`. -/
noncomputable def numCuspOrbitsOfSize (n : ℕ) : ℕ :=
  Nat.card {o : CuspOrbit H // cuspOrbitSize H o = n}

end Matrix.GeneralLinearGroup
