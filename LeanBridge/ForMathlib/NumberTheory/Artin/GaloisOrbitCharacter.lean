import LeanBridge.ForMathlib.NumberTheory.Artin.GaloisOrbit
import LeanBridge.ForMathlib.NumberTheory.ModularForms.Newform.ComplexAutomorphism
import LeanBridge.ForMathlib.NumberTheory.MulChar.GaloisAction
import Mathlib.Algebra.AlgebraicCard
import Mathlib.LinearAlgebra.Countable
import TauCeti.RepresentationTheory.CharacterTable.Determined
import TauCeti.RepresentationTheory.CharacterTable.Values

/-!
# Galois orbits of Artin representations through their characters

An automorphism `σ` of `ℂ` acts on the representations of a group `G` on a finite-dimensional
complex vector space `V` through their coefficients: the conjugate `ρ^σ` of `ρ` applies `σ` to the
matrix coefficients of `ρ` in a basis of `V`, which defines an action of `Aut(ℂ)`, and the
representations Galois conjugate to `ρ` (`Representation.IsGaloisConjugate`, LMFDB
`artin.galois_orbit`) are those isomorphic to some `ρ^σ`. The character of `ρ^σ` is `σ ∘ χ_ρ`.

For the representations whose kernel has finite index, such as the Artin representations and the
representations of a finite group, characters determine representations up to isomorphism (Tau
Ceti's `Representation.nonempty_equiv_of_character_eq`, through the finite quotient of `G` by the
two kernels). So `ρ'` is Galois conjugate to `ρ` exactly when `χ_ρ' = σ ∘ χ_ρ` for some
`σ ∈ Aut(ℂ)`. If the values of `χ_ρ` lie in a countable normal subfield `F` of `ℂ`, every element
of `Gal(F/ℚ)` extends to an automorphism of `ℂ`
(`IntermediateField.exists_algEquiv_apply_eq_of_countable`) and every automorphism of `ℂ`
restricts to one of `F`, so the Galois orbit of `ρ` is the orbit of `χ_ρ` under `Gal(F/ℚ)`. This
applies to two fields:

* the field `ℚ̄` of algebraic numbers in `ℂ`: the orbits of `Aut(ℂ)` are the orbits of
  `Gal(ℚ̄/ℚ)` of the LMFDB, acting on the coefficients;
* the field `ℚ(ζ_n)` generated by the `n`-th roots of unity, when `ρ(g) ^ n = 1` for every `g`,
  for instance for `n` the order of the image of `ρ`: the values of `χ_ρ`, sums of eigenvalues of
  `ρ(g)`, lie in `ℚ(ζ_n)`. Hence the action of `Aut(ℂ)` on `ρ` factors through the finite abelian
  Galois group `Gal(ℚ(ζ_n)/ℚ)`: `ρ^σ` and `ρ^σ'` are isomorphic as soon as `σ ζ_n = σ' ζ_n`.

The LMFDB's "pre-composition" would give `ρ(σ) ρ(·) ρ(σ)⁻¹ ≅ ρ` for `σ` in `Gal(ℚ̄/ℚ)`, so every
orbit would be a single class; the action is the action on coefficients.

## Main definitions

* `Representation.coordConj`: the `σ`-semilinear bijection of `V` applying `σ` to the coordinates in
  the basis `Module.finBasis ℂ V`.
* `Representation.galoisConj` (LMFDB `artin.galois_orbit`): the conjugate `ρ^σ` of a
  representation `ρ` by an automorphism `σ` of `ℂ`.

## Main results

* `Representation.character_galoisConj`: the character of `ρ^σ` is `σ ∘ χ_ρ`.
* `Representation.isGaloisConjugate_iff_exists_nonempty_equiv` (LMFDB `artin.galois_orbit`): the
  Galois conjugates of `ρ` are the representations isomorphic to some `ρ^σ`.
* `Representation.nonempty_equiv_of_character_eq_of_finiteIndex`: representations whose kernels have
  finite index are determined by their characters.
* `Representation.isGaloisConjugate_iff_exists_character_eq`: for such representations, `ρ'` is
  Galois conjugate to `ρ` if and only if `χ_ρ' = σ ∘ χ_ρ` for some automorphism `σ` of `ℂ`.
* `Representation.isGaloisConjugate_iff_exists_algEquiv`: if the values of `χ_ρ` lie in a countable
  normal subfield `F` of `ℂ`, the Galois orbit of `ρ` is the orbit of `χ_ρ` under `Gal(F/ℚ)`.
* `Representation.character_mem_adjoin_nth_roots`: if `ρ(g) ^ n = 1` for every `g`, the values of
  `χ_ρ` lie in `ℚ(ζ_n)`.
* `Representation.isGaloisConjugate_iff_exists_cyclotomic`,
  `Representation.nonempty_equiv_galoisConj_of_apply_eq`: the Galois orbit of `ρ` is the orbit of
  `χ_ρ` under `Gal(ℚ(ζ_n)/ℚ)`, and `ρ^σ` only depends on `σ ζ_n`.
* `Representation.isGaloisConjugate_iff_exists_algebraicClosure`: the Galois orbit of `ρ` is the
  orbit of `χ_ρ` under `Gal(ℚ̄/ℚ)`.
* `Representation.IsArtin.isGaloisConjugate_iff_exists_algebraicClosure` (LMFDB
  `artin.galois_orbit`): the orbits of `Aut(ℂ)` on the Artin representations are the orbits of
  `Gal(ℚ̄/ℚ)` acting on the coefficients.
* `Representation.IsArtin.isGaloisConjugate_iff_exists_cyclotomic` and
  `Representation.IsArtin.nonempty_equiv_galoisConj_of_apply_eq` (LMFDB `artin.galois_orbit`): the
  action on an Artin representation `π` factors through `Gal(ℚ(ζ_n)/ℚ)`, for `n` the order of the
  image of `π`.
-/

open IntermediateField Module

namespace Representation

variable {G V : Type*} [Group G] [AddCommGroup V] [Module ℂ V] {ρ ρ' : Representation ℂ G V}
  {n : ℕ}

lemma Equiv.isGaloisConjugate (e : ρ.Equiv ρ') : ρ.IsGaloisConjugate ρ' :=
  ⟨RingEquiv.refl ℂ, e.toLinearEquiv.toAddEquiv, e.toLinearEquiv.map_smul,
    fun g v ↦ LinearMap.congr_fun (e.isIntertwining' g) v⟩

lemma pow_index_ker_eq_one (g : G) : ρ g ^ ρ.ker.index = 1 :=
  (map_pow ρ g _).symm.trans <| MonoidHom.mem_ker.mp <| ρ.ker.pow_index_mem g

section Artin

variable {K : Type*} [Field K] [CharZero K] {π : Representation ℂ Gal(AlgebraicClosure K/K) V}

lemma IsArtin.finiteIndex_ker (h : π.IsArtin) : π.ker.FiniteIndex :=
  have : Finite (Gal(AlgebraicClosure K/K) ⧸ π.ker) := π.ker.quotient_finite_of_isOpen h.isOpen_ker
  Subgroup.finiteIndex_of_finite_quotient

lemma IsArtin.neZero_index_ker (h : π.IsArtin) : NeZero π.ker.index :=
  have : π.ker.FiniteIndex := h.finiteIndex_ker
  ⟨Subgroup.FiniteIndex.index_ne_zero⟩

end Artin

variable [FiniteDimensional ℂ V] (σ : ℂ ≃+* ℂ)

/-- The `σ`-semilinear bijection of `V` that applies an automorphism `σ` of `ℂ` to the coordinates
in the basis `Module.finBasis ℂ V`. It conjugates a representation `ρ` into its Galois conjugate
`ρ^σ` (`Representation.galoisConj`). -/
noncomputable def coordConj : V ≃+ V :=
  (finBasis ℂ V).equivFun.toAddEquiv.trans <|
    (AddEquiv.piCongrRight fun _ ↦ σ.toAddEquiv).trans (finBasis ℂ V).equivFun.symm.toAddEquiv

lemma coe_repr_coordConj (v : V) :
    ⇑((finBasis ℂ V).repr (coordConj σ v)) = σ ∘ (finBasis ℂ V).repr v :=
  (finBasis ℂ V).equivFun.apply_symm_apply _

lemma coordConj_smul (c : ℂ) (v : V) : coordConj σ (c • v) = σ c • coordConj σ v :=
  (finBasis ℂ V).repr.injective <| DFunLike.coe_injective <| by
    rw [coe_repr_coordConj, map_smul, map_smul, Finsupp.coe_smul, Finsupp.coe_smul,
      coe_repr_coordConj]
    ext i
    simp

lemma coordConj_symm_smul (c : ℂ) (v : V) :
    (coordConj σ).symm (c • v) = σ.symm c • (coordConj σ).symm v :=
  (coordConj σ).injective <| by
    rw [AddEquiv.apply_symm_apply, coordConj_smul, AddEquiv.apply_symm_apply,
      RingEquiv.apply_symm_apply]

variable (ρ) in
/-- The **Galois conjugate** `ρ^σ` (LMFDB `artin.galois_orbit`) of a representation `ρ` on a
finite-dimensional complex vector space `V` by an automorphism `σ` of `ℂ`: the representation whose
matrices in the basis `Module.finBasis ℂ V` are those of `ρ` with `σ` applied to their entries. This
is an action of the automorphisms of `ℂ` on the representations on `V`. The character of `ρ^σ` is
`σ ∘ χ_ρ` (`Representation.character_galoisConj`), and the representations Galois conjugate to `ρ`
are those isomorphic to some `ρ^σ`
(`Representation.isGaloisConjugate_iff_exists_nonempty_equiv`). -/
noncomputable def galoisConj : Representation ℂ G V :=
  (Matrix.toLinAlgEquiv (finBasis ℂ V)).toMonoidHom.comp <| σ.mapMatrix.toMonoidHom.comp <|
    (LinearMap.toMatrixAlgEquiv (finBasis ℂ V)).toMonoidHom.comp ρ

lemma galoisConj_apply (g : G) : ρ.galoisConj σ g = Matrix.toLin (finBasis ℂ V) (finBasis ℂ V)
    ((LinearMap.toMatrix (finBasis ℂ V) (finBasis ℂ V) (ρ g)).map σ) :=
  rfl

lemma galoisConj_refl : ρ.galoisConj (RingEquiv.refl ℂ) = ρ :=
  MonoidHom.ext fun g ↦ by
    rw [galoisConj_apply, RingEquiv.coe_refl, Matrix.map_id, Matrix.toLin_toMatrix]

lemma galoisConj_galoisConj (τ : ℂ ≃+* ℂ) :
    (ρ.galoisConj τ).galoisConj σ = ρ.galoisConj (τ.trans σ) :=
  MonoidHom.ext fun g ↦ by
    rw [galoisConj_apply, galoisConj_apply, galoisConj_apply, LinearMap.toMatrix_toLin,
      Matrix.map_map, RingEquiv.coe_trans]

/-- **The character of the Galois conjugate `ρ^σ` is `σ ∘ χ_ρ`**: the trace of a matrix with `σ`
applied to its entries is `σ` of its trace. -/
lemma character_galoisConj (g : G) : (ρ.galoisConj σ).character g = σ (ρ.character g) := by
  rw [character, character, LinearMap.trace_eq_matrix_trace ℂ (finBasis ℂ V),
    LinearMap.trace_eq_matrix_trace ℂ (finBasis ℂ V), AddMonoidHom.map_trace, galoisConj_apply,
    LinearMap.toMatrix_toLin]

lemma coordConj_apply (g : G) (v : V) : coordConj σ (ρ g v) = ρ.galoisConj σ g (coordConj σ v) :=
  (finBasis ℂ V).repr.injective <| DFunLike.coe_injective <| by
    ext i
    rw [coe_repr_coordConj, galoisConj_apply, Matrix.repr_toLin, coe_repr_coordConj,
      ← LinearMap.toMatrix_mulVec_repr (finBasis ℂ V) (finBasis ℂ V)]
    exact RingHom.map_mulVec σ.toRingHom _ _ i

variable {σ} in
lemma coordConj_symm_galoisConj (g : G) (v : V) :
    (coordConj σ).symm (ρ.galoisConj σ g v) = ρ g ((coordConj σ).symm v) :=
  (coordConj σ).injective <| by
    rw [AddEquiv.apply_symm_apply, coordConj_apply, AddEquiv.apply_symm_apply]

lemma isGaloisConjugate_galoisConj : ρ.IsGaloisConjugate (ρ.galoisConj σ) :=
  ⟨σ, coordConj σ, coordConj_smul σ, coordConj_apply σ⟩

lemma ker_galoisConj : (ρ.galoisConj σ).ker = ρ.ker :=
  (isGaloisConjugate_galoisConj σ).ker_eq

/-- **The Galois conjugates of `ρ` are the representations isomorphic to its conjugates `ρ^σ`**: if
a `σ`-semilinear bijection `f` intertwines `ρ` and `ρ'`, then `f` composed with the inverse of the
`σ`-semilinear `Representation.coordConj σ` is a linear isomorphism intertwining `ρ^σ` and `ρ'`. -/
lemma isGaloisConjugate_iff_exists_nonempty_equiv :
    ρ.IsGaloisConjugate ρ' ↔ ∃ σ : ℂ ≃+* ℂ, Nonempty ((ρ.galoisConj σ).Equiv ρ') := by
  refine ⟨fun ⟨σ, f, hf, hρ⟩ ↦ ?_, fun ⟨σ, ⟨e⟩⟩ ↦
    (isGaloisConjugate_galoisConj σ).trans e.isGaloisConjugate⟩
  let e : V ≃ₗ[ℂ] V :=
    { (coordConj σ).symm.trans f with
      map_smul' c v := by
        rw [AddEquiv.toFun_eq_coe, AddEquiv.trans_apply, coordConj_symm_smul, hf,
          RingEquiv.apply_symm_apply, RingHom.id_apply, AddEquiv.trans_apply] }
  refine ⟨σ, ⟨Equiv.mk e fun g ↦ LinearMap.ext fun v ↦ ?_⟩⟩
  rw [LinearMap.comp_apply, LinearMap.comp_apply]
  exact (congrArg f (coordConj_symm_galoisConj g v)).trans (hρ g _)

lemma IsGaloisConjugate.exists_character_eq (h : ρ.IsGaloisConjugate ρ') :
    ∃ σ : ℂ ≃+* ℂ, ∀ g, ρ'.character g = σ (ρ.character g) := by
  rcases isGaloisConjugate_iff_exists_nonempty_equiv.mp h with ⟨σ, ⟨e⟩⟩
  exact ⟨σ, fun g ↦ (congrFun (char_iso e) g).symm.trans (character_galoisConj σ g)⟩

/-- **The character values of a representation of exponent dividing `n` lie in `ℚ(ζ_n)`**, the
subfield of `ℂ` generated by the `n`-th roots of unity: if `ρ(g) ^ n = 1`, then `χ_ρ(g)` is a sum of
eigenvalues of `ρ(g)`, which are `n`-th roots of unity. -/
lemma character_mem_adjoin_nth_roots (hn : ∀ g, ρ g ^ n = 1) (g : G) :
    ρ.character g ∈ adjoin ℚ {b : ℂ | b ^ n = 1} :=
  char_mem_of_forall_pow_eq_one_mem (MonoidHom.id (End ℂ V)) (IsAlgClosed.splits _) (hn g)
    (A := (adjoin ℚ {b : ℂ | b ^ n = 1}).toSubalgebra.toSubring) fun _ hb ↦ subset_adjoin ℚ _ hb

variable [ρ.ker.FiniteIndex] [ρ'.ker.FiniteIndex] [NeZero n]

instance : (ρ.galoisConj σ).ker.FiniteIndex := by
  rw [ker_galoisConj]
  infer_instance

/-- **Representations whose kernels have finite index are determined by their characters**: two
such representations of `G` on finite-dimensional complex vector spaces factor through the finite
quotient of `G` by the intersection of their kernels, where characters determine representations
(Tau Ceti's `Representation.nonempty_equiv_of_character_eq`). -/
lemma nonempty_equiv_of_character_eq_of_finiteIndex (h : ρ.character = ρ'.character) :
    Nonempty (ρ.Equiv ρ') := by
  let N : Subgroup G := ρ.ker ⊓ ρ'.ker
  let π : Representation ℂ (G ⧸ N) V := QuotientGroup.lift N ρ inf_le_left
  let π' : Representation ℂ (G ⧸ N) V := QuotientGroup.lift N ρ' inf_le_right
  have hπ : π.character = π'.character := funext fun x ↦ by
    induction x using QuotientGroup.induction_on with
    | H g => exact congrFun h g
  rcases nonempty_equiv_of_character_eq π π' hπ with ⟨e⟩
  exact ⟨Equiv.mk e.toLinearEquiv fun g ↦ e.isIntertwining' (g : G ⧸ N)⟩

/-- **The character criterion for Galois conjugacy**: if the kernels of `ρ` and `ρ'` have finite
index, as for Artin representations, `ρ'` is Galois conjugate to `ρ` if and only if
`χ_ρ' = σ ∘ χ_ρ` for some automorphism `σ` of `ℂ`. -/
lemma isGaloisConjugate_iff_exists_character_eq :
    ρ.IsGaloisConjugate ρ' ↔ ∃ σ : ℂ ≃+* ℂ, ∀ g, ρ'.character g = σ (ρ.character g) := by
  refine ⟨IsGaloisConjugate.exists_character_eq, fun ⟨σ, hσ⟩ ↦ ?_⟩
  rcases nonempty_equiv_of_character_eq_of_finiteIndex (ρ := ρ.galoisConj σ) (ρ' := ρ') <|
    funext fun g ↦ (character_galoisConj σ g).trans (hσ g).symm with ⟨e⟩
  exact (isGaloisConjugate_galoisConj σ).trans e.isGaloisConjugate

/-- **Galois orbits through a normal subfield of `ℂ`**: if the kernels of `ρ` and `ρ'` have finite
index and the values of `χ_ρ` lie in a countable normal subfield `F` of `ℂ`, then `ρ'` is Galois
conjugate to `ρ` if and only if `χ_ρ' = τ ∘ χ_ρ` for some `τ ∈ Gal(F/ℚ)`: an automorphism of `ℂ`
restricts to `F`, and an automorphism of `F` extends to `ℂ`
(`IntermediateField.exists_algEquiv_apply_eq_of_countable`). -/
lemma isGaloisConjugate_iff_exists_algEquiv (F : IntermediateField ℚ ℂ) [Normal ℚ F] [Countable F]
    (hF : ∀ g, ρ.character g ∈ F) :
    ρ.IsGaloisConjugate ρ' ↔ ∃ τ : Gal(F/ℚ), ∀ g, ρ'.character g = τ ⟨ρ.character g, hF g⟩ := by
  rw [isGaloisConjugate_iff_exists_character_eq]
  refine ⟨fun ⟨σ, hσ⟩ ↦ ⟨σ.toRatAlgEquiv.restrictNormal F, fun g ↦ ?_⟩, fun ⟨τ, hτ⟩ ↦ ?_⟩
  · rw [hσ, AlgEquiv.restrictNormal_apply]
    rfl
  · rcases exists_algEquiv_apply_eq_of_countable (F.val.comp τ.toAlgHom) with ⟨σ, hσ⟩
    exact ⟨σ.toRingEquiv, fun g ↦ (hτ g).trans (hσ ⟨_, hF g⟩).symm⟩

/-- **Galois orbits through `Gal(ℚ(ζ_n)/ℚ)`**: if `ρ(g) ^ n = 1` for every `g` and the kernels of
`ρ` and `ρ'` have finite index, then `ρ'` is Galois conjugate to `ρ` if and only if `χ_ρ' = τ ∘ χ_ρ`
for some `τ` in the finite abelian Galois group `Gal(ℚ(ζ_n)/ℚ)`. -/
lemma isGaloisConjugate_iff_exists_cyclotomic (hn : ∀ g, ρ g ^ n = 1) : ρ.IsGaloisConjugate ρ' ↔
    ∃ τ : Gal(adjoin ℚ {b : ℂ | b ^ n = 1}/ℚ), ∀ g, ρ'.character g =
      τ ⟨ρ.character g, character_mem_adjoin_nth_roots hn g⟩ := by
  have : Normal ℚ (adjoin ℚ {b : ℂ | b ^ n = 1}) :=
    (IsCyclotomicExtension.isGalois {n} ℚ _).to_normal
  have : Countable (adjoin ℚ {b : ℂ | b ^ n = 1}) := Finsupp.Countable.of_moduleFinite (R := ℚ)
  exact isGaloisConjugate_iff_exists_algEquiv _ _

variable {σ} in
/-- **The Galois action factors through `Gal(ℚ(ζ_n)/ℚ)`**: if `ρ(g) ^ n = 1` for every `g`, the
kernel of `ρ` has finite index and `σ ζ = σ' ζ` for a primitive `n`-th root of unity `ζ`, so that
`σ` and `σ'` agree on `ℚ(ζ_n)`, then the conjugates `ρ^σ` and `ρ^σ'` are isomorphic. -/
lemma nonempty_equiv_galoisConj_of_apply_eq (hn : ∀ g, ρ g ^ n = 1) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ n) {σ' : ℂ ≃+* ℂ} (h : σ ζ = σ' ζ) :
    Nonempty ((ρ.galoisConj σ).Equiv (ρ.galoisConj σ')) := by
  have hF : σ.toRatAlgEquiv.toAlgHom.comp (adjoin ℚ {b : ℂ | b ^ n = 1}).val =
      σ'.toRatAlgEquiv.toAlgHom.comp (adjoin ℚ {b : ℂ | b ^ n = 1}).val :=
    adjoin_algHom_ext ℚ fun x (hx : x ^ n = 1) ↦ by
      rcases hζ.eq_pow_of_pow_eq_one hx with ⟨i, -, rfl⟩
      simp [h]
  exact nonempty_equiv_of_character_eq_of_finiteIndex <| funext fun g ↦ by
    rw [character_galoisConj, character_galoisConj]
    exact DFunLike.congr_fun hF ⟨_, character_mem_adjoin_nth_roots hn g⟩

lemma character_mem_algebraicClosure (g : G) : ρ.character g ∈ algebraicClosure ℚ ℂ :=
  have : NeZero ρ.ker.index := ⟨Subgroup.FiniteIndex.index_ne_zero⟩
  le_algebraicClosure ℚ ℂ _ (character_mem_adjoin_nth_roots pow_index_ker_eq_one g)

/-- **Galois orbits through `Gal(ℚ̄/ℚ)`**: if the kernels of `ρ` and `ρ'` have finite index, then
`ρ'` is Galois conjugate to `ρ` if and only if `χ_ρ' = τ ∘ χ_ρ` for some `τ ∈ Gal(ℚ̄/ℚ)`, where `ℚ̄`
is the field of algebraic numbers in `ℂ`, which is countable and contains the values of `χ_ρ`. -/
lemma isGaloisConjugate_iff_exists_algebraicClosure : ρ.IsGaloisConjugate ρ' ↔
    ∃ τ : Gal(algebraicClosure ℚ ℂ/ℚ), ∀ g, ρ'.character g =
      τ ⟨ρ.character g, character_mem_algebraicClosure g⟩ := by
  have : Countable (algebraicClosure ℚ ℂ) := Set.countable_coe_iff.mpr <|
    (Algebraic.countable ℚ ℂ).mono fun _ hx ↦ mem_algebraicClosure_iff.mp hx
  exact isGaloisConjugate_iff_exists_algEquiv _ _

section Artin

variable {K : Type*} [Field K] [CharZero K] {π π' : Representation ℂ Gal(AlgebraicClosure K/K) V}

lemma IsArtin.character_mem_algebraicClosure (h : π.IsArtin) (g : Gal(AlgebraicClosure K/K)) :
    π.character g ∈ algebraicClosure ℚ ℂ :=
  have : π.ker.FiniteIndex := h.finiteIndex_ker
  Representation.character_mem_algebraicClosure g

/-- **The Galois orbits of Artin representations are the orbits of `Gal(ℚ̄/ℚ)`** (LMFDB
`artin.galois_orbit`): an Artin representation `π'` is Galois conjugate to an Artin representation
`π`, through an automorphism of `ℂ` acting on the coefficients, if and only if `χ_π' = τ ∘ χ_π` for
some `τ ∈ Gal(ℚ̄/ℚ)`, where `ℚ̄` is the field of algebraic numbers in `ℂ`. -/
lemma IsArtin.isGaloisConjugate_iff_exists_algebraicClosure (h : π.IsArtin) (h' : π'.IsArtin) :
    π.IsGaloisConjugate π' ↔ ∃ τ : Gal(algebraicClosure ℚ ℂ/ℚ), ∀ g, π'.character g =
      τ ⟨π.character g, h.character_mem_algebraicClosure g⟩ :=
  have : π.ker.FiniteIndex := h.finiteIndex_ker
  have : π'.ker.FiniteIndex := h'.finiteIndex_ker
  Representation.isGaloisConjugate_iff_exists_algebraicClosure

/-- **The Galois action on an Artin representation factors through a cyclotomic field** (LMFDB
`artin.galois_orbit`), the finite abelian extension `ℚ(ζ_n)` of `ℚ` for `n` the order of the image
of the Artin representation `π`: an Artin representation `π'` is Galois conjugate to `π` if and
only if `χ_π' = τ ∘ χ_π` for some `τ ∈ Gal(ℚ(ζ_n)/ℚ)`. -/
lemma IsArtin.isGaloisConjugate_iff_exists_cyclotomic (h : π.IsArtin) (h' : π'.IsArtin) :
    π.IsGaloisConjugate π' ↔ ∃ τ : Gal(adjoin ℚ {b : ℂ | b ^ π.ker.index = 1}/ℚ), ∀ g,
      π'.character g = τ ⟨π.character g, character_mem_adjoin_nth_roots pow_index_ker_eq_one g⟩ :=
  have : π.ker.FiniteIndex := h.finiteIndex_ker
  have : π'.ker.FiniteIndex := h'.finiteIndex_ker
  have : NeZero π.ker.index := h.neZero_index_ker
  Representation.isGaloisConjugate_iff_exists_cyclotomic pow_index_ker_eq_one

variable {σ} in
/-- **The Galois conjugate of an Artin representation only depends on the action on `ζ_n`**
(LMFDB `artin.galois_orbit`), for `n` the order of the image of the Artin representation `π`: if
`σ ζ = σ' ζ` for a primitive `n`-th root of unity `ζ`, then `π^σ` and `π^σ'` are isomorphic, so the
action of `Aut(ℂ)` on `π` factors through `Gal(ℚ(ζ_n)/ℚ)`. -/
lemma IsArtin.nonempty_equiv_galoisConj_of_apply_eq (h : π.IsArtin) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ π.ker.index) {σ' : ℂ ≃+* ℂ} (hσ : σ ζ = σ' ζ) :
    Nonempty ((π.galoisConj σ).Equiv (π.galoisConj σ')) :=
  have : π.ker.FiniteIndex := h.finiteIndex_ker
  have : NeZero π.ker.index := h.neZero_index_ker
  Representation.nonempty_equiv_galoisConj_of_apply_eq pow_index_ker_eq_one hζ hσ

end Artin

end Representation
