import TauCeti.NumberTheory.NumberField.Ideal.IntegersRat

/-!
# The absolute norm of a height one prime of `𝓞 ℚ`

A height one prime `v` of the ring of integers `𝓞 ℚ` of `ℚ` is generated by a rational prime `p`
(Mathlib's `Rat.HeightOneSpectrum.natGenerator`), which is its absolute norm (Tau Ceti's
`Rat.HeightOneSpectrum.absNorm_asIdeal`): the absolute norm of `v` is a prime number.
-/

open IsDedekindDomain NumberField

namespace Rat.HeightOneSpectrum

lemma prime_absNorm_asIdeal (v : HeightOneSpectrum (𝓞 ℚ)) : (Ideal.absNorm v.asIdeal).Prime :=
  absNorm_asIdeal v ▸ prime_natGenerator v

end Rat.HeightOneSpectrum
