import Mathlib.Algebra.Ring.Aut
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Coarse subgroups of the level `N` enhanced group of a polarized quaternion order

Let `O` be an order in a quaternion algebra `B` over `ℚ` (indefinite and division for the LMFDB),
that is, a subring of `B` which is a `ℤ`-lattice, and let `μ ∈ B^×` be a polarization of `O`. The
normalizer `N_{B^×}(O) = {γ ∈ B^× : γ⁻¹ O γ = O}` contains the central subgroup `ℚ^×`, and
`Aut_{±μ}(O) = {γ ∈ N_{B^×}(O)/ℚ^× : γ⁻¹ μ γ = ±μ}`. It acts on `O` by conjugation, hence on `O^×`
and on `(O/NO)^×` for every positive integer `N`. The map
`f : Aut_{±μ}(O) ⋉ O^× → N_{B^×}(O)/ℚ^×`, `(w, x) ↦ w x` is a homomorphism, and a subgroup `H` of
`Aut_{±μ}(O) ⋉ (O/NO)^×` is **coarse** if it contains the image of the kernel of `f` under
reduction modulo `N`. The kernel of `f` consists of the pairs `(x⁻¹, x)` for the units `x` of `O`
whose class lies in `Aut_{±μ}(O)` (`Subalgebra.isCoarseSubgroup_iff`); among them is `(1, -1)`, so a
coarse subgroup contains `-1` (`Subalgebra.IsCoarseSubgroup.inl_neg_one_mem`), as for modular
curves.

The definitions need neither that `B` is a quaternion algebra nor that `O` is an order nor that `μ`
is a polarization: `B` is any `ℚ`-algebra, `O` any subring of `B` and `μ` any element of `B`. The
semidirect products are Mathlib's `O^× ⋊ Aut_{±μ}(O)` and `(O/NO)^× ⋊ Aut_{±μ}(O)`, where an element
`⟨x, w⟩` is the product `x w` and `w` acts on `x` by `x ↦ w x w⁻¹`; the LMFDB writes the same groups
as `Aut_{±μ}(O) ⋉ O^×` and `Aut_{±μ}(O) ⋉ (O/NO)^×`. The quotient `O/NO` is the quotient of `O` by
the two-sided ideal generated by `N`.

## Main definitions

* `Subalgebra.unitsNormalizer`: the normalizer `N_{B^×}(O)` of `O` in `B^×`.
* `Subalgebra.NormalizerModScalars`: the group `N_{B^×}(O)/ℚ^×`.
* `Subalgebra.autPmMu` (LMFDB `shimcurve.aut_pm_mu_o`): the group `Aut_{±μ}(O)`.
* `Subalgebra.EnhancedGroupMod`: the group `Aut_{±μ}(O) ⋉ (O/NO)^×`.
* `Subalgebra.autPmMuMul`: the homomorphism `f : Aut_{±μ}(O) ⋉ O^× → N_{B^×}(O)/ℚ^×`.
* `Subalgebra.autPmMuReduction`: reduction modulo `N`, from `Aut_{±μ}(O) ⋉ O^×` to
  `Aut_{±μ}(O) ⋉ (O/NO)^×`.
* `Subalgebra.IsCoarseSubgroup` (LMFDB `shimcurve.is_coarse`).

## Main results

* `Subalgebra.isCoarseSubgroup_iff`: `H` is coarse if and only if it contains the reduction of
  `(x⁻¹, x)` for every unit `x` of `O` whose class lies in `Aut_{±μ}(O)`.
* `Subalgebra.IsCoarseSubgroup.inl_neg_one_mem`: a coarse subgroup contains `-1`.
-/

variable {R : Type*} [Ring R] (N : ℕ)

/-- The automorphism of `Mˣ` induced by an automorphism of a monoid `M`, as a homomorphism. -/
private def unitsMulAut {M : Type*} [Monoid M] : MulAut M →* MulAut Mˣ where
  toFun e := Units.mapEquiv e
  map_one' := rfl
  map_mul' _ _ := rfl

instance : (Ideal.span {(N : R)}).IsTwoSided where
  mul_mem_of_left b ha := by
    rcases Ideal.mem_span_singleton'.mp ha with ⟨a, rfl⟩
    exact Ideal.mem_span_singleton'.mpr
      ⟨a * b, by rw [mul_assoc, mul_assoc, (Nat.cast_commute N b).eq]⟩

/-- The automorphism of `R/NR` induced by a ring automorphism of a ring `R`, as a homomorphism. -/
private noncomputable def quotientNatCastAut : RingAut R →* RingAut (R ⧸ Ideal.span {(N : R)}) where
  toFun σ := Ideal.quotientEquiv _ _ σ (by rw [Ideal.map_span, Set.image_singleton, map_natCast])
  map_one' := RingEquiv.ext fun x ↦ Quotient.inductionOn' x fun _ ↦ rfl
  map_mul' _ _ := RingEquiv.ext fun x ↦ Quotient.inductionOn' x fun _ ↦ rfl

open Ideal.Quotient in
/-- Reduction modulo `NR` on the units of a ring `R`, `R^× → (R/NR)^×`. -/
private noncomputable def unitsQuotientNatCast : Rˣ →* (R ⧸ Ideal.span {(N : R)})ˣ :=
  Units.map (mk _).toMonoidHom

namespace Subalgebra

variable {B : Type*} [Ring B] (O : Subalgebra ℤ B) {γ : Bˣ} {x : B} (u : Oˣ)

/-- The **normalizer** `N_{B^×}(O) = {γ ∈ B^× : γ⁻¹ O γ = O}` of a subring `O` of a ring `B` in
`B^×`. -/
def unitsNormalizer : Subgroup Bˣ where
  carrier := {γ | ∀ x, x ∈ O ↔ (γ : B) * x * ↑γ⁻¹ ∈ O}
  one_mem' x := by
    simp
  mul_mem' {γ δ} hγ hδ x := by
    rw [hδ, hγ]
    simp [mul_assoc]
  inv_mem' {γ} hγ x := by
    simpa [mul_assoc] using (hγ (↑γ⁻¹ * x * γ)).symm

variable {O}

lemma conj_mem_of_mem_unitsNormalizer (hγ : γ ∈ O.unitsNormalizer) (hx : x ∈ O) :
    (γ : B) * x * ↑γ⁻¹ ∈ O :=
  (hγ x).mp hx

lemma inv_conj_mem_of_mem_unitsNormalizer (hγ : γ ∈ O.unitsNormalizer) (hx : x ∈ O) :
    (↑γ⁻¹ : B) * x * γ ∈ O := by
  simpa using conj_mem_of_mem_unitsNormalizer (inv_mem hγ) hx

variable (O)

/-- Conjugation `x ↦ γ x γ⁻¹` by an element `γ` of the normalizer `N_{B^×}(O)`, as a ring
automorphism of `O`. -/
noncomputable def unitsNormalizerConj : O.unitsNormalizer →* RingAut O where
  toFun γ :=
    { toFun x := ⟨(γ : Bˣ) * x * ↑(γ : Bˣ)⁻¹, conj_mem_of_mem_unitsNormalizer γ.2 x.2⟩
      invFun x := ⟨↑(γ : Bˣ)⁻¹ * x * (γ : Bˣ), inv_conj_mem_of_mem_unitsNormalizer γ.2 x.2⟩
      left_inv x := Subtype.ext (by simp [mul_assoc])
      right_inv x := Subtype.ext (by simp [mul_assoc])
      map_mul' x y := Subtype.ext (by simp [mul_assoc])
      map_add' x y := Subtype.ext (by simp [mul_add, add_mul]) }
  map_one' := by
    ext x
    simp
  map_mul' γ δ := by
    ext x
    simp [mul_assoc]

@[simp]
lemma coe_unitsNormalizerConj_apply (δ : O.unitsNormalizer) (y : O) :
    (O.unitsNormalizerConj δ y : B) = (δ : Bˣ) * y * ↑(δ : Bˣ)⁻¹ :=
  rfl

/-- The units of `O` lie in its normalizer `N_{B^×}(O)`. -/
def unitsToNormalizer : Oˣ →* O.unitsNormalizer :=
  (Units.map O.val.toMonoidHom).codRestrict O.unitsNormalizer fun v y ↦
    ⟨fun hy ↦ mul_mem (mul_mem (v : O).2 hy) (↑v⁻¹ : O).2, fun hy ↦ by
      let v' : Bˣ := Units.map O.val.toMonoidHom v
      have h : (↑v'⁻¹ : B) * (v' * y * ↑v'⁻¹) * v' = y := by
        simp [mul_assoc]
      exact h ▸ mul_mem (mul_mem (↑v⁻¹ : O).2 hy) (v : O).2⟩

@[simp]
lemma coe_unitsToNormalizer_apply : ((O.unitsToNormalizer u : Bˣ) : B) = (u : O) :=
  rfl

variable [Algebra ℚ B] (μ : B)

/-- The subgroup `ℚ^×` of the normalizer `N_{B^×}(O)`: the nonzero rational scalars, which are
central in `B^×`. -/
def normalizerRatUnits : Subgroup O.unitsNormalizer :=
  (Units.map (algebraMap ℚ B : ℚ →* B)).range.subgroupOf O.unitsNormalizer

instance : O.normalizerRatUnits.Normal :=
  Subgroup.normal_of_le_center fun γ ⟨q, hq⟩ ↦ Subgroup.mem_center_iff.mpr fun _ ↦ by
    have h : (γ : Bˣ) = Units.map (algebraMap ℚ B : ℚ →* B) q := hq.symm
    refine Subtype.ext (Units.ext ?_)
    rw [Subgroup.coe_mul, Subgroup.coe_mul, Units.val_mul, Units.val_mul, h, Units.coe_map,
      MonoidHom.coe_ofClass]
    exact (Algebra.commutes (q : ℚ) _).symm

/-- The group `N_{B^×}(O)/ℚ^×`. -/
abbrev NormalizerModScalars : Type _ :=
  O.unitsNormalizer ⧸ O.normalizerRatUnits

/-- Conjugation by the elements of `N_{B^×}(O)/ℚ^×`, as ring automorphisms of `O`: the scalars act
trivially. -/
noncomputable def normalizerModScalarsConj : O.NormalizerModScalars →* RingAut O :=
  QuotientGroup.lift _ O.unitsNormalizerConj fun γ ⟨q, hq⟩ ↦ by
    refine MonoidHom.mem_ker.mpr (RingEquiv.ext fun x ↦ Subtype.ext ?_)
    have h : (γ : Bˣ) = Units.map (algebraMap ℚ B : ℚ →* B) q := hq.symm
    rw [coe_unitsNormalizerConj_apply, h, Units.coe_map, Units.coe_map_inv, MonoidHom.coe_ofClass,
      Algebra.commutes, mul_assoc, ← map_mul, Units.mul_inv, map_one, mul_one]
    rfl

/-- The class in `N_{B^×}(O)/ℚ^×` of a unit of `O`. -/
noncomputable def unitsToNormalizerModScalars : Oˣ →* O.NormalizerModScalars :=
  (QuotientGroup.mk' _).comp O.unitsToNormalizer

lemma unitsToNormalizerModScalars_conj (w : O.NormalizerModScalars) :
    O.unitsToNormalizerModScalars (Units.mapEquiv (O.normalizerModScalarsConj w).toMulEquiv u) =
    w * O.unitsToNormalizerModScalars u * w⁻¹ := by
  induction w using QuotientGroup.induction_on with | H γ => ?_
  rw [unitsToNormalizerModScalars, MonoidHom.comp_apply, MonoidHom.comp_apply,
    QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, ← QuotientGroup.mk_mul,
    ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
  congr 1
  ext
  rfl

/-- The elements `γ` of `N_{B^×}(O)` with `γ⁻¹ μ γ = ±μ`. -/
def normalizerPmMu : Subgroup O.unitsNormalizer where
  carrier := {γ | ↑(γ : Bˣ)⁻¹ * μ * (γ : Bˣ) = μ ∨ ↑(γ : Bˣ)⁻¹ * μ * (γ : Bˣ) = -μ}
  one_mem' := Or.inl (by simp)
  mul_mem' {γ δ} hγ hδ := by
    have h : (↑((γ * δ : O.unitsNormalizer) : Bˣ)⁻¹ : B) * μ * ((γ * δ : O.unitsNormalizer) : Bˣ) =
        ↑(δ : Bˣ)⁻¹ * (↑(γ : Bˣ)⁻¹ * μ * (γ : Bˣ)) * (δ : Bˣ) := by
      simp [mul_assoc]
    simp only [Set.mem_ofPred_eq, h]
    rcases hγ with hγ | hγ <;> rcases hδ with hδ | hδ <;> simp [hγ, hδ]
  inv_mem' {γ} hγ := by
    have h : ((γ : Bˣ) : B) * (↑(γ : Bˣ)⁻¹ * μ * (γ : Bˣ)) * ↑(γ : Bˣ)⁻¹ = μ := by
      simp [mul_assoc]
    rcases hγ with hγ | hγ <;> rw [hγ] at h
    · exact Or.inl h
    · rw [mul_neg, neg_mul] at h
      exact Or.inr (neg_eq_iff_eq_neg.mp h)

/-- The group `Aut_{±μ}(O) = {γ ∈ N_{B^×}(O)/ℚ^× : γ⁻¹ μ γ = ±μ}` (LMFDB `shimcurve.aut_pm_mu_o`)
of the automorphisms of `O`, up to the scalars, preserving `μ` up to sign. The LMFDB takes `O` an
order in an indefinite division quaternion algebra `B` over `ℚ` and `μ` a polarization of `O`. -/
def autPmMu : Subgroup O.NormalizerModScalars :=
  (O.normalizerPmMu μ).map (QuotientGroup.mk' _)

/-- The action of `Aut_{±μ}(O)` on `O^×` by conjugation. -/
noncomputable def autPmMuUnitsAction : O.autPmMu μ →* MulAut Oˣ :=
  ((unitsMulAut.comp (RingAut.toMulAut _)).comp O.normalizerModScalarsConj).comp
    (O.autPmMu μ).subtype

/-- The action of `Aut_{±μ}(O)` on `(O/NO)^×` by conjugation. -/
noncomputable def autPmMuQuotientUnitsAction : O.autPmMu μ →* MulAut (O ⧸ Ideal.span {(N : O)})ˣ :=
  (((unitsMulAut.comp (RingAut.toMulAut _)).comp (quotientNatCastAut N)).comp
    O.normalizerModScalarsConj).comp (O.autPmMu μ).subtype

/-- The group `Aut_{±μ}(O) ⋉ (O/NO)^×`, Mathlib's semidirect product `(O/NO)^× ⋊ Aut_{±μ}(O)`. Its
subgroups are the images of the open subgroups of level dividing `N` of the enhanced group
`Aut_{±μ}(O) ⋉ Ô^×` of the LMFDB, those containing the kernel of reduction modulo `N`. -/
abbrev EnhancedGroupMod : Type _ :=
  (O ⧸ Ideal.span {(N : O)})ˣ ⋊[O.autPmMuQuotientUnitsAction N μ] O.autPmMu μ

variable (H : Subgroup (O.EnhancedGroupMod N μ))

/-- The homomorphism `f : Aut_{±μ}(O) ⋉ O^× → N_{B^×}(O)/ℚ^×`, `(w, x) ↦ w x`, here on Mathlib's
`O^× ⋊ Aut_{±μ}(O)`, where `⟨x, w⟩` is the product `x w`. -/
noncomputable def autPmMuMul : Oˣ ⋊[O.autPmMuUnitsAction μ] O.autPmMu μ →* O.NormalizerModScalars :=
  SemidirectProduct.lift O.unitsToNormalizerModScalars (O.autPmMu μ).subtype fun g ↦
    MonoidHom.ext fun v ↦ O.unitsToNormalizerModScalars_conj v g

/-- Reduction modulo `N`, from `Aut_{±μ}(O) ⋉ O^×` to `Aut_{±μ}(O) ⋉ (O/NO)^×`. -/
noncomputable def autPmMuReduction :
    Oˣ ⋊[O.autPmMuUnitsAction μ] O.autPmMu μ →* O.EnhancedGroupMod N μ :=
  SemidirectProduct.map (unitsQuotientNatCast N) (MonoidHom.id _) fun _ ↦
    MonoidHom.ext fun _ ↦ Units.ext rfl

/-- A subgroup `H` of `Aut_{±μ}(O) ⋉ (O/NO)^×` is **coarse** (LMFDB `shimcurve.is_coarse`) if it
contains the image under reduction modulo `N` of the kernel of the homomorphism
`f : Aut_{±μ}(O) ⋉ O^× → N_{B^×}(O)/ℚ^×`, `(w, x) ↦ w x`. -/
def IsCoarseSubgroup : Prop :=
  (O.autPmMuMul μ).ker.map (O.autPmMuReduction N μ) ≤ H

/-- **A subgroup `H` is coarse if and only if it contains the reduction of the pair `(x⁻¹, x)`**,
Mathlib's `⟨x, x⁻¹⟩`, for every unit `x` of `O` whose class lies in `Aut_{±μ}(O)`: these pairs make
up the kernel of `f`. -/
lemma isCoarseSubgroup_iff : O.IsCoarseSubgroup N μ H ↔ ∀ (y : Oˣ)
    (hy : (O.unitsToNormalizerModScalars y)⁻¹ ∈ O.autPmMu μ),
    O.autPmMuReduction N μ ⟨y, ⟨_, hy⟩⟩ ∈ H := by
  refine ⟨fun h y hy ↦ h ⟨⟨y, ⟨_, hy⟩⟩, MonoidHom.mem_ker.mpr (mul_inv_cancel _), rfl⟩, ?_⟩
  rintro h - ⟨⟨y, w, hw⟩, hyw, rfl⟩
  have h₁ : w = (O.unitsToNormalizerModScalars y)⁻¹ := eq_inv_of_mul_eq_one_right hyw
  subst h₁
  exact h y hw

variable {N O μ H} in
/-- **A coarse subgroup contains `-1`**, the reduction of `(1, -1)`: as `-1` is a scalar, its class
in `N_{B^×}(O)/ℚ^×` is trivial, so `(1, -1)` lies in the kernel of `f`. -/
lemma IsCoarseSubgroup.inl_neg_one_mem (h : O.IsCoarseSubgroup N μ H) :
    SemidirectProduct.inl (-1) ∈ H := by
  have h₁ : O.unitsToNormalizerModScalars (-1) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr ⟨-1, Units.ext (by simp)⟩
  convert (O.isCoarseSubgroup_iff N μ H).mp h (-1) (by simp [h₁]) using 1
  ext
  · simp [autPmMuReduction, unitsQuotientNatCast]
  · simp [autPmMuReduction, h₁]

end Subalgebra
