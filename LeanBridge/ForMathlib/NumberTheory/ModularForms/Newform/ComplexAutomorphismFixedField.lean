import LeanBridge.ForMathlib.NumberTheory.ModularForms.Newform.ComplexAutomorphism
import Mathlib.FieldTheory.CardinalEmb
import Mathlib.FieldTheory.Minpoly.IsConjRoot
import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.NumberTheory.NumberField.Basic

/-!
# Fixed fields of automorphisms of `ℂ`

A countable subfield `K` of `ℂ` is the fixed field of the automorphisms of `ℂ` fixing `K`, and if
`K` has finitely many embeddings into `ℂ`, it is a number field. Both rest on the extension of
embeddings of countable subfields of `ℂ` to automorphisms of `ℂ`, and on the embeddings
`x ↦ x + j` of the field generated by a transcendental number `x`.

## Main definitions

* `IntermediateField.transcendentalEmbedding`: the embedding `x ↦ y` of the field generated by a
  transcendental number `x`, for a transcendental number `y`.

## Main results

* `IntermediateField.exists_algEquiv_apply_ne_of_notMem`: a complex number outside a countable
  subfield `K` is moved by an automorphism of `ℂ` fixing `K`.
* `IntermediateField.finiteDimensional_of_finite_algHom`: a subfield of `ℂ` with finitely many
  embeddings into `ℂ` has finite degree over `ℚ`.
-/

open Cardinal Field

namespace IntermediateField

variable {F : Type*} [Field F] [Algebra F ℂ] {K : IntermediateField ℚ ℂ} {x y : ℂ}

/-- The embedding of the field `F⟮x⟯` generated by a transcendental number `x` sending `x` to `y`,
for a transcendental number `y`. -/
noncomputable def transcendentalEmbedding (hx : Transcendental F x) (hy : Transcendental F y) :
    F⟮x⟯ →ₐ[F] ℂ :=
  (F⟮y⟯.val).comp ((RatFunc.algEquivOfTranscendental y hy).toAlgHom.comp
    (RatFunc.algEquivOfTranscendental x hx).symm.toAlgHom)

lemma transcendentalEmbedding_gen (hx : Transcendental F x) (hy : Transcendental F y) :
    transcendentalEmbedding hx hy (AdjoinSimple.gen F x) = y := by
  simp [transcendentalEmbedding]

lemma transcendental_add_natCast (hx : Transcendental F x) (j : ℕ) : Transcendental F (x + j) :=
  fun h ↦ hx <| by simpa using h.sub (isAlgebraic_algebraMap (j : F))

lemma exists_algHom_apply_gen_ne (hx : x ∉ K) :
    ∃ ι : K⟮x⟯ →ₐ[K] ℂ, ι (AdjoinSimple.gen K x) ≠ x := by
  by_cases halg : IsAlgebraic K x
  · have hint : IsIntegral K x := halg.isIntegral
    have hbot : x ∉ (⊥ : Subalgebra K ℂ) := fun h ↦ by
      rcases Algebra.mem_bot.mp h with ⟨y, rfl⟩
      exact hx y.2
    rcases (notMem_iff_exists_ne_and_isConjRoot (minpoly.irreducible hint).separable
      (IsAlgClosed.splits _)).mp hbot with ⟨y, hne, hy⟩
    have hmem : y ∈ (minpoly K x).aroots ℂ :=
      Polynomial.mem_aroots.mpr ⟨minpoly.ne_zero hint, hy ▸ minpoly.aeval K y⟩
    exact ⟨(algHomAdjoinIntegralEquiv K hint).symm ⟨y, hmem⟩, by
      rw [algHomAdjoinIntegralEquiv_symm_apply_gen]
      exact hne.symm⟩
  · have hx₀ : Transcendental K x := halg
    have hy : Transcendental K (x + (1 : ℕ)) := transcendental_add_natCast hx₀ 1
    exact ⟨transcendentalEmbedding hx₀ hy, by
      rw [transcendentalEmbedding_gen]
      simp⟩

variable [Countable K] in
/-- **A countable subfield of `ℂ` is the fixed field of its automorphisms**: a complex number
outside a countable subfield `K` is moved by an automorphism of `ℂ` fixing `K`. -/
lemma exists_algEquiv_apply_ne_of_notMem (hx : x ∉ K) :
    ∃ σ : Gal(ℂ/ℚ), (∀ y : K, σ y = y) ∧ σ x ≠ x := by
  rcases exists_algHom_apply_gen_ne hx with ⟨ι, hι⟩
  have hc : Countable K⟮x⟯ := by
    rw [← mk_le_aleph0_iff]
    exact (cardinalMk_adjoin_le K {x}).trans <| sup_le (sup_le (mk_le_aleph0_iff.mpr inferInstance)
      (Set.countable_singleton x).le_aleph0) le_rfl
  have : Countable (K⟮x⟯.restrictScalars ℚ) := hc
  let ι₀ : K⟮x⟯.restrictScalars ℚ →ₐ[ℚ] ℂ := ι.restrictScalars ℚ
  rcases exists_algEquiv_apply_eq_of_countable ι₀ with ⟨σ, hσ⟩
  refine ⟨σ, fun y ↦ ?_, ?_⟩
  · exact (hσ (algebraMap K K⟮x⟯ y)).trans (ι.commutes y)
  · exact (hσ (AdjoinSimple.gen K x)).symm ▸ hι

/-- **A subfield of `ℂ` with finitely many embeddings has finite degree.** It is algebraic, as the
embeddings `x ↦ x + j` of the field generated by a transcendental number `x` extend to `K`, and an
infinite separable extension has infinitely many embeddings. -/
lemma finiteDimensional_of_finite_algHom [Finite (K →ₐ[ℚ] ℂ)] : FiniteDimensional ℚ K := by
  have halg : Algebra.IsAlgebraic ℚ K := ⟨fun x ↦ by
    by_contra hx
    have hx₀ : Transcendental ℚ (x : ℂ) := fun h ↦
      hx <| (isAlgebraic_algHom_iff K.val Subtype.val_injective).mp h
    have : Countable ℚ⟮(x : ℂ)⟯ := by
      rw [← mk_le_aleph0_iff]
      exact (cardinalMk_adjoin_le ℚ {(x : ℂ)}).trans <|
        sup_le (sup_le mk_le_aleph0 (Set.countable_singleton _).le_aleph0) le_rfl
    have hext (j : ℕ) : ∃ σ : Gal(ℂ/ℚ), σ x = x + j := by
      rcases exists_algEquiv_apply_eq_of_countable
        (transcendentalEmbedding hx₀ (transcendental_add_natCast hx₀ j)) with ⟨σ, hσ⟩
      exact ⟨σ, (hσ (AdjoinSimple.gen ℚ (x : ℂ))).trans (transcendentalEmbedding_gen _ _)⟩
    choose σ hσ using hext
    refine not_injective_infinite_finite (fun j : ℕ ↦ (σ j : ℂ →ₐ[ℚ] ℂ).comp K.val) fun i j h ↦ ?_
    have hij : (x : ℂ) + i = x + j := by
      rw [← hσ, ← hσ]
      exact DFunLike.congr_fun h x
    exact_mod_cast add_left_cancel hij⟩
  let e : Emb ℚ K → (K →ₐ[ℚ] ℂ) := fun ι ↦
    ((IsAlgClosed.lift : AlgebraicClosure K →ₐ[K] ℂ).restrictScalars ℚ).comp ι
  have he : Function.Injective e := fun ι ι' h ↦ AlgHom.ext fun x ↦
    (IsAlgClosed.lift : AlgebraicClosure K →ₐ[K] ℂ).injective (DFunLike.congr_fun h x)
  have : Finite (Emb ℚ K) := Finite.of_injective e he
  by_contra hfin
  have hinf : ℵ₀ ≤ Module.rank ℚ K :=
    not_lt.mp fun h ↦ hfin (IsNoetherian.iff_fg.mp (IsNoetherian.iff_rank_lt_aleph0.mpr h))
  have hcard : #(Emb ℚ K) = 2 ^ Module.rank ℚ K := Emb.cardinal_eq_two_pow_rank hinf
  have hlt : #(Emb ℚ K) < ℵ₀ := lt_aleph0_iff_finite.mpr inferInstance
  exact absurd (hcard ▸ hlt) (not_lt.mpr <| hinf.trans (cantor _).le)

end IntermediateField
