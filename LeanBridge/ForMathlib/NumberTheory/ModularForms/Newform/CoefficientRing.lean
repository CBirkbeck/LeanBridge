import LeanBridge.ForMathlib.NumberTheory.ModularForms.Newform.Embedding
import TauCeti.NumberTheory.ModularForms.Newforms.NumberField
import Mathlib.GroupTheory.FiniteAbelian.Basic

/-!
# The coefficient ring of a newform

The coefficient ring of a modular form `f = ∑ aₙ qⁿ` (LMFDB `cmf.coefficient_ring`), also called
its Hecke ring, is the subring `ℤ[a₁, a₂, a₃, …]` of `ℂ` generated by its coefficients. For a
newform `f` in weight at least two, where Tau Ceti proves that the `aₙ` are algebraic integers, it
is a subring of finite index of the ring of integers `𝓞 K` of the coefficient field `K = ℚ(f)`, i.e.
an order of `K`.

The coefficient ring generator bound of a newform (LMFDB `cmf.hecke_ring_generators`) is the least
`n ≥ 1` such that `a₁, …, aₙ` generate the coefficient ring; it exists because `𝓞 K` is a
noetherian `ℤ`-module.

## Main definitions

* `UpperHalfPlane.qExpansionCoeffRing`: the coefficient ring of a modular form, or of any function
  on the upper half plane (LMFDB `cmf.coefficient_ring`).
* `HeckeRing.GL2.Newform.coefficientRing`: the coefficient ring of a newform
  (LMFDB `cmf.coefficient_ring`).
* `HeckeRing.GL2.Newform.coefficientOrder`: the coefficient ring of a newform, as a subring of the
  ring of integers of the coefficient field (LMFDB `cmf.coefficient_ring`).
* `HeckeRing.GL2.Newform.truncCoefficientRing`: the subring `ℤ[a₁, …, aₙ]`.
* `HeckeRing.GL2.Newform.coefficientRingGeneratorBound`: the coefficient ring generator bound of a
  newform (LMFDB `cmf.hecke_ring_generators`).

## Main results

* `HeckeRing.GL2.Newform.coefficientRing_le_range`, `HeckeRing.GL2.Newform.map_coefficientOrder`:
  in weight at least two, the coefficient ring lies in the ring of integers of the coefficient
  field, as the image of `coefficientOrder`.
* `HeckeRing.GL2.Newform.finiteIndex_coefficientOrder`: in weight at least two, the coefficient
  ring has finite index in the ring of integers of the coefficient field.
* `HeckeRing.GL2.Newform.nonempty_truncCoefficientRing_eq`: in weight at least two, finitely many
  coefficients generate the coefficient ring.
* `HeckeRing.GL2.Newform.truncCoefficientRing_coefficientRingGeneratorBound`: in weight at least
  two, the coefficients `aₙ` with `1 ≤ n ≤ B` generate the coefficient ring, for `B` the generator
  bound.
-/

open UpperHalfPlane TauCeti NumberField

namespace UpperHalfPlane

/-- The **coefficient ring** of a modular form `f = ∑ aₙ qⁿ` (LMFDB `cmf.coefficient_ring`), or
Hecke ring: the subring `ℤ[a₁, a₂, a₃, …]` of `ℂ` generated by the coefficients `aₙ`, `n ≥ 1`, of
its `q`-expansion in `q = e^{2πiz}`. It is defined for every function `f` on the upper half plane,
through Mathlib's `qExpansion 1 f`. -/
noncomputable def qExpansionCoeffRing (f : ℍ → ℂ) : Subring ℂ :=
  Subring.closure (Set.range fun n : ℕ+ ↦ (qExpansion 1 f).coeff n)

end UpperHalfPlane

namespace HeckeRing.GL2.Newform

variable {N : ℕ} [NeZero N] {k : ℤ} {f : Newform N k} (hk : 2 ≤ k) {m n : ℕ}

variable (f) in
/-- The **coefficient ring** of a newform `f = ∑ aₙ qⁿ` (LMFDB `cmf.coefficient_ring`), or Hecke
ring: the coefficient ring `ℤ[a₁, a₂, a₃, …]` of its `q`-expansion. -/
noncomputable abbrev coefficientRing : Subring ℂ :=
  qExpansionCoeffRing f.toCuspForm

variable (f n) in
lemma qExpansion_coeff_mem_coefficientRing :
    (qExpansion 1 f.toCuspForm).coeff n ∈ f.coefficientRing := by
  rcases n with _ | n
  · rw [CuspFormClass.qExpansion_coeff_zero f.toCuspForm one_pos
      (one_mem_strictPeriods_Gamma1_map N)]
    exact zero_mem _
  · exact Subring.subset_closure ⟨n.succPNat, rfl⟩

variable (f) in
lemma coefficientRing_le_coefficientField :
    f.coefficientRing ≤ (CoefficientField f).toSubalgebra.toSubring :=
  Subring.closure_le.mpr <| Set.range_subset_iff.mpr <| coeff_mem_CoefficientField f

variable (f) in
include hk in
/-- **The coefficient ring lies in the ring of integers of the coefficient field**, in weight at
least two: its generators `aₙ` are algebraic integers in `ℚ(f)`. -/
lemma coefficientRing_le_range :
    f.coefficientRing ≤ (algebraMap (𝓞 (CoefficientField f)) ℂ).range :=
  Subring.closure_le.mpr <| Set.range_subset_iff.mpr fun n ↦ ⟨⟨⟨_, coeff_mem_CoefficientField f n⟩,
    (isIntegral_algHom_iff (CoefficientField f).val.toIntAlgHom Subtype.val_injective).mp
      (f.isIntegral_qExpansion_coeff hk n)⟩, rfl⟩

include hk in
lemma exists_mul_mem_coefficientRing_of_mem_coefficientField {x : ℂ} (hx : x ∈ CoefficientField f) :
    ∃ m : ℕ, 0 < m ∧ m * x ∈ f.coefficientRing := by
  rw [← IntermediateField.mem_toSubalgebra, CoefficientField_def,
    IntermediateField.adjoin_toSubalgebra_of_isAlgebraic] at hx
  · induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with ⟨n, rfl⟩
      exact ⟨1, one_pos, by simpa using f.qExpansion_coeff_mem_coefficientRing n⟩
    | algebraMap q =>
      refine ⟨q.den, q.pos, ?_⟩
      rw [eq_ratCast, ← Rat.cast_natCast, ← Rat.cast_mul, Rat.den_mul_eq_num, Rat.cast_intCast]
      exact intCast_mem _ _
    | add x y _ _ hx hy =>
      rcases hx with ⟨m, hm, hmx⟩
      rcases hy with ⟨m', hm', hmy⟩
      refine ⟨m * m', Nat.mul_pos hm hm', ?_⟩
      have h : ((m * m' : ℕ) : ℂ) * (x + y) = m * x * m' + m * (m' * y) := by
        push_cast
        ring1
      rw [h]
      exact add_mem (mul_mem hmx (natCast_mem _ m')) (mul_mem (natCast_mem _ m) hmy)
    | mul x y _ _ hx hy =>
      rcases hx with ⟨m, hm, hmx⟩
      rcases hy with ⟨m', hm', hmy⟩
      refine ⟨m * m', Nat.mul_pos hm hm', ?_⟩
      have h : ((m * m' : ℕ) : ℂ) * (x * y) = m * x * (m' * y) := by
        push_cast
        ring1
      rw [h]
      exact mul_mem hmx hmy
  · rintro _ ⟨n, rfl⟩
    exact (f.isIntegral_qExpansion_coeff hk n).tower_top.isAlgebraic

variable (f) in
/-- The coefficient ring of a newform `f`, as a subring of the ring of integers `𝓞 K` of its
coefficient field `K = ℚ(f)`: the preimage of the coefficient ring under `𝓞 K → ℂ`. In weight at
least two it is mapped onto the coefficient ring (`map_coefficientOrder`) and has finite index in
`𝓞 K` (`finiteIndex_coefficientOrder`), i.e. it is an order of `K`. -/
noncomputable def coefficientOrder : Subring (𝓞 (CoefficientField f)) :=
  f.coefficientRing.comap (algebraMap (𝓞 (CoefficientField f)) ℂ)

variable (f) in
include hk in
/-- **In weight at least two, the coefficient ring is the image of `coefficientOrder f`**, as it
lies in the ring of integers of the coefficient field. -/
lemma map_coefficientOrder :
    f.coefficientOrder.map (algebraMap (𝓞 (CoefficientField f)) ℂ) = f.coefficientRing := by
  rw [coefficientOrder, Subring.map_comap_eq, inf_eq_left.mpr (f.coefficientRing_le_range hk)]

variable (f) in
include hk in
/-- **The coefficient ring has finite index in the ring of integers of the coefficient field**, in
weight at least two: it contains a multiple of every element of the coefficient field, so the
quotient of `𝓞 K` by it is a finitely generated torsion abelian group. -/
lemma finiteIndex_coefficientOrder : f.coefficientOrder.toAddSubgroup.FiniteIndex := by
  have : NumberField (CoefficientField f) := numberField_CoefficientField f hk
  have : Finite (𝓞 (CoefficientField f) ⧸ f.coefficientOrder.toAddSubgroup) := by
    refine Module.finite_of_fg_torsion _ fun x ↦ ?_
    rcases QuotientAddGroup.mk'_surjective _ x with ⟨x, rfl⟩
    rcases exists_mul_mem_coefficientRing_of_mem_coefficientField hk
      (algebraMap (𝓞 (CoefficientField f)) (CoefficientField f) x).2 with ⟨m, hm, hmx⟩
    refine ⟨⟨m, mem_nonZeroDivisors_of_ne_zero (by exact_mod_cast hm.ne')⟩, ?_⟩
    rw [Submonoid.mk_smul, ← map_zsmul, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
    simpa [coefficientOrder,
      IsScalarTower.algebraMap_apply (𝓞 (CoefficientField f)) (CoefficientField f) ℂ] using hmx
  exact AddSubgroup.finiteIndex_of_finite_quotient

variable (f n) in
/-- The subring `ℤ[a₁, …, aₙ]` of `ℂ` generated by the first `n` coefficients of a newform
`f = ∑ aₙ qⁿ`. -/
noncomputable def truncCoefficientRing : Subring ℂ :=
  Subring.closure ((fun m : ℕ ↦ (qExpansion 1 f.toCuspForm).coeff m) '' Set.Icc 1 n)

variable (f) in
lemma truncCoefficientRing_mono : Monotone f.truncCoefficientRing :=
  fun _ _ h ↦ Subring.closure_mono (Set.image_mono (Set.Icc_subset_Icc_right h))

variable (f n) in
lemma truncCoefficientRing_le : f.truncCoefficientRing n ≤ f.coefficientRing :=
  Subring.closure_le.mpr <| Set.image_subset_iff.mpr fun m _ ↦
    f.qExpansion_coeff_mem_coefficientRing m

lemma qExpansion_coeff_mem_truncCoefficientRing (hm : 1 ≤ m) (hmn : m ≤ n) :
    (qExpansion 1 f.toCuspForm).coeff m ∈ f.truncCoefficientRing n :=
  Subring.subset_closure ⟨m, ⟨hm, hmn⟩, rfl⟩

variable (f) in
include hk in
/-- **Finitely many coefficients generate the coefficient ring**, in weight at least two: the
subrings `ℤ[a₁, …, aₙ]` give an increasing chain of submodules of the noetherian `ℤ`-module
`𝓞 K`, which stabilises. -/
lemma nonempty_truncCoefficientRing_eq :
    {n | 0 < n ∧ f.truncCoefficientRing n = f.coefficientRing}.Nonempty := by
  have : NumberField (CoefficientField f) := numberField_CoefficientField f hk
  let c : ℕ →o Submodule ℤ (𝓞 (CoefficientField f)) :=
    ⟨fun n ↦ ((f.truncCoefficientRing n).comap
      (algebraMap (𝓞 (CoefficientField f)) ℂ)).toAddSubgroup.toIntSubmodule,
      fun _ _ h _ hx ↦ f.truncCoefficientRing_mono h hx⟩
  rcases monotone_stabilizes_iff_noetherian.mpr inferInstance c with ⟨n, hn⟩
  refine ⟨max n 1, by omega, le_antisymm (f.truncCoefficientRing_le _) <|
    Subring.closure_le.mpr <| Set.range_subset_iff.mpr fun m ↦ ?_⟩
  rcases f.coefficientRing_le_range hk (f.qExpansion_coeff_mem_coefficientRing m) with ⟨x, hx⟩
  have hx₁ : algebraMap _ ℂ x ∈ f.truncCoefficientRing (max n m) :=
    hx ▸ qExpansion_coeff_mem_truncCoefficientRing m.pos (le_max_right n m)
  have hx₂ : algebraMap _ ℂ x ∈ f.truncCoefficientRing n :=
    (SetLike.ext_iff.mp (hn _ (le_max_left n m)) x).mpr hx₁
  exact hx ▸ f.truncCoefficientRing_mono (le_max_left n 1) hx₂

variable (f) in
/-- The **coefficient ring generator bound** of a newform `f = ∑ aₙ qⁿ`
(LMFDB `cmf.hecke_ring_generators`): the least `n ≥ 1` such that `ℤ[a₁, …, aₙ]` is the whole
coefficient ring `ℤ[a₁, a₂, a₃, …]`. Such an `n` exists in weight at least two
(`nonempty_truncCoefficientRing_eq`); the value `0`, for no such `n`, does not occur there. -/
noncomputable def coefficientRingGeneratorBound : ℕ :=
  sInf {n | 0 < n ∧ f.truncCoefficientRing n = f.coefficientRing}

include hk in
lemma coefficientRingGeneratorBound_pos : 0 < f.coefficientRingGeneratorBound :=
  (Nat.sInf_mem (f.nonempty_truncCoefficientRing_eq hk)).1

include hk in
/-- **The coefficients `aₙ` with `1 ≤ n ≤ B` generate the coefficient ring**, for `B` the
coefficient ring generator bound, in weight at least two. -/
lemma truncCoefficientRing_coefficientRingGeneratorBound :
    f.truncCoefficientRing f.coefficientRingGeneratorBound = f.coefficientRing :=
  (Nat.sInf_mem (f.nonempty_truncCoefficientRing_eq hk)).2

lemma coefficientRingGeneratorBound_le (hn : 0 < n)
    (h : f.truncCoefficientRing n = f.coefficientRing) : f.coefficientRingGeneratorBound ≤ n :=
  Nat.sInf_le ⟨hn, h⟩

end HeckeRing.GL2.Newform
