import LeanBridge.ForMathlib.NumberTheory.Cyclotomic.LeastLevel
import TauCeti.NumberTheory.ModularForms.Newforms.Fields
import TauCeti.NumberTheory.MulChar.Basic

/-!
# The least cyclotomic field containing the values of a nebentypus

The field of values `ℚ(χ)` of a nebentypus `χ : (ℤ/Nℤ)ˣ → ℂˣ` is the subfield of `ℂ` generated by
the values of `χ` (Tau Ceti's `TauCeti.CharacterField`). For `χ` of order `n` it is the cyclotomic
field `ℚ(ζ_n)` generated by the `n`-th roots of unity, as one value of `χ` is a primitive `n`-th
root of unity. The LMFDB considers the least positive `m` such that the values of `χ` lie in the
cyclotomic field `ℚ(ζ_m)`, the cyclotomic level of `χ`. The order of `χ` is one such `m`, and the
least one is `n / 2` if `n ≡ 2 mod 4` and `n` otherwise, the least level of the cyclotomic field
`ℚ(ζ_n)` (`Complex.isLeast_adjoin_nth_roots_le`). So `ℚ(ζ_m) = ℚ(χ)`, and as `ℚ(χ)` lies in the
coefficient field `ℚ(f)` of a newform `f` of nebentypus `χ` (Tau Ceti's
`TauCeti.CharacterField_le_CoefficientField`), so does `ℚ(ζ_m)`, as the LMFDB states. Here
`ℚ(ζ_m)` is the subfield of `ℂ` generated by the `m`-th roots of unity, which any primitive `m`-th
root of unity generates (Tau Ceti's `IsPrimitiveRoot.adjoin_singleton_eq_adjoin_nth_roots`).

## Main definitions

* `TauCeti.cyclotomicLevel` (LMFDB `cmf.coefficient_field`): the least positive `m` such that the
  cyclotomic field `ℚ(ζ_m)` contains the values of a nebentypus.

## Main results

* `TauCeti.characterField_eq_adjoin_nth_roots`: the field of values of a nebentypus of order `n` is
  the cyclotomic field `ℚ(ζ_n)`.
* `TauCeti.isLeast_cyclotomicLevel` (LMFDB `cmf.coefficient_field`): there is a least positive `m`
  such that `ℚ(ζ_m)` contains the values of `χ`, the cyclotomic level of `χ`.
* `TauCeti.cyclotomicLevel_eq`: the cyclotomic level of `χ` is `n / 2` if `n ≡ 2 mod 4`, and `n`
  otherwise.
* `TauCeti.adjoin_nth_roots_cyclotomicLevel` (LMFDB `cmf.coefficient_field`): for the cyclotomic
  level `m` of `χ`, `ℚ(ζ_m)` is the field of values of `χ`.
* `HeckeRing.GL2.Newform.adjoin_nth_roots_cyclotomicLevel_le_coefficientField`
  (LMFDB `cmf.coefficient_field`): the coefficient field of a newform contains `ℚ(ζ_m)`.
-/

open IntermediateField TauCeti

variable {N : ℕ}

namespace MulChar

variable {R R' : Type*} [CommMonoid R] [CommMonoidWithZero R']

lemma orderOf_ofUnitHom (f : Rˣ →* R'ˣ) : orderOf (ofUnitHom f) = orderOf f :=
  mulEquivToUnitHom.symm.orderOf_eq f

end MulChar

namespace TauCeti

variable (χ : (ZMod N)ˣ →* ℂˣ)

/-- **The field of values of a nebentypus of order `n` is the cyclotomic field `ℚ(ζ_n)`**,
generated by the `n`-th roots of unity. -/
lemma characterField_eq_adjoin_nth_roots :
    CharacterField χ = adjoin ℚ {b : ℂ | b ^ orderOf χ = 1} := by
  rw [← MulChar.orderOf_ofUnitHom, ← MulChar.adjoin_range_eq_adjoin_nth_roots]
  refine le_antisymm ((CharacterField_le_iff χ _).mpr fun u ↦ ?_) (adjoin_le_iff.mpr ?_)
  · exact subset_adjoin ℚ _ ⟨u, MulChar.ofUnitHom_coe χ u⟩
  · exact Set.range_subset_iff.mpr <| (MulChar.ofUnitHom χ).apply_mem_of_forall_unit _ fun u ↦
      MulChar.ofUnitHom_coe χ u ▸ char_mem_CharacterField χ u

/-- The **cyclotomic level** of a nebentypus `χ` (LMFDB `cmf.coefficient_field`): the least
positive integer `m` such that the cyclotomic field `ℚ(ζ_m)`, generated in `ℂ` by the `m`-th roots
of unity, contains the values of `χ`. Such an `m` exists (`isLeast_cyclotomicLevel`): for `χ` of
order `n` it is `n / 2` if `n ≡ 2 mod 4` and `n` otherwise (`cyclotomicLevel_eq`), and `ℚ(ζ_m)` is
the field of values of `χ` (`adjoin_nth_roots_cyclotomicLevel`). -/
noncomputable def cyclotomicLevel : ℕ :=
  sInf {m | 0 < m ∧ ∀ u, (χ u : ℂ) ∈ adjoin ℚ {b : ℂ | b ^ m = 1}}

/-- **There is a least positive `m` such that the cyclotomic field `ℚ(ζ_m)` contains the values of
`χ`**, the cyclotomic level of `χ`: the order of `χ` is one such `m`. -/
lemma isLeast_cyclotomicLevel :
    IsLeast {m | 0 < m ∧ ∀ u, (χ u : ℂ) ∈ adjoin ℚ {b : ℂ | b ^ m = 1}} (cyclotomicLevel χ) :=
  ⟨Nat.sInf_mem ⟨orderOf χ, MulChar.orderOf_ofUnitHom χ ▸ (MulChar.ofUnitHom χ).orderOf_pos, fun u ↦
    characterField_eq_adjoin_nth_roots χ ▸ char_mem_CharacterField χ u⟩, fun _ ↦ Nat.sInf_le⟩

/-- **The cyclotomic level of a nebentypus of order `n` is `n / 2` if `n ≡ 2 mod 4`, and `n`
otherwise.** -/
lemma cyclotomicLevel_eq :
    cyclotomicLevel χ = if orderOf χ % 4 = 2 then orderOf χ / 2 else orderOf χ := by
  have : NeZero (orderOf χ) :=
    .of_pos <| MulChar.orderOf_ofUnitHom χ ▸ (MulChar.ofUnitHom χ).orderOf_pos
  simp only [cyclotomicLevel, ← CharacterField_le_iff, characterField_eq_adjoin_nth_roots]
  exact Complex.isLeast_adjoin_nth_roots_le.csInf_eq

/-- **The cyclotomic field `ℚ(ζ_m)` of the cyclotomic level `m` of a nebentypus `χ` is the field of
values of `χ`.** -/
lemma adjoin_nth_roots_cyclotomicLevel :
    adjoin ℚ {b : ℂ | b ^ cyclotomicLevel χ = 1} = CharacterField χ := by
  rw [cyclotomicLevel_eq, characterField_eq_adjoin_nth_roots]
  split_ifs with h
  exacts [adjoin_nth_roots_div_two h, rfl]

end TauCeti

namespace HeckeRing.GL2.Newform

/-- **The coefficient field of a newform contains the cyclotomic field `ℚ(ζ_m)`** (LMFDB
`cmf.coefficient_field`), for the least positive `m` such that `ℚ(ζ_m)` contains the values of the
nebentypus. -/
lemma adjoin_nth_roots_cyclotomicLevel_le_coefficientField [NeZero N] {k : ℤ} (f : Newform N k) :
    adjoin ℚ {b : ℂ | b ^ cyclotomicLevel f.χ = 1} ≤ CoefficientField f :=
  (adjoin_nth_roots_cyclotomicLevel f.χ).trans_le <| CharacterField_le_CoefficientField f

end HeckeRing.GL2.Newform
