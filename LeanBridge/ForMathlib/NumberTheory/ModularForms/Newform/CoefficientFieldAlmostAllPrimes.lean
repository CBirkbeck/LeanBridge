import LeanBridge.ForMathlib.NumberTheory.ModularForms.Newform.CrossLevelMultiplicityOne
import LeanBridge.ForMathlib.NumberTheory.ModularForms.Newform.GaloisActionOnNewforms
import LeanBridge.ForMathlib.NumberTheory.ModularForms.Newform.NebentypusRigidity

/-!
# The coefficient field of a newform is generated by almost all of its `a_p`

Two newforms of the same level whose coefficients `a_p` agree at all but finitely many primes are
equal. The nebentypus is not assumed to be the same: nebentypus rigidity
(`HeckeRing.GL2.Newform.comp_unitsMap_eq_of_eventually_coeff_eq`) gives it, and strong multiplicity
one at a fixed level with finitely many exceptional primes
(`HeckeRing.GL2.Newform.eq_of_forall_prime_notMem_eigenvalue_eq`) does the rest. Only one level
occurs here, so strong multiplicity one across levels is not used.

As the Galois conjugates of a newform are newforms of the same level, two automorphisms of `ℂ`
agreeing on `a_p` at almost all primes `p` agree on every `a_n`, and a countable subfield of `ℂ` is
the fixed field of its automorphisms. So the coefficient field of `f` is generated by the `a_p` for
almost all `p`, which is the form in which Ribet's arguments on inner twists use strong multiplicity
one.

## Main results

* `HeckeRing.GL2.Newform.eq_of_eventually_coeff_eq`: two newforms of the same level whose
  coefficients agree at almost all primes are equal.
* `HeckeRing.GL2.Newform.apply_coeff_eq_of_eventually_apply_coeff_eq`: automorphisms of `ℂ` agreeing
  on `a_p` at almost all primes agree on every `a_n`.
* `HeckeRing.GL2.Newform.coefficientField_le_of_eventually_coeff_mem`: a subfield of `ℂ` containing
  `a_p` at almost all primes contains the coefficient field.
-/

open UpperHalfPlane TauCeti

namespace HeckeRing.GL2.Newform

variable {N : ℕ} [NeZero N] {k : ℤ} {f g : Newform N k} {σ τ : Gal(ℂ/ℚ)}

/-- **Strong multiplicity one at a fixed level, on the coefficients at almost all primes**: two
newforms of the same level and weight whose coefficients `a_p` agree at all but finitely many primes
are equal. Their nebentypes agree by nebentypus rigidity. -/
lemma eq_of_eventually_coeff_eq (h : ∀ᶠ p in Filter.cofinite, p.Prime →
    (qExpansion 1 g.toCuspForm).coeff p = (qExpansion 1 f.toCuspForm).coeff p) : f = g := by
  have hfin : {p : ℕ | ¬(p.Prime → (qExpansion 1 g.toCuspForm).coeff p =
      (qExpansion 1 f.toCuspForm).coeff p)}.Finite := Filter.eventually_cofinite.mp h
  refine eq_of_forall_prime_notMem_eigenvalue_eq (S := hfin.toFinset) ?_ fun p hp hpN hpS ↦ ?_
  · simpa using comp_unitsMap_eq_of_eventually_coeff_eq f g dvd_rfl dvd_rfl h
  · rw [← f.qExpansion_coeff_eq_eigenvalue f.isNorm ⟨p, hp.pos⟩ hpN,
      ← g.qExpansion_coeff_eq_eigenvalue g.isNorm ⟨p, hp.pos⟩ hpN]
    by_contra hne
    exact hpS (hfin.mem_toFinset.mpr fun h' ↦ hne (h' hp).symm)

/-- **Automorphisms of `ℂ` agreeing on `a_p` at almost all primes agree on every coefficient** of
the newform: the Galois conjugates `σ(f)` and `τ(f)` are newforms of the same level, equal by strong
multiplicity one at a fixed level. -/
lemma apply_coeff_eq_of_eventually_apply_coeff_eq (h : ∀ᶠ p in Filter.cofinite, p.Prime →
    σ ((qExpansion 1 f.toCuspForm).coeff p) = τ ((qExpansion 1 f.toCuspForm).coeff p)) (n : ℕ) :
    σ ((qExpansion 1 f.toCuspForm).coeff n) = τ ((qExpansion 1 f.toCuspForm).coeff n) := by
  have hf : τ • f = σ • f := eq_of_eventually_coeff_eq <| h.mono fun p hp hp' ↦ by
    rw [coeff_smul, coeff_smul, hp hp']
  rw [← coeff_smul, ← coeff_smul, hf]

/-- **The coefficient field is generated by almost all of the `a_p`**: a subfield of `ℂ` containing
`a_p` at all but finitely many primes contains the coefficient field of the newform. -/
lemma coefficientField_le_of_eventually_coeff_mem {L : IntermediateField ℚ ℂ}
    (h : ∀ᶠ p in Filter.cofinite, p.Prime → (qExpansion 1 f.toCuspForm).coeff p ∈ L) :
    CoefficientField f ≤ L := by
  refine (CoefficientField_le_iff f L).mpr fun n ↦ ?_
  have hc : Countable (L ⊓ CoefficientField f : IntermediateField ℚ ℂ) :=
    (IntermediateField.inclusion inf_le_right).injective.countable
  by_contra hn
  rcases IntermediateField.exists_algEquiv_apply_ne_of_notMem
    (K := L ⊓ CoefficientField f) (x := (qExpansion 1 f.toCuspForm).coeff (n : ℕ))
    fun hn' ↦ hn hn'.1 with ⟨σ, hσ, hne⟩
  refine hne <| apply_coeff_eq_of_eventually_apply_coeff_eq (τ := 1) (h.mono fun p hp hp' ↦ ?_) n
  exact hσ ⟨_, hp hp', f.qExpansion_coeff_mem_coefficientField p⟩

end HeckeRing.GL2.Newform
