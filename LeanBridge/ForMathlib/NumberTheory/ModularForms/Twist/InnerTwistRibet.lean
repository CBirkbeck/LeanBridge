import LeanBridge.ForMathlib.NumberTheory.ModularForms.Newform.CoefficientFieldAlmostAllPrimes
import LeanBridge.ForMathlib.NumberTheory.ModularForms.Twist.InnerTwistGroup

/-!
# Ribet's theorems on inner twists

Let `f` be a newform of level `N`, nebentypus `ε` and coefficient field `K`, and let `(χ, σ)` be an
inner twist pair of `f`: a primitive Dirichlet character `χ` and an automorphism `σ` of `ℂ` with
`σ(a_p) = χ(p) a_p` for all but finitely many primes `p`
(`HeckeRing.GL2.Newform.innerTwistPairs`). This file proves the theorems of Ribet and Momose on such
pairs (K. Ribet, *Twists of modular forms and endomorphisms of abelian varieties*, Math. Ann. 253
(1980), §3; F. Momose, *On the `ℓ`-adic representations attached to modular forms*, J. Fac. Sci.
Univ. Tokyo 28 (1981), Lemma 1.5; both as cited in E. Studnia, arXiv:2401.17769v4, Lemma 1.3 and
Proposition 1.4, which the argument below follows, and in D. Loeffler, arXiv:1411.1789).

Nebentypus rigidity, for `σ(f)` and a newform with the eigenvalues of `f ⊗ χ`, gives
`σ(ε) = ε χ²`. At a root of unity `ζ`, `σ(ζ)` is `ζ^(2 s + 1)` for some `s`: an odd exponent
exists, as an even exponent prime to the order of `ζ` can be changed by the order. So
`χ(n) = ± ε(n)^s` at `n` prime to `N` and the modulus of `χ`, and `χ` has values in the field `ℚ(ε)`
of values of `ε`, hence in `K`. As `K` is generated by the `a_p` at almost all primes
(`HeckeRing.GL2.Newform.coefficientField_le_of_eventually_coeff_mem`), `σ(a_p) = χ(p) a_p` gives
`σ(K) = K`.

For a second pair `(χ', σ')`, with `χ'(n) = ± ε(n)^s'`, both `χ(n) σ(χ'(n))` and `χ'(n) σ'(χ(n))`
are `± ε(n)^(s + s' + 2 s s')`, with the same sign. So they agree, and `σ σ'` and `σ' σ` agree on
`a_p` at almost all primes, hence on `K`. Finally, `χ` determines `σ` on `K`, as
`σ(a_p) = χ(p) a_p`.

Strong multiplicity one across levels is not used: only nebentypus rigidity across levels, and
strong multiplicity one at the level of `f` (`HeckeRing.GL2.Newform.eq_of_eventually_coeff_eq`).

The group of inner twists is in
`LeanBridge.ForMathlib.NumberTheory.ModularForms.Twist.InnerTwistAutGroup`.

## Main results

* `HeckeRing.GL2.Newform.apply_dirichletLift_eq`: `σ(ε(n)) = ε(n) χ(n)²`.
* `HeckeRing.GL2.Newform.apply_mem_characterField`: `χ` has values in the field of values of `ε`.
* `HeckeRing.GL2.Newform.apply_mem_coefficientField`: `χ` has values in the coefficient field.
* `HeckeRing.GL2.Newform.map_coefficientField_eq`: `σ` preserves the coefficient field.
* `HeckeRing.GL2.Newform.mul_apply_eq_mul_apply_of_mem`: `χ(n) σ(χ'(n)) = χ'(n) σ'(χ(n))`.
* `HeckeRing.GL2.Newform.apply_apply_coeff_comm`: `σ σ'` and `σ' σ` agree on the coefficients of
  `f`.
* `HeckeRing.GL2.Newform.apply_coeff_eq_of_fst_eq`: `χ` determines `σ` on the coefficients of `f`.
-/

open UpperHalfPlane TauCeti

namespace HeckeRing.GL2.Newform

variable {N : ℕ} [NeZero N] {k : ℤ} {f : Newform N k} {σ τ : Gal(ℂ/ℚ)} {ζ w w' : ℂ}
  {x y : (Σ M : ℕ+, DirichletCharacter ℂ M) × Gal(ℂ/ℚ)} {n : ℕ}

/-- **The nebentypus of an inner twist** (Ribet): if `(χ, σ)` is an inner twist pair of `f`, of
nebentypus `ε`, then `σ(ε(n)) = ε(n) χ(n)²` at every `n` prime to the level and the modulus of `χ`.
Indeed `σ(f)`, of nebentypus `σ ∘ ε`, has the eigenvalues of a newform of nebentypus `ε χ²`, the
primitive associate of the twist `f ⊗ χ`, at almost all primes. -/
lemma apply_dirichletLift_eq (hx : x ∈ f.innerTwistPairs) (hn : n.Coprime (N * x.1.1)) :
    x.2 (f.dirichletLift n) = f.dirichletLift n * x.1.2 n ^ 2 := by
  rcases x with ⟨⟨M, χ⟩, σ⟩
  simp only at hn ⊢
  have hNL : N * M ∣ N * M * M := dvd_mul_right _ _
  have hML : (M : ℕ) * M ∣ N * M * M := ⟨N, by ring1⟩
  have hL : NeZero (N * M * M) := ⟨mul_ne_zero (mul_ne_zero (NeZero.ne N) M.ne_zero) M.ne_zero⟩
  rcases exists_isGaloisConjugateBy f σ with ⟨g, hg⟩
  rcases exists_newform_qExpansion_coeff_prime_eq_twist f χ hNL hML with ⟨R, _, hR, h, hχ, ha⟩
  have hgh : ∀ᶠ p in Filter.cofinite, p.Prime → (qExpansion 1 h.toCuspForm).coeff p =
      (qExpansion 1 g.toCuspForm).coeff p := by
    filter_upwards [hx.2, (N * M * M : ℕ).primeFactors.finite_toSet.compl_mem_cofinite] with
      p hp hpL hpp
    rw [ha p hpp (hpp.coprime_iff_not_dvd.mpr fun hd ↦
      hpL (Nat.mem_primeFactors.mpr ⟨hpp, hd, NeZero.ne _⟩)), hg.coeff, hp hpp]
  have hnL : n.Coprime (N * M * M) := hn.mul_right (hn.coprime_dvd_right (dvd_mul_left _ _))
  have hnN : n.Coprime N := hn.coprime_dvd_right (dvd_mul_right _ _)
  have h₂ : (g.χ (ZMod.unitOfCoprime n hnN) : ℂ) = f.χ (ZMod.unitOfCoprime n hnN) * χ n ^ 2 := by
    simpa using congrArg (fun φ ↦ ((φ (ZMod.unitOfCoprime n hnL) : ℂˣ) : ℂ))
      ((comp_unitsMap_eq_of_eventually_coeff_eq g h (dvd_of_mul_right_dvd hNL) hR hgh).trans hχ)
  rw [f.dirichletLift_apply_of_coprime hnN, ← hg.χ_apply]
  exact h₂

variable (σ) in
private lemma exists_apply_eq_pow_odd (hζ : IsOfFinOrder ζ) : ∃ s : ℕ, σ ζ = ζ ^ (2 * s + 1) := by
  have hn : 0 < orderOf ζ := hζ.orderOf_pos
  have : NeZero (orderOf ζ) := ⟨hn.ne'⟩
  have hprim : IsPrimitiveRoot ζ (orderOf ζ) := IsPrimitiveRoot.orderOf ζ
  have hσ : IsPrimitiveRoot (σ ζ) (orderOf ζ) := hprim.map_of_injective σ.injective
  rcases hprim.eq_pow_of_pow_eq_one hσ.pow_eq_one with ⟨i, -, hi⟩
  have hcop : i.Coprime (orderOf ζ) := (hprim.pow_iff_coprime hn i).mp (hi ▸ hσ)
  rcases Nat.even_or_odd' i with ⟨s, rfl | rfl⟩
  · rcases Nat.coprime_two_left.mp (hcop.coprime_dvd_left (dvd_mul_right 2 s)) with ⟨m, hm⟩
    refine ⟨s + m, ?_⟩
    rw [← hi, mul_add, add_assoc, pow_add, ← hm, pow_orderOf_eq_one, mul_one]
  · exact ⟨s, hi.symm⟩

private lemma eq_or_eq_neg_pow_of_apply_eq (hζ : IsOfFinOrder ζ) {s : ℕ}
    (hs : σ ζ = ζ ^ (2 * s + 1)) (hw : σ ζ = ζ * w ^ 2) : w = ζ ^ s ∨ w = -ζ ^ s := by
  have hζ₀ : ζ ≠ 0 := fun h ↦ by
    have h₁ : (0 : ℂ) ^ orderOf ζ = 1 := h ▸ pow_orderOf_eq_one ζ
    rw [zero_pow hζ.orderOf_pos.ne'] at h₁
    exact zero_ne_one h₁
  refine sq_eq_sq_iff_eq_or_eq_neg.mp (mul_left_cancel₀ hζ₀ ?_)
  rw [← hw, hs]
  ring1

private lemma mul_apply_eq_mul_apply (hζ : IsOfFinOrder ζ) (hw : σ ζ = ζ * w ^ 2)
    (hw' : τ ζ = ζ * w' ^ 2) : w * σ w' = w' * τ w := by
  rcases exists_apply_eq_pow_odd σ hζ with ⟨s, hs⟩
  rcases exists_apply_eq_pow_odd τ hζ with ⟨s', hs'⟩
  have hexp : s + (2 * s + 1) * s' = s' + (2 * s' + 1) * s := by ring1
  have h₁ : ζ ^ s * (ζ ^ (2 * s + 1)) ^ s' = ζ ^ s' * (ζ ^ (2 * s' + 1)) ^ s := by
    rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add, hexp]
  rcases eq_or_eq_neg_pow_of_apply_eq hζ hs hw with rfl | rfl <;>
    rcases eq_or_eq_neg_pow_of_apply_eq hζ hs' hw' with rfl | rfl <;>
    simp only [map_neg, map_pow, hs, hs', neg_mul, mul_neg, h₁]

private lemma isOfFinOrder_dirichletLift (hn : n.Coprime N) : IsOfFinOrder (f.dirichletLift n) := by
  rw [f.dirichletLift_apply_of_coprime hn]
  exact Units.isOfFinOrder_val.mpr (f.χ.isOfFinOrder (isOfFinOrder_of_finite _))

private lemma apply_natCast_mem_characterField (hx : x ∈ f.innerTwistPairs)
    (hn : n.Coprime (N * x.1.1)) : x.1.2 n ∈ CharacterField f.χ := by
  have hnN : n.Coprime N := hn.coprime_dvd_right (dvd_mul_right _ _)
  have hmem : f.dirichletLift n ∈ CharacterField f.χ := by
    rw [f.dirichletLift_apply_of_coprime hnN]
    exact char_mem_CharacterField _ _
  have hζ : IsOfFinOrder (f.dirichletLift n) := isOfFinOrder_dirichletLift hnN
  rcases exists_apply_eq_pow_odd x.2 hζ with ⟨s, hs⟩
  rcases eq_or_eq_neg_pow_of_apply_eq hζ hs (apply_dirichletLift_eq hx hn) with h | h
  · rw [h]
    exact pow_mem hmem s
  · rw [h]
    exact neg_mem (pow_mem hmem s)

/-- **An inner twist character has values in the field of values of the nebentypus** (Momose,
*On the `ℓ`-adic representations attached to modular forms*, Lemma 1.5; Ribet): if `(χ, σ)` is an
inner twist pair of `f`, of nebentypus `ε`, then `χ(a) ∈ ℚ(ε)` for all `a`. At `n` prime to the
level and the modulus, `σ(ε(n)) = ε(n) χ(n)²`, by nebentypus rigidity, and
`σ(ε(n)) = ε(n)^(2 s + 1)` for some `s`, so `χ(n) = ± ε(n)^s`. -/
lemma apply_mem_characterField (hx : x ∈ f.innerTwistPairs) (a : ZMod x.1.1) :
    x.1.2 a ∈ CharacterField f.χ := by
  by_cases ha : IsUnit a
  · rcases ha with ⟨u, rfl⟩
    rcases Nat.forall_exists_prime_gt_and_eq_mod u.isUnit (N * x.1.1) with ⟨p, hpNM, hp, hpu⟩
    rw [← hpu]
    exact apply_natCast_mem_characterField hx
      (Nat.coprime_of_lt_prime (mul_ne_zero (NeZero.ne N) x.1.1.ne_zero) hpNM hp)
  · rw [MulChar.map_nonunit _ ha]
    exact zero_mem _

/-- **An inner twist character has values in the coefficient field** (Ribet, Momose). -/
lemma apply_mem_coefficientField (hx : x ∈ f.innerTwistPairs) (a : ZMod x.1.1) :
    x.1.2 a ∈ CoefficientField f :=
  CharacterField_le_CoefficientField f (apply_mem_characterField hx a)

private lemma map_coefficientField_le (hx : x ∈ f.innerTwistPairs) :
    (CoefficientField f).map (x.2 : ℂ →ₐ[ℚ] ℂ) ≤ CoefficientField f := by
  refine IntermediateField.map_le_iff_le_comap.mpr <| coefficientField_le_of_eventually_coeff_mem <|
    hx.2.mono fun p hp hp' ↦ ?_
  have hmem : x.1.2 p * (qExpansion 1 f.toCuspForm).coeff p ∈ CoefficientField f :=
    mul_mem (apply_mem_coefficientField hx _) (f.qExpansion_coeff_mem_coefficientField p)
  rw [← hp hp'] at hmem
  exact hmem

/-- **An inner twist preserves the coefficient field** (Ribet, Momose, Lemma 1.5): if `(χ, σ)` is an
inner twist pair of `f`, then `σ(K) = K` for the coefficient field `K` of `f`. Indeed `σ(a_p)` is
`χ(p) a_p ∈ K` at almost all primes, these `a_p` generate `K`, and the same holds for `σ⁻¹`. -/
lemma map_coefficientField_eq (hx : x ∈ f.innerTwistPairs) :
    (CoefficientField f).map (x.2 : ℂ →ₐ[ℚ] ℂ) = CoefficientField f := by
  refine le_antisymm (map_coefficientField_le hx) fun a ha ↦ ?_
  exact ⟨x.2⁻¹ a, map_coefficientField_le (innerTwistInv_mem hx) ⟨a, ha, rfl⟩,
    x.2.apply_symm_apply a⟩

/-- **The cocycle of inner twists is symmetric**: if `(χ, σ)` and `(χ', σ')` are inner twist pairs
of `f`, then `χ(n) σ(χ'(n)) = χ'(n) σ'(χ(n))` at every `n` prime to the level and the moduli. -/
lemma mul_apply_eq_mul_apply_of_mem (hx : x ∈ f.innerTwistPairs) (hy : y ∈ f.innerTwistPairs)
    (hn : n.Coprime (N * x.1.1 * y.1.1)) : x.1.2 n * x.2 (y.1.2 n) = y.1.2 n * y.2 (x.1.2 n) := by
  have hnx : n.Coprime (N * x.1.1) := hn.coprime_dvd_right (dvd_mul_right _ _)
  have hny : n.Coprime (N * y.1.1) := hn.coprime_dvd_right
    (mul_dvd_mul_right (dvd_mul_right _ _) _)
  exact mul_apply_eq_mul_apply (isOfFinOrder_dirichletLift
    (hnx.coprime_dvd_right (dvd_mul_right _ _))) (apply_dirichletLift_eq hx hnx)
      (apply_dirichletLift_eq hy hny)

/-- **Inner twists commute on the coefficient field** (Ribet, Momose): if `(χ, σ)` and `(χ', σ')`
are inner twist pairs of `f`, then `σ σ'` and `σ' σ` agree on the coefficients of `f`. -/
lemma apply_apply_coeff_comm (hx : x ∈ f.innerTwistPairs) (hy : y ∈ f.innerTwistPairs) (m : ℕ) :
    x.2 (y.2 ((qExpansion 1 f.toCuspForm).coeff m)) =
      y.2 (x.2 ((qExpansion 1 f.toCuspForm).coeff m)) := by
  refine apply_coeff_eq_of_eventually_apply_coeff_eq (σ := x.2 * y.2) (τ := y.2 * x.2) ?_ m
  filter_upwards [hx.2, hy.2, eventually_prime_coprime
    (mul_ne_zero (mul_ne_zero (NeZero.ne N) x.1.1.ne_zero) y.1.1.ne_zero)] with p hxp hyp hpc hp
  rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hyp hp, hxp hp, map_mul, map_mul, hxp hp, hyp hp,
    ← mul_assoc, ← mul_assoc, mul_comm (x.2 _), mul_comm (y.2 _),
    mul_apply_eq_mul_apply_of_mem hx hy (hpc hp)]

/-- **The character determines the automorphism on the coefficient field** (LMFDB
`cmf.inner_twist_group`): if `(χ, σ)` and `(χ, σ')` are inner twist pairs of `f`, then `σ` and `σ'`
agree on the coefficients of `f`. -/
lemma apply_coeff_eq_of_fst_eq (hx : x ∈ f.innerTwistPairs) (hy : y ∈ f.innerTwistPairs)
    (hxy : x.1 = y.1) (m : ℕ) :
    x.2 ((qExpansion 1 f.toCuspForm).coeff m) = y.2 ((qExpansion 1 f.toCuspForm).coeff m) := by
  refine apply_coeff_eq_of_eventually_apply_coeff_eq ?_ m
  filter_upwards [hx.2, hy.2] with p hxp hyp hp
  rw [hxp hp, hyp hp, hxy]

end HeckeRing.GL2.Newform
