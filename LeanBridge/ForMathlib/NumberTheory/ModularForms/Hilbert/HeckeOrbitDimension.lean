import LeanBridge.ForMathlib.NumberTheory.ModularForms.Hilbert.HeckeFourier

/-!
# Dimensions of Hecke orbits of Hilbert modular forms

The Hecke orbit of a Hilbert modular form `f` (LMFDB `mf.hilbert.hecke_orbit`) is the space
spanned by the images of `f` under the Hecke operators `T_𝔞`, `𝔞` coprime to the level, and its
dimension (LMFDB `mf.hilbert.dimension`) is its dimension as a `ℚ`-vector space. Over `ℂ` the Hecke
orbit of a Hecke eigenform is the line `ℂ f` (`HilbertModularForm.heckeIdealOrbit_eq_span`), so
the dimension is that of a `ℚ`-structure: here the `ℚ`-span of the images of `f` under the finite
products of the `T_𝔞`, in the LMFDB's normalisation `N(𝔞)^{m/2 - 1} T_𝔞` for parallel weight `m`
(`HilbertModularForm.heckeIdealSpaceNormalised`). For an eigenform with eigenvalues `a_𝔞` it is
`E f`, where `E = ℚ(a_𝔞)` is the field generated by the eigenvalues, so its dimension is `[E : ℚ]`,
as the knowl states. The LMFDB computes Hecke orbits inside the forms with rational Fourier
coefficients, where the orbit of `f` is a Hecke-stable `ℚ`-subspace of the same dimension `[E : ℚ]`
(the number of Galois conjugates of `f`); rational structures on spaces of Hilbert modular forms
are not formalised.

## Main definitions

* `HilbertModularForm.rationalHeckeOrbit` (LMFDB `mf.hilbert.hecke_orbit`): the Hecke orbit as a
  `ℚ`-vector space.
* `HilbertModularForm.heckeOrbitDimension` (LMFDB `mf.hilbert.dimension`): its dimension.
* `HilbertModularForm.heckeField` (LMFDB `mf.hilbert.dimension`): the field generated by the Hecke
  eigenvalues of an eigenform.

## Main results

* `HilbertModularForm.heckeOrbitDimension_eq_finrank_heckeField`: the dimension of the Hecke orbit
  of a Hecke eigenform is the degree over `ℚ` of the field generated by its Hecke eigenvalues.
-/

open Module NumberField InfinitePlace

open scoped nonZeroDivisors

namespace Submonoid

lemma coe_closure_range_eq_range_listProd {ι M : Type*} [Monoid M] (g : ι → M) :
    (closure (Set.range g) : Set M) = Set.range fun l : List ι ↦ (l.map g).prod := by
  rw [← FreeMonoid.mrange_lift, MonoidHom.coe_mrange,
    ← FreeMonoid.toList.symm.surjective.range_comp]
  exact congrArg Set.range <| funext fun l ↦ FreeMonoid.lift_apply g _

end Submonoid

namespace IntermediateField

lemma finrank_adjoin_eq_finrank_algebraAdjoin {K L : Type*} [Field K] [Field L] [Algebra K L]
    (S : Set L) : Module.finrank K (adjoin K S) = Module.finrank K (Algebra.adjoin K S) := by
  by_cases h : ∀ x ∈ S, IsAlgebraic K x
  · rw [← adjoin_toSubalgebra_of_isAlgebraic h]
    rfl
  · push Not at h
    rcases h with ⟨x, hx, hxa⟩
    have h₁ : ¬Module.Finite K (adjoin K S) := fun hfin ↦ hxa <|
      ((IsIntegral.of_finite K (⟨x, subset_adjoin K S hx⟩ : adjoin K S)).map (val _)).isAlgebraic
    have h₂ : ¬Module.Finite K (Algebra.adjoin K S) := fun hfin ↦ hxa <|
      ((IsIntegral.of_finite K (⟨x, Algebra.subset_adjoin hx⟩ : Algebra.adjoin K S)).map
        (Algebra.adjoin K S).val).isAlgebraic
    rw [Module.finrank_of_not_finite h₁, Module.finrank_of_not_finite h₂]

end IntermediateField

namespace HilbertModularForm

variable {F : Type*} [Field F] [NumberField F] {k : {w : InfinitePlace F // w.IsReal} → ℤ}
  {𝔑 : Ideal (𝓞 F)} [NeZero 𝔑] {𝔟 : NarrowClassGroup F → (FractionalIdeal (𝓞 F)⁰ F)ˣ}
  {h𝔟 : ∀ c, NarrowClassGroup.mk (𝔟 c) = c} (m : ℤ) (f : HilbertModularForm 𝔑 k 𝔟 h𝔟)

/-- The **Hecke orbit** (LMFDB `mf.hilbert.hecke_orbit`) of a Hilbert modular form `f` of parallel
weight `m`, as a `ℚ`-vector space: the `ℚ`-subspace of the space of Hilbert modular forms spanned
by the images of `f` under the finite products of the Hecke operators `T_𝔞`, `𝔞` coprime to the
level, in the LMFDB's normalisation `N(𝔞)^{m/2 - 1} T_𝔞` (`heckeIdealSpaceNormalised`). Its
`ℂ`-span is the Hecke orbit `heckeIdealOrbit` over `ℂ`, the line `ℂ f` for an eigenform, while for
an eigenform this `ℚ`-structure is `E f`, `E` the field generated by the Hecke eigenvalues. -/
noncomputable def rationalHeckeOrbit : Submodule ℚ (space k 𝔑 𝔟) :=
  Submodule.span ℚ <| Set.range fun l : List {𝔞 : (Ideal (𝓞 F))⁰ // (𝔞 : Ideal (𝓞 F)) ⊔ 𝔑 = ⊤} ↦
    (l.map fun 𝔞 ↦ heckeIdealSpaceNormalised m 𝔞.1).prod ⟨f.toFun, f.toFun_mem_space⟩

/-- The **dimension** (LMFDB `mf.hilbert.dimension`) of the Hecke orbit of a Hilbert modular form
`f` of parallel weight `m`: the dimension of its Hecke orbit as a `ℚ`-vector space
(`rationalHeckeOrbit`), and `0` if it were infinite-dimensional. For a Hecke eigenform it is the
degree over `ℚ` of the field generated by the Hecke eigenvalues
(`heckeOrbitDimension_eq_finrank_heckeField`), which is finite since the eigenvalues are algebraic
(not proved here). -/
noncomputable def heckeOrbitDimension : ℕ :=
  Module.finrank ℚ (f.rationalHeckeOrbit m)

variable {f} (hf : f.IsHeckeIdealEigenform)

/-- The **Hecke field** `ℚ(a_𝔞)` (LMFDB `mf.hilbert.dimension`) of a Hecke eigenform `f` of
parallel weight `m`: the subfield of `ℂ` generated by its Hecke eigenvalues `a_𝔞` in the LMFDB's
normalisation (`heckeIdealEigenvalueNormalised`), at the nonzero ideals `𝔞` coprime to the level.
By the multiplicativity of the Hecke operators (not formalised here) it is generated by the `a_𝔭`
at the primes `𝔭` coprime to the level. -/
noncomputable def heckeField : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ <| Set.range fun 𝔞 : {𝔞 : (Ideal (𝓞 F))⁰ // ↑𝔞 ⊔ 𝔑 = ⊤} ↦
    heckeIdealEigenvalueNormalised m 𝔞.1 hf 𝔞.2

variable {m}

lemma prod_heckeIdealSpaceNormalised_apply (l : List {𝔞 : (Ideal (𝓞 F))⁰ // ↑𝔞 ⊔ 𝔑 = ⊤}) :
    (l.map fun 𝔞 ↦ heckeIdealSpaceNormalised m 𝔞.1).prod ⟨f.toFun, f.toFun_mem_space⟩ =
      (l.map fun 𝔞 ↦ heckeIdealEigenvalueNormalised m 𝔞.1 hf 𝔞.2).prod •
          (⟨f.toFun, f.toFun_mem_space⟩ : space k 𝔑 𝔟) := by
  induction l with
  | nil => simp
  | cons 𝔞 l ih =>
    rw [List.map_cons, List.prod_cons, End.mul_apply, ih, map_smul, List.map_cons, List.prod_cons,
      mul_comm, mul_smul, heckeIdealSpaceNormalised_apply 𝔞.1 hf 𝔞.2]

/-- **The dimension of the Hecke orbit of a Hecke eigenform is the degree of the field generated by
its Hecke eigenvalues** (LMFDB `mf.hilbert.dimension`): the images of `f` under the products of
the Hecke operators are the multiples of `f` by the products of the eigenvalues, which span the
`ℚ`-algebra `ℚ[a_𝔞]`, of the same dimension as the field `ℚ(a_𝔞)`. -/
lemma heckeOrbitDimension_eq_finrank_heckeField :
    f.heckeOrbitDimension m = Module.finrank ℚ (heckeField m hf) := by
  let φ : ℂ →ₗ[ℚ] space k 𝔑 𝔟 :=
    (LinearMap.toSpanSingleton ℂ _ ⟨f.toFun, f.toFun_mem_space⟩).restrictScalars ℚ
  have hv : (⟨f.toFun, f.toFun_mem_space⟩ : space k 𝔑 𝔟) ≠ 0 :=
    fun h ↦ hf.1 <| congrArg Subtype.val h
  have hφ : Function.Injective φ := smul_left_injective ℂ hv
  rw [heckeField, IntermediateField.finrank_adjoin_eq_finrank_algebraAdjoin,
    ← Subalgebra.finrank_toSubmodule, Algebra.adjoin_eq_span,
    Submonoid.coe_closure_range_eq_range_listProd, heckeOrbitDimension, rationalHeckeOrbit]
  refine Eq.trans ?_ (Submodule.equivMapOfInjective φ hφ _).finrank_eq.symm
  rw [← Submodule.span_image, ← Set.range_comp]
  exact congrArg (fun s ↦ Module.finrank ℚ (Submodule.span ℚ s)) <| congrArg Set.range <|
    funext fun l ↦ prod_heckeIdealSpaceNormalised_apply hf l

end HilbertModularForm
