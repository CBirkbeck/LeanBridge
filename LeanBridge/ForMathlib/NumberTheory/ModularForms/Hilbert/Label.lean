import LeanBridge.ForMathlib.NumberTheory.ModularForms.Hilbert.Basic
import LeanBridge.ForMathlib.NumberTheory.NumberField.IdealLabelHMF
import LeanBridge.ForMathlib.NumberTheory.NumberField.Label

/-!
# Labels of Hilbert modular forms

The LMFDB labels a Galois orbit of Hilbert cusp forms over a totally real field `F`, of level `𝔑`,
by `F-N.i-x`: the label `d.r.D.i` of the number field `F`, the label `N.i` of the level, and a
letter `x` distinguishing the orbits of the same field and level. The label `d.r.D.i` of a number
field records its degree `d`, its number `r` of real places and the absolute value `D` of its
discriminant, followed by the index of the field among those with the same `d`, `r` and `D`. The
level label predates the LMFDB's labels of ideals: `N` is the norm of `𝔑` and `i` distinguishes the
ideals of the same norm. The pages describe the level by a triple `[N, n, β]`, where `N` is the
norm of `𝔑`, `n` generates `𝔑 ∩ ℤ` and `β` is an element such that `𝔑 = (N, n, β)`.

The index of `F`, the index `i` of the level among the ideals of the same norm and the letter `x`
follow LMFDB orderings that the knowl does not specify: they are database numberings, with nothing
to formalise in them. The mathematically defined part of the label is the prefix `d.r.D` of the
label of `F`, which is `NumberField.labelPrefix F` and determines `d`, `r` and `D`
(`NumberField.labelPrefix_eq_iff`), and `N`.

The description `[N, n, β]` is the label of `𝔑` in the Hilbert modular form convention (LMFDB
`nf.ideal.label.hmf`), the relation `Ideal.IsHMFLabel 𝔑 N n β`. That relation asks for
`𝔑 = (n, β)`, which is the same as `𝔑 = (N, n, β)` since `N` lies in `𝔑 ∩ ℤ = nℤ`
(`Ideal.isHMFLabel_iff`). The entries `N` and `n` are determined by `𝔑`, `n` being
`Ideal.absNorm (Ideal.under ℤ 𝔑)`, the least positive integer in `𝔑` for `𝔑 ≠ 0`
(`Int.absNorm_under_eq_sInf`), and a suitable `β` exists for `𝔑 ≠ 0` (`Ideal.exists_isHMFLabel`),
since an ideal of a Dedekind domain is generated by any of its nonzero elements together with one
more element. The element `β` is not determined by `𝔑`, and the LMFDB's choice of it is not
specified.

## Main definitions

* `HilbertModularForm.Label` (LMFDB `mf.hilbert.label`): the mathematically defined part of the
  label of a Galois orbit of Hilbert modular forms.
* `HilbertModularForm.label` (LMFDB `mf.hilbert.label`): that of the orbit of a form.
-/

open NumberField

open scoped nonZeroDivisors

namespace HilbertModularForm

variable {F : Type*} [Field F] [NumberField F] {𝔑 : Ideal (𝓞 F)}
  {k : {w : InfinitePlace F // w.IsReal} → ℤ}
  {𝔟 : NarrowClassGroup F → (FractionalIdeal (𝓞 F)⁰ F)ˣ} {h𝔟 : ∀ c, NarrowClassGroup.mk (𝔟 c) = c}
  (f : HilbertModularForm 𝔑 k 𝔟 h𝔟)

/-- The mathematically defined part of the **label** `F-N.i-x` (LMFDB `mf.hilbert.label`) of a
Galois orbit of Hilbert cusp forms: the prefix `d.r.D` of the label `d.r.D.i` of the base field,
which records its degree `d`, its number `r` of real places and the absolute value `D` of its
discriminant, and the norm `N` of the level. The index of the field, the index `i` of the level and
the orbit letter `x` are database numberings. -/
structure Label where
  /-- The prefix `d.r.D` of the label of the base field (`NumberField.labelPrefix`), which
  determines `d`, `r` and `D` (`NumberField.labelPrefix_eq_iff`). -/
  fieldLabelPrefix : String
  /-- The norm `N` of the level. -/
  levelNorm : ℕ

/-- The mathematically defined part of the **label** `F-N.i-x` (LMFDB `mf.hilbert.label`) of the
Galois orbit of a Hilbert cusp form `f` over `F` (a newform, for the LMFDB): the label prefix
`d.r.D` of `F`, which records its degree, its number of real places and its absolute
discriminant, and the norm of the level of `f`. It depends only on `F` and the level, so it is
defined for every Hilbert modular form. -/
noncomputable def label : Label where
  fieldLabelPrefix := labelPrefix F
  levelNorm := f.levelNorm

end HilbertModularForm
