import TauCeti.NumberTheory.HeckeRing.GL2.Gamma0.Diagonal.Composite
import TauCeti.NumberTheory.ModularForms.HeckeSlash.Finite
import TauCeti.NumberTheory.ModularForms.HeckeSlash.Nebentypus.Action
import TauCeti.NumberTheory.ModularForms.ModularSymbols.Hecke.Finite
import TauCeti.NumberTheory.ModularForms.SturmBound

/-!
# Hecke algebras

For a commutative ring `R` and an `R`-module `M` with an action of Hecke operators, the `R`-Hecke
algebra is the `R`-subalgebra of `End_R(M)` generated by the Hecke operators (LMFDB
`hecke_algebra.definition`). The LMFDB includes all the Hecke operators, also those whose index
divides the level or is a multiple of the characteristic, and takes `R = ℚ` or `R = ℂ` when the
ring is not named.

The Hecke operators of the spaces `M_k(Γ₁(N))` and `S_k(Γ₁(N))` are Tau Ceti's `T_n` for every
`n ≥ 1` (`HeckeRing.GL2.heckeTNat`, `HeckeRing.GL2.heckeTCuspNat`, which are the `U_p` at the
primes `p ∣ N`) and the diamond operators `⟨d⟩` (`diamondOp`, `diamondOpCusp`). Tau Ceti's `T_n`
is the operator of the single double coset `Γ₁(N) diag(1, n) Γ₁(N)`, although its documentation
calls it the classical `T_n`: the two differ by diamond-operator terms when `n` is divisible by
the square of a prime `p ∤ N` (at `n = p²` by `p^{k-2}` times a diamond operator). With the
diamond operators among the generators, the algebra generated is the classical one. On the
spaces `M_k(N, χ)` and `S_k(N, χ)` with character the Hecke operators are the classical `T_n` of
the `Γ₀(N)` Hecke ring (`HeckeRing.GL2.heckeTCompositeGamma0`, acting through
`HeckeRing.GL2.heckeRingHomCharSpace` and `HeckeRing.GL2.heckeRingHomCuspCharSpace`), on which
the diamond operators act by the scalars `χ(d)`. These spaces are `ℂ`-vector spaces, and their
Hecke algebras are taken over `R = ℂ`. On Tau Ceti's modular symbols `𝕄_w(Γ₁(N); R)`, defined
over every commutative ring `R` (in particular over `ℚ` and over the finite fields), they are its
operators `T_n` for every `n ≥ 1`.

## Main definitions

* `Module.End.heckeAlgebra` (LMFDB `hecke_algebra.definition`): the `R`-Hecke algebra of a module
  with a family of Hecke operators.
* `HeckeRing.GL2.modularFormHeckeAlgebra`, `HeckeRing.GL2.cuspFormHeckeAlgebra`: the Hecke
  algebras of `M_k(Γ₁(N))` and `S_k(Γ₁(N))`.
* `HeckeRing.GL2.modFormCharSpaceHeckeAlgebra`, `HeckeRing.GL2.cuspFormCharSpaceHeckeAlgebra`:
  the Hecke algebras of `M_k(N, χ)` and `S_k(N, χ)`.
* `TauCeti.ModularSymbols.heckeAlgebra`: the `R`-Hecke algebra of the modular symbols
  `𝕄_w(Γ₁(N); R)`.

## Main results

* `Module.End.isMulCommutative_heckeAlgebra`: the Hecke algebra of commuting operators is
  commutative.
* `Module.End.finite_heckeAlgebra`: over a noetherian ring, the Hecke algebra of a finite module
  is a finite module.
* `HeckeRing.GL2.isMulCommutative_modFormCharSpaceHeckeAlgebra`,
  `HeckeRing.GL2.isMulCommutative_cuspFormCharSpaceHeckeAlgebra`: the Hecke algebras of the spaces
  with character are commutative.
* `HeckeRing.GL2.finite_modularFormHeckeAlgebra`, `HeckeRing.GL2.finite_cuspFormHeckeAlgebra`: the
  Hecke algebras of `M_k(Γ₁(N))` and `S_k(Γ₁(N))` are finite-dimensional.
* `HeckeRing.GL2.heckeTCuspAlgebra_le_restrictScalars_cuspFormHeckeAlgebra`: Tau Ceti's integral
  algebra `TauCeti.heckeTCuspAlgebra`, generated by the `T_n` alone, lies in the Hecke algebra of
  `S_k(Γ₁(N))`.
* `TauCeti.ModularSymbols.heckeAlgebra_int`: over `ℤ`, the Hecke algebra of the modular symbols
  is Tau Ceti's `TauCeti.ModularSymbols.heckeTAlgebra`.
-/

open Matrix SpecialLinearGroup CongruenceSubgroup TauCeti Module

namespace Module.End

variable (R : Type*) {M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (T : ι → Module.End R M)

/-- The **`R`-Hecke algebra** (LMFDB `hecke_algebra.definition`) of an `R`-module `M` equipped
with an action of Hecke operators `T i`: the `R`-subalgebra of the endomorphism ring `End_R(M)`
generated by the Hecke operators. -/
def heckeAlgebra : Subalgebra R (Module.End R M) :=
  Algebra.adjoin R (Set.range T)

lemma mem_heckeAlgebra (i : ι) : T i ∈ heckeAlgebra R T :=
  Algebra.subset_adjoin ⟨i, rfl⟩

lemma heckeAlgebra_le_iff {A : Subalgebra R (Module.End R M)} :
    heckeAlgebra R T ≤ A ↔ ∀ i, T i ∈ A :=
  Algebra.adjoin_le_iff.trans Set.range_subset_iff

/-- **The Hecke algebra of commuting operators is commutative.** -/
lemma isMulCommutative_heckeAlgebra (hT : ∀ i j, Commute (T i) (T j)) :
    IsMulCommutative (heckeAlgebra R T) :=
  Algebra.isMulCommutative_adjoin R <| by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ -
    exact hT i j

/-- **The Hecke algebra of a finite module over a noetherian ring is a finite module.** -/
lemma finite_heckeAlgebra [IsNoetherianRing R] [Module.Finite R M] :
    Module.Finite R (heckeAlgebra R T) :=
  inferInstanceAs (Module.Finite R (Subalgebra.toSubmodule (heckeAlgebra R T)))

end Module.End

namespace HeckeRing.GL2

variable {N : ℕ} [NeZero N] (k : ℤ) (n : ℕ) [NeZero n] (d : (ZMod N)ˣ)

/-- The Hecke operators on `M_k(Γ₁(N))`: the `T_n` for `n ≥ 1` and the diamond operators `⟨d⟩`. -/
noncomputable def modularFormHeckeOperator :
    ℕ+ ⊕ (ZMod N)ˣ → Module.End ℂ (ModularForm ((Gamma1 N).map (mapGL ℝ)) k)
  | .inl n => haveI : NeZero (n : ℕ) := ⟨n.ne_zero⟩
    heckeTNat k n
  | .inr d => diamondOp k d

/-- The **Hecke algebra of `M_k(Γ₁(N))`** (LMFDB `hecke_algebra.definition`), over `ℂ`: the
`ℂ`-subalgebra of `End(M_k(Γ₁(N)))` generated by the Hecke operators `T_n` for every `n ≥ 1`,
including the `U_p` at the primes `p ∣ N`, and the diamond operators `⟨d⟩`. Tau Ceti's `T_n` is
the operator of the single double coset `Γ₁(N) diag(1, n) Γ₁(N)`, which differs from the
classical `T_n` by terms involving diamond operators when `n` is divisible by the square of a
prime not dividing `N`; with the diamond operators among the generators the algebra is the
classical `ℂ[T_n, ⟨d⟩]`. -/
noncomputable def modularFormHeckeAlgebra :
    Subalgebra ℂ (Module.End ℂ (ModularForm ((Gamma1 N).map (mapGL ℝ)) k)) :=
  End.heckeAlgebra ℂ (modularFormHeckeOperator k)

lemma heckeTNat_mem_modularFormHeckeAlgebra : heckeTNat (N := N) k n ∈ modularFormHeckeAlgebra k :=
  End.mem_heckeAlgebra ℂ (modularFormHeckeOperator k) (.inl ⟨n, NeZero.pos n⟩)

lemma diamondOp_mem_modularFormHeckeAlgebra : diamondOp k d ∈ modularFormHeckeAlgebra k :=
  End.mem_heckeAlgebra ℂ (modularFormHeckeOperator k) (.inr d)

/-- **The Hecke algebra of `M_k(Γ₁(N))` is finite-dimensional.** -/
lemma finite_modularFormHeckeAlgebra : Module.Finite ℂ (modularFormHeckeAlgebra (N := N) k) :=
  End.finite_heckeAlgebra ℂ (modularFormHeckeOperator k)

/-- The Hecke operators on `S_k(Γ₁(N))`: the `T_n` for `n ≥ 1` and the diamond operators `⟨d⟩`. -/
noncomputable def cuspFormHeckeOperator :
    ℕ+ ⊕ (ZMod N)ˣ → Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)
  | .inl n => haveI : NeZero (n : ℕ) := ⟨n.ne_zero⟩
    heckeTCuspNat k n
  | .inr d => diamondOpCusp k d

/-- The **Hecke algebra of `S_k(Γ₁(N))`** (LMFDB `hecke_algebra.definition`), over `ℂ`: the
`ℂ`-subalgebra of `End(S_k(Γ₁(N)))` generated by the Hecke operators `T_n` for every `n ≥ 1`,
including the `U_p` at the primes `p ∣ N`, and the diamond operators `⟨d⟩` (with them, the
single double cosets `T_n` of Tau Ceti generate the classical algebra, see
`modularFormHeckeAlgebra`). It contains Tau Ceti's integral algebra `TauCeti.heckeTCuspAlgebra`,
generated by the `T_n` alone (`heckeTCuspAlgebra_le_restrictScalars_cuspFormHeckeAlgebra`). -/
noncomputable def cuspFormHeckeAlgebra :
    Subalgebra ℂ (Module.End ℂ (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)) :=
  End.heckeAlgebra ℂ (cuspFormHeckeOperator k)

lemma heckeTCuspNat_mem_cuspFormHeckeAlgebra :
    heckeTCuspNat (N := N) k n ∈ cuspFormHeckeAlgebra k :=
  End.mem_heckeAlgebra ℂ (cuspFormHeckeOperator k) (.inl ⟨n, NeZero.pos n⟩)

lemma diamondOpCusp_mem_cuspFormHeckeAlgebra : diamondOpCusp k d ∈ cuspFormHeckeAlgebra k :=
  End.mem_heckeAlgebra ℂ (cuspFormHeckeOperator k) (.inr d)

/-- **The Hecke algebra of `S_k(Γ₁(N))` is finite-dimensional.** -/
lemma finite_cuspFormHeckeAlgebra : Module.Finite ℂ (cuspFormHeckeAlgebra (N := N) k) :=
  End.finite_heckeAlgebra ℂ (cuspFormHeckeOperator k)

/-- **Tau Ceti's integral Hecke algebra of `S_k(Γ₁(N))` lies in its Hecke algebra**: the
`ℤ`-algebra `TauCeti.heckeTCuspAlgebra` generated by the `T_n` is contained in the Hecke algebra
`cuspFormHeckeAlgebra k`. -/
lemma heckeTCuspAlgebra_le_restrictScalars_cuspFormHeckeAlgebra :
    heckeTCuspAlgebra N k ≤ (cuspFormHeckeAlgebra k).restrictScalars ℤ :=
  (heckeTCuspAlgebra_le_iff N k _).mpr fun n _ ↦ heckeTCuspNat_mem_cuspFormHeckeAlgebra k n

lemma commute_heckeTCompositeGamma0 (a b : ℕ+) :
    Commute (heckeTCompositeGamma0 N a) (heckeTCompositeGamma0 N b) :=
  HeckeCosetModule.mul_comm_of_antiInvolution ℤ (atkinLehnerAntiInvolution N)
    (atkinLehnerAntiInvolution_onHeckeCoset_eq_self N) _ _

variable (χ : (ZMod N)ˣ →* ℂˣ)

/-- The **Hecke algebra of `M_k(N, χ)`** (LMFDB `hecke_algebra.definition`), over `ℂ`: the
`ℂ`-subalgebra of `End(M_k(N, χ))` generated by the classical Hecke operators `T_n` for every
`n ≥ 1` (`heckeTCompositeGamma0`), including those whose index is not prime to `N`. The diamond
operators act on `M_k(N, χ)` by the scalars `χ(d)`. -/
noncomputable def modFormCharSpaceHeckeAlgebra :
    Subalgebra ℂ (Module.End ℂ (modFormCharSpace k χ)) :=
  End.heckeAlgebra ℂ fun n : ℕ+ ↦ heckeRingHomCharSpace k χ (heckeTCompositeGamma0 N n)

/-- The **Hecke algebra of `S_k(N, χ)`** (LMFDB `hecke_algebra.definition`), over `ℂ`: the
`ℂ`-subalgebra of `End(S_k(N, χ))` generated by the classical Hecke operators `T_n` for every
`n ≥ 1` (`heckeTCompositeGamma0`), including those whose index is not prime to `N`. The diamond
operators act on `S_k(N, χ)` by the scalars `χ(d)`. -/
noncomputable def cuspFormCharSpaceHeckeAlgebra :
    Subalgebra ℂ (Module.End ℂ (cuspFormCharSpace k χ)) :=
  End.heckeAlgebra ℂ fun n : ℕ+ ↦ heckeRingHomCuspCharSpace k χ (heckeTCompositeGamma0 N n)

/-- **The Hecke algebra of `M_k(N, χ)` is commutative**, as the `Γ₀(N)` Hecke ring is. -/
lemma isMulCommutative_modFormCharSpaceHeckeAlgebra :
    IsMulCommutative (modFormCharSpaceHeckeAlgebra k χ) :=
  End.isMulCommutative_heckeAlgebra ℂ _ fun a b ↦
    (commute_heckeTCompositeGamma0 a b).map (heckeRingHomCharSpace k χ)

/-- **The Hecke algebra of `S_k(N, χ)` is commutative**, as the `Γ₀(N)` Hecke ring is. -/
lemma isMulCommutative_cuspFormCharSpaceHeckeAlgebra :
    IsMulCommutative (cuspFormCharSpaceHeckeAlgebra k χ) :=
  End.isMulCommutative_heckeAlgebra ℂ _ fun a b ↦
    (commute_heckeTCompositeGamma0 a b).map (heckeRingHomCuspCharSpace k χ)

end HeckeRing.GL2

namespace TauCeti.ModularSymbols

variable (R : Type*) [CommRing R] (N w : ℕ) [NeZero N]

/-- The Hecke operators on the modular symbols `𝕄_w(Γ₁(N); R)`: the `T_n` for `n ≥ 1`. -/
noncomputable def heckeOperator (n : ℕ+) : Module.End R (ModularSymbols R (Gamma1 N) w) :=
  haveI : NeZero (n : ℕ) := ⟨n.ne_zero⟩
  heckeTSymbol R w N n

/-- The **`R`-Hecke algebra of the modular symbols** `𝕄_w(Γ₁(N); R)` of weight `w + 2` (LMFDB
`hecke_algebra.definition`): the `R`-subalgebra of `End_R(𝕄_w(Γ₁(N); R))` generated by the Hecke
operators `T_n` for every `n ≥ 1`, including those whose index divides the level or is a multiple
of the characteristic of `R`. Over `ℤ` it is Tau Ceti's `TauCeti.ModularSymbols.heckeTAlgebra`
(`heckeAlgebra_int`). -/
noncomputable def heckeAlgebra : Subalgebra R (Module.End R (ModularSymbols R (Gamma1 N) w)) :=
  End.heckeAlgebra R (heckeOperator R N w)

lemma heckeTSymbol_mem_heckeAlgebra (n : ℕ) [NeZero n] :
    heckeTSymbol R w N n ∈ heckeAlgebra R N w :=
  End.mem_heckeAlgebra R (heckeOperator R N w) ⟨n, NeZero.pos n⟩

/-- **Over `ℤ`, the Hecke algebra of the modular symbols is Tau Ceti's integral Hecke algebra**
`TauCeti.ModularSymbols.heckeTAlgebra`. -/
lemma heckeAlgebra_int : heckeAlgebra ℤ N w = heckeTAlgebra N w :=
  le_antisymm ((End.heckeAlgebra_le_iff ℤ _).mpr fun n ↦
      have : NeZero (n : ℕ) := ⟨n.ne_zero⟩
      heckeTSymbol_mem_heckeTAlgebra N w n)
    ((heckeTAlgebra_le_iff N w _).mpr fun n _ ↦ heckeTSymbol_mem_heckeAlgebra ℤ N w n)

end TauCeti.ModularSymbols
