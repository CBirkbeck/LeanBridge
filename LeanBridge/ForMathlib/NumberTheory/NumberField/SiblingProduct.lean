import LeanBridge.ForMathlib.NumberTheory.NumberField.Sibling
import Mathlib.RingTheory.Artinian.Module
import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# The Galois closure of a product of fields

The LMFDB (`nf.sibling`) considers finite separable algebras over a field `F`, which are finite
products of finite separable field extensions `K_i` of `F` (number fields when `F = ℚ`), and calls
the compositum of the Galois closures of the `K_i` the Galois closure of the algebra.
`Algebra.galoisClosure F A` is defined for any `F`-algebra `A` as the subfield of `F̄` generated by
the images of all `F`-algebra maps `A → F̄`. This file proves that the two agree: an `F`-algebra map
from `∏ K_i` to a field factors through a projection, so for `A ≅ ∏ K_i` the Galois closure of `A`
is the compositum in `F̄` of the normal closures of the `K_i`, which are their Galois closures. It
also proves the decomposition itself for Mathlib's `Algebra.IsSeparable`: a finite-dimensional
separable commutative `F`-algebra is reduced, hence the product of its quotients by its maximal
ideals, fields that are finite-dimensional and separable over `F`.

## Main definitions

* `Algebra.algEquivPiOfIsSeparable` (LMFDB `nf.sibling`): a finite-dimensional separable commutative
  `F`-algebra `A` is the product of the fields `A ⧸ m` over its maximal ideals `m`.

## Main results

* `Algebra.isSeparable_quotient`: a quotient of a separable algebra is separable.
* `Algebra.galoisClosure_pi`: the Galois closure of a finite product of fields is the compositum of
  the Galois closures of the factors.
* `Algebra.galoisClosure_eq_iSup_normalClosure` (LMFDB `nf.sibling`): the Galois closure of an
  algebra `A ≅ ∏ K_i` is the compositum in `F̄` of the normal closures of the `K_i`.
-/

open Polynomial

namespace Algebra

variable {F : Type*} [Field F] {A B : Type*} [CommRing A] [Algebra F A] [CommRing B] [Algebra F B]
  {ι : Type*} [Finite ι] {K : ι → Type*} [∀ i, Field (K i)] [∀ i, Algebra F (K i)] {L : Type*}
  [Field L] [Algebra F L]

lemma isReduced_of_isSeparable [Algebra.IsSeparable F A] : IsReduced A := by
  refine ⟨fun x ⟨n, hn⟩ ↦ ?_⟩
  rcases n.eq_zero_or_pos with rfl | hn0
  · rw [pow_zero] at hn
    rw [← mul_one x, hn, mul_zero]
  · have hdvd : minpoly F x ∣ X ^ n := minpoly.dvd F x (by simp [hn])
    rcases ((IsSeparable.isSeparable F x).squarefree.dvd_pow_iff_dvd hn0.ne').mp hdvd with ⟨q, hq⟩
    have hx : aeval x X = aeval x (minpoly F x * q) := congrArg (aeval x) hq
    rwa [aeval_X, map_mul, minpoly.aeval, zero_mul] at hx

open Ideal in
/-- **A quotient of a separable algebra is separable.** -/
lemma isSeparable_quotient [Algebra.IsSeparable F A] (I : Ideal A) :
    Algebra.IsSeparable F (A ⧸ I) := by
  refine ⟨fun y ↦ ?_⟩
  rcases Quotient.mkₐ_surjective F I y with ⟨x, rfl⟩
  refine (IsSeparable.isSeparable F x).of_dvd <| minpoly.dvd F _ ?_
  rw [aeval_algHom_apply, minpoly.aeval, map_zero]

variable (F A) in
/-- A finite-dimensional separable commutative `F`-algebra `A` (LMFDB `nf.sibling`) is the product
of its quotients `A ⧸ m` by its finitely many maximal ideals `m`: these are fields
(`Ideal.Quotient.maximal_ideal_iff_isField_quotient`), finite-dimensional and separable over `F`
(`isSeparable_quotient`), hence number fields when `F = ℚ`. Indeed `A` is reduced, since a nilpotent
element has a separable minimal polynomial dividing a power of `X`, and Artinian. -/
noncomputable def algEquivPiOfIsSeparable [FiniteDimensional F A] [Algebra.IsSeparable F A] :
    A ≃ₐ[F] Π m : MaximalSpectrum A, A ⧸ m.asIdeal :=
  haveI : IsReduced A := isReduced_of_isSeparable (F := F)
  haveI : IsArtinianRing A := isArtinian_of_tower F inferInstance
  (IsArtinianRing.equivPi A).restrictScalars F

lemma exists_algHom_eq_comp_evalAlgHom (f : (Π i, K i) →ₐ[F] L) :
    ∃ (i : ι) (g : K i →ₐ[F] L), f = g.comp (Pi.evalAlgHom F K i) := by
  rcases PrimeSpectrum.exists_comap_evalRingHom_eq ⟨RingHom.ker f, RingHom.ker_isPrime f⟩ with
    ⟨i, q, hq⟩
  have hle : RingHom.ker (Pi.evalAlgHom F K i).toRingHom ≤ RingHom.ker f.toRingHom := fun x hx ↦ by
    have hx0 : x i = 0 := hx
    have hx' : x ∈ (PrimeSpectrum.comap (Pi.evalRingHom K i) q).asIdeal := by
      simp [hx0]
    rw [hq] at hx'
    exact hx'
  exact ⟨i, (Pi.evalAlgHom F K i).liftOfSurjective (Function.surjective_eval i) f hle,
    (AlgHom.liftOfSurjective_comp _ _ _ _).symm⟩

lemma galoisClosure_congr (e : A ≃ₐ[F] B) : galoisClosure F A = galoisClosure F B := by
  unfold galoisClosure
  congr 1
  ext x
  simp only [Set.mem_iUnion]
  exact ⟨fun ⟨f, a, ha⟩ ↦ ⟨f.comp e.symm.toAlgHom, e a, by simp [ha]⟩,
    fun ⟨f, b, hb⟩ ↦ ⟨f.comp e.toAlgHom, e.symm b, by simp [hb]⟩⟩

/-- **The Galois closure of a finite product of fields is the compositum of the Galois closures
of the factors**, since every `F`-algebra map from the product to `F̄` factors through a
projection. -/
lemma galoisClosure_pi : galoisClosure F (Π i, K i) = ⨆ i, galoisClosure F (K i) := by
  refine le_antisymm (IntermediateField.adjoin_le_iff.mpr ?_) (iSup_le fun i ↦ ?_)
  · rintro - ⟨-, ⟨f, rfl⟩, x, rfl⟩
    rcases exists_algHom_eq_comp_evalAlgHom f with ⟨i, g, rfl⟩
    exact le_iSup (fun i ↦ galoisClosure F (K i)) i <|
      IntermediateField.subset_adjoin F _ <| Set.mem_iUnion.mpr ⟨g, x i, rfl⟩
  · refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro - ⟨-, ⟨g, rfl⟩, y, rfl⟩
    rcases Function.surjective_eval i y with ⟨x, rfl⟩
    exact IntermediateField.subset_adjoin F _ <|
      Set.mem_iUnion.mpr ⟨g.comp (Pi.evalAlgHom F K i), x, rfl⟩

/-- **The Galois closure of an algebra is the compositum of the Galois closures of its constituent
fields** (LMFDB `nf.sibling`): for `A ≅ ∏ K_i`, `Algebra.galoisClosure F A` is the compositum in
`F̄` of the normal closures of the `K_i`, which are their Galois closures when the `K_i` are finite
separable over `F`. -/
lemma galoisClosure_eq_iSup_normalClosure (e : A ≃ₐ[F] Π i, K i) :
    galoisClosure F A = ⨆ i, IntermediateField.normalClosure F (K i) (AlgebraicClosure F) := by
  rw [galoisClosure_congr e, galoisClosure_pi]
  exact iSup_congr fun i ↦ galoisClosure_eq_normalClosure (K i)

end Algebra
