import Mathlib.Algebra.Field.ZMod
import Mathlib.Topology.Compactification.OnePoint.ProjectiveLine
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.ProjGenLinGroup
import LeanBridge.ForMathlib.GroupTheory.Perm.MulAut
import LeanBridge.ForMathlib.LinearAlgebra.Projectivization.ProjGenLinAction
import LeanBridge.ForMathlib.NumberTheory.NumberField.SexticTwin.OuterAutomorphism

/-!
# The outer automorphism of `S₆` interchanges `S₅` and `PGL₂(𝔽₅)`

The symmetric group `S_n` has an automorphism that is not inner exactly for `n = 6`: for `n ≠ 6`
all its automorphisms are inner (`Equiv.Perm.surjective_conj_of_card_ne_six`), while `S₆` has the
outer automorphism `θ` of `Equiv.Perm.outerAutFinSix`, unique up to inner automorphisms.

The group `PGL₂(𝔽₅)` acts faithfully on the six points of the projective line
`ℙ¹(𝔽₅) = 𝔽₅ ∪ {∞}` (`Matrix.ProjGenLinGroup.toPermHom_injective`), which we label by `Fin 6`:
`x ∈ 𝔽₅` by `x ∈ {0, …, 4}`, and `∞` by `5`; so its image in `S₆` is a copy of `PGL₂(𝔽₅)`. The
outer automorphism `θ` sends the stabilizer of the point `5`, a copy of `S₅`, onto this image, and
the image back onto the stabilizer, as `θ` is an involution. The stabilizer of `5` is generated by
the `5`-cycle `(0 1 2 3 4)` (Mathlib's `Fin.cycleRange 4`), which `θ` fixes and which is the
translation `z ↦ z + 1`, and by the transposition `(0 1)`, which `θ` sends to `(0 4)(1 2)(3 5)`,
the transformation `z ↦ (3z + 3)/(z + 2)`. So `θ(S₅)` lies in the image of `PGL₂(𝔽₅)`, and both
have order `120`. Any other outer automorphism of `S₆` is `θ` composed with an inner automorphism,
so it sends `S₅` onto a conjugate of the image of `PGL₂(𝔽₅)`.

## Main definitions

* `Equiv.Perm.finSixEquivOnePoint`: the labelling of `ℙ¹(𝔽₅) = 𝔽₅ ∪ {∞}` by `Fin 6`.
* `Equiv.Perm.pglTwoFiveToPerm` (LMFDB `nf.sextic_twin`): the action of `PGL₂(𝔽₅)` on the six
  points of `ℙ¹(𝔽₅)`, as a homomorphism to `S₆`.

## Main results

* `Equiv.Perm.exists_isOuter_iff` (LMFDB `nf.sextic_twin`): `S_n` has an outer automorphism if and
  only if `n = 6`.
* `Matrix.ProjGenLinGroup.card_two_zmod_five`: `PGL₂(𝔽₅)` has order `120`.
* `Equiv.Perm.map_stabilizer_outerAutFinSix` (LMFDB `nf.sextic_twin`): `θ` sends the stabilizer of
  `5`, a copy of `S₅`, onto the image of `PGL₂(𝔽₅)`.
* `Equiv.Perm.map_range_pglTwoFiveToPerm_outerAutFinSix` (LMFDB `nf.sextic_twin`): `θ` sends the
  image of `PGL₂(𝔽₅)` onto the stabilizer of `5`.
* `Equiv.Perm.injective_pglTwoFiveToPerm` (LMFDB `nf.sextic_twin`): `PGL₂(𝔽₅)` acts faithfully on
  `ℙ¹(𝔽₅)`, so its image is isomorphic to `PGL₂(𝔽₅)`.
* `Equiv.Perm.exists_map_stabilizer_eq_map_conj_range` (LMFDB `nf.sextic_twin`): every outer
  automorphism of `S₆` sends the stabilizer of `5` onto a conjugate of the image of `PGL₂(𝔽₅)`.
-/

open Matrix MulAction Subgroup

open scoped MatrixGroups LinearAlgebra.Projectivization OnePoint

private local instance : Fact (Nat.Prime 5) :=
  ⟨Nat.prime_five⟩

namespace Matrix.ProjGenLinGroup

/-- **`PGL₂(𝔽₅)` has order `120`**, that is `5³ - 5` (Tau Ceti's `TauCeti.natCard_PGL_fin_two`). -/
lemma card_two_zmod_five : Nat.card PGL(2, ZMod 5) = 120 := by
  rw [TauCeti.natCard_PGL_fin_two, ZMod.card]
  rfl

end Matrix.ProjGenLinGroup

namespace Equiv.Perm

/-- **The symmetric group `S_n` has an outer automorphism if and only if `n = 6`** (LMFDB
`nf.sextic_twin`): for `n ≠ 6` every automorphism is inner
(`Equiv.Perm.surjective_conj_of_card_ne_six`), and for `n = 6` the outer automorphism `θ` of
`Equiv.Perm.outerAutFinSix`, transported along a bijection with `Fin 6`, is not inner. -/
lemma exists_isOuter_iff {α : Type*} [DecidableEq α] [Fintype α] :
    (∃ φ : MulAut (Perm α), φ.IsOuter) ↔ Nat.card α = 6 := by
  refine ⟨fun ⟨φ, hφ⟩ ↦ by_contra fun h ↦ hφ (surjective_conj_of_card_ne_six h φ), fun h ↦ ?_⟩
  let E : Perm α ≃* Perm (Fin 6) :=
    (Fintype.equivFinOfCardEq (by rwa [← Nat.card_eq_fintype_card])).permCongrHom
  refine ⟨E.trans (outerAutFinSix.trans E.symm), fun ⟨g, hg⟩ ↦
    isOuter_outerAutFinSix ⟨E g, MulEquiv.ext fun σ ↦ ?_⟩⟩
  have h1 : E (MulAut.conj g (E.symm σ)) = E (E.trans (outerAutFinSix.trans E.symm) (E.symm σ)) :=
    congrArg E (DFunLike.congr_fun hg (E.symm σ))
  simp only [MulAut.conj_apply, map_mul, MulEquiv.apply_symm_apply, map_inv,
    MulEquiv.trans_apply] at h1
  rw [MulAut.conj_apply, h1]

/-- The labelling of the projective line `ℙ¹(𝔽₅) = 𝔽₅ ∪ {∞}` by `Fin 6`: `x ∈ {0, …, 4}` labels
`x ∈ 𝔽₅`, and `5` labels `∞`. -/
def finSixEquivOnePoint : Fin 6 ≃ OnePoint (ZMod 5) where
  toFun i := if i = 5 then ∞ else ((i : ℕ) : ZMod 5)
  invFun x := x.elim 5 fun y ↦ ⟨y.val, (ZMod.val_lt y).trans (by decide)⟩
  left_inv i := by
    fin_cases i <;> rfl
  right_inv x := by
    induction x with
    | infty => rfl
    | coe y => fin_cases y <;> rfl

/-- **`PGL₂(𝔽₅)` acting on the six points of the projective line `ℙ¹(𝔽₅)`** (LMFDB
`nf.sextic_twin`), labelled by `Fin 6` through `Equiv.Perm.finSixEquivOnePoint` (with `∞` labelled
by `5`): the image of `PGL₂(𝔽₅)` in `S₆`. -/
noncomputable def pglTwoFiveToPerm : PGL(2, ZMod 5) →* Perm (Fin 6) :=
  ((OnePoint.equivProjectivization (ZMod 5)).symm.trans
    finSixEquivOnePoint.symm).permCongrHom.toMonoidHom.comp
      (MulAction.toPermHom PGL(2, ZMod 5) (ℙ (ZMod 5) (Fin 2 → ZMod 5)))

/-- Whether the Möbius transformation `z ↦ (a z + b) / (c z + d)` of `ℙ¹(𝔽₅)` sends the point
labelled `i` to the point labelled `j` (`Equiv.Perm.finSixEquivOnePoint`), tested without
division. -/
def mobiusSends (a b c d : ZMod 5) (i j : Fin 6) : Bool :=
  if i = 5 then
    if j = 5 then c = 0 else c ≠ 0 && a = ((j : ℕ) : ZMod 5) * c
  else if j = 5 then c * ((i : ℕ) : ZMod 5) + d = 0
  else c * ((i : ℕ) : ZMod 5) + d ≠ 0 &&
    a * ((i : ℕ) : ZMod 5) + b = ((j : ℕ) : ZMod 5) * (c * ((i : ℕ) : ZMod 5) + d)

variable (g : GL (Fin 2) (ZMod 5)) (i j : Fin 6)

lemma pglTwoFiveToPerm_mk_apply : pglTwoFiveToPerm (ProjGenLinGroup.mk g) i =
    finSixEquivOnePoint.symm (g • finSixEquivOnePoint i) :=
  rfl

lemma pglTwoFiveToPerm_mk_apply_eq_iff : pglTwoFiveToPerm (ProjGenLinGroup.mk g) i = j ↔
    mobiusSends (g 0 0) (g 0 1) (g 1 0) (g 1 1) i j := by
  rw [pglTwoFiveToPerm_mk_apply, Equiv.symm_apply_eq]
  rcases eq_or_ne i 5 with rfl | hi <;> rcases eq_or_ne j 5 with rfl | hj
  · simp [finSixEquivOnePoint, OnePoint.smul_infty_eq_self_iff, mobiusSends]
  · simp only [finSixEquivOnePoint, coe_fn_mk, ↓reduceIte, OnePoint.smul_infty_eq_ite,
      mobiusSends]
    split_ifs with hc
    · simp [hc]
    · simp [hc, div_eq_iff hc]
  · simp only [finSixEquivOnePoint, coe_fn_mk, hi, ↓reduceIte, OnePoint.smul_some_eq_ite,
      mobiusSends]
    split_ifs with hc
    · simp [hc]
    · simp [hc]
  · simp only [finSixEquivOnePoint, coe_fn_mk, hi, ↓reduceIte, OnePoint.smul_some_eq_ite,
      mobiusSends]
    split_ifs with hc
    · simp [hc]
    · simp [hc, div_eq_iff hc]

lemma pglTwoFiveToPerm_mk_eq_of_forall (A : Matrix (Fin 2) (Fin 2) (ZMod 5)) (hA : A.det ≠ 0)
    {τ : Perm (Fin 6)} (h : ∀ i, mobiusSends (A 0 0) (A 0 1) (A 1 0) (A 1 1) i (τ i)) :
    pglTwoFiveToPerm (ProjGenLinGroup.mk (GeneralLinearGroup.mkOfDetNeZero A hA)) = τ :=
  Equiv.ext fun i ↦ (pglTwoFiveToPerm_mk_apply_eq_iff _ i (τ i)).mpr (h i)

lemma outerAutFinSix_cycleRange_four : outerAutFinSix (Fin.cycleRange 4) = Fin.cycleRange 4 :=
  outerAutFinSix_eq_of_forall <| by decide

lemma cycleRange_four_ne_five_iff (x : Fin 6) : Fin.cycleRange 4 x ≠ 5 ↔ x ≠ 5 := by
  revert x
  decide

lemma range_ofSubtype_eq_stabilizer_five :
    (ofSubtype : Perm {x : Fin 6 // x ≠ 5} →* Perm (Fin 6)).range =
      stabilizer (Perm (Fin 6)) (5 : Fin 6) := by
  ext g
  rw [mem_range_ofSubtype_iff, mem_stabilizer_iff, Perm.smul_def]
  refine ⟨fun h ↦ by_contra fun h5 ↦ h (mem_support.mpr h5) rfl, fun h x hx ↦ ?_⟩
  rintro rfl
  exact mem_support.mp hx h

lemma closure_cycleRange_four_swap_zero_one :
    closure {Fin.cycleRange 4, swap 0 1} = stabilizer (Perm (Fin 6)) (5 : Fin 6) := by
  have hcard : Fintype.card {x : Fin 6 // x ≠ 5} = 5 := by decide
  have hσ : ((Fin.cycleRange 4).subtypePerm cycleRange_four_ne_five_iff).IsCycle :=
    isCycle_of_prime_order'' (by rw [hcard]; exact Nat.prime_five)
      ((orderOf_eq_prime (by decide) (by decide)).trans hcard.symm)
  rw [← range_ofSubtype_eq_stabilizer_five, MonoidHom.range_eq_map,
    ← closure_cycle_adjacent_swap hσ (by decide) ⟨0, by decide⟩, MonoidHom.map_closure,
    Set.image_pair, ofSubtype_subtypePerm cycleRange_four_ne_five_iff (by decide),
    ofSubtype_swap_eq]
  rfl

lemma natCard_stabilizer_five : Nat.card (stabilizer (Perm (Fin 6)) (5 : Fin 6)) = 120 := by
  rw [← range_ofSubtype_eq_stabilizer_five,
    Nat.card_congr (MonoidHom.ofInjective ofSubtype_injective).toEquiv.symm, Nat.card_perm,
    Nat.card_eq_fintype_card]
  rfl

/-- **The outer automorphism `θ` of `S₆` sends `S₅` onto `PGL₂(𝔽₅)`** (LMFDB `nf.sextic_twin`):
the image under `θ` of the stabilizer of the point `5` is the image of `PGL₂(𝔽₅)` acting on the
projective line `ℙ¹(𝔽₅)`, labelled by `Fin 6` (`Equiv.Perm.pglTwoFiveToPerm`). The stabilizer is
generated by `(0 1 2 3 4)` and `(0 1)`, which `θ` sends to the transformations `z ↦ z + 1` and
`z ↦ (3z + 3)/(z + 2)`, and both groups have order `120`. -/
lemma map_stabilizer_outerAutFinSix :
    (stabilizer (Perm (Fin 6)) (5 : Fin 6)).map outerAutFinSix.toMonoidHom =
      pglTwoFiveToPerm.range := by
  refine eq_of_le_of_card_ge ?_ ?_
  · rw [← closure_cycleRange_four_swap_zero_one, MonoidHom.map_closure, Set.image_pair,
      Subgroup.closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    simp only [MulEquiv.coe_toMonoidHom, outerAutFinSix_cycleRange_four,
      outerAutFinSix_swap_zero_one]
    exact ⟨⟨_, pglTwoFiveToPerm_mk_eq_of_forall !![1, 1; 0, 1] (by rw [det_fin_two_of]; decide)
      (by decide)⟩, ⟨_, pglTwoFiveToPerm_mk_eq_of_forall !![3, 3; 1, 2]
        (by rw [det_fin_two_of]; decide) (by decide)⟩⟩
  · rw [card_map_of_injective (f := outerAutFinSix.toMonoidHom) outerAutFinSix.injective,
      natCard_stabilizer_five, ← ProjGenLinGroup.card_two_zmod_five]
    exact Nat.card_le_card_of_surjective _ pglTwoFiveToPerm.rangeRestrict_surjective

/-- **The outer automorphism `θ` of `S₆` sends `PGL₂(𝔽₅)` onto `S₅`** (LMFDB `nf.sextic_twin`):
the image under `θ` of the image of `PGL₂(𝔽₅)` is the stabilizer of the point `5`, as `θ` is an
involution (`Equiv.Perm.map_stabilizer_outerAutFinSix`). -/
lemma map_range_pglTwoFiveToPerm_outerAutFinSix :
    pglTwoFiveToPerm.range.map outerAutFinSix.toMonoidHom =
      stabilizer (Perm (Fin 6)) (5 : Fin 6) := by
  have h : outerAutFinSix.toMonoidHom.comp outerAutFinSix.toMonoidHom = MonoidHom.id _ :=
    MonoidHom.ext outerAutFinSix_outerAutFinSix
  rw [← map_stabilizer_outerAutFinSix, Subgroup.map_map, h, Subgroup.map_id]

lemma natCard_range_pglTwoFiveToPerm : Nat.card pglTwoFiveToPerm.range = 120 := by
  rw [← map_stabilizer_outerAutFinSix,
    card_map_of_injective (f := outerAutFinSix.toMonoidHom) outerAutFinSix.injective,
    natCard_stabilizer_five]

/-- **`PGL₂(𝔽₅)` acts faithfully on the projective line `ℙ¹(𝔽₅)`** (LMFDB `nf.sextic_twin`), so
that its image in `S₆` is isomorphic to `PGL₂(𝔽₅)`: the case `n = 2`, `K = 𝔽₅` of
`Matrix.ProjGenLinGroup.toPermHom_injective`. -/
lemma injective_pglTwoFiveToPerm : Function.Injective pglTwoFiveToPerm :=
  (Equiv.permCongrHom _).injective.comp ProjGenLinGroup.toPermHom_injective

/-- **Every outer automorphism of `S₆` sends `S₅` onto a conjugate of `PGL₂(𝔽₅)`** (LMFDB
`nf.sextic_twin`): it is `θ` composed with an inner automorphism
(`Equiv.Perm.exists_eq_outerAutFinSix_mul_conj`). -/
lemma exists_map_stabilizer_eq_map_conj_range {φ : MulAut (Perm (Fin 6))} (hφ : φ.IsOuter) :
    ∃ τ, (stabilizer (Perm (Fin 6)) (5 : Fin 6)).map φ.toMonoidHom =
      pglTwoFiveToPerm.range.map (MulAut.conj τ).toMonoidHom := by
  rcases exists_eq_outerAutFinSix_mul_conj hφ with ⟨k, rfl⟩
  have h : (outerAutFinSix * MulAut.conj k).toMonoidHom =
      (MulAut.conj (outerAutFinSix k)).toMonoidHom.comp outerAutFinSix.toMonoidHom :=
    MonoidHom.ext fun σ ↦ by
      rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.coe_toMonoidHom,
        MulEquiv.coe_toMonoidHom, MulAut.mul_apply, MulAut.conj_apply, MulAut.conj_apply,
        map_mul, map_mul, map_inv]
  rw [h, ← Subgroup.map_map, map_stabilizer_outerAutFinSix]
  exact ⟨outerAutFinSix k, rfl⟩

end Equiv.Perm
