import TauCeti.NumberTheory.NumberField.Cyclotomic.MaximalRealSubfield
import TauCeti.NumberTheory.NumberField.Cyclotomic.SeventhCyclotomic.Quadratic
import LeanBridge.ForMathlib.NumberTheory.Cyclotomic.MaximalRealSubfieldAdjoin
import LeanBridge.ForMathlib.NumberTheory.MulChar.GaloisAction
import LeanBridge.ForMathlib.NumberTheory.NumberField.SexticTwin.Cyclic
import LeanBridge.ForMathlib.NumberTheory.NumberField.SexticTwin.GaloisDescent

/-!
# The twin of the seventh cyclotomic field

The seventh cyclotomic field `ℚ(ζ₇)` is a sextic number field (`Algebra.finrank_seventhCyclotomic`)
whose twin (LMFDB `nf.sextic_twin`) is not a field: it is the product `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`
of the subfields of `ℚ(ζ₇)` of degrees `1`, `2` and `3`. This is the knowl's "common situation"
where `A` is a field but `B` is not. The results hold for every seventh cyclotomic field `K` over
`ℚ`, such as the subfield of `ℂ` generated by the seventh roots of unity (the instances
`IsCyclotomicExtension {7} ℚ (adjoin ℚ {b : ℂ | b ^ 7 = 1})` and
`NumberField (adjoin ℚ {b : ℂ | b ^ 7 = 1})` of the file on the Galois action on characters): an
actual sextic number field whose twin is not a field
(`Algebra.not_isField_sexticTwin_adjoin_seventh_roots`).

The Galois group of `K` is cyclic of order `6`, generated by the automorphism `γ : ζ₇ ↦ ζ₇ ^ 3`
(Tau Ceti's `TauCeti.NumberField.frobeniusThreeSeven`), so no twin of `K` is a field
(`Algebra.IsSexticTwin.not_isField_of_isCyclic`). To compute the twin, we label the Galois set
`Hom(K, ℚ^sep)` by `ι ∘ γ ^ i ↦ i` for an embedding `ι : K → ℚ^sep`
(`Algebra.seventhCyclotomicGaloisSetEquiv`). If `τ ∈ Gal(ℚ^sep/ℚ)` restricts to `γ ^ n` on `K`,
it permutes the labels by `(0 1 2 3 4 5) ^ n`, and those of the twin by
`θ(0 1 2 3 4 5) ^ n = ((0 4 5)(1 3)) ^ n`. The map sending `(q, a, b)` in
`ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)` to `ι ∘ (b, a, q, γ a, γ b, γ² b)` is therefore a map to the twin: `γ²`
fixes `ℚ(√-7)`, the fixed field of `γ²` (Tau Ceti's
`TauCeti.NumberField.seventhCyclotomicQuadraticSubfield_eq_adjoin_sqrtNegSeven`), and
`γ³ : ζ₇ ↦ ζ₇⁻¹` fixes `ℚ(ζ₇ + ζ₇⁻¹)`. It is injective, and both algebras have dimension `6`, as
`ℚ(ζ₇ + ζ₇⁻¹)` has degree `3`: it is the maximal real subfield of `ℚ(ζ₇)`
(`IsPrimitiveRoot.maximalRealSubfield_eq_adjoin_add_inv`), the field fixed by `γ³`, of degree `3`.
So every finite separable twin of `K` is isomorphic to `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`, its factors
corresponding to the orbits `{2}`, `{1, 3}` and `{0, 4, 5}` of `(0 4 5)(1 3)`.

## Main definitions

* `Algebra.seventhCyclotomicGaloisSetEquiv`: the labelling of the Galois set of `ℚ(ζ₇)` by the
  powers of `γ`.
* `Algebra.SeventhCyclotomicTwin`: the `ℚ`-algebra `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`.
* `Algebra.seventhCyclotomicTwinEquiv` (LMFDB `nf.sextic_twin`): its isomorphism onto the twin of
  `ℚ(ζ₇)`.

## Main results

* `Algebra.finrank_seventhCyclotomic`: `ℚ(ζ₇)` is a sextic field.
* `Algebra.finrank_adjoin_zeta_add_inv`: `ℚ(ζ₇ + ζ₇⁻¹)` has degree `3` over `ℚ`.
* `Algebra.IsSexticTwin.not_isField_seventhCyclotomic` (LMFDB `nf.sextic_twin`): no twin of
  `ℚ(ζ₇)` is a field.
* `Algebra.IsSexticTwin.nonempty_algEquiv_seventhCyclotomicTwin` (LMFDB `nf.sextic_twin`): every
  finite separable twin of `ℚ(ζ₇)` is isomorphic to `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`.
* `Algebra.not_isField_sexticTwin_adjoin_seventh_roots` (LMFDB `nf.sextic_twin`): the subfield of
  `ℂ` generated by the seventh roots of unity is a sextic number field whose twin is not a field.
-/

open Equiv IntermediateField Module MulAction Perm Subgroup TauCeti IsCyclotomicExtension
  NumberField

namespace Algebra

variable {K : Type*} [Field K] [NumberField K] [IsCyclotomicExtension {7} ℚ K]

private local instance : IsGalois ℚ K :=
  IsCyclotomicExtension.isGalois {7} ℚ K

/-- **The seventh cyclotomic field is a sextic field**: `[ℚ(ζ₇) : ℚ] = φ(7) = 6`. -/
lemma finrank_seventhCyclotomic : finrank ℚ K = 6 := by
  rw [Rat.finrank 7 K, Nat.totient_prime Nat.prime_seven]

lemma natCard_gal_seventhCyclotomic : Nat.card Gal(K/ℚ) = 6 :=
  (IsGalois.card_aut_eq_finrank ℚ K).trans finrank_seventhCyclotomic

lemma isCyclic_gal_seventhCyclotomic : IsCyclic Gal(K/ℚ) :=
  isCyclic_of_orderOf_eq_card _ <|
    orderOf_frobeniusThreeSeven.trans natCard_gal_seventhCyclotomic.symm

variable {B : Type*} [CommRing B] [Algebra ℚ B]

/-- **The seventh cyclotomic field is a sextic number field whose twins are not fields** (LMFDB
`nf.sextic_twin`): its Galois group is cyclic, generated by `ζ₇ ↦ ζ₇ ^ 3`
(`Algebra.IsSexticTwin.not_isField_of_isCyclic`). Its finite separable twins are isomorphic to
`ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)` (`Algebra.IsSexticTwin.nonempty_algEquiv_seventhCyclotomicTwin`). -/
lemma IsSexticTwin.not_isField_seventhCyclotomic (h : IsSexticTwin ℚ K B) : ¬IsField B :=
  have : IsCyclic Gal(K/ℚ) := isCyclic_gal_seventhCyclotomic
  h.not_isField_of_isCyclic

variable (K) in
/-- The **powers of the generator `γ : ζ₇ ↦ ζ₇ ^ 3` of `Gal(ℚ(ζ₇)/ℚ)`**: `i ↦ γ ^ i` for
`i ∈ {0, …, 5}`, a bijection as `γ` has order `6`. -/
noncomputable def finSixEquivGalSeventhCyclotomic : Fin 6 ≃ Gal(K/ℚ) :=
  Equiv.ofBijective (fun i ↦ frobeniusThreeSeven ^ (i : ℕ)) <|
    Function.Injective.bijective_of_nat_card_le
      (fun i j h ↦ Fin.ext <| pow_injOn_Iio_orderOf
        (Set.mem_Iio.mpr (i.2.trans_eq orderOf_frobeniusThreeSeven.symm))
        (Set.mem_Iio.mpr (j.2.trans_eq orderOf_frobeniusThreeSeven.symm)) h)
      (by rw [natCard_gal_seventhCyclotomic, Nat.card_eq_fintype_card, Fintype.card_fin])

lemma finSixEquivGalSeventhCyclotomic_apply (i : Fin 6) :
    finSixEquivGalSeventhCyclotomic K i = frobeniusThreeSeven ^ (i : ℕ) :=
  rfl

lemma permCongr_toPerm_frobeniusThreeSeven :
    (finSixEquivGalSeventhCyclotomic K).symm.permCongr (toPerm (frobeniusThreeSeven : Gal(K/ℚ))) =
      finRotate 6 :=
  Equiv.ext fun i ↦ by
    rw [permCongr_apply, symm_symm, toPerm_apply, smul_eq_mul, symm_apply_eq,
      finSixEquivGalSeventhCyclotomic_apply, finSixEquivGalSeventhCyclotomic_apply, ← pow_succ',
      pow_eq_pow_iff_modEq, orderOf_frobeniusThreeSeven]
    fin_cases i <;> decide

/-- The **labelling of the Galois set of `ℚ(ζ₇)` by the powers of `γ : ζ₇ ↦ ζ₇ ^ 3`**: the embedding
`ι ∘ γ ^ i` of `ℚ(ζ₇)` in `ℚ^sep` is labelled by `i`, where `ι` is a fixed embedding
(`IsSepClosed.lift`). -/
noncomputable def seventhCyclotomicGaloisSetEquiv : (K →ₐ[ℚ] SeparableClosure ℚ) ≃ Fin 6 :=
  (galEquivAlgHom IsSepClosed.lift).symm.trans (finSixEquivGalSeventhCyclotomic K).symm

lemma sexticTwinPerm_seventhCyclotomicGaloisSetEquiv {τ : Gal(SeparableClosure ℚ/ℚ)} {n : ℕ}
    (hn : IsSepClosed.lift.restrictNormalHom τ = (frobeniusThreeSeven : Gal(K/ℚ)) ^ n) :
    sexticTwinPerm (seventhCyclotomicGaloisSetEquiv (K := K)) τ =
      (swap 0 5 * swap 0 4 * swap 1 3) ^ n := by
  rw [sexticTwinPerm_apply, permCongr_galoisSetPerm IsSepClosed.lift,
    seventhCyclotomicGaloisSetEquiv, ← trans_assoc, self_trans_symm, refl_trans, hn,
    ← permCongr_toPerm_pow, permCongr_toPerm_frobeniusThreeSeven, map_pow,
    outerAutFinSix_finRotate]

lemma adjoin_zeta_add_inv_eq_fixedField :
    ℚ⟮zeta 7 ℚ K + (zeta 7 ℚ K)⁻¹⟯ = fixedField (zpowers (frobeniusThreeSeven ^ 3)) := by
  refine toSubfield_injective ?_
  rw [← (zeta_spec 7 ℚ K).maximalRealSubfield_eq_adjoin_add_inv,
    ← Rat.toSubfield_fixedField_zpowers_galEquivZMod_symm_neg_one 7 K, frobeniusThreeSeven,
    ← map_pow]
  rfl

lemma finrank_fixedField_frobeniusThreeSeven_pow_three :
    finrank ℚ (fixedField (zpowers (frobeniusThreeSeven ^ 3 : Gal(K/ℚ)))) = 3 := by
  have h : finrank ℚ (fixedField (zpowers (frobeniusThreeSeven ^ 3 : Gal(K/ℚ)))) *
      orderOf (frobeniusThreeSeven ^ 3 : Gal(K/ℚ)) = finrank ℚ K :=
    finrank_fixedField_zpowers_mul_orderOf _
  rw [orderOf_pow, orderOf_frobeniusThreeSeven, finrank_seventhCyclotomic (K := K),
    (by decide : 6 / Nat.gcd 6 3 = 2)] at h
  omega

/-- **The field `ℚ(ζ₇ + ζ₇⁻¹)` has degree `3` over `ℚ`**: it is the maximal real subfield of
`ℚ(ζ₇)` (`IsPrimitiveRoot.maximalRealSubfield_eq_adjoin_add_inv`), which is the field fixed by
`γ³ : ζ₇ ↦ ζ₇⁻¹` (Tau Ceti's
`TauCeti.IsCyclotomicExtension.Rat.toSubfield_fixedField_zpowers_galEquivZMod_symm_neg_one`), of
degree `3`. -/
lemma finrank_adjoin_zeta_add_inv : finrank ℚ ℚ⟮zeta 7 ℚ K + (zeta 7 ℚ K)⁻¹⟯ = 3 :=
  adjoin_zeta_add_inv_eq_fixedField (K := K) ▸ finrank_fixedField_frobeniusThreeSeven_pow_three

variable (K) in
/-- The **`ℚ`-algebra `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`**, for `ℚ(√-7)` and `ℚ(ζ₇ + ζ₇⁻¹)` the subfields
of the seventh cyclotomic field `K` generated by Tau Ceti's Gaussian period
`TauCeti.NumberField.seventhCyclotomicSqrtNegSeven`, a square root of `-7`, and by `ζ₇ + ζ₇⁻¹`.
It is the twin of `K` (`Algebra.seventhCyclotomicTwinEquiv`). -/
abbrev SeventhCyclotomicTwin : Type _ :=
  ℚ × ℚ⟮(seventhCyclotomicSqrtNegSeven : K)⟯ × ℚ⟮zeta 7 ℚ K + (zeta 7 ℚ K)⁻¹⟯

variable (K) in
/-- The **six coordinates of the twin of `ℚ(ζ₇)`**: `(q, a, b) ↦ (b, a, q, γ a, γ b, γ² b)` on
`ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`, where `γ : ζ₇ ↦ ζ₇ ^ 3`. -/
noncomputable def seventhCyclotomicTwinCoord : Fin 6 → (SeventhCyclotomicTwin K →ₐ[ℚ] K) :=
  letI a : SeventhCyclotomicTwin K →ₐ[ℚ] K :=
    (ℚ⟮(seventhCyclotomicSqrtNegSeven : K)⟯).val.comp
      ((AlgHom.fst ℚ _ _).comp (AlgHom.snd ℚ ℚ _))
  letI b : SeventhCyclotomicTwin K →ₐ[ℚ] K :=
    (ℚ⟮zeta 7 ℚ K + (zeta 7 ℚ K)⁻¹⟯).val.comp ((AlgHom.snd ℚ _ _).comp (AlgHom.snd ℚ ℚ _))
  ![b, a, (ofId ℚ K).comp (AlgHom.fst ℚ ℚ _), (frobeniusThreeSeven : Gal(K/ℚ)).toAlgHom.comp a,
    (frobeniusThreeSeven : Gal(K/ℚ)).toAlgHom.comp b,
    (frobeniusThreeSeven ^ 2 : Gal(K/ℚ)).toAlgHom.comp b]

lemma frobeniusThreeSeven_sq_apply_of_mem {a : K}
    (ha : a ∈ ℚ⟮(seventhCyclotomicSqrtNegSeven : K)⟯) :
    (frobeniusThreeSeven ^ 2 : Gal(K/ℚ)) a = a :=
  (mem_seventhCyclotomicQuadraticSubfield_iff a).mp <|
    (seventhCyclotomicQuadraticSubfield_eq_adjoin_sqrtNegSeven (L := K)) ▸ ha

lemma frobeniusThreeSeven_pow_three_apply_of_mem {b : K} (hb : b ∈ ℚ⟮zeta 7 ℚ K + (zeta 7 ℚ K)⁻¹⟯) :
    (frobeniusThreeSeven ^ 3 : Gal(K/ℚ)) b = b :=
  (mem_fixedField_zpowers_iff _ _).mp (adjoin_zeta_add_inv_eq_fixedField.le hb)

variable (x : SeventhCyclotomicTwin K) (y : Fin 6)

lemma seventhCyclotomicTwinCoord_swap :
    seventhCyclotomicTwinCoord K ((swap 0 5 * swap 0 4 * swap 1 3 : Perm (Fin 6)) y) x =
      (frobeniusThreeSeven : Gal(K/ℚ)) (seventhCyclotomicTwinCoord K y x) := by
  have h3 : (x.2.1 : K) =
      (frobeniusThreeSeven : Gal(K/ℚ)) ((frobeniusThreeSeven : Gal(K/ℚ)) (x.2.1 : K)) :=
    (frobeniusThreeSeven_sq_apply_of_mem x.2.1.2).symm.trans (by rw [pow_two, AlgEquiv.mul_apply])
  have h4 : (frobeniusThreeSeven ^ 2 : Gal(K/ℚ)) (x.2.2 : K) =
      (frobeniusThreeSeven : Gal(K/ℚ)) ((frobeniusThreeSeven : Gal(K/ℚ)) (x.2.2 : K)) := by
    rw [pow_two, AlgEquiv.mul_apply]
  have h5 : (x.2.2 : K) =
      (frobeniusThreeSeven : Gal(K/ℚ)) ((frobeniusThreeSeven ^ 2 : Gal(K/ℚ)) (x.2.2 : K)) :=
    (frobeniusThreeSeven_pow_three_apply_of_mem x.2.2.2).symm.trans
      (by rw [pow_succ', AlgEquiv.mul_apply])
  fin_cases y
  · exact rfl
  · exact rfl
  · exact (frobeniusThreeSeven.commutes x.1).symm
  · exact h3
  · exact h4
  · exact h5

lemma seventhCyclotomicTwinCoord_pow_swap (n : ℕ) :
    seventhCyclotomicTwinCoord K (((swap 0 5 * swap 0 4 * swap 1 3 : Perm (Fin 6)) ^ n) y) x =
      (frobeniusThreeSeven ^ n : Gal(K/ℚ)) (seventhCyclotomicTwinCoord K y x) := by
  induction n with
  | zero => rw [pow_zero, pow_zero, one_apply, AlgEquiv.one_apply]
  | succ n ih =>
    rw [pow_succ', mul_apply, seventhCyclotomicTwinCoord_swap, ih, pow_succ', AlgEquiv.mul_apply]

lemma pi_seventhCyclotomicTwinCoord_mem :
    AlgHom.pi (fun y ↦ IsSepClosed.lift.comp (seventhCyclotomicTwinCoord K y)) x ∈
      sexticTwin (seventhCyclotomicGaloisSetEquiv (K := K)) := by
  refine (mem_galoisSetAlgebra _).mpr fun τ y ↦ ?_
  let n : ℕ := (finSixEquivGalSeventhCyclotomic K).symm (IsSepClosed.lift.restrictNormalHom τ)
  have hn : IsSepClosed.lift.restrictNormalHom τ = (frobeniusThreeSeven : Gal(K/ℚ)) ^ n :=
    ((finSixEquivGalSeventhCyclotomic K).apply_symm_apply _).symm
  rw [AlgHom.pi_apply, AlgHom.pi_apply, sexticTwinPerm_seventhCyclotomicGaloisSetEquiv hn,
    AlgHom.comp_apply, AlgHom.comp_apply, seventhCyclotomicTwinCoord_pow_swap, ← hn,
    AlgHom.restrictNormalHom_commutes]

/-- The **map from `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)` to the twin of `ℚ(ζ₇)`**:
`(q, a, b) ↦ ι ∘ (b, a, q, γ a, γ b, γ² b)` on the Galois set `{0, …, 5}` of the twin, labelled by
`Algebra.seventhCyclotomicGaloisSetEquiv`, where `ι` is the fixed embedding of `ℚ(ζ₇)` in `ℚ^sep`
and `γ : ζ₇ ↦ ζ₇ ^ 3`. -/
noncomputable def seventhCyclotomicTwinHom :
    SeventhCyclotomicTwin K →ₐ[ℚ] sexticTwin (seventhCyclotomicGaloisSetEquiv (K := K)) :=
  (AlgHom.pi fun y ↦ IsSepClosed.lift.comp (seventhCyclotomicTwinCoord K y)).codRestrict _
    pi_seventhCyclotomicTwinCoord_mem

lemma injective_seventhCyclotomicTwinHom : Function.Injective (seventhCyclotomicTwinHom (K := K)) :=
  (injective_iff_map_eq_zero _).mpr fun x hx ↦ by
    have h (y : Fin 6) :
        (IsSepClosed.lift : K →ₐ[ℚ] SeparableClosure ℚ) (seventhCyclotomicTwinCoord K y x) = 0 :=
      congrFun (congrArg Subtype.val hx) y
    have h0 : (x.2.2 : K) = 0 := IsSepClosed.lift.injective ((h 0).trans (map_zero _).symm)
    have h1 : (x.2.1 : K) = 0 := IsSepClosed.lift.injective ((h 1).trans (map_zero _).symm)
    have h2 : algebraMap ℚ K x.1 = 0 := IsSepClosed.lift.injective ((h 2).trans (map_zero _).symm)
    exact Prod.ext ((map_eq_zero_iff _ (algebraMap ℚ K).injective).mp h2)
      (Prod.ext (Subtype.ext h1) (Subtype.ext h0))

lemma finrank_seventhCyclotomicTwin : finrank ℚ (SeventhCyclotomicTwin K) = 6 := by
  rw [finrank_prod, finrank_prod, finrank_self,
    ← seventhCyclotomicQuadraticSubfield_eq_adjoin_sqrtNegSeven,
    finrank_seventhCyclotomicQuadraticSubfield, finrank_adjoin_zeta_add_inv]

lemma finrank_sexticTwin_seventhCyclotomicGaloisSetEquiv :
    finrank ℚ (sexticTwin (seventhCyclotomicGaloisSetEquiv (K := K))) = 6 :=
  finrank_sexticTwin _

lemma bijective_seventhCyclotomicTwinHom :
    Function.Bijective (seventhCyclotomicTwinHom (K := K)) := by
  have : FiniteDimensional ℚ (sexticTwin (seventhCyclotomicGaloisSetEquiv (K := K))) :=
    finite_of_finrank_eq_succ finrank_sexticTwin_seventhCyclotomicGaloisSetEquiv
  have h6 : finrank ℚ (SeventhCyclotomicTwin K) =
      finrank ℚ (sexticTwin (seventhCyclotomicGaloisSetEquiv (K := K))) :=
    finrank_seventhCyclotomicTwin.trans finrank_sexticTwin_seventhCyclotomicGaloisSetEquiv.symm
  exact ⟨injective_seventhCyclotomicTwinHom,
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank h6
      (f := seventhCyclotomicTwinHom.toLinearMap)).mp injective_seventhCyclotomicTwinHom⟩

/-- The **isomorphism of `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)` onto the twin of `ℚ(ζ₇)`** (LMFDB
`nf.sextic_twin`), the twin `Algebra.sexticTwin` for the labelling
`Algebra.seventhCyclotomicGaloisSetEquiv` of the Galois set of `ℚ(ζ₇)`: the map
`Algebra.seventhCyclotomicTwinHom` is injective, and both algebras have dimension `6`. -/
noncomputable def seventhCyclotomicTwinEquiv :
    SeventhCyclotomicTwin K ≃ₐ[ℚ] sexticTwin (seventhCyclotomicGaloisSetEquiv (K := K)) :=
  AlgEquiv.ofBijective _ bijective_seventhCyclotomicTwinHom

/-- **The twin of `ℚ(ζ₇)` is `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`** (LMFDB `nf.sextic_twin`): every finite
separable twin of the seventh cyclotomic field is isomorphic to the product of its subfields `ℚ`,
`ℚ(√-7)` and `ℚ(ζ₇ + ζ₇⁻¹)`, of degrees `1`, `2` and `3`, as the twin of
`Algebra.seventhCyclotomicTwinEquiv` is, twins being unique
(`Algebra.IsSexticTwin.nonempty_algEquiv`). Here `√-7` is Tau Ceti's Gaussian period
`TauCeti.NumberField.seventhCyclotomicSqrtNegSeven`, `1 + 2(ζ₇ + ζ₇² + ζ₇⁴)`, whose square is
`-7`. -/
lemma IsSexticTwin.nonempty_algEquiv_seventhCyclotomicTwin [Etale ℚ B] (h : IsSexticTwin ℚ K B) :
    Nonempty (B ≃ₐ[ℚ] ℚ × ℚ⟮(seventhCyclotomicSqrtNegSeven : K)⟯ ×
      ℚ⟮zeta 7 ℚ K + (zeta 7 ℚ K)⁻¹⟯) := by
  have : Etale ℚ (sexticTwin (seventhCyclotomicGaloisSetEquiv (K := K))) := etale_sexticTwin _
  rcases h.nonempty_algEquiv (isSexticTwin_sexticTwin seventhCyclotomicGaloisSetEquiv) with ⟨f⟩
  exact ⟨f.trans seventhCyclotomicTwinEquiv.symm⟩

/-- **A sextic number field whose twin is not a field** (LMFDB `nf.sextic_twin`), the knowl's
"common situation" where `A` is a field but `B` is not. Here `A` is the subfield `ℚ(μ₇)` of `ℂ`
generated by the seventh roots of unity, a seventh cyclotomic number field (the instances
`IsCyclotomicExtension {7} ℚ (adjoin ℚ {b : ℂ | b ^ 7 = 1})` and
`NumberField (adjoin ℚ {b : ℂ | b ^ 7 = 1})` of the file on the Galois action on characters), so of
degree `6` (`Algebra.finrank_seventhCyclotomic`). And `B` is its twin `Algebra.sexticTwin` for the
labelling `Algebra.seventhCyclotomicGaloisSetEquiv`, a finite separable algebra of degree `6`
(`Algebra.etale_sexticTwin`, `Algebra.finrank_sexticTwin`) that is a twin of `A`
(`Algebra.isSexticTwin_sexticTwin`), isomorphic to `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`
(`Algebra.seventhCyclotomicTwinEquiv`). No twin of a seventh cyclotomic field is a field
(`Algebra.IsSexticTwin.not_isField_seventhCyclotomic`). -/
lemma not_isField_sexticTwin_adjoin_seventh_roots : ¬IsField (sexticTwin
    (seventhCyclotomicGaloisSetEquiv (K := IntermediateField.adjoin ℚ {b : ℂ | b ^ 7 = 1}))) :=
  (isSexticTwin_sexticTwin _).not_isField_seventhCyclotomic

end Algebra
