import TauCeti.FieldTheory.Galois.Restriction
import LeanBridge.ForMathlib.NumberTheory.NumberField.SexticTwin.LinearFactor

/-!
# The twin of a cyclic sextic field is not a field

Let `A` be a field that is a Galois extension of degree `6` of a field `F` with cyclic Galois group,
such as the seventh cyclotomic field over `ℚ`. Its Galois set `Hom_F(A, F^sep)` is a torsor under
`Gal(A/F)`: for an embedding `ι : A → F^sep`, the maps `g ↦ ι ∘ g` label it by `Gal(A/F)`
(`Algebra.galEquivAlgHom`), and `τ ∈ Gal(F^sep/F)` acts by left multiplication by its restriction
`g_τ` to `A` along `ι`, defined by `τ ∘ ι = ι ∘ g_τ` (Tau Ceti's `AlgHom.restrictNormalHom`). So,
labelled by `{0, …, 5}`, the Galois action on `A` lies in the cyclic group generated by a
permutation `π` that has a single orbit, a `6`-cycle, conjugate to `(0 1 2 3 4 5)`. Only the
normality of `A` over `F` is used: for a normal `A`, the maps `g ↦ ι ∘ g` are all the embeddings
of `A` in `F^sep`, and a twin asks for six of them, so that `Gal(A/F)` then has order `6`.

The outer automorphism `θ` of `S₆` (`Equiv.Perm.outerAutFinSix`) sends `(0 1 2 3 4 5)` to
`(0 4 5)(1 3)`, which fixes the point `2` only, so `θ(π)` and its powers have a common fixed point.
Hence the Galois set of a twin `B` of `A` has a point fixed by `Gal(F^sep/F)`, so `B` has `F` as a
factor, and `B` is not a field (`Algebra.IsSexticTwin.not_isField_of_algHom`). For `A = ℚ(ζ₇)` the
twin is `ℚ × ℚ(√-7) × ℚ(ζ₇ + ζ₇⁻¹)`, whose factors correspond to the orbits of sizes `1`, `2` and
`3` of `(0 4 5)(1 3)`.

## Main definitions

* `Algebra.galEquivAlgHom`: the labelling `g ↦ ι ∘ g` of the Galois set of a normal extension `A`
  by its Galois group, for an embedding `ι`.

## Main results

* `Equiv.Perm.exists_forall_mem_zpowers_outerAutFinSix_apply_eq`: the outer automorphism `θ` sends
  the cyclic group generated by a `6`-cycle into the stabilizer of a point.
* `Algebra.IsSexticTwin.nonempty_algHom_of_isCyclic` (LMFDB `nf.sextic_twin`): a twin of a cyclic
  sextic field has `F` as a factor.
* `Algebra.IsSexticTwin.not_isField_of_isCyclic` (LMFDB `nf.sextic_twin`): a twin of a cyclic
  sextic field is not a field.
-/

open Equiv MulAction Perm Subgroup

namespace Equiv.Perm

variable {G : Type*} [Group G] (E : G ≃ Fin 6) (g : G)

/-- **The outer automorphism `θ` of `S₆` sends the cyclic group generated by a `6`-cycle into the
stabilizer of a point**: a permutation `π` of `{0, …, 5}` with a single orbit is a `6`-cycle,
conjugate to `(0 1 2 3 4 5)`, and `θ(0 1 2 3 4 5) = (0 4 5)(1 3)` fixes `2`. -/
lemma exists_forall_mem_zpowers_outerAutFinSix_apply_eq {π : Perm (Fin 6)}
    (h : ∀ x y, π.SameCycle x y) : ∃ p, ∀ σ ∈ zpowers π, outerAutFinSix σ p = p := by
  have hπ (x : Fin 6) : π x ≠ x := fun hx ↦ by
    rcases exists_ne x with ⟨y, hy⟩
    rcases h x y with ⟨i, rfl⟩
    exact hy (zpow_apply_eq_self_of_apply_eq_self hx i)
  have hc : π.IsCycle := ⟨0, hπ 0, fun y _ ↦ h 0 y⟩
  have ht : (finRotate 6).cycleType = π.cycleType := by
    rw [hc.cycleType, Finset.eq_univ_of_forall fun x ↦ mem_support.mpr (hπ x), cycleType_finRotate]
    rfl
  rcases isConj_iff.mp (isConj_iff_cycleType_eq.mpr ht) with ⟨c, rfl⟩
  refine ⟨outerAutFinSix c 2, fun σ hσ ↦ ?_⟩
  rcases mem_zpowers_iff.mp hσ with ⟨k, rfl⟩
  have h2 : outerAutFinSix (finRotate 6) 2 = 2 := by
    rw [outerAutFinSix_finRotate]
    decide
  rw [conj_zpow, map_mul, map_mul, map_inv, mul_apply, mul_apply, coe_inv, symm_apply_apply,
    map_zpow, zpow_apply_eq_self_of_apply_eq_self h2]

lemma permCongr_toPerm_pow (n : ℕ) : E.permCongr (toPerm g) ^ n = E.permCongr (toPerm (g ^ n)) :=
  (map_pow (E.permCongrHom.toMonoidHom.comp (toPermHom G G)) g n).symm

lemma permCongr_toPerm_zpow (k : ℤ) : E.permCongr (toPerm g) ^ k = E.permCongr (toPerm (g ^ k)) :=
  (map_zpow (E.permCongrHom.toMonoidHom.comp (toPermHom G G)) g k).symm

lemma sameCycle_permCongr_toPerm {γ : G} (hγ : ∀ g, g ∈ zpowers γ) (x y : Fin 6) :
    (E.permCongr (toPerm γ)).SameCycle x y := by
  rcases mem_zpowers_iff.mp (hγ (E.symm y * (E.symm x)⁻¹)) with ⟨k, hk⟩
  refine ⟨k, ?_⟩
  rw [permCongr_toPerm_zpow, permCongr_apply, toPerm_apply, smul_eq_mul, hk, inv_mul_cancel_right,
    apply_symm_apply]

lemma exists_forall_outerAutFinSix_permCongr_toPerm_apply_eq [IsCyclic G] :
    ∃ p, ∀ g : G, outerAutFinSix (E.permCongr (toPerm g)) p = p := by
  rcases IsCyclic.exists_generator (α := G) with ⟨γ, hγ⟩
  rcases exists_forall_mem_zpowers_outerAutFinSix_apply_eq (sameCycle_permCongr_toPerm E hγ) with
    ⟨p, hp⟩
  refine ⟨p, fun g ↦ hp _ ?_⟩
  rcases mem_zpowers_iff.mp (hγ g) with ⟨k, rfl⟩
  exact mem_zpowers_iff.mpr ⟨k, permCongr_toPerm_zpow E γ k⟩

end Equiv.Perm

namespace Algebra

variable {F A Ω : Type*} [Field F] [Field A] [Algebra F A] [Field Ω] [Algebra F Ω] [Normal F A]
  (ι : A →ₐ[F] Ω) (τ : Gal(Ω/F))

lemma bijective_comp_toAlgHom : Function.Bijective fun g : Gal(A/F) ↦ ι.comp g.toAlgHom :=
  ⟨fun _ _ h ↦ AlgEquiv.ext (ι.injective <| DFunLike.congr_fun h ·), (ι.exists_comp_eq_of_normal ·)⟩

/-- The **labelling of the Galois set of a normal extension `A` of `F` by its Galois group**
(LMFDB `nf.sextic_twin`), for an embedding `ι : A → Ω`: an automorphism `g` of `A` labels the
embedding `ι ∘ g`, and every embedding of `A` in `Ω` is of this form for a unique `g` (Tau Ceti's
`AlgHom.exists_comp_eq_of_normal`). -/
noncomputable def galEquivAlgHom : Gal(A/F) ≃ (A →ₐ[F] Ω) :=
  Equiv.ofBijective _ (bijective_comp_toAlgHom ι)

lemma galoisSetPerm_galEquivAlgHom (g : Gal(A/F)) :
    galoisSetPerm F Ω A τ (galEquivAlgHom ι g) = galEquivAlgHom ι (ι.restrictNormalHom τ * g) :=
  AlgHom.ext fun a ↦ (ι.restrictNormalHom_commutes τ (g a)).symm

lemma permCongr_galoisSetPerm {α : Type*} (e : (A →ₐ[F] Ω) ≃ α) :
    e.permCongr (galoisSetPerm F Ω A τ) =
      ((galEquivAlgHom ι).trans e).permCongr (toPerm (ι.restrictNormalHom τ)) :=
  Equiv.ext fun x ↦ by
    rw [permCongr_apply, permCongr_apply, toPerm_apply, smul_eq_mul, trans_apply,
      ← galoisSetPerm_galEquivAlgHom, symm_trans_apply, apply_symm_apply]

variable [IsCyclic Gal(A/F)]

lemma exists_forall_sexticTwinPerm_apply_eq (e : (A →ₐ[F] SeparableClosure F) ≃ Fin 6) :
    ∃ p, ∀ τ, sexticTwinPerm e τ p = p := by
  rcases exists_forall_outerAutFinSix_permCongr_toPerm_apply_eq
    ((galEquivAlgHom (e.symm 0)).trans e) with ⟨p, hp⟩
  exact ⟨p, fun τ ↦ by rw [sexticTwinPerm_apply, permCongr_galoisSetPerm (e.symm 0), hp]⟩

variable {B : Type*} [CommRing B] [Algebra F B]

/-- **A twin of a cyclic sextic field has `F` as a factor** (LMFDB `nf.sextic_twin`): if `A` is a
normal extension of `F` with cyclic Galois group, such as a Galois extension of degree `6` with
cyclic Galois group, every twin `B` of `A` has an `F`-algebra map to `F`. The Galois action on `A`
lies in the cyclic group generated by a `6`-cycle, which the outer automorphism of `S₆` sends into
the stabilizer of a point. -/
lemma IsSexticTwin.nonempty_algHom_of_isCyclic (h : IsSexticTwin F A B) : Nonempty (B →ₐ[F] F) := by
  rcases h with ⟨eA, eB, h⟩
  rcases exists_forall_sexticTwinPerm_apply_eq eA with ⟨p, hp⟩
  rcases IsSexticTwin.exists_forall_galoisSetPerm_eq ⟨eA, eB, h⟩ eA hp with ⟨ψ, hψ⟩
  exact nonempty_algHom_of_forall_galoisSetPerm_eq hψ

/-- **The twin of a cyclic sextic field is not a field** (LMFDB `nf.sextic_twin`): if `A` is a
normal extension of `F` with cyclic Galois group, such as a Galois extension of degree `6` with
cyclic Galois group, no twin of `A` is a field, as it has `F` as a factor
(`Algebra.IsSexticTwin.nonempty_algHom_of_isCyclic`). -/
lemma IsSexticTwin.not_isField_of_isCyclic (h : IsSexticTwin F A B) : ¬IsField B :=
  h.not_isField_of_algHom h.nonempty_algHom_of_isCyclic.some

end Algebra
