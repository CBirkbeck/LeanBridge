import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.Normal.Closure

/-!
# Sibling fields and algebras

Two finite separable extensions of a field `F` are siblings if they are not isomorphic but have
isomorphic Galois closures. A finite separable `F`-algebra is a finite product of finite separable
extensions of `F`, and its Galois closure is the compositum of their Galois closures; this is the
subfield of an algebraic closure `F̄` of `F` generated by the images of all `F`-algebra maps into
`F̄`, which is how we define it for any `F`-algebra.

## Main definitions

* `Algebra.galoisClosure`: the Galois closure of an `F`-algebra, inside `AlgebraicClosure F`.
* `Algebra.IsSibling` (LMFDB `nf.sibling`).

## Main results

* `Algebra.galoisClosure_eq_normalClosure`: the Galois closure of a field is its normal closure in
  `AlgebraicClosure F`.
* `Algebra.isNormalClosure_galoisClosure`: the Galois closure of an algebraic extension is a normal
  closure of it.
* `Algebra.isSibling_iff`: for algebraic extensions, being siblings can be tested on any normal
  closures, so it does not depend on the choice of the algebraic closure of `F`.
-/

namespace Algebra

variable (F A B : Type*) [Field F] [CommRing A] [Algebra F A] [CommRing B] [Algebra F B] (K : Type*)
  [Field K] [Algebra F K] {K₁ K₂ L₁ L₂ : Type*} [Field K₁] [Field K₂] [Field L₁] [Field L₂]
  [Algebra F K₁] [Algebra F K₂] [Algebra F L₁] [Algebra F L₂]

/-- The **Galois closure** of an `F`-algebra `A`: the subfield of the algebraic closure `F̄` of `F`
generated by the images of all `F`-algebra maps `A → F̄`.

For a field `K` this is the normal closure of `K` in `F̄` (`galoisClosure_eq_normalClosure`), a
Galois closure of `K` when `K / F` is finite separable. For a finite separable `F`-algebra, a
product of finite separable extensions `K_i` of `F`, every `F`-algebra map to `F̄` factors through
one of the `K_i`, so this is the compositum of the Galois closures of the `K_i`, as in the LMFDB
knowl `nf.sibling`. -/
noncomputable def galoisClosure : IntermediateField F (AlgebraicClosure F) :=
  IntermediateField.adjoin F (⋃ f : A →ₐ[F] AlgebraicClosure F, Set.range f)

/-- Two `F`-algebras `A` and `B` are **siblings** (LMFDB `nf.sibling`) if they are not isomorphic
but have isomorphic Galois closures. The LMFDB considers finite separable extensions of `F`, and
finite separable `ℚ`-algebras, for which this is its definition. -/
def IsSibling : Prop :=
  IsEmpty (A ≃ₐ[F] B) ∧ Nonempty (galoisClosure F A ≃ₐ[F] galoisClosure F B)

variable {F A B}

lemma IsSibling.symm (h : IsSibling F A B) : IsSibling F B A :=
  ⟨⟨fun e ↦ h.1.false e.symm⟩, h.2.map AlgEquiv.symm⟩

/-- The Galois closure of a field is its normal closure in the algebraic closure of `F`. -/
lemma galoisClosure_eq_normalClosure :
    galoisClosure F K = IntermediateField.normalClosure F K (AlgebraicClosure F) := by
  rw [galoisClosure, normalClosure_def, IntermediateField.iSup_eq_adjoin]
  rfl

/-- The Galois closure of an algebraic extension `K` of `F` is a normal closure of `K / F`. -/
lemma isNormalClosure_galoisClosure [Algebra.IsAlgebraic F K] :
    IsNormalClosure F K (galoisClosure F K) := by
  have : Nonempty (K →ₐ[F] AlgebraicClosure F) := ⟨IsAlgClosed.lift⟩
  rw [galoisClosure_eq_normalClosure]
  infer_instance

/-- Two algebraic extensions `K₁` and `K₂` of `F` with normal closures `L₁` and `L₂` are siblings
exactly when they are not isomorphic and `L₁` and `L₂` are isomorphic. -/
lemma isSibling_iff [Algebra.IsAlgebraic F K₁] [Algebra.IsAlgebraic F K₂] [IsNormalClosure F K₁ L₁]
    [IsNormalClosure F K₂ L₂] :
    IsSibling F K₁ K₂ ↔ IsEmpty (K₁ ≃ₐ[F] K₂) ∧ Nonempty (L₁ ≃ₐ[F] L₂) := by
  have : IsNormalClosure F K₁ (galoisClosure F K₁) := isNormalClosure_galoisClosure K₁
  have : IsNormalClosure F K₂ (galoisClosure F K₂) := isNormalClosure_galoisClosure K₂
  exact and_congr_right' <| (AlgEquiv.equivCongr (IsNormalClosure.equiv (K := K₁))
    (IsNormalClosure.equiv (K := K₂))).nonempty_congr

end Algebra
