import LeanBridge.ForMathlib.NumberTheory.NumberField.ReflexReflexFieldGalois

/-!
# The reflex field of the reflex field through the inverses of the embeddings of a Galois closure

The LMFDB defines the reflex field of the reflex field of a CM type `Φ` of `K` as follows (LMFDB
`nf.reflex_reflex_field`). Let `N` be a Galois closure of `K` and `Φ_N` the CM type of `N` induced
by `Φ`. The complex embeddings of `N` are isomorphisms onto the image `F` of `N` in `ℂ`, and their
inverses, for the embeddings in `Φ_N`, form a CM type on `F` with values in `N`. The reflex field
of the reflex field of `Φ` is the reflex field of this CM type: the subfield of `N` fixed by the
automorphisms `g` of `N` whose composition with these inverses permutes them, as in the definition
of the reflex field (LMFDB `nf.reflex_field`) with `N` in place of the algebraic closure of `ℚ`.

This file formalises this description for a finite Galois extension `N` of `ℚ`. The inverse of
`χ ∘ g⁻¹` is the composite of `g` with the inverse of `χ`, so the automorphisms stabilising the
inverted CM type are those stabilising `Φ_N` under precomposition, whose fixed field is the image
of `NumberField.CMType.reflexReflexField` by `NumberField.CMType.map_algebraMap_reflexReflexField`.

## Main definitions

* `NumberField.ComplexEmbedding.imageField`: the image `F` of `N` in `ℂ`.
* `NumberField.ComplexEmbedding.inverse`: the inverse `F → N` of a complex embedding of `N`.
* `NumberField.ComplexEmbedding.imageFieldConj`: complex conjugation on `F`.
* `NumberField.CMType.inverseType`: the inverses of the embeddings in a CM type of `N`.
* `NumberField.CMType.inverseTypeStabilizer`: the automorphisms of `N` stabilising them.

## Main results

* `NumberField.ComplexEmbedding.fieldRange_eq_imageField`: every complex embedding of `N` has
  image `F`.
* `NumberField.CMType.mem_inverseType_iff_comp_imageFieldConj_notMem`: the inverted CM type
  contains exactly one of each pair of complex conjugate embeddings of `F` into `N`.
* `NumberField.CMType.mem_inverseTypeStabilizer_iff_image_comp_eq`: the automorphisms `g` in
  `inverseTypeStabilizer` are those with `g ∘ Ψ = Ψ` for the inverted CM type `Ψ`.
* `NumberField.CMType.inverseTypeStabilizer_eq`: the automorphisms stabilising the inverted CM type
  are those stabilising the CM type under precomposition.
* `NumberField.CMType.map_algebraMap_reflexReflexField_eq_fixedField_inverseTypeStabilizer` (LMFDB
  `nf.reflex_reflex_field`): the reflex field of the reflex field is the reflex field of the
  inverted CM type.
-/

open IntermediateField NumberField ComplexEmbedding

open scoped ComplexConjugate

namespace NumberField

variable (N : Type*) [Field N]

namespace ComplexEmbedding

/-- The **image in `ℂ`** of a field `N`: the subfield of `ℂ` generated by the images of the complex
embeddings of `N`. When `N` is a finite Galois extension of `ℚ`, it is the image of every complex
embedding of `N` (`fieldRange_eq_imageField`), the field `F` of the LMFDB knowl
`nf.reflex_reflex_field`. -/
noncomputable def imageField : Subfield ℂ :=
  ⨆ χ : N →+* ℂ, χ.fieldRange

variable {N} [NumberField N] [IsGalois ℚ N] (χ χ' : N →+* ℂ) (g : N ≃ₐ[ℚ] N)

lemma fieldRange_le_fieldRange : χ.fieldRange ≤ χ'.fieldRange := by
  rcases exists_comp_symm_eq_of_comp_eq (k := ℚ) χ' χ (Subsingleton.elim _ _) with ⟨σ, rfl⟩
  rintro - ⟨x, rfl⟩
  exact ⟨σ.symm x, rfl⟩

/-- **Every complex embedding of a finite Galois extension of `ℚ` has the same image**, the image
field. -/
lemma fieldRange_eq_imageField : χ.fieldRange = imageField N :=
  (le_iSup (fun χ : N →+* ℂ ↦ χ.fieldRange) χ).antisymm <|
    iSup_le fun χ' ↦ fieldRange_le_fieldRange χ' χ

/-- The **inverse** of a complex embedding `χ` of a finite Galois extension `N` of `ℚ`: the
homomorphism from the image `F` of `N` in `ℂ` to `N` that sends `z` to the `x` with `χ x = z`. -/
noncomputable def inverse : imageField N →+* N :=
  (χ.rangeRestrictFieldEquiv.symm : χ.fieldRange →+* N).comp
    (Subfield.inclusion (fieldRange_eq_imageField χ).ge)

lemma apply_inverse (z : imageField N) : χ (inverse χ z) = z :=
  χ.rangeRestrictFieldEquiv_apply_symm_apply _

lemma inverse_apply (x : N) : inverse χ ⟨χ x, (fieldRange_eq_imageField χ).le ⟨x, rfl⟩⟩ = x :=
  χ.injective (apply_inverse χ _)

lemma inverse_injective : Function.Injective (inverse : (N →+* ℂ) → imageField N →+* N) :=
  fun χ χ' h ↦ RingHom.ext fun x ↦ by
    have hx : χ' (inverse χ' ⟨χ x, (fieldRange_eq_imageField χ).le ⟨x, rfl⟩⟩) = χ x :=
      apply_inverse χ' _
    rw [← h, inverse_apply] at hx
    exact hx.symm

lemma inverse_surjective : Function.Surjective (inverse : (N →+* ℂ) → imageField N →+* N) :=
  fun ψ ↦ by
    let χ₀ : N →+* ℂ := Classical.choice inferInstance
    let ψ' : N →ₐ[ℚ] N := (ψ.comp <| (Subfield.inclusion (fieldRange_eq_imageField χ₀).le).comp
      χ₀.rangeRestrictField).toRatAlgHom
    have hψ : Function.Surjective ψ := fun y ↦ by
      rcases ψ'.bijective.2 y with ⟨x, rfl⟩
      exact ⟨_, rfl⟩
    let e : imageField N ≃+* N := RingEquiv.ofBijective ψ ⟨ψ.injective, hψ⟩
    let ι : N →+* ℂ := (imageField N).subtype.comp (e.symm : N →+* imageField N)
    exact ⟨ι, RingHom.ext fun z ↦ ι.injective <|
      (apply_inverse ι z).trans (congrArg Subtype.val (e.symm_apply_apply z)).symm⟩

lemma comp_inverse :
    (g : N →+* N).comp (inverse χ) = inverse (χ.comp ((g⁻¹ : N ≃ₐ[ℚ] N) : N →+* N)) :=
  RingHom.ext fun z ↦ (χ.comp ((g⁻¹ : N ≃ₐ[ℚ] N) : N →+* N)).injective <| by
    simp [apply_inverse]

variable (N) in
lemma conj_mem_imageField {z : ℂ} (hz : z ∈ imageField N) : conj z ∈ imageField N := by
  let χ₀ : N →+* ℂ := Classical.choice inferInstance
  rw [← fieldRange_eq_imageField χ₀] at hz
  rcases hz with ⟨x, rfl⟩
  exact (fieldRange_eq_imageField (conjugate χ₀)).le ⟨x, rfl⟩

variable (N) in
/-- **Complex conjugation on the image** `F` in `ℂ` of a finite Galois extension `N` of `ℚ`. The
complex conjugate of an embedding `ψ` of `F` into `N` is its composite with this conjugation. -/
noncomputable def imageFieldConj : imageField N →+* imageField N :=
  ((starRingEnd ℂ).comp (imageField N).subtype).codRestrict (imageField N) fun z ↦
    conj_mem_imageField N z.2

lemma inverse_conjugate : inverse (conjugate χ) = (inverse χ).comp (imageFieldConj N) :=
  RingHom.ext fun z ↦ (conjugate χ).injective <| by
    simp [apply_inverse, imageFieldConj]

end ComplexEmbedding

namespace CMType

variable {N} [NumberField N] [IsGalois ℚ N] (Θ : CMType N)

/-- The **inverted CM type** of a CM type `Θ` of a finite Galois extension `N` of `ℚ`: the
inverses of the embeddings in `Θ`, a set of embeddings into `N` of the image `F` of `N` in `ℂ`. For
`Θ` induced by a CM type `Φ` of a subfield `K` of `N`, this is the "CM type on `F` with values in
`N`" of the LMFDB knowl `nf.reflex_reflex_field`. It contains exactly one of each pair of complex
conjugate embeddings of `F` into `N` (`mem_inverseType_iff_comp_imageFieldConj_notMem`). -/
noncomputable def inverseType : Set (imageField N →+* N) :=
  inverse '' Θ.1

/-- **The inverted CM type is a CM type with values in `N`**: it contains exactly one of an
embedding `ψ` of `F` into `N` and its complex conjugate, the composite of `ψ` with complex
conjugation on `F`. -/
lemma mem_inverseType_iff_comp_imageFieldConj_notMem (ψ : imageField N →+* N) :
    ψ ∈ Θ.inverseType ↔ ψ.comp (imageFieldConj N) ∉ Θ.inverseType := by
  rcases inverse_surjective ψ with ⟨χ, rfl⟩
  rw [← inverse_conjugate, inverseType, inverse_injective.mem_set_image,
    inverse_injective.mem_set_image]
  exact Θ.2 χ

/-- The **stabiliser of the inverted CM type** of `Θ` in the automorphism group of `N` over `ℚ`,
acting on the embeddings into `N` by composition: the `g` such that `g ∘ ψ` lies in the inverted
CM type if and only if `ψ` does. As in the definition of the reflex field of a CM type (LMFDB
`nf.reflex_field`), with `N` in place of the algebraic closure of `ℚ`, its fixed field in `N` is
the reflex field of the inverted CM type. -/
def inverseTypeStabilizer : Subgroup (N ≃ₐ[ℚ] N) where
  carrier := {g | ∀ ψ : imageField N →+* N,
    ψ ∈ Θ.inverseType ↔ (g : N →+* N).comp ψ ∈ Θ.inverseType}
  mul_mem' hg hh ψ := (hh ψ).trans (hg _)
  one_mem' _ := Iff.rfl
  inv_mem' {g} hg ψ := by
    have h : (g : N →+* N).comp (((g⁻¹ : N ≃ₐ[ℚ] N) : N →+* N).comp ψ) = ψ :=
      RingHom.ext fun x ↦ by simp
    exact ((hg _).trans (by rw [h])).symm

/-- **`inverseTypeStabilizer` is the stabiliser for the action by composition**: `g` lies in it if
and only if `g ∘ Ψ = Ψ` for the inverted CM type `Ψ`, where `g ∘ Ψ` is the set of the `g ∘ ψ` for
`ψ ∈ Ψ`. -/
lemma mem_inverseTypeStabilizer_iff_image_comp_eq {g : N ≃ₐ[ℚ] N} :
    g ∈ Θ.inverseTypeStabilizer ↔ ((g : N →+* N).comp ·) '' Θ.inverseType = Θ.inverseType := by
  refine ⟨fun h ↦ Set.ext fun ψ ↦ ⟨?_, fun hψ ↦ ⟨((g⁻¹ : N ≃ₐ[ℚ] N) : N →+* N).comp ψ,
    (inv_mem h ψ).mp hψ, RingHom.ext fun x ↦ by simp⟩⟩, fun h ψ ↦ ⟨fun hψ ↦ h.subset ⟨ψ, hψ, rfl⟩,
    fun hψ ↦ ?_⟩⟩
  · rintro ⟨ψ', hψ', rfl⟩
    exact (h ψ').mp hψ'
  · rcases h.symm.subset hψ with ⟨ψ', hψ', hψψ'⟩
    have h' : ψ' = ψ := RingHom.ext fun x ↦ by simpa using RingHom.congr_fun hψψ' x
    exact h' ▸ hψ'

/-- **The automorphisms stabilising the inverted CM type are those stabilising the CM type under
precomposition**: the inverse of `χ ∘ g⁻¹` is the composite of `g` with the inverse of `χ`. -/
lemma inverseTypeStabilizer_eq : Θ.inverseTypeStabilizer = Θ.precompStabilizer := by
  have h (g : N ≃ₐ[ℚ] N) (χ : N →+* ℂ) : (g : N →+* N).comp (inverse χ) ∈ Θ.inverseType ↔
      χ.comp ((g⁻¹ : N ≃ₐ[ℚ] N) : N →+* N) ∈ Θ.1 := by
    rw [comp_inverse, inverseType, inverse_injective.mem_set_image]
  refine Subgroup.ext fun g ↦ ⟨fun hg ↦ inv_mem_iff.mp fun χ ↦ ?_, fun hg ψ ↦ ?_⟩
  · rw [← h, ← hg, inverseType, inverse_injective.mem_set_image]
  · rcases inverse_surjective ψ with ⟨χ, rfl⟩
    rw [h, inverseType, inverse_injective.mem_set_image]
    exact inv_mem hg χ

/-- **The reflex field of the reflex field is the reflex field of the inverted CM type** (LMFDB
`nf.reflex_reflex_field`): for a CM type `Φ` of `K`, a finite Galois extension `N` of `ℚ`
containing `K`, such as a Galois closure of `K`, and the CM type `Φ_N` of `N` induced by `Φ`, the
subfield of `N` fixed by the stabiliser of the inverses of the embeddings in `Φ_N` is the image of
the reflex field of the reflex field of `Φ`. -/
lemma map_algebraMap_reflexReflexField_eq_fixedField_inverseTypeStabilizer {K : Type*} [Field K]
    [NumberField K] [Algebra K N] (Φ : CMType K) : Φ.reflexReflexField.map (algebraMap K N) =
      (fixedField (Φ.induce (algebraMap K N)).inverseTypeStabilizer).toSubfield := by
  rw [inverseTypeStabilizer_eq]
  exact Φ.map_algebraMap_reflexReflexField N

end CMType

end NumberField
