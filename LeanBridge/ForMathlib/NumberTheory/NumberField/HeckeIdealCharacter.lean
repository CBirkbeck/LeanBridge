import TauCeti.NumberTheory.NumberField.Global.HeckeCharacter.Ideal

/-!
# Hecke characters as characters of ideals

The classical, ideal-theoretic notion of a Hecke character modulo `𝔪` of a number field `K`: a
homomorphism `χ : I(𝔪) → ℂˣ` from the group of fractional ideals prime to `𝔪` such that, for some
continuous characters `χ_w` of the completions `K_wˣ` at the infinite places, `χ((α)) = ∏_w χ_w(α)`
for every `α ∈ Kˣ` with `α ≡ 1 mod* 𝔪`. Tau Ceti's Hecke characters are idelic; the ideal character
of an idelic Hecke character is one in this sense. The converse, that every ideal-theoretic Hecke
character arises in this way, is not proved here.

## Main definitions

* `TauCeti.GlobalNumberFields.IsIdealHeckeCharacter` (LMFDB `character.hecke`).

## Main results

* `TauCeti.GlobalNumberFields.HeckeCharacter.isIdealHeckeCharacter_idealCharacter`: the ideal
  character of an idelic Hecke character is a Hecke character modulo its finite conductor.
-/

open NumberField IsDedekindDomain

open scoped NumberField

namespace TauCeti.GlobalNumberFields

variable {K : Type*} [Field K] [NumberField K]

/-- A homomorphism `χ : I(𝔪) → ℂˣ` from the fractional ideals of `K` prime to a modulus `𝔪` is a
**Hecke character** modulo `𝔪` (LMFDB `character.hecke`) if there are continuous characters
`χ_w : K_wˣ → ℂˣ` of the completions at the infinite places such that `χ((α)) = ∏_w χ_w(α)` for
every `α ∈ Kˣ` with `α ≡ 1 mod* 𝔪`. The LMFDB's modulus is an integral ideal, the modulus with no
infinite part, for which `α ≡ 1 mod* 𝔪` is the condition `v_𝔭(α - 1) ≥ v_𝔭(𝔪)` at the primes
`𝔭 ∣ 𝔪`; a general modulus also imposes positivity at the real places it contains.

The knowl asks for a homomorphism `χ_∞ : Kˣ/ℚˣ → ℂˣ` with no further condition, which does not give
the intended notion: an arbitrary homomorphism imposes no condition at all on the restriction of
`χ` to the principal ideals generated by elements `≡ 1 mod* 𝔪` that are independent modulo `ℚˣ`,
and triviality on `ℚˣ` is not part of the classical definition. The standard requirement, made
here, is that `χ_∞` be the restriction to `Kˣ` of a continuous character of
`(K ⊗ ℝ)ˣ = ∏_w K_wˣ`. -/
def IsIdealHeckeCharacter (𝔪 : Modulus K) (χ : idealsPrimeTo 𝔪 →* ℂˣ) : Prop :=
  ∃ φ : ∀ w : InfinitePlace K, w.Completionˣ →ₜ* ℂˣ, ∀ (x : Kˣ) (hx : IsCongrOne 𝔪 x),
    χ ⟨toPrincipalIdeal (𝓞 K) K x, hx.toPrincipalIdeal_mem_idealsPrimeTo⟩ =
      ∏ w, φ w (Units.map (algebraMap K w.Completion).toMonoidHom x)

/-- **The ideal character of an idelic Hecke character is a Hecke character** modulo its finite
conductor, with the inverses of the infinite components as characters at the infinite places. -/
lemma HeckeCharacter.isIdealHeckeCharacter_idealCharacter (χ : HeckeCharacter K) :
    IsIdealHeckeCharacter _ χ.idealCharacter :=
  ⟨fun w ↦ (χ.infiniteComponent w)⁻¹, fun x hx ↦ by
    rw [χ.idealCharacter_apply_toPrincipalIdeal x hx, ← Finset.prod_inv_distrib]
    rfl⟩

end TauCeti.GlobalNumberFields
