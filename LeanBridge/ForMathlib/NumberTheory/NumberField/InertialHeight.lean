import LeanBridge.ForMathlib.NumberTheory.NumberField.WeightFunction
import Mathlib.Algebra.BigOperators.Finprod
import Mathlib.Algebra.CharP.CharAndCard
import Mathlib.Analysis.SpecialFunctions.Pow.NNReal
import TauCeti.NumberTheory.LocalField.Padic
import TauCeti.NumberTheory.LocalField.Tame.Quotient

/-!
# Local and inertial height functions

Let `w` be a weight function on a finite group `G`. For a prime `p ∤ #G`, the local height of a
continuous homomorphism `φ : Gal(ℚ̄_p/ℚ_p) → G` is `H_{w,p}(φ) = p ^ w(φ(τ_p))`, where `τ_p` is a
generator of the tame inertia group: an element of the inertia subgroup whose tame character
topologically generates `ℤ̂^{(p')}(1)`. Such a `φ` kills wild inertia, which is pro-`p`, so the
image of inertia is the cyclic group generated by `φ(τ_p)`; as `w` takes the same value at two
generators of a cyclic subgroup of `G`, the local height does not depend on the choice of `τ_p`.
The inertial height of a continuous homomorphism `φ : Gal(ℚ̄/ℚ) → G` is the product over all primes
of the local heights of the restrictions of `φ` to the decomposition groups, with auxiliary local
heights `H_p` at the primes `p ∣ #G`. For the weight function equal to `1` away from the identity
the local height at `p ∤ #G` is `p` or `1` according as `φ` is ramified at `p` or not, so the
inertial height is the radical discriminant: the product of the primes at which `φ` ramifies.

The LMFDB knowl `nf.inertial_height_function` writes `H_{w,p}(φ) = w(φ(τ_p))`, which vanishes at
every unramified `φ`, and takes the product of the `H_{w,p}` over the primes `p ∣ #G`; these are
misprints for `p ^ w(φ(τ_p))` and for the primes `p ∤ #G`, as the example of the radical
discriminant shows.

The product over all primes is a `finprod`. For a finite `G` it has finite support, as a continuous
`φ` is unramified at all but finitely many primes; this is not proved here.

## Main definitions

* `NumberField.WeightFunction.localHeight` (LMFDB `nf.inertial_height_function`): the local height
  function `H_{w,p}`.
* `NumberField.WeightFunction.inertialHeight` (LMFDB `nf.inertial_height_function`): the inertial
  height function.

## Main results

* `NumberField.WeightFunction.toFun_eq_of_zpowers_eq`: a weight function takes the same value at
  two generators of the same cyclic subgroup.
* `NumberField.WeightFunction.localHeight_eq`: the local height at `p ∤ #G` may be computed with any
  generator of tame inertia.
* `NumberField.WeightFunction.localHeight_indicator`: for the weight function equal to `1` away
  from the identity, the local height at `p ∤ #G` is `1` or `p` according as `φ` is unramified or
  not.
* `NumberField.WeightFunction.inertialHeight_indicator`: the corresponding inertial height is the
  radical discriminant, the product of the primes at which `φ` is ramified.
-/

open scoped NNReal

open TauCeti

namespace Padic

variable {G : Type*} [Group G] [TopologicalSpace G] [DiscreteTopology G] {p : ℕ} [Fact p.Prime]
  (hp : ¬p ∣ Nat.card G) (φ : Field.absoluteGaloisGroup ℚ_[p] →ₜ* G)
include hp

lemma wildInertiaSubgroup_le_ker :
    wildInertiaSubgroup ℚ_[p] ≤ (φ : Field.absoluteGaloisGroup ℚ_[p] →* G).ker := by
  intro σ hσ
  have : Fintype (IsLocalRing.ResidueField (ValuativeRel.valuation ℚ_[p]).integer) :=
    Fintype.ofFinite _
  have : CharP (IsLocalRing.ResidueField (ValuativeRel.valuation ℚ_[p]).integer) p :=
    charP_of_card_eq_prime (by rw [← Nat.card_eq_fintype_card, natCard_residueField])
  have hP : IsPGroup p ((φ : Field.absoluteGaloisGroup ℚ_[p] →* G).comp
      (wildInertiaSubgroup ℚ_[p]).subtype).range :=
    (isProP_wildInertiaSubgroup ℚ_[p] p).isPGroup_range _
      ((isOpen_discrete ({1} : Set G)).preimage (φ.continuous.comp continuous_subtype_val))
  rcases hP ⟨φ σ, ⟨σ, hσ⟩, rfl⟩ with ⟨k, hk⟩
  have hk' : φ σ ^ p ^ k = 1 := by simpa using congrArg Subtype.val hk
  rw [MonoidHom.mem_ker, ← orderOf_eq_one_iff]
  exact ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr hp |>.pow_left k
    |>.coprime_dvd_left (orderOf_dvd_of_pow_eq_one hk')).eq_one_of_dvd (orderOf_dvd_natCard _)

lemma map_inertiaSubgroup_eq_zpowers {τ : inertiaSubgroup ℚ_[p]}
    (hτ : (Subgroup.zpowers (inertiaTameCharacter ℚ_[p] τ)).topologicalClosure = ⊤) :
    (inertiaSubgroup ℚ_[p]).map (φ : Field.absoluteGaloisGroup ℚ_[p] →* G) =
      Subgroup.zpowers (φ τ) :=
  (map_inertiaSubgroup_eq_topologicalClosure_zpowers _ φ.continuous
    (wildInertiaSubgroup_le_ker hp φ) hτ).trans (isClosed_discrete _).subgroup_topologicalClosure_eq

end Padic

namespace NumberField.WeightFunction

variable {G : Type*} [Group G] (w : WeightFunction G)

/-- **A weight function takes the same value at two generators of a cyclic subgroup** of a finite
group: such generators are powers of each other by exponents prime to their order, and these
exponents may be chosen prime to the order of the group. -/
lemma toFun_eq_of_zpowers_eq [Finite G] {x y : G} (h : Subgroup.zpowers x = Subgroup.zpowers y) :
    w.toFun x = w.toFun y := by
  have hy : y ∈ Submonoid.powers x :=
    (isOfFinOrder_of_finite x).mem_powers_iff_mem_zpowers.mpr (h ▸ Subgroup.mem_zpowers y)
  have hx : x ∈ Submonoid.powers y :=
    (isOfFinOrder_of_finite y).mem_powers_iff_mem_zpowers.mpr (h ▸ Subgroup.mem_zpowers x)
  rcases hy with ⟨k, rfl⟩
  rcases hx with ⟨l, hl⟩
  have hkl : k * l ≡ 1 [MOD orderOf x] :=
    pow_eq_pow_iff_modEq.mp <| (pow_mul x k l).trans <| hl.trans (pow_one x).symm
  rcases ZMod.unitsMap_surjective (orderOf_dvd_natCard x)
    (ZMod.unitOfCoprime k (Nat.coprime_of_mul_modEq_one l hkl)) with ⟨v, hv⟩
  have hvk : ((v : ZMod (Nat.card G)).val : ZMod (orderOf x)) = k := by
    rw [ZMod.natCast_val, ← ZMod.unitsMap_val (orderOf_dvd_natCard x), hv, ZMod.coe_unitOfCoprime]
  rw [← w.toFun_pow x _ (ZMod.val_coe_unit_coprime v)]
  exact congrArg w.toFun (pow_eq_pow_iff_modEq.mpr ((ZMod.natCast_eq_natCast_iff _ _ _).mp hvk))

variable [TopologicalSpace G] [DiscreteTopology G]

/-- The **local height function** `H_{w,p}` of a weight function `w` on a finite group `G` at a
prime `p ∤ #G` (LMFDB `nf.inertial_height_function`): `H_{w,p}(φ) = p ^ w(φ(τ_p))` for a continuous
homomorphism `φ : Gal(ℚ̄_p/ℚ_p) → G`, where `τ_p` is a generator of the tame inertia group, an
element of the inertia subgroup whose tame character topologically generates `ℤ̂^{(p')}(1)`. The
value does not depend on the choice of `τ_p` (`NumberField.WeightFunction.localHeight_eq`). The
LMFDB knowl writes `w(φ(τ_p))`, a misprint for `p ^ w(φ(τ_p))`. The definition makes sense at every
prime, with a fixed choice of `τ_p`; at the primes `p ∣ #G`, where wild inertia need not die in `G`,
its value may depend on that choice, and it is not used there. -/
noncomputable def localHeight (p : ℕ) [Fact p.Prime] (φ : Field.absoluteGaloisGroup ℚ_[p] →ₜ* G) :
    ℝ≥0 :=
  (p : ℝ≥0) ^
    (w.toFun (φ (exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top ℚ_[p]).choose) : ℝ)

/-- The **inertial height function** of a weight function `w` on a finite group `G` (LMFDB
`nf.inertial_height_function`), with auxiliary local heights `H ℓ` at the primes `ℓ ∣ #G`: for a
continuous homomorphism `φ : Gal(ℚ̄/ℚ) → G`, the product over all primes `ℓ` of `H ℓ (φ_ℓ)` if
`ℓ ∣ #G` and of the local height `H_{w,ℓ}(φ_ℓ)` if `ℓ ∤ #G`, where `φ_ℓ` is the restriction of `φ`
to the decomposition group `Gal(ℚ̄_ℓ/ℚ_ℓ)`, along Mathlib's chosen embedding `ℚ̄ → ℚ̄_ℓ`. The
LMFDB knowl takes the auxiliary heights positive, and writes the product of the `H_{w,ℓ}` over the
primes `ℓ ∣ #G`, a misprint for `ℓ ∤ #G`.

The product is a `finprod`, which is `1` when infinitely many factors differ from `1`. That does not
happen for a finite `G`, though this is not proved here: the kernel of `φ` is open, so it cuts out a
finite Galois extension of `ℚ`, and at the primes `ℓ ∤ #G` unramified in it the restriction `φ_ℓ`
kills inertia, so that `H_{w,ℓ}(φ_ℓ) = ℓ ^ w(1) = 1`. (For an infinite `G`, outside the knowl's
setting, `Nat.card G = 0` and every prime counts as dividing `#G`.) -/
noncomputable def inertialHeight
    (H : ∀ (ℓ : ℕ) [Fact ℓ.Prime], (Field.absoluteGaloisGroup ℚ_[ℓ] →ₜ* G) → ℝ≥0)
    (φ : Field.absoluteGaloisGroup ℚ →ₜ* G) : ℝ≥0 :=
  ∏ᶠ (ℓ : ℕ) (hℓ : ℓ.Prime),
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    letI φℓ : Field.absoluteGaloisGroup ℚ_[ℓ] →ₜ* G :=
      φ.comp (Field.absoluteGaloisGroup.map (algebraMap ℚ ℚ_[ℓ]))
    if ℓ ∣ Nat.card G then H ℓ φℓ else w.localHeight ℓ φℓ

variable {p : ℕ} [Fact p.Prime] (hp : ¬p ∣ Nat.card G) (ψ : Field.absoluteGaloisGroup ℚ_[p] →ₜ* G)

include hp in
/-- **The local height does not depend on the generator of tame inertia**: at a prime `p ∤ #G`, it
is `p ^ w(ψ(τ))` for every element `τ` of inertia whose tame character topologically generates
`ℤ̂^{(p')}(1)`. -/
lemma localHeight_eq {τ : inertiaSubgroup ℚ_[p]}
    (hτ : (Subgroup.zpowers (inertiaTameCharacter ℚ_[p] τ)).topologicalClosure = ⊤) :
    w.localHeight p ψ = (p : ℝ≥0) ^ (w.toFun (ψ τ) : ℝ) := by
  have : Finite G := Nat.finite_of_card_ne_zero fun h ↦ hp (h ▸ dvd_zero p)
  rw [localHeight, w.toFun_eq_of_zpowers_eq ((Padic.map_inertiaSubgroup_eq_zpowers hp ψ
    (exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top ℚ_[p]).choose_spec).symm.trans
    (Padic.map_inertiaSubgroup_eq_zpowers hp ψ hτ))]

variable [DecidableEq G]

open scoped Classical in
include hp in
/-- **The local height of the weight function equal to `1` away from the identity** at a prime
`p ∤ #G` is `1` if `ψ` is unramified, i.e. kills the inertia subgroup, and `p` otherwise. -/
lemma localHeight_indicator : indicator.localHeight p ψ =
    if (inertiaSubgroup ℚ_[p]).map (ψ : Field.absoluteGaloisGroup ℚ_[p] →* G) = ⊥ then 1
    else (p : ℝ≥0) := by
  rw [Padic.map_inertiaSubgroup_eq_zpowers hp ψ
    (exists_topologicalClosure_zpowers_inertiaTameCharacter_eq_top ℚ_[p]).choose_spec,
    Subgroup.zpowers_eq_bot, localHeight]
  split_ifs with h <;> simp [indicator, h]

open scoped Classical in
/-- **The inertial height of the weight function equal to `1` away from the identity is the radical
discriminant**: with the auxiliary local heights `H ℓ χ` equal to `ℓ` or `1` at the primes
`ℓ ∣ #G`, according as `χ : Gal(ℚ̄_ℓ/ℚ_ℓ) → G` is ramified (does not kill the inertia subgroup) or
not, the inertial height of `φ` is the product over all primes `ℓ` of `H ℓ (φ_ℓ)`, the product of
the primes at which `φ` is ramified. These are the primes ramified in the number field cut out by
`φ`; that comparison with the ramification of number fields is not formalised. -/
lemma inertialHeight_indicator (φ : Field.absoluteGaloisGroup ℚ →ₜ* G) :
    letI H (ℓ : ℕ) [Fact ℓ.Prime] (χ : Field.absoluteGaloisGroup ℚ_[ℓ] →ₜ* G) : ℝ≥0 :=
      if (inertiaSubgroup ℚ_[ℓ]).map (χ : Field.absoluteGaloisGroup ℚ_[ℓ] →* G) = ⊥ then 1 else ℓ
    indicator.inertialHeight H φ = ∏ᶠ (ℓ : ℕ) (hℓ : ℓ.Prime),
      haveI : Fact ℓ.Prime := ⟨hℓ⟩
      H ℓ (φ.comp (Field.absoluteGaloisGroup.map (algebraMap ℚ ℚ_[ℓ]))) := by
  refine finprod_congr fun ℓ ↦ finprod_congr fun hℓ ↦ ?_
  have : Fact ℓ.Prime := ⟨hℓ⟩
  by_cases h : ℓ ∣ Nat.card G
  · exact ite_eq_left h
  · exact (ite_eq_right h).trans (localHeight_indicator h _)

end NumberField.WeightFunction
