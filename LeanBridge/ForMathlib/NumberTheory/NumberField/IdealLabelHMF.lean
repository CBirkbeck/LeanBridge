import Mathlib.Algebra.CharZero.Infinite
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.RingTheory.DedekindDomain.Factorization
import Mathlib.RingTheory.Ideal.Int

/-!
# Labels of ideals of number fields in the Hilbert modular form convention

On its pages of Hilbert modular forms, the LMFDB represents an ideal `I` of the ring of integers
`𝓞 K` of a number field `K` by a label `[N, m, α]` (LMFDB `nf.ideal.label.hmf`), where `N` is the
absolute norm of `I`, `m` is the smallest positive rational integer in `I`, and `α` is an element
of `𝓞 K` with `(m, α) = I`.

The first two entries are functions of `I`: they are Mathlib's `Ideal.absNorm I` and
`Ideal.absNorm (Ideal.under ℤ I)`, the second being the smallest positive integer in `I` by
`Int.absNorm_under_eq_sInf` (it divides the first, `Int.absNorm_under_dvd_absNorm`). The third is
not: a nonzero ideal of a Dedekind domain is generated by any of its nonzero elements together
with a suitable second element (`IsDedekindDomain.exists_eq_span_pair`), which is far from unique,
and the LMFDB picks one by a database convention that the knowl does not specify. That choice is
not mathematics and is not formalised: a label is a relation between an ideal and the triples
`[N, m, α]` that represent it.

The pages of Hilbert modular forms describe the level `𝔑` by `[N, n, β]` with `𝔑 = (N, n, β)`
(LMFDB `mf.hilbert.label`), three generators instead of two: as `N` lies in `𝔑 ∩ ℤ = nℤ`, this is
the same relation (`Ideal.isHMFLabel_iff`).

## Main definitions

* `Ideal.IsHMFLabel` (LMFDB `nf.ideal.label.hmf`): `[N, m, α]` is a label of `I`.

## Main results

* `Ideal.isHMFLabel_iff`: `[N, m, α]` is a label of `I` exactly when `N` is the norm of `I`, `m`
  generates `I ∩ ℤ` and `I = (N, m, α)`, the form of LMFDB `mf.hilbert.label`.
* `Ideal.exists_isHMFLabel`: every nonzero ideal has a label, whose first two entries are its
  absolute norm and the smallest positive integer in it.
* `Ideal.IsHMFLabel.eq`: a label determines the ideal.
-/

open NumberField

namespace Ideal

variable {K : Type*} [Field K] [NumberField K] (I J : Ideal (𝓞 K)) {N m : ℕ} {α : 𝓞 K}

variable (N m α) in
/-- `[N, m, α]` is a **label** of an ideal `I` of the ring of integers of a number field in the
Hilbert modular form convention (LMFDB `nf.ideal.label.hmf`): `N` is the absolute norm of `I`, `m`
is the smallest positive rational integer in `I`, which is `absNorm (under ℤ I)`
(`Int.absNorm_under_eq_sInf`), and `α` is an element such that `I` is generated by `m` and `α`.
Every nonzero ideal has a label (`exists_isHMFLabel`). The element `α` is not determined by `I`,
and the LMFDB chooses one by a database convention that the knowl does not specify, which is not
formalised, so this is a relation and not a function of `I`. -/
def IsHMFLabel : Prop :=
  N = absNorm I ∧ m = absNorm (under ℤ I) ∧ span {(m : 𝓞 K), α} = I

/-- **A label is the description of the Hilbert modular form pages** (LMFDB `mf.hilbert.label`):
`[N, m, α]` is a label of `I` exactly when `N` is the absolute norm of `I`, `m` generates `I ∩ ℤ`
and `I = (N, m, α)`, since `N` lies in `I ∩ ℤ = mℤ`, so that `(N, m, α) = (m, α)`. -/
lemma isHMFLabel_iff : I.IsHMFLabel N m α ↔ absNorm I = N ∧ under ℤ I = span {(m : ℤ)} ∧
    I = span {(N : 𝓞 K), (m : 𝓞 K), α} := by
  refine ⟨?_, ?_⟩
  · rintro ⟨rfl, rfl, h⟩
    refine ⟨rfl, (Int.ideal_span_absNorm_eq_self _).symm, ?_⟩
    rw [span_insert, h, sup_eq_right.mpr (I.span_singleton_le_iff_mem.mpr I.absNorm_mem)]
  · rintro ⟨rfl, hm, h⟩
    have hm' : m = absNorm (under ℤ I) := by
      rw [hm, absNorm_apply, Submodule.cardQuot_apply, Int.card_ideal_quot]
    have hdvd : m ∣ absNorm I := hm' ▸ Int.absNorm_under_dvd_absNorm I
    have hN : (absNorm I : 𝓞 K) ∈ span {(m : 𝓞 K), α} :=
      span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) <|
        mem_span_singleton.mpr <| Nat.cast_dvd_cast hdvd
    refine ⟨rfl, hm', ?_⟩
    rw [h, span_insert (absNorm I : 𝓞 K), sup_eq_right.mpr ((span_singleton_le_iff_mem _).mpr hN)]

variable {I} in
/-- **Every nonzero ideal has a label** `[N, m, α]` in the Hilbert modular form convention, with
`N` its absolute norm and `m` the smallest positive integer in it: since `m ≠ 0` lies in `I`, the
ideal is `(m, α)` for some `α`, as any nonzero ideal of a Dedekind domain is generated by any of
its nonzero elements and one more element. -/
lemma exists_isHMFLabel (hI : I ≠ ⊥) : ∃ α, I.IsHMFLabel (absNorm I) (absNorm (under ℤ I)) α := by
  have hm : absNorm (under ℤ I) ≠ 0 := fun h ↦
    hI <| absNorm_eq_zero_iff.mp <| Nat.eq_zero_of_zero_dvd <| h ▸ Int.absNorm_under_dvd_absNorm I
  rcases IsDedekindDomain.exists_eq_span_pair (Int.absNorm_under_mem I) (Nat.cast_ne_zero.mpr hm)
    with ⟨α, hα⟩
  exact ⟨α, rfl, rfl, hα.symm⟩

variable {I J} in
/-- **A label determines the ideal**: an ideal is generated by the last two entries of any of its
labels. -/
lemma IsHMFLabel.eq (h : I.IsHMFLabel N m α) (h' : J.IsHMFLabel N m α) : I = J :=
  h.2.2.symm.trans h'.2.2

end Ideal
