import TauCeti.NumberTheory.NumberField.LocalGlobal.Semilocal.Basic

/-!
# The completions of a number field from the roots of a defining polynomial

Let `L / K` be an extension of number fields, `a` a generator of `L` over `K`, given as a power
basis of `L / K` (Mathlib's `PowerBasis.ofAdjoinEqTop` makes one from every `a` with `K(a) = L`),
with minimal polynomial `f`, and `v` a finite place of `K` (LMFDB `nf.padic_completion`, for
`K = ℚ` and `v = p`, where `K_v = ℚ_p` by Mathlib's
`Rat.HeightOneSpectrum.adicCompletion.padicEquiv`).

Tau Ceti's semi-local decomposition `K_v ⊗_K L ≃ ∏_{w ∣ v} L_w` sends `1 ⊗ a` to the tuple of the
images `a_w` of `a`, and `1 ⊗ a` generates `K_v ⊗_K L` over `K_v`, with minimal polynomial `f`. So
each `L_w` is generated over `K_v` by `a_w`, and `L_w ≃ K_v[x] / (q_w)` for the minimal polynomial
`q_w` of `a_w`, a monic irreducible factor of `f` over `K_v`. Conversely every monic irreducible
factor `q` of `f` over `K_v` is a `q_w`: otherwise `q` is a unit at `(a_w)_w`, so the cofactor of
`q` in `f`, of smaller degree, vanishes at `(a_w)_w`. So adjoining the roots of `f` to `K_v`
constructs the completions of `L` above `v`.

## Main definitions

* `PowerBasis.baseChange`: the power basis `1 ⊗ a` of `A ⊗_K L` over `A`.
* `NumberField.adjoinRootEquivCompletion` (LMFDB `nf.padic_completion`):
  `K_v[x] / (q_w) ≃ₐ[K_v] L_w`.

## Main theorems

* `NumberField.adjoin_simple_algebraMap_eq_top` (LMFDB `nf.padic_completion`): `K_v(a_w) = L_w`.
* `NumberField.minpoly_dvd_map_minpoly` (LMFDB `nf.padic_completion`): `q_w` divides `f` over
  `K_v`.
* `NumberField.exists_eq_minpoly_algebraMap` (LMFDB `nf.padic_completion`): every monic
  irreducible factor of `f` over `K_v` is some `q_w`.
-/

open IsDedekindDomain Module Polynomial TauCeti

open scoped NumberField TensorProduct IntermediateField AdicCompletionExtension Valued

namespace PowerBasis

variable {K L : Type*} [Field K] [Field L] [Algebra K L] (A : Type*) [Field A] [Algebra K A]
  (pb : PowerBasis K L)

open Algebra in
/-- The power basis `1 ⊗ a` of the base change `A ⊗_K L` over `A`, for a power basis `a` of
`L / K`. -/
noncomputable def baseChange : PowerBasis A (A ⊗[K] L) where
  gen := 1 ⊗ₜ pb.gen
  dim := pb.dim
  basis := pb.basis.baseChange A
  basis_eq_pow i := by
    rw [Basis.baseChange_apply, pb.basis_eq_pow]
    induction i.1 with
    | zero => rw [pow_zero, pow_zero, TensorProduct.one_def]
    | succ n ih => rw [pow_succ, pow_succ, ← ih, TensorProduct.tmul_mul_tmul, mul_one]

lemma baseChange_gen : (pb.baseChange A).gen = 1 ⊗ₜ pb.gen :=
  rfl

lemma baseChange_dim : (pb.baseChange A).dim = pb.dim :=
  rfl

open Algebra in
lemma minpoly_baseChange_gen :
    minpoly A (pb.baseChange A).gen = (minpoly K pb.gen).map (algebraMap K A) := by
  refine (eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic (pb.baseChange A).isIntegral_gen)
    ((minpoly.monic pb.isIntegral_gen).map _) (minpoly.dvd _ _ ?_) ?_).symm
  · rw [aeval_map_algebraMap, baseChange_gen, ← TensorProduct.includeRight_apply,
      aeval_algHom_apply, minpoly.aeval, map_zero]
  · rw [natDegree_map, natDegree_minpoly, natDegree_minpoly, baseChange_dim]

end PowerBasis

namespace NumberField

variable {K : Type*} [Field K] [NumberField K] {L : Type*} [Field L] [NumberField L] [Algebra K L]
  (v : HeightOneSpectrum (𝓞 K)) (pb : PowerBasis K L)
  (w : {w : HeightOneSpectrum (𝓞 L) // w.asIdeal.LiesOver v.asIdeal})

lemma semilocalEquiv_baseChange_gen :
    semilocalEquiv L v (pb.baseChange (v.adicCompletion K)).gen w =
      algebraMap L (w.1.adicCompletion L) pb.gen := by
  rw [PowerBasis.baseChange_gen, semilocalEquiv_tmul, map_one, one_mul]

lemma adjoin_algebraMap_eq_top :
    Algebra.adjoin (v.adicCompletion K) {algebraMap L (w.1.adicCompletion L) pb.gen} = ⊤ := by
  let φ : v.adicCompletion K ⊗[K] L →ₐ[v.adicCompletion K] w.1.adicCompletion L :=
    (Pi.evalAlgHom _ _ w).comp (semilocalEquiv L v).toAlgHom
  have hφ : Function.Surjective φ :=
    (Function.surjective_eval w).comp (semilocalEquiv L v).surjective
  have himage : φ '' {(pb.baseChange (v.adicCompletion K)).gen} =
      {algebraMap L (w.1.adicCompletion L) pb.gen} := by
    rw [Set.image_singleton, ← semilocalEquiv_baseChange_gen]
    rfl
  rw [← himage, Algebra.adjoin_image, PowerBasis.adjoin_gen_eq_top, Algebra.map_top,
    (AlgHom.range_eq_top φ).2 hφ]

/-- **The completion `L_w` is generated by `a`** (LMFDB `nf.padic_completion`): `K_v(a_w) = L_w`
for the image `a_w` of a generator `a` of `L / K`. -/
lemma adjoin_simple_algebraMap_eq_top :
    (v.adicCompletion K)⟮algebraMap L (w.1.adicCompletion L) pb.gen⟯ = ⊤ :=
  IntermediateField.adjoin_eq_top_of_algebra _ _ (adjoin_algebraMap_eq_top v pb w)

lemma aeval_algebraMap_map_minpoly : aeval (algebraMap L (w.1.adicCompletion L) pb.gen)
    ((minpoly K pb.gen).map (algebraMap K (v.adicCompletion K))) = 0 := by
  rw [aeval_map_algebraMap, aeval_algebraMap_apply, minpoly.aeval, map_zero]

/-- **The minimal polynomial of `a_w` divides `f`** (LMFDB `nf.padic_completion`): the minimal
polynomial `q_w` over `K_v` of the image `a_w` of `a` is a factor of `f` over `K_v`. -/
lemma minpoly_dvd_map_minpoly : minpoly (v.adicCompletion K)
    (algebraMap L (w.1.adicCompletion L) pb.gen) ∣
    (minpoly K pb.gen).map (algebraMap K (v.adicCompletion K)) :=
  minpoly.dvd _ _ (aeval_algebraMap_map_minpoly v pb w)

lemma isIntegral_algebraMap :
    IsIntegral (v.adicCompletion K) (algebraMap L (w.1.adicCompletion L) pb.gen) :=
  ⟨_, (minpoly.monic pb.isIntegral_gen).map _, aeval_algebraMap_map_minpoly v pb w⟩

/-- The completion `L_w` from a root of `f` (LMFDB `nf.padic_completion`):
`K_v[x] / (q_w) ≃ₐ[K_v] L_w` for the minimal polynomial `q_w` over `K_v` of the image `a_w` of a
generator `a` of `L / K`, a factor of `f` (`NumberField.minpoly_dvd_map_minpoly`). -/
noncomputable def adjoinRootEquivCompletion : AdjoinRoot (minpoly (v.adicCompletion K)
    (algebraMap L (w.1.adicCompletion L) pb.gen)) ≃ₐ[v.adicCompletion K] w.1.adicCompletion L :=
  (IntermediateField.adjoinRootEquivAdjoin _ (isIntegral_algebraMap v pb w)).trans
    ((IntermediateField.equivOfEq (adjoin_simple_algebraMap_eq_top v pb w)).trans
      IntermediateField.topEquiv)

/-- **Every factor of `f` over `K_v` gives a completion** (LMFDB `nf.padic_completion`): every
monic irreducible factor `q` of `f` over `K_v` is the minimal polynomial of the image `a_w` of `a`
in `L_w` for some place `w ∣ v`, so that `K_v[x] / (q) ≃ₐ[K_v] L_w`. -/
lemma exists_eq_minpoly_algebraMap {q : (v.adicCompletion K)[X]} (hq : Irreducible q)
    (hqm : q.Monic) (hdvd : q ∣ (minpoly K pb.gen).map (algebraMap K (v.adicCompletion K))) :
    ∃ w : {w : HeightOneSpectrum (𝓞 L) // w.asIdeal.LiesOver v.asIdeal}, q =
      minpoly (v.adicCompletion K) (algebraMap L (w.1.adicCompletion L) pb.gen) := by
  by_contra! h
  rcases hdvd with ⟨r, hr⟩
  have hα : minpoly (v.adicCompletion K) (semilocalEquiv L v (pb.baseChange _).gen) =
      (minpoly K pb.gen).map (algebraMap K (v.adicCompletion K)) := by
    rw [minpoly.algEquiv_eq, PowerBasis.minpoly_baseChange_gen]
  have hunit : IsUnit (aeval (semilocalEquiv L v (pb.baseChange _).gen) q) := by
    refine Pi.isUnit_iff.2 fun w ↦ isUnit_iff_ne_zero.2 fun h₀ ↦ h w ?_
    rw [aeval_pi_apply₂, semilocalEquiv_baseChange_gen] at h₀
    exact minpoly.eq_of_irreducible_of_monic hq h₀ hqm
  have hr₀ : aeval (semilocalEquiv L v (pb.baseChange _).gen) r = 0 := by
    have hf : aeval (semilocalEquiv L v (pb.baseChange _).gen)
        ((minpoly K pb.gen).map (algebraMap K (v.adicCompletion K))) = 0 :=
      hα ▸ minpoly.aeval _ _
    rwa [hr, map_mul, hunit.mul_right_eq_zero] at hf
  have hf₀ : (minpoly K pb.gen).map (algebraMap K (v.adicCompletion K)) ≠ 0 :=
    ((minpoly.monic pb.isIntegral_gen).map _).ne_zero
  have hr0 : r ≠ 0 :=
    right_ne_zero_of_mul (hr ▸ hf₀)
  have hle : ((minpoly K pb.gen).map (algebraMap K (v.adicCompletion K))).natDegree ≤
      r.natDegree :=
    natDegree_le_of_dvd (hα ▸ minpoly.dvd _ _ hr₀) hr0
  rw [hr, natDegree_mul hqm.ne_zero hr0] at hle
  exact hq.natDegree_pos.ne' (by omega)

end NumberField
