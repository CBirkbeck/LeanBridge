import LeanBridge.ForMathlib.NumberTheory.NumberField.WeilPolynomial.FrobeniusOrder
import Mathlib.RingTheory.Norm.Defs

/-!
# The real order of a Weil polynomial

The étale algebra `K = ℚ[F]` of an isogeny class of abelian varieties over `𝔽_q` with Weil
polynomial `h` contains the totally real subalgebra `K⁺ = ℚ[F + V]`, and the Frobenius order
`R = ℤ[F, V]` contains the real order `R⁺ = ℤ[F + V]`. The LMFDB records the index of `R⁺` in the
maximal order of `K⁺` and the norm `N_{K/ℚ}(F - V)`, which satisfies
`|N_{K/ℚ}(F - V)| = |Δ_R| / Δ_{R⁺}²` when `h` has no real roots (not formalised here). As in
`LeanBridge.ForMathlib.NumberTheory.NumberField.WeilPolynomial.FrobeniusOrder`, `K` is built from a
polynomial `h ∈ ℤ[x]`, and the results assume that `h` is a Weil `q`-polynomial.

## Main definitions

* `Polynomial.realSubalgebra`: the subalgebra `K⁺ = ℚ[F + V]` of `K`.
* `Polynomial.realOrder`: the real order `R⁺ = ℤ[F + V]` of `K⁺`.
* `Polynomial.realIndex` (LMFDB `av.fq.zfv_real_index`): the index `[𝒪_{K⁺} : ℤ[F + V]]`.
* `Polynomial.relativeDiscriminantNorm` (LMFDB `av.fq.zfv_rel_disc_norm`): the norm
  `N_{K/ℚ}(F - V)`.

## Main results

* `Polynomial.IsWeilPolynomial.realOrder_le_integralClosure`: `ℤ[F + V] ⊆ 𝒪_{K⁺}`.
-/

namespace Polynomial

open EtaleAlgebra

variable (q : ℕ) (h : ℤ[X])

/-- The **totally real subalgebra** `K⁺ = ℚ[F + V]` of the étale algebra `K = ℚ[F]` of a polynomial
`h ∈ ℤ[x]`, generated by the sum of the Frobenius `F` and the Verschiebung `V = q / F`. When `h` is
a Weil `q`-polynomial, for the LMFDB the Weil polynomial of an isogeny class of abelian varieties
over `𝔽_q`, it is the product of the maximal totally real subfields of the factors of `K` (not
formalised here). -/
noncomputable def realSubalgebra : Subalgebra ℚ h.EtaleAlgebra :=
  Algebra.adjoin ℚ {frobenius h + verschiebung q h}

/-- The **real order** `ℤ[F + V]` of a polynomial `h ∈ ℤ[x]`: the subring of `K⁺ = ℚ[F + V]`
generated by `F + V`, for the Frobenius `F` and the Verschiebung `V = q / F`. -/
noncomputable def realOrder : Subalgebra ℤ (h.realSubalgebra q) :=
  Algebra.adjoin ℤ {⟨frobenius h + verschiebung q h, Algebra.self_mem_adjoin_singleton ℚ _⟩}

/-- The **real index** (LMFDB `av.fq.zfv_real_index`) of a polynomial `h ∈ ℤ[x]`: the index
`[𝒪_{K⁺} : ℤ[F + V]]` of the additive group of the real order `ℤ[F + V]` in that of the maximal
order `𝒪_{K⁺}` of `K⁺ = ℚ[F + V]`, the integral closure of `ℤ` in `K⁺`. The LMFDB's `h` is the Weil
polynomial of an isogeny class of abelian varieties over `𝔽_q`; here `h` is any polynomial, and
when it is a Weil `q`-polynomial the real order lies in `𝒪_{K⁺}`
(`Polynomial.IsWeilPolynomial.realOrder_le_integralClosure`). That the index is then finite is not
formalised here; it is `0` when infinite. -/
noncomputable def realIndex : ℕ :=
  (h.realOrder q).toSubmodule.toAddSubgroup.relIndex
    (integralClosure ℤ (h.realSubalgebra q)).toSubmodule.toAddSubgroup

/-- The **relative discriminant norm** (LMFDB `av.fq.zfv_rel_disc_norm`) of a polynomial
`h ∈ ℤ[x]`: the norm `N_{K/ℚ}(F - V)` from its étale algebra `K = ℚ[F]`, for the Frobenius `F` and
the Verschiebung `V = q / F`; the LMFDB's `h` is the Weil polynomial of an isogeny class of abelian
varieties over `𝔽_q`. The LMFDB states `|N_{K/ℚ}(F - V)| = |Δ_R| / Δ_{R⁺}²` for the discriminants
of the Frobenius order `R = ℤ[F, V]` (which the LMFDB's text misprints as `ℚ[F, V]`) and of the
real order `R⁺ = ℤ[F + V]`. This holds when `h` has no real roots, and fails otherwise: a real root
makes `F - V` vanish in a factor of `K`, so that `N_{K/ℚ}(F - V) = 0`. It is not formalised
here. -/
noncomputable def relativeDiscriminantNorm : ℚ :=
  Algebra.norm ℚ (frobenius h - verschiebung q h)

variable {q h}

/-- The real order `ℤ[F + V]` lies in the maximal order of `K⁺ = ℚ[F + V]`. -/
lemma IsWeilPolynomial.realOrder_le_integralClosure (hh : h.IsWeilPolynomial q) :
    h.realOrder q ≤ integralClosure ℤ (h.realSubalgebra q) := by
  refine Algebra.adjoin_le <| Set.singleton_subset_iff.mpr ?_
  rw [SetLike.mem_coe, mem_integralClosure_iff, ← isIntegral_algHom_iff
    ((h.realSubalgebra q).val.restrictScalars ℤ) Subtype.val_injective]
  exact hh.isIntegral_frobenius.add hh.isIntegral_verschiebung

end Polynomial
