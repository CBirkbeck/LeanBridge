import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.FieldTheory.Perfect
import Mathlib.GroupTheory.Index
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.Etale.StandardEtale
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
import Mathlib.RingTheory.Radical.Basic
import LeanBridge.ForMathlib.NumberTheory.NumberField.WeilPolynomial

/-!
# The Frobenius order of a Weil polynomial

The LMFDB indexes the isogeny classes of abelian varieties over `𝔽_q` by their Weil polynomials,
and attaches to the isogeny class with Weil polynomial `h` the étale `ℚ`-algebra `K = ℚ[F]`
generated by its Frobenius endomorphism `F`, the Verschiebung `V = q / F`, and the Frobenius order
`ℤ[F, V]`, an order in `K`. The Weil polynomial of an abelian variety, the characteristic
polynomial of its Frobenius on a Tate module (LMFDB `av.fq.weil_polynomial`), is not available
here, so these objects are defined in terms of a polynomial `h ∈ ℤ[x]`, as the LMFDB computes them.
They have their meaning when `h` is a Weil `q`-polynomial, the hypothesis of the results below, and
nothing requires `h` to be the Weil polynomial of an isogeny class (which Weil polynomials are is
Honda–Tate theory). The Frobenius acts semisimply (Tate), so its minimal polynomial is the radical
`m` of `h`, the product of the distinct monic irreducible factors of `h` over `ℚ`, and
`K = ℚ[x] / (m)`, with `F` the class of `x`; this is `ℚ[x] / (h)` when `h` is squarefree. The
Verschiebung `V = q / F` is a root of `m`, because `z ↦ q / z` is complex conjugation on the complex
roots of `h`, which have absolute value `√q`.

## Main definitions

* `Polynomial.frobeniusMinpoly`: the radical `m` of `h` over `ℚ`.
* `Polynomial.EtaleAlgebra`: the étale algebra `K = ℚ[F] = ℚ[x] / (m)`.
* `Polynomial.EtaleAlgebra.frobenius` and `Polynomial.EtaleAlgebra.verschiebung`: the Frobenius
  `F` and the Verschiebung `V = q / F` in `K`.
* `Polynomial.verschiebungPoly`: a polynomial `v` over `ℚ` with `V = v(F)`.
* `Polynomial.frobeniusOrder` (LMFDB `av.fq.frobenius_order`): the Frobenius order `ℤ[F, V]`.
* `Polynomial.HasMaximalFrobeniusOrder` (LMFDB `av.fq.maximal_zfv`): `ℤ[F, V]` is the maximal order
  `𝒪_K` of `K`.
* `Polynomial.frobeniusOrderIndex` (LMFDB `av.fq.zfv_index`): the index `[𝒪_K : ℤ[F, V]]`.

## Main results

* The instance `Algebra.Etale ℚ h.EtaleAlgebra`: `K` is an étale `ℚ`-algebra.
* The instance `Module.Finite ℚ h.EtaleAlgebra`: `K` is finite-dimensional over `ℚ`.
* `Polynomial.IsWeilPolynomial.frobenius_mul_verschiebung`: `F V = q`.
* `Polynomial.IsWeilPolynomial.aeval_verschiebung`: `V` is a root of `m`, as `F` is.
* `Polynomial.IsWeilPolynomial.frobeniusOrder_le_integralClosure`: `ℤ[F, V] ⊆ 𝒪_K`.
* `Polynomial.IsWeilPolynomial.hasMaximalFrobeniusOrder_iff`: the Frobenius order is maximal if and
  only if its index is `1`.
-/

open ComplexConjugate UniqueFactorizationMonoid

namespace Polynomial

variable (q : ℕ) (h : ℤ[X]) (P : ℚ[X])

/-- The **minimal polynomial of the Frobenius** of a polynomial `h ∈ ℤ[x]`: the radical of `h` over
`ℚ`, the product of its distinct monic irreducible factors. When `h` is the Weil polynomial of an
isogeny class of abelian varieties over `𝔽_q`, this is the minimal polynomial of its Frobenius
endomorphism, which acts semisimply on the Tate modules (Tate). -/
noncomputable def frobeniusMinpoly : ℚ[X] :=
  radical (h.map (Int.castRingHom ℚ))

/-- The **étale algebra** `K = ℚ[F]` of a polynomial `h ∈ ℤ[x]`: the quotient `ℚ[x] / (m)` by the
radical `m` of `h` over `ℚ` (`Polynomial.frobeniusMinpoly`). When `h` is the Weil polynomial of an
isogeny class of abelian varieties over `𝔽_q`, `m` is the minimal polynomial of the Frobenius
endomorphism `F`, and `K` is the LMFDB's étale algebra `ℚ[F]` generated by `F`. It is an étale
`ℚ`-algebra, as `m` is separable (the instance `Algebra.Etale ℚ h.EtaleAlgebra`): by the Chinese
remainder theorem it is the product of the number fields `ℚ[x] / (g)` for the distinct irreducible
factors `g` of `h` (not formalised here). It is `ℚ[x] / (h)` when `h` is squarefree; when `h` has a
repeated factor, `ℚ[x] / (h)` is not reduced, hence not étale. -/
abbrev EtaleAlgebra : Type :=
  AdjoinRoot h.frobeniusMinpoly

namespace EtaleAlgebra

/-- The **Frobenius** `F` in the étale algebra `ℚ[F]` of a polynomial `h ∈ ℤ[x]`: the class of
`x`. -/
noncomputable def frobenius : h.EtaleAlgebra :=
  AdjoinRoot.root h.frobeniusMinpoly

/-- The **Verschiebung** `V = q / F` in the étale algebra `ℚ[F]` of a polynomial `h ∈ ℤ[x]`, for the
Frobenius `F`, and `0` when `F` is not a unit. When `h` is a Weil `q`-polynomial, `F V = q`
(`Polynomial.IsWeilPolynomial.frobenius_mul_verschiebung`), and `F` is a unit if `q ≠ 0`
(`Polynomial.IsWeilPolynomial.isUnit_frobenius`). -/
noncomputable def verschiebung : h.EtaleAlgebra :=
  q * Ring.inverse (frobenius h)

end EtaleAlgebra

open EtaleAlgebra

/-- A polynomial `v` over `ℚ` with `V = v(F)` for the Verschiebung `V = q / F` in the étale algebra
of a Weil `q`-polynomial `h`: the class of `v = -(q / m(0)) (m - m(0)) / x` in `ℚ[x] / (m)`, for the
radical `m` of `h`, is `q / x`, as `x v = q - (q / m(0)) m`
(`Polynomial.IsWeilPolynomial.verschiebung_eq_mk`). -/
noncomputable def verschiebungPoly : ℚ[X] :=
  C (-(q : ℚ) / h.frobeniusMinpoly.coeff 0) * h.frobeniusMinpoly.divX

/-- The **Frobenius order** `ℤ[F, V]` (LMFDB `av.fq.frobenius_order`) of a polynomial `h ∈ ℤ[x]`:
the subring of its étale algebra `ℚ[F]` generated by the Frobenius `F` and the Verschiebung
`V = q / F`. For the Weil polynomial `h` of an isogeny class of abelian varieties over `𝔽_q`, this
is the subring of the endomorphism ring generated by the Frobenius and Verschiebung endomorphisms.
When `h` is a Weil `q`-polynomial it lies in the maximal order
(`Polynomial.IsWeilPolynomial.frobeniusOrder_le_integralClosure`), and it is an order of `ℚ[F]`
(not formalised here). -/
noncomputable def frobeniusOrder : Subalgebra ℤ h.EtaleAlgebra :=
  Algebra.adjoin ℤ {frobenius h, verschiebung q h}

/-- The Frobenius order `ℤ[F, V]` of a polynomial `h ∈ ℤ[x]` is **maximal** (LMFDB
`av.fq.maximal_zfv`) if it is the maximal order `𝒪_K` of its étale algebra `K = ℚ[F]`, the integral
closure of `ℤ` in `K`, which is the product of the rings of integers of the number fields that are
the factors of `K`. The LMFDB's `h` is the Weil polynomial of an isogeny class of abelian varieties
over `𝔽_q`; here `h` is any polynomial, and the notion has its meaning when `h` is a Weil
`q`-polynomial. -/
def HasMaximalFrobeniusOrder : Prop :=
  h.frobeniusOrder q = integralClosure ℤ h.EtaleAlgebra

/-- The **index** (LMFDB `av.fq.zfv_index`) of the Frobenius order `ℤ[F, V]` of a polynomial
`h ∈ ℤ[x]`: the index `[𝒪_K : ℤ[F, V]]` of the additive group of `ℤ[F, V]` in that of the maximal
order `𝒪_K` of `K = ℚ[F]`. The LMFDB's `h` is the Weil polynomial of an isogeny class of abelian
varieties over `𝔽_q`; here `h` is any polynomial, and when it is a Weil `q`-polynomial the Frobenius
order lies in `𝒪_K` (`Polynomial.IsWeilPolynomial.frobeniusOrder_le_integralClosure`). That the
index is then finite, as `ℤ[F, V]` is an order, is not formalised here; it is `0` when infinite. -/
noncomputable def frobeniusOrderIndex : ℕ :=
  (h.frobeniusOrder q).toSubmodule.toAddSubgroup.relIndex
    (integralClosure ℤ h.EtaleAlgebra).toSubmodule.toAddSubgroup

lemma frobenius_mem_frobeniusOrder : frobenius h ∈ h.frobeniusOrder q :=
  Algebra.subset_adjoin <| Set.mem_insert _ _

lemma verschiebung_mem_frobeniusOrder : verschiebung q h ∈ h.frobeniusOrder q :=
  Algebra.subset_adjoin <| Set.mem_insert_of_mem _ rfl

lemma frobeniusMinpoly_dvd : h.frobeniusMinpoly ∣ h.map (Int.castRingHom ℚ) :=
  radical_dvd_self

lemma separable_frobeniusMinpoly : h.frobeniusMinpoly.Separable :=
  PerfectField.separable_iff_squarefree.mpr squarefree_radical

lemma monic_frobeniusMinpoly : h.frobeniusMinpoly.Monic := by
  classical
  refine monic_prod_of_monic _ _ fun p hp ↦ ?_
  rw [mem_primeFactors] at hp
  rw [id, ← normalize_normalized_factor p hp]
  exact monic_normalize (ne_zero_of_mem_normalizedFactors hp)

instance : Algebra.Etale ℚ h.EtaleAlgebra := by
  rcases h.separable_frobeniusMinpoly with ⟨a, b, hab⟩
  let P : StandardEtalePair ℚ := ⟨h.frobeniusMinpoly, h.monic_frobeniusMinpoly, 1, b, a, 0, by
    rw [pow_zero, ← hab]
    ring1⟩
  exact .of_equiv <| P.equivAwayAdjoinRoot.trans <|
    (IsLocalization.atUnit _ _ (AdjoinRoot.mk P.f P.g) (by simp [P])).symm.restrictScalars ℚ

instance : Module.Finite ℚ h.EtaleAlgebra :=
  (AdjoinRoot.powerBasis' h.monic_frobeniusMinpoly).finite

lemma aeval_frobenius : aeval (frobenius h) P = AdjoinRoot.mk h.frobeniusMinpoly P :=
  AdjoinRoot.aeval_eq P

lemma mk_X_eq_frobenius : AdjoinRoot.mk h.frobeniusMinpoly X = frobenius h :=
  AdjoinRoot.mk_X

lemma aeval_frobenius_frobeniusMinpoly : aeval (frobenius h) h.frobeniusMinpoly = 0 :=
  (aeval_frobenius h _).trans AdjoinRoot.mk_self

variable {q h P} {A : Type*} [CommRing A] [Algebra ℚ A] {z : ℂ}
  (hz : aeval z h.frobeniusMinpoly = 0)

lemma EtaleAlgebra.algHom_ext {φ ψ : h.EtaleAlgebra →ₐ[ℚ] A}
    (hφψ : φ (frobenius h) = ψ (frobenius h)) : φ = ψ :=
  AdjoinRoot.algHom_ext hφψ

lemma Separable.dvd_of_forall_aeval_complex_eq_zero {m : ℚ[X]} (hm : m.Separable)
    (hmP : ∀ z : ℂ, aeval z m = 0 → aeval z P = 0) : m ∣ P := by
  rcases eq_or_ne P 0 with rfl | hP
  · exact dvd_zero m
  rw [← map_dvd_map' (algebraMap ℚ ℂ)]
  refine (IsAlgClosed.splits _).dvd_of_roots_le_roots (map_ne_zero hm.ne_zero) ?_
  rw [Multiset.le_iff_subset (nodup_roots hm.map)]
  intro z hz
  rw [mem_roots_map_of_injective (algebraMap ℚ ℂ).injective hm.ne_zero] at hz
  rw [mem_roots_map_of_injective (algebraMap ℚ ℂ).injective hP]
  exact hmP z hz

lemma aeval_eq_zero_of_aeval_frobeniusMinpoly {x : A} (hx : aeval x h.frobeniusMinpoly = 0) :
    aeval x h = 0 := by
  rcases h.frobeniusMinpoly_dvd with ⟨s, hs⟩
  rw [← aeval_map_algebraMap ℚ, algebraMap_int_eq, hs, map_mul, hx, zero_mul]

include hz in
lemma aeval_conj_frobeniusMinpoly : aeval (conj z) h.frobeniusMinpoly = 0 :=
  (aeval_algHom_apply (Complex.conjAe.restrictScalars ℚ).toAlgHom z h.frobeniusMinpoly).trans <| by
    rw [hz, map_zero]

namespace IsWeilPolynomial

variable (hh : h.IsWeilPolynomial q) (hq : q ≠ 0)

include hh

include hz in
lemma norm_eq_sqrt : ‖z‖ = √q :=
  hh.2 z <| (mem_roots (hh.1.map _).ne_zero).mpr <| (eval_map _ z).trans <|
    aeval_eq_zero_of_aeval_frobeniusMinpoly hz

include hz hq in
lemma ne_zero_of_aeval_frobeniusMinpoly : z ≠ 0 :=
  norm_ne_zero_iff.mp <| (hh.norm_eq_sqrt hz).trans_ne <| Real.sqrt_ne_zero'.mpr <|
    Nat.cast_pos.mpr <| Nat.pos_of_ne_zero hq

include hq in
lemma coeff_zero_frobeniusMinpoly_ne_zero : h.frobeniusMinpoly.coeff 0 ≠ 0 :=
  fun h0 ↦ hh.ne_zero_of_aeval_frobeniusMinpoly
    (by rw [← coeff_zero_eq_aeval_zero', h0, map_zero]) hq rfl

include hz in
lemma aeval_verschiebungPoly : aeval z (h.verschiebungPoly q) = conj z := by
  rcases eq_or_ne q 0 with rfl | hq
  · have hz0 : z = 0 := norm_eq_zero.mp <| (hh.norm_eq_sqrt hz).trans <| by simp
    simp [verschiebungPoly, hz0]
  have hX : aeval z (X * h.frobeniusMinpoly.divX + C (h.frobeniusMinpoly.coeff 0)) = 0 := by
    rw [X_mul_divX_add, hz]
  rw [map_add, map_mul, aeval_X, aeval_C] at hX
  have hconj : z * conj z = q := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hh.norm_eq_sqrt hz,
      Real.sq_sqrt (Nat.cast_nonneg q)]
    simp
  rw [verschiebungPoly, map_mul, aeval_C]
  refine mul_left_cancel₀ (hh.ne_zero_of_aeval_frobeniusMinpoly hz hq) ?_
  rw [hconj, mul_left_comm, eq_neg_of_add_eq_zero_left hX, ← map_neg, ← map_mul, neg_div,
    neg_mul_neg, div_mul_cancel₀ _ (hh.coeff_zero_frobeniusMinpoly_ne_zero hq), map_natCast]

lemma frobenius_mul_mk_verschiebungPoly :
    frobenius h * AdjoinRoot.mk h.frobeniusMinpoly (h.verschiebungPoly q) = q := by
  rcases eq_or_ne q 0 with rfl | hq
  · simp [verschiebungPoly]
  rw [← mk_X_eq_frobenius, ← map_mul, ← map_natCast (AdjoinRoot.mk _), AdjoinRoot.mk_eq_mk]
  refine ⟨C (-(q : ℚ) / h.frobeniusMinpoly.coeff 0), ?_⟩
  rw [verschiebungPoly, mul_left_comm,
    ← sub_eq_iff_eq_add.mpr (X_mul_divX_add h.frobeniusMinpoly).symm]
  simp only [mul_sub, ← C_mul, div_mul_cancel₀ _ (hh.coeff_zero_frobeniusMinpoly_ne_zero hq),
    map_neg, map_natCast]
  ring1

include hq in
lemma isUnit_frobenius : IsUnit (frobenius h) :=
  isUnit_of_mul_isUnit_left <| by
    rw [hh.frobenius_mul_mk_verschiebungPoly, ← map_natCast (algebraMap ℚ h.EtaleAlgebra)]
    exact (IsUnit.mk0 (q : ℚ) (Nat.cast_ne_zero.mpr hq)).map _

lemma verschiebung_eq_mk :
    verschiebung q h = AdjoinRoot.mk h.frobeniusMinpoly (h.verschiebungPoly q) := by
  rcases eq_or_ne q 0 with rfl | hq
  · simp [verschiebung, verschiebungPoly]
  rw [verschiebung, ← hh.frobenius_mul_mk_verschiebungPoly, mul_comm, ← mul_assoc,
    Ring.inverse_mul_cancel _ (hh.isUnit_frobenius hq), one_mul]

/-- The Frobenius and the Verschiebung of a Weil `q`-polynomial `h` satisfy `F V = q`. -/
lemma frobenius_mul_verschiebung : frobenius h * verschiebung q h = q := by
  rw [hh.verschiebung_eq_mk, hh.frobenius_mul_mk_verschiebungPoly]

/-- The Verschiebung `V = q / F` of a Weil `q`-polynomial `h` is a root of the radical of `h`, the
minimal polynomial of the Frobenius: `z ↦ q / z` is complex conjugation on the roots of `h`. -/
lemma aeval_verschiebung : aeval (verschiebung q h) h.frobeniusMinpoly = 0 := by
  rw [hh.verschiebung_eq_mk, ← aeval_frobenius, ← aeval_comp, aeval_frobenius,
    AdjoinRoot.mk_eq_zero]
  refine h.separable_frobeniusMinpoly.dvd_of_forall_aeval_complex_eq_zero fun z hz ↦ ?_
  rw [aeval_comp, hh.aeval_verschiebungPoly hz, aeval_conj_frobeniusMinpoly hz]

lemma aeval_verschiebung_verschiebungPoly :
    aeval (verschiebung q h) (h.verschiebungPoly q) = frobenius h := by
  rw [hh.verschiebung_eq_mk, ← aeval_frobenius, ← aeval_comp, aeval_frobenius, ← mk_X_eq_frobenius,
    AdjoinRoot.mk_eq_mk]
  refine h.separable_frobeniusMinpoly.dvd_of_forall_aeval_complex_eq_zero fun z hz ↦ ?_
  rw [map_sub, aeval_comp, hh.aeval_verschiebungPoly hz,
    hh.aeval_verschiebungPoly (aeval_conj_frobeniusMinpoly hz), Complex.conj_conj, aeval_X,
    sub_self]

lemma isIntegral_frobenius : IsIntegral ℤ (frobenius h) :=
  ⟨h, hh.1, aeval_eq_zero_of_aeval_frobeniusMinpoly h.aeval_frobenius_frobeniusMinpoly⟩

lemma isIntegral_verschiebung : IsIntegral ℤ (verschiebung q h) :=
  ⟨h, hh.1, aeval_eq_zero_of_aeval_frobeniusMinpoly hh.aeval_verschiebung⟩

/-- The Frobenius order `ℤ[F, V]` of a Weil `q`-polynomial `h` lies in the maximal order of its
étale algebra. -/
lemma frobeniusOrder_le_integralClosure : h.frobeniusOrder q ≤ integralClosure ℤ h.EtaleAlgebra :=
  Algebra.adjoin_le <| Set.pair_subset hh.isIntegral_frobenius hh.isIntegral_verschiebung

/-- The Frobenius order of a Weil `q`-polynomial `h` is maximal if and only if its index is `1`. -/
lemma hasMaximalFrobeniusOrder_iff :
    h.HasMaximalFrobeniusOrder q ↔ h.frobeniusOrderIndex q = 1 := by
  rw [frobeniusOrderIndex, AddSubgroup.relIndex_eq_one, Submodule.toAddSubgroup_le,
    Subalgebra.toSubmodule.le_iff_le]
  exact ⟨fun hR ↦ hR.ge, hh.frobeniusOrder_le_integralClosure.antisymm⟩

end IsWeilPolynomial

end Polynomial
