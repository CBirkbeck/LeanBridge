import LeanBridge.ForMathlib.NumberTheory.MulChar.FieldOfValues
import Mathlib.NumberTheory.NumberField.Cyclotomic.Galois
import Mathlib.RingTheory.RootsOfUnity.Complex

/-!
# The Galois action on the characters of order `n`

Let `ℚ(ζ_n)` be the subfield of `ℂ` generated by the `n`-th roots of unity. For `n ≥ 1` it is an
`n`-th cyclotomic number field, by the instances
`IsCyclotomicExtension {n} ℚ (adjoin ℚ {b : ℂ | b ^ n = 1})` and
`NumberField (adjoin ℚ {b : ℂ | b ^ n = 1})` (from Tau Ceti's
`IsPrimitiveRoot.isCyclotomicExtension_adjoin_nth_roots`). It serves as the concrete cyclotomic
field: at the pinned Mathlib, instance search finds
`IsCyclotomicExtension {n} ℚ (CyclotomicField n ℚ)` only for `CyclotomicField.algebra`, not for
the default `ℚ`-algebra structure of `CyclotomicField n ℚ`, which is equal to it but not reducibly
so. A complex character `χ` with `χ ^ n = 1` of a commutative monoid, such as a Dirichlet character
of order dividing `n`, takes its values in `ℚ(ζ_n)`, so every `σ ∈ Gal(ℚ(ζ_n)/ℚ)` gives a character
`σ(χ) : x ↦ σ(χ x)`. When the monoid has finitely many units, `σ(χ)` lies in the Galois orbit of
`χ` (Tau Ceti's `MulChar.galoisOrbit`), so it has the same order, and `χ ↦ σ(χ)` is an action of
`Gal(ℚ(ζ_n)/ℚ)` on the characters of order `n`: the instance
`MulAction Gal(adjoin ℚ {b : ℂ | b ^ n = 1}/ℚ) {χ : MulChar M ℂ // orderOf χ = n}`. The action is
free, since a character of order `n` takes a primitive `n`-th root of unity as a value, and this
value generates `ℚ(ζ_n)`. Hence it is faithful, and the orbit of `χ` is its Galois orbit, as
`σ_a(χ) = χ ^ a` for the automorphism `σ_a` raising roots of unity to the power `a` prime to `n`.
Every character of order `n` has `ℚ(ζ_n)` as its field of values
(`MulChar.adjoin_range_eq_adjoin_nth_roots`).

## Main definitions

* `MulChar.toAdjoinNthRoots`: a character `χ` with `χ ^ n = 1`, with values in `ℚ(ζ_n)`.
* `MulChar.galoisConj` (LMFDB `character.dirichlet.galois_orbit`): the conjugate `σ(χ)` of a
  character `χ` by an automorphism `σ` of `ℚ(ζ_n)`.

## Main results

* `MulChar.image_val_orbit` (LMFDB `character.dirichlet.galois_orbit`): the orbit of `χ` under
  `Gal(ℚ(ζ_n)/ℚ)` is its Galois orbit.
* `MulChar.eq_one_of_smul_eq`: the action of `Gal(ℚ(ζ_n)/ℚ)` on the characters of order `n` is
  free.
* `MulChar.faithfulSMul_galois` (LMFDB `character.dirichlet.galois_orbit`): the action of
  `Gal(ℚ(ζ_n)/ℚ)` on the characters of order `n` is faithful.
-/

open IntermediateField IsCyclotomicExtension

namespace MulChar

variable {M : Type*} [CommMonoid M] {n : ℕ} (σ τ : Gal(adjoin ℚ {b : ℂ | b ^ n = 1}/ℚ))
  {χ : MulChar M ℂ}

variable [NeZero n] in
instance : IsCyclotomicExtension {n} ℚ (adjoin ℚ {b : ℂ | b ^ n = 1}) :=
  (Complex.isPrimitiveRoot_exp n <| NeZero.ne n).isCyclotomicExtension_adjoin_nth_roots

variable [NeZero n] in
instance : NumberField (adjoin ℚ {b : ℂ | b ^ n = 1}) :=
  IsCyclotomicExtension.numberField {n} ℚ _

lemma apply_mem_adjoin_nth_roots (hχ : χ ^ n = 1) (x : M) : χ x ∈ adjoin ℚ {b : ℂ | b ^ n = 1} := by
  by_cases hx : IsUnit x
  · refine subset_adjoin ℚ _ ?_
    rw [Set.mem_ofPred_eq, ← hx.unit_spec, ← pow_apply_coe, hχ, one_apply_coe]
  · rw [χ.map_nonunit hx]
    exact zero_mem _

variable (hχ : χ ^ n = 1)

/-- A complex character `χ` with `χ ^ n = 1`, as a character with values in the subfield `ℚ(ζ_n)`
of `ℂ` generated by the `n`-th roots of unity. -/
noncomputable def toAdjoinNthRoots : MulChar M (adjoin ℚ {b : ℂ | b ^ n = 1}) where
  toFun x := ⟨χ x, apply_mem_adjoin_nth_roots hχ x⟩
  map_one' := Subtype.ext χ.map_one
  map_mul' x y := Subtype.ext <| χ.map_mul x y
  map_nonunit' _ hx := Subtype.ext <| χ.map_nonunit hx

/-- The **Galois conjugate** (LMFDB `character.dirichlet.galois_orbit`) `σ(χ) : x ↦ σ(χ x)` of a
complex character `χ` with `χ ^ n = 1`, such as a Dirichlet character of modulus `q` and order `n`,
by an automorphism `σ` of the subfield `ℚ(ζ_n)` of `ℂ` generated by the `n`-th roots of unity, which
contains the values of `χ`. On the characters of order `n` it is an action of `Gal(ℚ(ζ_n)/ℚ)`
whose orbits are the Galois orbits (`MulChar.image_val_orbit`). -/
noncomputable def galoisConj : MulChar M ℂ :=
  ((toAdjoinNthRoots hχ).ringHomComp σ.toRingEquiv.toRingHom).ringHomComp (algebraMap _ ℂ)

lemma galoisConj_apply (x : M) : galoisConj σ hχ x = σ ⟨χ x, apply_mem_adjoin_nth_roots hχ x⟩ :=
  rfl

lemma galoisConj_one : galoisConj 1 hχ = χ :=
  ext fun _ ↦ rfl

variable [Finite Mˣ]

lemma galoisConj_mem_galoisOrbit : galoisConj σ hχ ∈ χ.galoisOrbit := by
  have hle : adjoin ℚ (Set.range χ) ≤ adjoin ℚ {b : ℂ | b ^ n = 1} :=
    adjoin_le_iff.mpr <| Set.range_subset_iff.mpr <| apply_mem_adjoin_nth_roots hχ
  exact mem_galoisOrbit_iff_exists_algHom.mpr
    ⟨(adjoin ℚ {b : ℂ | b ^ n = 1}).val.comp (σ.toAlgHom.comp (inclusion hle)), fun _ ↦ rfl⟩

lemma orderOf_galoisConj : orderOf (galoisConj σ hχ) = orderOf χ :=
  orderOf_eq_of_mem_galoisOrbit <| galoisConj_mem_galoisOrbit σ hχ

lemma galoisConj_pow_eq_one : galoisConj σ hχ ^ n = 1 := by
  rw [← orderOf_dvd_iff_pow_eq_one, orderOf_galoisConj]
  exact orderOf_dvd_of_pow_eq_one hχ

lemma galoisConj_mul : galoisConj (σ * τ) hχ = galoisConj σ (galoisConj_pow_eq_one τ hχ) :=
  ext fun _ ↦ rfl

@[nolint defsWithUnderscore]
noncomputable instance :
    MulAction Gal(adjoin ℚ {b : ℂ | b ^ n = 1}/ℚ) {χ : MulChar M ℂ // orderOf χ = n} where
  smul σ χ := ⟨galoisConj σ <| orderOf_dvd_iff_pow_eq_one.mp <| dvd_of_eq χ.2,
    (orderOf_galoisConj σ _).trans χ.2⟩
  one_smul _ := Subtype.ext <| galoisConj_one _
  mul_smul σ τ _ := Subtype.ext <| galoisConj_mul σ τ _

lemma val_smul (ψ : {χ : MulChar M ℂ // orderOf χ = n}) :
    (σ • ψ).val = galoisConj σ (orderOf_dvd_iff_pow_eq_one.mp <| dvd_of_eq ψ.2) :=
  rfl

/-- **The action of `Gal(ℚ(ζ_n)/ℚ)` on the characters of order `n` is free**: an automorphism `σ`
with `σ(χ) = χ` fixes a value of `χ` that is a primitive `n`-th root of unity, hence all of
`ℚ(ζ_n)`. -/
lemma eq_one_of_smul_eq {ψ : {χ : MulChar M ℂ // orderOf χ = n}} (h : σ • ψ = ψ) : σ = 1 := by
  rcases ψ with ⟨χ, rfl⟩
  have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
  rcases χ.exists_isPrimitiveRoot_apply with ⟨u, hu⟩
  let ζ : adjoin ℚ {b : ℂ | b ^ orderOf χ = 1} := toAdjoinNthRoots (pow_orderOf_eq_one χ) u
  have hσζ : σ ζ = ζ := Subtype.ext <| congrArg (·.1 u) h
  refine AlgEquiv.coe_toAlgHom_injective <| adjoin_algHom_ext ℚ fun x hx ↦ ?_
  rcases hu.eq_pow_of_pow_eq_one hx with ⟨j, -, rfl⟩
  have hj : (⟨χ u ^ j, subset_adjoin ℚ _ hx⟩ : adjoin ℚ {b : ℂ | b ^ orderOf χ = 1}) = ζ ^ j :=
    rfl
  rw [hj, AlgEquiv.toAlgHom_apply, AlgEquiv.toAlgHom_apply, map_pow, hσζ, AlgEquiv.one_apply]

variable (χ) in
/-- **The action of `Gal(ℚ(ζ_n)/ℚ)` on the characters of order `n` is faithful**, `n` being the
order of a character `χ`, so that there are characters of order `n`. -/
lemma faithfulSMul_galois : FaithfulSMul Gal(adjoin ℚ {b : ℂ | b ^ orderOf χ = 1}/ℚ)
    {ψ : MulChar M ℂ // orderOf ψ = orderOf χ} := by
  refine ⟨fun {σ τ} h ↦ ?_⟩
  have h₁ : (τ⁻¹ * σ) • (⟨χ, rfl⟩ : {ψ : MulChar M ℂ // orderOf ψ = orderOf χ}) = ⟨χ, rfl⟩ := by
    rw [mul_smul, h, inv_smul_smul]
  exact (inv_mul_eq_one.mp <| eq_one_of_smul_eq _ h₁).symm

variable (χ) in
/-- **The orbit of a character `χ` of order `n` under `Gal(ℚ(ζ_n)/ℚ)` is its Galois orbit**, the
set `{σ(χ) : σ ∈ Gal(ℚ(ζ_n)/ℚ)}`: the automorphism `σ_a` raising the `n`-th roots of unity to the
power `a` prime to `n` sends `χ` to `χ ^ a`. -/
lemma image_val_orbit : Subtype.val '' MulAction.orbit Gal(adjoin ℚ {b : ℂ | b ^ orderOf χ = 1}/ℚ)
    (⟨χ, rfl⟩ : {ψ : MulChar M ℂ // orderOf ψ = orderOf χ}) = χ.galoisOrbit := by
  refine subset_antisymm ?_ fun ψ h ↦ ?_
  · rintro _ ⟨_, ⟨σ, rfl⟩, rfl⟩
    exact galoisConj_mem_galoisOrbit σ _
  · rcases mem_galoisOrbit_iff_exists_pow.mp h with ⟨a, ha, rfl⟩
    have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
    refine ⟨_, ⟨(Rat.galEquivZMod (orderOf χ) _).symm (ZMod.unitOfCoprime a ha), rfl⟩,
      ext fun v ↦ ?_⟩
    have hv : χ v ^ orderOf χ = 1 := by
      rw [← pow_apply_coe, pow_orderOf_eq_one, one_apply_coe]
    have hx : (⟨χ v, apply_mem_adjoin_nth_roots (pow_orderOf_eq_one χ) v⟩ :
        adjoin ℚ {b : ℂ | b ^ orderOf χ = 1}) ^ orderOf χ = 1 :=
      Subtype.ext hv
    rw [val_smul, galoisConj_apply, Rat.galEquivZMod_apply_of_pow_eq _ _ _ hx,
      MulEquiv.apply_symm_apply, ZMod.coe_unitOfCoprime, ZMod.val_natCast, SubmonoidClass.coe_pow,
      ← pow_eq_pow_mod a hv, pow_apply_coe]

end MulChar
