import TauCeti.NumberTheory.Cyclotomic.Adjoin
import TauCeti.NumberTheory.MulChar.GaloisOrbit
import TauCeti.NumberTheory.NumberField.Cyclotomic.Finrank

/-!
# The field of values and the degree of a multiplicative character

The field of values of a multiplicative character `χ` with values in a field `K` of characteristic
zero, such as a Dirichlet character, is the subfield `ℚ(χ)` of `K` generated by its values. When the
monoid has finitely many units and `χ` has order `n`, one value of `χ` is a primitive `n`-th root of
unity `ζ` (Tau Ceti's `MulChar.exists_isPrimitiveRoot_apply`) and generates `ℚ(χ)` (Tau Ceti's
`MulChar.adjoin_range_eq_adjoin_simple`). Hence `ℚ(χ) = ℚ(ζ)` is the field `ℚ(μ_n)` generated by
all the `n`-th roots of unity of `K`, the `n`-th cyclotomic field, and its degree is `φ(n)`.

## Main definitions

* `MulChar.degree` (LMFDB `character.dirichlet.degree`): the degree of a character.

## Main results

* `MulChar.degree_eq_totient` (LMFDB `character.dirichlet.degree`): a character of order `n` has
  degree `φ(n)`.
* `MulChar.adjoin_range_eq_adjoin_nth_roots`: the field of values of a character of order `n` is
  the field `ℚ(μ_n)` generated by the `n`-th roots of unity.
-/

open IntermediateField

namespace MulChar

variable {M K : Type*} [CommMonoid M] [Field K] [CharZero K] (χ : MulChar M K)

/-- The **degree** (LMFDB `character.dirichlet.degree`) of a character `χ` with values in a field of
characteristic zero, such as a Dirichlet character: the degree over `ℚ` of its field of values
`ℚ(χ)`, the subfield generated by its values. A character of order `n` on a monoid with finitely
many units has degree `φ(n)` (`MulChar.degree_eq_totient`). -/
noncomputable def degree : ℕ :=
  Module.finrank ℚ <| adjoin ℚ <| Set.range χ

variable [Finite Mˣ]

/-- **A character of order `n` has degree `φ(n)`.** -/
lemma degree_eq_totient : χ.degree = (orderOf χ).totient := by
  have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
  rcases χ.exists_isPrimitiveRoot_apply with ⟨u, hu⟩
  rw [degree, adjoin_range_eq_adjoin_simple hu, hu.finrank_adjoin_eq_totient]

/-- **The field of values of a character of order `n` is the field `ℚ(μ_n)`** generated by the
`n`-th roots of unity, an `n`-th cyclotomic field (Tau Ceti's
`IsPrimitiveRoot.isCyclotomicExtension_adjoin_nth_roots`). -/
lemma adjoin_range_eq_adjoin_nth_roots :
    adjoin ℚ (Set.range χ) = adjoin ℚ {b : K | b ^ orderOf χ = 1} := by
  have : NeZero (orderOf χ) := ⟨χ.orderOf_pos.ne'⟩
  rcases χ.exists_isPrimitiveRoot_apply with ⟨u, hu⟩
  rw [adjoin_range_eq_adjoin_simple hu, hu.adjoin_singleton_eq_adjoin_nth_roots]

end MulChar
