import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.NumberTheory.DirichletCharacter.Basic
import Mathlib.NumberTheory.MulChar.Duality
import Mathlib.RingTheory.Trace.Basic
import TauCeti.NumberTheory.MulChar.GaloisOrbit

/-!
# Orbit indices and labels of Galois orbits of Dirichlet characters

The LMFDB numbers the Galois orbits (Tau Ceti's `MulChar.galoisOrbit`) of the complex Dirichlet
characters of modulus `q` by the lexicographic order of their trace vectors
`t([χ]) = (n, t₁, …, t_{q-1})`, where `n` is the order of `χ` and `tᵢ` is the trace of `χ i` from
the field of values `ℚ(χ)` of `χ` to `ℚ`. The trace vector depends only on the Galois orbit, and it
determines the orbit: the trace `tᵢ` is the sum of `ψ i` over the characters `ψ` of the orbit of
`χ`, and distinct characters are linearly independent. The orbit is then labelled `q.a`, where `a`
is the orbit index minus one written in base `26` with the letters `a, …, z` for the digits.

## Main definitions

* `DirichletCharacter.valueTrace`: the trace `tᵢ` of `χ i` from the field of values of `χ`.
* `DirichletCharacter.galoisOrbitTraceVector`: the trace vector `t([χ])`.
* `DirichletCharacter.galoisOrbitIndex` (LMFDB `character.dirichlet.galois_orbit_index`).
* `DirichletCharacter.letterCode`: the base-`26` letter code `a, b, …, z, ba, bb, …`.
* `DirichletCharacter.galoisOrbitLabel` (LMFDB `character.dirichlet.galois_orbit_label`).

## Main results

* `DirichletCharacter.valueTrace_eq_sum_galoisOrbit`: the trace of `χ x` is the sum of `ψ x` over
  the Galois orbit of `χ`.
* `DirichletCharacter.mem_galoisOrbit_of_valueTrace_eq`: characters whose values have the same
  traces lie in one Galois orbit.
* `DirichletCharacter.galoisOrbitTraceVector_eq_iff`: two characters have the same trace vector
  exactly when they lie in one Galois orbit.
* `DirichletCharacter.galoisOrbitIndex_eq_iff`: two characters have the same orbit index exactly
  when they lie in one Galois orbit.
* `DirichletCharacter.galoisOrbitIndex_one`: the orbit of the principal character has index `1`.
-/

open IntermediateField Set

namespace DirichletCharacter

variable {q : ℕ} (χ ψ : DirichletCharacter ℂ q) (x : ZMod q) (σ : adjoin ℚ (Set.range χ) →ₐ[ℚ] ℂ)

/-- The character `χ` with values in its field of values `ℚ(χ)`, the subfield of `ℂ` generated by
the values of `χ`. -/
noncomputable def toFieldOfValues : DirichletCharacter (adjoin ℚ (Set.range χ)) q where
  toFun y := ⟨χ y, subset_adjoin ℚ _ ⟨y, rfl⟩⟩
  map_one' := Subtype.ext (map_one χ)
  map_mul' y z := Subtype.ext (map_mul χ y z)
  map_nonunit' _ hy := Subtype.ext (χ.map_nonunit hy)

/-- The trace of the value `χ x` from the field of values `ℚ(χ)` of `χ` to `ℚ`. It is a rational
integer. -/
noncomputable def valueTrace : ℚ :=
  Algebra.trace ℚ (adjoin ℚ (Set.range χ)) (χ.toFieldOfValues x)

/-- The **trace vector** `t([χ]) = (n, t₁, …, t_{q-1})` of a Dirichlet character `χ` of modulus
`q`: its order `n` followed by the traces `tᵢ = tr_{ℚ(χ)/ℚ}(χ i)` for `i = 1, …, q - 1`. The `tᵢ`
are rational integers; we keep them in `ℚ`, whose order agrees with that of `ℤ`. -/
noncomputable def galoisOrbitTraceVector : List ℚ :=
  (orderOf χ : ℚ) :: (List.range (q - 1)).map fun i ↦ χ.valueTrace ((i + 1 : ℕ) : ZMod q)

/-- The **orbit index** of a Dirichlet character `χ` of modulus `q` (LMFDB
`character.dirichlet.galois_orbit_index`): the position, counted from `1`, of the trace vector of
`χ` in the lexicographic order on the trace vectors of the Dirichlet characters of modulus `q`. It
depends only on the Galois orbit of `χ` and determines it (`galoisOrbitIndex_eq_iff`). -/
noncomputable def galoisOrbitIndex : ℕ :=
  {t | t ∈ Set.range (galoisOrbitTraceVector (q := q)) ∧ t < χ.galoisOrbitTraceVector}.ncard + 1

/-- The **letter code** of a natural number `n`: its base-`26` expansion with the digits written
`a, b, …, z`, so that `0, 1, …, 25, 26` are written `a, b, …, z, ba`. -/
def letterCode (n : ℕ) : String :=
  if n = 0 then "a" else String.ofList ((Nat.digits 26 n).reverse.map fun d ↦ Char.ofNat (97 + d))

lemma letterCode_zero : letterCode 0 = "a" := by
  decide

lemma letterCode_one : letterCode 1 = "b" := by
  decide

lemma letterCode_twentySix : letterCode 26 = "ba" := by
  decide

/-- The **label** of the Galois orbit of a Dirichlet character `χ` of modulus `q` (LMFDB
`character.dirichlet.galois_orbit_label`): `q.a`, where `a` is the letter code of the orbit index
of `χ` minus one, so that the orbit indices `1, 2, 27` are written `a, b, ba`. -/
noncomputable def galoisOrbitLabel : String :=
  toString q ++ "." ++ letterCode (χ.galoisOrbitIndex - 1)

/-- The conjugate `σ ∘ χ` of `χ` by an embedding `σ` of its field of values into `ℂ`. -/
noncomputable def conjChar : DirichletCharacter ℂ q :=
  χ.toFieldOfValues.ringHomComp σ

variable {χ ψ}

variable {x} in
lemma valueTrace_eq_of_mem_galoisOrbit (h : ψ ∈ χ.galoisOrbit) :
    ψ.valueTrace x = χ.valueTrace x := by
  rcases MulChar.mem_galoisOrbit_iff_exists_algHom.mp h with ⟨σ, hσ⟩
  have hF : adjoin ℚ (Set.range ψ) = σ.fieldRange := by
    refine le_antisymm (adjoin_le_iff.mpr ?_) ?_
    · rintro _ ⟨a, rfl⟩
      exact ⟨_, (hσ a).symm⟩
    · rintro _ ⟨⟨y, hy⟩, rfl⟩
      induction hy using adjoin_induction with
      | mem z hz =>
        rcases hz with ⟨a, rfl⟩
        exact hσ a ▸ subset_adjoin ℚ _ ⟨a, rfl⟩
      | algebraMap r => exact (σ.commutes r).symm ▸ IntermediateField.algebraMap_mem _ r
      | add z w hz hw ihz ihw => exact (map_add σ ⟨z, hz⟩ ⟨w, hw⟩) ▸ add_mem ihz ihw
      | inv z hz ih => exact (map_inv₀ σ ⟨z, hz⟩) ▸ inv_mem ih
      | mul z w hz hw ihz ihw => exact (map_mul σ ⟨z, hz⟩ ⟨w, hw⟩) ▸ mul_mem ihz ihw
  have he :
      σ.equivFieldRange.trans (equivOfEq hF.symm) (χ.toFieldOfValues x) = ψ.toFieldOfValues x :=
    Subtype.ext (hσ x).symm
  rw [valueTrace, valueTrace, ← he, Algebra.trace_eq_of_algEquiv]

lemma galoisOrbitTraceVector_eq_of_mem_galoisOrbit (h : ψ ∈ χ.galoisOrbit) :
    ψ.galoisOrbitTraceVector = χ.galoisOrbitTraceVector := by
  simp only [galoisOrbitTraceVector, MulChar.orderOf_eq_of_mem_galoisOrbit h,
    valueTrace_eq_of_mem_galoisOrbit h]

lemma galoisOrbitIndex_eq_of_mem_galoisOrbit (h : ψ ∈ χ.galoisOrbit) :
    ψ.galoisOrbitIndex = χ.galoisOrbitIndex := by
  rw [galoisOrbitIndex, galoisOrbitIndex, galoisOrbitTraceVector_eq_of_mem_galoisOrbit h]

/-- The Galois orbit of the principal character has orbit index `1`, since every other character
has a larger order. -/
lemma galoisOrbitIndex_one : galoisOrbitIndex (1 : DirichletCharacter ℂ q) = 1 := by
  have h : {t | t ∈ Set.range (galoisOrbitTraceVector (q := q)) ∧
      t < galoisOrbitTraceVector (1 : DirichletCharacter ℂ q)} = ∅ := by
    refine Set.eq_empty_of_forall_notMem fun t ⟨⟨ψ, hψ⟩, ht⟩ ↦ ?_
    subst hψ
    rw [galoisOrbitTraceVector, galoisOrbitTraceVector, List.cons_lt_cons_iff, orderOf_one] at ht
    rcases ht with ht | ⟨ht, ht'⟩
    · exact absurd (Nat.cast_lt.mp ht) (not_lt.mpr ψ.orderOf_pos)
    · rw [Nat.cast_inj, orderOf_eq_one_iff] at ht
      subst ht
      exact lt_irrefl _ ht'
  rw [galoisOrbitIndex, h, Set.ncard_empty]

lemma conjChar_apply : χ.conjChar σ x = σ (χ.toFieldOfValues x) :=
  rfl

lemma conjChar_injective : Function.Injective χ.conjChar := fun _ _ h ↦
  adjoin_algHom_ext ℚ fun _ ⟨y, hy⟩ ↦ by
    subst hy
    exact congrArg (· y) h

lemma mem_galoisOrbit_iff_exists_conjChar : ψ ∈ χ.galoisOrbit ↔ ∃ σ, χ.conjChar σ = ψ :=
  MulChar.mem_galoisOrbit_iff_exists_algHom.trans
    ⟨fun ⟨σ, hσ⟩ ↦ ⟨σ, MulChar.ext fun y ↦ (hσ y).symm⟩, fun ⟨σ, hσ⟩ ↦ ⟨σ, fun _ ↦ hσ ▸ rfl⟩⟩

lemma finiteDimensional_adjoin_range : FiniteDimensional ℚ (adjoin ℚ (Set.range χ)) := by
  rcases χ.exists_isPrimitiveRoot_apply with ⟨u, hu⟩
  rw [MulChar.adjoin_range_eq_adjoin_simple hu]
  exact adjoin.finiteDimensional ((hu.isIntegral χ.orderOf_pos).tower_top)

/-- The trace of `χ x` from the field of values of `χ` to `ℚ` is the sum of `ψ x` over the
characters `ψ` in the Galois orbit of `χ`. -/
lemma valueTrace_eq_sum_galoisOrbit :
    (χ.valueTrace x : ℂ) = ∑ ρ ∈ χ.finite_galoisOrbit.toFinset, ρ x := by
  classical
  have : FiniteDimensional ℚ (adjoin ℚ (Set.range χ)) := finiteDimensional_adjoin_range
  have himage : χ.finite_galoisOrbit.toFinset = Finset.univ.image χ.conjChar := by
    ext ρ
    simp [mem_galoisOrbit_iff_exists_conjChar]
  rw [valueTrace, ← eq_ratCast (algebraMap ℚ ℂ), trace_eq_sum_embeddings ℂ, himage,
    Finset.sum_image fun _ _ _ _ h ↦ conjChar_injective h]
  rfl

variable {x} in
lemma valueTrace_of_not_isUnit (hx : ¬IsUnit x) : χ.valueTrace x = 0 := by
  rw [valueTrace, χ.toFieldOfValues.map_nonunit hx, map_zero]

/-- Two Dirichlet characters whose values have the same traces lie in one Galois orbit: the traces
are the sums of the characters over the two orbits, and distinct characters are linearly
independent. -/
lemma mem_galoisOrbit_of_valueTrace_eq (h : ∀ x : ZMod q, ψ.valueTrace x = χ.valueTrace x) :
    ψ ∈ χ.galoisOrbit := by
  classical
  by_contra hψ
  have hdisj : Disjoint χ.finite_galoisOrbit.toFinset ψ.finite_galoisOrbit.toFinset := by
    refine Finset.disjoint_left.mpr fun ρ hρχ hρψ ↦ hψ ?_
    rw [Finite.mem_toFinset, ← MulChar.galoisOrbit_eq_galoisOrbit_iff] at hρχ hρψ
    exact MulChar.galoisOrbit_eq_galoisOrbit_iff.mp (hρψ.symm.trans hρχ)
  have hinj : Function.Injective (fun ρ : DirichletCharacter ℂ q ↦ ρ.toMonoidHom) :=
    fun ρ τ hρτ ↦ MulChar.ext' fun x ↦ by
      rw [← MulChar.coe_toMonoidHom, ← MulChar.coe_toMonoidHom]
      exact DFunLike.congr_fun hρτ x
  have hli : LinearIndependent ℂ (fun ρ : DirichletCharacter ℂ q ↦ (ρ.toMonoidHom : ZMod q → ℂ)) :=
    (linearIndependent_monoidHom (ZMod q) ℂ).comp _ hinj
  have h1 : ∑ ρ ∈ χ.finite_galoisOrbit.toFinset, (if ρ ∈ χ.galoisOrbit then (1 : ℂ) else -1) •
      (ρ.toMonoidHom : ZMod q → ℂ) = ∑ ρ ∈ χ.finite_galoisOrbit.toFinset,
      (ρ.toMonoidHom : ZMod q → ℂ) :=
    Finset.sum_congr rfl fun _ hρ ↦ by simp [χ.finite_galoisOrbit.mem_toFinset.mp hρ]
  have h2 : ∑ ρ ∈ ψ.finite_galoisOrbit.toFinset, (if ρ ∈ χ.galoisOrbit then (1 : ℂ) else -1) •
      (ρ.toMonoidHom : ZMod q → ℂ) = -∑ ρ ∈ ψ.finite_galoisOrbit.toFinset,
      (ρ.toMonoidHom : ZMod q → ℂ) := by
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun ρ hρ ↦ ?_
    have hρχ : ρ ∉ χ.galoisOrbit := fun hρχ ↦ Finset.disjoint_left.mp hdisj
      (χ.finite_galoisOrbit.mem_toFinset.mpr hρχ) hρ
    simp [hρχ]
  have hsum : ∑ ρ ∈ χ.finite_galoisOrbit.toFinset ∪ ψ.finite_galoisOrbit.toFinset,
      (if ρ ∈ χ.galoisOrbit then (1 : ℂ) else -1) • (ρ.toMonoidHom : ZMod q → ℂ) = 0 := by
    rw [Finset.sum_union hdisj, h1, h2, add_neg_eq_zero]
    funext x
    simp only [Finset.sum_apply, MulChar.coe_toMonoidHom]
    rw [← valueTrace_eq_sum_galoisOrbit, ← valueTrace_eq_sum_galoisOrbit, h]
  have hχ : (if χ ∈ χ.galoisOrbit then (1 : ℂ) else -1) = 0 :=
    linearIndependent_iff'.mp hli _ _ hsum χ <| Finset.mem_union_left _
      (χ.finite_galoisOrbit.mem_toFinset.mpr χ.mem_galoisOrbit_self)
  simp at hχ

private lemma galoisOrbitIndex_lt_of_lt (h : ψ.galoisOrbitTraceVector < χ.galoisOrbitTraceVector) :
    ψ.galoisOrbitIndex < χ.galoisOrbitIndex := by
  rw [galoisOrbitIndex, galoisOrbitIndex, add_lt_add_iff_right]
  exact Set.ncard_lt_ncard ⟨fun _ ⟨ht, htψ⟩ ↦ ⟨ht, htψ.trans h⟩,
    fun hsub ↦ (hsub ⟨⟨ψ, rfl⟩, h⟩).2.false⟩
    ((Set.finite_range galoisOrbitTraceVector).subset fun _ ht ↦ ht.1)

variable [NeZero q]

/-- Two Dirichlet characters of nonzero modulus have the same trace vector exactly when they lie
in one Galois orbit. -/
lemma galoisOrbitTraceVector_eq_iff :
    ψ.galoisOrbitTraceVector = χ.galoisOrbitTraceVector ↔ ψ ∈ χ.galoisOrbit := by
  refine ⟨fun h ↦ ?_, galoisOrbitTraceVector_eq_of_mem_galoisOrbit⟩
  rcases eq_or_ne q 1 with rfl | hq
  · rw [level_one ψ, level_one χ]
    exact MulChar.mem_galoisOrbit_self 1
  have htail : ∀ a ∈ List.range (q - 1), ψ.valueTrace (a + 1 : ℕ) = χ.valueTrace (a + 1 : ℕ) :=
    List.map_inj_left.mp (List.cons.inj h).2
  refine mem_galoisOrbit_of_valueTrace_eq fun x ↦ ?_
  by_cases hx : IsUnit x
  · have hx0 : x.val ≠ 0 := by
      have : Nontrivial (ZMod q) := ZMod.nontrivial_iff.mpr hq
      rw [Ne, ZMod.val_eq_zero]
      exact hx.ne_zero
    have hxq : x.val < q := x.val_lt
    have hx' : x = ((x.val - 1 + 1 : ℕ) : ZMod q) := by
      rw [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hx0), ZMod.natCast_zmod_val]
    rw [hx']
    exact htail (x.val - 1) (List.mem_range.mpr (by omega))
  · rw [valueTrace_of_not_isUnit hx, valueTrace_of_not_isUnit hx]

/-- Two Dirichlet characters of nonzero modulus have the same orbit index exactly when they lie in
one Galois orbit. -/
lemma galoisOrbitIndex_eq_iff : ψ.galoisOrbitIndex = χ.galoisOrbitIndex ↔ ψ ∈ χ.galoisOrbit := by
  refine ⟨fun h ↦ ?_, galoisOrbitIndex_eq_of_mem_galoisOrbit⟩
  rcases lt_trichotomy ψ.galoisOrbitTraceVector χ.galoisOrbitTraceVector with hlt | heq | hgt
  · exact absurd h (galoisOrbitIndex_lt_of_lt hlt).ne
  · exact galoisOrbitTraceVector_eq_iff.mp heq
  · exact absurd h (galoisOrbitIndex_lt_of_lt hgt).ne'

end DirichletCharacter
