import LeanBridge.ForMathlib.NumberTheory.MulChar.GaloisAction
import LeanBridge.ForMathlib.NumberTheory.MulChar.Order

/-!
# The fixed field of a Dirichlet character

Let `χ` be a complex Dirichlet character of modulus `q` and `K = ℚ(ζ_q)` a `q`-th cyclotomic field,
such as the subfield `ℚ(μ_q)` of `ℂ` generated by the `q`-th roots of unity (the instances
`IsCyclotomicExtension {q} ℚ (adjoin ℚ {b : ℂ | b ^ q = 1})` and
`NumberField (adjoin ℚ {b : ℂ | b ^ q = 1})` of the file on the Galois action on characters; at
the pinned Mathlib, instance search does not find
`IsCyclotomicExtension {q} ℚ (CyclotomicField q ℚ)` for the default `ℚ`-algebra structure of
`CyclotomicField q ℚ`, only for `CyclotomicField.algebra`).
Mathlib's `IsCyclotomicExtension.Rat.galEquivZMod` identifies `Gal(K/ℚ)` with `(ℤ/qℤ)ˣ`, sending the
automorphism `σ_a : ζ_q ↦ ζ_q ^ a` to `a`, so that the kernel of `χ` on `(ℤ/qℤ)ˣ` becomes a subgroup
of `Gal(K/ℚ)`. Its fixed field `K^{ker χ}` is the fixed field of `χ`: the elements of `K` fixed by
the automorphisms `ζ_q ↦ ζ_q ^ k` with `χ(k) = 1`. As `Gal(K/ℚ)` is abelian, the fixed field is
Galois over `ℚ` (the instance `IsGalois ℚ (χ.fixedField K)`), and by the Galois correspondence its
Galois group is `Gal(K/ℚ)/ker(χ ∘ σ) ≅ Im(χ)`, the image of `χ` on units. That image is the cyclic
group of `n`-th roots of unity, `n` being the order of `χ`
(`MulChar.range_toUnitHom_eq_rootsOfUnity`, `MulChar.card_range_toUnitHom`,
`MulChar.isCyclic_range_toUnitHom`).

## Main definitions

* `DirichletCharacter.fixedField` (LMFDB `character.dirichlet.field_cut_out`): the fixed field of a
  Dirichlet character.
* `DirichletCharacter.galEquivRange` (LMFDB `character.dirichlet.field_cut_out`): the isomorphism of
  the Galois group of the fixed field with the image of the character.

## Main results

* `DirichletCharacter.mem_fixedField_iff` (LMFDB `character.dirichlet.field_cut_out`): the fixed
  field consists of the elements fixed by the automorphisms `ζ_q ↦ ζ_q ^ k` with `χ(k) = 1`.
* `DirichletCharacter.galEquivRange_restrictNormalHom`: the isomorphism sends the restriction of
  `σ_a` to the fixed field to `χ(a)`.
* `DirichletCharacter.finrank_fixedField`: the fixed field has degree the order of the character.
-/

open IsCyclotomicExtension

namespace DirichletCharacter

variable {q : ℕ} [NeZero q] (K : Type*) [Field K] [NumberField K] [IsCyclotomicExtension {q} ℚ K]
  (χ : DirichletCharacter ℂ q)

/-- The **fixed field** (LMFDB `character.dirichlet.field_cut_out`) of a complex Dirichlet character
`χ` of modulus `q`: the subfield `ℚ(ζ_q)^{ker χ}` of a `q`-th cyclotomic field `K = ℚ(ζ_q)`, for
instance the subfield `adjoin ℚ {b : ℂ | b ^ q = 1}` of `ℂ`, fixed by the subgroup of `Gal(K/ℚ)`
that corresponds to the kernel of `χ` on `(ℤ/qℤ)ˣ` under Mathlib's
`IsCyclotomicExtension.Rat.galEquivZMod`, the isomorphism `Gal(K/ℚ) ≃* (ℤ/qℤ)ˣ` sending
`σ_a : ζ_q ↦ ζ_q ^ a` to `a`. Its elements are those fixed by the automorphisms `ζ_q ↦ ζ_q ^ k`
with `χ(k) = 1` (`DirichletCharacter.mem_fixedField_iff`). -/
noncomputable abbrev fixedField : IntermediateField ℚ K :=
  IntermediateField.fixedField (χ.toUnitHom.comp (Rat.galEquivZMod q K).toMonoidHom).ker

variable {K} in
/-- **The fixed field of `χ` consists of the elements fixed by the automorphisms `ζ_q ↦ ζ_q ^ k`
with `χ(k) = 1`**, `ζ_q` being the primitive `q`-th root of unity `IsCyclotomicExtension.zeta`. -/
lemma mem_fixedField_iff {x : K} : x ∈ χ.fixedField K ↔ ∀ (k : ℕ) (σ : Gal(K/ℚ)),
    σ (zeta q ℚ K) = zeta q ℚ K ^ k → χ k = 1 → σ x = x := by
  have hζ : IsPrimitiveRoot (zeta q ℚ K) q := zeta_spec q ℚ K
  refine ⟨fun hx k σ hσ hk ↦ hx ⟨σ, ?_⟩, fun h σ ↦ ?_⟩
  · rw [Rat.galEquivZMod_apply_of_pow_eq q K σ hζ.pow_eq_one,
      (hζ.isOfFinOrder (NeZero.ne q)).pow_inj_mod, ← hζ.eq_orderOf,
      ← ZMod.natCast_eq_natCast_iff', ZMod.natCast_zmod_val] at hσ
    rwa [MonoidHom.mem_ker, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Units.ext_iff,
      MulChar.coe_toUnitHom, Units.val_one, hσ]
  · have hσ : χ.toUnitHom (Rat.galEquivZMod q K σ) = 1 := σ.2
    refine h _ σ (Rat.galEquivZMod_apply_of_pow_eq q K σ hζ.pow_eq_one) ?_
    rw [ZMod.natCast_zmod_val, ← MulChar.coe_toUnitHom, hσ, Units.val_one]

instance : IsGalois ℚ (χ.fixedField K) := by
  have : IsGalois ℚ K := IsCyclotomicExtension.isGalois {q} ℚ K
  exact IsGalois.of_fixedField_normal_subgroup _

lemma range_comp_galEquivZMod :
    (χ.toUnitHom.comp (Rat.galEquivZMod q K).toMonoidHom).range = χ.toUnitHom.range := by
  rw [MonoidHom.range_comp, MulEquiv.toMonoidHom_eq_coe, MulEquiv.range_eq_top,
    ← MonoidHom.range_eq_map]

/-- The isomorphism (LMFDB `character.dirichlet.field_cut_out`) of the Galois group of the fixed
field `ℚ(ζ_q)^{ker χ}` of a Dirichlet character `χ` with the image `Im(χ)` of `χ` on units, given by
the Galois correspondence: `Gal(ℚ(ζ_q)^{ker χ}/ℚ) ≅ Gal(ℚ(ζ_q)/ℚ)/ker(χ ∘ σ) ≅ Im(χ)`. It sends the
restriction of `σ_a` to `χ(a)` (`DirichletCharacter.galEquivRange_restrictNormalHom`). The image
`Im(χ)` is the cyclic group of `n`-th roots of unity, `n` being the order of `χ`. -/
noncomputable def galEquivRange : Gal(χ.fixedField K/ℚ) ≃* χ.toUnitHom.range :=
  haveI : IsGalois ℚ K := IsCyclotomicExtension.isGalois {q} ℚ K
  (IsGalois.normalAutEquivQuotient _).symm.trans <| (QuotientGroup.quotientKerEquivRange _).trans <|
    MulEquiv.subgroupCongr <| χ.range_comp_galEquivZMod K

/-- **The isomorphism of the Galois group of the fixed field with the image of `χ` sends the
restriction of `σ_a` to `χ(a)`.** -/
lemma galEquivRange_restrictNormalHom (σ : Gal(K/ℚ)) :
    (χ.galEquivRange K (AlgEquiv.restrictNormalHom (χ.fixedField K) σ) : ℂˣ) =
      χ.toUnitHom (Rat.galEquivZMod q K σ) := by
  have : IsGalois ℚ K := IsCyclotomicExtension.isGalois {q} ℚ K
  rw [galEquivRange, MulEquiv.trans_apply, MulEquiv.trans_apply,
    ← IsGalois.normalAutEquivQuotient_apply, MulEquiv.symm_apply_apply]
  rfl

/-- **The fixed field of a Dirichlet character of order `n` has degree `n` over `ℚ`.** -/
lemma finrank_fixedField : Module.finrank ℚ (χ.fixedField K) = orderOf χ := by
  rw [← IsGalois.card_aut_eq_finrank, Nat.card_congr (χ.galEquivRange K).toEquiv,
    χ.card_range_toUnitHom]

end DirichletCharacter
