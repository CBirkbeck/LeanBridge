import Mathlib.RingTheory.Localization.NormTrace
import TauCeti.FieldTheory.GaloisGroups.Discriminant.Field
import TauCeti.FieldTheory.IntermediateField.Quadratic
import TauCeti.NumberTheory.LocalField.AbsoluteRamificationIndex
import TauCeti.NumberTheory.LocalField.Discriminant.Basic
import TauCeti.NumberTheory.LocalField.Monogenic
import TauCeti.NumberTheory.LocalField.Norm.Basic
import TauCeti.RingTheory.Polynomial.Resultant.Discriminant

/-!
# The discriminant of an extension of local fields from an integral basis

Let `L / K` be a finite separable extension of nonarchimedean local fields and `β_1, …, β_n` a
basis of `𝒪_L` over `𝒪_K`. The LMFDB (`lf.discriminant_exponent`) defines the discriminant of
`L / K` as `det(σ_i(β_j)) ^ 2`, for the embeddings `σ_i` of `L` into an algebraic closure of `K`;
it is the discriminant `Algebra.discr 𝒪_K β` of the basis, an element of `𝒪_K`, well defined up
to the square of a unit, of the form `π_K ^ c u` with `u` a unit, and `c` is the discriminant
exponent.
Tau Ceti defines the discriminant exponent `TauCeti.discriminantExponent K L` instead as the
exponent of `𝓂_K` in the relative norm of the different, `TauCeti.discriminantIdeal K L`. We show
that this ideal is generated by `Algebra.discr 𝒪_K β` for every integral basis `β`, so the two
definitions agree.

The proof writes `𝒪_L = 𝒪_K[x]` (Tau Ceti), so that the different is generated by `f'(x)` for the
minimal polynomial `f` of `x`, and its norm is `± disc(1, x, …, x ^ (n - 1))`; any other integral
basis differs from this power basis by a matrix invertible over `𝒪_K`.

Together with the discriminant root field `K(√disc f)` (LMFDB `lf.discriminant_root_field`) of a
defining polynomial `f`, the exponent `c` determines the discriminant up to the square of a unit:
`disc β · disc f` is a square in `K`, two discriminant root fields agree only for discriminants in
the same square class (Tau Ceti's quadratic Kummer theory), and an element of `K` whose square is a
unit of `𝒪_K` is itself a unit.

## Main definitions

* `IsNonarchimedeanLocalField.padicDiscriminantExponent` (LMFDB `lf.discriminant_exponent`): the
  discriminant exponent of a `p`-adic field over `ℚ_p`, which gives the base and the absolute
  discriminant exponents `c_0` and `c_abs` of an extension `L / K` of `p`-adic fields.

## Main theorems

* `Algebra.discr_eq_det_sq_mul_discr` (LMFDB `lf.discriminant_exponent`): the discriminants of two
  bases differ by the square of a unit.
* `IsNonarchimedeanLocalField.span_discr_eq_discriminantIdeal` (LMFDB `lf.discriminant_exponent`):
  the discriminant of any integral basis generates Tau Ceti's discriminant ideal.
* `IsNonarchimedeanLocalField.associated_discr` (LMFDB `lf.discriminant_exponent`): the
  discriminant is `π_K ^ c u` with `u` a unit and `c` the discriminant exponent.
* `IsNonarchimedeanLocalField.algebraMap_discr_eq_det_sq` (LMFDB `lf.discriminant_exponent`): the
  discriminant of an integral basis is `det(σ_i(β_j)) ^ 2`.
* `IsNonarchimedeanLocalField.exists_discr_eq_sq_mul_discr` (LMFDB `lf.discriminant_exponent`):
  the discriminant exponent and the discriminant root field determine the discriminant up to the
  square of a unit.
-/

open ValuativeRel IsLocalRing TauCeti Polynomial

open scoped IntermediateField

namespace Algebra

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] {ι : Type*} [Fintype ι]
  [DecidableEq ι]

/-- **The discriminant is well defined up to the square of a unit** (LMFDB
`lf.discriminant_exponent`): the discriminants of two bases `b, b'` of `B` over `A` differ by the
square of the determinant of `b'` in the basis `b`, a unit of `A` (`Module.Basis.isUnit_det`). -/
lemma discr_eq_det_sq_mul_discr (b b' : Module.Basis ι A B) :
    discr A b' = b.det b' ^ 2 * discr A b := by
  rw [b.det_apply, ← discr_of_matrix_vecMul, b.toMatrix_map_vecMul]

end Algebra

namespace IsNonarchimedeanLocalField

variable (K L : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L] {ι : Type*} [Fintype ι]
  [DecidableEq ι]

open Module in
lemma algebraMap_discr_integerRing (b : Module.Basis ι 𝒪[K] 𝒪[L]) :
    algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b) = Algebra.discr K fun i ↦ (b i : L) := by
  have : IsLocalization (Algebra.algebraMapSubmonoid 𝒪[L] (nonZeroDivisors 𝒪[K])) L :=
    isLocalization_integerRing K L
  rw [← Algebra.discr_localizationLocalization 𝒪[K] (nonZeroDivisors 𝒪[K]) L b]
  congr 1
  funext i
  rw [Basis.localizationLocalization_apply]
  rfl

variable [Algebra.IsSeparable K L]

lemma discr_powerBasis_eq_neg_one_pow_mul_intNorm (pb : PowerBasis 𝒪[K] 𝒪[L])
    (hpb : K⟮(pb.gen : L)⟯ = ⊤) : Algebra.discr 𝒪[K] pb.basis =
      (-1) ^ (Module.finrank K L * (Module.finrank K L - 1) / 2) *
        Algebra.intNorm 𝒪[K] 𝒪[L] (aeval pb.gen (derivative (minpoly 𝒪[K] pb.gen))) := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  have hint : IsIntegral K (pb.gen : L) := .of_finite K _
  have hadj : Algebra.adjoin K {(pb.gen : L)} = ⊤ := by
    rw [← IntermediateField.adjoin_toSubalgebra, hpb, IntermediateField.top_toSubalgebra]
  have hmin : minpoly K (pb.gen : L) = (minpoly 𝒪[K] pb.gen).map (algebraMap 𝒪[K] K) :=
    minpoly.isIntegrallyClosed_eq_field_fractions K L pb.isIntegral_gen
  have hdim : (PowerBasis.ofAdjoinEqTop hint hadj).dim = pb.dim := by
    rw [PowerBasis.ofAdjoinEqTop_dim, hmin, (minpoly.monic pb.isIntegral_gen).natDegree_map,
      pb.natDegree_minpoly]
  have hcoe (y : 𝒪[K]) : algebraMap 𝒪[K] K y = y := rfl
  have hfun : (fun i ↦ ((pb.basis i : 𝒪[L]) : L)) =
      (PowerBasis.ofAdjoinEqTop hint hadj).basis ∘ (finCongr hdim).symm := by
    funext i
    rw [Function.comp_apply, PowerBasis.basis_eq_pow, PowerBasis.basis_eq_pow,
      PowerBasis.ofAdjoinEqTop_gen, finCongr_symm_apply_coe]
    rfl
  apply IsFractionRing.injective 𝒪[K] K
  rw [algebraMap_discr_integerRing, map_mul, map_pow, map_neg, map_one, Algebra.intNorm_eq_norm,
    hcoe, coe_norm_integerRing, hfun, Algebra.discr_reindex, Algebra.discr_powerBasis_eq_norm,
    PowerBasis.ofAdjoinEqTop_gen, hmin, derivative_map, aeval_map_algebraMap]
  congr 2
  exact aeval_algebraMap_apply L pb.gen _

/-- **The discriminant of an integral basis generates the discriminant ideal** (LMFDB
`lf.discriminant_exponent`): for every basis `β` of `𝒪_L` over `𝒪_K`, the discriminant
`Algebra.discr 𝒪_K β` generates Tau Ceti's discriminant ideal `N_{L/K}(𝔡(L / K))`. -/
lemma span_discr_eq_discriminantIdeal (b : Module.Basis ι 𝒪[K] 𝒪[L]) :
    Ideal.span {Algebra.discr 𝒪[K] b} = discriminantIdeal K L := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  rcases exists_integerRing_powerBasis_intermediateField_adjoin_eq_top_and_dim_eq_finrank K L with
    ⟨pb, hpb, -⟩
  rw [← Algebra.discr_reindex 𝒪[K] b (b.indexEquiv pb.basis), ← b.coe_reindex,
    Algebra.discr_eq_det_sq_mul_discr pb.basis,
    Ideal.span_singleton_mul_left_unit ((pb.basis.isUnit_det _).pow 2),
    discr_powerBasis_eq_neg_one_pow_mul_intNorm K L pb hpb,
    Ideal.span_singleton_mul_left_unit (isUnit_neg_one.pow _), ← Ideal.relNorm_singleton,
    ← differentIdeal_eq_span_aeval_derivative_minpoly 𝒪[K] K L 𝒪[L] pb.gen pb.adjoin_gen_eq_top,
    discriminantIdeal_def]

lemma discr_ne_zero (b : Module.Basis ι 𝒪[K] 𝒪[L]) : Algebra.discr 𝒪[K] b ≠ 0 := fun h ↦
  discriminantIdeal_ne_bot K L <| by
    rw [← span_discr_eq_discriminantIdeal K L b, h, Ideal.span_singleton_eq_bot]

/-- **The discriminant is `π_K ^ c u` with `u` a unit and `c` the discriminant exponent** (LMFDB
`lf.discriminant_exponent`): for a uniformizer `ϖ` of `K` and a basis `β` of `𝒪_L` over `𝒪_K`,
`Algebra.discr 𝒪_K β` is associated to `ϖ ^ c`, where `c = TauCeti.discriminantExponent K L`. -/
lemma associated_discr {ϖ : 𝒪[K]} (hϖ : Irreducible ϖ) (b : Module.Basis ι 𝒪[K] 𝒪[L]) :
    Associated (ϖ ^ discriminantExponent K L) (Algebra.discr 𝒪[K] b) := by
  rw [← Ideal.span_singleton_eq_span_singleton, span_discr_eq_discriminantIdeal,
    discriminantIdeal_eq_maximalIdeal_pow,
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).1 hϖ, Ideal.span_singleton_pow]

/-- **The discriminant is the square of `det(σ_i(β_j))`** (LMFDB `lf.discriminant_exponent`): for
a basis `β` of `𝒪_L` over `𝒪_K` and an enumeration `e` of the embeddings `σ` of `L` into an
algebraically closed field `E` over `K`, the image in `E` of `Algebra.discr 𝒪_K β` is the square of
the determinant of the matrix `(σ_i(β_j))`. -/
lemma algebraMap_discr_eq_det_sq (E : Type*) [Field E] [Algebra K E] [IsAlgClosed E]
    (b : Module.Basis ι 𝒪[K] 𝒪[L]) (e : ι ≃ (L →ₐ[K] E)) :
    algebraMap K E (algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b)) =
      (Algebra.embeddingsMatrixReindex K E (fun i ↦ (b i : L)) e).det ^ 2 := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  rw [algebraMap_discr_integerRing, Algebra.discr_eq_det_embeddingsMatrixReindex_pow_two]

lemma isSquare_algebraMap_discr_mul_discr_minpoly (b : Module.Basis ι 𝒪[K] 𝒪[L]) {x : L}
    (hx : K⟮x⟯ = ⊤) :
    IsSquare (algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b) * (minpoly K x).discr) := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  have : IsLocalization (Algebra.algebraMapSubmonoid 𝒪[L] (nonZeroDivisors 𝒪[K])) L :=
    isLocalization_integerRing K L
  have hint : IsIntegral K x := .of_finite K x
  have hadj : Algebra.adjoin K {x} = ⊤ := by
    rw [← IntermediateField.adjoin_toSubalgebra, hx, IntermediateField.top_toSubalgebra]
  let pbL : PowerBasis K L := PowerBasis.ofAdjoinEqTop hint hadj
  let bL : Module.Basis ι K L := b.localizationLocalization K (nonZeroDivisors 𝒪[K]) L
  have h₁ : algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b) = Algebra.discr K bL :=
    (Algebra.discr_localizationLocalization 𝒪[K] (nonZeroDivisors 𝒪[K]) L b).symm
  rw [h₁, ← Algebra.discr_reindex K bL (bL.indexEquiv pbL.basis), ← bL.coe_reindex,
    Algebra.discr_eq_det_sq_mul_discr pbL.basis, Algebra.discr_powerBasis_eq_minpoly_discr,
    PowerBasis.ofAdjoinEqTop_gen]
  exact ⟨pbL.basis.det (bL.reindex (bL.indexEquiv pbL.basis)) * (minpoly K x).discr, by ring1⟩

variable (L' : Type*) [Field L'] [ValuativeRel L'] [TopologicalSpace L']
  [IsNonarchimedeanLocalField L'] [Algebra K L'] [ValuativeExtension K L']
  [Algebra.IsSeparable K L'] in
open Algebra in
/-- **The discriminant exponent and the discriminant root field determine the discriminant up to
the square of a unit** (LMFDB `lf.discriminant_exponent`): let `L / K` and `L' / K` be finite
separable extensions of a nonarchimedean local field `K` with `2 ≠ 0`, with bases `β, β'` of `𝒪_L`
and `𝒪_{L'}` over `𝒪_K` and generators `x, x'` (`K(x) = L`, `K(x') = L'`). If they have the same
discriminant exponent and the same discriminant root field `K(√disc f) = K(√disc f')` (LMFDB
`lf.discriminant_root_field`, Tau Ceti's `TauCeti.discrField`) for the minimal polynomials `f, f'`
of `x, x'`, in an algebraically closed field `E`, then `disc β' = u ^ 2 disc β` for a unit `u`. -/
lemma exists_discr_eq_sq_mul_discr [NeZero (2 : K)] (E : Type*) [Field E] [Algebra K E]
    [IsAlgClosed E] {ι' : Type*} [Fintype ι'] [DecidableEq ι'] (b : Module.Basis ι 𝒪[K] 𝒪[L])
    (b' : Module.Basis ι' 𝒪[K] 𝒪[L']) {x : L} {x' : L'} (hx : K⟮x⟯ = ⊤) (hx' : K⟮x'⟯ = ⊤)
    (hc : discriminantExponent K L = discriminantExponent K L')
    (hroot : discrField (minpoly K x) E = discrField (minpoly K x') E) :
    ∃ u : 𝒪[K]ˣ, Algebra.discr 𝒪[K] b' = (u : 𝒪[K]) ^ 2 * Algebra.discr 𝒪[K] b := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  have : Module.Finite K L' := finite_of_valuativeExtension K L'
  have hD : (minpoly K x).discr ≠ 0 :=
    (Monic.discr_ne_zero_iff (minpoly.monic (.of_finite K x))).2 (IsSeparable.isSeparable K x)
  have hD' : (minpoly K x').discr ≠ 0 :=
    (Monic.discr_ne_zero_iff (minpoly.monic (.of_finite K x'))).2 (IsSeparable.isSeparable K x')
  have hd : algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective 𝒪[K] K)).2 (discr_ne_zero K L b)
  rcases IsAlgClosed.exists_pow_nat_eq (algebraMap K E (minpoly K x).discr) two_pos with ⟨δ, hδ⟩
  rcases IsAlgClosed.exists_pow_nat_eq (algebraMap K E (minpoly K x').discr) two_pos with
    ⟨δ', hδ'⟩
  rw [discrField_eq_adjoin_simple hδ, discrField_eq_adjoin_simple hδ'] at hroot
  have hDD : IsSquare ((minpoly K x).discr * (minpoly K x').discr) := by
    by_cases hδb : δ ∈ (⊥ : IntermediateField K E)
    · have hδ'b : δ' ∈ (⊥ : IntermediateField K E) := IntermediateField.adjoin_simple_eq_bot_iff.1
        (hroot ▸ IntermediateField.adjoin_simple_eq_bot_iff.2 hδb)
      rcases IntermediateField.mem_bot.1 hδb with ⟨r, hr⟩
      rcases IntermediateField.mem_bot.1 hδ'b with ⟨r', hr'⟩
      refine ⟨r * r', (algebraMap K E).injective ?_⟩
      simp only [map_mul]
      rw [← hδ, ← hδ', ← hr, ← hr']
      ring1
    · exact IntermediateField.isSquare_mul_of_adjoin_simple_eq hδ hδ' hδb hroot
  rcases isSquare_algebraMap_discr_mul_discr_minpoly K L b hx with ⟨s, hs⟩
  rcases isSquare_algebraMap_discr_mul_discr_minpoly K L' b' hx' with ⟨s', hs'⟩
  rcases hDD with ⟨t, ht⟩
  rcases IsDiscreteValuationRing.exists_irreducible 𝒪[K] with ⟨ϖ, hϖ⟩
  rcases (associated_discr K L hϖ b).symm.trans (hc ▸ associated_discr K L' hϖ b') with ⟨u, hu⟩
  have hu' : algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b) * algebraMap 𝒪[K] K u =
      algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b') := by
    rw [← map_mul, hu]
  generalize algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b) = d at hd hs hu'
  generalize algebraMap 𝒪[K] K (Algebra.discr 𝒪[K] b') = d' at hs' hu'
  generalize (minpoly K x).discr = D at hD hs ht
  generalize (minpoly K x').discr = D' at hD' hs' ht
  have hz : (s * s' * t / (d * D * D')) ^ 2 = algebraMap 𝒪[K] K u := by
    rw [div_pow, div_eq_iff (pow_ne_zero 2 (mul_ne_zero (mul_ne_zero hd hD) hD'))]
    linear_combination -(s' * s') * (t * t) * hs - d * D * (t * t) * hs' - d * D * d' * D' * ht -
      d * D ^ 2 * D' ^ 2 * hu'
  have hint : IsIntegral 𝒪[K] (s * s' * t / (d * D * D')) :=
    ⟨X ^ 2 - C (u : 𝒪[K]), monic_X_pow_sub_C _ two_ne_zero, by simp [hz]⟩
  rcases IsIntegrallyClosed.isIntegral_iff.1 hint with ⟨y, hy⟩
  have hy₂ : y ^ 2 = u :=
    IsFractionRing.injective 𝒪[K] K <| by rw [map_pow, hy, hz]
  have hyu : IsUnit y :=
    (isUnit_pow_iff two_ne_zero).1 (hy₂ ▸ u.isUnit)
  exact ⟨hyu.unit, by rw [IsUnit.unit_spec, hy₂, mul_comm, hu]⟩

variable (p : ℕ) [Fact p.Prime] [FinitePadicExtension K p] in
/-- The **discriminant exponent over `ℚ_p`** of a `p`-adic field `K` (LMFDB
`lf.discriminant_exponent`): Tau Ceti's discriminant exponent of `K / ℚ_p`, a separable extension
since `ℚ_p` has characteristic zero. For an extension `L / K` of `p`-adic fields, the **base
discriminant exponent** `c_0` is this exponent of `K`, and the **absolute discriminant exponent**
`c_abs` is this exponent of `L`. -/
noncomputable def padicDiscriminantExponent : ℕ :=
  haveI : Algebra.IsIntegral ℚ_[p] K := .of_finite ℚ_[p] K
  haveI : Algebra.IsSeparable ℚ_[p] K := .of_integral ℚ_[p] K
  discriminantExponent ℚ_[p] K

end IsNonarchimedeanLocalField
