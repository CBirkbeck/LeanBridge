import LeanBridge.ForMathlib.RingTheory.Polynomial.EisensteinForm
import TauCeti.FieldTheory.IntermediateField.Adjoin.EqTop
import TauCeti.NumberTheory.LocalField.InertiaDegree
import TauCeti.RingTheory.LocalRing.Monogenic

/-!
# Every extension of local fields is generated by a root of a polynomial of Eisenstein form

Let `L / K` be a finite extension of nonarchimedean local fields, with ramification index `e` and
residue degree `f`. Lift a generator `α` of the residue field extension to `a ∈ 𝒪_L`, and its
minimal polynomial to a monic `ν ∈ 𝒪_K[X]` of degree `f`; a Newton step (Tau Ceti) moves `a` within
its residue class to a `β` at which `Π = ν(β)` is a uniformizer of `L`. Then `𝒪_L = 𝒪_K[β]`
(Tau Ceti), so `L = K(β)`, and the minimal polynomial `F` of `β` has degree `e f`. Writing
`F = ν ^ e + ∑_{i < e} g_i ν ^ i` with `deg g_i < f`, the relation `0 = Π ^ e + ∑ g_i(β) Π ^ i`
forces every `g_i` to have coefficients in `𝓂_K` and `g_0` to have one outside `𝓂_K ^ 2`: an element
`g_i(β)` with a unit coefficient is a unit, since its residue `ḡ_i(α)` has degree less than `f`,
while `g_i(β) ∈ 𝓂_K 𝒪_L = 𝓂_L ^ e` otherwise, and a sum of terms of which exactly one is not in
`𝓂_L ^ (k + 1)` is not zero. So `F` is of Eisenstein form (LMFDB `lf.eisenstein_form`).

## Main theorems

* `IsNonarchimedeanLocalField.exists_adjoin_eq_top_isEisensteinForm_minpoly` (LMFDB
  `lf.eisenstein_form`): every finite extension `L / K` of nonarchimedean local fields, ramified or
  not, is `K(β)` for a root `β` of a polynomial of Eisenstein form, its minimal polynomial over
  `𝒪_K`.
-/

open ValuativeRel IsLocalRing Polynomial Finset TauCeti

open scoped IntermediateField

namespace Polynomial

lemma exists_eq_pow_add_sum_mul_pow {R : Type*} [CommRing R] [Nontrivial R] {F ν : R[X]}
    (hν : ν.Monic) (hd : 0 < ν.natDegree) (e : ℕ) (hF : F.Monic)
    (he : F.natDegree = e * ν.natDegree) :
    ∃ g : ℕ → R[X], (∀ i, (g i).degree < ν.degree) ∧ F = ν ^ e + ∑ i ∈ range e, g i * ν ^ i := by
  induction e generalizing F with
  | zero =>
    refine ⟨fun _ ↦ 0, fun _ ↦ ?_, ?_⟩
    · rw [degree_zero]
      exact bot_lt_iff_ne_bot.2 (ne_zero_of_natDegree_gt hd ∘ degree_eq_bot.1)
    · rw [zero_mul] at he
      rw [pow_zero, sum_range_zero, add_zero, (Monic.natDegree_eq_zero hF).1 he]
  | succ e ih =>
    have hdeg : (F %ₘ ν).degree < ν.degree := degree_modByMonic_lt F hν
    have hle : ν.degree ≤ F.degree := by
      rw [degree_eq_natDegree hν.ne_zero, degree_eq_natDegree hF.ne_zero, he]
      exact_mod_cast Nat.le_mul_of_pos_left _ e.succ_pos
    have hQ : (F /ₘ ν).Monic := by
      rw [Monic, leadingCoeff_divByMonic_of_monic hν hle, hF.leadingCoeff]
    have hQdeg : (F /ₘ ν).natDegree = e * ν.natDegree := by
      rw [natDegree_divByMonic F hν, he, Nat.succ_mul, Nat.add_sub_cancel]
    rcases ih hQ hQdeg with ⟨g, hg, hQeq⟩
    refine ⟨fun i ↦ Nat.casesOn i (F %ₘ ν) g, fun i ↦ Nat.casesOn i hdeg hg, ?_⟩
    conv_lhs => rw [← modByMonic_add_div F ν, hQeq]
    rw [sum_range_succ', mul_add, mul_sum, pow_succ', pow_zero, mul_one]
    simp_rw [mul_left_comm ν, ← pow_succ']
    rw [Nat.rec_zero]
    ring1

end Polynomial

namespace IsNonarchimedeanLocalField

variable (K : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  (L : Type*) [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L] [ValuativeExtension K L]

open Algebra in
/-- **Every extension is generated by a root of a polynomial of Eisenstein form** (LMFDB
`lf.eisenstein_form`): a finite extension `L / K` of nonarchimedean local fields, ramified or not,
is `K(β)` for some `β ∈ 𝒪_L` whose minimal polynomial over `𝒪_K` is of Eisenstein form. -/
lemma exists_adjoin_eq_top_isEisensteinForm_minpoly :
    ∃ β : 𝒪[L], K⟮(β : L)⟯ = ⊤ ∧ (minpoly 𝒪[K] β).IsEisensteinForm := by
  have : Module.Finite K L := finite_of_valuativeExtension K L
  rcases Field.exists_primitive_element 𝓀[K] 𝓀[L] with ⟨α, hα⟩
  rcases lifts_and_natDegree_eq_and_monic
    (mem_lifts_of_surjective residue_surjective (minpoly 𝓀[K] α)) (minpoly.monic
      (.of_finite 𝓀[K] α)) with ⟨ν, hνmap, hνdeg, hν⟩
  rcases residue_surjective (R := 𝒪[L]) α with ⟨a, rfl⟩
  rcases IsDiscreteValuationRing.exists_irreducible 𝒪[L] with ⟨π, hπ⟩
  have hπspan : Ideal.span {π} = 𝓂[L] :=
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer π).1 hπ).symm
  have hbridge (x : 𝒪[L]) (q : 𝒪[K][X]) :
      residue 𝒪[L] (aeval x q) = aeval (residue 𝒪[L] x) (q.map (residue 𝒪[K])) :=
    map_aeval_eq_aeval_map IsLocalRing.residue_comp_algebraMap q x
  have ha : (ν.map (algebraMap 𝒪[K] 𝒪[L])).eval a ∈ 𝓂[L] := by
    rw [eval_map_algebraMap, ← residue_eq_zero_iff, hbridge, hνmap, minpoly.aeval]
  have ha' : IsUnit ((derivative (ν.map (algebraMap 𝒪[K] 𝒪[L]))).eval a) := by
    rw [derivative_map, eval_map_algebraMap, ← residue_ne_zero_iff_isUnit, hbridge,
      ← derivative_map, hνmap]
    exact (IsSeparable.isSeparable _ _).aeval_derivative_ne_zero (minpoly.aeval _ _)
  rcases IsLocalRing.exists_span_eval_eq_maximalIdeal hπspan ha ha' with ⟨β, hβa, hβ⟩
  rw [eval_map_algebraMap] at hβ
  have hres : residue 𝒪[L] β = residue 𝒪[L] a := by
    rw [← sub_eq_zero, ← map_sub, residue_eq_zero_iff]
    exact hβa
  have hadj : Algebra.adjoin 𝒪[K] {β} = ⊤ :=
    IsLocalRing.adjoin_eq_top_of_span_eval_eq_maximalIdeal
      (hres ▸ Algebra.adjoin_eq_top_of_primitive_element (IsAlgebraic.of_finite _ _) hα) hβ
  have hβint : IsIntegral 𝒪[K] β := .of_finite 𝒪[K] β
  have hgen' : IntermediateField.adjoin K {algebraMap 𝒪[L] L β} = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top hadj
  have hgen : K⟮(β : L)⟯ = ⊤ := hgen'
  refine ⟨β, hgen, ?_⟩
  have hαdeg : (minpoly 𝓀[K] (residue 𝒪[L] a)).natDegree = inertiaDegree K L := by
    rw [inertiaDegree_def, ← Field.primitive_element_iff_minpoly_natDegree_eq]
    exact hα
  have hβdeg : (minpoly 𝒪[K] β).natDegree = Module.finrank K L := by
    rw [← (minpoly.monic hβint).natDegree_map (algebraMap 𝒪[K] K),
      ← minpoly.isIntegrallyClosed_eq_field_fractions K L hβint,
      ← Field.primitive_element_iff_minpoly_natDegree_eq]
    exact hgen
  have hFdeg : (minpoly 𝒪[K] β).natDegree = ramificationIndex K L * ν.natDegree := by
    rw [hβdeg, hνdeg, hαdeg, ramificationIndex_mul_inertiaDegree]
  have hνpos : 0 < ν.natDegree := by
    rw [hνdeg]
    exact minpoly.natDegree_pos (.of_finite 𝓀[K] _)
  rcases exists_eq_pow_add_sum_mul_pow hν hνpos _ (minpoly.monic hβint) hFdeg with
    ⟨g, hgdeg, hFeq⟩
  have hirr : Irreducible (aeval β ν) :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer _).2 hβ.symm
  have hmax : aeval β ν ∈ 𝓂[L] := by
    rw [← hβ]
    exact Ideal.mem_span_singleton_self _
  have hunit (q : 𝒪[K][X]) (hq : q.degree < ν.degree) (n : ℕ) (hn : q.coeff n ∉ 𝓂[K]) :
      IsUnit (aeval β q) := by
    rw [← residue_ne_zero_iff_isUnit, hbridge, hres]
    intro h₀
    have hq₀ : q.map (residue 𝒪[K]) ≠ 0 := fun h ↦
      hn (by rw [← residue_eq_zero_iff, ← coeff_map, h, coeff_zero])
    have hle : (minpoly 𝓀[K] (residue 𝒪[L] a)).degree ≤ (q.map (residue 𝒪[K])).degree :=
      minpoly.degree_le_of_ne_zero 𝓀[K] (residue 𝒪[L] a) hq₀ h₀
    rw [← hνmap, hν.degree_map] at hle
    exact lt_irrefl _ ((hle.trans degree_map_le).trans_lt hq)
  have hmem (I : Ideal 𝒪[K]) (q : 𝒪[K][X]) (hq : ∀ n, q.coeff n ∈ I) :
      aeval β q ∈ I.map (algebraMap 𝒪[K] 𝒪[L]) := by
    rw [aeval_eq_sum_range]
    refine Ideal.sum_mem _ fun n _ ↦ ?_
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hq n))
  have hnot (u : 𝒪[L]) (hu : IsUnit u) (k : ℕ) : u * aeval β ν ^ k ∉ 𝓂[L] ^ (k + 1) := by
    rw [← hβ, Ideal.span_singleton_pow, Ideal.mem_span_singleton, pow_succ, mul_comm u]
    intro h
    exact hirr.not_isUnit (isUnit_of_dvd_unit
      ((mul_dvd_mul_iff_left (pow_ne_zero k hirr.ne_zero)).1 h) hu)
  have hF₀ : aeval β ν ^ ramificationIndex K L +
      ∑ i ∈ range (ramificationIndex K L), aeval β (g i) * aeval β ν ^ i = 0 := by
    have h : aeval β (minpoly 𝒪[K] β) = 0 := minpoly.aeval 𝒪[K] β
    rw [hFeq, map_add, map_pow, map_sum] at h
    simpa only [map_mul, map_pow] using h
  have hA : ∀ i < ramificationIndex K L, ∀ n, (g i).coeff n ∈ 𝓂[K] := by
    by_contra hcon
    push Not at hcon
    classical
    have hspec : Nat.find hcon < ramificationIndex K L ∧
        ∃ n, (g (Nat.find hcon)).coeff n ∉ 𝓂[K] :=
      Nat.find_spec hcon
    have hmin (i : ℕ) (hi : i < Nat.find hcon) (n : ℕ) : (g i).coeff n ∈ 𝓂[K] := by
      by_contra hn
      exact Nat.find_min hcon hi ⟨hi.trans hspec.1, n, hn⟩
    rcases hspec with ⟨hi₀, n₀, hn₀⟩
    apply hnot _ (hunit _ (hgdeg _) n₀ hn₀) (Nat.find hcon)
    have hsplit : aeval β (g (Nat.find hcon)) * aeval β ν ^ Nat.find hcon +
        ∑ i ∈ (range (ramificationIndex K L)).erase (Nat.find hcon), aeval β (g i) * aeval β ν ^ i =
          ∑ i ∈ range (ramificationIndex K L), aeval β (g i) * aeval β ν ^ i :=
      add_sum_erase _ (fun i ↦ aeval β (g i) * aeval β ν ^ i) (mem_range.2 hi₀)
    rw [← hsplit, ← add_assoc, add_comm _ (aeval β (g _) * _), add_assoc,
      add_eq_zero_iff_eq_neg] at hF₀
    rw [hF₀]
    refine neg_mem (Ideal.add_mem _ (Ideal.pow_le_pow_right hi₀ (Ideal.pow_mem_pow hmax _))
      (Ideal.sum_mem _ fun i hi ↦ ?_))
    rcases mem_erase.1 hi with ⟨hne, -⟩
    rcases hne.lt_or_gt with hlt | hgt
    · refine Ideal.mul_mem_right _ _ (Ideal.pow_le_pow_right hi₀ ?_)
      rw [← map_maximalIdeal_eq_maximalIdeal_pow K L]
      exact hmem _ _ (hmin i hlt)
    · exact Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right hgt (Ideal.pow_mem_pow hmax i))
  have hB : ∃ n, (g 0).coeff n ∉ 𝓂[K] ^ 2 := by
    by_contra hcon
    push Not at hcon
    rcases Nat.exists_eq_add_one.2 (ramificationIndex_pos (K := K) (L := L)) with ⟨e, he⟩
    apply hnot 1 isUnit_one (ramificationIndex K L)
    rw [one_mul, ← neg_neg (aeval β ν ^ _), neg_eq_of_add_eq_zero_right hF₀, he, sum_range_succ']
    refine neg_mem (Ideal.add_mem _ (Ideal.sum_mem _ fun i hi ↦ ?_) ?_)
    · rw [pow_succ]
      refine Ideal.mul_mem_mul ?_
        (Ideal.pow_le_self (Nat.succ_ne_zero i) (Ideal.pow_mem_pow hmax _))
      rw [← he, ← map_maximalIdeal_eq_maximalIdeal_pow K L]
      exact hmem _ _ (hA (i + 1) (he ▸ Nat.succ_lt_succ (mem_range.1 hi)))
    · have h2 : aeval β (g 0) ∈ (𝓂[K] ^ 2).map (algebraMap 𝒪[K] 𝒪[L]) := hmem _ _ hcon
      rw [Ideal.map_pow, map_maximalIdeal_eq_maximalIdeal_pow K L, ← pow_mul, he] at h2
      rw [pow_zero, mul_one]
      exact Ideal.pow_le_pow_right (by omega) h2
  exact ⟨minpoly.monic hβint, ν, ramificationIndex K L, g, hν,
    hνmap ▸ minpoly.irreducible (.of_finite 𝓀[K] _), ramificationIndex_pos, hA,
    fun i _ ↦ hgdeg i, hB, hFeq⟩

end IsNonarchimedeanLocalField
