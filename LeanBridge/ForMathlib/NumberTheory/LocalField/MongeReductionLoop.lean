import LeanBridge.ForMathlib.NumberTheory.LocalField.MongeDigits

/-!
# Monge's reduction algorithm

This file runs the reduction algorithm of Monge (arXiv:1109.4617, Algorithms 1 and 2, p. 7): for a
totally ramified extension `L / K` of Herbrand invariant `I`, it replaces a uniformiser `π` of `L`
by `π + π ^ (m + 1) θ`, for suitable `m` and `θ`, one digit of its minimal polynomial `g` at a time.
A digit of `g` at the index `r` can be changed by the elements of Monge's subgroup `W_r`, which
leaves the lower digits unchanged, and does not depend on the uniformiser modulo `π ^ 2`. By the
ramification polygon of `g`, a digit is `0` at a `Z`-point, not `0` at an `A`-point, and arbitrary
at a `B`-point. At a `C`-point, it can be made `0` when `r / e` is not a Swan slope, since `W_r` is
then the whole residue field, and otherwise lies in a set of representatives modulo `W_r`.

The algorithm stops at the top of the generic polynomial, by Monge's Remark 1 (p. 7): a polynomial
which is close enough to `g` has a root close to `π`, the quantitative criterion of Krasner that
Monge recovers from the reduction steps above `r_w`. This file uses Tau Ceti's Hensel lemma instead,
for the polynomial `π ^ (-N) q(π + π ^ (m₀ + 1) T)`, with a simple root modulo `π` at `T = 0`.

## Main definitions

* `IsNonarchimedeanLocalField.HerbrandInvariant.IsMongeStage`: a stage of the algorithm.
* `IsNonarchimedeanLocalField.HerbrandInvariant.IsValidDigit`: the digits that the algorithm allows.

## Main results

* `IsNonarchimedeanLocalField.HerbrandInvariant.exists_isMongeStage_of_sub_mem_mongeSubgroup`
  (Monge's Algorithm 2): the reduction step.
* `IsNonarchimedeanLocalField.HerbrandInvariant.mem_mongeSubgroup_of_pointType_eq_C`: the digit at a
  `C`-point.
* `IsNonarchimedeanLocalField.HerbrandInvariant.exists_isValidDigit` (Monge's Proposition 3): the
  choice of the digit.
* `IsNonarchimedeanLocalField.HerbrandInvariant.exists_isMongeStage_hasDigits`: the reduction loop.
* `IsNonarchimedeanLocalField.HerbrandInvariant.exists_isMongeStage_coeff_zero` (Monge's
  Algorithm 1): the first step.
* `IsNonarchimedeanLocalField.HerbrandInvariant.exists_root_of_pow_dvd` (Monge's Remark 1): the
  truncation above the top break.
* `IsNonarchimedeanLocalField.HerbrandInvariant.exists_mem_mongeSemicanonicalPolynomials` (LMFDB
  `lf.family_polynomial`, the first statement of Monge's Theorem 1): every extension of Herbrand
  invariant `I` is generated by a root of a semicanonical polynomial.
-/

open Finset Ideal IntermediateField IsDiscreteValuationRing IsLocalRing Polynomial TauCeti
  ValuativeRel

namespace IsNonarchimedeanLocalField.HerbrandInvariant

variable {K L : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K] [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L] {p : ℕ}
  {I : HerbrandInvariant p} {g : 𝒪[K][X]} {π : 𝒪[L]} {ϖ δ t : 𝒪[K]} {f : ℕ → 𝒪[K]} {e₀ r : ℕ}

lemma dvd_of_pow_two_dvd_sub {A : Type*} [CommRing A] {x y : A} (h : x ^ 2 ∣ y - x) : x ∣ y :=
  dvd_sub_self_right.mp ((dvd_pow_self x two_ne_zero).trans h)

lemma exists_digits (hg : g.IsEisensteinAt 𝓂[K]) (hϖ : Irreducible ϖ) :
    ∃ a : ℕ → 𝒪[K], ∀ i < g.natDegree, g.coeff i = ϖ * a i := by
  choose! a ha using fun i (hi : i < g.natDegree) ↦
    Ideal.mem_span_singleton.mp (hϖ.maximalIdeal_eq ▸ hg.mem hi)
  exact ⟨a, ha⟩

variable (g π) in
/-- A **stage** of Monge's reduction (arXiv:1109.4617, p. 7): a monic Eisenstein polynomial `g` over
`𝒪[K]` with a root `π ∈ 𝒪[L]` generating `L` over `K`. -/
structure IsMongeStage : Prop where
  monic : g.Monic
  isEisensteinAt : g.IsEisensteinAt 𝓂[K]
  isRoot : (g.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot π
  adjoin_eq_top : K⟮(π : L)⟯ = ⊤

lemma isMongeStage_of_monic (htr : IsTotallyRamified K L) (hm : g.Monic)
    (hdeg : g.natDegree = TauCeti.ramificationIndex K L) (hπ : Irreducible π)
    (hroot : (g.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot π) : IsMongeStage g π := by
  have hK : K⟮algebraMap 𝒪[L] L π⟯ = ⊤ :=
    IntermediateField.adjoin_eq_top_of_algebra_adjoin_eq_top
      (htr.adjoin_eq_top_of_irreducible hπ)
  rw [Algebra.algebraMap_ofSubsemiring_apply] at hK
  exact ⟨hm, isEisensteinAt_of_isRoot_of_irreducible (by simp [hm.leadingCoeff]) hdeg hπ hroot,
    hroot, hK⟩

lemma isMongeStage_minpoly (htr : IsTotallyRamified K L) (hπ : Irreducible π) :
    IsMongeStage (minpoly 𝒪[K] π) π := by
  have hint : IsIntegral 𝒪[K] π :=
    IsIntegral.of_finite 𝒪[K] π
  refine isMongeStage_of_monic htr (minpoly.monic hint) ?_ hπ ?_
  · simpa using (htr.integralPowerBasis hπ).natDegree_minpoly
  · rw [IsRoot, eval_map, ← aeval_def, minpoly.aeval]

lemma IsMongeStage.natDegree_eq (h : IsMongeStage g π) :
    g.natDegree = TauCeti.ramificationIndex K L :=
  (ramificationIndex_eq_natDegree_of_eisenstein_adjoin_eq_top g h.isEisensteinAt π h.isRoot
    h.adjoin_eq_top).symm

lemma IsMongeStage.irreducible (h : IsMongeStage g π) : Irreducible π :=
  irreducible_of_eisenstein_adjoin_eq_top g h.isEisensteinAt π h.isRoot h.adjoin_eq_top

lemma exists_dvd_sub_of_surjective (htr : IsTotallyRamified K L) (hπ : Irreducible π) (z : 𝒪[L]) :
    ∃ θ : 𝒪[K], π ∣ algebraMap 𝒪[K] 𝒪[L] θ - z := by
  rcases (isTotallyRamified_iff_surjective_algebraMap_residueField K L).mp htr (residue 𝒪[L] z) with
    ⟨x, hx⟩
  rcases residue_surjective x with ⟨θ, rfl⟩
  refine ⟨θ, (hπ.residue_eq_zero_iff_dvd _).mp ?_⟩
  rw [map_sub, sub_eq_zero, ← hx]
  rfl

variable (I) in
/-- A digit `x` at the index `σ` is **valid** for Monge's choices `C` and the subgroups `W`
(arXiv:1109.4617, Proposition 3, p. 9): in the coefficient set of the type of `P_σ` if `σ` is an
index of the generic polynomial, and `0` otherwise. -/
def IsValidDigit (C : I.MongeChoice 𝓂[K]) (W : ℕ → AddSubgroup (𝒪[K] ⧸ 𝓂[K])) (σ : ℕ) (x : 𝒪[K]) :
    Prop :=
  (σ ∈ I.genericIndices → x ∈ (C.toSemicanonicalChoice W).coeffSet σ) ∧
    (σ ∉ I.genericIndices → x = 0)

lemma pointType_ne_D (hr₀ : r ≠ 0) : I.pointType r ≠ .D := by
  rw [pointType, ite_eq_right hr₀]
  split_ifs <;> exact nofun

lemma isUnit_of_coeff_zero_eq (hst : IsMongeStage g π) (hϖ : Irreducible ϖ) {d : 𝒪[K]}
    (hd : g.coeff 0 = ϖ * d) : IsUnit d := by
  have hpos : 0 < g.natDegree := by
    rw [hst.natDegree_eq]
    exact TauCeti.ramificationIndex_pos
  have hirr : Irreducible (g.coeff 0) :=
    hst.isEisensteinAt.irreducible_coeff_zero hpos
  rw [hd] at hirr
  exact (hirr.isUnit_or_isUnit rfl).resolve_left hϖ.not_isUnit

lemma hasDigits_one (hst : IsMongeStage g π) (hϖ : Irreducible ϖ)
    (he : g.natDegree = I.ramificationIndex) {r₀ : 𝒪[K]} (hr : ϖ ^ 2 ∣ g.coeff 0 - r₀ * ϖ) :
    I.HasDigits ϖ (fun _ ↦ r₀) 1 g := by
  have hpos : 0 < I.ramificationIndex := by
    rw [← he, hst.natDegree_eq]
    exact TauCeti.ramificationIndex_pos
  rcases exists_digits hst.isEisensteinAt hϖ with ⟨a, ha⟩
  intro i hi
  have hsum : I.digitSum ϖ (fun _ ↦ r₀) 1 = C (r₀ * ϖ) := by
    rw [digitSum, range_one, sum_singleton, Nat.zero_div, Nat.zero_mod, pow_zero, mul_one, zero_add,
      pow_one]
  rw [hsum, coeff_sub, coeff_C]
  split_ifs with hi₀
  · subst hi₀
    refine le_trans ?_ (le_nsmul_addVal_add_of_pow_dvd hϖ hr)
    exact_mod_cast (by omega : 1 + I.ramificationIndex ≤ I.ramificationIndex * 2 + 0)
  · rw [sub_zero]
    refine le_trans ?_ (le_nsmul_addVal_add_of_pow_dvd (j := 1) hϖ
      (by rw [pow_one, ha i (he ▸ hi)]; exact dvd_mul_right _ _))
    exact_mod_cast (by omega : 1 + I.ramificationIndex ≤ I.ramificationIndex * 1 + i)

variable [Fact p.Prime]

/-- **Monge's reduction, step 0** (Monge, arXiv:1109.4617, Algorithm 1, p. 7): for a totally
ramified extension `L / K` and Monge's choices `C`, there is a stage `(g₀, π₀)` with `g₀(0) ≡ r₀ ϖ`
modulo `ϖ ^ 2` for an `r₀ ∈ 𝒟`. -/
lemma exists_isMongeStage_coeff_zero [CharP 𝓀[K] p] (htr : IsTotallyRamified K L)
    (hϖ : Irreducible ϖ) (he : TauCeti.ramificationIndex K L = I.ramificationIndex)
    (C : I.MongeChoice 𝓂[K]) : ∃ (g₀ : 𝒪[K][X]) (π₀ : 𝒪[L]), IsMongeStage g₀ π₀ ∧ ∃ r₀ ∈ C.unitReps,
      ϖ ^ 2 ∣ g₀.coeff 0 - r₀ * ϖ := by
  rcases IsDiscreteValuationRing.exists_irreducible 𝒪[L] with ⟨π₁, hπ₁⟩
  have hst₁ : IsMongeStage (minpoly 𝒪[K] π₁) π₁ :=
    isMongeStage_minpoly htr hπ₁
  rcases exists_digits hst₁.isEisensteinAt hϖ with ⟨a, ha⟩
  have hpos : 0 < (minpoly 𝒪[K] π₁).natDegree := by
    rw [hst₁.natDegree_eq]
    exact TauCeti.ramificationIndex_pos
  have hdu : IsUnit (a 0) :=
    isUnit_of_coeff_zero_eq hst₁ hϖ (ha 0 hpos)
  have hfin : Finite (𝒪[K] ⧸ 𝓂[K]) :=
    inferInstanceAs (Finite 𝓀[K])
  have hc : CharP (𝒪[K] ⧸ 𝓂[K]) p :=
    inferInstanceAs (CharP 𝓀[K] p)
  have hexp : ExpChar (𝒪[K] ⧸ 𝓂[K]) p :=
    .prime Fact.out
  rcases exists_units_mul_pow_ramificationIndex_mem_unitReps C hdu with ⟨θ, r₀, hr₀, hmk⟩
  have hdeg : (minpoly 𝒪[K] π₁).natDegree = I.ramificationIndex :=
    hst₁.natDegree_eq.trans he
  have hst₀ : IsMongeStage ((minpoly 𝒪[K] π₁).scaleRoots θ) (algebraMap 𝒪[K] 𝒪[L] θ * π₁) := by
    refine isMongeStage_of_monic htr ((monic_scaleRoots_iff _).mpr hst₁.monic) ?_
      ((irreducible_isUnit_mul (θ.isUnit.map _)).mpr hπ₁) ?_
    · rw [natDegree_scaleRoots]
      exact hst₁.natDegree_eq
    · rw [IsRoot, eval_map, ← aeval_def]
      exact scaleRoots_aeval_eq_zero (minpoly.aeval _ _)
  refine ⟨_, _, hst₀, r₀, hr₀, ?_⟩
  rw [Quotient.algebraMap_eq, Quotient.mk_eq_mk_iff_sub_mem, hϖ.maximalIdeal_eq,
    Ideal.mem_span_singleton] at hmk
  rw [coeff_scaleRoots, Nat.sub_zero, ha 0 hpos, hdeg]
  rw [(by ring1 : ϖ * a 0 * (θ : 𝒪[K]) ^ I.ramificationIndex - r₀ * ϖ =
    ϖ * (a 0 * (θ : 𝒪[K]) ^ I.ramificationIndex - r₀)), pow_two]
  exact mul_dvd_mul_left _ hmk

variable [CharP 𝓀[L] p]

lemma IsMongeStage.isMongeRoot (h : IsMongeStage g π) : IsMongeRoot g π p :=
  isMongeRoot_of_isEisensteinAt h.monic h.isEisensteinAt h.isRoot h.adjoin_eq_top

/-- **The reduction step of Monge** (Monge, arXiv:1109.4617, Algorithm 2, p. 7): let `(g, π)` be a
stage whose coefficient `c` of `x ^ i` in `g - ∑_{σ < r} f_σ ϖ ^ (j + 1) x ^ i`, for `r = j e + i`,
`0 ≤ i < e`, is `ϖ ^ (j + 1) δ`, and let `t` be such that `δ - t` lies, modulo `𝔪`, in Monge's
subgroup `W_r`. Then there is a stage `(g', π')` with `π' ≡ π` modulo `π ^ 2`, such that `g` and
`g'` agree below the level `r + e`, and the corresponding digit of `g'` is `t`. -/
lemma exists_isMongeStage_of_sub_mem_mongeSubgroup (htr : IsTotallyRamified K L)
    (hst : IsMongeStage g π) (hϖ : Irreducible ϖ) (hP : I.IsRamificationPolygon g π) {T : 𝒪[K][X]}
    (hy : (g - T).coeff (r % I.ramificationIndex) = ϖ ^ (r / I.ramificationIndex + 1) * δ)
    (hmem : algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) δ - algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) t ∈
      mongeSubgroup ϖ 𝓂[K] g π r) : ∃ g' π', IsMongeStage g' π' ∧ π ^ 2 ∣ π' - π ∧
      (∀ i < I.ramificationIndex, ((r + I.ramificationIndex : ℕ) : ℕ∞) ≤
        I.ramificationIndex • addVal 𝒪[K] ((g - g').coeff i) + i) ∧
      ϖ ^ (r / I.ramificationIndex + 2) ∣ (g' - T).coeff (r % I.ramificationIndex) -
        t * ϖ ^ (r / I.ramificationIndex + 1) := by
  have h : IsMongeRoot g π p :=
    hst.isMongeRoot
  have hn : g.natDegree = I.ramificationIndex :=
    hP.natDegree_eq
  have hpos : 0 < I.ramificationIndex :=
    hn ▸ h.natDegree_pos
  have hmodlt : r % I.ramificationIndex < g.natDegree := by
    rw [hn]
    exact Nat.mod_lt r hpos
  by_cases hl : ∃ m, 1 ≤ m ∧ mongeLevel g π m = (r + g.natDegree : ℕ)
  · rcases hl with ⟨m, hm, hlevel⟩
    rcases exists_digits hst.isEisensteinAt hϖ with ⟨a, ha⟩
    have hdvdp : π ∣ (p : 𝒪[L]) := by
      refine (hst.irreducible.residue_eq_zero_iff_dvd _).mp ?_
      rw [map_natCast]
      exact CharP.cast_eq_zero 𝓀[L] p
    have hc : CharP (𝒪[L] ⧸ Ideal.span {π}) p :=
      charP_quotient h hdvdp
    have hmem' : algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) δ - algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) t ∈
        mongeImage ϖ 𝓂[K] g π r := by
      rw [← coe_mongeSubgroup h 𝓂[K] hϖ.ne_zero (ha 0 h.natDegree_pos) hm hlevel]
      exact hmem
    rcases hmem' with ⟨m', hm', hl', d, r', θ, u, hd, hr', hu, hmemπ⟩
    have hda : a 0 = d :=
      mul_left_cancel₀ hϖ.ne_zero ((ha 0 h.natDegree_pos).symm.trans hd)
    rw [hn] at hmemπ hu hl'
    have hnum : r + I.ramificationIndex = (r / I.ramificationIndex + 1) * I.ramificationIndex +
        r % I.ramificationIndex := by
      have h₁ : I.ramificationIndex * (r / I.ramificationIndex) + r % I.ramificationIndex = r :=
        Nat.div_add_mod r I.ramificationIndex
      rw [add_mul, one_mul, mul_comm]
      omega
    have hρ :
        π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ = π * (1 + π ^ m' * algebraMap 𝒪[K] 𝒪[L] θ) := by
      ring1
    have hirr : Irreducible (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ) := by
      rw [hρ, irreducible_mul_isUnit (isUnit_one_add_pow_mul _ h.irreducible hm')]
      exact h.irreducible
    have hst' : IsMongeStage (minpoly 𝒪[K] (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ))
        (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ) :=
      isMongeStage_minpoly htr hirr
    have hdeg :
        (minpoly 𝒪[K] (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ)).natDegree = g.natDegree :=
      hst'.natDegree_eq.trans hst.natDegree_eq.symm
    have hroot : aeval (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ)
        (minpoly 𝒪[K] (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ)) = 0 :=
      minpoly.aeval _ _
    have hN : mongeLevel g π m' = (r + g.natDegree : ℕ) := by
      rw [hn]
      exact hl'
    have hN' : mongeLevel g π m' = (((r / I.ramificationIndex + 1) * g.natDegree +
        r % I.ramificationIndex : ℕ) : ℕ∞) := by
      rw [hn, ← hnum]
      exact hl'
    rcases pow_dvd_sub_coeff h hst'.monic hdeg hroot hm' hN' hmodlt hϖ with ⟨δ₀, hδ₀⟩
    have hu' : (mongeShift g π m').eval (algebraMap 𝒪[K] 𝒪[L] θ) =
        π ^ ((r / I.ramificationIndex + 1) * g.natDegree + r % I.ramificationIndex) * u := by
      rw [hn, ← hnum]
      exact hu
    have hkey : π ∣ algebraMap 𝒪[K] 𝒪[L] δ₀ -
        algebraMap 𝒪[K] 𝒪[L] ((-a 0) ^ (r / I.ramificationIndex + 1)) * u :=
      dvd_digit_sub h ha hst'.monic hdeg hroot hm' hN' hmodlt hδ₀ hu'
    rw [hda] at hkey
    have hmemπ' : π ∣ algebraMap 𝒪[K] 𝒪[L] r' -
        algebraMap 𝒪[K] 𝒪[L] ((-d) ^ (r / I.ramificationIndex + 1)) * u :=
      Ideal.mem_span_singleton.mp hmemπ
    have h₁ : π ∣ algebraMap 𝒪[K] 𝒪[L] (δ₀ - r') := by
      rw [map_sub, ← sub_sub_sub_cancel_right _ _
        (algebraMap 𝒪[K] 𝒪[L] ((-d) ^ (r / I.ramificationIndex + 1)) * u)]
      exact dvd_sub hkey hmemπ'
    have h₂ : δ₀ - r' ∈ 𝓂[K] :=
      mem_maximalIdeal_of_dvd_algebraMap h.irreducible h₁
    have h₃ : r' - (δ - t) ∈ 𝓂[K] := by
      rwa [← map_sub, Quotient.algebraMap_eq, Quotient.mk_eq_mk_iff_sub_mem] at hr'
    have h₄ : ϖ ∣ δ - δ₀ - t := by
      have h₅ : -(δ₀ - r' + (r' - (δ - t))) ∈ 𝓂[K] :=
        𝓂[K].neg_mem (𝓂[K].add_mem h₂ h₃)
      rwa [(by ring1 : -(δ₀ - r' + (r' - (δ - t))) = δ - δ₀ - t), hϖ.maximalIdeal_eq,
        Ideal.mem_span_singleton] at h₅
    refine ⟨_, _, hst', ?_, fun i hi ↦ ?_, ?_⟩
    · rw [add_sub_cancel_left]
      exact (pow_dvd_pow π (by omega)).mul_right _
    · have hdvd : π ^ (r + g.natDegree) ∣ algebraMap 𝒪[K] 𝒪[L] (g.coeff i -
          (minpoly 𝒪[K] (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ)).coeff i) * π ^ i :=
        pow_dvd_sub_coeff_mul_pow h hst'.monic hdeg hroot hm' (by exact_mod_cast hN) (hn ▸ hi)
      rw [pow_dvd_iff_le_addVal h.irreducible, addVal_algebraMap_mul_pow h, hn] at hdvd
      rw [coeff_sub]
      exact hdvd
    · have heq : (minpoly 𝒪[K] (π + π ^ (m' + 1) * algebraMap 𝒪[K] 𝒪[L] θ) - T).coeff
          (r % I.ramificationIndex) - t * ϖ ^ (r / I.ramificationIndex + 1) =
          ϖ ^ (r / I.ramificationIndex + 1) * (δ - δ₀ - t) := by
        rw [coeff_sub] at hy ⊢
        linear_combination hy - hδ₀
      rw [heq, pow_succ]
      exact mul_dvd_mul_left _ h₄
  · have hbot : mongeSubgroup ϖ 𝓂[K] g π r = ⊥ :=
      mongeSubgroup_eq_bot ϖ 𝓂[K] g π fun k hk hlk ↦ hl ⟨k, hk, hlk⟩
    rw [hbot, AddSubgroup.mem_bot, ← map_sub, Quotient.algebraMap_eq, Quotient.eq_zero_iff_mem,
      hϖ.maximalIdeal_eq, Ideal.mem_span_singleton] at hmem
    refine ⟨g, π, hst, ?_, fun i _ ↦ ?_, ?_⟩
    · rw [sub_self]
      exact dvd_zero _
    · rw [sub_self, coeff_zero, addVal_zero, nsmul_eq_mul,
        ENat.mul_top (by exact_mod_cast hpos.ne'), top_add]
      exact le_top
    · rw [hy, (by ring1 : ϖ ^ (r / I.ramificationIndex + 1) * δ -
        t * ϖ ^ (r / I.ramificationIndex + 1) = ϖ ^ (r / I.ramificationIndex + 1) * (δ - t)),
        pow_succ]
      exact mul_dvd_mul_left _ hmem

lemma exists_dvd_pow_sub (hπ : Irreducible π) (a : ℕ) (z : 𝒪[L]) :
    ∃ w : 𝒪[L], π ∣ w ^ p ^ a - z := by
  have hexp : ExpChar 𝓀[L] p :=
    .prime Fact.out
  rcases (PerfectRing.bijective_frobenius (p := p ^ a)).2 (residue 𝒪[L] z) with ⟨y, hy⟩
  rcases residue_surjective y with ⟨w, rfl⟩
  have hy' : residue 𝒪[L] w ^ p ^ a = residue 𝒪[L] z :=
    hy
  refine ⟨w, (hπ.residue_eq_zero_iff_dvd _).mp ?_⟩
  rw [map_sub, map_pow, hy', sub_self]

/-- **The digit at a `C`-point**: for a stage `(g, π)` whose ramification polygon is that of `I`,
and a `C`-point `P_r`, `r > 0`, with `r / e` not a Swan slope, Monge's subgroup `W_r` is the whole
residue field (Monge, arXiv:1109.4617, p. 6, p. 8 and Proposition 3): `r + e` is the level of an
integer `m ≥ 1` which is not a ramification break, and `S_m` is surjective. -/
lemma mem_mongeSubgroup_of_pointType_eq_C (htr : IsTotallyRamified K L) (hst : IsMongeStage g π)
    (hϖ : Irreducible ϖ) (he₀ : addVal 𝒪[K] (p : 𝒪[K]) = e₀) (hP : I.IsRamificationPolygon g π)
    (hr₀ : r ≠ 0) (hC : I.pointType r = .C)
    (hnc : ∀ j ∈ Icc 1 I.w, (r : ℚ) / I.ramificationIndex ≠ I.swanSlope j) (x : 𝒪[K] ⧸ 𝓂[K]) :
    x ∈ mongeSubgroup ϖ 𝓂[K] g π r := by
  have h : IsMongeRoot g π p :=
    hst.isMongeRoot
  have hn : g.natDegree = I.ramificationIndex :=
    hP.natDegree_eq
  rcases exists_segment_of_pointType_eq_C he₀ h hP hr₀ hC hnc with ⟨k, m, hk, hv, hm, h₁, h₂, hσ⟩
  have hN : ((r + I.ramificationIndex : ℕ) : ℚ) = I.polygonLine k m + I.ramificationIndex := by
    push_cast
    rw [hσ]
  rcases exists_digits hst.isEisensteinAt hϖ with ⟨a, ha⟩
  have hd : g.coeff 0 = ϖ * a 0 :=
    ha 0 h.natDegree_pos
  have hdu : IsUnit (algebraMap 𝒪[K] 𝒪[L] (a 0)) :=
    (isUnit_of_coeff_zero_eq hst hϖ hd).map _
  rcases exists_coeff_mongeShift_eq h hP hk hv hN with ⟨c, hc, hcoeff⟩
  refine AddSubgroup.subset_closure (mem_mongeImage_of_forall_pow_succ_dvd (a := I.w - k) 𝓂[K] hd
    hdu hm ?_ hc ?_ ?_ (exists_dvd_sub_of_surjective htr h.irreducible)
    (exists_dvd_pow_sub h.irreducible _) x)
  · rw [hn]
    exact mongeLevel_eq_of_mem_segment h hP hk hv h₁.le (fun hlt ↦ (h₂ hlt).le) hN
  · rw [hn]
    exact hcoeff
  · rw [hn]
    exact fun s hs ↦ pow_succ_dvd_coeff_mongeShift_of_ne h hP hk h₁ h₂ hN hs

/-- **The choice of the digit** (Monge, arXiv:1109.4617, Proposition 3 and Remark 1): for a stage
`(g, π)` whose ramification polygon is that of `I`, with valid digits below `r ≥ 1`, and for the
digit `δ` of `g` at `r`, there is a valid digit `t` at `r` with `δ - t ∈ W_r`. The digit `δ` is `0`
at a `Z`-point and not `0` at an `A`-point; at a `C`-point, `t` represents `δ` modulo `W_r`. -/
lemma exists_isValidDigit (htr : IsTotallyRamified K L) (hst : IsMongeStage g π)
    (hϖ : Irreducible ϖ) (he₀ : addVal 𝒪[K] (p : 𝒪[K]) = e₀) (hP : I.IsRamificationPolygon g π)
    (C : I.MongeChoice 𝓂[K]) (hr₀ : r ≠ 0) (hf : ∀ σ < r, σ ∉ I.genericIndices → f σ = 0)
    (hy : (g - I.digitSum ϖ f r).coeff (r % I.ramificationIndex) =
      ϖ ^ (r / I.ramificationIndex + 1) * δ) : ∃ t,
      IsValidDigit I C (mongeSubgroup ϖ 𝓂[K] g π) r t ∧ algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) δ -
        algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) t ∈ mongeSubgroup ϖ 𝓂[K] g π r := by
  have h : IsMongeRoot g π p :=
    hst.isMongeRoot
  rcases hT : I.pointType r with _ | _ | _ | _ | _
  · exact absurd hT (pointType_ne_D hr₀)
  · have hm : (r : ℚ) / I.ramificationIndex = I.mean (I.pointIndex (r % I.ramificationIndex)) :=
      div_eq_mean_of_pointType_eq_A hT
    have hval : addVal 𝒪[K] (g.coeff (r % I.ramificationIndex)) =
        ((r / I.ramificationIndex + 1 : ℕ) : ℕ∞) :=
      addVal_coeff_eq_of_pointType_eq_A he₀ h hP hT
    rw [coeff_sub, coeff_digitSum_eq_zero_of_le_mean hf hr₀ hm.le, sub_zero] at hy
    rw [hy, addVal_mul, addVal_pow, addVal_uniformizer hϖ, nsmul_one] at hval
    have hunit : IsUnit δ := by
      refine addVal_eq_zero_iff.mp ?_
      simpa using hval
    rcases C.existsUnique_mem_reps (algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) δ) with ⟨t, ⟨ht, hmk⟩, -⟩
    have hδ₀ : algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) δ ≠ 0 := by
      rw [Quotient.algebraMap_eq, Ne, Quotient.eq_zero_iff_mem]
      exact fun hmem ↦ hmem hunit
    refine ⟨t, ⟨fun _ ↦ ?_, fun hg ↦ absurd (mem_genericIndices_of_pointType (.inl hT)) hg⟩, ?_⟩
    · simp only [SemicanonicalChoice.coeffSet, hT]
      refine ⟨ht, fun h₀ ↦ hδ₀ ?_⟩
      rw [← hmk, Set.mem_singleton_iff.mp h₀, map_zero]
    · rw [hmk, sub_self]
      exact zero_mem _
  · rcases C.existsUnique_mem_reps (algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) δ) with ⟨t, ⟨ht, hmk⟩, -⟩
    refine ⟨t, ⟨fun _ ↦ ?_, fun hg ↦ absurd (mem_genericIndices_of_pointType (.inr hT)) hg⟩, ?_⟩
    · simp only [SemicanonicalChoice.coeffSet, hT]
      exact ht
    · rw [hmk, sub_self]
      exact zero_mem _
  · by_cases hnc : ∀ j ∈ Icc 1 I.w, (r : ℚ) / I.ramificationIndex ≠ I.swanSlope j
    · refine ⟨0, ⟨fun hg ↦ ?_, fun _ ↦ rfl⟩, ?_⟩
      · exfalso
        rcases (mem_filter.mp hg).2 with h₁ | h₁ | h₁ | ⟨-, h₁⟩
        · rw [hT] at h₁
          cases h₁
        · rw [hT] at h₁
          cases h₁
        · rw [hT] at h₁
          cases h₁
        · rcases mem_image.mp h₁ with ⟨j, hj, hs⟩
          exact hnc j hj hs.symm
      · rw [map_zero, sub_zero]
        exact mem_mongeSubgroup_of_pointType_eq_C htr hst hϖ he₀ hP hr₀ hT hnc _
    · push Not at hnc
      rcases hnc with ⟨j, hj, hs⟩
      rcases C.existsUnique_mem_cosetReps (mongeSubgroup ϖ 𝓂[K] g π r)
        (algebraMap 𝒪[K] (𝒪[K] ⧸ 𝓂[K]) δ) with ⟨t, ⟨ht, hmk⟩, -⟩
      have hmem : r ∈ I.genericIndices := by
        refine mem_filter.mpr ⟨mem_range_floor_of_div_le ?_, .inr (.inr (.inr ⟨hT, ?_⟩))⟩
        · rw [hs]
          exact swanSlope_mono (mem_Icc.mp hj).2
        · exact mem_image.mpr ⟨j, hj, hs.symm⟩
      refine ⟨t, ⟨fun _ ↦ ?_, fun hg ↦ absurd hmem hg⟩, ?_⟩
      · simp only [SemicanonicalChoice.coeffSet, hT]
        exact ht
      · rw [← neg_sub]
        exact neg_mem hmk
  · have hlt : (r : ℚ) / I.ramificationIndex <
        I.mean (I.pointIndex (r % I.ramificationIndex)) := by
      rw [pointType] at hT
      split_ifs at hT with h₁ h₂
      exact h₂
    have hval : ((r / I.ramificationIndex + 1 : ℕ) : ℕ∞) <
        addVal 𝒪[K] (g.coeff (r % I.ramificationIndex)) :=
      lt_addVal_coeff_of_pointType_eq_Z he₀ h hP hT
    rw [coeff_sub, coeff_digitSum_eq_zero_of_le_mean hf hr₀ hlt.le, sub_zero] at hy
    refine ⟨0, ⟨fun hg ↦ absurd hg (notMem_genericIndices_of_pointType_eq_Z hT), fun _ ↦ rfl⟩, ?_⟩
    have hdvd : ϖ ^ (r / I.ramificationIndex + 1 + 1) ∣ ϖ ^ (r / I.ramificationIndex + 1) * δ := by
      rw [← hy, pow_dvd_iff_le_addVal hϖ]
      exact_mod_cast Order.add_one_le_of_lt hval
    rw [pow_succ _ (r / I.ramificationIndex + 1),
      mul_dvd_mul_iff_left (pow_ne_zero _ hϖ.ne_zero)] at hdvd
    have hmem : δ ∈ 𝓂[K] := by
      rw [hϖ.maximalIdeal_eq, Ideal.mem_span_singleton]
      exact hdvd
    rw [map_zero, sub_zero, Quotient.algebraMap_eq, Quotient.eq_zero_iff_mem.mpr hmem]
    exact zero_mem _

variable (r) in
/-- **The reduction loop** (Monge, arXiv:1109.4617, Algorithms 1 and 2, p. 7, and the discussion in
§2.3): starting from a stage `(g₀, π₀)` with a valid digit at `0`, Monge's reduction produces, for
all `r`, a stage `(g, π)`, `π ≡ π₀` modulo `π₀ ^ 2`, with valid digits `f_σ`, `σ ≤ r`. -/
lemma exists_isMongeStage_hasDigits (htr : IsTotallyRamified K L)
    (hub : ∀ {g : 𝒪[K][X]} {π : 𝒪[L]}, IsMongeStage g π → I.IsRamificationPolygon g π)
    (hϖ : Irreducible ϖ) (he₀ : addVal 𝒪[K] (p : 𝒪[K]) = e₀) (C : I.MongeChoice 𝓂[K]) {g₀ : 𝒪[K][X]}
    {π₀ : 𝒪[L]} {f₀ : ℕ → 𝒪[K]} {W : ℕ → AddSubgroup (𝒪[K] ⧸ 𝓂[K])}
    (hinv : ∀ {g : 𝒪[K][X]} {π : 𝒪[L]}, IsMongeStage g π → π₀ ^ 2 ∣ π - π₀ →
      mongeSubgroup ϖ 𝓂[K] g π = W) (hst₀ : IsMongeStage g₀ π₀) (hv₀ : IsValidDigit I C W 0 (f₀ 0))
    (hd₀ : I.HasDigits ϖ f₀ 1 g₀) : ∃ g π f, IsMongeStage g π ∧ π₀ ^ 2 ∣ π - π₀ ∧
      (∀ σ < r + 1, IsValidDigit I C W σ (f σ)) ∧ I.HasDigits ϖ f (r + 1) g := by
  induction r with
  | zero =>
    refine ⟨g₀, π₀, f₀, hst₀, ?_, fun σ hσ ↦ ?_, hd₀⟩
    · rw [sub_self]
      exact dvd_zero _
    · rwa [Nat.lt_one_iff.mp hσ]
  | succ r ih =>
    rcases ih with ⟨g, π, f, hst, hπ₀, hvalid, hdig⟩
    have hW : mongeSubgroup ϖ 𝓂[K] g π = W :=
      hinv hst hπ₀
    rcases hdig.pow_dvd_coeff hϖ with ⟨δ, hδ⟩
    rcases exists_isValidDigit htr hst hϖ he₀ (hub hst) C (Nat.succ_ne_zero r)
      (fun σ hσ ↦ (hvalid σ hσ).2) hδ with ⟨t, htv, htm⟩
    rw [hW] at htv htm
    rcases exists_isMongeStage_of_sub_mem_mongeSubgroup htr hst hϖ (hub hst) hδ
      (by rw [hW]; exact htm) with ⟨g', π', hst', hππ', hd, ht⟩
    refine ⟨g', π', Function.update f (r + 1) t, hst', ?_, fun σ hσ ↦ ?_, hdig.succ hϖ hd ht⟩
    · have hsub : π' - π₀ = (π' - π) + (π - π₀) := by
        ring1
      rw [hsub]
      exact dvd_add ((pow_dvd_pow_of_dvd (dvd_of_pow_two_dvd_sub hπ₀) 2).trans hππ') hπ₀
    · rcases (Nat.lt_succ_iff.mp hσ).lt_or_eq with hlt | rfl
      · rw [Function.update_of_ne hlt.ne]
        exact hvalid σ hlt
      · rwa [Function.update_self]

/-- **The truncation of a polynomial above the top break** (Monge, arXiv:1109.4617, Remark 1, p. 7):
let `(g, π)` be a stage whose ramification polygon is that of `I`, and `m₀ > r_w`, so that
`N = e m_w + m₀ + e` is the level of `g` at `m₀` and `S_{m₀}` is linear. Every polynomial `q` with
`π ^ (N + 1) ∣ (q - g)_i π ^ i` for all `i` has a root `π + π ^ (m₀ + 1) Y₀` in `𝒪[L]`. Monge
recovers this criterion of Krasner from the reduction steps above `r_w`; here it is Hensel's lemma
for the polynomial `π ^ (-N) q(π + π ^ (m₀ + 1) T)`, with a simple root modulo `π` at `T = 0`. -/
lemma exists_root_of_pow_dvd (hst : IsMongeStage g π) (hP : I.IsRamificationPolygon g π) {m₀ N : ℕ}
    (hm₀ : I.ram I.w < m₀) (hN : (N : ℚ) = I.polygonLine I.w m₀ + I.ramificationIndex) {q : 𝒪[K][X]}
    (hq : ∀ i, π ^ (N + 1) ∣ algebraMap 𝒪[K] 𝒪[L] ((q - g).coeff i) * π ^ i) :
    ∃ Y₀ : 𝒪[L], aeval (π + π ^ (m₀ + 1) * Y₀) q = 0 := by
  have h : IsMongeRoot g π p :=
    hst.isMongeRoot
  have hπ : Irreducible π :=
    h.irreducible
  have hv : I.IsVertex I.w :=
    .inl rfl
  rcases exists_coeff_mongeShift_eq h hP le_rfl hv hN with ⟨c, hc, hcoeff⟩
  rw [Nat.sub_self, pow_zero] at hcoeff
  have hne : ∀ s, s ≠ 1 → π ^ (N + 1) ∣ (mongeShift g π m₀).coeff s := fun s hs ↦
    pow_succ_dvd_coeff_mongeShift_of_ne h hP le_rfl hm₀ (fun hlt ↦ absurd hlt (lt_irrefl _)) hN
      (by rwa [Nat.sub_self, pow_zero])
  have hE :
      C (π ^ (N + 1)) ∣ ((q - g).map (algebraMap 𝒪[K] 𝒪[L])).comp (C π + C (π ^ (m₀ + 1)) * X) :=
    C_pow_dvd_comp_of_forall_pow_dvd hq
  have hshift : mongeShift q π m₀ = mongeShift g π m₀ +
      ((q - g).map (algebraMap 𝒪[K] 𝒪[L])).comp (C π + C (π ^ (m₀ + 1)) * X) := by
    rw [mongeShift, mongeShift, ← add_comp, ← Polynomial.map_add, add_sub_cancel]
  generalize ((q - g).map (algebraMap 𝒪[K] 𝒪[L])).comp (C π + C (π ^ (m₀ + 1)) * X) = E at hE hshift
  have hE' (s : ℕ) : π ^ (N + 1) ∣ E.coeff s :=
    (C_dvd_iff_dvd_coeff _ _).mp hE s
  have hdvd : C (π ^ N) ∣ mongeShift q π m₀ := by
    refine (C_dvd_iff_dvd_coeff _ _).mpr fun s ↦ ?_
    rw [hshift, coeff_add]
    refine dvd_add ?_ ((pow_dvd_pow π N.le_succ).trans (hE' s))
    rcases eq_or_ne s 1 with rfl | hs
    · rw [hcoeff]
      exact dvd_mul_right _ _
    · exact (pow_dvd_pow π N.le_succ).trans (hne s hs)
  rcases hdvd with ⟨H, hH⟩
  have hpN : π ^ N ≠ 0 :=
    pow_ne_zero N hπ.ne_zero
  have hH₀ : H.coeff 0 ∈ IsLocalRing.maximalIdeal 𝒪[L] := by
    rw [hπ.maximalIdeal_eq, Ideal.mem_span_singleton]
    have h₁ : π ^ N * H.coeff 0 = E.coeff 0 := by
      have h₂ : (mongeShift q π m₀).coeff 0 = (C (π ^ N) * H).coeff 0 :=
        congrArg (fun P ↦ coeff P 0) hH
      simp only [coeff_C_mul, hshift, coeff_add, coeff_mongeShift_zero h, zero_add] at h₂
      exact h₂.symm
    have h₂ : π ^ (N + 1) ∣ E.coeff 0 :=
      hE' 0
    rw [← h₁, pow_succ, mul_dvd_mul_iff_left hpN] at h₂
    exact h₂
  have hH₁ : IsUnit (H.coeff 1) := by
    rcases hE' 1 with ⟨t, ht⟩
    have h₁ : H.coeff 1 = c + π * t := by
      have h₂ : (mongeShift q π m₀).coeff 1 = (C (π ^ N) * H).coeff 1 :=
        congrArg (fun P ↦ coeff P 1) hH
      simp only [coeff_C_mul, hshift, coeff_add, hcoeff, ht] at h₂
      refine mul_left_cancel₀ hpN ?_
      rw [← h₂, pow_succ]
      ring1
    exact h₁ ▸ isUnit_add_mul hπ hc t
  rcases HenselianLocalRing.exists_isRoot_sub_mem_maximalIdeal H
    (by rwa [← coeff_zero_eq_eval_zero]) (by
      rw [← coeff_zero_eq_eval_zero, coeff_derivative]
      simpa using hH₁) with ⟨Y₀, hY₀, -⟩
  refine ⟨Y₀, ?_⟩
  rw [← eval_mongeShift, hH, eval_mul, hY₀.eq_zero, mul_zero]

/-- **The first statement of Monge's Theorem 1, with Proposition 3 and Remark 1, in the form of the
knowl** (Monge, arXiv:1109.4617, p. 11; LMFDB `lf.family_polynomial`): let `L / K` be a totally
ramified extension, all of whose stages have the ramification polygon of `I`, with Monge's subgroups
invariant under `π ↦ π + O(π ^ 2)`. For a uniformiser `ϖ` of `K` and Monge's choices `C`, `L` is
generated over `K` by a root in `𝒪[L]` of a semicanonical polynomial. -/
lemma exists_mem_mongeSemicanonicalPolynomials [CharP 𝓀[K] p] (htr : IsTotallyRamified K L)
    (hub : ∀ {g : 𝒪[K][X]} {π : 𝒪[L]}, IsMongeStage g π → I.IsRamificationPolygon g π)
    (hinv : ∀ {g g' : 𝒪[K][X]} {π π' : 𝒪[L]}, IsMongeStage g π → IsMongeStage g' π' →
      π ^ 2 ∣ π' - π → mongeSubgroup ϖ 𝓂[K] g' π' = mongeSubgroup ϖ 𝓂[K] g π) (hϖ : Irreducible ϖ)
    (he₀ : addVal 𝒪[K] (p : 𝒪[K]) = e₀) (he : TauCeti.ramificationIndex K L = I.ramificationIndex)
    (C : I.MongeChoice 𝓂[K]) :
    ∃ y : 𝒪[L], K⟮(y : L)⟯ = ⊤ ∧ (I.mongeSemicanonicalPolynomials ϖ y C).Nonempty := by
  rcases exists_isMongeStage_coeff_zero htr hϖ he C with ⟨g₀, π₀, hst₀, r₀, hr₀, hc₀⟩
  have hinv' {g : 𝒪[K][X]} {π : 𝒪[L]} (hst : IsMongeStage g π) (hdvd : π₀ ^ 2 ∣ π - π₀) :
      mongeSubgroup ϖ 𝓂[K] g π = mongeSubgroup ϖ 𝓂[K] g₀ π₀ :=
    hinv hst₀ hst hdvd
  have hv₀ : IsValidDigit I C (mongeSubgroup ϖ 𝓂[K] g₀ π₀) 0 ((fun _ ↦ r₀ : ℕ → 𝒪[K]) 0) :=
    ⟨fun _ ↦ by
      rw [SemicanonicalChoice.coeffSet_zero]
      exact hr₀, fun hn ↦ absurd I.zero_mem_genericIndices hn⟩
  have hd₀ : I.HasDigits ϖ (fun _ ↦ r₀) 1 g₀ :=
    hasDigits_one hst₀ hϖ (hst₀.natDegree_eq.trans he) hc₀
  have h₀ : IsMongeRoot g₀ π₀ p :=
    hst₀.isMongeRoot
  rcases exists_natCast_eq_mul_mean he₀ h₀ (hub hst₀) le_rfl (.inl rfl) with ⟨σw, hσw, -⟩
  have hm₀ : I.ram I.w < (⌈I.ram I.w⌉₊ + 1 : ℕ) := by
    push_cast
    exact (Nat.le_ceil _).trans_lt (lt_add_one _)
  generalize ⌈I.ram I.w⌉₊ + 1 = m₀ at hm₀
  have hm₁ : 1 ≤ m₀ := by
    have h₁ : (0 : ℚ) < m₀ :=
      (I.ram_nonneg _).trans_lt hm₀
    exact Nat.one_le_iff_ne_zero.mpr fun h₂ ↦ by simp [h₂] at h₁
  rcases exists_isMongeStage_hasDigits (σw + m₀) htr hub hϖ he₀ C hinv' hst₀ hv₀ hd₀ with
    ⟨g, π, f, hst, hπ₀, hvalid, hdig⟩
  have hP : I.IsRamificationPolygon g π :=
    hub hst
  have h : IsMongeRoot g π p :=
    hst.isMongeRoot
  have hn : g.natDegree = I.ramificationIndex :=
    hP.natDegree_eq
  have hline : I.polygonLine I.w m₀ = σw + m₀ := by
    rw [polygonLine, Nat.sub_self, pow_zero, one_mul, hσw]
  have hN :
      ((σw + m₀ + I.ramificationIndex : ℕ) : ℚ) = I.polygonLine I.w m₀ + I.ramificationIndex := by
    rw [hline]
    push_cast
    rfl
  have hgen : I.genericIndices ⊆ range (σw + m₀ + 1) := by
    intro σ hσ
    have hlt : σ < ⌊(I.ramificationIndex : ℚ) * I.swanSlope I.w⌋₊ + 1 :=
      mem_range.mp (mem_filter.mp hσ).1
    refine mem_range.mpr (lt_of_lt_of_le hlt (Nat.succ_le_succ ?_))
    have hs : (I.ramificationIndex : ℚ) * I.swanSlope I.w = σw + I.ram I.w := by
      rw [I.mul_swanSlope_eq le_rfl, polygonLine, Nat.sub_self, pow_zero, one_mul, ← hσw]
    have h₁ : (⌊(I.ramificationIndex : ℚ) * I.swanSlope I.w⌋₊ : ℚ) ≤ σw + m₀ := by
      refine (Nat.floor_le ?_).trans ?_
      · rw [hs]
        exact add_nonneg (Nat.cast_nonneg _) (I.ram_nonneg _)
      · rw [hs]
        exact add_le_add le_rfl hm₀.le
    exact_mod_cast h₁
  have hf : ∀ σ < σw + m₀ + 1, σ ∉ I.genericIndices → f σ = 0 :=
    fun σ hσ ↦ (hvalid σ hσ).2
  have hq : I.specialisation ϖ f = X ^ I.ramificationIndex + I.digitSum ϖ f (σw + m₀ + 1) :=
    specialisation_eq_add_digitSum hgen hf
  have hmonic : (I.specialisation ϖ f).Monic :=
    monic_specialisation ϖ f
  have hdegq : (I.specialisation ϖ f).natDegree = I.ramificationIndex :=
    natDegree_specialisation ϖ f
  have hq' (i : ℕ) : π ^ (σw + m₀ + I.ramificationIndex + 1) ∣
      algebraMap 𝒪[K] 𝒪[L] ((I.specialisation ϖ f - g).coeff i) * π ^ i := by
    rcases lt_or_ge i I.ramificationIndex with hi | hi
    · have h₂ : (I.specialisation ϖ f - g).coeff i =
          -(g - I.digitSum ϖ f (σw + m₀ + 1)).coeff i := by
        rw [hq]
        simp only [coeff_sub, coeff_add, coeff_X_pow, ite_eq_right hi.ne]
        ring1
      rw [pow_dvd_iff_le_addVal h.irreducible, addVal_algebraMap_mul_pow h, h₂,
        AddValuation.map_neg, hn, Nat.add_right_comm (σw + m₀) I.ramificationIndex 1]
      exact hdig i hi
    · have h₁ : (I.specialisation ϖ f - g).coeff i = 0 := by
        rw [coeff_sub, sub_eq_zero]
        rcases hi.lt_or_eq with hi | rfl
        · rw [coeff_eq_zero_of_natDegree_lt (by omega), coeff_eq_zero_of_natDegree_lt (by omega)]
        · have h₂ : (I.specialisation ϖ f).coeff (I.specialisation ϖ f).natDegree = 1 :=
            hmonic.coeff_natDegree
          have h₃ : g.coeff g.natDegree = 1 :=
            hst.monic.coeff_natDegree
          rw [hdegq] at h₂
          rw [hn] at h₃
          rw [h₂, h₃]
      rw [h₁, map_zero, zero_mul]
      exact dvd_zero _
  rcases exists_root_of_pow_dvd hst hP hm₀ hN hq' with ⟨Y₀, hY₀⟩
  have hρ : π + π ^ (m₀ + 1) * Y₀ = π * (1 + π ^ m₀ * Y₀) := by
    ring1
  have hα : Irreducible (π + π ^ (m₀ + 1) * Y₀) := by
    rw [hρ, irreducible_mul_isUnit (isUnit_one_add_pow_mul Y₀ h.irreducible hm₁)]
    exact h.irreducible
  have hstq : IsMongeStage (I.specialisation ϖ f) (π + π ^ (m₀ + 1) * Y₀) := by
    refine isMongeStage_of_monic htr hmonic (hdegq.trans he.symm) hα ?_
    rw [IsRoot, eval_map, ← aeval_def]
    exact hY₀
  have hdvd : π₀ ^ 2 ∣ π + π ^ (m₀ + 1) * Y₀ - π₀ := by
    have hsub : π + π ^ (m₀ + 1) * Y₀ - π₀ = π ^ (m₀ + 1) * Y₀ + (π - π₀) := by
      ring1
    rw [hsub]
    exact dvd_add (((pow_dvd_pow_of_dvd (dvd_of_pow_two_dvd_sub hπ₀) 2).trans
      (pow_dvd_pow π (by omega))).mul_right _) hπ₀
  have hW : mongeSubgroup ϖ 𝓂[K] (I.specialisation ϖ f) (π + π ^ (m₀ + 1) * Y₀) =
      mongeSubgroup ϖ 𝓂[K] g₀ π₀ :=
    hinv' hstq hdvd
  refine ⟨_, hstq.adjoin_eq_top, I.specialisation ϖ f, hY₀, f, fun σ hσ ↦ ?_, rfl⟩
  rw [hW]
  exact (hvalid σ (mem_range.mp (hgen hσ))).1 hσ

end IsNonarchimedeanLocalField.HerbrandInvariant
