import LeanBridge.ForMathlib.NumberTheory.LocalField.GaloisMeanSlope
import TauCeti.NumberTheory.LocalField.Padic

/-!
# The Galois mean slope of a Galois extension of `ℚ_p`

Let `L` be a finite Galois extension of `ℚ_p`, of degree `n`. Its Galois mean slope (LMFDB
`lf.galois_mean_slope`) is the nonnegative rational number `α` such that the discriminant ideal of
`L / ℚ_p` is `(p ^ (n α))`. LeanBridge defines it as `α = δ / n` for the discriminant exponent `δ`
(`IsNonarchimedeanLocalField.galoisMeanSlope`, over any nonarchimedean local field), and Tau Ceti
proves that the discriminant ideal is `𝓂 ^ δ`. Over `ℚ_p` the maximal ideal of the ring of
integers is `(p)`, since `p` is a uniformizer, so the discriminant ideal is `(p ^ δ)`, and `n α` is
the only natural number `m` with discriminant ideal `(p ^ m)`.

## Main results

* `IsNonarchimedeanLocalField.discriminantIdeal_eq_span_natCast_pow`: the discriminant ideal of a
  finite Galois extension `L / ℚ_p` is `(p ^ δ)`.
* `IsNonarchimedeanLocalField.discriminantIdeal_eq_span_natCast_pow_iff` (LMFDB
  `lf.galois_mean_slope`): for `m : ℕ`, the discriminant ideal is `(p ^ m)` exactly when
  `m = [L : ℚ_p] α`.
-/

open Module ValuativeRel TauCeti

namespace IsNonarchimedeanLocalField

variable (p : ℕ) [Fact p.Prime] (L : Type*) [Field L] [ValuativeRel L] [TopologicalSpace L]
  [IsNonarchimedeanLocalField L] [Algebra ℚ_[p] L] [ValuativeExtension ℚ_[p] L] [IsGalois ℚ_[p] L]

/-- **The discriminant ideal of a Galois extension of `ℚ_p` is `(p ^ δ)`**: the maximal ideal of
the ring of integers of `ℚ_p` is generated by the uniformizer `p`. -/
lemma discriminantIdeal_eq_span_natCast_pow :
    discriminantIdeal ℚ_[p] L = Ideal.span {(p : 𝒪[ℚ_[p]]) ^ discriminantExponent ℚ_[p] L} := by
  rw [discriminantIdeal_eq_maximalIdeal_pow, (Padic.irreducible_natCast_self p).maximalIdeal_eq,
    Ideal.span_singleton_pow]

variable {L} in
/-- **The Galois mean slope of a Galois extension of `ℚ_p`** (LMFDB `lf.galois_mean_slope`): for a
natural number `m`, the discriminant ideal of `L / ℚ_p` is `(p ^ m)` exactly when
`m = [L : ℚ_p] α`, for the Galois mean slope `α`. So `α` is the nonnegative rational number
(`IsNonarchimedeanLocalField.galoisMeanSlope_nonneg`) such that the discriminant ideal is
`(p ^ ([L : ℚ_p] α))`. -/
lemma discriminantIdeal_eq_span_natCast_pow_iff {m : ℕ} : discriminantIdeal ℚ_[p] L =
    Ideal.span {(p : 𝒪[ℚ_[p]]) ^ m} ↔ (m : ℚ) = finrank ℚ_[p] L * galoisMeanSlope ℚ_[p] L := by
  have : Module.Finite ℚ_[p] L := finite_of_valuativeExtension ℚ_[p] L
  have hp : Irreducible (p : 𝒪[ℚ_[p]]) := Padic.irreducible_natCast_self p
  rw [finrank_mul_galoisMeanSlope, Nat.cast_inj, discriminantIdeal_eq_span_natCast_pow,
    Ideal.span_singleton_eq_span_singleton]
  refine ⟨fun h ↦ le_antisymm ?_ ?_, fun h ↦ h ▸ Associated.refl _⟩
  · exact (pow_dvd_pow_iff hp.ne_zero hp.not_isUnit).mp h.symm.dvd
  · exact (pow_dvd_pow_iff hp.ne_zero hp.not_isUnit).mp h.dvd

end IsNonarchimedeanLocalField
