/-!
# The quadratic extensions of `ℚ_p`

The quadratic extensions of `ℚ_p`, listed in LMFDB `lf.discriminant_root_field`, inside any
extension `Ω` of `ℚ_p` that contains the square roots involved:

* for an odd prime `p` and a `p`-adic integer `u` that is not a square modulo `p`, they are the
  three distinct fields `ℚ_p(√u)`, `ℚ_p(√p)`, `ℚ_p(√(pu))`, and `ℚ_p(√u)` is the unramified
  quadratic extension;
* for `p = 2` and a `2`-adic integer `u ≡ 5 mod 8`, they are the seven distinct fields `ℚ_2(√u)`,
  `ℚ_2(√-1)`, `ℚ_2(√-u)`, `ℚ_2(√2)`, `ℚ_2(√(2u))`, `ℚ_2(√-2)`, `ℚ_2(√(-2u))`, and `ℚ_2(√u)` is the
  unramified quadratic extension.

Away from characteristic `2`, a quadratic intermediate field is `F(√a)` for a nonsquare `a`, and
`F(√a) = F(√b)` exactly when `ab` is a square (Tau Ceti's quadratic Kummer theory, completed here by
the converse). So the quadratic extensions correspond to the nontrivial square classes, given by
`u, p, pu` for odd `p` (Tau Ceti's `TauCeti.exists_isSquare_mul_of_isUnit_two`) and, for `p = 2`, by
`-1, ±5, ±2, ±10`, which with `1` represent each square class of `ℚ_2` exactly once (Tau Ceti's
`TauCeti.squareClass_padicTwoSquareClassRep_bijective`). The unramified quadratic extension is Tau
Ceti's `TauCeti.unramifiedExtension ℚ_[p] Ω 2`, the unique unramified intermediate field of degree
`2` when `Ω` is separably closed: the square roots of a unit are unramified for odd `p`, and
`ℚ_2(√u) = ℚ_2(√-3)` is generated by a primitive cube root of unity.

Tau Ceti's main, not at the pin, determines the totally ramified quadratic extensions of `ℚ_p`
(`TauCeti.Padic.totallyRamifiedOfDegree_two_eq`, `TauCeti.totallyRamifiedOfDegree_two_eq_padicTwo`)
but neither the complete lists nor the unramified one. The short private helper turning a square
class into an inclusion of simple extensions is on main as
`TauCeti.IntermediateField.mem_adjoin_simple_of_isSquare_mul` (with the equality
`TauCeti.IntermediateField.adjoin_simple_eq_of_isSquare_mul`), to be used instead after the bump.

## Main results

* `IntermediateField.setOf_finrank_eq_two_eq_range`: the quadratic intermediate fields are the
  `F(√r i)` when the `r i` are nonsquares representing every nontrivial square class.
* `IntermediateField.injective_adjoin_simple`: the `F(√r i)` are distinct when the `r i` lie in
  distinct square classes.
* `IntermediateField.adjoin_simple_eq_unramifiedExtension`: a quadratic `F(x)` with `x` in the
  maximal unramified extension is the unramified quadratic extension.
* `Padic.exists_isSquare_mul_of_ne_two`: representatives of the square classes of `ℚ_p` for odd
  `p`.
* `Padic.setOf_finrank_eq_two_eq_range_of_ne_two`, `Padic.injective_adjoin_of_not_isSquare_toZMod`,
  `Padic.ncard_setOf_finrank_eq_two_of_ne_two`, `Padic.adjoin_eq_unramifiedExtension_of_ne_two`
  (LMFDB `lf.discriminant_root_field`): the quadratic extensions of `ℚ_p` for odd `p`.
* `Padic.setOf_finrank_eq_two_eq_range_padicTwo`, `Padic.injective_adjoin_padicTwo`,
  `Padic.ncard_setOf_finrank_eq_two_padicTwo`, `Padic.adjoin_eq_unramifiedExtension_padicTwo` (LMFDB
  `lf.discriminant_root_field`): the seven quadratic extensions of `ℚ_2`.
-/

open IntermediateField Module TauCeti ValuativeRel

namespace IntermediateField

variable {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]

private lemma adjoin_simple_le_of_isSquare_mul {a b : F} {y z : Ω} (hy : y ^ 2 = algebraMap F Ω a)
    (hz : z ^ 2 = algebraMap F Ω b) (hb : b ≠ 0) (h : IsSquare (a * b)) : F⟮y⟯ ≤ F⟮z⟯ := by
  rcases h with ⟨s, hs⟩
  have hz0 : z ≠ 0 := by
    rintro rfl
    exact hb <| (algebraMap F Ω).injective <| by rw [← hz, map_zero, zero_pow two_ne_zero]
  have key : (y * z - algebraMap F Ω s) * (y * z + algebraMap F Ω s) = 0 := by
    have hs' : algebraMap F Ω a * algebraMap F Ω b = algebraMap F Ω s * algebraMap F Ω s := by
      rw [← map_mul, ← map_mul, hs]
    linear_combination z ^ 2 * hy + algebraMap F Ω a * hz + hs'
  rw [adjoin_simple_le_iff]
  rcases mul_eq_zero.mp key with h | h
  · rw [eq_div_of_mul_eq hz0 (sub_eq_zero.mp h)]
    exact div_mem (algebraMap_mem _ s) (mem_adjoin_simple_self F z)
  · rw [eq_div_of_mul_eq hz0 (eq_neg_of_add_eq_zero_left h)]
    exact div_mem (neg_mem (algebraMap_mem _ s)) (mem_adjoin_simple_self F z)

variable [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [IsSepClosed Ω] in
/-- A quadratic simple extension `F(x)` of a nonarchimedean local field `F`, with `x` in the maximal
unramified extension, is the unramified quadratic extension `TauCeti.unramifiedExtension F Ω 2`, the
unique unramified intermediate field of degree `2`. -/
lemma adjoin_simple_eq_unramifiedExtension {x : Ω} (hx : x ∈ maximalUnramifiedExtension F Ω)
    (h2 : finrank F F⟮x⟯ = 2) : F⟮x⟯ = unramifiedExtension F Ω 2 := by
  have : FiniteDimensional F F⟮x⟯ := .of_finrank_pos (by omega)
  let _ : ValuativeRel F⟮x⟯ := finiteIntermediateFieldValuativeRel F Ω F⟮x⟯
  let _ : TopologicalSpace F⟮x⟯ := finiteIntermediateFieldTopology F Ω F⟮x⟯
  have : IsNonarchimedeanLocalField F⟮x⟯ := finiteIntermediateField_isNonarchimedeanLocalField F Ω _
  have : ValuativeExtension F F⟮x⟯ := finiteIntermediateField_valuativeExtension F Ω _
  have : IsUnramified F F⟮x⟯ :=
    (F⟮x⟯.le_maximalUnramifiedExtension_iff).mp (adjoin_simple_le_iff.mpr hx)
  exact F⟮x⟯.eq_unramifiedExtension_finrank.trans (by rw [h2])

variable [NeZero (2 : F)] {ι : Type*} {r : ι → F} {x : ι → Ω}

/-- **The quadratic intermediate fields** (LMFDB `lf.discriminant_root_field`): if `2 ≠ 0` in `F`,
the `r i` are nonsquares such that every nonsquare of `F` is `r i` times a square for some `i`, and
`x i` is a square root of `r i`, then the intermediate fields of degree `2` are the `F(x i)`. -/
lemma setOf_finrank_eq_two_eq_range (hx : ∀ i, x i ^ 2 = algebraMap F Ω (r i))
    (hr : ∀ i, ¬IsSquare (r i)) (hrep : ∀ a : F, ¬IsSquare a → ∃ i, IsSquare (a * r i)) :
    {E : IntermediateField F Ω | finrank F E = 2} = Set.range fun i ↦ F⟮x i⟯ := by
  ext E
  refine ⟨fun hE ↦ ?_, ?_⟩
  · rcases IntermediateField.exists_sq_mem_range_adjoin_simple_eq_of_finrank_eq_two hE with
      ⟨w, -, hwb, ⟨a, hw⟩, rfl⟩
    have ha : ¬IsSquare a := by
      rintro ⟨s, rfl⟩
      have key : (w - algebraMap F Ω s) * (w + algebraMap F Ω s) = 0 := by
        rw [map_mul] at hw
        linear_combination hw
      refine hwb ?_
      rcases mul_eq_zero.mp key with h | h
      · rw [sub_eq_zero.mp h]
        exact algebraMap_mem _ s
      · rw [eq_neg_of_add_eq_zero_left h]
        exact neg_mem (algebraMap_mem _ s)
    rcases hrep a ha with ⟨i, hi⟩
    exact ⟨i, le_antisymm (adjoin_simple_le_of_isSquare_mul (hx i) hw
      (fun h ↦ ha (h ▸ IsSquare.zero)) (mul_comm a (r i) ▸ hi))
      (adjoin_simple_le_of_isSquare_mul hw (hx i) (fun h ↦ hr i (h ▸ IsSquare.zero)) hi)⟩
  · rintro ⟨i, rfl⟩
    exact IntermediateField.finrank_adjoin_simple_eq_two_of_not_isSquare (hx i) (hr i)

/-- **Distinct square classes give distinct quadratic extensions**: if `2 ≠ 0` in `F`, the `r i` are
nonsquares, no product `r i * r j` with `i ≠ j` is a square and `x i` is a square root of `r i`,
then the fields `F(x i)` are distinct. -/
lemma injective_adjoin_simple (hx : ∀ i, x i ^ 2 = algebraMap F Ω (r i)) (hr : ∀ i, ¬IsSquare (r i))
    (hinj : ∀ i j, IsSquare (r i * r j) → i = j) : Function.Injective fun i ↦ F⟮x i⟯ := by
  intro i j h
  refine hinj i j (IntermediateField.isSquare_mul_of_adjoin_simple_eq (hx i) (hx j) ?_ h)
  rw [← adjoin_simple_eq_bot_iff]
  intro hb
  have h2 : finrank F F⟮x i⟯ = 2 :=
    IntermediateField.finrank_adjoin_simple_eq_two_of_not_isSquare (hx i) (hr i)
  rw [hb, IntermediateField.finrank_bot] at h2
  omega

end IntermediateField

namespace PadicInt

variable {p : ℕ} [Fact p.Prime] {u : ℤ_[p]}

lemma isUnit_of_not_isSquare_toZMod (hu : ¬IsSquare (toZMod u)) : IsUnit u := by
  by_contra h
  have hm : u ∈ IsLocalRing.maximalIdeal ℤ_[p] := h
  rw [← ker_toZMod, RingHom.mem_ker] at hm
  exact hu (hm ▸ IsSquare.zero)

lemma not_isSquare_coe_of_not_isSquare_toZMod (hu : ¬IsSquare (toZMod u)) :
    ¬IsSquare (u : ℚ_[p]) := by
  rintro ⟨b, hb⟩
  have hb1 : ‖b‖ ≤ 1 := by
    have h : ‖b‖ * ‖b‖ ≤ 1 := by rw [← norm_mul, ← hb]; exact norm_le_one u
    nlinarith [norm_nonneg b]
  rcases (⟨⟨b, hb1⟩, rfl⟩ : ∃ c : ℤ_[p], (c : ℚ_[p]) = b) with ⟨c, rfl⟩
  have hc : u = c * c := PadicInt.ext (by push_cast; exact hb)
  exact hu ⟨toZMod c, by rw [hc, map_mul]⟩

lemma isSquare_coe_of_toZModPow_three_eq_one {v : ℤ_[2]} (hv : toZModPow 3 v = 1) :
    IsSquare (v : ℚ_[2]) := by
  have hunit : IsUnit v := by
    by_contra h
    rcases (norm_lt_one_iff_dvd v).mp (not_isUnit_iff.mp h) with ⟨w, rfl⟩
    rw [map_mul, map_natCast] at hv
    revert hv
    generalize toZModPow 3 w = t
    revert t
    decide
  exact (isSquare_coe_iff_mem_unitsPrincipal_three hunit.unit).mpr
    (mem_unitsPrincipal_iff_toZModPow.mpr hv)

end PadicInt

namespace Padic

open PadicInt

variable {Ω : Type*} [Field Ω]

section Odd

variable {p : ℕ} [Fact p.Prime] [Algebra ℚ_[p] Ω] {u : ℤ_[p]} {a : ℚ_[p]}

lemma not_isSquare_of_odd_valuation (h : Odd a.valuation) : ¬IsSquare a := by
  rintro ⟨b, rfl⟩
  rcases eq_or_ne b 0 with rfl | hb
  · simp at h
  rw [valuation_mul hb hb] at h
  exact Int.not_even_iff_odd.mpr h ⟨_, rfl⟩

/-- **The square classes of `ℚ_p` for odd `p`**: if `u` is a `p`-adic integer that is not a square
modulo `p`, every nonzero `a ∈ ℚ_p` is, up to a square, one of `1`, `u`, `p`, `pu`. -/
lemma exists_isSquare_mul_of_ne_two (hp : p ≠ 2) (hu : ¬IsSquare (toZMod u)) (ha : a ≠ 0) :
    ∃ c ∈ ({1, (u : ℚ_[p]), (p : ℚ_[p]), p * (u : ℚ_[p])} : Set ℚ_[p]), IsSquare (a * c) := by
  have hu1 : IsUnit u := isUnit_of_not_isSquare_toZMod hu
  rcases exists_isSquare_mul_of_isUnit_two (isUnit_two_integerRing hp)
    (Padic.isUniformizer_natCast_self p) (u := Units.mk0 _ (coe_ne_zero.2 hu1.ne_zero))
    (by simp [valuation_eq_zero_of_isUnit hu1])
    (fun h ↦ not_isSquare_coe_of_not_isSquare_toZMod hu
      (by simpa using isSquare_units_val_iff.mpr h)) (Units.mk0 a ha) with
    ⟨r, hr, hsq⟩
  refine ⟨r, ?_, by simpa using hsq.map (Units.coeHom ℚ_[p])⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr ⊢
  rcases hr with rfl | rfl | rfl | rfl
  · exact Or.inl Units.val_one
  · exact Or.inr (Or.inl (Units.val_mk0 _))
  · exact Or.inr (Or.inr (Or.inl (Units.val_mk0 _)))
  · exact Or.inr (Or.inr (Or.inr (by rw [Units.val_mul, Units.val_mk0, Units.val_mk0, mul_comm])))

/-- **The quadratic extensions of `ℚ_p` for odd `p`** (LMFDB `lf.discriminant_root_field`): if `u`
is a `p`-adic integer that is not a square modulo `p` (hence a unit) and `x 0`, `x 1`, `x 2` are
square roots of `u`, `p`, `pu` in an extension `Ω` of `ℚ_p`, then the quadratic intermediate fields
of `Ω` are `ℚ_p(√u)`, `ℚ_p(√p)`, `ℚ_p(√(pu))`. -/
lemma setOf_finrank_eq_two_eq_range_of_ne_two (hp : p ≠ 2) (hu : ¬IsSquare (toZMod u))
    {x : Fin 3 → Ω} (hx : ∀ i, x i ^ 2 = algebraMap ℚ_[p] Ω (![(u : ℚ_[p]), p, p * u] i)) :
    {E : IntermediateField ℚ_[p] Ω | finrank ℚ_[p] E = 2} = Set.range fun i ↦ ℚ_[p]⟮x i⟯ := by
  have hu1 : IsUnit u := isUnit_of_not_isSquare_toZMod hu
  refine setOf_finrank_eq_two_eq_range hx (fun i ↦ ?_) fun a ha ↦ ?_
  · fin_cases i
    · exact not_isSquare_coe_of_not_isSquare_toZMod hu
    · exact not_isSquare_of_odd_valuation (by simp)
    · refine not_isSquare_of_odd_valuation ?_
      simp [valuation_mul (NeZero.ne _) (coe_ne_zero.2 hu1.ne_zero),
        valuation_eq_zero_of_isUnit hu1]
  · have ha0 : a ≠ 0 := by
      rintro rfl
      exact ha .zero
    rcases exists_isSquare_mul_of_ne_two hp hu ha0 with ⟨c, hc, hsq⟩
    simp only [Set.mem_insert_iff] at hc
    rcases hc with rfl | rfl | rfl | rfl
    · exact absurd (by simpa using hsq) ha
    · exact ⟨0, hsq⟩
    · exact ⟨1, hsq⟩
    · exact ⟨2, hsq⟩

/-- **The three quadratic extensions of `ℚ_p` for odd `p` are distinct** (LMFDB
`lf.discriminant_root_field`): for `u` a `p`-adic integer that is not a square modulo `p` and square
roots `x 0`, `x 1`, `x 2` of `u`, `p`, `pu`, the fields `ℚ_p(x i)` are distinct. -/
lemma injective_adjoin_of_not_isSquare_toZMod (hu : ¬IsSquare (toZMod u)) {x : Fin 3 → Ω}
    (hx : ∀ i, x i ^ 2 = algebraMap ℚ_[p] Ω (![(u : ℚ_[p]), p, p * u] i)) :
    Function.Injective fun i ↦ ℚ_[p]⟮x i⟯ := by
  have hu1 : IsUnit u := isUnit_of_not_isSquare_toZMod hu
  have hu0 : (u : ℚ_[p]) ≠ 0 := coe_ne_zero.2 hu1.ne_zero
  have hv : (u : ℚ_[p]).valuation = 0 := by simp [valuation_eq_zero_of_isUnit hu1]
  have hp0 : (p : ℚ_[p]) ≠ 0 := NeZero.ne _
  have hpu (h : IsSquare ((p : ℚ_[p]) * (p * u))) : False := by
    rcases h with ⟨s, hs⟩
    exact not_isSquare_coe_of_not_isSquare_toZMod hu ⟨s / p, by field_simp; linear_combination hs⟩
  refine injective_adjoin_simple hx (fun i ↦ ?_) fun i j h ↦ ?_
  · fin_cases i
    · exact not_isSquare_coe_of_not_isSquare_toZMod hu
    · exact not_isSquare_of_odd_valuation (by simp)
    · exact not_isSquare_of_odd_valuation (by simp [hp0, hu0, hv])
  · fin_cases i <;> fin_cases j
    all_goals first
      | rfl
      | (refine (hpu ?_).elim; simpa [mul_comm] using h)
      | exact absurd h (not_isSquare_of_odd_valuation (by simp [hp0, hu0, hv]))

/-- **There are three quadratic extensions of `ℚ_p` for odd `p`** (LMFDB
`lf.discriminant_root_field`), inside a separably closed extension `Ω` of `ℚ_p`. -/
lemma ncard_setOf_finrank_eq_two_of_ne_two [IsSepClosed Ω] (hp : p ≠ 2) :
    {E : IntermediateField ℚ_[p] Ω | finrank ℚ_[p] E = 2}.ncard = 3 := by
  have : CharZero Ω := charZero_of_injective_algebraMap (algebraMap ℚ_[p] Ω).injective
  rcases FiniteField.exists_nonsquare (F := ZMod p) (by rwa [ZMod.ringChar_zmod_n]) with ⟨b, hb⟩
  have hu : ¬IsSquare (toZMod (b.val : ℤ_[p])) := by
    rwa [map_natCast, ZMod.natCast_zmod_val]
  choose x hx using fun i ↦ IsSepClosed.exists_pow_nat_eq
    (algebraMap ℚ_[p] Ω (![((b.val : ℤ_[p]) : ℚ_[p]), p, p * (b.val : ℤ_[p])] i)) 2
  rw [setOf_finrank_eq_two_eq_range_of_ne_two hp hu hx,
    Set.ncard_range_of_injective (injective_adjoin_of_not_isSquare_toZMod hu hx),
    Nat.card_eq_fintype_card, Fintype.card_fin]

/-- **`ℚ_p(√u)` is the unramified quadratic extension for odd `p`** (LMFDB
`lf.discriminant_root_field`): if `u` is a `p`-adic integer that is not a square modulo `p` and `x`
is a square root of `u` in a separably closed extension `Ω` of `ℚ_p`, then `ℚ_p(x)` is the unique
unramified intermediate field of degree `2`, Tau Ceti's `TauCeti.unramifiedExtension ℚ_[p] Ω 2`. -/
lemma adjoin_eq_unramifiedExtension_of_ne_two [IsSepClosed Ω] (hp : p ≠ 2)
    (hu : ¬IsSquare (toZMod u)) {x : Ω} (hx : x ^ 2 = algebraMap ℚ_[p] Ω u) :
    ℚ_[p]⟮x⟯ = unramifiedExtension ℚ_[p] Ω 2 := by
  have hu1 : IsUnit u := isUnit_of_not_isSquare_toZMod hu
  refine adjoin_simple_eq_unramifiedExtension ?_
    (IntermediateField.finrank_adjoin_simple_eq_two_of_not_isSquare hx
      (not_isSquare_coe_of_not_isSquare_toZMod hu))
  exact mem_maximalUnramifiedExtension_of_pow_eq
    (IsLocalRing.isUnit_natCast_iff_not_dvd.1 (by exact_mod_cast isUnit_two_integerRing hp))
    (u := Units.mk0 _ (coe_ne_zero.2 hu1.ne_zero))
    (mem_unitFiltration_iff_exists.2 ⟨(hu1.map (integerRingEquiv p).symm).unit, by simp, by simp⟩)
    (by simpa using hx)

end Odd

section Two

variable [Algebra ℚ_[2] Ω] {u : ℤ_[2]}

private lemma isSquare_mul_padicTwoSquareClassRep_iff {i j : Fin 8} :
    IsSquare ((padicTwoSquareClassRep i : ℚ_[2]) * padicTwoSquareClassRep j) ↔ i = j := by
  rw [← Units.val_mul, isSquare_units_val_iff, ← squareClass_eq_iff_isSquare_mul,
    squareClass_padicTwoSquareClassRep_bijective.injective.eq_iff]

private lemma isSquare_mul_trans {a b c : ℚ_[2]} (hb : b ≠ 0) (h₁ : IsSquare (a * b))
    (h₂ : IsSquare (b * c)) : IsSquare (a * c) := by
  rw [show a * c = a * b * (b * c) * (b ^ 2)⁻¹ by field_simp]
  exact (h₁.mul h₂).mul (IsSquare.sq b).inv

private lemma isSquare_mul_rep_padicTwo (hu : toZModPow 3 u = 5) (i : Fin 7) :
    IsSquare (![(u : ℚ_[2]), -1, -u, 2, 2 * u, -2, -2 * u] i *
        padicTwoSquareClassRep (![2, 1, 3, 4, 6, 5, 7] i)) := by
  have h5 : ((5 : ℤ_[2]) : ℚ_[2]) = 5 := by simpa using coe_natCast (p := 2) 5
  have h5u : IsSquare (5 * (u : ℚ_[2])) := by
    simpa [h5] using isSquare_coe_of_toZModPow_three_eq_one (v := 5 * u)
      (by rw [map_mul, hu, map_ofNat]; decide)
  rcases h5u with ⟨s, hs⟩
  fin_cases i
  all_goals first
    | (refine ⟨1, ?_⟩; norm_num; done)
    | (refine ⟨2, ?_⟩; norm_num; done)
    | (refine ⟨s, ?_⟩; simp; linear_combination hs)
    | (refine ⟨2 * s, ?_⟩; simp; linear_combination 4 * hs)

private lemma not_isSquare_rep_padicTwo (i : Fin 7) :
    ¬IsSquare (padicTwoSquareClassRep (![2, 1, 3, 4, 6, 5, 7] i) : ℚ_[2]) := by
  have h : (padicTwoSquareClassRep 0 : ℚ_[2]) = 1 := by simp
  rw [← mul_one (padicTwoSquareClassRep _ : ℚ_[2]), ← h, isSquare_mul_padicTwoSquareClassRep_iff]
  revert i
  decide

private lemma not_isSquare_rep_mul_rep_padicTwo {i j : Fin 7} (hij : i ≠ j) :
    ¬IsSquare ((padicTwoSquareClassRep (![2, 1, 3, 4, 6, 5, 7] i) : ℚ_[2]) *
        padicTwoSquareClassRep (![2, 1, 3, 4, 6, 5, 7] j)) := fun h ↦
  hij <| (by decide : Function.Injective ![(2 : Fin 8), 1, 3, 4, 6, 5, 7])
    (isSquare_mul_padicTwoSquareClassRep_iff.mp h)

private lemma vec_ne_zero_padicTwo (hu : toZModPow 3 u = 5) (i : Fin 7) :
    ![(u : ℚ_[2]), -1, -u, 2, 2 * u, -2, -2 * u] i ≠ 0 := by
  have hu0 : (u : ℚ_[2]) ≠ 0 := by
    intro h
    rw [coe_eq_zero.mp h, map_zero] at hu
    exact absurd hu (by decide)
  fin_cases i <;> simp [hu0]

private lemma not_isSquare_vec_padicTwo (hu : toZModPow 3 u = 5) (i : Fin 7) :
    ¬IsSquare (![(u : ℚ_[2]), -1, -u, 2, 2 * u, -2, -2 * u] i) := fun h ↦
  not_isSquare_rep_padicTwo i <| by
    simpa using isSquare_mul_trans (a := 1) (vec_ne_zero_padicTwo hu i) (by rwa [one_mul])
      (isSquare_mul_rep_padicTwo hu i)

/-- **The quadratic extensions of `ℚ_2`** (LMFDB `lf.discriminant_root_field`): if `u` is a `2`-adic
integer with `u ≡ 5 mod 8` and `x 0`, …, `x 6` are square roots of `u`, `-1`, `-u`, `2`, `2u`, `-2`,
`-2u` in an extension `Ω` of `ℚ_2`, then the quadratic intermediate fields of `Ω` are `ℚ_2(√u)`,
`ℚ_2(√-1)`, `ℚ_2(√-u)`, `ℚ_2(√2)`, `ℚ_2(√(2u))`, `ℚ_2(√-2)`, `ℚ_2(√(-2u))`. -/
lemma setOf_finrank_eq_two_eq_range_padicTwo (hu : toZModPow 3 u = 5) {x : Fin 7 → Ω}
    (hx : ∀ i, x i ^ 2 = algebraMap ℚ_[2] Ω (![(u : ℚ_[2]), -1, -u, 2, 2 * u, -2, -2 * u] i)) :
    {E : IntermediateField ℚ_[2] Ω | finrank ℚ_[2] E = 2} = Set.range fun i ↦ ℚ_[2]⟮x i⟯ := by
  refine setOf_finrank_eq_two_eq_range hx (not_isSquare_vec_padicTwo hu) fun a ha ↦ ?_
  have ha0 : a ≠ 0 := by
    rintro rfl
    exact ha .zero
  rcases squareClass_padicTwoSquareClassRep_bijective.surjective (squareClass (.mk0 a ha0)) with
    ⟨k, hk⟩
  rw [squareClass_eq_iff_isSquare_mul, ← isSquare_units_val_iff, Units.val_mul, Units.val_mk0] at hk
  have hk0 : k ≠ 0 := by
    rintro rfl
    exact ha (by simpa using hk)
  rcases (by decide : ∀ k : Fin 8, k ≠ 0 → ∃ i : Fin 7, ![2, 1, 3, 4, 6, 5, 7] i = k) k hk0 with
    ⟨i, rfl⟩
  exact ⟨i, isSquare_mul_trans (Units.ne_zero _) (by rwa [mul_comm])
    (by rw [mul_comm]; exact isSquare_mul_rep_padicTwo hu i)⟩

/-- **The seven quadratic extensions of `ℚ_2` are distinct** (LMFDB `lf.discriminant_root_field`):
for `u ≡ 5 mod 8` and square roots `x 0`, …, `x 6` of `u`, `-1`, `-u`, `2`, `2u`, `-2`, `-2u`, the
fields `ℚ_2(x i)` are distinct. -/
lemma injective_adjoin_padicTwo (hu : toZModPow 3 u = 5) {x : Fin 7 → Ω}
    (hx : ∀ i, x i ^ 2 = algebraMap ℚ_[2] Ω (![(u : ℚ_[2]), -1, -u, 2, 2 * u, -2, -2 * u] i)) :
    Function.Injective fun i ↦ ℚ_[2]⟮x i⟯ := by
  refine injective_adjoin_simple hx (not_isSquare_vec_padicTwo hu) fun i j h ↦ ?_
  by_contra hij
  exact not_isSquare_rep_mul_rep_padicTwo hij <| isSquare_mul_trans (vec_ne_zero_padicTwo hu j)
    (isSquare_mul_trans (vec_ne_zero_padicTwo hu i)
      (by rw [mul_comm]; exact isSquare_mul_rep_padicTwo hu i) h) (isSquare_mul_rep_padicTwo hu j)

/-- **There are seven quadratic extensions of `ℚ_2`** (LMFDB `lf.discriminant_root_field`), inside a
separably closed extension `Ω` of `ℚ_2`. -/
lemma ncard_setOf_finrank_eq_two_padicTwo [IsSepClosed Ω] :
    {E : IntermediateField ℚ_[2] Ω | finrank ℚ_[2] E = 2}.ncard = 7 := by
  have : CharZero Ω := charZero_of_injective_algebraMap (algebraMap ℚ_[2] Ω).injective
  rcases (⟨5, map_ofNat _ 5⟩ : ∃ v : ℤ_[2], toZModPow 3 v = 5) with ⟨v, hv⟩
  choose x hx using fun i ↦ IsSepClosed.exists_pow_nat_eq
    (algebraMap ℚ_[2] Ω (![(v : ℚ_[2]), -1, -v, 2, 2 * v, -2, -2 * v] i)) 2
  rw [setOf_finrank_eq_two_eq_range_padicTwo hv hx,
    Set.ncard_range_of_injective (injective_adjoin_padicTwo hv hx), Nat.card_eq_fintype_card,
    Fintype.card_fin]

/-- **`ℚ_2(√u)` is the unramified quadratic extension** (LMFDB `lf.discriminant_root_field`): if
`u ≡ 5 mod 8` and `x` is a square root of `u` in a separably closed extension `Ω` of `ℚ_2`, then
`ℚ_2(x)` is the unique unramified intermediate field of degree `2`,
`TauCeti.unramifiedExtension ℚ_[2] Ω 2`: `ℚ_2(x) = ℚ_2(√-3)` is generated by a primitive cube root
of unity. -/
lemma adjoin_eq_unramifiedExtension_padicTwo [IsSepClosed Ω] (hu : toZModPow 3 u = 5) {x : Ω}
    (hx : x ^ 2 = algebraMap ℚ_[2] Ω u) : ℚ_[2]⟮x⟯ = unramifiedExtension ℚ_[2] Ω 2 := by
  have : CharZero Ω := charZero_of_injective_algebraMap (algebraMap ℚ_[2] Ω).injective
  have h3 : ((3 : ℤ_[2]) : ℚ_[2]) = 3 := by simpa using coe_natCast (p := 2) 3
  rcases isSquare_coe_of_toZModPow_three_eq_one (v := -3 * u)
    (by rw [map_mul, hu, map_neg, map_ofNat]; decide) with ⟨t, ht⟩
  rw [PadicInt.coe_mul, PadicInt.coe_neg, h3] at ht
  have hu0 : (u : ℚ_[2]) ≠ 0 := vec_ne_zero_padicTwo hu 0
  have ht0 : t ≠ 0 := by
    rintro rfl
    exact hu0 (by linear_combination (-1 / 3 : ℚ_[2]) * ht)
  have hw : (x * algebraMap ℚ_[2] Ω (-3 / t)) ^ 2 = -3 := by
    rw [mul_pow, hx, ← map_pow, ← map_mul, show (u : ℚ_[2]) * (-3 / t) ^ 2 = -3 by
      rw [div_pow, mul_div_assoc', div_eq_iff (pow_ne_zero 2 ht0)]
      linear_combination -3 * ht, map_neg, map_ofNat]
  have hζ : ((x * algebraMap ℚ_[2] Ω (-3 / t) - 1) / 2) ^ 3 = 1 := by
    linear_combination ((x * algebraMap ℚ_[2] Ω (-3 / t) - 3) / 8) * hw
  have hmem : (x * algebraMap ℚ_[2] Ω (-3 / t) - 1) / 2 ∈ maximalUnramifiedExtension ℚ_[2] Ω :=
    mem_maximalUnramifiedExtension_of_pow_eq_one (IsLocalRing.isUnit_natCast_iff_not_dvd.1 (by
      exact_mod_cast isUnit_intCast_integerRing (p := 2) (m := 3) (by decide))) hζ
  refine adjoin_simple_eq_unramifiedExtension ?_
    (IntermediateField.finrank_adjoin_simple_eq_two_of_not_isSquare hx
      (by simpa using not_isSquare_vec_padicTwo hu 0))
  have hxe :
      x = (2 * ((x * algebraMap ℚ_[2] Ω (-3 / t) - 1) / 2) + 1) * algebraMap ℚ_[2] Ω (t / -3) := by
    rw [mul_div_cancel₀ _ two_ne_zero, sub_add_cancel, mul_assoc, ← map_mul,
      div_mul_div_cancel₀ ht0, div_self (by norm_num), map_one, mul_one]
  rw [hxe]
  exact mul_mem (add_mem (by rw [two_mul]; exact add_mem hmem hmem) (one_mem _))
    (IntermediateField.algebraMap_mem _ _)

end Two

