import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Data.Nat.Prime.Basic
import Mathlib.Order.Lattice.Nat
import Mathlib.RingTheory.Coprime.Lemmas
import Mathlib.Tactic.Linarith

/-!
# Filtered groups with Pagano's shift, Miki's factorisation and the uniqueness of its levels

Let `p` be a prime and `e'` a positive integer, and let `ρ(a) = min(pa, a + (p - 1) e')` be Pagano's
shift (C. Pagano, *Jump sets in local fields*, arXiv:1810.09975, §1.2), the example relevant for a
`p`-adic field `K` containing a primitive `p`-th root of unity `ζ`, of absolute ramification index
`e = (p - 1) e'`. The positive integers are the disjoint union of the chains `ρ^b(s)` for `s` in
`T = {n < p e' | p ∤ n}`, the complement of the image of `ρ`.

The group of principal units of `K` with its unit filtration is an example of a
`IsNonarchimedeanLocalField.JumpFiltration`: a decreasing filtration `U n` of a commutative group
with an element `ζ` of order dividing `p` at the level `e'`, such that the `p`-th power maps `U a`
to `U (ρ a)` and induces a bijection of the graded pieces at `a` and `ρ(a)` for `a ≠ e'`, every
element of `U (a + (p - 1) e')`, `a > e'`, is a `p`-th power of an element of `U a`, and the kernel
of the `p`-th power on the graded piece at `e'` is generated by `ζ`.

In this setting the file proves the two theorems behind the jump set of `K` (LMFDB `lf.jump_set`),
in the form of Miki's Lemma 17 (H. Miki, *On the ramification numbers of cyclic `p`-extensions over
local fields*, J. Reine Angew. Math. 328 (1981), 99-115) as quoted by Pagano, §1.4: `ζ` has a
factorisation `∏_{l ≤ r} γ_l ^ p ^ l`, `e' = ρ^r(m)`, `m ∈ T`, each `γ_l` being `1` or a *Miki
factor*, of a level `s` in `T` or of the level `s = p e'` and not a `p`-th power, the levels
`ρ^l(s_l)` of the factors strictly decreasing with `l`, and the levels `s_l` of any such
factorisation are uniquely determined.

The proof of the uniqueness shows that the level of the partial product `∏_{l < j} γ_l ^ p ^ l` is
the largest level of a quotient of `ζ` by a `p ^ j`-th power, which does not depend on the
factorisation. The only obstruction to reading off levels of powers is the crossing of the level
`e'`, where the `p`-th power of an element may jump because of `ζ`.

## Main definitions

* `IsNonarchimedeanLocalField.jumpShift`: Pagano's shift `ρ`.
* `IsNonarchimedeanLocalField.IsJumpBase`: the set `T`, the complement of the image of `ρ`.
* `IsNonarchimedeanLocalField.JumpFiltration`: a filtered group with the properties of the principal
  units of a `p`-adic field containing a primitive `p`-th root of unity.
* `IsNonarchimedeanLocalField.JumpFiltration.IsLevel`: `x` lies in `U n` but not in `U (n + 1)`.
* `IsNonarchimedeanLocalField.JumpFiltration.level`: the level of an element.
* `IsNonarchimedeanLocalField.JumpFiltration.IsMikiAt`: `x` is a Miki factor of level `n`.
* `IsNonarchimedeanLocalField.JumpFiltration.jumpProd`: the partial product of a factorisation.
* `IsNonarchimedeanLocalField.JumpFiltration.IsReduced`: a sequence of Miki factors whose powers
  have strictly decreasing levels.
* `IsNonarchimedeanLocalField.JumpFiltration.IsMikiData`: a factorisation of `ζ` into Miki factors
  and the sequence of its levels, filled in by `ρ`, with `ρ(u_{l + 1}) ≤ u_l`.

## Main results

* `IsNonarchimedeanLocalField.JumpFiltration.exists_chain`: the chain of an element.
* `IsNonarchimedeanLocalField.JumpFiltration.exists_isReduced`: the reduction of an element.
* `IsNonarchimedeanLocalField.JumpFiltration.exists_forall_isMikiData`: **Miki's existence
  theorem**.
* `IsNonarchimedeanLocalField.JumpFiltration.exists_eq_pow_pow_mul_of_isLevel`: the crossing of the
  level `e'` does not change the levels of the `p ^ a`-th powers modulo a quotient of `ζ` by a
  `p ^ j`-th power, `a ≤ j`.
* `IsNonarchimedeanLocalField.JumpFiltration.IsMikiData.ne_one_top` and
  `IsNonarchimedeanLocalField.JumpFiltration.IsMikiData.eq_top`: the top factor is not trivial, of
  level `m`, for `e' = ρ^r(m)`.
* `IsNonarchimedeanLocalField.JumpFiltration.IsMikiData.mem_of_eq_pow_pow_mul`: the level of a
  partial product is maximal among the quotients of `ζ` by `p ^ j`-th powers.
* `IsNonarchimedeanLocalField.JumpFiltration.IsMikiData.eq`: **the uniqueness of the levels**.
* `IsNonarchimedeanLocalField.JumpFiltration.IsMikiData.one_le` and
  `IsNonarchimedeanLocalField.JumpFiltration.IsMikiData.lt_succ`: the levels are positive and
  decrease strictly with `l`.
-/

open Finset Function

namespace IsNonarchimedeanLocalField

/-- **Pagano's shift** `ρ(a) = min(p a, a + e)` for `e = (p - 1) e'` (Pagano, *Jump sets in local
fields*, §1.2; LMFDB `lf.jump_set`), the function `ρ_{e,p}` of a `p`-adic field containing a
primitive `p`-th root of unity, of absolute ramification index `e`. It describes the effect of the
`p`-th power on the unit filtration. -/
def jumpShift (p e' a : ℕ) : ℕ :=
  min (p * a) (a + (p - 1) * e')

/-- The set `T` of **Pagano's shift** `ρ` (Pagano's `T_ρ`, §1.2): the integers `n < p e'` prime to
`p`, the complement of the image of `ρ` in the positive integers. Pagano's `T_ρ^*` adds to it the
integer `e^* = p e' = ρ(e')`. -/
def IsJumpBase (p e' n : ℕ) : Prop :=
  ¬p ∣ n ∧ n < p * e'

variable {G : Type*} [CommGroup G] {p e' a b k n m s s' : ℕ}

local notation "ρ" => jumpShift p e'

lemma IsJumpBase.pos (h : IsJumpBase p e' n) : 1 ≤ n :=
  Nat.pos_of_ne_zero fun h₀ ↦ h.1 <| h₀ ▸ dvd_zero p

lemma jumpShift_of_le (h : a ≤ e') : ρ a = p * a := by
  refine min_eq_left ?_
  rcases p with _ | q
  · simp
  · rw [Nat.add_sub_cancel, Nat.succ_mul, add_comm]
    exact Nat.add_le_add_left (Nat.mul_le_mul_left q h) a

lemma jumpShift_self : ρ e' = p * e' :=
  jumpShift_of_le le_rfl

section Prime

variable [Fact p.Prime]

lemma jumpShift_of_ge (h : e' ≤ a) : ρ a = a + (p - 1) * e' := by
  refine min_eq_right ?_
  rcases Nat.exists_eq_add_of_le' (Fact.out : p.Prime).one_le with ⟨q, hq⟩
  rw [hq, Nat.add_sub_cancel, Nat.succ_mul, add_comm]
  exact Nat.add_le_add_right (Nat.mul_le_mul_left q h) a

lemma iterate_jumpShift_of_ge (h : e' ≤ a) : ρ^[b] a = a + b * ((p - 1) * e') := by
  induction b with
  | zero => simp
  | succ b ih =>
    rw [iterate_succ_apply', ih, jumpShift_of_ge (h.trans (Nat.le_add_right a _))]
    ring1

lemma mul_eq_add_sub_one_mul : p * e' = e' + (p - 1) * e' := by
  have h : p = 1 + (p - 1) := by
    have h₁ : 1 ≤ p := (Fact.out : p.Prime).one_le
    omega
  conv_lhs => rw [h, add_mul, one_mul]

lemma jumpShift_succ_self : ρ (e' + 1) = p * e' + 1 := by
  have h : p * e' = e' + (p - 1) * e' :=
    mul_eq_add_sub_one_mul
  rw [jumpShift_of_ge e'.le_succ, h]
  omega

lemma lt_prime_mul (he : 1 ≤ e') : e' < p * e' :=
  lt_mul_of_one_lt_left he (Fact.out : p.Prime).one_lt

lemma strictMono_jumpShift : StrictMono (jumpShift p e') :=
  fun _ _ h ↦ lt_min (min_lt_of_left_lt <| Nat.mul_lt_mul_of_pos_left h (Fact.out : p.Prime).pos)
    (min_lt_of_right_lt <| Nat.add_lt_add_right h _)

variable (b) in
lemma strictMono_iterate_jumpShift : StrictMono ρ^[b] :=
  strictMono_jumpShift.iterate b

lemma lt_jumpShift (ha : 1 ≤ a) (he : 1 ≤ e') : a < ρ a := by
  have hp : 2 ≤ p := (Fact.out : p.Prime).two_le
  refine lt_min ?_ ?_
  · nlinarith
  · have h : 1 ≤ (p - 1) * e' := Nat.mul_pos (Nat.sub_pos_of_lt hp) he
    omega

lemma le_iterate_jumpShift (ha : 1 ≤ a) (he : 1 ≤ e') (c : ℕ) : a ≤ ρ^[c] a := by
  induction c with
  | zero => exact le_rfl
  | succ c ih =>
    rw [iterate_succ_apply']
    exact ih.trans (lt_jumpShift (ha.trans ih) he).le

lemma lt_iterate_jumpShift (ha : 1 ≤ a) (he : 1 ≤ e') (hb : b ≠ 0) : a < ρ^[b] a := by
  rcases Nat.exists_eq_succ_of_ne_zero hb with ⟨b, rfl⟩
  rw [iterate_succ_apply']
  exact (le_iterate_jumpShift ha he b).trans_lt
    (lt_jumpShift (ha.trans (le_iterate_jumpShift ha he b)) he)

lemma iterate_le_iterate_jumpShift (ha : 1 ≤ a) (he : 1 ≤ e') (h : b ≤ k) : ρ^[b] a ≤ ρ^[k] a := by
  rw [← Nat.sub_add_cancel h, iterate_add_apply]
  exact le_iterate_jumpShift (ha.trans (le_iterate_jumpShift ha he b)) he _

lemma not_isJumpBase_jumpShift : ¬IsJumpBase p e' (ρ a) := by
  rintro ⟨h₁, h₂⟩
  rcases le_total a e' with h | h
  · rw [jumpShift_of_le h] at h₁
    exact h₁ (dvd_mul_right p a)
  · have h₃ : p * e' = e' + (p - 1) * e' :=
      mul_eq_add_sub_one_mul
    rw [jumpShift_of_ge h] at h₂
    omega

lemma not_isJumpBase_iterate_jumpShift (h : k ≠ 0) : ¬IsJumpBase p e' (ρ^[k] a) := by
  rcases Nat.exists_eq_succ_of_ne_zero h with ⟨k, rfl⟩
  rw [iterate_succ_apply']
  exact not_isJumpBase_jumpShift

lemma exists_jumpShift_eq (hn : 1 ≤ n) (hT : ¬IsJumpBase p e' n) (hE : n ≠ p * e') :
    ∃ a, a ≠ e' ∧ 1 ≤ a ∧ ρ a = n := by
  by_cases hlt : n < p * e'
  · have hdvd : p ∣ n :=
      by_contra fun h ↦ hT ⟨h, hlt⟩
    rcases hdvd with ⟨a, rfl⟩
    have ha : a < e' :=
      Nat.lt_of_mul_lt_mul_left hlt
    exact ⟨a, ha.ne, Nat.pos_of_ne_zero fun h ↦ by simp [h] at hn, jumpShift_of_le ha.le⟩
  · have h₁ : p * e' = e' + (p - 1) * e' :=
      mul_eq_add_sub_one_mul
    have h₂ : e' < n - (p - 1) * e' := by
      omega
    refine ⟨n - (p - 1) * e', h₂.ne', by omega, ?_⟩
    rw [jumpShift_of_ge h₂.le]
    omega

lemma eq_zero_of_eq_iterate_jumpShift (hs : IsJumpBase p e' s) (h : s = ρ^[k] s') : k = 0 :=
  by_contra fun hk ↦ not_isJumpBase_iterate_jumpShift hk (h ▸ hs)

lemma index_eq_of_iterate_eq_iterate (hs : IsJumpBase p e' s) (hs' : IsJumpBase p e' s')
    (h : ρ^[b] s = ρ^[k] s') : b = k := by
  rcases le_total b k with hbk | hkb
  · rw [← Nat.add_sub_of_le hbk, iterate_add_apply] at h
    have h₀ : k - b = 0 :=
      eq_zero_of_eq_iterate_jumpShift hs ((strictMono_iterate_jumpShift b).injective h)
    omega
  · rw [← Nat.add_sub_of_le hkb, iterate_add_apply] at h
    have h₀ : b - k = 0 :=
      eq_zero_of_eq_iterate_jumpShift hs' ((strictMono_iterate_jumpShift k).injective h).symm
    omega

lemma base_eq_of_iterate_eq_iterate (hs : IsJumpBase p e' s) (hs' : IsJumpBase p e' s')
    (h : ρ^[b] s = ρ^[k] s') : s = s' := by
  rw [index_eq_of_iterate_eq_iterate hs hs' h] at h
  exact (strictMono_iterate_jumpShift k).injective h

lemma iterate_jumpShift_of_pow_mul_le (h : p ^ b * s ≤ e') : ρ^[b] s = p ^ b * s := by
  induction b with
  | zero => simp
  | succ b ih =>
    have hle : p ^ b * s ≤ p ^ (b + 1) * s :=
      Nat.mul_le_mul_right s <| Nat.pow_le_pow_right (Fact.out : p.Prime).pos b.le_succ
    rw [iterate_succ_apply', ih (hle.trans h), jumpShift_of_le (hle.trans h), pow_succ']
    ring1

lemma index_eq_of_isJumpBase_or {r : ℕ} (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e')
    (hs : IsJumpBase p e' s ∨ s = p * e') (hs' : IsJumpBase p e' s' ∨ s' = p * e') (hb : b ≤ r)
    (hk : k ≤ r) (h : ρ^[b] s = ρ^[k] s') : b = k := by
  have hE : p * e' = ρ^[r + 1] m := by
    rw [iterate_succ_apply', hr, jumpShift_self]
  rcases hs with hs | rfl <;> rcases hs' with hs' | rfl
  · exact index_eq_of_iterate_eq_iterate hs hs' h
  · rw [hE, ← iterate_add_apply] at h
    have h₁ : b = k + (r + 1) :=
      index_eq_of_iterate_eq_iterate hs hm h
    omega
  · rw [hE, ← iterate_add_apply] at h
    have h₁ : b + (r + 1) = k :=
      index_eq_of_iterate_eq_iterate hm hs' h
    omega
  · rw [hE, ← iterate_add_apply, ← iterate_add_apply] at h
    have h₁ : b + (r + 1) = k + (r + 1) :=
      index_eq_of_iterate_eq_iterate hm hm h
    omega

end Prime

variable (G p e') in
/-- A **filtered group with Pagano's shift** `ρ`, for a prime `p` and `e' ≥ 1`: a decreasing
filtration `U n` of a commutative group `G = U 1` with zero intersection and an element `ζ` of order
dividing `p` and of level `e'`, such that the `p`-th power maps `U a` to `U (ρ a)`, is injective and
surjective on the graded pieces at `a` and `ρ(a)` for `a ≠ e'`, maps `U a` onto `U (ρ a)` for
`a > e'`, and has kernel generated by `ζ` on the graded piece at `e'`. These are the properties of
the principal units of a `p`-adic field containing a primitive `p`-th root of unity `ζ`, of absolute
ramification index `e = (p - 1) e'`, which enter the theory of its jump set (LMFDB
`lf.jump_set`). -/
structure JumpFiltration where
  /-- The steps of the filtration. -/
  U : ℕ → Subgroup G
  succ_le (n : ℕ) : U (n + 1) ≤ U n
  one_eq_top : U 1 = ⊤
  eq_one_of_forall_mem {x : G} (h : ∀ n, x ∈ U n) : x = 1
  pow_mem {a : ℕ} {x : G} (h : x ∈ U a) : x ^ p ∈ U (jumpShift p e' a)
  mem_succ_of_pow_mem {a : ℕ} {x : G} (ha : a ≠ e') (h : x ∈ U a)
    (h' : x ^ p ∈ U (jumpShift p e' a + 1)) : x ∈ U (a + 1)
  exists_eq_pow_mul {a : ℕ} {x : G} (ha : a ≠ e') (ha₁ : 1 ≤ a) (h : x ∈ U (jumpShift p e' a)) :
    ∃ y ∈ U a, ∃ x' ∈ U (jumpShift p e' a + 1), x = y ^ p * x'
  exists_eq_pow {a : ℕ} {x : G} (ha : e' < a) (h : x ∈ U (jumpShift p e' a)) : ∃ y ∈ U a, x = y ^ p
  /-- The element of order dividing `p` and level `e'`. -/
  ζ : G
  ζ_mem : ζ ∈ U e'
  ζ_notMem : ζ ∉ U (e' + 1)
  ζ_pow : ζ ^ p = 1
  exists_eq_ζ_pow_mul {z : G} (hz : z ∈ U e') (h : z ^ p ∈ U (p * e' + 1)) :
    ∃ b : ℕ, ∃ z' ∈ U (e' + 1), z = ζ ^ b * z'

namespace JumpFiltration

lemma one_le (F : JumpFiltration G p e') : 1 ≤ e' :=
  Nat.pos_of_ne_zero fun h ↦ F.ζ_notMem <| by
    subst h
    exact F.one_eq_top ▸ Subgroup.mem_top _

variable (F : JumpFiltration G p e') {x y c : G}

variable (x) in
lemma mem_one : x ∈ F.U 1 :=
  F.one_eq_top ▸ Subgroup.mem_top x

lemma mem_of_le (h : a ≤ b) (hx : x ∈ F.U b) : x ∈ F.U a :=
  antitone_nat_of_succ_le F.succ_le h hx

/-- `g` has **level** `t` in a filtered group: it lies in `U t` and not in `U (t + 1)`. -/
def IsLevel (g : G) (t : ℕ) : Prop :=
  g ∈ F.U t ∧ g ∉ F.U (t + 1)

/-- The **level** of an element `g ≠ 1` of a filtered group, the largest `t` with `g ∈ U t`
(`JumpFiltration.isLevel_level`), and `0` for `g = 1`. -/
noncomputable def level (g : G) : ℕ :=
  sInf {t | g ∉ F.U (t + 1)}

lemma exists_notMem (hx : x ≠ 1) : ∃ n, x ∉ F.U (n + 1) := by
  by_contra! h
  refine hx <| F.eq_one_of_forall_mem fun n ↦ ?_
  rcases n with _ | n
  · exact F.mem_of_le (Nat.zero_le 1) (F.mem_one x)
  · exact h n

lemma isLevel_level (hx : x ≠ 1) : F.IsLevel x (F.level x) := by
  have hne : {n | x ∉ F.U (n + 1)}.Nonempty :=
    F.exists_notMem hx
  refine ⟨?_, Nat.sInf_mem hne⟩
  rcases Nat.eq_zero_or_pos (F.level x) with h | h
  · rw [h]
    exact F.mem_of_le (Nat.zero_le 1) (F.mem_one x)
  · have hmem : F.level x - 1 ∉ {n | x ∉ F.U (n + 1)} :=
      Nat.notMem_of_lt_sInf (Nat.sub_lt h Nat.one_pos)
    simp only [Set.mem_ofPred_eq, not_not, Nat.sub_add_cancel h] at hmem
    exact hmem

variable {F}

lemma IsLevel.ne_one (h : F.IsLevel x n) : x ≠ 1 :=
  fun h₁ ↦ h.2 <| h₁ ▸ one_mem _

lemma IsLevel.pos (h : F.IsLevel x n) : 1 ≤ n :=
  Nat.pos_of_ne_zero fun h₀ ↦ h.2 <| by
    rw [h₀]
    exact F.mem_one x

lemma IsLevel.le (h : F.IsLevel x n) (hx : x ∈ F.U a) : a ≤ n :=
  not_lt.mp fun ha ↦ h.2 <| F.mem_of_le ha hx

lemma IsLevel.eq (h : F.IsLevel x a) (h' : F.IsLevel x b) : a = b :=
  (h'.le h.1).antisymm (h.le h'.1)

lemma IsLevel.level_eq (h : F.IsLevel x n) : F.level x = n :=
  (F.isLevel_level h.ne_one).eq h

lemma IsLevel.mul_of_mem (h : F.IsLevel x n) (hy : y ∈ F.U (n + 1)) : F.IsLevel (x * y) n :=
  ⟨mul_mem h.1 (F.mem_of_le n.le_succ hy),
    fun h' ↦ h.2 <| (Subgroup.mul_mem_cancel_right _ hy).mp h'⟩

lemma isLevel_of_mul_mem (h : F.IsLevel (x * y) n) (hy : y ∈ F.U (n + 1)) : F.IsLevel x n :=
  ⟨(Subgroup.mul_mem_cancel_right _ (F.mem_of_le n.le_succ hy)).mp h.1,
    fun hx ↦ h.2 <| mul_mem hx hy⟩

lemma IsLevel.pow (h : F.IsLevel x a) (ha : a ≠ e') : F.IsLevel (x ^ p) (ρ a) :=
  ⟨F.pow_mem h.1, fun h' ↦ h.2 <| F.mem_succ_of_pow_mem ha h.1 h'⟩

variable (x b) in
lemma pow_pow_succ : x ^ p ^ (b + 1) = (x ^ p ^ b) ^ p := by
  rw [pow_succ, pow_mul]

lemma pow_pow_mem (hx : x ∈ F.U a) (d : ℕ) : x ^ p ^ d ∈ F.U (ρ^[d] a) := by
  induction d with
  | zero => simpa using hx
  | succ d ih =>
    rw [pow_pow_succ, iterate_succ_apply']
    exact F.pow_mem ih

lemma IsLevel.pow_pow (h : F.IsLevel x s) (hb : ∀ i < b, ρ^[i] s ≠ e') :
    F.IsLevel (x ^ p ^ b) (ρ^[b] s) := by
  induction b with
  | zero => simpa using h
  | succ b ih =>
    rw [pow_pow_succ, iterate_succ_apply']
    exact (ih fun i hi ↦ hb i (hi.trans b.lt_succ_self)).pow (hb b b.lt_succ_self)

variable (F) in
/-- `g` is a **Miki factor** of level `t` in a filtered group with Pagano's shift (Pagano, *Jump
sets in local fields*, §1.4; LMFDB `lf.jump_set`): it has level `t`, and either `t` lies in the
complement `T` of the image of the shift, or `t = p e'` and `g` is not a `p`-th power. -/
def IsMikiAt (g : G) (t : ℕ) : Prop :=
  F.IsLevel g t ∧ (IsJumpBase p e' t ∨ t = p * e' ∧ ∀ y, g ≠ y ^ p)

lemma not_isMikiAt_one : ¬F.IsMikiAt (1 : G) s :=
  fun h ↦ h.1.ne_one rfl

variable (p) in
/-- The product `∏_{l < j} γ_l ^ p ^ l` of the factors of a factorisation of exponent below
`p ^ j`. -/
def jumpProd (γ : ℕ → G) (j : ℕ) : G :=
  ∏ l ∈ range j, γ l ^ p ^ l

variable (F) in
/-- A sequence `γ` is **reduced** below the exponent `p ^ j` at the level `t`, in a filtered group
with Pagano's shift `ρ`: its elements `γ_l`, `l < j`, are `1` or Miki factors, the levels of whose
powers `γ_l ^ p ^ l` are at least `t` and strictly decrease with `l`. -/
structure IsReduced (γ : ℕ → G) (j t : ℕ) : Prop where
  eq_one_or (l : ℕ) (hl : l < j) : γ l = 1 ∨ ∃ s, F.IsMikiAt (γ l) s ∧ t ≤ ρ^[l] s
  lt {l l' s s' : ℕ} (hl : l < l') (hl' : l' < j) (hs : F.IsMikiAt (γ l) s)
    (hs' : F.IsMikiAt (γ l') s') : ρ^[l'] s' < ρ^[l] s

variable (F) in
/-- A **Miki factorisation** of the element `ζ` of a filtered group with Pagano's shift `ρ`, with
the sequence `u` of its levels (Pagano, *Jump sets in local fields*, §1.4; LMFDB `lf.jump_set`):
`ζ = ∏_{l ≤ r} γ_l ^ p ^ l`, where each `γ_l` is `1` or a Miki factor of level `u_l`, the levels of
the elements `γ_l = 1` are filled in by `u_l = ρ(u_{l + 1})` and `ρ(u_{l + 1}) ≤ u_l` for all
`l < r`. The last condition is condition (C.1) of a jump set, and the uniqueness of the levels fails
without it. -/
structure IsMikiData (γ : ℕ → G) (u : ℕ → ℕ) (r : ℕ) : Prop where
  prod_eq : F.ζ = jumpProd p γ (r + 1)
  eq_one_or (l : ℕ) (hl : l ≤ r) : γ l = 1 ∨ F.IsMikiAt (γ l) (u l)
  eq_shift (l : ℕ) (hl : l < r) (h : γ l = 1) : u l = ρ (u (l + 1))
  shift_le (l : ℕ) (hl : l < r) : ρ (u (l + 1)) ≤ u l

variable {γ δ : ℕ → G} {u v : ℕ → ℕ} {j l r : ℕ} {y₀ R : G}

variable (γ j) in
lemma jumpProd_succ : jumpProd p γ (j + 1) = jumpProd p γ j * γ j ^ p ^ j :=
  prod_range_succ _ j

lemma jumpProd_congr (h : ∀ l < j, γ l = δ l) : jumpProd p γ j = jumpProd p δ j :=
  prod_congr rfl fun l hl ↦ by rw [h l (mem_range.mp hl)]

lemma jumpProd_eq_of_forall_eq_one (hb : b ≤ j) (h : ∀ l, b ≤ l → l < j → γ l = 1) :
    jumpProd p γ j = jumpProd p γ b := by
  induction j, hb using Nat.le_induction with
  | base => rfl
  | succ j hj ih =>
    rw [jumpProd_succ, h j hj j.lt_succ_self, one_pow, mul_one]
    exact ih fun l hl hl' ↦ h l hl (hl'.trans j.lt_succ_self)

lemma jumpProd_eq_one (h : ∀ l < j, γ l = 1) : jumpProd p γ j = 1 :=
  (jumpProd_eq_of_forall_eq_one j.zero_le fun l _ hl ↦ h l hl).trans (prod_range_zero _)

variable (γ) in
lemma exists_jumpProd_eq (hj : j ≤ k) : ∃ Y, jumpProd p γ k = jumpProd p γ j * Y ^ p ^ j := by
  refine ⟨∏ l ∈ range (k - j), γ (j + l) ^ p ^ l, ?_⟩
  rw [jumpProd, jumpProd, ← Nat.add_sub_of_le hj, prod_range_add, Nat.add_sub_cancel_left,
    ← prod_pow]
  refine congrArg _ <| prod_congr rfl fun l _ ↦ ?_
  rw [← pow_mul, ← pow_add, add_comm l j]

lemma exists_eq_jumpProd_succ (h : jumpProd p γ j ≠ 1) :
    ∃ l < j, γ l ≠ 1 ∧ jumpProd p γ j = jumpProd p γ (l + 1) := by
  induction j with
  | zero => exact absurd rfl h
  | succ j ih =>
    by_cases hj : γ j = 1
    · rw [jumpProd_succ, hj, one_pow, mul_one] at h
      rcases ih h with ⟨l, hl, hγ, hl'⟩
      refine ⟨l, hl.trans j.lt_succ_self, hγ, ?_⟩
      rw [jumpProd_succ, hj, one_pow, mul_one, hl']
    · exact ⟨j, j.lt_succ_self, hj, rfl⟩

lemma IsReduced.mono (h : F.IsReduced γ j n) (hmn : m ≤ n) : F.IsReduced γ j m :=
  ⟨fun l hl ↦ (h.eq_one_or l hl).imp id fun ⟨s, hs, hl'⟩ ↦ ⟨s, hs, hmn.trans hl'⟩, h.lt⟩

lemma IsReduced.of_update (h : F.IsReduced γ j n) (x : G) : F.IsReduced (update γ j x) j n := by
  have hne {l : ℕ} (hl : l < j) : update γ j x l = γ l :=
    update_of_ne hl.ne _ _
  refine ⟨fun l hl ↦ by simpa only [hne hl] using h.eq_one_or l hl, fun hl hl' hs hs' ↦ ?_⟩
  rw [hne (hl.trans hl')] at hs
  rw [hne hl'] at hs'
  exact h.lt hl hl' hs hs'

lemma IsMikiData.isJumpBase_or (h : F.IsMikiData γ u r) (hl : l ≤ r) (hγ : γ l ≠ 1) :
    IsJumpBase p e' (u l) ∨ u l = p * e' :=
  ((h.eq_one_or l hl).resolve_left hγ).2.imp id (·.1)

lemma IsMikiData.iterate_succ_eq (h : F.IsMikiData γ u r) (hl : l < r) (hγ : γ l = 1) :
    ρ^[l + 1] (u (l + 1)) = ρ^[l] (u l) := by
  rw [iterate_succ_apply, h.eq_shift l hl hγ]

variable (F) in
lemma ζ_pow_pow_pow (d : ℕ) (hk : k ≠ 0) : (F.ζ ^ d) ^ p ^ k = 1 := by
  rcases Nat.exists_eq_succ_of_ne_zero hk with ⟨k, rfl⟩
  have h : d * p ^ (k + 1) = p * (d * p ^ k) := by
    ring1
  rw [← pow_mul, Nat.succ_eq_add_one, h, pow_mul, F.ζ_pow, one_pow]

variable (x) in
lemma eq_zpow_mul_zpow_of_coprime {d : ℕ} (hd : p.Coprime d) :
    ∃ i j : ℤ, x = (x ^ p) ^ i * (x ^ d) ^ j := by
  rcases Nat.isCoprime_iff_coprime.mpr hd with ⟨i, j, hij⟩
  refine ⟨i, j, ?_⟩
  rw [← zpow_natCast x p, ← zpow_natCast x d, ← zpow_mul, ← zpow_mul, ← zpow_add, mul_comm (p : ℤ),
    mul_comm (d : ℤ), hij, zpow_one]

variable [Fact p.Prime]

lemma pow_mem_succ (hx : x ∈ F.U (a + 1)) : x ^ p ∈ F.U (ρ a + 1) :=
  F.mem_of_le (strictMono_jumpShift a.lt_succ_self) (F.pow_mem hx)

lemma pow_pow_mem_succ (hx : x ∈ F.U (a + 1)) (d : ℕ) : x ^ p ^ d ∈ F.U (ρ^[d] a + 1) :=
  F.mem_of_le ((strictMono_iterate_jumpShift d) a.lt_succ_self) (pow_pow_mem hx d)

lemma IsLevel.pow_pow_of_lt (h : F.IsLevel x n) (hn : e' < n) (d : ℕ) :
    F.IsLevel (x ^ p ^ d) (ρ^[d] n) :=
  h.pow_pow fun i _ ↦ (hn.trans_le (le_iterate_jumpShift h.pos F.one_le i)).ne'

lemma mem_succ_of_pow_pow_mem (ha : e' < a) (hx : x ∈ F.U a) (h : x ^ p ^ b ∈ F.U (ρ^[b] a + 1)) :
    x ∈ F.U (a + 1) := by
  by_contra hn
  exact (IsLevel.pow_pow_of_lt (F := F) ⟨hx, hn⟩ ha b).2 h

lemma exists_eq_pow_pow (ha : e' < a) (hx : x ∈ F.U (ρ^[b] a)) : ∃ y ∈ F.U a, x = y ^ p ^ b := by
  induction b generalizing x with
  | zero => exact ⟨x, by simpa using hx, by simp⟩
  | succ b ih =>
    rw [iterate_succ_apply'] at hx
    have hlt : e' < ρ^[b] a :=
      ha.trans_le (le_iterate_jumpShift (Nat.one_le_of_lt ha) F.one_le b)
    rcases F.exists_eq_pow hlt hx with ⟨y₁, hy₁, rfl⟩
    rcases ih hy₁ with ⟨y, hy, rfl⟩
    exact ⟨y, hy, by rw [pow_pow_succ]⟩

lemma IsMikiAt.mul_of_mem (h : F.IsMikiAt c s) (hy : y ∈ F.U (s + 1)) : F.IsMikiAt (c * y) s := by
  refine ⟨h.1.mul_of_mem hy, h.2.imp id ?_⟩
  rintro ⟨rfl, hc⟩
  refine ⟨rfl, fun g hg ↦ ?_⟩
  rw [← jumpShift_succ_self] at hy
  rcases F.exists_eq_pow e'.lt_succ_self hy with ⟨g', -, rfl⟩
  refine hc (g * g'⁻¹) ?_
  rw [mul_pow, inv_pow, ← hg, mul_inv_cancel_right]

lemma IsLevel.pow_of_coprime (h : F.IsLevel x n) {d : ℕ} (hd : p.Coprime d) :
    F.IsLevel (x ^ d) n := by
  refine ⟨Subgroup.pow_mem _ h.1 d, fun h' ↦ h.2 ?_⟩
  rcases eq_zpow_mul_zpow_of_coprime x hd with ⟨i, j, hij⟩
  rw [hij]
  refine mul_mem (Subgroup.zpow_mem _ (F.mem_of_le (lt_jumpShift h.pos F.one_le) (F.pow_mem h.1)) i)
    (Subgroup.zpow_mem _ h' j)

lemma IsMikiAt.pow_of_coprime (h : F.IsMikiAt x n) {d : ℕ} (hd : p.Coprime d) :
    F.IsMikiAt (x ^ d) n := by
  refine ⟨h.1.pow_of_coprime hd, h.2.imp id ?_⟩
  rintro ⟨rfl, hx⟩
  refine ⟨rfl, fun y hy ↦ ?_⟩
  rcases eq_zpow_mul_zpow_of_coprime x hd with ⟨i, j, hij⟩
  refine hx (x ^ i * y ^ j) ?_
  rw [mul_pow, ← zpow_natCast (x ^ i), ← zpow_natCast (y ^ j), ← zpow_mul, ← zpow_mul, mul_comm i,
    mul_comm j, zpow_mul, zpow_mul, zpow_natCast, zpow_natCast, ← hy]
  exact hij

lemma isLevel_of_isLevel_pow (hx : F.IsLevel (x ^ p) (p * e')) : F.IsLevel x e' := by
  have hx₁ : x ≠ 1 := fun h ↦ hx.ne_one (by rw [h, one_pow])
  have ha : F.IsLevel x (F.level x) :=
    F.isLevel_level hx₁
  by_cases he : F.level x = e'
  · rwa [he] at ha
  · have hx' : F.IsLevel (x ^ p) (ρ e') := by
      rw [jumpShift_self]
      exact hx
    exact absurd (strictMono_jumpShift.injective ((ha.pow he).eq hx')) he

/-- **The chain of an element** of a filtered group with Pagano's shift: an element `x` of level `n`
is `c ^ p ^ b x'`, with `c` a Miki factor of a level `s`, `ρ^b(s) = n` and `x'` of a higher
level. -/
lemma exists_chain (hx : F.IsLevel x n) :
    ∃ c s b x', F.IsMikiAt c s ∧ ρ^[b] s = n ∧ x' ∈ F.U (n + 1) ∧ x = c ^ p ^ b * x' := by
  induction n using Nat.strong_induction_on generalizing x with
  | _ n ih =>
    by_cases hT : IsJumpBase p e' n
    · exact ⟨x, n, 0, 1, ⟨hx, .inl hT⟩, rfl, one_mem _, by simp⟩
    by_cases hE : n = p * e'
    · by_cases hy : ∀ y, x ≠ y ^ p
      · exact ⟨x, n, 0, 1, ⟨hx, .inr ⟨hE, hy⟩⟩, rfl, one_mem _, by simp⟩
      · push Not at hy
        rcases hy with ⟨d, rfl⟩
        subst hE
        have hd : F.IsLevel d e' :=
          isLevel_of_isLevel_pow hx
        rcases ih e' (lt_prime_mul F.one_le) hd with ⟨c, s, b, d', hc, hb, hd', rfl⟩
        refine ⟨c, s, b + 1, d' ^ p, hc, ?_, ?_, ?_⟩
        · rw [iterate_succ_apply', hb, jumpShift_self]
        · rw [← jumpShift_self (p := p)]
          exact pow_mem_succ hd'
        · rw [mul_pow, pow_pow_succ]
    · rcases exists_jumpShift_eq (p := p) (e' := e') hx.pos hT hE with ⟨a, ha, ha₁, rfl⟩
      rcases F.exists_eq_pow_mul ha ha₁ hx.1 with ⟨y, hy, x₁, hx₁, rfl⟩
      have hyl : F.IsLevel y a :=
        ⟨hy, fun h ↦ hx.2 <| mul_mem (pow_mem_succ h) hx₁⟩
      rcases ih a (lt_jumpShift ha₁ F.one_le) hyl with ⟨c, s, b, y', hc, hb, hy', rfl⟩
      refine ⟨c, s, b + 1, y' ^ p * x₁, hc, ?_, mul_mem (pow_mem_succ hy') hx₁, ?_⟩
      · rw [iterate_succ_apply', hb]
      · rw [mul_pow, pow_pow_succ, mul_assoc]

variable (F) in
/-- **The reduction of an element**, the induction behind Miki's existence theorem: for `j ≤ j₀` and
`ρ^j(t) < n`, an element `x` of `U n` is a product of powers `∏_{l < j} γ_l ^ p ^ l` of a reduced
sequence at the level `n` with a `p ^ j`-th power of an element of `U (t + 1)`. -/
lemma exists_isReduced (j₀ : ℕ) : ∀ k n, e' + 1 + j₀ * ((p - 1) * e') ≤ n + k → ∀ j ≤ j₀, ∀ t,
    ρ^[j] t < n → ∀ x ∈ F.U n, ∃ γ : ℕ → G, F.IsReduced γ j n ∧ γ j ∈ F.U (t + 1) ∧
      x = jumpProd p γ j * γ j ^ p ^ j := by
  intro k
  induction k with
  | zero =>
    intro n hB j hj t ht x hx
    have hle : ρ^[j] (max (t + 1) (e' + 1)) ≤ n := by
      rw [iterate_jumpShift_of_ge (le_max_of_le_right e'.le_succ)]
      rcases le_total (t + 1) (e' + 1) with h | h
      · rw [max_eq_right h]
        exact (Nat.add_le_add_left (Nat.mul_le_mul_right _ hj) _).trans hB
      · rw [max_eq_left h]
        rw [iterate_jumpShift_of_ge (Nat.le_of_succ_le_succ h)] at ht
        omega
    rcases exists_eq_pow_pow (lt_of_lt_of_le e'.lt_succ_self (le_max_right (t + 1) (e' + 1)))
      (F.mem_of_le hle hx) with ⟨y, hy, rfl⟩
    have hne {l : ℕ} (hl : l < j) : update (1 : ℕ → G) j y l = 1 :=
      update_of_ne hl.ne _ _
    refine ⟨update 1 j y, ⟨fun l hl ↦ .inl (hne hl), ?_⟩, ?_, ?_⟩
    · intro l l' s s' hl hl' hs _
      rw [hne (hl.trans hl')] at hs
      exact absurd hs not_isMikiAt_one
    · rw [update_self]
      exact F.mem_of_le (le_max_left _ _) hy
    · rw [jumpProd_eq_one fun l hl ↦ hne hl, update_self, one_mul]
  | succ k ih =>
    intro n hB j hj t ht x hx
    have hB' : e' + 1 + j₀ * ((p - 1) * e') ≤ n + 1 + k := by
      omega
    by_cases hx₁ : x ∈ F.U (n + 1)
    · rcases ih (n + 1) hB' j hj t (ht.trans n.lt_succ_self) x hx₁ with ⟨γ, hγ, h₁, h₂⟩
      exact ⟨γ, hγ.mono n.le_succ, h₁, h₂⟩
    rcases exists_chain (F := F) ⟨hx, hx₁⟩ with ⟨c, s, b, x', hc, hb, hx', rfl⟩
    by_cases hbj : j ≤ b
    · rcases ih _ hB' j hj t (ht.trans n.lt_succ_self) x' hx' with ⟨γ, hγ, h₁, h₂⟩
      have hb' : b = j + (b - j) := by
        omega
      refine ⟨update γ j (c ^ p ^ (b - j) * γ j), (hγ.mono n.le_succ).of_update _, ?_, ?_⟩
      · rw [update_self]
        refine mul_mem (F.mem_of_le ?_ (pow_pow_mem hc.1.1 _)) h₁
        refine Nat.succ_le_of_lt <|
          (strictMono_iterate_jumpShift (p := p) (e' := e') j).lt_iff_lt.mp ?_
        rw [← iterate_add_apply, ← hb', hb]
        exact ht
      · rw [jumpProd_congr (δ := γ) fun l hl ↦ update_of_ne hl.ne _ _, update_self, mul_pow,
          ← pow_mul, ← pow_add, add_comm (b - j), ← hb', mul_left_comm, ← h₂]
    · have hbj' : b < j :=
        not_le.mp hbj
      rcases ih _ hB' b (hbj'.le.trans hj) s (hb ▸ n.lt_succ_self) x' hx' with ⟨δ, hδ, h₁, rfl⟩
      have hcδ : F.IsMikiAt (c * δ b) s :=
        hc.mul_of_mem h₁
      let γ : ℕ → G := fun l ↦ if l < b then δ l else if l = b then c * δ b else 1
      have hγ₁ {l : ℕ} (hl : l < b) : γ l = δ l :=
        ite_eq_left hl
      have hγ₂ : γ b = c * δ b := by
        simp [γ]
      have hγ₃ {l : ℕ} (hl : b < l) : γ l = 1 := by
        simp [γ, hl.ne', hl.not_gt]
      refine ⟨γ, ⟨fun l _ ↦ ?_, fun {l l' s₁ s₂} hl hl' hs₁ hs₂ ↦ ?_⟩, ?_, ?_⟩
      · rcases lt_trichotomy l b with h | rfl | h
        · rw [hγ₁ h]
          exact (hδ.eq_one_or l h).imp id fun ⟨s', hs', hl'⟩ ↦ ⟨s', hs', n.le_succ.trans hl'⟩
        · exact .inr ⟨s, hγ₂ ▸ hcδ, hb.ge⟩
        · exact .inl (hγ₃ h)
      · rcases lt_trichotomy l' b with h | rfl | h
        · rw [hγ₁ (hl.trans h)] at hs₁
          rw [hγ₁ h] at hs₂
          exact hδ.lt hl h hs₁ hs₂
        · rw [hγ₁ hl] at hs₁
          rw [hγ₂] at hs₂
          rcases hδ.eq_one_or l hl with h₁ | ⟨s', hs', hl'⟩
          · exact absurd (h₁ ▸ hs₁) not_isMikiAt_one
          · rw [hs₁.1.eq hs'.1, hs₂.1.eq hcδ.1, hb]
            exact hl'
        · rw [hγ₃ h] at hs₂
          exact absurd hs₂ not_isMikiAt_one
      · rw [hγ₃ hbj']
        exact one_mem _
      · rw [hγ₃ hbj', one_pow, mul_one, jumpProd_eq_of_forall_eq_one (b := b + 1) hbj'
          fun l hl _ ↦ hγ₃ hl, jumpProd_succ, jumpProd_congr fun l hl ↦ hγ₁ hl, hγ₂, mul_pow]
        exact mul_left_comm _ _ _

lemma exists_isMikiData_aux (hγ : F.IsReduced γ r (e' + 1)) (hm : F.IsMikiAt (γ r) m)
    (hr : ρ^[r] m = e') (hu : ∀ l ≤ r, γ l ≠ 1 → u l = F.level (γ l))
    (hu' : ∀ l < r, γ l = 1 → u l = ρ (u (l + 1))) (hl : l < r) : ρ (u (l + 1)) ≤ u l := by
  have hmiki {l : ℕ} (hl : l < r) (hl₁ : γ l ≠ 1) : F.IsMikiAt (γ l) (u l) := by
    rcases (hγ.eq_one_or l hl).resolve_left hl₁ with ⟨s, hs, -⟩
    rwa [hu l hl.le hl₁, hs.1.level_eq]
  have hinv : ∀ d ≤ r, ∃ l₀ s, r - d ≤ l₀ ∧ l₀ ≤ r ∧ F.IsMikiAt (γ l₀) s ∧
      u (r - d) = ρ^[l₀ - (r - d)] s := by
    intro d
    induction d with
    | zero =>
      intro _
      refine ⟨r, m, le_rfl, le_rfl, hm, ?_⟩
      simp [hu r le_rfl hm.1.ne_one, hm.1.level_eq]
    | succ d ih =>
      intro hd
      rcases ih (Nat.le_of_succ_le hd) with ⟨l₀, s, h₁, h₂, hs, hs'⟩
      have hsucc : r - d = r - (d + 1) + 1 := by
        omega
      by_cases hl₁ : γ (r - (d + 1)) = 1
      · refine ⟨l₀, s, by omega, h₂, hs, ?_⟩
        have hsub : l₀ - (r - (d + 1)) = l₀ - (r - d) + 1 := by
          omega
        rw [hu' _ (by omega) hl₁, ← hsucc, hs', hsub, iterate_succ_apply']
      · exact ⟨r - (d + 1), u (r - (d + 1)), le_rfl, by omega, hmiki (by omega) hl₁, by simp⟩
  rcases hinv (r - (l + 1)) (Nat.sub_le _ _) with ⟨l₀, s, h₁, h₂, hs, hs'⟩
  have hsub : r - (r - (l + 1)) = l + 1 := by
    omega
  rw [hsub] at h₁ hs'
  by_cases hl₁ : γ l = 1
  · exact (hu' l hl hl₁).ge
  have hlt : ρ^[l₀] s < ρ^[l] (u l) := by
    rcases h₂.lt_or_eq with h₃ | rfl
    · exact hγ.lt (Nat.lt_of_succ_le h₁) h₃ (hmiki hl hl₁) hs
    · rcases (hγ.eq_one_or l hl).resolve_left hl₁ with ⟨s', hs₁, hs₂⟩
      rw [hs.1.eq hm.1, hr, (hmiki hl hl₁).1.eq hs₁.1]
      exact hs₂
  have hadd : l₀ = l + (l₀ - (l + 1) + 1) := by
    omega
  rw [hadd, iterate_add_apply, iterate_succ_apply'] at hlt
  rw [hs']
  exact ((strictMono_iterate_jumpShift l).lt_iff_lt.mp hlt).le

variable (F) in
/-- **Miki's existence theorem** (Miki, *On the ramification numbers of cyclic `p`-extensions over
local fields*, Lemma 17, as quoted by Pagano, *Jump sets in local fields*, §1.4; LMFDB
`lf.jump_set`): in a filtered group with Pagano's shift `ρ`, for `e' = ρ^r(m)` with `m` in `T`, the
element `ζ` has a factorisation `∏_{l ≤ r} γ_l ^ p ^ l` into Miki factors whose levels `u_l`, filled
in by `u_l = ρ(u_{l + 1})` where `γ_l = 1`, satisfy `ρ(u_{l + 1}) ≤ u_l`. -/
lemma exists_forall_isMikiData (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e') : ∃ γ : ℕ → G,
    ∀ u : ℕ → ℕ, (∀ l ≤ r, γ l ≠ 1 → u l = F.level (γ l)) →
      (∀ l < r, γ l = 1 → u l = ρ (u (l + 1))) → F.IsMikiData γ u r := by
  rcases exists_chain (F := F) ⟨F.ζ_mem, F.ζ_notMem⟩ with ⟨c, s, b, x', hc, hb, hx', hζ⟩
  have hs : IsJumpBase p e' s := by
    refine hc.2.resolve_right ?_
    rintro ⟨rfl, -⟩
    have hlt : e' < ρ^[b] (p * e') :=
      (lt_prime_mul F.one_le).trans_le (le_iterate_jumpShift hc.1.pos F.one_le b)
    exact hlt.ne' hb
  have hsm : s = m :=
    base_eq_of_iterate_eq_iterate hs hm (hb.trans hr.symm)
  have hbr : b = r :=
    index_eq_of_iterate_eq_iterate hs hm (hb.trans hr.symm)
  subst hsm hbr
  rcases F.exists_isReduced b (b * ((p - 1) * e')) (e' + 1) le_rfl b le_rfl s
    (hb.trans_lt e'.lt_succ_self) x' hx' with ⟨γ', hγ', h₁, h₂⟩
  refine ⟨update γ' b (c * γ' b), fun u hu hu' ↦ ?_⟩
  have hγ : F.IsReduced (update γ' b (c * γ' b)) b (e' + 1) :=
    hγ'.of_update _
  have htop : F.IsMikiAt (update γ' b (c * γ' b) b) s := by
    rw [update_self]
    exact hc.mul_of_mem h₁
  refine ⟨?_, fun l hl ↦ ?_, hu', fun _ hl ↦ exists_isMikiData_aux hγ htop hr hu hu' hl⟩
  · rw [hζ, jumpProd_succ, jumpProd_congr (δ := γ') fun l hl ↦ update_of_ne hl.ne _ _, update_self,
      mul_pow, h₂, mul_left_comm]
  · by_cases hl₁ : update γ' b (c * γ' b) l = 1
    · exact .inl hl₁
    refine .inr ?_
    rw [hu l hl hl₁]
    rcases hl.lt_or_eq with h | rfl
    · rcases (hγ.eq_one_or l h).resolve_left hl₁ with ⟨s', hs', -⟩
      rwa [hs'.1.level_eq]
    · rwa [htop.1.level_eq]

/-- **The crossing of the level `e'`**: if `ζ = y ^ p ^ j R` with `R ∈ U L`, then for `a ≤ j` an
element `x = c ^ p ^ a R''` of level `ν < L`, `R'' ∈ U L`, is `c' ^ p ^ a h` for an element `c'` of
level `t` with `ρ^a(t) = ν` and an `h` of a higher level. So `p ^ a`-th powers modulo `U L` have the
levels `ρ^a(t)`, even though the `p`-th power of an element may jump at the level `e'` because of
`ζ`. -/
lemma exists_eq_pow_pow_mul_of_isLevel {L : ℕ} (hζ : F.ζ = y₀ ^ p ^ j * R) (hR : R ∈ F.U L) :
    a ≤ j → ∀ (x c R'' : G) (ν : ℕ), R'' ∈ F.U L → x = c ^ p ^ a * R'' → F.IsLevel x ν → ν < L →
      ∃ c' t h, F.IsLevel c' t ∧ ρ^[a] t = ν ∧ h ∈ F.U (ν + 1) ∧ x = c' ^ p ^ a * h := by
  induction a using Nat.strong_induction_on with
  | _ a ih =>
    intro ha x c R'' ν hR'' hx hν hνL
    have hR''ν : R'' ∈ F.U (ν + 1) :=
      F.mem_of_le hνL hR''
    have hc : c ≠ 1 := by
      rintro rfl
      rw [one_pow, one_mul] at hx
      exact hν.2 (hx ▸ hR''ν)
    have ht : F.IsLevel c (F.level c) :=
      F.isLevel_level hc
    by_cases hcross : ∃ i < a, F.IsLevel (c ^ p ^ i) e' ∧ (c ^ p ^ i) ^ p ∈ F.U (p * e' + 1)
    · rcases hcross with ⟨i, hi, hzl, hzp⟩
      rcases F.exists_eq_ζ_pow_mul hzl.1 hzp with ⟨b, z', hz', hz⟩
      have hai : p ^ a = p ^ i * p ^ (a - i) := by
        rw [← pow_add, Nat.add_sub_of_le hi.le]
      have hne : a - i ≠ 0 := by
        omega
      have hxz : x = z' ^ p ^ (a - i) * R'' := by
        rw [hx, hai, pow_mul, hz, mul_pow, ζ_pow_pow_pow F b hne, one_mul]
      have hz'1 : z' ≠ 1 := by
        rintro rfl
        rw [one_pow, one_mul] at hxz
        exact hν.2 (hxz ▸ hR''ν)
      have hz'l : F.IsLevel z' (F.level z') :=
        F.isLevel_level hz'1
      have hiter : ρ^[a - i] (F.level z') = ν :=
        (hz'l.pow_pow_of_lt (Nat.lt_of_succ_le (hz'l.le hz')) (a - i)).eq
          (isLevel_of_mul_mem (hxz ▸ hν) hR''ν)
      have hlt : F.level z' < ν :=
        hiter ▸ lt_iterate_jumpShift hz'l.pos F.one_le hne
      have hj' : p ^ j = p ^ i * p ^ (j - i) := by
        rw [← pow_add, Nat.add_sub_of_le (hi.le.trans ha)]
      have hy : (y₀ ^ (p ^ (j - i) * b)) ^ p ^ i = (y₀ ^ p ^ j) ^ b := by
        rw [← pow_mul, ← pow_mul, hj']
        congr 1
        ring1
      have hrel : z' = (c * (y₀ ^ (p ^ (j - i) * b))⁻¹) ^ p ^ i * (R ^ b)⁻¹ := by
        rw [mul_pow, inv_pow, hz, hζ, mul_pow, hy, mul_assoc _ _ z', mul_comm _ (_ * z'),
          mul_inv_cancel_right, mul_comm _ z', mul_inv_cancel_right]
      rcases ih i hi (hi.le.trans ha) z' _ _ (F.level z') (inv_mem (Subgroup.pow_mem _ hR b)) hrel
        hz'l (hlt.trans hνL) with ⟨c', t, h', hc', ht', hh', hz'eq⟩
      refine ⟨c', t, h' ^ p ^ (a - i) * R'', hc', ?_, mul_mem ?_ hR''ν, ?_⟩
      · rw [← hiter, ← ht', ← iterate_add_apply, Nat.sub_add_cancel hi.le]
      · rw [← hiter]
        exact pow_pow_mem_succ hh' _
      · rw [hxz, hz'eq, mul_pow, ← pow_mul, ← hai, mul_assoc]
    · push Not at hcross
      have hlev : ∀ i ≤ a, F.IsLevel (c ^ p ^ i) (ρ^[i] (F.level c)) := by
        intro i
        induction i with
        | zero =>
          intro _
          simpa using ht
        | succ i ih' =>
          intro hi
          have hz : F.IsLevel (c ^ p ^ i) (ρ^[i] (F.level c)) :=
            ih' (Nat.le_of_succ_le hi)
          rw [pow_pow_succ, iterate_succ_apply']
          by_cases he : ρ^[i] (F.level c) = e'
          · rw [he] at hz ⊢
            rw [jumpShift_self]
            refine ⟨?_, hcross i (Nat.lt_of_succ_le hi) hz⟩
            rw [← jumpShift_self (p := p)]
            exact F.pow_mem hz.1
          · exact hz.pow he
      exact ⟨c, F.level c, R'', ht, (hlev a le_rfl).eq (isLevel_of_mul_mem (hx ▸ hν) hR''ν), hR''ν,
        hx⟩

lemma IsMikiData.isLevel_pow (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e')
    (hl : l ≤ r) (hγ : γ l ≠ 1) : F.IsLevel (γ l ^ p ^ l) (ρ^[l] (u l)) := by
  rcases (h.eq_one_or l hl).resolve_left hγ with ⟨hlev, hT | ⟨hE, -⟩⟩
  · refine hlev.pow_pow fun i hi hi' ↦ ?_
    have hir : i = r :=
      index_eq_of_iterate_eq_iterate hT hm (hi'.trans hr.symm)
    omega
  · exact hlev.pow_pow_of_lt (hE ▸ lt_prime_mul F.one_le) l

lemma IsMikiData.exists_isLevel_jumpProd (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m)
    (hr : ρ^[r] m = e') : j ≤ r + 1 → jumpProd p γ j = 1 ∨ ∃ l < j, γ l ≠ 1 ∧
      F.IsLevel (jumpProd p γ j) (ρ^[l] (u l)) := by
  induction j with
  | zero => exact fun _ ↦ .inl rfl
  | succ j ih =>
    intro hj
    rw [jumpProd_succ]
    have hj' : j ≤ r :=
      Nat.le_of_succ_le_succ hj
    by_cases hγ : γ j = 1
    · rw [hγ, one_pow, mul_one]
      exact (ih (Nat.le_of_succ_le hj)).imp id
        fun ⟨l, hl, h₁, h₂⟩ ↦ ⟨l, hl.trans j.lt_succ_self, h₁, h₂⟩
    have hV : F.IsLevel (γ j ^ p ^ j) (ρ^[j] (u j)) :=
      h.isLevel_pow hm hr hj' hγ
    refine .inr ?_
    rcases ih (Nat.le_of_succ_le hj) with h₁ | ⟨l₀, hl₀, hγ₀, hV₀⟩
    · exact ⟨j, j.lt_succ_self, hγ, by rwa [h₁, one_mul]⟩
    rcases lt_trichotomy (ρ^[l₀] (u l₀)) (ρ^[j] (u j)) with hlt | heq | hlt
    · exact ⟨l₀, hl₀.trans j.lt_succ_self, hγ₀, hV₀.mul_of_mem (F.mem_of_le hlt hV.1)⟩
    · have hl₀j : l₀ = j :=
        index_eq_of_isJumpBase_or hm hr (h.isJumpBase_or (hl₀.le.trans hj') hγ₀)
          (h.isJumpBase_or hj' hγ) (hl₀.le.trans hj') hj' heq
      omega
    · refine ⟨j, j.lt_succ_self, hγ, ?_⟩
      rw [mul_comm]
      exact hV.mul_of_mem (F.mem_of_le hlt hV₀.1)

lemma IsMikiData.exists_iterate_eq (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m)
    (hr : ρ^[r] m = e') : ∃ l ≤ r, γ l ≠ 1 ∧ ρ^[l] (u l) = e' := by
  rcases h.exists_isLevel_jumpProd hm hr le_rfl with h₁ | ⟨l, hl, hγ, hV⟩
  · exact absurd (h.prod_eq.trans h₁ ▸ one_mem _) F.ζ_notMem
  · rw [← h.prod_eq] at hV
    exact ⟨l, Nat.lt_succ_iff.mp hl, hγ, hV.eq ⟨F.ζ_mem, F.ζ_notMem⟩⟩

lemma IsMikiData.isJumpBase_of_iterate_eq (h : F.IsMikiData γ u r) (hl : l ≤ r) (hγ : γ l ≠ 1)
    (hV : ρ^[l] (u l) = e') : IsJumpBase p e' (u l) := by
  refine (h.isJumpBase_or hl hγ).resolve_right fun hE ↦ ?_
  have hlt : e' < ρ^[l] (u l) := by
    rw [hE]
    exact (lt_prime_mul F.one_le).trans_le
      (le_iterate_jumpShift (F.one_le.trans (lt_prime_mul F.one_le).le) F.one_le l)
  exact hlt.ne' hV

/-- **The top factor of a Miki factorisation**: `γ_r ≠ 1`. -/
lemma IsMikiData.ne_one_top (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e') :
    γ r ≠ 1 := by
  rcases h.exists_iterate_eq hm hr with ⟨l, hl, hγ, hV⟩
  rwa [index_eq_of_iterate_eq_iterate (h.isJumpBase_of_iterate_eq hl hγ hV) hm (hV.trans hr.symm)]
    at hγ

/-- **The level of the top factor of a Miki factorisation** is `m`, for `e' = ρ^r(m)`. -/
lemma IsMikiData.eq_top (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e') :
    u r = m := by
  rcases h.exists_iterate_eq hm hr with ⟨l, hl, hγ, hV⟩
  have hT : IsJumpBase p e' (u l) :=
    h.isJumpBase_of_iterate_eq hl hγ hV
  have hlr : l = r :=
    index_eq_of_iterate_eq_iterate hT hm (hV.trans hr.symm)
  subst hlr
  exact base_eq_of_iterate_eq_iterate hT hm (hV.trans hr.symm)

lemma IsMikiData.ne_iterate (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e')
    (d : ℕ) : d ≤ r → ∀ k, d < k → k ≤ r → u (r - d) ≠ ρ^[k] m := by
  induction d with
  | zero =>
    intro _ k hk _ heq
    rw [Nat.sub_zero, h.eq_top hm hr] at heq
    exact (lt_iterate_jumpShift hm.pos F.one_le hk.ne').ne heq
  | succ d ih =>
    intro hd k hk hkr heq
    have hsucc : r - d = r - (d + 1) + 1 := by
      omega
    rcases Nat.exists_eq_succ_of_ne_zero (by omega : k ≠ 0) with ⟨k, rfl⟩
    rw [iterate_succ_apply'] at heq
    by_cases hγ : γ (r - (d + 1)) = 1
    · rw [h.eq_shift _ (by omega) hγ, ← hsucc] at heq
      exact ih (Nat.le_of_succ_le hd) k (by omega) (by omega)
        (strictMono_jumpShift.injective heq)
    · rcases ((h.eq_one_or _ (Nat.sub_le _ _)).resolve_left hγ).2 with hT | ⟨hE, -⟩
      · rw [heq] at hT
        exact not_isJumpBase_jumpShift hT
      · rw [hE, ← iterate_succ_apply' (jumpShift p e')] at heq
        exact not_lt.mpr
          (heq.le.trans ((iterate_le_iterate_jumpShift hm.pos F.one_le hkr).trans hr.le))
          (lt_prime_mul F.one_le)

lemma IsMikiData.shift_lt (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e')
    (hl : l < r) (hγ : γ l ≠ 1) : ρ (u (l + 1)) < u l := by
  refine (h.shift_le l hl).lt_of_ne fun heq ↦ ?_
  rcases ((h.eq_one_or l hl.le).resolve_left hγ).2 with hT | ⟨hE, -⟩
  · exact not_isJumpBase_jumpShift (heq ▸ hT)
  · rw [hE, ← jumpShift_self (p := p)] at heq
    have he : u (l + 1) = e' :=
      strictMono_jumpShift.injective heq
    refine h.ne_iterate hm hr (r - (l + 1)) (Nat.sub_le _ _) r (by omega) le_rfl ?_
    rw [Nat.sub_sub_self hl, he, hr]

lemma IsMikiData.iterate_succ_le (h : F.IsMikiData γ u r) (hl : l < r) :
    ρ^[l + 1] (u (l + 1)) ≤ ρ^[l] (u l) := by
  rw [iterate_succ_apply]
  exact (strictMono_iterate_jumpShift l).monotone (h.shift_le l hl)

lemma IsMikiData.iterate_succ_lt (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m)
    (hr : ρ^[r] m = e') (hl : l < r) (hγ : γ l ≠ 1) : ρ^[l + 1] (u (l + 1)) < ρ^[l] (u l) := by
  rw [iterate_succ_apply]
  exact strictMono_iterate_jumpShift l (h.shift_lt hm hr hl hγ)

lemma IsMikiData.jumpProd_mem (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m)
    (hr : ρ^[r] m = e') : j ≤ r → jumpProd p γ j ∈ F.U (ρ^[j] (u j) + 1) := by
  induction j with
  | zero => exact fun _ ↦ one_mem _
  | succ j ih =>
    intro hj
    have hj' : j < r :=
      Nat.lt_of_succ_le hj
    rw [jumpProd_succ]
    by_cases hγ : γ j = 1
    · rw [hγ, one_pow, mul_one, h.iterate_succ_eq hj' hγ]
      exact ih hj'.le
    · have hlt : ρ^[j + 1] (u (j + 1)) < ρ^[j] (u j) :=
        h.iterate_succ_lt hm hr hj' hγ
      exact mul_mem (F.mem_of_le (Nat.succ_le_succ hlt.le) (ih hj'.le))
        (F.mem_of_le hlt (h.isLevel_pow hm hr hj'.le hγ).1)

lemma IsMikiData.isLevel_jumpProd_succ (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m)
    (hr : ρ^[r] m = e') (hj : j ≤ r) (hγ : γ j ≠ 1) :
    F.IsLevel (jumpProd p γ (j + 1)) (ρ^[j] (u j)) := by
  rw [jumpProd_succ, mul_comm]
  exact (h.isLevel_pow hm hr hj hγ).mul_of_mem (h.jumpProd_mem hm hr hj)

/-- **The level of a partial product of a Miki factorisation is maximal**: for `j ≤ r`, if
`ζ = y ^ p ^ j R` with `R ∈ U n`, then `∏_{l < j} γ_l ^ p ^ l ∈ U n`. So this level is the largest
level of a quotient of `ζ` by a `p ^ j`-th power, which does not depend on the factorisation. -/
lemma IsMikiData.mem_of_eq_pow_pow_mul (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m)
    (hr : ρ^[r] m = e') (hj : j ≤ r) (hζ : F.ζ = y₀ ^ p ^ j * R) (hR : R ∈ F.U n) :
    jumpProd p γ j ∈ F.U n := by
  by_contra hx
  have hne : jumpProd p γ j ≠ 1 := fun h₁ ↦ hx (h₁ ▸ one_mem _)
  rcases exists_eq_jumpProd_succ hne with ⟨l, hl, hγl, hprod⟩
  have hlr : l ≤ r :=
    hl.le.trans hj
  have hlev : F.IsLevel (jumpProd p γ j) (ρ^[l] (u l)) := by
    rw [hprod]
    exact h.isLevel_jumpProd_succ hm hr hlr hγl
  have hνn : ρ^[l] (u l) < n :=
    not_le.mp fun hn ↦ hx <| F.mem_of_le hn hlev.1
  rcases exists_jumpProd_eq (p := p) γ (hj.trans r.le_succ) with ⟨Y, hY⟩
  have hx' : jumpProd p γ j = (y₀ * Y⁻¹) ^ p ^ j * R := by
    have h₁ : jumpProd p γ j * Y ^ p ^ j = y₀ ^ p ^ j * R := by
      rw [← hY, ← h.prod_eq, hζ]
    rw [mul_pow, inv_pow, mul_right_comm, ← h₁, mul_inv_cancel_right]
  rcases exists_eq_pow_pow_mul_of_isLevel hζ hR le_rfl _ _ _ _ hR hx' hlev hνn with
    ⟨c', t, h', hc', ht, hh', heq⟩
  have hlj : j = l + (j - l) := by
    omega
  have hk : j - l ≠ 0 := by
    omega
  have hρ : ρ^[j - l] t = u l := by
    rw [hlj, iterate_add_apply] at ht
    exact (strictMono_iterate_jumpShift (p := p) (e' := e') l).injective ht
  rcases ((h.eq_one_or l hlr).resolve_left hγl).2 with hT | ⟨hE, hnp⟩
  · exact not_isJumpBase_iterate_jumpShift hk (hρ ▸ hT)
  have hc'' : c' ^ p ^ (j - l) ∈ F.U (p * e') := by
    rw [← hE, ← hρ]
    exact pow_pow_mem hc'.1 _
  have hγmem : γ l ∈ F.U (p * e') := by
    rw [← hE]
    exact ((h.eq_one_or l hlr).resolve_left hγl).1.1
  have hq : γ l * (c' ^ p ^ (j - l))⁻¹ ∈ F.U (p * e') :=
    mul_mem hγmem (inv_mem hc'')
  have hprod' : jumpProd p γ l * γ l ^ p ^ l = c' ^ p ^ j * h' := by
    rw [← jumpProd_succ, ← hprod, heq]
  have hqp : (γ l * (c' ^ p ^ (j - l))⁻¹) ^ p ^ l ∈ F.U (ρ^[l] (p * e') + 1) := by
    have hpow : (γ l * (c' ^ p ^ (j - l))⁻¹) ^ p ^ l = h' * (jumpProd p γ l)⁻¹ := by
      have hcp : (c' ^ p ^ (j - l)) ^ p ^ l = c' ^ p ^ j := by
        rw [← pow_mul, ← pow_add, add_comm, ← hlj]
      rw [mul_pow, inv_pow, hcp, eq_mul_inv_iff_mul_eq, mul_right_comm, mul_comm (γ l ^ p ^ l),
        hprod', mul_comm (c' ^ p ^ j), mul_inv_cancel_right]
    rw [hpow, ← hE]
    exact mul_mem hh' (inv_mem (h.jumpProd_mem hm hr hlr))
  have hq₁ : γ l * (c' ^ p ^ (j - l))⁻¹ ∈ F.U (p * e' + 1) :=
    mem_succ_of_pow_pow_mem (lt_prime_mul F.one_le) hq hqp
  rw [← jumpShift_succ_self] at hq₁
  rcases F.exists_eq_pow e'.lt_succ_self hq₁ with ⟨g, -, hg⟩
  rcases Nat.exists_eq_succ_of_ne_zero hk with ⟨k', hk'⟩
  refine hnp (g * c' ^ p ^ k') ?_
  rw [mul_pow, ← hg, ← pow_pow_succ, ← Nat.succ_eq_add_one, ← hk', inv_mul_cancel_right]

lemma IsMikiData.mem_jumpProd_of_mem (h : F.IsMikiData γ u r) (h' : F.IsMikiData δ v r)
    (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e') (hj : j ≤ r) (hmem : jumpProd p γ j ∈ F.U n) :
    jumpProd p δ j ∈ F.U n := by
  rcases exists_jumpProd_eq (p := p) γ (hj.trans r.le_succ) with ⟨Y, hY⟩
  refine h'.mem_of_eq_pow_pow_mul hm hr hj (y₀ := Y) (R := jumpProd p γ j) ?_ hmem
  rw [h.prod_eq, hY, mul_comm]

lemma IsMikiData.eq_one_of_eq_one (h : F.IsMikiData γ u r) (h' : F.IsMikiData δ v r)
    (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e') (hl : l < r) (hγ : γ l = 1) : δ l = 1 := by
  by_contra hδ
  refine (h'.isLevel_jumpProd_succ hm hr hl.le hδ).2 <|
    h.mem_jumpProd_of_mem h' hm hr (Nat.succ_le_of_lt hl) ?_
  rw [jumpProd_succ, hγ, one_pow, mul_one]
  exact h'.mem_jumpProd_of_mem h hm hr hl.le (h'.jumpProd_mem hm hr hl.le)

/-- **The uniqueness of the levels of a Miki factorisation** (Miki, Lemma 17, as quoted by Pagano,
*Jump sets in local fields*, §1.4; LMFDB `lf.jump_set`): in a filtered group with Pagano's shift
`ρ`, for `e' = ρ^r(m)` with `m` in `T`, two Miki factorisations of `ζ` have the same sequence of
levels. -/
lemma IsMikiData.eq (h : F.IsMikiData γ u r) (h' : F.IsMikiData δ v r) (hm : IsJumpBase p e' m)
    (hr : ρ^[r] m = e') (hl : l ≤ r) : u l = v l := by
  have hd : ∀ d ≤ r, u (r - d) = v (r - d) := by
    intro d
    induction d with
    | zero =>
      intro _
      rw [Nat.sub_zero, h.eq_top hm hr, h'.eq_top hm hr]
    | succ d ih =>
      intro hd
      have hsucc : r - d = r - (d + 1) + 1 := by
        omega
      have hlt : r - (d + 1) < r := by
        omega
      have hih : u (r - (d + 1) + 1) = v (r - (d + 1) + 1) := by
        rw [← hsucc]
        exact ih (Nat.le_of_succ_le hd)
      generalize r - (d + 1) = l at hlt hih ⊢
      by_cases hγ : γ l = 1
      · rw [h.eq_shift l hlt hγ, h'.eq_shift l hlt (h.eq_one_of_eq_one h' hm hr hlt hγ), hih]
      · have hδ : δ l ≠ 1 := fun hδ ↦ hγ (h'.eq_one_of_eq_one h hm hr hlt hδ)
        have hγl : F.IsLevel (jumpProd p γ (l + 1)) (ρ^[l] (u l)) :=
          h.isLevel_jumpProd_succ hm hr hlt.le hγ
        have hδl : F.IsLevel (jumpProd p δ (l + 1)) (ρ^[l] (v l)) :=
          h'.isLevel_jumpProd_succ hm hr hlt.le hδ
        have hle : Nat.succ l ≤ r :=
          Nat.succ_le_of_lt hlt
        refine (strictMono_iterate_jumpShift (p := p) (e' := e') l).injective <|
          IsLevel.eq (F := F) (x := jumpProd p γ (l + 1)) hγl
            ⟨h'.mem_jumpProd_of_mem h hm hr hle hδl.1, fun hn ↦ hδl.2 ?_⟩
        exact h.mem_jumpProd_of_mem h' hm hr hle hn
  have hsub : r - (r - l) = l := by
    omega
  rw [← hsub]
  exact hd (r - l) (Nat.sub_le _ _)

/-- **The levels of a Miki factorisation are positive.** -/
lemma IsMikiData.one_le (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e')
    (hl : l ≤ r) : 1 ≤ u l := by
  have hd : ∀ d ≤ r, 1 ≤ u (r - d) := by
    intro d
    induction d with
    | zero =>
      intro _
      rw [Nat.sub_zero, h.eq_top hm hr]
      exact hm.pos
    | succ d ih =>
      intro hd
      have hsucc : r - (d + 1) + 1 = r - d := by
        omega
      have hle : ρ (u (r - d)) ≤ u (r - (d + 1)) := by
        rw [← hsucc]
        exact h.shift_le _ (by omega)
      exact (ih (Nat.le_of_succ_le hd)).trans <|
        (lt_jumpShift (ih (Nat.le_of_succ_le hd)) F.one_le).le.trans hle
  rw [← Nat.sub_sub_self hl]
  exact hd (r - l) (Nat.sub_le _ _)

/-- **The levels of a Miki factorisation increase with the slot**: `u_{l + 1} < u_l`. -/
lemma IsMikiData.lt_succ (h : F.IsMikiData γ u r) (hm : IsJumpBase p e' m) (hr : ρ^[r] m = e')
    (hl : l < r) : u (l + 1) < u l :=
  (lt_jumpShift (h.one_le hm hr (Nat.succ_le_of_lt hl)) F.one_le).trans_le (h.shift_le l hl)

end JumpFiltration

end IsNonarchimedeanLocalField
