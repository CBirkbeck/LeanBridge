import LeanBridge.ForMathlib.RingTheory.IsAdjoinRootPrimitive
import Mathlib.Analysis.Normed.Field.Approximation
import Mathlib.Analysis.Normed.Field.Krasner
import Mathlib.NumberTheory.Padics.Complex
import Mathlib.NumberTheory.Padics.PadicIntegers
import Mathlib.RingTheory.Localization.Integral
import Mathlib.RingTheory.Polynomial.IntegralNormalization

/-!
# Integral defining polynomials of `p`-adic fields

A defining polynomial of a `p`-adic field `K` (LMFDB `lf.defining_polynomial`) is an irreducible
`f ∈ ℚ_p[x]` with `K ≅ ℚ_p(a)` for a root `a` of `f`, that is `IsAdjoinRoot K f`. The LMFDB notes
that it can be chosen monic with coefficients in `ℤ_p` and, by Krasner's lemma, in `ℤ`. This file
proves both.

Let `a` be a primitive element of `K`, embedded in `ℚ̄_p` (Mathlib's `PadicAlgCl p`, with the
spectral norm). Approximate its minimal polynomial by a monic `g ∈ ℚ[x]` of the same degree, `ℚ`
being dense in `ℚ_p`. By the continuity of roots, `g` has a root `β` closer to `a` than every other
conjugate of `a`, so `a ∈ ℚ_p(β)` by Krasner's lemma (Mathlib's `IsKrasner`), and `ℚ_p(β) = ℚ_p(a)`,
both of degree `deg g`; this follows the proof of Mathlib's `IsAlgClosed.of_denseRange`. So `β` is
the image of a generator `b` of `K` with `g(b) = 0`. Clearing the denominators of `g` and making it
monic gives `f ∈ ℤ[x]` with a root `d b`, `d ∈ ℤ` nonzero, which generates `K`; `f` has degree at
most `[K : ℚ_p]`, so it is the minimal polynomial of `d b`.

## Main results

* `Padic.exists_ratPolynomial_adjoin_simple_eq`: every simple extension `ℚ_p(α) ⊆ ℚ̄_p` is
  generated by a root of a monic polynomial in `ℚ[x]` of degree `[ℚ_p(α) : ℚ_p]`.
* `Padic.exists_monic_nonempty_isAdjoinRoot` (LMFDB `lf.defining_polynomial`): every finite
  extension of `ℚ_p` has a monic defining polynomial with coefficients in `ℤ`.
* `Padic.exists_monic_nonempty_isAdjoinRoot_padicInt` (LMFDB `lf.defining_polynomial`): every
  finite extension of `ℚ_p` has a monic defining polynomial with coefficients in `ℤ_p`.
-/

open IntermediateField Module Polynomial

namespace Padic

variable {p : ℕ} [Fact p.Prime]

open Algebra in
/-- **Approximation by a rational polynomial**: every `α ∈ ℚ̄_p` generates the same field over `ℚ_p`
as a root `β` of a monic polynomial `g ∈ ℚ[x]` of degree `[ℚ_p(α) : ℚ_p]`. The polynomial `g`
approximates the minimal polynomial of `α`, and `α ∈ ℚ_p(β)` by Krasner's lemma. -/
lemma exists_ratPolynomial_adjoin_simple_eq (α : PadicAlgCl p) : ∃ g : ℚ[X], g.Monic ∧ g.natDegree =
    (minpoly ℚ_[p] α).natDegree ∧ ∃ β : PadicAlgCl p, aeval β g = 0 ∧ ℚ_[p]⟮β⟯ = ℚ_[p]⟮α⟯ := by
  have hint : IsIntegral ℚ_[p] α := IsIntegral.isIntegral α
  have fmon : (minpoly ℚ_[p] α).Monic := minpoly.monic hint
  have fnatdeg0 : (minpoly ℚ_[p] α).natDegree ≠ 0 := (minpoly.natDegree_pos hint).ne'
  classical
  let S : Finset (PadicAlgCl p) :=
    {x ∈ ((minpoly ℚ_[p] α).rootSet (PadicAlgCl p)).toFinset | x ≠ α}
  let δ : ℝ := if hS : S.Nonempty then (S.image fun x ↦ ‖α - x‖).min'
    (Finset.image_nonempty.mpr hS) else 1
  have norm_sub_le (α' : PadicAlgCl p) (conj : IsConjRoot ℚ_[p] α α') (ne : α ≠ α') :
      δ ≤ ‖α - α'‖ := by
    have hmem : α' ∈ S := by
      simp only [Finset.mem_filter, Set.mem_toFinset, S]
      exact ⟨(isConjRoot_iff_mem_minpoly_rootSet hint).mp conj, ne.symm⟩
    have hS : S.Nonempty := ⟨α', hmem⟩
    simp only [hS, δ]
    exact Finset.min'_le _ _ (Finset.mem_image_of_mem _ hmem)
  have δpos : 0 < δ := by
    by_cases hS : S.Nonempty <;> simp only [hS, ↓reduceDIte, δ]
    · simp only [Finset.lt_min'_iff, Finset.mem_image, forall_exists_index, and_imp,
        forall_apply_eq_imp_iff₂]
      intro a' ha'
      simp only [Finset.mem_filter, S] at ha'
      rw [norm_pos_iff, sub_ne_zero]
      exact ha'.2.symm
    · exact one_pos
  have hε :
      0 < (δ / max ‖α‖ 1) ^ (minpoly ℚ_[p] α).natDegree / ((minpoly ℚ_[p] α).natDegree + 1) := by
    positivity
  rcases exists_monic_and_natDegree_eq_and_norm_map_algebraMap_coeff_sub_lt
    (denseRange_ratCast p) fmon hε with ⟨g, gmon, gdeg, gcoeff⟩
  rcases exists_aroots_norm_sub_lt_of_norm_coeff_sub_lt hε (minpoly.aeval _ _) fmon (gmon.map _)
    (by rw [natDegree_map, gdeg]) gcoeff (IsAlgClosed.splits _) with ⟨β, hβ, hαβ⟩
  have hlt : ‖α - β‖ < δ := by
    rw [← Real.rpow_natCast, ← mul_comm_div, div_self, one_mul,
      ← Real.rpow_mul (div_pos δpos (by positivity)).le, mul_inv_cancel₀] at hαβ
    · simpa [div_mul_cancel₀ _ (by positivity : (max ‖α‖ 1) > 0).ne'] using hαβ
    · simp [fnatdeg0]
    · positivity
  have hβroot : aeval β (g.map (algebraMap ℚ ℚ_[p])) = 0 := (mem_aroots.mp hβ).2
  have hβint : IsIntegral ℚ_[p] β := ⟨_, gmon.map _, hβroot⟩
  have hαβ' : α ∈ ℚ_[p]⟮β⟯ := IsKrasner.krasner (minpoly.irreducible hint).separable
    (IsAlgClosed.splits _) hβint fun α' h1 h2 ↦ hlt.trans_le (norm_sub_le α' h1 h2)
  have : FiniteDimensional ℚ_[p] ℚ_[p]⟮β⟯ := adjoin.finiteDimensional hβint
  refine ⟨g, gmon, gdeg.symm, β, by rwa [aeval_map_algebraMap] at hβroot,
    (eq_of_le_of_finrank_le (adjoin_simple_le_iff.mpr hαβ') ?_).symm⟩
  rw [adjoin.finrank hβint, adjoin.finrank hint, gdeg, ← natDegree_map (algebraMap ℚ ℚ_[p])]
  exact natDegree_le_of_dvd (minpoly.dvd ℚ_[p] β hβroot) (gmon.map _).ne_zero

variable (p) (K : Type*) [Field K] [Algebra ℚ_[p] K] [FiniteDimensional ℚ_[p] K]

/-- **A defining polynomial with integer coefficients** (LMFDB `lf.defining_polynomial`): every
finite extension `K` of `ℚ_p` is `ℚ_p[x] / (f)` for a monic `f ∈ ℤ[x]`, irreducible over `ℚ_p`. -/
lemma exists_monic_nonempty_isAdjoinRoot :
    ∃ f : ℤ[X], f.Monic ∧ Nonempty (IsAdjoinRoot K (f.map (algebraMap ℤ ℚ_[p]))) := by
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap ℚ_[p] K).injective
  rcases Field.exists_primitive_element ℚ_[p] K with ⟨a, ha⟩
  let ι : K →ₐ[ℚ_[p]] PadicAlgCl p := IsAlgClosed.lift
  rcases exists_ratPolynomial_adjoin_simple_eq (ι a) with ⟨g, gmon, gdeg, β, hβ, hβa⟩
  have hmap (x : K) : ℚ_[p]⟮ι x⟯ = (ℚ_[p]⟮x⟯).map ι := by
    rw [adjoin_map, Set.image_singleton]
  have hβmem : β ∈ (ℚ_[p]⟮a⟯).map ι := hmap a ▸ hβa ▸ mem_adjoin_simple_self ℚ_[p] β
  rcases hβmem with ⟨b, -, rfl⟩
  have hb : aeval b g = 0 := by
    rw [← aeval_map_algebraMap ℚ_[p], ← map_eq_zero_iff ι ι.toRingHom.injective,
      ← aeval_algHom_apply, aeval_map_algebraMap]
    exact hβ
  have hbtop : ℚ_[p]⟮b⟯ = ⊤ := by
    refine top_le_iff.mp (ha ▸ adjoin_simple_le_iff.mpr ?_)
    have hιa : ι a ∈ (ℚ_[p]⟮b⟯).map ι := hmap b ▸ hβa ▸ mem_adjoin_simple_self ℚ_[p] (ι a)
    rcases hιa with ⟨c, hc, hca⟩
    exact ι.injective hca ▸ hc
  have hh0 : IsLocalization.integerNormalization (nonZeroDivisors ℤ) g ≠ 0 :=
    IsFractionRing.integerNormalization_eq_zero_iff.not.mpr gmon.ne_zero
  have hle : (IsLocalization.integerNormalization (nonZeroDivisors ℤ) g).natDegree ≤ g.natDegree :=
    natDegree_le_iff_coeff_eq_zero.mpr fun n hn ↦
      (IsFractionRing.coeff_integerNormalization_eq_zero_iff g n).mpr
        (coeff_eq_zero_of_natDegree_lt hn)
  have hbh : aeval b (IsLocalization.integerNormalization (nonZeroDivisors ℤ) g) = 0 :=
    IsLocalization.integerNormalization_aeval_eq_zero _ g hb
  generalize IsLocalization.integerNormalization (nonZeroDivisors ℤ) g = h at hh0 hle hbh
  have hd : algebraMap ℚ_[p] K (h.leadingCoeff : ℚ_[p]) ≠ 0 := by
    rw [Ne, ← map_zero (algebraMap ℚ_[p] K), (algebraMap ℚ_[p] K).injective.eq_iff,
      Int.cast_eq_zero]
    exact leadingCoeff_ne_zero.mpr hh0
  have hct : ℚ_[p]⟮algebraMap ℤ K h.leadingCoeff * b⟯ = ⊤ := by
    refine top_le_iff.mp (hbtop ▸ adjoin_simple_le_iff.mpr ?_)
    convert mul_mem (inv_mem (IntermediateField.algebraMap_mem _ (h.leadingCoeff : ℚ_[p])))
      (mem_adjoin_simple_self ℚ_[p] (algebraMap ℤ K h.leadingCoeff * b)) using 1
    rw [map_intCast, algebraMap_int_eq, eq_intCast, inv_mul_cancel_left₀ (by simpa using hd)]
  have hcint : IsIntegral ℚ_[p] (algebraMap ℤ K h.leadingCoeff * b) := .of_finite ℚ_[p] _
  have hcroot : aeval (algebraMap ℤ K h.leadingCoeff * b)
      (h.integralNormalization.map (algebraMap ℤ ℚ_[p])) = 0 := by
    rw [aeval_map_algebraMap]
    exact integralNormalization_aeval_eq_zero hbh fun x hx ↦ by
      rwa [algebraMap_int_eq, eq_intCast, Int.cast_eq_zero] at hx
  refine ⟨_, monic_integralNormalization hh0, IsAdjoinRoot.nonempty_iff.mpr ⟨?_, _, hcroot, hct⟩⟩
  rw [eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hcint)
    ((monic_integralNormalization hh0).map _) (minpoly.dvd _ _ hcroot) ?_]
  · exact minpoly.irreducible hcint
  rw [natDegree_map_eq_of_injective (algebraMap ℤ ℚ_[p]).injective_int,
    natDegree_integralNormalization, ← adjoin.finrank hcint, hct, ← ha,
    adjoin.finrank (.of_finite ℚ_[p] a), ← minpoly.algHom_eq ι ι.toRingHom.injective a, ← gdeg]
  exact hle

/-- **A defining polynomial with `p`-adic integer coefficients** (LMFDB `lf.defining_polynomial`):
every finite extension `K` of `ℚ_p` is `ℚ_p[x] / (f)` for a monic `f ∈ ℤ_p[x]`, irreducible over
`ℚ_p`. -/
lemma exists_monic_nonempty_isAdjoinRoot_padicInt :
    ∃ f : ℤ_[p][X], f.Monic ∧ Nonempty (IsAdjoinRoot K (f.map (algebraMap ℤ_[p] ℚ_[p]))) := by
  rcases exists_monic_nonempty_isAdjoinRoot p K with ⟨f, hf, h⟩
  refine ⟨f.map (algebraMap ℤ ℤ_[p]), hf.map _, ?_⟩
  rwa [Polynomial.map_map, RingHom.ext_int ((algebraMap ℤ_[p] ℚ_[p]).comp (algebraMap ℤ ℤ_[p]))]

end Padic
