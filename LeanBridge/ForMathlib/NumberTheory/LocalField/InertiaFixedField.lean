import LeanBridge.ForMathlib.NumberTheory.LocalField.SlopeContentDegree
import Mathlib.FieldTheory.Relrank
import TauCeti.NumberTheory.LocalField.Teichmuller
import TauCeti.NumberTheory.LocalField.Unramified.Factorization

/-!
# The fixed field of inertia is the maximal unramified subextension

Let `L / K` be a finite Galois extension of nonarchimedean local fields, with ramification index
`e`, residue degree `f`, tame degree `t` and lower ramification groups `G_i`; the inertia group
`G_0` is the upper ramification group `G^0`, which the LMFDB (`lf.slope_content`,
`lf.galois_invariants`) writes `G^{(1)}`. Tau Ceti's maximal unramified subextension `L^un`,
generated by the roots of `x^{q^f} - x` for `q` the order of the residue field of `K`, has degree
`f` over `K`, and `L` is totally ramified of degree `e` over it. We show that `L^un` is the fixed
field of `G_0`. A root `ω` of `x^{q^f} - x` is the Teichmüller representative of its residue, and
so is `σ ω` for `σ ∈ G_0`, which acts trivially on the residue field of `L`; hence `σ ω = ω`, so
`G_0` fixes `L^un`, and the two fields agree since `[L : L^{G_0}] = #G_0 = e = [L : L^un]`.

Consequently the fixed field of the wild inertia group `G_1`, the maximal tamely ramified
subextension (Tau Ceti's `IntermediateField.lift_fixedField_lowerRamificationGroup_one`), has
degree `[G_0 : G_1] = t` over `L^un`. The LMFDB calls `t` the degree of the largest tamely
totally ramified subextension of `L / K`, which is wrong: for `K = ℚ_3`, `ζ` a primitive eighth
root of unity and `L = ℚ_3(ζ, √(3 ζ))`, cyclic of order `4` with `e = f = t = 2`, the only quadratic
subfield is the unramified `ℚ_3(ζ)`, so the largest tamely totally ramified subextension is `ℚ_3`.

## Main results

* `IsNonarchimedeanLocalField.fixedField_lowerRamificationGroup_zero` (LMFDB `lf.slope_content`,
  `lf.galois_invariants`): the fixed field of the inertia group `G_0` is the maximal unramified
  subextension `L^un`.
* `IsNonarchimedeanLocalField.fixingSubgroup_unramifiedExtension_inertiaDegree`: the Galois group
  of `L / L^un` is `G_0`.
* `IsNonarchimedeanLocalField.fixedField_upperRamificationGroup_zero` (LMFDB `lf.slope_content`,
  `lf.galois_invariants`): the fixed field of `G^{(1)} = G^0` is `L^un`.
* `IsNonarchimedeanLocalField.relfinrank_fixedField_lowerRamificationGroup_one` (LMFDB
  `lf.slope_content`, `lf.galois_invariants`): the fixed field of `G_1` has degree `t` over `L^un`.
* `IsNonarchimedeanLocalField.finrank_fixedField_upperRamificationGroup_zero_galoisClosure` (LMFDB
  `lf.galois_invariants`): for a finite separable extension `E / K`, the fixed field of
  `G^{(1)}` in the Galois closure of `E` has degree the unramified degree over `K`.

## References

* [J.-P. Serre, *Corps Locaux*][serre1968], Chapter IV, §1.
-/

open ValuativeRel TauCeti LocalFieldsRamification IntermediateField Polynomial

attribute [local instance] finiteIntermediateFieldValuativeRel finiteIntermediateFieldTopology
  finiteIntermediateField_isNonarchimedeanLocalField finiteIntermediateField_valuativeExtension

namespace IsNonarchimedeanLocalField

variable (K : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  (L : Type*) [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [Algebra K L] [ValuativeExtension K L] [Module.Finite K L]

variable {K L} in
lemma apply_eq_self_of_mem_rootSet {σ : L ≃ₐ[K] L} (hσ : σ ∈ lowerRamificationGroup K L 0) {x : L}
    (hx : x ∈ (X ^ Nat.card 𝓀[K] ^ inertiaDegree K L - X : K[X]).rootSet L) : σ x = x := by
  rw [mem_rootSet, map_sub, map_pow, aeval_X, sub_eq_zero, ← natCard_residueField] at hx
  have hv : valuation L x ≤ 1 := by
    rcases eq_or_ne x 0 with hx0 | hx0
    · rw [hx0, map_zero]
      exact zero_le
    have h : x ^ (Nat.card 𝓀[L] - 1) = 1 :=
      mul_right_cancel₀ hx0 (by rw [pow_sub_one_mul Nat.card_pos.ne', hx.2, one_mul])
    have h' : valuation L x ^ (Nat.card 𝓀[L] - 1) ≤ 1 := by
      rw [← map_pow, h, map_one]
    exact (pow_le_one_iff_of_nonneg zero_le (Nat.sub_ne_zero_of_lt Finite.one_lt_card)).mp h'
  let y : 𝒪[L] := ⟨x, (Valuation.mem_integer_iff _ _).mpr hv⟩
  have hy : y ^ Nat.card 𝓀[L] = y := Subtype.ext (by simpa using hx.2)
  have hres : IsLocalRing.residue 𝒪[L] (σ • y) = IsLocalRing.residue 𝒪[L] y := by
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    simpa using mem_lowerRamificationGroup_iff.mp hσ y
  have h : σ • y = y := ((eq_teichmullerLift_iff L).mpr ⟨hres, by rw [← smul_pow', hy]⟩).trans
    ((eq_teichmullerLift_iff L).mpr ⟨rfl, hy⟩).symm
  simpa using congrArg Subtype.val h

lemma unramifiedExtension_le_fixedField :
    unramifiedExtension K L (inertiaDegree K L) ≤ fixedField (lowerRamificationGroup K L 0) :=
  unramifiedExtension_le_iff.mpr fun _ hx ↦ (mem_fixedField_iff _ _).mpr fun _ hσ ↦
    apply_eq_self_of_mem_rootSet hσ hx

variable [IsGalois K L]

/-- **The fixed field of inertia is the maximal unramified subextension** (LMFDB
`lf.slope_content`, `lf.galois_invariants`): for a finite Galois extension `L / K` of
nonarchimedean local fields, the field fixed by the inertia group `G_0` is the maximal unramified
subextension `L^un`, of degree `f` over `K` (Tau Ceti's
`TauCeti.finrank_unramifiedExtension_inertiaDegree`), over which `L` is totally ramified (Tau
Ceti's `TauCeti.isTotallyRamified_unramifiedExtension_inertiaDegree`). -/
lemma fixedField_lowerRamificationGroup_zero :
    fixedField (lowerRamificationGroup K L 0) = unramifiedExtension K L (inertiaDegree K L) :=
  (eq_of_le_of_finrank_eq' (unramifiedExtension_le_fixedField K L) <| by
    rw [finrank_unramifiedExtension_inertiaDegree_eq_ramificationIndex, finrank_fixedField_eq_card,
      natCard_lowerRamificationGroup_zero]).symm

/-- **The Galois group of `L` over its maximal unramified subextension is the inertia group**
`G_0`, for a finite Galois extension `L / K` of nonarchimedean local fields. -/
lemma fixingSubgroup_unramifiedExtension_inertiaDegree :
    (unramifiedExtension K L (inertiaDegree K L)).fixingSubgroup =
      lowerRamificationGroup K L 0 := by
  rw [← fixedField_lowerRamificationGroup_zero, fixingSubgroup_fixedField]

/-- **The fixed field of `G^{(1)}` is the maximal unramified subextension** (LMFDB
`lf.slope_content`, `lf.galois_invariants`): for a finite Galois extension `L / K` of
nonarchimedean local fields, the field fixed by the upper ramification group `G^0`, which the
LMFDB writes `G^{(1)}`, is the maximal unramified subextension `L^un`. -/
lemma fixedField_upperRamificationGroup_zero :
    fixedField (upperRamificationGroup K L ⟨0, by norm_num⟩) =
      unramifiedExtension K L (inertiaDegree K L) := by
  rw [upperRamificationGroup_zero, fixedField_lowerRamificationGroup_zero]

/-- **The maximal tamely ramified subextension has degree the tame degree over `L^un`** (LMFDB
`lf.slope_content`, `lf.galois_invariants`, corrected): for a finite Galois extension `L / K` of
nonarchimedean local fields, the field fixed by the wild inertia group `G_1`, which is the maximal
tamely ramified subextension (Tau Ceti's
`IntermediateField.lift_fixedField_lowerRamificationGroup_one`), has degree `[G_0 : G_1] = t` over
the maximal unramified subextension `L^un`. -/
lemma relfinrank_fixedField_lowerRamificationGroup_one :
    (unramifiedExtension K L (inertiaDegree K L)).relfinrank
      (fixedField (lowerRamificationGroup K L 1)) = tameDegree K L := by
  refine Nat.eq_of_mul_eq_mul_right (pow_pos (CharP.prime_ringChar 𝓀[K]).pos
    ((ramificationIndex K L).factorization (ringChar 𝓀[K]))) ?_
  rw [← natCard_lowerRamificationGroup_one, ← finrank_fixedField_eq_card,
    relfinrank_mul_finrank_top ((fixedField_lowerRamificationGroup_zero K L).symm.le.trans
      (fixedField_antitone (lowerRamificationGroup_antitone K L zero_le_one))),
    finrank_fixedField_eq_card, natCard_lowerRamificationGroup_one, mul_comm,
    ordProj_mul_tameDegree]

variable (E : Type*) [Field E] [Algebra K E] [FiniteDimensional K E] [Algebra.IsSeparable K E]

/-- **The fixed field of `G^{(1)}` has degree the unramified degree** (LMFDB
`lf.galois_invariants`): for a finite separable extension `E / K` of a nonarchimedean local field,
the field fixed by the upper ramification group `G^0 = G^{(1)}` of the Galois closure `E^gal / K`
has degree over `K` the unramified degree of `E^gal / K`. -/
lemma finrank_fixedField_upperRamificationGroup_zero_galoisClosure :
    Module.finrank K (fixedField (upperRamificationGroup K (Algebra.galoisClosure K E)
      ⟨0, by norm_num⟩)) = galoisUnramifiedDegree K E := by
  rw [fixedField_upperRamificationGroup_zero, finrank_unramifiedExtension_inertiaDegree]
  rfl

end IsNonarchimedeanLocalField
