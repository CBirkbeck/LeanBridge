import LeanBridge.ForMathlib.NumberTheory.ModEllGaloisRep.Frobenius
import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import TauCeti.NumberTheory.Chebotarev.Density.Chebotarev

/-!
# The generating primes of a mod-`ℓ` Galois representation

Let `ρ : Gal(ℚ̄/ℚ) → GL_n(𝔽_ℓ)` be a mod-`ℓ` Galois representation with splitting field `L`. A good
prime is a prime `p ≠ ℓ` unramified in `L`; the Frobenius elements of `Gal(L/ℚ)` at the primes above
`p` then form a conjugacy class, whose image under `ρ` is a conjugacy class of the image of `ρ`. The
image of `ρ` is generated by these images at finitely many good primes, and the LMFDB canonicalises
such a set as the minimal sequence `p_1 < ⋯ < p_n` of good primes for which the subgroups
`H_k = ⟨ρ(Frob_{p_1}), …, ρ(Frob_{p_k})⟩` generated by the images of the Frobenius classes have
strictly increasing orders, with `H_0 = 1`, and `H_n` is the image of `ρ`.

Minimality means that the sequence is chosen greedily: `p_k` is the least good prime after
`p_{k-1}` whose Frobenius image is not contained in `H_{k-1}`. Equivalently, the Frobenius image of
every good prime `q` outside the sequence lies in the subgroup generated by those of the primes of
the sequence below `q`, which is how we state it. This determines the sequence
(`MonoidHom.IsGeneratingPrimes.eq`); it is also the lexicographically least sequence with the other
properties. The LMFDB data concern representations of `Gal(ℚ̄/ℚ)`, and so do the definitions here:
the knowl does not specify how to order the primes of a general number field. The sequence exists
by the Chebotarev density theorem (Tau Ceti's `NumberField.Chebotarev.infinite_frobeniusPrimeSet`):
it consists of the good primes `p` whose Frobenius image is not contained in the subgroup generated
by the Frobenius images of all the good primes below `p`.

## Main definitions

* `MonoidHom.IsGoodPrime` (LMFDB `modlgal.frobenius_prime`): the good primes of `ρ`.
* `MonoidHom.frobeniusImage`: the image under `ρ` of the Frobenius class at a prime `p`.
* `MonoidHom.frobeniusSubgroup`: the subgroup generated by the images of the Frobenius classes at
  the primes of a set.
* `MonoidHom.IsGeneratingPrimes` (LMFDB `modlgal.generating_primes`): the sequence of generating
  primes of `ρ`.
* `MonoidHom.generatingPrimes` (LMFDB `modlgal.generating_primes`): the generating primes.

## Main results

* `MonoidHom.IsGeneratingPrimes.eq`: the sequence of generating primes is unique.
* `MonoidHom.generatingPrimes_eq`: `MonoidHom.generatingPrimes` is the sequence of generating primes
  when there is one.
* `MonoidHom.exists_isGeneratingPrimes`: the sequence of generating primes exists.
* `MonoidHom.isGeneratingPrimes_generatingPrimes`: `MonoidHom.generatingPrimes` is the sequence of
  generating primes.
-/

open NumberField IsDedekindDomain

namespace MonoidHom

variable {n ℓ : ℕ} {ρ : Gal(AlgebraicClosure ℚ/ℚ) →* GL (Fin n) (ZMod ℓ)}
  (hρ : IsOpen (ρ.ker : Set Gal(AlgebraicClosure ℚ/ℚ))) (p : ℕ) (s : Set ℕ) {t : Set ℕ}
  (ps : List ℕ) {qs : List ℕ}

/-- A **good prime** (LMFDB `modlgal.frobenius_prime`) of a mod-`ℓ` Galois representation `ρ` of
`Gal(ℚ̄/ℚ)`: a natural number `p ≠ ℓ` that is the norm of a prime `v` of `ℚ`, that is a prime
number, such that `v` is unramified in the splitting field `L` of `ρ`. -/
def IsGoodPrime : Prop :=
  p ≠ ℓ ∧ ∃ v : HeightOneSpectrum (𝓞 ℚ), Ideal.absNorm v.asIdeal = p ∧
    ∀ (Q : Ideal (𝓞 (splittingField ρ hρ))) [Q.IsPrime] [Q.LiesOver v.asIdeal],
      Algebra.IsUnramifiedAt (𝓞 ℚ) Q

/-- The image `ρ(Frob_p)` under a mod-`ℓ` Galois representation `ρ` of `Gal(ℚ̄/ℚ)` of the Frobenius
class at a prime `p` unramified in the splitting field `L` of `ρ`: the image under the factorisation
`Gal(L/ℚ) → GL_n(𝔽_ℓ)` of `ρ` of the conjugacy class of `Gal(L/ℚ)` formed by the Frobenius
elements at the primes above `p` (Tau Ceti's `NumberField.artinSymbol`), a conjugacy class of the
image of `ρ`. It is empty if `p` is not a prime number or is ramified in `L`. -/
noncomputable def frobeniusImage : Set (GL (Fin n) (ZMod ℓ)) :=
  ⋃ (v : HeightOneSpectrum (𝓞 ℚ)) (_ : Ideal.absNorm v.asIdeal = p)
    (hur : ∀ (Q : Ideal (𝓞 (splittingField ρ hρ))) [Q.IsPrime] [Q.LiesOver v.asIdeal],
      Algebra.IsUnramifiedAt (𝓞 ℚ) Q),
    galoisFactor hρ '' (artinSymbol v.asIdeal hur).carrier

/-- The subgroup of `GL_n(𝔽_ℓ)` generated by the images `ρ(Frob_p)` of the Frobenius classes at the
primes `p` of a set `s` (`MonoidHom.frobeniusImage`). -/
noncomputable def frobeniusSubgroup : Subgroup (GL (Fin n) (ZMod ℓ)) :=
  .closure (⋃ q ∈ s, frobeniusImage hρ q)

/-- A list `[p_1, …, p_n]` is the **sequence of generating primes** (LMFDB
`modlgal.generating_primes`) of a mod-`ℓ` Galois representation `ρ` of `Gal(ℚ̄/ℚ)` if it is the
minimal increasing sequence of good primes such that the subgroups
`H_k = ⟨ρ(Frob_{p_1}), …, ρ(Frob_{p_k})⟩` have strictly increasing orders, with `H_0 = 1`, and
`H_n` is the image of `ρ`. Minimality is stated as the greedy property: the Frobenius image of each
good prime `q` outside the list lies in the subgroup generated by those of the primes of the list
below `q`. -/
structure IsGeneratingPrimes : Prop where
  /-- The primes are increasing. -/
  sortedLT : ps.SortedLT
  /-- The primes are good. -/
  isGoodPrime (q : ℕ) : q ∈ ps → IsGoodPrime hρ q
  /-- The orders of the subgroups `H_k` are strictly increasing. -/
  card_lt (q : ℕ) : q ∈ ps → Nat.card (frobeniusSubgroup hρ {r | r ∈ ps ∧ r < q}) <
    Nat.card (frobeniusSubgroup hρ {r | r ∈ ps ∧ r ≤ q})
  /-- The images of the Frobenius classes at the primes of the list generate the image of `ρ`. -/
  frobeniusSubgroup_eq_range : frobeniusSubgroup hρ {q | q ∈ ps} = ρ.range
  /-- The sequence is minimal: the Frobenius image of a good prime `q` outside the list lies in the
  subgroup generated by those of the primes of the list below `q`. -/
  subset_frobeniusSubgroup (q : ℕ) : IsGoodPrime hρ q → q ∉ ps →
    frobeniusImage hρ q ⊆ frobeniusSubgroup hρ {r | r ∈ ps ∧ r < q}

open scoped Classical in
/-- The **generating primes** (LMFDB `modlgal.generating_primes`) of a mod-`ℓ` Galois representation
`ρ` of `Gal(ℚ̄/ℚ)`: the sequence of generating primes (`MonoidHom.IsGeneratingPrimes`), which
exists by the Chebotarev density theorem and is unique
(`MonoidHom.isGeneratingPrimes_generatingPrimes`, `MonoidHom.IsGeneratingPrimes.eq`). The value
`[]` in the case that there is none never occurs. -/
noncomputable def generatingPrimes : List ℕ :=
  if h : ∃ qs, IsGeneratingPrimes hρ qs then h.choose else []

variable {hρ p ps} in
lemma IsGeneratingPrimes.not_subset (h : IsGeneratingPrimes hρ ps) (hp : p ∈ ps) :
    ¬frobeniusImage hρ p ⊆ frobeniusSubgroup hρ {q | q ∈ ps ∧ q < p} := by
  intro hsub
  have heq : frobeniusSubgroup hρ {q | q ∈ ps ∧ q ≤ p} =
      frobeniusSubgroup hρ {q | q ∈ ps ∧ q < p} := by
    refine le_antisymm ((Subgroup.closure_le _).mpr fun x hx ↦ ?_)
      (Subgroup.closure_mono <| Set.biUnion_mono (fun q hq ↦ ⟨hq.1, hq.2.le⟩) fun _ _ ↦ subset_rfl)
    rcases Set.mem_iUnion₂.mp hx with ⟨q, ⟨hq, hqp⟩, hxq⟩
    rcases hqp.lt_or_eq with hlt | rfl
    · exact Subgroup.subset_closure <| Set.mem_iUnion₂.mpr ⟨q, ⟨hq, hlt⟩, hxq⟩
    · exact hsub hxq
  exact (h.card_lt p hp).ne <|
    congrArg (fun H : Subgroup (GL (Fin n) (ZMod ℓ)) ↦ Nat.card H) heq.symm

variable {hρ ps} in
/-- **The sequence of generating primes is unique.** -/
lemma IsGeneratingPrimes.eq (h : IsGeneratingPrimes hρ ps) (h' : IsGeneratingPrimes hρ qs) :
    ps = qs := by
  have hmem (q : ℕ) : q ∈ ps ↔ q ∈ qs := by
    induction q using Nat.strong_induction_on with
    | _ q ih =>
      have hset : {r | r ∈ ps ∧ r < q} = {r | r ∈ qs ∧ r < q} :=
        Set.ext fun r ↦ and_congr_left fun hr ↦ ih r hr
      refine ⟨fun hq ↦ by_contra fun hq' ↦ h.not_subset hq ?_,
        fun hq ↦ by_contra fun hq' ↦ h'.not_subset hq ?_⟩
      · exact hset ▸ h'.subset_frobeniusSubgroup q (h.isGoodPrime q hq) hq'
      · exact hset ▸ h.subset_frobeniusSubgroup q (h'.isGoodPrime q hq) hq'
  exact ((List.perm_ext_iff_of_nodup h.sortedLT.nodup h'.sortedLT.nodup).mpr hmem).eq_of_sortedLE
    h.sortedLT.sortedLE h'.sortedLT.sortedLE

variable {hρ ps} in
/-- **The generating primes are the sequence of generating primes**, when there is one. -/
lemma generatingPrimes_eq (h : IsGeneratingPrimes hρ ps) : generatingPrimes hρ = ps := by
  have he : ∃ qs, IsGeneratingPrimes hρ qs := ⟨ps, h⟩
  rw [generatingPrimes, dite_eq_left he]
  exact he.choose_spec.eq h

lemma range_eq_range_galoisFactor : ρ.range = (galoisFactor hρ).range := by
  ext x
  refine ⟨?_, ?_⟩
  · rintro ⟨τ, rfl⟩
    exact ⟨_, galoisFactor_restrictNormalHom hρ τ⟩
  · rintro ⟨σ, rfl⟩
    rcases AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure ℚ) σ with ⟨τ, rfl⟩
    exact ⟨τ, (galoisFactor_restrictNormalHom hρ τ).symm⟩

lemma frobeniusImage_subset_range : frobeniusImage hρ p ⊆ ρ.range := by
  intro x hx
  simp only [frobeniusImage, Set.mem_iUnion] at hx
  rcases hx with ⟨v, -, hur, σ, -, rfl⟩
  exact (range_eq_range_galoisFactor hρ).symm ▸ ⟨σ, rfl⟩

lemma frobeniusSubgroup_le_range : frobeniusSubgroup hρ s ≤ ρ.range :=
  (Subgroup.closure_le _).mpr <| Set.iUnion₂_subset fun q _ ↦ frobeniusImage_subset_range hρ q

variable {s} in
lemma frobeniusSubgroup_mono (h : s ⊆ t) : frobeniusSubgroup hρ s ≤ frobeniusSubgroup hρ t :=
  Subgroup.closure_mono <| Set.biUnion_subset_biUnion_left h

lemma exists_lt_isGoodPrime_mem_frobeniusImage (σ : Gal(splittingField ρ hρ/ℚ)) (m : ℕ) :
    ∃ q, m < q ∧ IsGoodPrime hρ q ∧ galoisFactor hρ σ ∈ frobeniusImage hρ q := by
  have hfin : {v : HeightOneSpectrum (𝓞 ℚ) | Ideal.absNorm v.asIdeal ≤ max m ℓ}.Finite :=
    (Ideal.finite_setOfPred_absNorm_le (max m ℓ)).preimage fun _ _ _ _ ↦ HeightOneSpectrum.ext
  rcases ((Chebotarev.infinite_frobeniusPrimeSet ℚ _ (ConjClasses.mk σ)).sdiff hfin).nonempty with
    ⟨v, ⟨hur, hv⟩, hle⟩
  have hlt : max m ℓ < Ideal.absNorm v.asIdeal := not_le.mp hle
  refine ⟨Ideal.absNorm v.asIdeal, (le_max_left m ℓ).trans_lt hlt,
    ⟨((le_max_right m ℓ).trans_lt hlt).ne', v, rfl, hur⟩, ?_⟩
  exact Set.mem_iUnion₂.mpr ⟨v, rfl, Set.mem_iUnion.mpr ⟨hur, σ, hv ▸ ConjClasses.mem_carrier_mk,
    rfl⟩⟩

/-- **The sequence of generating primes exists**, by the Chebotarev density theorem. It is the
sorted list of the good primes `p` whose Frobenius image is not contained in the subgroup
generated by the Frobenius images of the good primes below `p`. -/
lemma exists_isGeneratingPrimes : ∃ ps, IsGeneratingPrimes hρ ps := by
  have : Finite ρ.range := (range_eq_range_galoisFactor hρ).symm ▸ inferInstance
  have hfin (s : Set ℕ) : Finite (frobeniusSubgroup hρ s) :=
    Finite.of_injective _ <| Subgroup.inclusion_injective <| frobeniusSubgroup_le_range hρ s
  let H : ℕ → Subgroup (GL (Fin n) (ZMod ℓ)) :=
    fun p ↦ frobeniusSubgroup hρ {q | IsGoodPrime hρ q ∧ q < p}
  let T : Set ℕ := {p | IsGoodPrime hρ p ∧ ¬frobeniusImage hρ p ⊆ H p}
  have himage (q : ℕ) (s : Set ℕ) (hq : q ∈ s) : frobeniusImage hρ q ⊆ frobeniusSubgroup hρ s :=
    (Set.subset_biUnion_of_mem hq).trans Subgroup.subset_closure
  have hH {p p' : ℕ} (h : p ≤ p') : H p ≤ H p' :=
    frobeniusSubgroup_mono hρ fun q hq ↦ ⟨hq.1, hq.2.trans_le h⟩
  have hsub (p : ℕ) (hp : IsGoodPrime hρ p) (hpT : p ∉ T) : frobeniusImage hρ p ⊆ H p :=
    not_not.mp fun h ↦ hpT ⟨hp, h⟩
  have hlt (p : ℕ) (hp : p ∈ T) (s : Set ℕ) (hs : p ∈ s) (hps : H p ≤ frobeniusSubgroup hρ s) :
      Nat.card (H p) < Nat.card (frobeniusSubgroup hρ s) :=
    Subgroup.card_lt_of_lt <| lt_of_le_of_ne hps fun h ↦ hp.2 (h ▸ himage p s hs)
  have hTH (p : ℕ) : frobeniusSubgroup hρ {q | q ∈ T ∧ q < p} = H p := by
    induction p using Nat.strong_induction_on with
    | _ p ih =>
      refine le_antisymm (frobeniusSubgroup_mono hρ fun q hq ↦ ⟨hq.1.1, hq.2⟩)
        ((Subgroup.closure_le _).mpr <| Set.iUnion₂_subset fun q hq ↦ ?_)
      by_cases hqT : q ∈ T
      · exact himage q {r | r ∈ T ∧ r < p} ⟨hqT, hq.2⟩
      · exact fun x hx ↦ frobeniusSubgroup_mono hρ (by exact fun r hr ↦ ⟨hr.1, hr.2.trans hq.2⟩)
          ((ih q hq.2).symm.le (hsub q hq.1 hqT hx))
  have hT : T.Finite := by
    have hmono : StrictMonoOn (fun p ↦ Nat.card (H (p + 1))) T := fun p _ p' hp' h ↦
      (Subgroup.card_le_of_le (hH (Nat.succ_le_of_lt h))).trans_lt <|
        hlt p' hp' {q | IsGoodPrime hρ q ∧ q < p' + 1} ⟨hp'.1, lt_add_one p'⟩ (hH p'.le_succ)
    refine .of_finite_image ((Set.finite_Iic (Nat.card ρ.range)).subset ?_) hmono.injOn
    rintro _ ⟨p, -, rfl⟩
    exact Subgroup.card_le_of_le (frobeniusSubgroup_le_range hρ _)
  let ps : List ℕ := hT.toFinset.sort (· ≤ ·)
  have hmem (q : ℕ) : q ∈ ps ↔ q ∈ T := (Finset.mem_sort _).trans hT.mem_toFinset
  have hset (P : ℕ → Prop) : {r | r ∈ ps ∧ P r} = {r | r ∈ T ∧ P r} :=
    Set.ext fun r ↦ and_congr_left fun _ ↦ hmem r
  refine ⟨ps, Finset.sortedLT_sort _, fun q hq ↦ ((hmem q).mp hq).1, fun q hq ↦ ?_, ?_,
    fun q hq hqps ↦ ?_⟩
  · rw [hset (· < q), hset (· ≤ q), hTH q]
    exact hlt q ((hmem q).mp hq) {r | r ∈ T ∧ r ≤ q} ⟨(hmem q).mp hq, le_rfl⟩
      ((hTH q).symm.le.trans <| frobeniusSubgroup_mono hρ fun r hr ↦ ⟨hr.1, hr.2.le⟩)
  · have hps : {q | q ∈ ps} = T := Set.ext hmem
    rw [hps]
    refine le_antisymm (frobeniusSubgroup_le_range hρ T) fun x hx ↦ by_contra fun hxT ↦ ?_
    rcases (range_eq_range_galoisFactor hρ ▸ hx : x ∈ (galoisFactor hρ).range) with ⟨σ, rfl⟩
    rcases hT.bddAbove with ⟨M, hM⟩
    rcases exists_lt_isGoodPrime_mem_frobeniusImage hρ σ M with ⟨p, hMp, hp, hσp⟩
    have hTp : {q | q ∈ T ∧ q < p} = T :=
      Set.ext fun q ↦ and_iff_left_of_imp fun hq ↦ (hM hq).trans_lt hMp
    have hpT : p ∈ T := by
      refine ⟨hp, fun h ↦ hxT ?_⟩
      rw [← hTp, hTH p]
      exact h hσp
    exact absurd hMp (not_lt.mpr (hM hpT))
  · rw [hset (· < q), hTH q]
    exact hsub q hq fun hqT ↦ hqps <| (hmem q).mpr hqT

/-- **The generating primes form the sequence of generating primes**, which exists by
`MonoidHom.exists_isGeneratingPrimes`. -/
lemma isGeneratingPrimes_generatingPrimes : IsGeneratingPrimes hρ (generatingPrimes hρ) := by
  rcases exists_isGeneratingPrimes hρ with ⟨ps, h⟩
  exact (generatingPrimes_eq h).symm ▸ h

end MonoidHom
