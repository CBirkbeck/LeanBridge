import LeanBridge.ForMathlib.NumberTheory.ModEllGaloisRep.Frobenius
import LeanBridge.ForMathlib.NumberTheory.NumberField.PrimeIdealOrder
import Mathlib.RingTheory.DedekindDomain.Factorization
import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import TauCeti.NumberTheory.Chebotarev.Density.Chebotarev

/-!
# The generating primes of a mod-`ℓ` Galois representation of a number field

Let `K` be a number field and `ρ : Gal(K̄/K) → GL_n(𝔽_ℓ)` a mod-`ℓ` Galois representation with
splitting field `L`. A good prime of `ρ` is a prime `𝔭` of `K` not dividing `ℓ` and unramified in
`L`; the Frobenius elements of `Gal(L/K)` at the primes above `𝔭` then form a conjugacy class (Tau
Ceti's `NumberField.artinSymbol`), whose image under `ρ` is a conjugacy class of the image of `ρ`.
By the Chebotarev density theorem over `K` (Tau Ceti's
`NumberField.Chebotarev.infinite_frobeniusPrimeSet`), every element of `Gal(L/K)` is a Frobenius
element at infinitely many good primes, so the image of `ρ` is generated by the images of the
Frobenius classes at finitely many good primes (LMFDB `modlgal.generating_primes`). This extends
LeanBridge's `MonoidHom.exists_isGeneratingPrimes` from `ℚ` to every number field.

The LMFDB canonicalises such a set as the minimal sequence `𝔭₁ < ⋯ < 𝔭ₙ` of good primes for which
the subgroups `H_k = ⟨ρ(Frob_𝔭₁), …, ρ(Frob_𝔭ₖ)⟩` generated by the images of the Frobenius classes
have strictly increasing orders, with `H_0 = 1`, and `H_n` is the image of `ρ`. Minimality is stated
as in `MonoidHom.IsGeneratingPrimes`: the Frobenius image of every good prime outside the sequence
lies in the subgroup generated by those of the primes of the sequence below it. The knowl does not
say how the primes of `K` are ordered. The definitions here take any total order on the primes of
`K` (`MonoidHom.IsGeneratingPrimeIdeals`); the sequence is then unique, and it exists as soon as
every prime has finitely many primes below it. For the canonical sequence we take the order by which
the LMFDB labels the prime ideals of `K` (LMFDB `nf.ideal_labels`), the Cremona–Page–Sutherland
order `NumberField.primeLinearOrder`: by norm, then by ramification index, then by the `p`-adic
digits of the factor of the defining polynomial that corresponds to the prime. A prime has finitely
many primes of norm at most its own, so this order qualifies.

## Main definitions

* `MonoidHom.IsGoodPrimeIdeal` (LMFDB `modlgal.frobenius_prime`): the good primes of `ρ`.
* `MonoidHom.primeFrobeniusImage`: the image under `ρ` of the Frobenius class at a prime of `K`.
* `MonoidHom.primeFrobeniusSubgroup`: the subgroup generated by the images of the Frobenius classes
  at the primes of a set.
* `MonoidHom.IsGeneratingPrimeIdeals` (LMFDB `modlgal.generating_primes`): the sequence of
  generating primes of `ρ` for a total order on the primes of `K`.
* `MonoidHom.generatingPrimeIdeals` (LMFDB `modlgal.generating_primes`): the generating primes.

## Main results

* `MonoidHom.exists_finset_primeFrobeniusSubgroup_eq_range` (LMFDB `modlgal.generating_primes`):
  the image of `ρ` is generated by the images of the Frobenius classes at finitely many good primes.
* `MonoidHom.IsGeneratingPrimeIdeals.eq`: the sequence of generating primes is unique.
* `MonoidHom.generatingPrimeIdeals_eq`: `MonoidHom.generatingPrimeIdeals` is the sequence of
  generating primes when there is one.
* `MonoidHom.exists_isGeneratingPrimeIdeals`: it exists for an order in which every prime has
  finitely many primes below it.
* `MonoidHom.isGeneratingPrimeIdeals_generatingPrimeIdeals`: `MonoidHom.generatingPrimeIdeals` is
  the sequence of generating primes for such an order.
* `NumberField.finite_setOf_lt_primeLinearOrder`: every prime has finitely many primes below it in
  the Cremona–Page–Sutherland order.
* `MonoidHom.isGeneratingPrimeIdeals_primeLinearOrder` (LMFDB `modlgal.generating_primes`): the
  generating primes for the Cremona–Page–Sutherland order.

## References

* J. E. Cremona, A. Page, A. V. Sutherland, *Sorting and labelling integral ideals in a number
  field*, arXiv:2005.09491.
-/

open IsDedekindDomain NumberField

open scoped IntermediateField

namespace NumberField

variable {K : Type*} [Field K] [NumberField K] (α : 𝓞 K) (hα : ℚ⟮(α : K)⟯ = ⊤)

/-- **A prime has finitely many primes below it in the Cremona–Page–Sutherland order**
(`NumberField.primeLinearOrder`), which orders the primes first by norm. -/
lemma finite_setOf_lt_primeLinearOrder (v : HeightOneSpectrum (𝓞 K)) :
    letI : LinearOrder (HeightOneSpectrum (𝓞 K)) := primeLinearOrder α hα
    {w | w < v}.Finite := by
  refine ((Ideal.finite_setOfPred_absNorm_le (Ideal.absNorm v.asIdeal)).preimage
    fun _ _ _ _ ↦ HeightOneSpectrum.ext).subset fun w hw ↦ ?_
  rcases Prod.Lex.lt_iff.mp hw with h | ⟨h, -⟩
  · exact h.le
  · exact h.le

end NumberField

namespace MonoidHom

variable {K : Type*} [Field K] [NumberField K] {n ℓ : ℕ}
  {ρ : Gal(AlgebraicClosure K/K) →* GL (Fin n) (ZMod ℓ)}
  (hρ : IsOpen (ρ.ker : Set Gal(AlgebraicClosure K/K))) (v : HeightOneSpectrum (𝓞 K))
  (s : Set (HeightOneSpectrum (𝓞 K))) {t : Set (HeightOneSpectrum (𝓞 K))}
  (ps : List (HeightOneSpectrum (𝓞 K))) {qs : List (HeightOneSpectrum (𝓞 K))}

/-- A **good prime** (LMFDB `modlgal.frobenius_prime`) of a mod-`ℓ` Galois representation `ρ` of
`Gal(K̄/K)`: a prime `𝔭` of `K` not dividing `ℓ` and unramified in the splitting field `L` of `ρ`.
It is the analogue over `K` of `MonoidHom.IsGoodPrime`. -/
def IsGoodPrimeIdeal : Prop :=
  (ℓ : 𝓞 K) ∉ v.asIdeal ∧ ∀ (Q : Ideal (𝓞 (splittingField ρ hρ))) [Q.IsPrime]
    [Q.LiesOver v.asIdeal], Algebra.IsUnramifiedAt (𝓞 K) Q

/-- The image `ρ(Frob_𝔭)` under a mod-`ℓ` Galois representation `ρ` of `Gal(K̄/K)` of the Frobenius
class at a prime `𝔭` of `K` unramified in the splitting field `L` of `ρ`: the image under the
factorisation `Gal(L/K) → GL_n(𝔽_ℓ)` of `ρ` of the conjugacy class of `Gal(L/K)` formed by the
Frobenius elements at the primes above `𝔭` (Tau Ceti's `NumberField.artinSymbol`), a conjugacy class
of the image of `ρ`. It is empty if `𝔭` is ramified in `L`. -/
noncomputable def primeFrobeniusImage : Set (GL (Fin n) (ZMod ℓ)) :=
  ⋃ (hur : ∀ (Q : Ideal (𝓞 (splittingField ρ hρ))) [Q.IsPrime] [Q.LiesOver v.asIdeal],
    Algebra.IsUnramifiedAt (𝓞 K) Q), galoisFactor hρ '' (artinSymbol v.asIdeal hur).carrier

/-- The subgroup of `GL_n(𝔽_ℓ)` generated by the images `ρ(Frob_𝔭)` of the Frobenius classes at the
primes `𝔭` of a set `s` of primes of `K` (`MonoidHom.primeFrobeniusImage`). -/
noncomputable def primeFrobeniusSubgroup : Subgroup (GL (Fin n) (ZMod ℓ)) :=
  .closure (⋃ w ∈ s, primeFrobeniusImage hρ w)

lemma range_galoisFactor : (galoisFactor hρ).range = ρ.range := by
  ext x
  refine ⟨?_, ?_⟩
  · rintro ⟨σ, rfl⟩
    rcases AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure K) σ with ⟨τ, rfl⟩
    exact ⟨τ, (galoisFactor_restrictNormalHom hρ τ).symm⟩
  · rintro ⟨τ, rfl⟩
    exact ⟨_, galoisFactor_restrictNormalHom hρ τ⟩

lemma primeFrobeniusImage_subset_range : primeFrobeniusImage hρ v ⊆ ρ.range := by
  intro x hx
  simp only [primeFrobeniusImage, Set.mem_iUnion] at hx
  rcases hx with ⟨-, σ, -, rfl⟩
  exact range_galoisFactor hρ ▸ ⟨σ, rfl⟩

lemma primeFrobeniusSubgroup_le_range : primeFrobeniusSubgroup hρ s ≤ ρ.range :=
  (Subgroup.closure_le _).mpr <| Set.iUnion₂_subset fun w _ ↦ primeFrobeniusImage_subset_range hρ w

variable {s} in
lemma primeFrobeniusSubgroup_mono (h : s ⊆ t) :
    primeFrobeniusSubgroup hρ s ≤ primeFrobeniusSubgroup hρ t :=
  Subgroup.closure_mono <| Set.biUnion_subset_biUnion_left h

lemma primeFrobeniusImage_subset_primeFrobeniusSubgroup (h : v ∈ s) :
    primeFrobeniusImage hρ v ⊆ primeFrobeniusSubgroup hρ s :=
  (Set.subset_biUnion_of_mem h).trans Subgroup.subset_closure

lemma exists_isGoodPrimeIdeal_mem_primeFrobeniusImage (hℓ : ℓ ≠ 0) (σ : Gal(splittingField ρ hρ/K))
    (hs : s.Finite) :
    ∃ w ∉ s, IsGoodPrimeIdeal hρ w ∧ galoisFactor hρ σ ∈ primeFrobeniusImage hρ w := by
  have hℓs : {w : HeightOneSpectrum (𝓞 K) | (ℓ : 𝓞 K) ∈ w.asIdeal}.Finite :=
    (Ideal.finite_factors (I := Ideal.span {(ℓ : 𝓞 K)}) (by simpa using hℓ)).subset
      fun w hw ↦ Ideal.dvd_span_singleton.mpr hw
  rcases ((Chebotarev.infinite_frobeniusPrimeSet K _ (ConjClasses.mk σ)).sdiff
    (hs.union hℓs)).nonempty with ⟨w, ⟨hur, hw⟩, hws⟩
  refine ⟨w, fun h ↦ hws (Or.inl h), ⟨fun h ↦ hws (Or.inr h), hur⟩, ?_⟩
  exact Set.mem_iUnion.mpr ⟨hur, σ, hw ▸ ConjClasses.mem_carrier_mk, rfl⟩

/-- **The image of `ρ` is generated by the images of the Frobenius classes at finitely many good
primes** (LMFDB `modlgal.generating_primes`), by the Chebotarev density theorem over `K`. -/
lemma exists_finset_primeFrobeniusSubgroup_eq_range (hℓ : ℓ ≠ 0) :
    ∃ s : Finset (HeightOneSpectrum (𝓞 K)), (∀ w ∈ s, IsGoodPrimeIdeal hρ w) ∧
      primeFrobeniusSubgroup hρ s = ρ.range := by
  have h (σ : Gal(splittingField ρ hρ/K)) :
      ∃ w, IsGoodPrimeIdeal hρ w ∧ galoisFactor hρ σ ∈ primeFrobeniusImage hρ w := by
    rcases exists_isGoodPrimeIdeal_mem_primeFrobeniusImage hρ ∅ hℓ σ Set.finite_empty with
      ⟨w, -, hw⟩
    exact ⟨w, hw⟩
  choose f hf using h
  classical
  refine ⟨Finset.univ.image f, fun w hw ↦ ?_, le_antisymm (primeFrobeniusSubgroup_le_range hρ _) ?_⟩
  · rcases Finset.mem_image.mp hw with ⟨σ, -, rfl⟩
    exact (hf σ).1
  · rintro _ ⟨σ, rfl⟩
    rw [← galoisFactor_restrictNormalHom hρ σ]
    exact primeFrobeniusImage_subset_primeFrobeniusSubgroup hρ _ _
      (by simp) (hf (AlgEquiv.restrictNormalHom (splittingField ρ hρ) σ)).2

section Order

variable [LinearOrder (HeightOneSpectrum (𝓞 K))]

/-- A list `[𝔭₁, …, 𝔭ₙ]` of primes of `K` is the **sequence of generating primes** (LMFDB
`modlgal.generating_primes`) of a mod-`ℓ` Galois representation `ρ` of `Gal(K̄/K)`, for a total
order on the primes of `K`, if it is the minimal increasing sequence of good primes such that the
subgroups `H_k = ⟨ρ(Frob_𝔭₁), …, ρ(Frob_𝔭ₖ)⟩` have strictly increasing orders, with `H_0 = 1`, and
`H_n` is the image of `ρ`. Minimality is stated as the greedy property: the Frobenius image of each
good prime `𝔮` outside the list lies in the subgroup generated by those of the primes of the list
below `𝔮`. The canonical order is the Cremona–Page–Sutherland order
(`MonoidHom.isGeneratingPrimeIdeals_primeLinearOrder`). -/
structure IsGeneratingPrimeIdeals : Prop where
  /-- The primes are increasing. -/
  sortedLT : ps.SortedLT
  /-- The primes are good. -/
  isGoodPrimeIdeal (w : HeightOneSpectrum (𝓞 K)) : w ∈ ps → IsGoodPrimeIdeal hρ w
  /-- The orders of the subgroups `H_k` are strictly increasing. -/
  card_lt (w : HeightOneSpectrum (𝓞 K)) : w ∈ ps →
    Nat.card (primeFrobeniusSubgroup hρ {u | u ∈ ps ∧ u < w}) <
      Nat.card (primeFrobeniusSubgroup hρ {u | u ∈ ps ∧ u ≤ w})
  /-- The images of the Frobenius classes at the primes of the list generate the image of `ρ`. -/
  primeFrobeniusSubgroup_eq_range : primeFrobeniusSubgroup hρ {u | u ∈ ps} = ρ.range
  /-- The sequence is minimal: the Frobenius image of a good prime `𝔮` outside the list lies in the
  subgroup generated by those of the primes of the list below `𝔮`. -/
  subset_primeFrobeniusSubgroup (w : HeightOneSpectrum (𝓞 K)) : IsGoodPrimeIdeal hρ w → w ∉ ps →
    primeFrobeniusImage hρ w ⊆ primeFrobeniusSubgroup hρ {u | u ∈ ps ∧ u < w}

open scoped Classical in
/-- The **generating primes** (LMFDB `modlgal.generating_primes`) of a mod-`ℓ` Galois representation
`ρ` of `Gal(K̄/K)`, for a total order on the primes of `K`: the sequence of generating primes
(`MonoidHom.IsGeneratingPrimeIdeals`), which is unique (`MonoidHom.IsGeneratingPrimeIdeals.eq`) and
exists when every prime has finitely many primes below it
(`MonoidHom.isGeneratingPrimeIdeals_generatingPrimeIdeals`), as in the Cremona–Page–Sutherland
order. The value `[]` in the case that there is none does not occur then. -/
noncomputable def generatingPrimeIdeals : List (HeightOneSpectrum (𝓞 K)) :=
  if h : ∃ qs, IsGeneratingPrimeIdeals hρ qs then h.choose else []

variable {hρ v ps} in
lemma IsGeneratingPrimeIdeals.not_subset (h : IsGeneratingPrimeIdeals hρ ps) (hv : v ∈ ps) :
    ¬primeFrobeniusImage hρ v ⊆ primeFrobeniusSubgroup hρ {u | u ∈ ps ∧ u < v} := by
  intro hsub
  have heq : primeFrobeniusSubgroup hρ {u | u ∈ ps ∧ u ≤ v} =
      primeFrobeniusSubgroup hρ {u | u ∈ ps ∧ u < v} := by
    refine le_antisymm ((Subgroup.closure_le _).mpr fun x hx ↦ ?_)
      (primeFrobeniusSubgroup_mono hρ fun u hu ↦ ⟨hu.1, hu.2.le⟩)
    rcases Set.mem_iUnion₂.mp hx with ⟨u, ⟨hu, huv⟩, hxu⟩
    rcases huv.lt_or_eq with hlt | rfl
    · exact Subgroup.subset_closure <| Set.mem_iUnion₂.mpr ⟨u, ⟨hu, hlt⟩, hxu⟩
    · exact hsub hxu
  exact (h.card_lt v hv).ne <|
    congrArg (fun H : Subgroup (GL (Fin n) (ZMod ℓ)) ↦ Nat.card H) heq.symm

variable {hρ ps} in
/-- **The sequence of generating primes is unique**, for any total order on the primes of `K`. -/
lemma IsGeneratingPrimeIdeals.eq (h : IsGeneratingPrimeIdeals hρ ps)
    (h' : IsGeneratingPrimeIdeals hρ qs) : ps = qs := by
  have hmem (q : HeightOneSpectrum (𝓞 K)) : q ∈ ps ↔ q ∈ qs := by
    by_contra hq
    -- the least prime in exactly one of the two lists
    have hfin : {r | ¬(r ∈ ps ↔ r ∈ qs)}.Finite :=
      (ps.finite_toSet.union qs.finite_toSet).subset fun r hr ↦ by
        by_cases hrp : r ∈ ps
        · exact Or.inl hrp
        · exact Or.inr (not_not.mp fun hrq ↦ hr ⟨fun h ↦ absurd h hrp, fun h ↦ absurd h hrq⟩)
    rcases hfin.exists_minimal ⟨q, hq⟩ with ⟨r, hr, hmin⟩
    have hset : {u | u ∈ ps ∧ u < r} = {u | u ∈ qs ∧ u < r} :=
      Set.ext fun u ↦ and_congr_left fun hu ↦ not_not.mp fun hne ↦ hu.not_ge (hmin hne hu.le)
    by_cases hr' : r ∈ ps
    · have hrq : r ∉ qs := fun hrq ↦ hr ⟨fun _ ↦ hrq, fun _ ↦ hr'⟩
      exact h.not_subset hr'
        (hset ▸ h'.subset_primeFrobeniusSubgroup r (h.isGoodPrimeIdeal r hr') hrq)
    · have hrq : r ∈ qs := not_not.mp fun hrq ↦ hr ⟨fun h ↦ absurd h hr', fun h ↦ absurd h hrq⟩
      exact h'.not_subset hrq
        (hset ▸ h.subset_primeFrobeniusSubgroup r (h'.isGoodPrimeIdeal r hrq) hr')
  exact ((List.perm_ext_iff_of_nodup h.sortedLT.nodup h'.sortedLT.nodup).mpr hmem).eq_of_sortedLE
    h.sortedLT.sortedLE h'.sortedLT.sortedLE

variable {hρ ps} in
/-- **The generating primes are the sequence of generating primes**, when there is one. -/
lemma generatingPrimeIdeals_eq (h : IsGeneratingPrimeIdeals hρ ps) :
    generatingPrimeIdeals hρ = ps := by
  have he : ∃ qs, IsGeneratingPrimeIdeals hρ qs := ⟨ps, h⟩
  rw [generatingPrimeIdeals, dite_eq_left he]
  exact he.choose_spec.eq h

/-- **The sequence of generating primes exists** for a total order on the primes of `K` in which
every prime has finitely many primes below it, by the Chebotarev density theorem over `K`. It is the
sorted list of the good primes `𝔭` whose Frobenius image is not contained in the subgroup generated
by the Frobenius images of the good primes below `𝔭`. -/
lemma exists_isGeneratingPrimeIdeals (hℓ : ℓ ≠ 0)
    (hfin : ∀ v : HeightOneSpectrum (𝓞 K), {w | w < v}.Finite) :
    ∃ ps, IsGeneratingPrimeIdeals hρ ps := by
  have : WellFoundedLT (HeightOneSpectrum (𝓞 K)) :=
    Subrelation.wf (fun {v w} hvw ↦ Set.ncard_lt_ncard ((Set.ssubset_iff_of_subset
      fun u hu ↦ lt_trans hu hvw).mpr ⟨v, hvw, lt_irrefl v⟩) (hfin w))
        (InvImage.wf (fun v ↦ {w | w < v}.ncard) wellFounded_lt)
  have hfin' (v : HeightOneSpectrum (𝓞 K)) : {w | w ≤ v}.Finite :=
    ((hfin v).union (Set.finite_singleton v)).subset fun _ hw ↦ le_iff_lt_or_eq.mp hw
  have : Finite ρ.range := range_galoisFactor hρ ▸ inferInstance
  have hfinH (s : Set (HeightOneSpectrum (𝓞 K))) : Finite (primeFrobeniusSubgroup hρ s) :=
    Finite.of_injective _ <| Subgroup.inclusion_injective <| primeFrobeniusSubgroup_le_range hρ s
  let H : HeightOneSpectrum (𝓞 K) → Subgroup (GL (Fin n) (ZMod ℓ)) :=
    fun v ↦ primeFrobeniusSubgroup hρ {w | IsGoodPrimeIdeal hρ w ∧ w < v}
  let T : Set (HeightOneSpectrum (𝓞 K)) :=
    {v | IsGoodPrimeIdeal hρ v ∧ ¬primeFrobeniusImage hρ v ⊆ H v}
  have hsub (v : HeightOneSpectrum (𝓞 K)) (hv : IsGoodPrimeIdeal hρ v) (hvT : v ∉ T) :
      primeFrobeniusImage hρ v ⊆ H v :=
    not_not.mp fun h ↦ hvT ⟨hv, h⟩
  have hlt (v : HeightOneSpectrum (𝓞 K)) (hv : v ∈ T) (s : Set (HeightOneSpectrum (𝓞 K)))
      (hs : v ∈ s) (hvs : H v ≤ primeFrobeniusSubgroup hρ s) :
      Nat.card (H v) < Nat.card (primeFrobeniusSubgroup hρ s) :=
    Subgroup.card_lt_of_lt <| lt_of_le_of_ne hvs fun h ↦
      hv.2 (h ▸ primeFrobeniusImage_subset_primeFrobeniusSubgroup hρ v s hs)
  have hTH (v : HeightOneSpectrum (𝓞 K)) : primeFrobeniusSubgroup hρ {w | w ∈ T ∧ w < v} = H v := by
    induction v using WellFoundedLT.induction with
    | _ v ih =>
      refine le_antisymm (primeFrobeniusSubgroup_mono hρ fun w hw ↦ ⟨hw.1.1, hw.2⟩)
        ((Subgroup.closure_le _).mpr <| Set.iUnion₂_subset fun w hw ↦ ?_)
      by_cases hwT : w ∈ T
      · exact primeFrobeniusImage_subset_primeFrobeniusSubgroup hρ w _ ⟨hwT, hw.2⟩
      · exact fun x hx ↦ primeFrobeniusSubgroup_mono hρ
          (by exact fun u hu ↦ ⟨hu.1, hu.2.trans hw.2⟩) ((ih w hw.2).symm.le (hsub w hw.1 hwT hx))
  have hT : T.Finite := by
    have hmono : StrictMonoOn
        (fun v ↦ Nat.card (primeFrobeniusSubgroup hρ {w | IsGoodPrimeIdeal hρ w ∧ w ≤ v})) T :=
      fun v _ v' hv' hvv' ↦ (Subgroup.card_le_of_le (primeFrobeniusSubgroup_mono hρ
        (by exact fun w hw ↦ ⟨hw.1, hw.2.trans_lt hvv'⟩))).trans_lt <| hlt v' hv' _ ⟨hv'.1, le_rfl⟩
          (primeFrobeniusSubgroup_mono hρ fun w hw ↦ ⟨hw.1, hw.2.le⟩)
    refine .of_finite_image ((Set.finite_Iic (Nat.card ρ.range)).subset ?_) hmono.injOn
    rintro _ ⟨v, -, rfl⟩
    exact Subgroup.card_le_of_le (primeFrobeniusSubgroup_le_range hρ _)
  let ps : List (HeightOneSpectrum (𝓞 K)) := hT.toFinset.sort (· ≤ ·)
  have hmem (w : HeightOneSpectrum (𝓞 K)) : w ∈ ps ↔ w ∈ T :=
    (Finset.mem_sort _).trans hT.mem_toFinset
  have hset (P : HeightOneSpectrum (𝓞 K) → Prop) : {u | u ∈ ps ∧ P u} = {u | u ∈ T ∧ P u} :=
    Set.ext fun u ↦ and_congr_left fun _ ↦ hmem u
  refine ⟨ps, Finset.sortedLT_sort _, fun w hw ↦ ((hmem w).mp hw).1, fun w hw ↦ ?_, ?_,
    fun w hw hwps ↦ ?_⟩
  · rw [hset (· < w), hset (· ≤ w), hTH w]
    exact hlt w ((hmem w).mp hw) {u | u ∈ T ∧ u ≤ w} ⟨(hmem w).mp hw, le_rfl⟩
      ((hTH w).symm.le.trans <| primeFrobeniusSubgroup_mono hρ fun u hu ↦ ⟨hu.1, hu.2.le⟩)
  · have hps : {w | w ∈ ps} = T := Set.ext hmem
    rw [hps]
    refine le_antisymm (primeFrobeniusSubgroup_le_range hρ T) fun x hx ↦ by_contra fun hxT ↦ ?_
    rcases (range_galoisFactor hρ ▸ hx : x ∈ (galoisFactor hρ).range) with ⟨σ, rfl⟩
    rcases exists_isGoodPrimeIdeal_mem_primeFrobeniusImage hρ (⋃ t ∈ T, {w | w ≤ t}) hℓ σ
      (hT.biUnion fun t _ ↦ hfin' t) with ⟨v, hvT, hv, hσv⟩
    have hTv : ∀ t ∈ T, t < v := fun t ht ↦ lt_of_not_ge fun hvt ↦
      hvT (Set.mem_biUnion ht hvt)
    have hTv' : {w | w ∈ T ∧ w < v} = T := Set.ext fun w ↦ and_iff_left_of_imp (hTv w)
    have hvT' : v ∈ T := by
      refine ⟨hv, fun h ↦ hxT ?_⟩
      rw [← hTv', hTH v]
      exact h hσv
    exact lt_irrefl v (hTv v hvT')
  · rw [hset (· < w), hTH w]
    exact hsub w hw fun hwT ↦ hwps <| (hmem w).mpr hwT

/-- **The generating primes form the sequence of generating primes** for a total order on the primes
of `K` in which every prime has finitely many primes below it. -/
lemma isGeneratingPrimeIdeals_generatingPrimeIdeals (hℓ : ℓ ≠ 0)
    (hfin : ∀ v : HeightOneSpectrum (𝓞 K), {w | w < v}.Finite) :
    IsGeneratingPrimeIdeals hρ (generatingPrimeIdeals hρ) := by
  rcases exists_isGeneratingPrimeIdeals hρ hℓ hfin with ⟨ps, h⟩
  exact (generatingPrimeIdeals_eq h).symm ▸ h

end Order

/-- **The generating primes of `ρ` for the order of the LMFDB** (LMFDB `modlgal.generating_primes`):
for an integral primitive element `α` of `K`, `MonoidHom.generatingPrimeIdeals` is the sequence of
generating primes of `ρ` for the Cremona–Page–Sutherland order on the primes of `K`
(`NumberField.primeLinearOrder`, LMFDB `nf.ideal_labels`), by norm, then by ramification index,
then by the `p`-adic digits of the corresponding factor of the minimal polynomial of `α`. -/
lemma isGeneratingPrimeIdeals_primeLinearOrder (hℓ : ℓ ≠ 0) (α : 𝓞 K) (hα : ℚ⟮(α : K)⟯ = ⊤) :
    letI : LinearOrder (HeightOneSpectrum (𝓞 K)) := primeLinearOrder α hα
    IsGeneratingPrimeIdeals hρ (generatingPrimeIdeals hρ) :=
  let _ : LinearOrder (HeightOneSpectrum (𝓞 K)) := primeLinearOrder α hα
  isGeneratingPrimeIdeals_generatingPrimeIdeals hρ hℓ (finite_setOf_lt_primeLinearOrder α hα)

end MonoidHom
