import LeanBridge.ForMathlib.NumberTheory.SatoTateGroup.Basic
import TauCeti.Topology.Algebra.Group.Connected

/-!
# Generators of Sato–Tate groups

The LMFDB describes a Sato–Tate group `G` by its identity component `G⁰` and a set `S` of matrices
in `G` that together with `G⁰` generate `G`. Since `G⁰` is normal in `G`, this says that the
classes of `S` generate the component group `G/G⁰`, so that the subgroup `⟨S⟩` meets every coset
of `G⁰`. In general `⟨S⟩` is larger than a set of representatives of `G/G⁰`, but when `G⁰` is
trivial, as for the finite Sato–Tate groups of weight `0`, `⟨S⟩` is `G` itself.

## Main definitions

* `SatoTateGroup.IsGeneratingSet` (LMFDB `st_group.generators`).

## Main results

* `SatoTateGroup.isGeneratingSet_iff_closure_image_eq_top`: `S` generates `G` together with `G⁰`
  if and only if its image generates the component group `G/G⁰`.
* `SatoTateGroup.IsGeneratingSet.exists_mem_closure_mk_eq`: the subgroup `⟨S⟩` contains a
  representative of every element of the component group.
* `SatoTateGroup.IsGeneratingSet.closure_eq_top`: if `G⁰` is trivial, `S` generates `G`.
-/

open Subgroup (connectedComponentOfOne)

namespace SatoTateGroup

variable {G : SatoTateGroup} {S : Set G.toSubgroup}

variable (G S) in
/-- A set `S` of elements of a Sato–Tate group `G`, which are matrices of `U(d)`, is a set of
**generators** of `G` (LMFDB `st_group.generators`) if `S` and the identity component `G⁰` (LMFDB
`st_group.identity_component`) together generate `G`. -/
def IsGeneratingSet : Prop :=
  Subgroup.closure S ⊔ connectedComponentOfOne G.toSubgroup = ⊤

/-- **A set generates a Sato–Tate group `G` together with its identity component `G⁰` if and only
if its image generates the component group `G/G⁰`** (LMFDB `st_group.generators`,
`st_group.component_group`). -/
lemma isGeneratingSet_iff_closure_image_eq_top : G.IsGeneratingSet S ↔ Subgroup.closure
    (QuotientGroup.mk '' S : Set (G.toSubgroup ⧸ connectedComponentOfOne G.toSubgroup)) = ⊤ := by
  rw [IsGeneratingSet, ← QuotientGroup.coe_mk', ← MonoidHom.map_closure,
    ← (Subgroup.comap_injective (QuotientGroup.mk'_surjective _)).eq_iff, Subgroup.comap_map_eq,
    QuotientGroup.ker_mk', Subgroup.comap_top]

/-- **The subgroup generated by a set of generators of a Sato–Tate group contains representatives
of every element of the component group** (LMFDB `st_group.generators`). -/
lemma IsGeneratingSet.exists_mem_closure_mk_eq (hS : G.IsGeneratingSet S)
    (q : G.toSubgroup ⧸ connectedComponentOfOne G.toSubgroup) :
    ∃ g ∈ Subgroup.closure S, (g : G.toSubgroup ⧸ connectedComponentOfOne G.toSubgroup) = q := by
  rw [isGeneratingSet_iff_closure_image_eq_top, ← QuotientGroup.coe_mk', ← MonoidHom.map_closure]
    at hS
  exact hS.ge <| Subgroup.mem_top q

/-- **A set of generators of a Sato–Tate group with trivial identity component generates it**
(LMFDB `st_group.generators`), as for the finite Sato–Tate groups of weight `0`. -/
lemma IsGeneratingSet.closure_eq_top (hS : G.IsGeneratingSet S)
    (hG : connectedComponentOfOne G.toSubgroup = ⊥) : Subgroup.closure S = ⊤ := by
  rwa [IsGeneratingSet, hG, sup_bot_eq] at hS

end SatoTateGroup
