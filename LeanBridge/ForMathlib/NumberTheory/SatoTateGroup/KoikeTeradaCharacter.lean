import LeanBridge.ForMathlib.NumberTheory.SatoTateGroup.AmbientDensity
import LeanBridge.ForMathlib.NumberTheory.SatoTateGroup.SpGroupAction
import LeanBridge.ForMathlib.NumberTheory.SatoTateGroup.SpWeylFormula
import Mathlib.Topology.Algebra.Module.Cardinality
import TauCeti.Algebra.Lie.HighestWeight.CompleteReducibility
import TauCeti.Algebra.Lie.HighestWeight.Existence
import TauCeti.Algebra.Lie.HighestWeight.Isotypic

/-!
# The characters of the highest weight submodules of the tensor powers

A Lie submodule `U` of a tensor power of the standard module generated by a highest weight vector
of weight `∑ c_k ω_k` is an irreducible representation of `USp(2g)`, and its character is the
Koike–Terada function `SatoTateGroup.symplecticSchur c` of the eigenvalues. On the torus, the trace
of a matrix of the group is the evaluation of the formal character of `U`, which Weyl's character
formula and `SatoTateGroup.symplecticSchur_mul_det` compare to the Koike–Terada function, wherever
the Weyl denominator does not vanish, and so on all the torus by continuity. The spectral theorem
carries the equality over to the group.

Conversely, every irreducible representation of `USp(2g)` occurs in a tensor power, since its
character occurs in a power of the trace, and the tensor power is a sum of irreducible Lie
submodules by Weyl's theorem.

## Main results

* `SatoTateGroup.exists_eq_conj_uspTorus`: every matrix of `USp(2g)` is conjugate to a matrix of the
  torus.
* `SatoTateGroup.trace_spGroupRep_eq_symplecticSchur`: the trace on a highest weight submodule of a
  tensor power is the Koike–Terada function.
* `SatoTateGroup.exists_lieSubmodule_equiv`: every irreducible representation of `USp(2g)` is an
  irreducible Lie submodule of a tensor power of the standard representation.
-/

open LieAlgebra LieModule Matrix Module TauCeti

open scoped ComplexConjugate Real

attribute [local instance 100] LieRing.ofAssociativeRing

namespace SatoTateGroup

variable {w g : ℕ} (hw : Odd w)

section Continuity

variable {x : ℝ → Fin g → ℂ}

lemma continuous_esymm_torusEigenvalues (hx : Continuous x) (hx₀ : ∀ t j, x t j ≠ 0) (k : ℕ) :
    Continuous fun t ↦ (torusEigenvalues (x t)).esymm k := by
  let M : Multiset (Fin g ⊕ Fin g) := Finset.univ.val.map Sum.inl + Finset.univ.val.map Sum.inr
  let F : ℝ → Fin g ⊕ Fin g → ℂ := fun t ↦ Sum.elim (x t) fun j ↦ (x t j)⁻¹
  have hF (a : Fin g ⊕ Fin g) : Continuous fun t ↦ F t a := by
    rcases a with j | j
    · exact (continuous_apply j).comp hx
    · exact ((continuous_apply j).comp hx).inv₀ fun t ↦ hx₀ t j
  have h₁ (t : ℝ) : (torusEigenvalues (x t)).esymm k =
      ((Multiset.powersetCard k M).map fun u ↦ (u.map fun a ↦ F t a).prod).sum := by
    have h₂ : torusEigenvalues (x t) = M.map (F t) := by
      simp [torusEigenvalues, M, F]
    rw [h₂, Multiset.esymm, Multiset.powersetCard_map, Multiset.map_map]
    rfl
  simp only [h₁]
  exact continuous_multiset_sum _ fun u _ ↦ continuous_multiset_prod u fun a _ ↦ hF a

lemma continuous_symplecticSchur_torusEigenvalues (c : Fin g → ℕ) (hx : Continuous x)
    (hx₀ : ∀ t j, x t j ≠ 0) : Continuous fun t ↦ symplecticSchur c (torusEigenvalues (x t)) := by
  have h₁ (m : ℤ) : Continuous fun t ↦ esymmOfInt (torusEigenvalues (x t)) m := by
    by_cases hm : 0 ≤ m
    · simp only [esymmOfInt, hm]
      exact continuous_esymm_torusEigenvalues hx hx₀ _
    · simp only [esymmOfInt, hm]
      exact continuous_const
  exact Continuous.matrix_det (continuous_matrix fun i j ↦ (h₁ _).sub (h₁ _))

lemma continuous_uspTorusMatrix : Continuous (uspTorusMatrix (g := g)) := by
  refine continuous_matrix fun i j ↦ ?_
  by_cases h : i = j
  · subst h
    simp only [uspTorusMatrix, diagonal_apply_eq]
    induction i using Fin.addCases with
    | left j =>
      simp only [uspTorusEntry_castAdd]
      exact continuous_induced_dom.comp (continuous_apply j)
    | right j =>
      simp only [uspTorusEntry_natAdd]
      exact continuous_induced_dom.comp (continuous_apply j).inv
  · simp only [uspTorusMatrix, diagonal_apply_ne _ h]
    exact continuous_const

lemma continuous_uspTorus :
    Continuous (uspTorus hw rfl : (Fin g → Circle) → ambientGroup w (g + g)) :=
  continuous_induced_rng.mpr (continuous_induced_rng.mpr continuous_uspTorusMatrix)

end Continuity

section Torus

variable (τ : Fin g → ℝ)

/-- The point of the torus with angles `τ`. -/
noncomputable def torusCoord : Fin g → Circle :=
  fun j ↦ Circle.exp (τ j)

/-- The element of the Cartan subalgebra whose exponential is the point of the torus with angles
`τ`. -/
noncomputable def torusLog : Fin g → ℂ :=
  fun j ↦ (τ j : ℂ) * Complex.I

lemma coe_torusCoord (j : Fin g) : (torusCoord τ j : ℂ) = Complex.exp (torusLog τ j) :=
  Circle.coe_exp _

lemma ambientToUsp_uspTorus_eq (x : Fin g → Circle) :
    ambientToUsp (uspTorus hw rfl x : ambientGroup w (g + g)) =
      diagonal (Sum.elim (fun i ↦ (x i : ℂ)) fun i ↦ ((x i)⁻¹ : Circle)) := by
  rw [ambientToUsp_eq_submatrix, coe_uspTorus, uspTorusMatrix, submatrix_diagonal_equiv]
  congr 1
  funext a
  rcases a with j | j
  · simp only [Function.comp_apply, finSumFinEquiv_apply_left, uspTorusEntry_castAdd, Sum.elim_inl]
  · simp only [Function.comp_apply, finSumFinEquiv_apply_right, uspTorusEntry_natAdd, Sum.elim_inr]

/-- **Every matrix of `USp(2g)` is conjugate to a matrix of the torus.** -/
lemma exists_eq_conj_uspTorus (h : ambientGroup w (g + g)) :
    ∃ (x : Fin g → Circle) (k : ambientGroup w (g + g)), h = k * uspTorus hw rfl x * k⁻¹ := by
  rcases (isUsp_ambientToUsp hw h).exists_mul_eq_mul_diagonal with ⟨C, x, hC, hAC⟩
  rcases exists_ambientToUsp_eq (w := w) hw hC with ⟨k, rfl⟩
  refine ⟨x, k, mul_right_cancel (b := k) (injective_ambientToUsp ?_)⟩
  rw [inv_mul_cancel_right, map_mul, map_mul, hAC, ambientToUsp_uspTorus_eq]

lemma charpoly_eq_of_eq_conj_uspTorus {h k : ambientGroup w (g + g)} {x : Fin g → Circle}
    (h₁ : h = k * uspTorus hw rfl x * k⁻¹) :
    (h : Matrix (Fin (g + g)) (Fin (g + g)) ℂ).charpoly = (uspTorusMatrix x).charpoly := by
  have h₂ : ambientToUsp k⁻¹ * ambientToUsp k = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  rw [← charpoly_ambientToUsp, ← coe_uspTorus hw, ← charpoly_ambientToUsp, h₁, map_mul, map_mul,
    charpoly_mul_comm, ← Matrix.mul_assoc, h₂, Matrix.one_mul]

lemma ambientToUsp_uspTorus : ambientToUsp (uspTorus hw rfl (torusCoord τ) :
    ambientGroup w (g + g)) = diagonal fun a ↦ Complex.exp (spValue (torusLog τ) a) := by
  rw [ambientToUsp_uspTorus_eq]
  congr 1
  funext a
  rcases a with j | j
  · exact coe_torusCoord τ j
  · rw [Sum.elim_inr, Circle.coe_inv, coe_torusCoord, spValue_inr, Complex.exp_neg]

variable {P : Type*} [Fintype P] [DecidableEq P]
  (U : LieSubmodule ℂ (Symplectic.sp (Fin g) ℂ) (SpTensor P g)) (v : U)
  (a : P → Fin g ⊕ Fin g)

lemma lie_spDiag_apply (θ : Fin g → ℂ) : (⁅spDiag θ, v⁆ : U).1 a = (∑ p, spValue θ (a p)) * v.1 a :=
  tensorAction_diagonal_mulVec_apply v.1 a _

lemma apply_spGroupRep_torus : (spGroupRep hw U (uspTorus hw rfl (torusCoord τ)) v).1 a =
    Complex.exp (∑ p, spValue (torusLog τ) (a p)) * v.1 a := by
  rw [Complex.exp_sum]
  exact (congrArg (fun A ↦ (tensorRep A *ᵥ v.1) a) (ambientToUsp_uspTorus hw τ)).trans
    (tensorRep_diagonal_mulVec_apply v.1 a _)

variable {v} in
lemma spGroupRep_torus_apply {m : ℂ} (hv : ⁅spDiag (torusLog τ), v⁆ = m • v) :
    spGroupRep hw U (uspTorus hw rfl (torusCoord τ)) v = Complex.exp m • v := by
  refine Subtype.ext (funext fun a ↦ ?_)
  have h₄ : (∑ p, spValue (torusLog τ) (a p)) * v.1 a = m * v.1 a :=
    (lie_spDiag_apply U v a _).symm.trans (congrFun (congrArg Subtype.val hv) a)
  have h₆ : ((Complex.exp m • v : U) : SpTensor P g) a = Complex.exp m * v.1 a :=
    rfl
  rw [apply_spGroupRep_torus, h₆]
  by_cases h₅ : v.1 a = 0
  · rw [h₅, mul_zero, mul_zero]
  · rw [mul_right_cancel₀ h₅ h₄]

lemma trace_spGroupRep_torus :
    LinearMap.trace ℂ U (spGroupRep hw U (uspTorus hw rfl (torusCoord τ))) =
      spEval ⟨spDiag (torusLog τ), spDiag_mem_spCartan _⟩
        (formalCharacter ℂ (spCartan (g := g)) U) := by
  refine trace_eq_spEval_formalCharacter _ fun μ v hv ↦ spGroupRep_torus_apply hw τ U ?_
  have h₁ : v ∈ weightSpace U (μ : spCartan (g := g) → ℂ) := by
    rwa [← genWeightSpace_eq_weightSpace]
  exact (mem_weightSpace _ _).mp h₁ ⟨spDiag (torusLog τ), spDiag_mem_spCartan _⟩

/-- The angles `τ` are generic: no root is an integer multiple of `2π` at `τ`. -/
def IsGenericAngle : Prop :=
  ∀ a b : Fin g ⊕ Fin g, a ≠ b → ∀ n : ℤ,
    spValue (fun j ↦ (τ j : ℂ)) a - spValue (fun j ↦ (τ j : ℂ)) b ≠ n * (2 * π)

lemma spValue_torusLog (b : Fin g ⊕ Fin g) :
    spValue (torusLog τ) b = spValue (fun j ↦ (τ j : ℂ)) b * Complex.I := by
  rcases b with j | j
  · rfl
  · simp [spValue_inr, torusLog]

variable {τ} in
lemma det_weylEntry_ne_zero (hτ : IsGenericAngle τ) :
    (of fun i j : Fin g ↦ weylEntry (fun k ↦ Complex.exp (torusLog τ k)) j (g - i)).det ≠ 0 := by
  intro h₀
  have h₁ : spEval ⟨spDiag (torusLog τ), spDiag_mem_spCartan _⟩
      (weylDenominator (spRootSystem g) spBase) = (of fun i j : Fin g ↦
        weylEntry (fun k ↦ Complex.exp (torusLog τ k)) j (g - i)).det *
          Complex.exp (-weylVector (spRootSystem g) spBase
            ⟨spDiag (torusLog τ), spDiag_mem_spCartan _⟩) :=
    spEval_weylDenominator (torusLog τ)
  rw [h₀, zero_mul, weylDenominator_def, map_prod, Finset.prod_eq_zero_iff] at h₁
  rcases h₁ with ⟨i, -, hi⟩
  rcases exists_eq_spRootForm i.1 (spCartan.isNonZero_coe_root i) with ⟨a, b, hab, h₂⟩
  have h₃ : (spRootSystem g).root i = spRootForm a b :=
    LinearMap.ext fun y ↦ congrFun h₂ y
  rw [map_sub, map_one, spEval_single, h₃, LinearMap.neg_apply, spRootForm_spDiag] at hi
  have h₄ : Complex.exp (-(spValue (torusLog τ) a - spValue (torusLog τ) b)) = 1 := by
    simp only [Int.cast_one, one_mul] at hi
    exact (sub_eq_zero.mp hi).symm
  rcases Complex.exp_eq_one_iff.mp h₄ with ⟨n, hn⟩
  refine hτ a b hab (-n) ?_
  rw [spValue_torusLog, spValue_torusLog, ← sub_mul] at hn
  have h₅ : (spValue (fun j ↦ (τ j : ℂ)) a - spValue (fun j ↦ (τ j : ℂ)) b + n * (2 * π)) *
      Complex.I = 0 := by
    linear_combination -hn
  have h₆ : spValue (fun j ↦ (τ j : ℂ)) a - spValue (fun j ↦ (τ j : ℂ)) b + n * (2 * π) = 0 :=
    (mul_eq_zero.mp h₅).resolve_right Complex.I_ne_zero
  push_cast
  linear_combination h₆

/-- The line through `τ` in the direction of `(g, g - 1, …, 1)`. -/
noncomputable def angleLine (t : ℝ) : Fin g → ℝ :=
  fun j ↦ τ j + t * ((g - j : ℕ) : ℝ)

lemma spValue_angleLine (t : ℝ) (b : Fin g ⊕ Fin g) : spValue (fun j ↦ (angleLine τ t j : ℂ)) b =
    spValue (fun j ↦ (τ j : ℂ)) b + (t : ℂ) * (spHeight b : ℂ) := by
  rcases b with j | j
  · simp [spValue_inl, angleLine, spHeight]
  · simp [spValue_inr, angleLine, spHeight]
    ring1

lemma countable_not_isGenericAngle_angleLine :
    {t : ℝ | ¬IsGenericAngle (angleLine τ t)}.Countable := by
  have h₁ : {t : ℝ | ¬IsGenericAngle (angleLine τ t)} ⊆ ⋃ (a : Fin g ⊕ Fin g) (b : Fin g ⊕ Fin g)
      (_ : a ≠ b) (n : ℤ), {t : ℝ | spValue (fun j ↦ (angleLine τ t j : ℂ)) a -
        spValue (fun j ↦ (angleLine τ t j : ℂ)) b = n * (2 * π)} := by
    intro t ht
    simp only [IsGenericAngle, not_forall, not_not] at ht
    rcases ht with ⟨a, b, hab, n, h⟩
    simp only [Set.mem_iUnion]
    exact ⟨a, b, hab, n, h⟩
  refine .mono h₁ <| Set.countable_iUnion fun a ↦ Set.countable_iUnion fun b ↦
    Set.countable_iUnion fun hab ↦ Set.countable_iUnion fun n ↦ (?_ : Set.Subsingleton _).countable
  intro t ht t' ht'
  simp only [Set.mem_ofPred_eq, spValue_angleLine] at ht ht'
  have h₂ : ((spHeight a - spHeight b : ℤ) : ℂ) ≠ 0 := by
    have h₃ : spHeight a ≠ spHeight b := fun h ↦ hab (spHeight_injective h)
    exact_mod_cast sub_ne_zero.mpr h₃
  have h₃ : ((t : ℂ) - t') * ((spHeight a - spHeight b : ℤ) : ℂ) = 0 := by
    push_cast
    linear_combination ht - ht'
  have h₄ : (t : ℂ) - t' = 0 := (mul_eq_zero.mp h₃).resolve_right h₂
  exact_mod_cast sub_eq_zero.mp h₄

variable {U} {c : Fin g → ℕ} {v}

variable {τ} in
lemma trace_torus_eq_of_isGenericAngle (hv : IsHighestWeightVector spBase (spPartitionWeight c) v)
    (hgen : LieSubmodule.lieSpan ℂ (Symplectic.sp (Fin g) ℂ) {v} = ⊤) (hτ : IsGenericAngle τ) :
    LinearMap.trace ℂ U (spGroupRep hw U (uspTorus hw rfl (torusCoord τ))) =
      symplecticSchur c (torusEigenvalues fun j ↦ Complex.exp (torusLog τ j)) := by
  have h₁ : spEval ⟨spDiag (torusLog τ), spDiag_mem_spCartan _⟩
      (formalCharacter ℂ (spCartan (g := g)) U) *
        (of fun i j : Fin g ↦ weylEntry (fun k ↦ Complex.exp (torusLog τ k)) j (g - i)).det =
      (of fun i j : Fin g ↦
        weylEntry (fun k ↦ Complex.exp (torusLog τ k)) j (highestWeight c i + g - i)).det :=
    spEval_formalCharacter_mul_det c hv hgen (torusLog τ)
  rw [← trace_spGroupRep_torus hw τ U] at h₁
  exact mul_right_cancel₀ (det_weylEntry_ne_zero hτ) (h₁.trans (symplecticSchur_mul_det c
    (x := fun j ↦ Complex.exp (torusLog τ j)) fun j ↦ Complex.exp_ne_zero _).symm)

lemma trace_torus_eq (hv : IsHighestWeightVector spBase (spPartitionWeight c) v)
    (hgen : LieSubmodule.lieSpan ℂ (Symplectic.sp (Fin g) ℂ) {v} = ⊤) :
    LinearMap.trace ℂ U (spGroupRep hw U (uspTorus hw rfl (torusCoord τ))) =
      symplecticSchur c (torusEigenvalues fun j ↦ Complex.exp (torusLog τ j)) := by
  have hline : Continuous fun t ↦ torusCoord (angleLine τ t) :=
    continuous_pi fun j ↦ Circle.exp.continuous.comp (by unfold angleLine; fun_prop)
  have hl : Continuous fun t ↦ LinearMap.trace ℂ U (spGroupRep hw U
      (uspTorus hw rfl (torusCoord (angleLine τ t)))) :=
    (continuous_trace _ (continuous_spGroupRep hw U)).comp ((continuous_uspTorus hw).comp hline)
  have hr : Continuous fun t ↦ symplecticSchur c
      (torusEigenvalues fun j ↦ Complex.exp (torusLog (angleLine τ t) j)) :=
    continuous_symplecticSchur_torusEigenvalues c
      (continuous_pi fun j ↦ Complex.continuous_exp.comp (by unfold torusLog angleLine; fun_prop))
      fun t j ↦ Complex.exp_ne_zero _
  have h₁ : (fun t ↦ LinearMap.trace ℂ U (spGroupRep hw U
      (uspTorus hw rfl (torusCoord (angleLine τ t))))) = fun t ↦ symplecticSchur c
        (torusEigenvalues fun j ↦ Complex.exp (torusLog (angleLine τ t) j)) :=
    Continuous.ext_on ((countable_not_isGenericAngle_angleLine τ).dense_compl ℝ) hl hr fun t ht ↦
      trace_torus_eq_of_isGenericAngle hw hv hgen (not_not.mp ht)
  have h₂ : angleLine τ 0 = τ := by
    funext j
    simp [angleLine]
  have h₃ : LinearMap.trace ℂ U (spGroupRep hw U
      (uspTorus hw rfl (torusCoord (angleLine τ 0)))) = symplecticSchur c
        (torusEigenvalues fun j ↦ Complex.exp (torusLog (angleLine τ 0) j)) :=
    congrFun h₁ 0
  rwa [h₂] at h₃

/-- **On a highest weight submodule of a tensor power, the trace is the Koike–Terada function.** -/
lemma trace_spGroupRep_eq_symplecticSchur
    (hv : IsHighestWeightVector spBase (spPartitionWeight c) v)
    (hgen : LieSubmodule.lieSpan ℂ (Symplectic.sp (Fin g) ℂ) {v} = ⊤) (h : ambientGroup w (g + g)) :
    LinearMap.trace ℂ U (spGroupRep hw U h) =
      symplecticSchur c (h : Matrix (Fin (g + g)) (Fin (g + g)) ℂ).charpoly.roots := by
  rcases exists_eq_conj_uspTorus hw h with ⟨x, k, h₁⟩
  have hx : torusCoord (fun j ↦ Complex.arg (x j)) = x :=
    funext fun j ↦ Circle.exp_arg (x j)
  have h₂ : LinearMap.trace ℂ U (spGroupRep hw U h) =
      LinearMap.trace ℂ U (spGroupRep hw U (uspTorus hw rfl x)) := by
    rw [h₁]
    exact Representation.char_conj _ _ _
  rw [h₂, charpoly_eq_of_eq_conj_uspTorus hw h₁, roots_charpoly_uspTorusMatrix, ← hx,
    trace_torus_eq hw _ hv hgen]
  simp only [coe_torusCoord]

end Torus

lemma trace_ambientToUsp (h : ambientGroup w (g + g)) :
    (ambientToUsp h).trace = (h : Matrix (Fin (g + g)) (Fin (g + g)) ℂ).trace :=
  Equiv.sum_comp finSumFinEquiv fun i ↦ (h : Matrix (Fin (g + g)) (Fin (g + g)) ℂ) i i

lemma trace_pow_eq_sum_trace {P : Type*} [Fintype P] [DecidableEq P] {k : ℕ}
    {N : Fin k → LieSubmodule ℂ (Symplectic.sp (Fin g) ℂ) (SpTensor P g)}
    (hN : DirectSum.IsInternal fun i ↦ (N i).toSubmodule) (h : ambientGroup w (g + g)) :
    (h : Matrix (Fin (g + g)) (Fin (g + g)) ℂ).trace ^ Fintype.card P =
      ∑ i, LinearMap.trace ℂ (N i) (spGroupRep hw (N i) h) := by
  let φ : SpTensor P g →ₗ[ℂ] SpTensor P g := toLin' (tensorRep (P := P) (ambientToUsp h))
  have hmaps (i : Fin k) : Set.MapsTo φ (N i).toSubmodule (N i).toSubmodule := fun f hf ↦
    tensorRep_mulVec_mem_of_lieSubmodule hw (N i) h hf
  have h₁ : (tensorRep (P := P) (ambientToUsp h)).trace = LinearMap.trace ℂ (SpTensor P g) φ :=
    (Matrix.trace_toLin'_eq _).symm
  rw [← trace_ambientToUsp, ← trace_tensorRep, h₁, LinearMap.trace_eq_sum_trace_restrict hN hmaps]
  rfl

/-- **Every irreducible representation of `USp(2g)` is an irreducible Lie submodule of a tensor
power of the standard representation.** -/
lemma exists_lieSubmodule_equiv (χ : IrrepClass ℂ (ambientGroup w (g + g))) :
    ∃ (n : ℕ) (U : LieSubmodule ℂ (Symplectic.sp (Fin g) ℂ) (SpTensor (Fin n) g))
      (_ : LieModule.IsIrreducible ℂ (Symplectic.sp (Fin g) ℂ) U)
      (e : U ≃ₗ[ℂ] EuclideanSpace ℂ (Fin χ.model.dim)),
        ∀ h x, e (spGroupRep hw U h x) = χ.model.rep h (e x) := by
  rcases exists_integral_trace_pow_mul_conj_ne_zero (isUnit_ambientForm_of_odd hw) χ with ⟨n, hn⟩
  rcases exists_isInternal_isIrreducible_of_isKilling ℂ (Symplectic.sp (Fin g) ℂ)
    (SpTensor (Fin n) g) with ⟨k, N, hN, hirr⟩
  have h₁ (i : Fin k) : ∃ (χ' : IrrepClass ℂ (ambientGroup w (g + g)))
      (e : N i ≃ₗ[ℂ] EuclideanSpace ℂ (Fin χ'.model.dim)),
        ∀ h x, e (spGroupRep hw (N i) h x) = χ'.model.rep h (e x) := by
    have : LieModule.IsIrreducible ℂ (Symplectic.sp (Fin g) ℂ) (N i) := hirr i
    exact exists_irrepClass_equiv (spGroupRep hw (N i)) (isIrreducible_spGroupRep hw (N i))
      (continuous_spGroupRep hw (N i))
  choose χ' e he using h₁
  have h₂ (i : Fin k) (h : ambientGroup w (g + g)) :
      ambientCharacter w (g + g) (χ' i) h = LinearMap.trace ℂ (N i) (spGroupRep hw (N i) h) :=
    character_model_eq_trace (e i) (he i) h
  have h₃ : ∃ i, χ' i = χ := by
    by_contra hcon
    push Not at hcon
    refine hn ?_
    have h₄ (h : ambientGroup w (g + g)) : (h : Matrix (Fin (g + g)) (Fin (g + g)) ℂ).trace ^ n *
        conj (ambientCharacter w (g + g) χ h) =
          ∑ i, ambientCharacter w (g + g) (χ' i) h * conj (ambientCharacter w (g + g) χ h) := by
      have h₅ : (h : Matrix (Fin (g + g)) (Fin (g + g)) ℂ).trace ^ Fintype.card (Fin n) =
          ∑ i, LinearMap.trace ℂ (N i) (spGroupRep hw (N i) h) :=
        trace_pow_eq_sum_trace hw hN h
      rw [Fintype.card_fin] at h₅
      rw [h₅, Finset.sum_mul]
      exact Finset.sum_congr rfl fun i _ ↦ by rw [h₂]
    have hint (i : Fin k) : MeasureTheory.Integrable (fun h ↦
        ambientCharacter w (g + g) (χ' i) h * conj (ambientCharacter w (g + g) χ h))
          (haarProb (ambientGroup w (g + g))) :=
      Continuous.integrable_of_hasCompactSupport ((ambientCharacter w (g + g) (χ' i)).continuous.mul
        (Complex.continuous_conj.comp (ambientCharacter w (g + g) χ).continuous))
        (HasCompactSupport.of_compactSpace _)
    simp only [h₄]
    rw [MeasureTheory.integral_finsetSum _ fun i _ ↦ hint i]
    exact Finset.sum_eq_zero fun i _ ↦
      integral_ambientCharacter_mul_conj_of_ne w (g + g) (Ne.symm (hcon i))
  rcases h₃ with ⟨i, rfl⟩
  exact ⟨n, N i, hirr i, e i, he i⟩

end SatoTateGroup
