import LeanBridge.ForMathlib.NumberTheory.SatoTateGroup.Basic
import Mathlib.Analysis.Complex.Circle
import Mathlib.Topology.Algebra.ContinuousMonoidHom
import Mathlib.Topology.Algebra.Group.Subgroup

/-!
# Hodge circles of Sato–Tate groups

A Hodge circle of a Sato–Tate group `G` of degree `d` and weight `w` is a continuous homomorphism
`h : U(1) → G⁰` such that, for some nonnegative integers `h^{p,q}` (`0 ≤ p, q ≤ w`) adding up to
`d`, every `h(u)` has the eigenvalues `u^{p-q}` with multiplicities `h^{p,q}`, and the conjugates of
the image of `h` generate a dense subgroup of `G⁰`.

## Main definitions

* `SatoTateGroup.HasHodgeEigenvalues`: `h(u)` has eigenvalues `u^{p-q}` with multiplicities
  `h^{p,q}`.
* `SatoTateGroup.IsHodgeCircle` (LMFDB `st_group.hodge_circle`).
-/

open Matrix Polynomial

namespace SatoTateGroup

variable (G : SatoTateGroup) (h : Circle →ₜ* G.toSubgroup)

/-- A continuous homomorphism `h : U(1) → G` **has Hodge eigenvalues** `h^{p,q}`, for a family of
nonnegative integers `h^{p,q}` indexed by `0 ≤ p, q ≤ w` with `w` the weight of `G`, if they add
up to the degree `d` and, for every `u ∈ U(1)`, the characteristic polynomial of `h(u)` is
`∏_{p,q} (X - u^{p-q})^{h^{p,q}}`: `h(u)` has the eigenvalues `u^{p-q}` with multiplicities
`h^{p,q}`. -/
def HasHodgeEigenvalues (hodge : ℕ → ℕ → ℕ) : Prop :=
  ∑ p ∈ Finset.range (G.weight + 1), ∑ q ∈ Finset.range (G.weight + 1), hodge p q = G.degree ∧
    ∀ u : Circle, (G.matrix (h u)).charpoly = ∏ p ∈ Finset.range (G.weight + 1),
      ∏ q ∈ Finset.range (G.weight + 1), (X - C ((u : ℂ) ^ ((p : ℤ) - q))) ^ hodge p q

/-- A **Hodge circle** (LMFDB `st_group.hodge_circle`) of a Sato–Tate group `G` of degree `d` and
weight `w`: a continuous homomorphism `h : U(1) → G` with values in the identity component `G⁰`,
with Hodge eigenvalues `h^{p,q}` for some nonnegative integers `h^{p,q}`, `0 ≤ p, q ≤ w`, adding up
to `d` (`HasHodgeEigenvalues`), and such that the subgroup generated by the conjugates
`g h(u) g⁻¹`, `g ∈ G⁰`, of its image is dense in `G⁰`. -/
def IsHodgeCircle : Prop :=
  (∀ u, h u ∈ Subgroup.connectedComponentOfOne G.toSubgroup) ∧
    (∃ hodge, G.HasHodgeEigenvalues h hodge) ∧
    (Subgroup.connectedComponentOfOne G.toSubgroup : Set G.toSubgroup) ⊆
      closure (Subgroup.closure {x | ∃ g ∈ Subgroup.connectedComponentOfOne G.toSubgroup,
        ∃ u, x = g * h u * g⁻¹})

end SatoTateGroup
