import LeanBridge.ForMathlib.NumberTheory.Hypergeometric.BezoutModule
import LeanBridge.ForMathlib.NumberTheory.Hypergeometric.LeveltPair
import LeanBridge.ForMathlib.NumberTheory.Hypergeometric.Weight
import Mathlib.Algebra.Polynomial.Reverse
import Mathlib.LinearAlgebra.Matrix.Charpoly.Coeff
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots
import Mathlib.RingTheory.RootsOfUnity.Complex
import Mathlib.Tactic.LinearCombination

/-!
# The Levelt matrices of a hypergeometric family

The monodromy of a hypergeometric family `H(A, B)` of degree `d` is generated by its local
monodromies `h_∞` and `h_0` around `∞` and `0`. The characteristic polynomial of `h_∞` is
`∏_j (T - e^{2πiα_j}) = Φ_A = ∏_{a ∈ A} Φ_a` and that of `h_0` is
`∏_j (T - e^{2πiβ_j}) = Φ_B`, where `Φ_n` is the `n`-th cyclotomic polynomial and `α`, `β` are the
lists of fractions of `A` and `B` (`Hypergeometric.CuspIndex.fractions`). The local
monodromy `h_1 = (h_0 h_∞)⁻¹` around `1` is a pseudo-reflection, that is, `h_∞` and `h_0⁻¹`
differ by a matrix of rank one. By Levelt's theorem (`Matrix.IsLeveltPair.exists_conj`), as `Φ_A`
and `Φ_B` are coprime, these conditions determine `(h_∞, h_0)` up to simultaneous conjugation, and
Levelt's choice is `h_∞ = C(Φ_A)` and `h_0 = C(Φ_B)⁻¹` for the companion matrices `C(Φ_A)` and
`C(Φ_B)`. As `Φ_A` and `Φ_B` have constant terms `±1`, these lie in `GL_d(ℤ)`.

The characteristic polynomial of `C(Φ_B)⁻¹` is the reciprocal polynomial of `Φ_B` up to a unit,
which is `Φ_B` itself: every cyclotomic polynomial `Φ_n` is self-reciprocal up to the sign of its
constant term, as its roots are closed under inversion.

The LMFDB knowl `hgm.levelt_matrices` states that the characteristic polynomials alone determine
the pair up to simultaneous conjugacy; that is false without the condition on `h_1`, which is part
of the definition of a hypergeometric group (Beukers and Heckman, Definition 3.1) and which we
include in `Hypergeometric.Parameters.IsLeveltPair`. The identification of `h_∞` and `h_0` with the
analytic local monodromies of the hypergeometric differential equation is not formalised.

## Main definitions

* `Hypergeometric.Parameters.leveltInfty` (LMFDB `hgm.levelt_matrices`): Levelt's matrix
  `h_∞ = C(Φ_A)` in `GL_d(ℤ)`.
* `Hypergeometric.Parameters.leveltZero` (LMFDB `hgm.levelt_matrices`): Levelt's matrix
  `h_0 = C(Φ_B)⁻¹` in `GL_d(ℤ)`.
* `Hypergeometric.Parameters.IsLeveltPair` (LMFDB `hgm.levelt_matrices`): a pair `(h_∞, h_0)` of
  invertible matrices over a field with characteristic polynomials `Φ_A` and `Φ_B` such that
  `h_∞ - h_0⁻¹` has rank at most one.

## Main results

* `Hypergeometric.reverse_cyclotomic_int`: `Φ_n` is self-reciprocal up to the sign of its constant
  term.
* `Hypergeometric.CuspIndex.map_cyclotomicProd_eq_prod_exp`: over `ℂ`,
  `Φ_A = ∏_j (T - e^{2πiα_j})`.
* `Hypergeometric.Parameters.charpoly_leveltInfty`,
  `Hypergeometric.Parameters.charpoly_leveltZero`: the characteristic polynomials of `h_∞` and
  `h_0` are `Φ_A` and `Φ_B`.
* `Hypergeometric.Parameters.isLeveltPair_map_leveltInfty_leveltZero`: Levelt's matrices satisfy
  the conditions over every field.
* `Hypergeometric.Parameters.IsLeveltPair.exists_conj`: over a field of characteristic zero, every
  pair satisfying the conditions is simultaneously conjugate to Levelt's matrices.
-/

open Complex Polynomial

open scoped Real

open Matrix (GeneralLinearGroup)

namespace Hypergeometric

variable {d : ℕ} (K : Type*) [Field K] {a b : ℕ}

lemma reverse_one_int : (1 : ℤ[X]).reverse = 1 := by
  simpa using reverse_C (1 : ℤ)

lemma reverse_mul_eq_C_coeff_zero_mul {p q : ℤ[X]} (hp : p.reverse = C (p.coeff 0) * p)
    (hq : q.reverse = C (q.coeff 0) * q) : (p * q).reverse = C ((p * q).coeff 0) * (p * q) := by
  rw [reverse_mul_of_domain, hp, hq, mul_coeff_zero, C_mul]
  ring1

variable (a) in
/-- **The cyclotomic polynomials are self-reciprocal up to sign**: `X^{φ(a)} Φ_a(1/X)` is `Φ_a`
times its constant term, which is `-1` for `a = 1` and `1` otherwise. -/
lemma reverse_cyclotomic_int :
    (cyclotomic a ℤ).reverse = C ((cyclotomic a ℤ).coeff 0) * cyclotomic a ℤ := by
  induction a using Nat.strong_induction_on with
  | _ a ih =>
    rcases eq_or_ne a 0 with rfl | ha
    · simp [reverse_one_int]
    have hQ : (∏ i ∈ a.properDivisors, cyclotomic i ℤ).reverse =
        C ((∏ i ∈ a.properDivisors, cyclotomic i ℤ).coeff 0) *
          ∏ i ∈ a.properDivisors, cyclotomic i ℤ :=
      Finset.prod_induction _ (fun q : ℤ[X] ↦ q.reverse = C (q.coeff 0) * q)
        (fun _ _ ↦ reverse_mul_eq_C_coeff_zero_mul) (by simp [reverse_one_int])
        fun i hi ↦ ih i (Nat.mem_properDivisors.mp hi).2
    have hprod : cyclotomic a ℤ * ∏ i ∈ a.properDivisors, cyclotomic i ℤ = X ^ a - 1 := by
      rw [← prod_cyclotomic_eq_X_pow_sub_one (Nat.pos_of_ne_zero ha) ℤ,
        ← Nat.cons_self_properDivisors ha, Finset.prod_cons]
    have hrev : (X ^ a - 1 : ℤ[X]).reverse = C ((X ^ a - 1 : ℤ[X]).coeff 0) * (X ^ a - 1) := by
      rw [sub_eq_add_neg, ← C_1, ← C_neg, reverse_add_C, ← mul_one (X ^ a), reverse_X_pow_mul,
        reverse_one_int]
      simp [ha.symm]
    have h0 : (X ^ a - 1 : ℤ[X]).coeff 0 ≠ 0 := by
      simp [ha.symm]
    rw [← hprod, reverse_mul_of_domain, hQ, mul_coeff_zero, C_mul] at hrev
    rw [← hprod, mul_coeff_zero] at h0
    have hne : C ((∏ i ∈ a.properDivisors, cyclotomic i ℤ).coeff 0) *
        ∏ i ∈ a.properDivisors, cyclotomic i ℤ ≠ 0 :=
      mul_ne_zero (C_ne_zero.mpr (right_ne_zero_of_mul h0))
        (Finset.prod_ne_zero_iff.mpr fun i _ ↦ cyclotomic_ne_zero i ℤ)
    refine mul_right_cancel₀ hne ?_
    linear_combination hrev

lemma isCoprime_cyclotomic [CharZero K] (hab : a ≠ b) :
    IsCoprime (cyclotomic a K) (cyclotomic b K) := by
  simpa using (cyclotomic.isCoprime_rat hab).map (mapRingHom (algebraMap ℚ K))

lemma charpoly_inv_eq_of_reverse_eq {R : Type*} [CommRing R] {n : Type*} [Fintype n]
    [DecidableEq n] (M : Matrix n n R) (hM : IsUnit M)
    (h : M.charpoly.reverse = C (M.charpoly.coeff 0) * M.charpoly) : M⁻¹.charpoly = M.charpoly := by
  have hu : IsUnit ((-1) ^ Fintype.card n * M.charpoly.coeff 0) := by
    rw [← Matrix.det_eq_sign_charpoly_coeff]
    exact (Matrix.isUnit_iff_isUnit_det M).mp hM
  have hC : ((-1) ^ Fintype.card n : R[X]) = C ((-1) ^ Fintype.card n) := by
    simp
  rw [Matrix.charpoly_inv M hM, ← Matrix.reverse_charpoly, h, Matrix.det_eq_sign_charpoly_coeff,
    hC, ← mul_assoc, ← C_mul, ← C_mul, mul_comm ((-1) ^ Fintype.card n), mul_assoc,
    Ring.inverse_mul_cancel _ hu, C_1, one_mul]

variable (a) in
lemma injOn_exp_fractionsWithDen :
    Set.InjOn (fun q : ℚ ↦ exp (2 * π * I * q)) (fractionsWithDen a) := by
  intro q hq q' hq' h
  rcases exp_eq_exp_iff_exists_int.mp h with ⟨m, hm⟩
  rw [Finset.mem_coe, mem_fractionsWithDen] at hq hq'
  have hqm : (q : ℂ) = q' + m := mul_left_cancel₀ two_pi_I_ne_zero <| by linear_combination hm
  have hqm' : q = q' + m := by
    exact_mod_cast hqm
  have hm0 : m = 0 := by
    have hm1 : m < 1 := by
      exact_mod_cast (by linarith : (m : ℚ) < 1)
    have hm2 : -1 < m := by
      exact_mod_cast (by linarith : (-1 : ℚ) < m)
    omega
  rw [hqm', hm0, Int.cast_zero, add_zero]

lemma cyclotomic_eq_prod_fractionsWithDen (ha : a ≠ 0) :
    cyclotomic a ℂ = ∏ q ∈ fractionsWithDen a, (X - C (exp (2 * π * I * q))) := by
  have himage :
      (fractionsWithDen a).image (fun q : ℚ ↦ exp (2 * π * I * q)) = primitiveRoots a ℂ := by
    refine Finset.eq_of_subset_of_card_le (fun μ hμ ↦ ?_) ?_
    · rcases Finset.mem_image.mp hμ with ⟨q, hq, rfl⟩
      rw [mem_primitiveRoots (Nat.pos_of_ne_zero ha)]
      exact (mem_fractionsWithDen.mp hq).2.2 ▸ isPrimitiveRoot_exp_rat q
    · rw [card_primitiveRoots, Finset.card_image_of_injOn (injOn_exp_fractionsWithDen a),
        card_fractionsWithDen]
  rw [cyclotomic_eq_prod_X_sub_primitiveRoots (isPrimitiveRoot_exp a ha), ← himage,
    Finset.prod_image (injOn_exp_fractionsWithDen a)]

namespace CuspIndex

variable (c : CuspIndex d)

lemma reverse_cyclotomicProd :
    c.cyclotomicProd.reverse = C (c.cyclotomicProd.coeff 0) * c.cyclotomicProd :=
  Multiset.prod_induction (fun q : ℤ[X] ↦ q.reverse = C (q.coeff 0) * q) _
    (fun _ _ ↦ reverse_mul_eq_C_coeff_zero_mul) (by simp [reverse_one_int]) fun q hq ↦ by
      rcases Multiset.mem_map.mp hq with ⟨a, -, rfl⟩
      exact reverse_cyclotomic_int a

lemma isUnit_coeff_zero_cyclotomicProd : IsUnit (c.cyclotomicProd.coeff 0) := by
  have h : c.cyclotomicProd.reverse.coeff 0 =
      (C (c.cyclotomicProd.coeff 0) * c.cyclotomicProd).coeff 0 :=
    congrArg (coeff · 0) c.reverse_cyclotomicProd
  rw [coeff_zero_reverse, c.monic_cyclotomicProd.leadingCoeff, coeff_C_mul] at h
  exact .of_mul_eq_one _ h.symm

lemma isUnit_det_companionMatrix : IsUnit (c.cyclotomicProd.companionMatrix d).det := by
  rw [Matrix.det_eq_sign_charpoly_coeff,
    c.cyclotomicProd.charpoly_companionMatrix d c.monic_cyclotomicProd c.natDegree_cyclotomicProd]
  exact (isUnit_neg_one.pow _).mul c.isUnit_coeff_zero_cyclotomicProd

lemma map_cyclotomicProd : c.cyclotomicProd.map (Int.castRingHom K) =
    ((c.toList : Multiset ℕ).map fun a ↦ cyclotomic a K).prod := by
  rw [cyclotomicProd, Polynomial.map_multiset_prod, Multiset.map_map]
  simp

/-- **`Φ_C` is the polynomial `∏_j (T - e^{2πiα_j})` of the LMFDB**: over `ℂ`, the product `Φ_C` of
the cyclotomic polynomials of the entries of a cusp-index `C` is `∏_j (T - e^{2πiα_j})`, where `α`
is the list of fractions of `C` (`Hypergeometric.CuspIndex.fractions`). -/
lemma map_cyclotomicProd_eq_prod_exp : c.cyclotomicProd.map (Int.castRingHom ℂ) =
    (c.fractions.map fun α : ℚ ↦ X - C (exp (2 * π * I * α))).prod := by
  rw [c.map_cyclotomicProd ℂ, fractions, ← Multiset.prod_coe, ← Multiset.map_coe, Multiset.sort_eq,
    Multiset.map_bind, Multiset.prod_bind]
  exact congrArg Multiset.prod <| Multiset.map_congr rfl fun a ha ↦
    cyclotomic_eq_prod_fractionsWithDen (c.pos a <| Multiset.mem_coe.mp ha).ne'

lemma reverse_map_cyclotomicProd : (c.cyclotomicProd.map (Int.castRingHom K)).reverse =
    C ((c.cyclotomicProd.map (Int.castRingHom K)).coeff 0) *
      c.cyclotomicProd.map (Int.castRingHom K) := by
  rw [reverse, c.monic_cyclotomicProd.natDegree_map, reflect_map, ← reverse,
    c.reverse_cyclotomicProd, Polynomial.map_mul, map_C, coeff_map]

end CuspIndex

namespace Parameters

variable (P : Parameters d) {gInf gZero : GL (Fin d) K}

/-- **Levelt's matrix `h_∞`** (LMFDB `hgm.levelt_matrices`) of a hypergeometric family `H(A, B)` of
degree `d`: the companion matrix `C(Φ_A)` of `Φ_A = ∏_{a ∈ A} Φ_a`, the local monodromy around
`∞` in Levelt's presentation, an element of `GL_d(ℤ)` with characteristic polynomial `Φ_A`
(`Hypergeometric.Parameters.charpoly_leveltInfty`). Over `ℂ`, `Φ_A = ∏_j (T - e^{2πiα_j})`
(`Hypergeometric.CuspIndex.map_cyclotomicProd_eq_prod_exp`). -/
noncomputable def leveltInfty : GL (Fin d) ℤ :=
  .mk'' (P.A.cyclotomicProd.companionMatrix d) P.A.isUnit_det_companionMatrix

/-- **Levelt's matrix `h_0`** (LMFDB `hgm.levelt_matrices`) of a hypergeometric family `H(A, B)` of
degree `d`: the inverse `C(Φ_B)⁻¹` of the companion matrix of `Φ_B = ∏_{b ∈ B} Φ_b`, the local
monodromy around `0` in Levelt's presentation, an element of `GL_d(ℤ)` with characteristic
polynomial `Φ_B` (`Hypergeometric.Parameters.charpoly_leveltZero`). Over `ℂ`,
`Φ_B = ∏_j (T - e^{2πiβ_j})` (`Hypergeometric.CuspIndex.map_cyclotomicProd_eq_prod_exp`). The
local monodromy `h_1 = (h_0 h_∞)⁻¹ = C(Φ_A)⁻¹ C(Φ_B)` around `1` is a pseudo-reflection, as the
companion matrices differ only in their last columns. -/
noncomputable def leveltZero : GL (Fin d) ℤ :=
  (GeneralLinearGroup.mk'' (P.B.cyclotomicProd.companionMatrix d) P.B.isUnit_det_companionMatrix)⁻¹

lemma coe_leveltInfty :
    (P.leveltInfty : Matrix (Fin d) (Fin d) ℤ) = P.A.cyclotomicProd.companionMatrix d :=
  rfl

lemma coe_leveltZero_inv : ((P.leveltZero⁻¹ : GL (Fin d) ℤ) : Matrix (Fin d) (Fin d) ℤ) =
    P.B.cyclotomicProd.companionMatrix d := by
  rw [leveltZero, inv_inv]
  rfl

/-- **The characteristic polynomial of `h_∞` is `Φ_A`.** -/
lemma charpoly_leveltInfty :
    (P.leveltInfty : Matrix (Fin d) (Fin d) ℤ).charpoly = P.A.cyclotomicProd :=
  P.A.cyclotomicProd.charpoly_companionMatrix d P.A.monic_cyclotomicProd
    P.A.natDegree_cyclotomicProd

/-- **The characteristic polynomial of `h_0 = C(Φ_B)⁻¹` is `Φ_B`**, as `Φ_B` is self-reciprocal
up to sign. -/
lemma charpoly_leveltZero :
    (P.leveltZero : Matrix (Fin d) (Fin d) ℤ).charpoly = P.B.cyclotomicProd := by
  have h : (P.B.cyclotomicProd.companionMatrix d).charpoly = P.B.cyclotomicProd :=
    P.B.cyclotomicProd.charpoly_companionMatrix d P.B.monic_cyclotomicProd
      P.B.natDegree_cyclotomicProd
  rw [leveltZero, Matrix.coe_units_inv, GeneralLinearGroup.val_mk'',
    charpoly_inv_eq_of_reverse_eq _ ((Matrix.isUnit_iff_isUnit_det _).mpr
      P.B.isUnit_det_companionMatrix) (h.symm ▸ P.B.reverse_cyclotomicProd), h]

variable (gInf gZero) in
/-- A pair `(h_∞, h_0)` of invertible `d × d` matrices over a field `K` is a **pair of Levelt
matrices** (LMFDB `hgm.levelt_matrices`) of the hypergeometric family `H(A, B)` if the
characteristic polynomial of `h_∞` is `Φ_A`, that of `h_0` is `Φ_B`, and `h_∞ - h_0⁻¹` has rank
at most one, that is, the local monodromy `h_1 = (h_0 h_∞)⁻¹` around `1` is a pseudo-reflection
(or the identity, which is impossible for `d ≥ 1` in characteristic zero). Over `ℂ`, `Φ_A` and
`Φ_B` are the knowl's `∏_j (T - e^{2πiα_j})` and `∏_j (T - e^{2πiβ_j})`
(`Hypergeometric.CuspIndex.map_cyclotomicProd_eq_prod_exp`). The knowl omits the rank condition,
without which the pair is not determined up to simultaneous conjugacy. Levelt's matrices
`(Hypergeometric.Parameters.leveltInfty, Hypergeometric.Parameters.leveltZero)` are such a pair
over every field (`Hypergeometric.Parameters.isLeveltPair_map_leveltInfty_leveltZero`), and over a
field of characteristic zero every such pair is simultaneously conjugate to them
(`Hypergeometric.Parameters.IsLeveltPair.exists_conj`). -/
structure IsLeveltPair : Prop where
  /-- The characteristic polynomial of `h_∞` is `Φ_A`. -/
  charpoly_infty :
    (gInf : Matrix (Fin d) (Fin d) K).charpoly = P.A.cyclotomicProd.map (Int.castRingHom K)
  /-- The characteristic polynomial of `h_0` is `Φ_B`. -/
  charpoly_zero :
    (gZero : Matrix (Fin d) (Fin d) K).charpoly = P.B.cyclotomicProd.map (Int.castRingHom K)
  /-- The matrices `h_∞` and `h_0⁻¹` differ by a matrix of rank at most one. -/
  rank_sub_inv_le_one : ((gInf : Matrix (Fin d) (Fin d) K) - (gZero⁻¹ : GL (Fin d) K)).rank ≤ 1

variable {P K} in
lemma IsLeveltPair.isLeveltPair_inv (h : P.IsLeveltPair K gInf gZero) :
    Matrix.IsLeveltPair (P.A.cyclotomicProd.map (Int.castRingHom K))
      (P.B.cyclotomicProd.map (Int.castRingHom K)) (gInf : Matrix (Fin d) (Fin d) K)
      ((gZero⁻¹ : GL (Fin d) K) : Matrix (Fin d) (Fin d) K) where
  charpoly_left := h.charpoly_infty
  charpoly_right := by
    rw [Matrix.coe_units_inv, charpoly_inv_eq_of_reverse_eq _ gZero.isUnit
      (h.charpoly_zero ▸ P.B.reverse_map_cyclotomicProd K), h.charpoly_zero]
  rank_sub_le_one := h.rank_sub_inv_le_one

/-- **Levelt's matrices form a pair of Levelt matrices** over every field: their characteristic
polynomials are `Φ_A` and `Φ_B`, and `h_∞ - h_0⁻¹ = C(Φ_A) - C(Φ_B)` has rank at most one. -/
lemma isLeveltPair_map_leveltInfty_leveltZero : P.IsLeveltPair K
    (GeneralLinearGroup.map (Int.castRingHom K) P.leveltInfty)
    (GeneralLinearGroup.map (Int.castRingHom K) P.leveltZero) where
  charpoly_infty := by
    rw [← P.charpoly_leveltInfty, ← Matrix.charpoly_map]
    rfl
  charpoly_zero := by
    rw [← P.charpoly_leveltZero, ← Matrix.charpoly_map]
    rfl
  rank_sub_inv_le_one := by
    have h : ((GeneralLinearGroup.map (Int.castRingHom K) P.leveltZero)⁻¹ : GL (Fin d) K) =
        GeneralLinearGroup.map (Int.castRingHom K) P.leveltZero⁻¹ :=
      (map_inv _ _).symm
    have h' : ((GeneralLinearGroup.map (Int.castRingHom K) P.leveltZero⁻¹ : GL (Fin d) K) :
        Matrix (Fin d) (Fin d) K) = (P.leveltZero⁻¹ : GL (Fin d) ℤ).val.map (Int.castRingHom K) :=
      rfl
    have h'' : ((GeneralLinearGroup.map (Int.castRingHom K) P.leveltInfty : GL (Fin d) K) :
        Matrix (Fin d) (Fin d) K) =
          (P.leveltInfty : Matrix (Fin d) (Fin d) ℤ).map (Int.castRingHom K) :=
      rfl
    rw [h, h', h'', P.coe_leveltZero_inv, P.coe_leveltInfty, Polynomial.companionMatrix_map,
      Polynomial.companionMatrix_map]
    exact (P.A.cyclotomicProd.map _).rank_companionMatrix_sub_le_one _ d

variable {P K} in
/-- **The Levelt matrices are unique up to simultaneous conjugation** (Levelt's theorem): over a
field of characteristic zero, every pair `(h_∞, h_0)` of Levelt matrices of a hypergeometric family
is simultaneously conjugate to Levelt's matrices `(C(Φ_A), C(Φ_B)⁻¹)`. -/
lemma IsLeveltPair.exists_conj [CharZero K] (h : P.IsLeveltPair K gInf gZero) :
    ∃ Q : GL (Fin d) K, Q⁻¹ * gInf * Q = GeneralLinearGroup.map (Int.castRingHom K) P.leveltInfty ∧
      Q⁻¹ * gZero * Q = GeneralLinearGroup.map (Int.castRingHom K) P.leveltZero := by
  have hcop : IsCoprime (P.A.cyclotomicProd.map (Int.castRingHom K))
      (P.B.cyclotomicProd.map (Int.castRingHom K)) := by
    rw [P.A.map_cyclotomicProd K, P.B.map_cyclotomicProd K]
    refine Multiset.prod_induction (fun x ↦ IsCoprime x _) _ (fun _ _ ↦ IsCoprime.mul_left)
      isCoprime_one_left fun x hx ↦ ?_
    rcases Multiset.mem_map.mp hx with ⟨a, ha, rfl⟩
    refine Multiset.prod_induction (IsCoprime _) _ (fun _ _ ↦ IsCoprime.mul_right)
      isCoprime_one_right fun y hy ↦ ?_
    rcases Multiset.mem_map.mp hy with ⟨b, hb, rfl⟩
    exact isCoprime_cyclotomic K fun hab ↦ P.disjoint (Multiset.mem_coe.mp ha)
      (hab ▸ Multiset.mem_coe.mp hb)
  rcases h.isLeveltPair_inv.exists_conj
    (P.isLeveltPair_map_leveltInfty_leveltZero K).isLeveltPair_inv hcop with ⟨Q, h₁, h₂⟩
  refine ⟨Q, Units.ext ?_, inv_injective <| Units.ext ?_⟩
  · rw [Units.val_mul, Units.val_mul]
    exact h₁
  · have h₃ : (Q⁻¹ * gZero * Q)⁻¹ = Q⁻¹ * gZero⁻¹ * Q := by
      group
    rw [h₃, Units.val_mul, Units.val_mul]
    exact h₂

end Parameters

end Hypergeometric
