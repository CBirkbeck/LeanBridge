import LeanBridge.ForMathlib.NumberTheory.Hypergeometric.LeveltMatrices

/-!
# The monodromy group of a hypergeometric family

The monodromy representation of a hypergeometric family `H(A, B)` of degree `d` is generated by
the local monodromies `h_∞` and `h_0` around `∞` and `0`. In Levelt's presentation these are
`h_∞ = C(Φ_A)` and `h_0 = C(Φ_B)⁻¹` in `GL_d(ℤ)`, and the monodromy group is the subgroup of
`GL_d(ℤ)` that they generate, which is also generated by the companion matrices `C(Φ_A)` and
`C(Φ_B)`. By Levelt's theorem, any other pair of Levelt matrices over a field of characteristic
zero generates a conjugate group, so the monodromy group is well defined up to conjugacy.

The identification with the monodromy of the hypergeometric differential equation and the
computation of these groups for families of weight `0` by Beukers and Heckman are not formalised.

## Main definitions

* `Hypergeometric.Parameters.monodromyGroup` (LMFDB `hgm.monodromy`): the monodromy group.

## Main results

* `Hypergeometric.Parameters.monodromyGroup_eq_closure_companionMatrix`: the monodromy group is
  generated by `C(Φ_A)` and `C(Φ_B)`.
* `Hypergeometric.Parameters.IsLeveltPair.exists_map_closure_eq`: over a field of characteristic
  zero, the group generated by a pair of Levelt matrices is conjugate to the monodromy group.
-/

open Matrix (GeneralLinearGroup)

namespace Hypergeometric.Parameters

variable {d : ℕ} (P : Parameters d)

/-- The **monodromy group** (LMFDB `hgm.monodromy`) of a hypergeometric family `H(A, B)` of degree
`d`: the subgroup of `GL_d(ℤ)` generated by Levelt's matrices `h_∞ = C(Φ_A)` and `h_0 = C(Φ_B)⁻¹`
(`Hypergeometric.Parameters.leveltInfty`, `Hypergeometric.Parameters.leveltZero`), the local
monodromies around `∞` and `0`. Up to conjugacy it does not depend on the choice of the Levelt
matrices (`Hypergeometric.Parameters.IsLeveltPair.exists_map_closure_eq`). -/
noncomputable def monodromyGroup : Subgroup (GL (Fin d) ℤ) :=
  .closure {P.leveltInfty, P.leveltZero}

/-- **The monodromy group is generated by the companion matrices** `C(Φ_A) = h_∞` and
`C(Φ_B) = h_0⁻¹`. -/
lemma monodromyGroup_eq_closure_companionMatrix :
    P.monodromyGroup = .closure {P.leveltInfty, P.leveltZero⁻¹} := by
  rw [monodromyGroup, Set.insert_eq, Set.insert_eq, Subgroup.closure_union, Subgroup.closure_union,
    ← Set.inv_singleton, Subgroup.closure_inv]

/-- **The monodromy group is well defined up to conjugacy**: over a field `K` of characteristic
zero, the subgroup of `GL_d(K)` generated by a pair `(h_∞, h_0)` of Levelt matrices is conjugate to
the image of the monodromy group. -/
lemma IsLeveltPair.exists_map_closure_eq {K : Type*} [Field K] [CharZero K]
    {gInf gZero : GL (Fin d) K} (h : P.IsLeveltPair K gInf gZero) : ∃ Q : GL (Fin d) K,
      (Subgroup.closure {gInf, gZero}).map (MulAut.conj Q⁻¹).toMonoidHom =
        P.monodromyGroup.map (GeneralLinearGroup.map (Int.castRingHom K)) := by
  rcases h.exists_conj with ⟨Q, h₁, h₂⟩
  refine ⟨Q, ?_⟩
  rw [MonoidHom.map_closure, monodromyGroup, MonoidHom.map_closure, Set.image_pair, Set.image_pair]
  simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv, h₁, h₂]

end Hypergeometric.Parameters
