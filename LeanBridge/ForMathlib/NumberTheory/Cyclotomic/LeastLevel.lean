import LeanBridge.ForMathlib.NumberTheory.MulChar.GaloisAction
import Mathlib.NumberTheory.NumberField.Cyclotomic.Basic

/-!
# The least level of a cyclotomic field

Let `ℚ(ζ_n)` be the subfield of `ℂ` generated by the `n`-th roots of unity, the cyclotomic field
of level `n`. Two levels can give the same field: for `n ≡ 2 mod 4` the level `n / 2` is odd, so
every `n`-th root of unity is an `n / 2`-th root of unity or the negative of one, and
`ℚ(ζ_n) = ℚ(ζ_{n / 2})`. There is no other coincidence. The roots of unity of the `m`-th
cyclotomic field are those of order dividing `m` if `m` is even, and `2m` if `m` is odd (Mathlib's
`IsCyclotomicExtension.Rat.torsionOrder_eq`), so for `n ≢ 2 mod 4` the field `ℚ(ζ_m)` contains
`ℚ(ζ_n)` exactly when `n ∣ m`. Hence, for `n ≠ 0`, the least positive `m` such that `ℚ(ζ_m)`
contains `ℚ(ζ_n)` is `n / 2` if `n ≡ 2 mod 4` and `n` otherwise, and for this `m` the two fields
are equal: `m` is the conductor of the abelian field `ℚ(ζ_n)`.

## Main results

* `IntermediateField.adjoin_nth_roots_div_two`: `F(μ_{n / 2}) = F(μ_n)` for `n ≡ 2 mod 4`.
* `IsPrimitiveRoot.dvd_of_isCyclotomicExtension_of_mod_four_ne_two`: if an `m`-th cyclotomic
  extension of `ℚ` contains a primitive `n`-th root of unity, where `n ≢ 2 mod 4`, then `n ∣ m`.
* `Complex.adjoin_nth_roots_le_adjoin_nth_roots_iff`: for `n ≢ 2 mod 4`, `ℚ(ζ_n) ⊆ ℚ(ζ_m)`
  exactly when `n ∣ m`.
* `Complex.isLeast_adjoin_nth_roots_le`: the least positive `m` such that `ℚ(ζ_n) ⊆ ℚ(ζ_m)` is
  `n / 2` if `n ≡ 2 mod 4`, and `n` otherwise.

## References

* L. C. Washington, *Introduction to Cyclotomic Fields*, Chapter 2.
-/

open IntermediateField IsCyclotomicExtension NumberField

variable {m n : ℕ}

namespace IntermediateField

variable {F K : Type*} [Field F] [Field K] [Algebra F K]

lemma adjoin_nth_roots_le_of_dvd (h : n ∣ m) :
    adjoin F {b : K | b ^ n = 1} ≤ adjoin F {b : K | b ^ m = 1} :=
  adjoin.mono F _ _ fun _ hb ↦ orderOf_dvd_iff_pow_eq_one.mp <|
    (orderOf_dvd_of_pow_eq_one hb).trans h

/-- **`F(μ_{n / 2}) = F(μ_n)` for `n ≡ 2 mod 4`**: as `n / 2` is odd, every `n`-th root of unity is
an `n / 2`-th root of unity or the negative of one. -/
lemma adjoin_nth_roots_div_two (hn : n % 4 = 2) :
    adjoin F {b : K | b ^ (n / 2) = 1} = adjoin F {b : K | b ^ n = 1} := by
  refine le_antisymm (adjoin_nth_roots_le_of_dvd <| Nat.div_dvd_of_dvd <| by omega)
    (adjoin_le_iff.mpr fun b (hb : b ^ n = 1) ↦ ?_)
  have hb' : (b ^ (n / 2)) ^ 2 = 1 := by
    rwa [← pow_mul, Nat.div_mul_cancel (by omega)]
  rcases sq_eq_one_iff.mp hb' with h | h
  · exact subset_adjoin F _ h
  · have h' : (-b) ^ (n / 2) = 1 := by
      rw [(Nat.odd_iff.mpr (by omega)).neg_pow, h, neg_neg]
    exact neg_neg b ▸ neg_mem (subset_adjoin F _ h')

end IntermediateField

namespace IsPrimitiveRoot

variable {K : Type*} [Field K] [NumberField K] [NeZero m] [NeZero n] [IsCyclotomicExtension {m} ℚ K]
  {ζ : K}

/-- **The levels of a cyclotomic field.** If an `m`-th cyclotomic extension of `ℚ` contains a
primitive `n`-th root of unity, where `n ≢ 2 mod 4`, then `n ∣ m`: its roots of unity are those of
order dividing `m` if `m` is even, and `2m` if `m` is odd. -/
lemma dvd_of_isCyclotomicExtension_of_mod_four_ne_two (hζ : IsPrimitiveRoot ζ n) (hn : n % 4 ≠ 2) :
    n ∣ m := by
  have h : n ∣ Units.torsionOrder K := Units.dvd_torsionOrder_of_isPrimitiveRoot hζ
  rw [Rat.torsionOrder_eq (n := m)] at h
  split_ifs at h with hm
  · exact h
  rcases Nat.even_or_odd n with hn' | hn'
  · have h4 : 4 ∣ 2 * m := (Nat.dvd_of_mod_eq_zero (by grind)).trans h
    exact absurd (Nat.even_iff.mpr (by omega)) hm
  · exact (Nat.coprime_two_right.mpr hn').dvd_of_dvd_mul_left h

end IsPrimitiveRoot

namespace Complex

variable [NeZero n] [NeZero m] in
/-- **For `n ≢ 2 mod 4`, `ℚ(ζ_n) ⊆ ℚ(ζ_m)` exactly when `n ∣ m`.** -/
lemma adjoin_nth_roots_le_adjoin_nth_roots_iff (hn : n % 4 ≠ 2) :
    adjoin ℚ {b : ℂ | b ^ n = 1} ≤ adjoin ℚ {b : ℂ | b ^ m = 1} ↔ n ∣ m :=
  ⟨fun h ↦ ((zeta_spec n ℚ _).map_of_injective <| inclusion_injective h)
    |>.dvd_of_isCyclotomicExtension_of_mod_four_ne_two hn, adjoin_nth_roots_le_of_dvd⟩

variable [NeZero m] in
lemma isLeast_of_adjoin_nth_roots_eq (hm : m % 4 ≠ 2)
    (h : adjoin ℚ {b : ℂ | b ^ m = 1} = adjoin ℚ {b : ℂ | b ^ n = 1}) :
    IsLeast {k | 0 < k ∧ adjoin ℚ {b : ℂ | b ^ n = 1} ≤ adjoin ℚ {b : ℂ | b ^ k = 1}} m :=
  ⟨⟨NeZero.pos m, h.ge⟩, fun k ⟨hk, hle⟩ ↦
    have : NeZero k := ⟨hk.ne'⟩
    Nat.le_of_dvd hk <| (adjoin_nth_roots_le_adjoin_nth_roots_iff hm).mp <| h.trans_le hle⟩

variable [NeZero n] in
/-- **The least level of the cyclotomic field `ℚ(ζ_n)`**: the least positive `m` such that
`ℚ(ζ_n) ⊆ ℚ(ζ_m)` is `n / 2` if `n ≡ 2 mod 4`, and `n` otherwise. -/
lemma isLeast_adjoin_nth_roots_le : IsLeast {m | 0 < m ∧ adjoin ℚ {b : ℂ | b ^ n = 1} ≤
    adjoin ℚ {b : ℂ | b ^ m = 1}} (if n % 4 = 2 then n / 2 else n) := by
  split_ifs with hn
  · have : NeZero (n / 2) := ⟨by omega⟩
    exact isLeast_of_adjoin_nth_roots_eq (by omega) (adjoin_nth_roots_div_two hn)
  · exact isLeast_of_adjoin_nth_roots_eq hn rfl

end Complex
