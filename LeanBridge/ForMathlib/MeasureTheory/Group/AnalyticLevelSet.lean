import LeanBridge.ForMathlib.Topology.Algebra.Group.ConnectedComponents
import Mathlib.Analysis.Analytic.IsolatedZeros
import Mathlib.MeasureTheory.Group.Measure
import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.MeasureTheory.Measure.Prod
import TauCeti.Topology.Algebra.Group.Connected

/-!
# Level sets of functions analytic along one-parameter subgroups

Let `K` be a second-countable topological group with a finite left-invariant Borel measure `μ`, and
let `Γ i : ℝ → K` be a family of continuous curves through `1` with `Γ i (-s) = (Γ i s)⁻¹`, such as
one-parameter subgroups. If `F : K → ℂ` is continuous and every `s ↦ F (w * Γ i s * g)` is
real-analytic, then for every value `z`, almost every point of the level set `F = z` has its whole
coset `H g` in the level set, for the subgroup `H` generated by the curves
(`MeasureTheory.measure_setOf_eq_sdiff_setOf_forall_mem_closure_eq_zero`).

A real-analytic function on `ℝ` that does not vanish identically has finitely many zeros in
`[0, 1]` (`AnalyticOnNhd.forall_eq_zero_or_volume_eq_zero`). So, by Fubini's theorem and the
invariance of `μ`, replacing a closed set `A` by the set of `g` with `γ s * g ∈ A` for all `s`
does not decrease its measure when every line `s ↦ γ s * g` meets `A` either everywhere or in a
null set. Iterating over the words in the curves gives the result for the products of their
ranges, and these exhaust `H`; as `K` is second countable, countably many of them suffice.

When `H` contains the identity component `K⁰`, as the one-parameter subgroups of a compact Lie
group do, `F` is therefore, on each connected component of `K`, either identically `z` or equal
to `z` on a null set (`MeasureTheory.forall_eq_or_measure_inter_connectedComponent_eq_zero`). If
moreover `K` has finitely many connected components and `μ` is a probability measure, the
probability that `F = z` is the proportion of the connected components on which `F` is
identically `z` (`MeasureTheory.measureReal_setOf_eq_eq_card_div_card`). This is Serre's
Proposition 8.4.3.3 for the compact Lie groups whose one-parameter subgroups carry analytic
functions, such as the polynomial functions of the entries of a compact matrix group.

## Main results

* `AnalyticOnNhd.forall_eq_zero_or_volume_eq_zero`: a real-analytic function on `ℝ` vanishes
  identically or on a Lebesgue-null subset of `[0, 1]`.
* `MeasureTheory.measure_setOf_eq_sdiff_setOf_forall_mem_closure_eq_zero`: almost every point of a
  level set of a function analytic along one-parameter subgroups has its coset under the subgroup
  they generate in the level set.
* `MeasureTheory.forall_eq_or_measure_inter_connectedComponent_eq_zero`: such a function is
  identically `z` on a connected component, or equal to `z` on a null part of it.
* `MeasureTheory.measureReal_setOf_eq_eq_card_div_card`: the probability that it equals `z` is the
  proportion of the connected components on which it is identically `z`.

## References

* J.-P. Serre, *Lectures on `N_X(p)`*, CRC Press (2012), Proposition 8.4.3.3.
-/

open Set

open scoped Pointwise

open Subgroup (connectedComponentOfOne)

/-- **A real-analytic function on `ℝ` vanishes identically, or on a Lebesgue-null subset of
`[0, 1]`**: otherwise its zeros are isolated, so finitely many in the compact `[0, 1]`. -/
lemma AnalyticOnNhd.forall_eq_zero_or_volume_eq_zero {f : ℝ → ℂ} (hf : AnalyticOnNhd ℝ f univ) :
    (∀ s, f s = 0) ∨ MeasureTheory.volume ({s | f s = 0} ∩ Icc 0 1) = 0 := by
  rcases hf.eqOn_zero_or_eventually_ne_zero_of_preconnected isPreconnected_univ with h | h
  · exact Or.inl fun s ↦ h (mem_univ s)
  · have hfin : (Icc (0 : ℝ) 1 \ {s | f s ≠ 0}).Finite :=
      isCompact_Icc.finite_sdiff_of_mem_codiscreteWithin
        (Filter.codiscreteWithin_mono (subset_univ _) h)
    refine Or.inr <| MeasureTheory.measure_mono_null ?_ (hfin.measure_zero _)
    exact fun s hs ↦ ⟨hs.2, fun h' ↦ h' hs.1⟩

namespace MeasureTheory

variable {K : Type*} [Group K] [TopologicalSpace K] [IsTopologicalGroup K] [MeasurableSpace K]
  {μ : Measure K} {F : K → ℂ} {z : ℂ}

/-- **On each connected component, `F` is identically `z` or equal to `z` on a null set**, as soon
as almost every `g` with `F g = z` has `F (h * g) = z` for all `h` in the identity component:
the set of these `g` is a union of connected components, the cosets of the identity component. -/
lemma forall_eq_or_measure_inter_connectedComponent_eq_zero
    (hF : μ ({g | F g = z} \ {g | ∀ h ∈ connectedComponentOfOne K, F (h * g) = z}) = 0) (g₀ : K) :
    (∀ g ∈ connectedComponent g₀, F g = z) ∨ μ ({g | F g = z} ∩ connectedComponent g₀) = 0 := by
  by_cases h : ∃ g₁ ∈ connectedComponent g₀, ∀ h ∈ connectedComponentOfOne K, F (h * g₁) = z
  · rcases h with ⟨g₁, hg₁, h⟩
    refine Or.inl fun g hg ↦ ?_
    have hmem : g₁⁻¹ * g ∈ connectedComponentOfOne K :=
      (connectedComponent_eq_connectedComponent_iff g₁ g).mp
        ((connectedComponent_eq hg₁).symm.trans (connectedComponent_eq hg))
    have hconj : g₁ * (g₁⁻¹ * g) * g₁⁻¹ ∈ connectedComponentOfOne K :=
      Subgroup.normal_connectedComponentOfOne.conj_mem _ hmem g₁
    simpa using h _ hconj
  · refine Or.inr <| measure_mono_null ?_ hF
    exact fun g hg ↦ ⟨hg.1, fun hT ↦ h ⟨g, hg.2, hT⟩⟩

variable [BorelSpace K] [μ.IsMulLeftInvariant]

variable [IsProbabilityMeasure μ] [Finite (ConnectedComponents K)] in
/-- **The probability that `F = z` is the proportion of the connected components on which `F` is
identically `z`**, for a left-invariant probability measure on a group with finitely many
connected components, as soon as almost every `g` with `F g = z` has `F (h * g) = z` for all `h`
in the identity component: each connected component is a coset of the identity component, of
measure one over their number, and meets the level set in a null set unless it lies in it. -/
lemma measureReal_setOf_eq_eq_card_div_card
    (hF : μ ({g | F g = z} \ {g | ∀ h ∈ connectedComponentOfOne K, F (h * g) = z}) = 0) :
    μ.real {g | F g = z} = Nat.card {c : ConnectedComponents K //
      ∀ g, ConnectedComponents.mk g = c → F g = z} / Nat.card (ConnectedComponents K) := by
  classical
  let _ : Fintype (ConnectedComponents K) := Fintype.ofFinite _
  let n : ℕ := Nat.card (ConnectedComponents K)
  have hindex : (connectedComponentOfOne K).index = n :=
    Nat.card_congr (connectedComponentsEquivQuotient K).symm
  have _ : (connectedComponentOfOne K).FiniteIndex :=
    ⟨hindex.trans_ne Nat.card_pos.ne'⟩
  have hK₀ : μ (connectedComponentOfOne K) = (n : ENNReal)⁻¹ := by
    refine ENNReal.eq_inv_of_mul_eq_one_left ?_
    rw [mul_comm, ← hindex, Subgroup.index_mul_measure _ isClosed_connectedComponent.measurableSet,
      measure_univ]
  have hmeas (c : ConnectedComponents K) : MeasurableSet (ConnectedComponents.mk ⁻¹' {c}) := by
    rcases ConnectedComponents.surjective_coe c with ⟨g, rfl⟩
    rw [connectedComponents_preimage_singleton]
    exact isClosed_connectedComponent.measurableSet
  have hterm (c : ConnectedComponents K) : μ (ConnectedComponents.mk ⁻¹' {c} ∩ {g | F g = z}) =
      if ∀ g, ConnectedComponents.mk g = c → F g = z then (n : ENNReal)⁻¹ else 0 := by
    rcases ConnectedComponents.surjective_coe c with ⟨g₀, rfl⟩
    rw [connectedComponents_preimage_singleton]
    split_ifs with hc
    · have hsub : connectedComponent g₀ ⊆ {g | F g = z} := fun g hg ↦
        hc g (ConnectedComponents.coe_eq_coe.mpr (connectedComponent_eq hg).symm)
      rw [inter_eq_left.mpr hsub, connectedComponent_eq_smul, measure_smul, hK₀]
    · rcases forall_eq_or_measure_inter_connectedComponent_eq_zero hF g₀ with h | h
      · exact (hc fun g hg ↦
          h g (ConnectedComponents.coe_eq_coe.mp hg ▸ mem_connectedComponent)).elim
      · rwa [inter_comm]
  have hsum : μ {g | F g = z} = ∑ c, μ.restrict {g | F g = z} (ConnectedComponents.mk ⁻¹' {c}) := by
    rw [sum_measure_preimage_singleton _ fun c _ ↦ hmeas c, Finset.coe_univ, preimage_univ,
      Measure.restrict_apply_univ]
  simp only [Measure.restrict_apply (hmeas _), hterm] at hsum
  rw [measureReal_def, hsum, Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const,
    nsmul_eq_mul, ENNReal.toReal_mul, ENNReal.toReal_inv, ENNReal.toReal_natCast,
    ENNReal.toReal_natCast, div_eq_mul_inv, Nat.card_eq_fintype_card (α := Subtype _),
    Fintype.card_subtype]

variable [SecondCountableTopology K] [IsFiniteMeasure μ] {γ : ℝ → K}

lemma measure_le_measure_setOf_forall_mul_mem {A : Set K} (hA : IsClosed A) (hγ : Continuous γ)
    (h : ∀ g, (∀ s, γ s * g ∈ A) ∨ volume ({s | γ s * g ∈ A} ∩ Icc 0 1) = 0) :
    μ A ≤ μ {g | ∀ s, γ s * g ∈ A} := by
  let ν : Measure ℝ := volume.restrict (Icc 0 1)
  have hν : ν univ = 1 := by
    simp [ν]
  have hE : MeasurableSet {p : ℝ × K | γ p.1 * p.2 ∈ A} :=
    (hA.preimage ((hγ.comp continuous_fst).mul continuous_snd)).measurableSet
  have hA' : MeasurableSet {g | ∀ s, γ s * g ∈ A} := by
    simp only [ofPred_forall]
    exact (isClosed_iInter fun s ↦ hA.preimage (continuous_const.mul continuous_id)).measurableSet
  have h₁ : ν.prod μ {p : ℝ × K | γ p.1 * p.2 ∈ A} = μ A := by
    rw [Measure.prod_apply hE]
    simp only [preimage_ofPred_eq]
    have hμ (s : ℝ) : μ {g | γ s * g ∈ A} = μ A :=
      measure_preimage_mul μ (γ s) A
    simp_rw [hμ]
    rw [lintegral_const, hν, mul_one]
  have h₂ :
      ν.prod μ {p : ℝ × K | γ p.1 * p.2 ∈ A} ≤ ∫⁻ g, {g | ∀ s, γ s * g ∈ A}.indicator 1 g ∂μ := by
    rw [Measure.prod_apply_symm hE]
    refine lintegral_mono fun g ↦ ?_
    rcases h g with hg | hg
    · rw [indicator_of_mem (by exact hg), Pi.one_apply]
      exact (measure_mono (subset_univ _)).trans hν.le
    · have hmeas : MeasurableSet {s | γ s * g ∈ A} :=
        (hA.preimage (hγ.mul continuous_const)).measurableSet
      rw [preimage_ofPred_eq, Measure.restrict_apply hmeas, hg]
      exact zero_le
  rw [← h₁]
  exact h₂.trans_eq (lintegral_indicator_one hA')

lemma measure_biInter_le_measure_biInter_mul_range (hF : Continuous F) (hγ : Continuous γ)
    (hFγ : ∀ w g, AnalyticOnNhd ℝ (fun s ↦ F (w * γ s * g)) univ) (W : Set K) :
    μ (⋂ w ∈ W, {g | F (w * g) = z}) ≤ μ (⋂ w ∈ W * range γ, {g | F (w * g) = z}) := by
  have hA : IsClosed (⋂ w ∈ W, {g | F (w * g) = z}) :=
    isClosed_biInter fun w _ ↦ isClosed_eq (hF.comp (continuous_const.mul continuous_id))
      continuous_const
  have heq : ⋂ w ∈ W * range γ, {g | F (w * g) = z} =
      {g | ∀ s, γ s * g ∈ ⋂ w ∈ W, {g | F (w * g) = z}} := by
    ext g
    simp only [mem_iInter₂, mem_ofPred_eq]
    constructor
    · intro h s w hw
      rw [← mul_assoc]
      exact h _ ⟨w, hw, γ s, ⟨s, rfl⟩, rfl⟩
    · rintro h _ ⟨w, hw, _, ⟨s, rfl⟩, rfl⟩
      rw [mul_assoc]
      exact h s w hw
  rw [heq]
  refine measure_le_measure_setOf_forall_mul_mem hA hγ fun g ↦ ?_
  by_cases hg : ∀ s, γ s * g ∈ ⋂ w ∈ W, {g | F (w * g) = z}
  · exact Or.inl hg
  · simp only [mem_iInter₂, mem_ofPred_eq, not_forall] at hg
    rcases hg with ⟨s₀, w, hw, hne⟩
    rcases ((hFγ w g).sub analyticOnNhd_const).forall_eq_zero_or_volume_eq_zero with h | h
    · exact absurd (sub_eq_zero.mp (h s₀)) (by rwa [← mul_assoc] at hne)
    · refine Or.inr <| measure_mono_null ?_ h
      intro s hs
      have hs' : F (w * (γ s * g)) = z := mem_iInter₂.mp hs.1 w hw
      rw [← mul_assoc] at hs'
      exact ⟨sub_eq_zero.mpr hs', hs.2⟩

/-- **Almost every point of a level set of a function analytic along one-parameter subgroups has
its whole coset in the level set**: if `F` is continuous and every `s ↦ F (w * Γ i s * g)` is
real-analytic, for a family `Γ` of continuous curves through `1` with `Γ i (-s) = (Γ i s)⁻¹`, then
almost every `g` with `F g = z` has `F (h * g) = z` for every `h` in the subgroup generated by the
curves. -/
lemma measure_setOf_eq_sdiff_setOf_forall_mem_closure_eq_zero {ι : Type*} {Γ : ι → ℝ → K}
    (hΓ : ∀ i, Continuous (Γ i)) (hΓ₀ : ∀ i, Γ i 0 = 1) (hΓinv : ∀ i s, Γ i (-s) = (Γ i s)⁻¹)
    (hF : Continuous F) (hFΓ : ∀ i w g, AnalyticOnNhd ℝ (fun s ↦ F (w * Γ i s * g)) univ) :
    μ ({g | F g = z} \ {g | ∀ h ∈ Subgroup.closure (⋃ i, range (Γ i)), F (h * g) = z}) = 0 := by
  let S : Set K → Set K := fun W ↦ ⋂ w ∈ W, {g | F (w * g) = z}
  let P : List ι → Set K := fun l ↦ (l.map fun i ↦ range (Γ i)).prod
  have hP (l : List ι) (i : ι) : P (l ++ [i]) = P l * range (Γ i) := by
    simp [P]
  have hle (l : List ι) : μ {g | F g = z} ≤ μ (S (P l)) := by
    induction l using List.reverseRecOn with
    | nil => simp [S, P]
    | append_singleton l i ih =>
      rw [hP]
      exact ih.trans (measure_biInter_le_measure_biInter_mul_range hF (hΓ i) (hFΓ i) _)
  have hone (l : List ι) : (1 : K) ∈ P l := by
    induction l using List.reverseRecOn with
    | nil => exact Set.mem_one.mpr rfl
    | append_singleton l i ih =>
      rw [hP]
      exact ⟨1, ih, 1, ⟨0, hΓ₀ i⟩, one_mul 1⟩
  have hinv (l : List ι) (x : K) (hx : x ∈ P l) : x⁻¹ ∈ P l.reverse := by
    induction l using List.reverseRecOn generalizing x with
    | nil =>
      rw [Set.mem_one.mp hx, inv_one]
      exact Set.mem_one.mpr rfl
    | append_singleton l i ih =>
      rw [hP] at hx
      rcases hx with ⟨a, ha, _, ⟨s, rfl⟩, rfl⟩
      rw [mul_inv_rev, List.reverse_append, List.reverse_singleton, List.singleton_append]
      exact ⟨Γ i (-s), ⟨-s, rfl⟩, a⁻¹, ih a ha, by rw [hΓinv]⟩
  have hsub (l : List ι) : S (P l) ⊆ {g | F g = z} := fun g hg ↦ by
    simpa using mem_iInter₂.mp hg 1 (hone l)
  have hclosed (W : Set K) : IsClosed (S W) :=
    isClosed_biInter fun w _ ↦ isClosed_eq (hF.comp (continuous_const.mul continuous_id))
      continuous_const
  have hnull (l : List ι) : μ ({g | F g = z} \ S (P l)) = 0 := by
    rw [measure_sdiff (hsub l) (hclosed _).nullMeasurableSet (measure_ne_top μ _)]
    exact tsub_eq_zero_of_le (hle l)
  have hmem (h : K) (hh : h ∈ Subgroup.closure (⋃ i, range (Γ i))) : ∃ l, h ∈ P l := by
    induction hh using Subgroup.closure_induction with
    | mem x hx =>
      rcases mem_iUnion.mp hx with ⟨i, hi⟩
      exact ⟨[i], by simpa [P] using hi⟩
    | one => exact ⟨[], hone []⟩
    | mul x y _ _ hx hy =>
      rcases hx with ⟨l, hl⟩
      rcases hy with ⟨l', hl'⟩
      exact ⟨l ++ l', by simpa [P] using Set.mul_mem_mul hl hl'⟩
    | inv x _ hx =>
      rcases hx with ⟨l, hl⟩
      exact ⟨l.reverse, hinv l x hl⟩
  let H : Subgroup K := Subgroup.closure (⋃ i, range (Γ i))
  rcases TopologicalSpace.isOpen_iUnion_countable (fun h : H ↦ {g | F (h * g) ≠ z})
    (fun h ↦ isOpen_ne_fun (hF.comp (continuous_const.mul continuous_id)) continuous_const) with
    ⟨C, hC, hCU⟩
  choose l hl using fun h : H ↦ hmem h h.2
  refine measure_mono_null ?_ ((measure_biUnion_null_iff hC).mpr fun h _ ↦ hnull (l h))
  rintro g ⟨hgz, hgT⟩
  simp only [mem_ofPred_eq, not_forall] at hgT
  rcases hgT with ⟨h, hh, hne⟩
  have hg : g ∈ ⋃ h : H, {g | F (h * g) ≠ z} := mem_iUnion.mpr ⟨⟨h, hh⟩, hne⟩
  rw [← hCU] at hg
  rcases mem_iUnion₂.mp hg with ⟨h', hh'C, hne'⟩
  exact mem_iUnion₂.mpr ⟨h', hh'C, hgz, fun hS ↦ hne' (mem_iInter₂.mp hS _ (hl h'))⟩

end MeasureTheory
