import Mathlib.LinearAlgebra.Projectivization.PSL.PSL2
import TauCeti.LinearAlgebra.Matrix.SpecialLinearGroup.Transvection

/-!
# Simplicity of `PSL(n, F)`

The projective special linear group `PSL(n, F) = SL(n, F) / Z(SL(n, F))` is simple for `n ≥ 3` and
every field `F`, and for `n = 2` when `|F| ≥ 4` (Jordan, Dickson). Mathlib proves the case `n = 2`
(`Matrix.ProjectiveSpecialLinearGroup.rank_two_simple`) by Iwasawa's criterion for the action of
`PSL(2, F)` on the projective line. This file extends it to `n ≥ 3`, through the same Iwasawa
structure on the projective space `ℙ(Fⁿ)`: to each point is attached the subgroup of the
transvections with that centre, and these subgroups are abelian and permuted by conjugation. Two
facts about `SL(n, F)` are needed.

* It is generated by these subgroups, since it is generated by transvections (Tau Ceti's
  `Matrix.SpecialLinearGroup.closure_range_toSpecialLinearGroup_eq_top_of_field`).
* It is perfect for `n ≥ 3`: for a third coordinate `k`, the commutator of `t_{ik}(c)` and
  `t_{kj}(1)` is `t_{ij}(c)` (Tau Ceti's
  `Matrix.SpecialLinearGroup.commutatorElement_transvection`).

Over a finite field `𝔽_q` this is the simplicity of `PSL(n, q)` stated in LMFDB
`group.special_linear`, for `n ≥ 3`, and for `n = 2` when `q ≥ 4` (`PSL(1, q)` is trivial). These
simple groups are projective linear groups in the sense of LMFDB `group.linear`.

## Main definitions

* `Matrix.ProjectiveSpecialLinearGroup.iwasawaStructure`: the Iwasawa structure of `PSL(n, F)`
  acting on `ℙ(Fⁿ)`.

## Main results

* `Matrix.SpecialLinearGroup.iSup_lineStab_eq_top`: `SL(n, F)` is generated by the subgroups of
  transvections with a given centre.
* `Matrix.SpecialLinearGroup.commutator_eq_top_of_three_le_card`: `SL(n, F)` is perfect for
  `n ≥ 3`.
* `Matrix.ProjectiveSpecialLinearGroup.isSimpleGroup_of_three_le_card` (LMFDB
  `group.special_linear`, `group.linear`): `PSL(n, F)` is simple for `n ≥ 3`.
* `Matrix.ProjectiveSpecialLinearGroup.isSimpleGroup_fin` (LMFDB `group.special_linear`,
  `group.linear`): `PSL(n, F)` is simple for `n ≥ 3`, and for `n = 2` when `|F| ≥ 4`.

## References

* L. E. Dickson, *Linear groups, with an exposition of the Galois field theory* (1901).
* K. Iwasawa, *Über die Einfachheit der speziellen projektiven Gruppen* (1941).
-/

open Matrix MulAction

open scoped MatrixGroups LinearAlgebra.Projectivization commutatorElement

variable {ι F : Type*} [Fintype ι] [DecidableEq ι] [Field F]

namespace Matrix.SpecialLinearGroup

lemma eq_top_of_forall_transvection_mem {H : Subgroup (SpecialLinearGroup ι F)}
    (h : ∀ {i j : ι} (hij : i ≠ j) (c : F), transvection hij c ∈ H) : H = ⊤ :=
  eq_top_iff.mpr <| closure_range_toSpecialLinearGroup_eq_top_of_field.ge.trans <|
    (Subgroup.closure_le H).mpr <| Set.range_subset_iff.mpr fun t ↦ h t.hij t.c

lemma transvection_mem_iSup_lineStab {i j : ι} (hij : i ≠ j) (c : F) :
    transvection hij c ∈ ⨆ p : ℙ F (ι → F), lineStab p.submodule := by
  have hv : (Pi.single i 1 : ι → F) ≠ 0 := Pi.single_ne_zero_iff.mpr one_ne_zero
  refine le_iSup (fun p : ℙ F (ι → F) ↦ lineStab p.submodule) (.mk F _ hv) ?_
  rw [Projectivization.submodule_mk]
  exact SL2Gen.transvection_mem_lineStab hij c

/-- **`SL(n, F)` is generated by transvections**: it is the subgroup generated by the subgroups
`lineStab L` of transvections with centre a line `L`, since every transvection lies in one of
them. -/
lemma iSup_lineStab_eq_top : (⨆ p : ℙ F (ι → F), lineStab p.submodule) = ⊤ :=
  eq_top_of_forall_transvection_mem transvection_mem_iSup_lineStab

/-- **`SL(n, F)` is perfect for `n ≥ 3`**: for distinct `i`, `j`, `k`, the transvection
`t_{ij}(c)` is the commutator of `t_{ik}(c)` and `t_{kj}(1)`, and `SL(n, F)` is generated by
transvections. -/
lemma commutator_eq_top_of_three_le_card (h : 3 ≤ Fintype.card ι) :
    commutator (SpecialLinearGroup ι F) = ⊤ :=
  eq_top_of_forall_transvection_mem fun {i j} hij c ↦ by
    have hk : (({i, j} : Finset ι)ᶜ).Nonempty := by
      rw [← Finset.card_pos, Finset.card_compl]
      have hij2 : ({i, j} : Finset ι).card ≤ 2 := Finset.card_le_two
      omega
    rcases hk with ⟨k, hk⟩
    simp only [Finset.mem_compl, Finset.mem_insert, Finset.mem_singleton, not_or] at hk
    rw [← mul_one c, ← commutatorElement_transvection (Ne.symm hk.1) hk.2 hij]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

end Matrix.SpecialLinearGroup

namespace Matrix.ProjectiveSpecialLinearGroup

variable (ι F) in
/-- The Iwasawa structure of `PSL(n, F)` acting on the projective space `ℙ(Fⁿ)`: to a point `p` it
attaches the image of the abelian subgroup of the transvections with centre `p`; these subgroups
are permuted by conjugation, and they generate `PSL(n, F)`. -/
noncomputable def iwasawaStructure :
    IwasawaStructure (ProjectiveSpecialLinearGroup ι F) (ℙ F (ι → F)) where
  T := PSL.iwasawaT
  is_comm p := by
    have hSL : IsMulCommutative (SpecialLinearGroup.lineStab p.submodule) := by
      rw [← Projectivization.mk_rep p, Projectivization.submodule_mk]
      exact SpecialLinearGroup.lineStab_isMulCommutative_of_span p.rep p.rep_nonzero
    exact Subgroup.map_isMulCommutative _ _
  is_conj g p := by
    rcases QuotientGroup.mk_surjective g with ⟨g, rfl⟩
    rw [smul_proj_mk]
    simp only [PSL.iwasawaT]
    rw [PSL.smul_submodule, SpecialLinearGroup.lineStab_smul, PSL.iwasawaT_map_conj]
  is_generator := by
    rw [← Subgroup.map_iSup, SpecialLinearGroup.iSup_lineStab_eq_top]
    exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)

/-- **`PSL(n, F)` is simple for `n ≥ 3`** (LMFDB `group.special_linear`, `group.linear`), for every
field `F`, by Iwasawa's criterion: it is perfect, acts primitively and faithfully on `ℙ(Fⁿ)`, and
the abelian subgroups of transvections with a given centre are conjugate and generate it. -/
lemma isSimpleGroup_of_three_le_card (h : 3 ≤ Fintype.card ι) :
    IsSimpleGroup (ProjectiveSpecialLinearGroup ι F) := by
  have : Nontrivial ι := Fintype.one_lt_card_iff_nontrivial.mp (by omega)
  have : Group.IsPerfect (SpecialLinearGroup ι F) :=
    ⟨SpecialLinearGroup.commutator_eq_top_of_three_le_card h⟩
  have hPSL : Group.IsPerfect (ProjectiveSpecialLinearGroup ι F) := inferInstance
  exact IwasawaStructure.isSimpleGroup hPSL.commutator_eq_top (iwasawaStructure ι F)
    inferInstance

/-- **`PSL(n, F)` is simple for `n ≥ 3`, and for `n = 2` when `F` has at least `4` elements** (LMFDB
`group.special_linear`, `group.linear`): the theorem of Jordan and Dickson, the case `n = 2` being
Mathlib's `Matrix.ProjectiveSpecialLinearGroup.rank_two_simple`. The bound is on `Nat.card F`, so
for `n = 2` the field is finite. Over `F = 𝔽_q` this covers every `PSL(n, q)` with `n ≥ 2` other
than `PSL(2, 2)` and `PSL(2, 3)`. -/
lemma isSimpleGroup_fin {n : ℕ} (hn : 2 ≤ n) (hF : n = 2 → 4 ≤ Nat.card F) :
    IsSimpleGroup PSL(n, F) := by
  rcases eq_or_lt_of_le hn with rfl | hn
  · exact rank_two_simple (hF rfl)
  · exact isSimpleGroup_of_three_le_card (by rw [Fintype.card_fin]; omega)

end Matrix.ProjectiveSpecialLinearGroup
