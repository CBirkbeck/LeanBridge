import LeanBridge.ForMathlib.LinearAlgebra.RootSystem.Crystal
import Mathlib.Topology.Instances.Rat
import Mathlib.Topology.Order.LocalExtr

/-!
# The crystal of Littelmann paths

Littelmann's root operators `fᵢ` and `eᵢ` on the Littelmann paths of a root pairing `P` over `ℚ`
(`RootPairing.LittelmannPath.lower` and `RootPairing.LittelmannPath.raise`) satisfy Kashiwara's
crystal axioms, so that the Littelmann paths form a crystal, and the straight-line path `π_λ` to a
dominant integral weight `λ` is the unique highest weight element of the paths obtained from it by
the lowering operators.

The raising operator `eᵢ` undoes the lowering operator `fᵢ`. Let `Hᵢ` be the height function of
`π`, with minimum `mᵢ` and future minimum `F(t) = min_{s ≥ t} Hᵢ(s)`, so that `fᵢ π = π - c αᵢ`
with `c = min(1, F - mᵢ)`. The height function `Hᵢ - 2c` of `fᵢ π` is at least `mᵢ - c`, and when
`c(t) > 0` it takes the value `mᵢ - c(t)` at the last time before `t` at which `Hᵢ` crosses the
level `mᵢ + c(t)`. So the past minimum of `Hᵢ - 2c` at `t` is `mᵢ - c(t)`, and the coefficient of
`αᵢ` in `eᵢ fᵢ π` is `c(t)`. The proof of `fᵢ eᵢ π = π` is the mirror image, with the first time
after `t` at which `Hᵢ` crosses a level.

The closed forms of `fᵢ` and `eᵢ` agree with Littelmann's description by reflections: when `Hᵢ`
increases from its minimum `mᵢ` at a time `t₀` to `mᵢ + 1` at a time `t₁` and stays at least
`mᵢ + 1` afterwards, `fᵢ π` is the reflection of `π` by `sᵢ` between `t₀` and `t₁`; dually for
`eᵢ`. On Littelmann's integral paths, whose local minima of `Hᵢ` are integers, `Hᵢ` has this shape
between the last time `p` at which it takes its minimum and the least time `x` after which
`Hᵢ ≥ mᵢ + 1`: a local minimum of `Hᵢ` between `p` and `x` would lie strictly between `mᵢ` and
`mᵢ + 1`. So `fᵢ π` is the reflection of `π` between `p` and `x`, Littelmann's definition of `fᵢ`
on integral paths; dually for `eᵢ`.

The crystal of Littelmann paths has the weight `wt(π) = π(1)` and the integer parts of Littelmann's
`εᵢ(π) = -mᵢ` and `φᵢ(π) = Hᵢ(1) - mᵢ`, which are integers for integral paths: `eᵢ` and `fᵢ` can
be applied exactly `⌊εᵢ(π)⌋` and `⌊φᵢ(π)⌋` times to `π`, so the crystal is seminormal.

For a base `b` of `P`, the crystal `B(π)` generated by a path `π` is the set of the paths
`f_{i₁} ⋯ f_{iₖ} π` for simple roots `α_{i₁}, …, α_{iₖ}`. Its weights lie in `wt(π) - Q₊`, `π` is
its only path of weight `wt(π)`, and `π` is its only possible highest weight element. For the
straight-line path `π_λ` to a dominant integral weight `λ`, `π_λ` is a highest weight element, so it
is the unique highest weight element of `B(π_λ)`, and its `i`-string has length `⟨λ, αᵢ^∨⟩`, as in
the highest weight crystal `B(λ)`.

Littelmann's theorem that `B(π_λ)` is stable under the raising operators, so that it is a connected
crystal, isomorphic to Kashiwara's crystal `B(λ)` of the irreducible integrable module of highest
weight `λ`, is not formalised here: its proof goes through Littelmann's description of `B(π_λ)` by
Lakshmibai–Seshadri paths, and Kashiwara's crystal `B(λ)` is not available.

## Main definitions

* `RootPairing.LittelmannPath.crystal` (LMFDB `crystals.littelmann_path`): the crystal of Littelmann
  paths.
* `RootPairing.LittelmannPath.lowerClosure` (LMFDB `crystals.littelmann_path`): the crystal `B(π)`
  generated by a Littelmann path `π`.
* `RootPairing.LittelmannPath.HasIntegralMinima`: Littelmann paths whose local minima of `Hᵢ` are
  integers.

## Main results

* `RootPairing.LittelmannPath.raisePath_lowerPath`: `eᵢ fᵢ π = π`.
* `RootPairing.LittelmannPath.lowerPath_raisePath`: `fᵢ eᵢ π = π`.
* `RootPairing.LittelmannPath.lower_eq_some_iff`: `fᵢ π = π'` if and only if `eᵢ π' = π`.
* `RootPairing.LittelmannPath.lowerPath_eq_reflect` and
  `RootPairing.LittelmannPath.raisePath_eq_reflect`: `fᵢ` and `eᵢ` are reflections when `Hᵢ` has
  the shape it has on integral paths.
* `RootPairing.LittelmannPath.HasIntegralMinima.exists_lowerPath_eq_reflect` and
  `RootPairing.LittelmannPath.HasIntegralMinima.exists_raisePath_eq_reflect`: on integral paths,
  `fᵢ` and `eᵢ` are Littelmann's reflections.
* `RootPairing.LittelmannPath.isSeminormal_crystal`: the crystal of Littelmann paths is seminormal.
* `RootPairing.LittelmannPath.HasIntegralMinima.crystal_ε_eq` and
  `RootPairing.LittelmannPath.HasIntegralMinima.crystal_φ_eq`: on integral paths, the crystal data
  are Littelmann's `εᵢ(π) = -mᵢ` and `φᵢ(π) = Hᵢ(1) - mᵢ`.
* `RootPairing.LittelmannPath.sub_wt_mem_closure`: the weights of `B(π)` lie in `wt(π) - Q₊`.
* `RootPairing.LittelmannPath.eq_of_mem_lowerClosure_of_wt_eq`: `π` is the only path of weight
  `wt(π)` in `B(π)`.
* `RootPairing.LittelmannPath.not_isHighestWeight_of_mem_lowerClosure`: `π` is the only possible
  highest weight element of `B(π)`.
* `RootPairing.LittelmannPath.isHighestWeight_iff_eq_straightLinePath`: `π_λ` is the unique highest
  weight element of `B(π_λ)`.
* `RootPairing.LittelmannPath.iterate_lower_straightLinePath_ne_none_iff`: the `i`-string of `π_λ`
  has length `⟨λ, αᵢ^∨⟩`.
-/

open Module Relation Set

namespace RootPairing

variable {ι M N : Type*} [AddCommGroup M] [Module ℚ M] [AddCommGroup N] [Module ℚ N]
  {P : RootPairing ι ℚ M N} (π : P.LittelmannPath) (i : ι) {π' : P.LittelmannPath} (b : P.Base)
  {j : b.support} {x : M} (hx : P.IsIntegralWeight x) {f : Icc (0 : ℚ) 1 → ℚ}
  {S : Finset (Icc (0 : ℚ) 1)} {t₀ t₁ t : Icc (0 : ℚ) 1} {y : ℚ} (hS : IsBreakpointSet f S)

variable (t) in
lemma IsBreakpointSet.isLeast_inf'_max :
    IsLeast (f '' Ici t) (S.inf' ⟨⊥, hS.1⟩ fun s ↦ f (max s t)) := by
  refine ⟨?_, ?_⟩
  · rcases Finset.exists_mem_eq_inf' ⟨⊥, hS.1⟩ (fun s ↦ f (max s t)) with ⟨s, -, hs⟩
    exact ⟨max s t, le_max_right s t, hs.symm⟩
  · rintro _ ⟨u, hu, rfl⟩
    have hu' : t ≤ u := mem_Ici.mp hu
    rcases hS.exists_le_le u with ⟨c, hc, d, hd, hcu, hud, heq⟩
    have hd' : S.inf' ⟨⊥, hS.1⟩ (fun s ↦ f (max s t)) ≤ f d :=
      (Finset.inf'_le (fun s ↦ f (max s t)) hd).trans_eq
        (congrArg f (max_eq_left (hu'.trans hud)))
    rcases le_total t c with htc | hct
    · have hc' : S.inf' ⟨⊥, hS.1⟩ (fun s ↦ f (max s t)) ≤ f c :=
        (Finset.inf'_le (fun s ↦ f (max s t)) hc).trans_eq (congrArg f (max_eq_left htc))
      exact le_apply_of_affine (heq u hcu hud) hcu hud hc' hd'
    · have ht' : S.inf' ⟨⊥, hS.1⟩ (fun s ↦ f (max s t)) ≤ f t :=
        (Finset.inf'_le (fun s ↦ f (max s t)) hS.1).trans_eq (congrArg f (max_eq_right bot_le))
      rcases (hu'.trans hud).lt_or_eq with htd | htd
      · exact le_apply_of_affine (eq_add_smul_of_le heq hct htd le_rfl u hu' hud) hu' hud ht' hd'
      · rwa [le_antisymm (htd ▸ hud) hu']

variable (t) in
lemma IsBreakpointSet.isLeast_inf'_min :
    IsLeast (f '' Iic t) (S.inf' ⟨⊤, hS.2.1⟩ fun s ↦ f (min s t)) := by
  refine ⟨?_, ?_⟩
  · rcases Finset.exists_mem_eq_inf' ⟨⊤, hS.2.1⟩ (fun s ↦ f (min s t)) with ⟨s, -, hs⟩
    exact ⟨min s t, min_le_right s t, hs.symm⟩
  · rintro _ ⟨u, hu, rfl⟩
    have hu' : u ≤ t := mem_Iic.mp hu
    rcases hS.exists_le_le u with ⟨c, hc, d, hd, hcu, hud, heq⟩
    have hc' : S.inf' ⟨⊤, hS.2.1⟩ (fun s ↦ f (min s t)) ≤ f c :=
      (Finset.inf'_le (fun s ↦ f (min s t)) hc).trans_eq
        (congrArg f (min_eq_left (hcu.trans hu')))
    rcases le_total d t with hdt | htd
    · have hd' : S.inf' ⟨⊤, hS.2.1⟩ (fun s ↦ f (min s t)) ≤ f d :=
        (Finset.inf'_le (fun s ↦ f (min s t)) hd).trans_eq (congrArg f (min_eq_left hdt))
      exact le_apply_of_affine (heq u hcu hud) hcu hud hc' hd'
    · have ht' : S.inf' ⟨⊤, hS.2.1⟩ (fun s ↦ f (min s t)) ≤ f t :=
        (Finset.inf'_le (fun s ↦ f (min s t)) hS.2.1).trans_eq
          (congrArg f (min_eq_right le_top))
      rcases (hcu.trans hu').lt_or_eq with hct | hct
      · exact le_apply_of_affine (eq_add_smul_of_le heq le_rfl hct htd u hcu hu') hcu hu' hc' ht'
      · rwa [le_antisymm (hct ▸ hu') hcu]

lemma IsPiecewiseLinearPath.exists_eq_forall_le (hf : IsPiecewiseLinearPath f) (h₀ : f ⊥ ≤ y)
    (h₁ : y ≤ f ⊤) : ∃ w, f w = y ∧ ∀ s, w ≤ s → y ≤ f s := by
  rcases hf with ⟨S, hS⟩
  rcases (isPiecewiseLinearPath_inf' ⟨⊥, hS.1⟩ fun s hs ↦ ⟨S, hS.comp_max hs⟩).exists_eq
    ((Finset.inf'_le _ hS.1).trans ((congrArg f (max_self ⊥)).trans_le h₀))
    (Finset.le_inf' _ _ fun s _ ↦ (congrArg f (max_eq_right le_top)).symm ▸ h₁) with ⟨u, hu⟩
  rcases (hS.isLeast_inf'_max u).1 with ⟨w, hw, hfw⟩
  exact ⟨w, hfw.trans hu, fun s hs ↦
    hu ▸ (hS.isLeast_inf'_max u).2 ⟨s, (mem_Ici.mp hw).trans hs, rfl⟩⟩

lemma IsPiecewiseLinearPath.exists_eq_forall_le' (hf : IsPiecewiseLinearPath f) (h₀ : y ≤ f ⊥)
    (h₁ : f ⊤ ≤ y) : ∃ w, f w = y ∧ ∀ s, s ≤ w → y ≤ f s := by
  rcases hf with ⟨S, hS⟩
  rcases (isPiecewiseLinearPath_inf' ⟨⊤, hS.2.1⟩ fun s hs ↦ ⟨S, hS.comp_min hs⟩).neg.exists_eq
    (neg_le_neg (Finset.le_inf' _ _ fun s _ ↦ (congrArg f (min_eq_right bot_le)).symm ▸ h₀))
    (neg_le_neg ((Finset.inf'_le _ hS.2.1).trans ((congrArg f (min_self ⊤)).trans_le h₁)))
    with ⟨u, hu⟩
  rw [Pi.neg_apply, neg_inj] at hu
  rcases (hS.isLeast_inf'_min u).1 with ⟨w, hw, hfw⟩
  exact ⟨w, hfw.trans hu, fun s hs ↦
    hu ▸ (hS.isLeast_inf'_min u).2 ⟨s, hs.trans (mem_Iic.mp hw), rfl⟩⟩

variable (t₀ t₁) in
lemma IsPiecewiseLinearPath.exists_isBreakpointSet (hf : IsPiecewiseLinearPath f) :
    ∃ T, IsBreakpointSet f T ∧ t₀ ∈ T ∧ t₁ ∈ T := by
  rcases hf with ⟨S, hS⟩
  exact ⟨insert t₀ (insert t₁ S),
    hS.mono ((Finset.subset_insert _ _).trans (Finset.subset_insert _ _)),
    Finset.mem_insert_self _ _, Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)⟩

lemma IsPiecewiseLinearPath.exists_eq_forall_le_of_le (hf : IsPiecewiseLinearPath f) (h : t₀ ≤ t₁)
    (h₀ : f t₀ ≤ y) (h₁ : y ≤ f t₁) :
    ∃ w, t₀ ≤ w ∧ w ≤ t₁ ∧ f w = y ∧ ∀ s, w ≤ s → s ≤ t₁ → y ≤ f s := by
  rcases hf.exists_isBreakpointSet t₀ t₁ with ⟨T, hT, ht₀, ht₁⟩
  rcases IsPiecewiseLinearPath.exists_eq_forall_le ⟨T, (hT.comp_min ht₁).comp_max ht₀⟩
    ((congrArg f ((congrArg (min t₁) (max_eq_left bot_le)).trans (min_eq_right h))).trans_le h₀)
    (h₁.trans_eq (congrArg f ((congrArg (min t₁) (max_eq_right le_top)).trans
      (min_eq_left le_top))).symm) with ⟨w, hw, hws⟩
  refine ⟨min t₁ (max t₀ w), le_min h (le_max_left t₀ w), min_le_left t₁ _, hw,
    fun s hs hs₁ ↦ ?_⟩
  rcases le_total w t₁ with hw₁ | hw₁
  · rw [min_eq_right (max_le h hw₁)] at hs
    have hy : y ≤ f (min t₁ (max t₀ s)) := hws s ((le_max_right t₀ w).trans hs)
    rwa [max_eq_right ((le_max_left t₀ w).trans hs), min_eq_right hs₁] at hy
  · rw [min_eq_left (hw₁.trans (le_max_right t₀ w))] at hs
    rwa [le_antisymm hs₁ hs]

lemma IsPiecewiseLinearPath.exists_eq_forall_le_of_ge (hf : IsPiecewiseLinearPath f) (h : t₀ ≤ t₁)
    (h₀ : y ≤ f t₀) (h₁ : f t₁ ≤ y) :
    ∃ w, t₀ ≤ w ∧ w ≤ t₁ ∧ f w = y ∧ ∀ s, t₀ ≤ s → s ≤ w → y ≤ f s := by
  rcases hf.exists_isBreakpointSet t₀ t₁ with ⟨T, hT, ht₀, ht₁⟩
  rcases IsPiecewiseLinearPath.exists_eq_forall_le' ⟨T, (hT.comp_min ht₁).comp_max ht₀⟩
    (h₀.trans_eq (congrArg f ((congrArg (min t₁) (max_eq_left bot_le)).trans
      (min_eq_right h))).symm)
    ((congrArg f ((congrArg (min t₁) (max_eq_right le_top)).trans
      (min_eq_left le_top))).trans_le h₁) with ⟨w, hw, hws⟩
  refine ⟨min t₁ (max t₀ w), le_min h (le_max_left t₀ w), min_le_left t₁ _, hw,
    fun s hs₀ hs ↦ ?_⟩
  rcases le_total t₀ w with hw₀ | hw₀
  · rw [max_eq_right hw₀] at hs
    have hy : y ≤ f (min t₁ (max t₀ s)) := hws s (hs.trans (min_le_right t₁ w))
    rwa [max_eq_right hs₀, min_eq_right (hs.trans (min_le_left t₁ w))] at hy
  · rw [max_eq_left hw₀, min_eq_right h] at hs
    rwa [le_antisymm hs hs₀]

lemma IsBreakpointSet.exists_segment_around (hT : IsBreakpointSet f S) (s : Icc (0 : ℚ) 1) :
    ∃ c ∈ S, ∃ d ∈ S, c ≤ s ∧ s ≤ d ∧ (∀ u ∈ S, u ≤ s → u ≤ c) ∧ (∀ u ∈ S, s ≤ u → d ≤ u) ∧
      ∀ v, c ≤ v → v ≤ d → f v = f c + (((v : ℚ) - c) / ((d : ℚ) - c)) • (f d - f c) := by
  rcases (S.filter (· ≤ s)).exists_max_image id ⟨⊥, Finset.mem_filter.mpr ⟨hT.1, bot_le⟩⟩ with
    ⟨c, hc, hcmax⟩
  rcases (S.filter (s ≤ ·)).exists_min_image id ⟨⊤, Finset.mem_filter.mpr ⟨hT.2.1, le_top⟩⟩ with
    ⟨d, hd, hdmin⟩
  rw [Finset.mem_filter] at hc hd
  refine ⟨c, hc.1, d, hd.1, hc.2, hd.2, fun u hu hus ↦ hcmax u (Finset.mem_filter.mpr ⟨hu, hus⟩),
    fun u hu hsu ↦ hdmin u (Finset.mem_filter.mpr ⟨hu, hsu⟩), fun v hcv hvd ↦ ?_⟩
  rcases (hc.2.trans hd.2).lt_or_eq with hcd | hcd
  · refine hT.2.2 c hc.1 d hd.1 hcd (fun u hu ↦ ?_) v hcv hvd
    rcases le_or_gt u s with hus | hsu
    · exact Or.inl (hcmax u (Finset.mem_filter.mpr ⟨hu, hus⟩))
    · exact Or.inr (hdmin u (Finset.mem_filter.mpr ⟨hu, hsu.le⟩))
  · rw [← le_antisymm (hcd ▸ hvd) hcv, sub_self, zero_div, zero_smul, add_zero]

lemma IsPiecewiseLinearPath.exists_eq_forall_le_of_lt (hf : IsPiecewiseLinearPath f) (h₀ : f t₀ < y)
    (h₁ : y ≤ f ⊤) :
    ∃ w, t₀ ≤ w ∧ f w = y ∧ (∀ s, w ≤ s → y ≤ f s) ∧ ∀ s < w, ∃ u, s ≤ u ∧ u < w ∧ f u < y := by
  rcases hf.exists_isBreakpointSet t₀ ⊤ with ⟨T, hT, ht₀, ht₁⟩
  rcases (T.filter fun u ↦ t₀ ≤ u ∧ f u < y).exists_max_image id
    ⟨t₀, Finset.mem_filter.mpr ⟨ht₀, le_rfl, h₀⟩⟩ with ⟨a, ha, hamax⟩
  rw [Finset.mem_filter] at ha
  rcases ha with ⟨haT, hta, hfa⟩
  have hat : a < ⊤ := lt_of_le_of_ne le_top fun h ↦ (h ▸ hfa).not_ge h₁
  rcases (T.filter (a < ·)).exists_min_image id ⟨⊤, Finset.mem_filter.mpr ⟨ht₁, hat⟩⟩ with
    ⟨b, hb, hbmin⟩
  rw [Finset.mem_filter] at hb
  rcases hb with ⟨hbT, hab⟩
  have hfb : y ≤ f b := not_lt.mp fun hfb ↦
    hab.not_ge (hamax b (Finset.mem_filter.mpr ⟨hbT, hta.trans hab.le, hfb⟩))
  have haff : ∀ x, a ≤ x → x ≤ b → f x = f a + (((x : ℚ) - a) / ((b : ℚ) - a)) • (f b - f a) :=
    hT.2.2 a haT b hbT hab fun u hu ↦ (le_or_gt u a).imp_right fun hau ↦
      hbmin u (Finset.mem_filter.mpr ⟨hu, hau⟩)
  have hab₁ : (a : ℚ) < b := hab
  have hfab : 0 < f b - f a := by
    linarith
  have hl₀ : 0 < (y - f a) / (f b - f a) := div_pos (by linarith) hfab
  have hl₁ : (y - f a) / (f b - f a) ≤ 1 := div_le_one_of_le₀ (by linarith) hfab.le
  have hτa : (a : ℚ) < a + (y - f a) / (f b - f a) * ((b : ℚ) - a) := by
    nlinarith
  have hτb : (a : ℚ) + (y - f a) / (f b - f a) * ((b : ℚ) - a) ≤ b := by
    nlinarith
  let w : Icc (0 : ℚ) 1 := ⟨_, a.2.1.trans hτa.le, hτb.trans b.2.2⟩
  have hw : (w : ℚ) = a + (y - f a) / (f b - f a) * ((b : ℚ) - a) := rfl
  have haw : a < w := hτa
  have hwb : w ≤ b := hτb
  have hf (x : Icc (0 : ℚ) 1) (hax : a ≤ x) (hxb : x ≤ b) :
      f x - y = (f b - f a) / ((b : ℚ) - a) * ((x : ℚ) - w) := by
    have hba : (b : ℚ) - a ≠ 0 := sub_ne_zero.mpr hab₁.ne'
    rw [haff x hax hxb, smul_eq_mul, hw]
    field_simp
    ring1
  have hk : 0 < (f b - f a) / ((b : ℚ) - a) := div_pos hfab (sub_pos.mpr hab₁)
  refine ⟨w, hta.trans haw.le, ?_, fun s hws ↦ ?_, fun s hsw ↦ ?_⟩
  · have h' : f w - y = (f b - f a) / ((b : ℚ) - a) * ((w : ℚ) - w) := hf w haw.le hwb
    rwa [sub_self, mul_zero, sub_eq_zero] at h'
  · rcases le_total s b with hsb | hbs
    · have h' : f s - y = (f b - f a) / ((b : ℚ) - a) * ((s : ℚ) - w) :=
        hf s (haw.le.trans hws) hsb
      have hws₁ : (w : ℚ) ≤ s := hws
      nlinarith
    · rcases hT.exists_segment_around s with ⟨c, hcT, d, hdT, hcs, hsd, hcmax, -, hcd⟩
      have hbc : b ≤ c := hcmax b hbT hbs
      have hfc : y ≤ f c := not_lt.mp fun hfc ↦ (hab.trans_le hbc).not_ge
        (hamax c (Finset.mem_filter.mpr ⟨hcT, hta.trans (hab.le.trans hbc), hfc⟩))
      have hfd : y ≤ f d := not_lt.mp fun hfd ↦ (hab.trans_le (hbs.trans hsd)).not_ge
        (hamax d (Finset.mem_filter.mpr ⟨hdT, hta.trans (hab.le.trans (hbs.trans hsd)), hfd⟩))
      exact le_apply_of_affine (hcd s hcs hsd) hcs hsd hfc hfd
  · rcases le_or_gt s a with hsa | has
    · exact ⟨a, hsa, haw, hfa⟩
    · have h' : f s - y = (f b - f a) / ((b : ℚ) - a) * ((s : ℚ) - w) :=
        hf s has.le (hsw.le.trans hwb)
      have hsw₁ : (s : ℚ) < w := hsw
      exact ⟨s, le_rfl, hsw, by nlinarith⟩

lemma IsPiecewiseLinearPath.exists_eq_forall_le_of_lt' (hf : IsPiecewiseLinearPath f) (h₀ : y ≤ f ⊥)
    (h₁ : f t₁ < y) :
    ∃ w, w ≤ t₁ ∧ f w = y ∧ (∀ s, s ≤ w → y ≤ f s) ∧ ∀ s, w < s → ∃ u, w < u ∧ u ≤ s ∧ f u < y := by
  rcases hf.exists_isBreakpointSet ⊥ t₁ with ⟨T, hT, ht₀, ht₁⟩
  rcases (T.filter fun u ↦ u ≤ t₁ ∧ f u < y).exists_min_image id
    ⟨t₁, Finset.mem_filter.mpr ⟨ht₁, le_rfl, h₁⟩⟩ with ⟨a, ha, hamin⟩
  rw [Finset.mem_filter] at ha
  rcases ha with ⟨haT, hat₁, hfa⟩
  have hba : ⊥ < a := lt_of_le_of_ne bot_le fun h ↦ (h ▸ hfa).not_ge h₀
  rcases (T.filter (· < a)).exists_max_image id ⟨⊥, Finset.mem_filter.mpr ⟨ht₀, hba⟩⟩ with
    ⟨b, hb, hbmax⟩
  rw [Finset.mem_filter] at hb
  rcases hb with ⟨hbT, hba⟩
  have hfb : y ≤ f b := not_lt.mp fun hfb ↦
    hba.not_ge (hamin b (Finset.mem_filter.mpr ⟨hbT, hba.le.trans hat₁, hfb⟩))
  have haff : ∀ x, b ≤ x → x ≤ a → f x = f b + (((x : ℚ) - b) / ((a : ℚ) - b)) • (f a - f b) :=
    hT.2.2 b hbT a haT hba fun u hu ↦ (lt_or_ge u a).imp
      (fun hua ↦ hbmax u (Finset.mem_filter.mpr ⟨hu, hua⟩)) id
  have hba₁ : (b : ℚ) < a := hba
  have hfab : 0 < f b - f a := by
    linarith
  have hl₀ : 0 ≤ (f b - y) / (f b - f a) := div_nonneg (by linarith) hfab.le
  have hl₁ : (f b - y) / (f b - f a) < 1 := (div_lt_one hfab).mpr (by linarith)
  have hτb : (b : ℚ) ≤ b + (f b - y) / (f b - f a) * ((a : ℚ) - b) := by
    nlinarith
  have hτa : (b : ℚ) + (f b - y) / (f b - f a) * ((a : ℚ) - b) < a := by
    nlinarith
  let w : Icc (0 : ℚ) 1 := ⟨_, b.2.1.trans hτb, hτa.le.trans a.2.2⟩
  have hw : (w : ℚ) = b + (f b - y) / (f b - f a) * ((a : ℚ) - b) := rfl
  have hbw : b ≤ w := hτb
  have hwa : w < a := hτa
  have hf (x : Icc (0 : ℚ) 1) (hbx : b ≤ x) (hxa : x ≤ a) :
      f x - y = (f a - f b) / ((a : ℚ) - b) * ((x : ℚ) - w) := by
    have hab : (a : ℚ) - b ≠ 0 := sub_ne_zero.mpr hba₁.ne'
    have hfab' : f b - f a ≠ 0 := hfab.ne'
    rw [haff x hbx hxa, smul_eq_mul, hw]
    field_simp
    ring1
  have hk : (f a - f b) / ((a : ℚ) - b) < 0 :=
    div_neg_of_neg_of_pos (by linarith) (sub_pos.mpr hba₁)
  refine ⟨w, hwa.le.trans hat₁, ?_, fun s hsw ↦ ?_, fun s hws ↦ ?_⟩
  · have h' : f w - y = (f a - f b) / ((a : ℚ) - b) * ((w : ℚ) - w) := hf w hbw hwa.le
    rwa [sub_self, mul_zero, sub_eq_zero] at h'
  · rcases le_total b s with hbs | hsb
    · have h' : f s - y = (f a - f b) / ((a : ℚ) - b) * ((s : ℚ) - w) :=
        hf s hbs (hsw.trans hwa.le)
      have hsw₁ : (s : ℚ) ≤ w := hsw
      nlinarith
    · rcases hT.exists_segment_around s with ⟨c, hcT, d, hdT, hcs, hsd, -, hdmin, hcd⟩
      have hdb : d ≤ b := hdmin b hbT hsb
      have hfc : y ≤ f c := not_lt.mp fun hfc ↦ (hcs.trans_lt (hsb.trans_lt hba)).not_ge
        (hamin c (Finset.mem_filter.mpr ⟨hcT, (hcs.trans (hsb.trans hba.le)).trans hat₁, hfc⟩))
      have hfd : y ≤ f d := not_lt.mp fun hfd ↦ (hdb.trans_lt hba).not_ge
        (hamin d (Finset.mem_filter.mpr ⟨hdT, (hdb.trans hba.le).trans hat₁, hfd⟩))
      exact le_apply_of_affine (hcd s hcs hsd) hcs hsd hfc hfd
  · rcases le_or_gt a s with has | hsa
    · exact ⟨a, hwa, has, hfa⟩
    · have h' : f s - y = (f a - f b) / ((a : ℚ) - b) * ((s : ℚ) - w) :=
        hf s (hbw.trans hws.le) hsa.le
      have hws₁ : (w : ℚ) < s := hws
      exact ⟨s, hws, le_rfl, by nlinarith⟩

lemma IsPiecewiseLinearPath.exists_le_forall_lt (hf : IsPiecewiseLinearPath f) (h : t₀ ≤ t₁)
    (h₀ : f t₀ ≤ y) : ∃ w, t₀ ≤ w ∧ w ≤ t₁ ∧ f w ≤ y ∧ ∀ s, w < s → s ≤ t₁ → y < f s := by
  rcases hf.exists_isBreakpointSet t₀ t₁ with ⟨T, hT, ht₀, ht₁⟩
  rcases (T.filter fun u ↦ t₀ ≤ u ∧ u ≤ t₁ ∧ f u ≤ y).exists_max_image id
    ⟨t₀, Finset.mem_filter.mpr ⟨ht₀, le_rfl, h, h₀⟩⟩ with ⟨a, ha, hamax⟩
  rw [Finset.mem_filter] at ha
  rcases ha with ⟨haT, hta, hat₁, hfa⟩
  rcases hat₁.lt_or_eq with hat₁ | hat₁
  · rcases (T.filter (a < ·)).exists_min_image id ⟨t₁, Finset.mem_filter.mpr ⟨ht₁, hat₁⟩⟩ with
      ⟨b, hb, hbmin⟩
    rw [Finset.mem_filter] at hb
    rcases hb with ⟨hbT, hab⟩
    have hbt₁ : b ≤ t₁ := hbmin t₁ (Finset.mem_filter.mpr ⟨ht₁, hat₁⟩)
    have hfb : y < f b := not_le.mp fun hfb ↦
      hab.not_ge (hamax b (Finset.mem_filter.mpr ⟨hbT, hta.trans hab.le, hbt₁, hfb⟩))
    have haff : ∀ x, a ≤ x → x ≤ b → f x = f a + (((x : ℚ) - a) / ((b : ℚ) - a)) • (f b - f a) :=
      hT.2.2 a haT b hbT hab fun u hu ↦ (le_or_gt u a).imp_right fun hau ↦
        hbmin u (Finset.mem_filter.mpr ⟨hu, hau⟩)
    have hab₁ : (a : ℚ) < b := hab
    have hfab : 0 < f b - f a := by
      linarith
    have hl₀ : 0 ≤ (y - f a) / (f b - f a) := div_nonneg (by linarith) hfab.le
    have hl₁ : (y - f a) / (f b - f a) < 1 := (div_lt_one hfab).mpr (by linarith)
    have hτa : (a : ℚ) ≤ a + (y - f a) / (f b - f a) * ((b : ℚ) - a) := by
      nlinarith
    have hτb : (a : ℚ) + (y - f a) / (f b - f a) * ((b : ℚ) - a) < b := by
      nlinarith
    let w : Icc (0 : ℚ) 1 := ⟨_, a.2.1.trans hτa, hτb.le.trans b.2.2⟩
    have hw : (w : ℚ) = a + (y - f a) / (f b - f a) * ((b : ℚ) - a) := rfl
    have haw : a ≤ w := hτa
    have hwb : w < b := hτb
    have hf (x : Icc (0 : ℚ) 1) (hax : a ≤ x) (hxb : x ≤ b) :
        f x - y = (f b - f a) / ((b : ℚ) - a) * ((x : ℚ) - w) := by
      have hba : (b : ℚ) - a ≠ 0 := sub_ne_zero.mpr hab₁.ne'
      rw [haff x hax hxb, smul_eq_mul, hw]
      field_simp
      ring1
    have hk : 0 < (f b - f a) / ((b : ℚ) - a) := div_pos hfab (sub_pos.mpr hab₁)
    refine ⟨w, hta.trans haw, hwb.le.trans hbt₁, ?_, fun s hws hst₁ ↦ ?_⟩
    · have h' : f w - y = (f b - f a) / ((b : ℚ) - a) * ((w : ℚ) - w) := hf w haw hwb.le
      rw [sub_self, mul_zero, sub_eq_zero] at h'
      exact h'.le
    · rcases le_total s b with hsb | hbs
      · have h' : f s - y = (f b - f a) / ((b : ℚ) - a) * ((s : ℚ) - w) :=
          hf s (haw.trans hws.le) hsb
        have hws₁ : (w : ℚ) < s := hws
        nlinarith
      · rcases hT.exists_segment_around s with ⟨c, hcT, d, hdT, hcs, hsd, hcmax, hdmin, hcd⟩
        have hbc : b ≤ c := hcmax b hbT hbs
        have hdt₁ : d ≤ t₁ := hdmin t₁ ht₁ hst₁
        have hfc : y < f c := not_le.mp fun hfc ↦ (hab.trans_le hbc).not_ge
          (hamax c (Finset.mem_filter.mpr ⟨hcT, hta.trans (hab.le.trans hbc), hcs.trans hst₁, hfc⟩))
        have hfd : y < f d := not_le.mp fun hfd ↦ (hab.trans_le (hbs.trans hsd)).not_ge
          (hamax d (Finset.mem_filter.mpr ⟨hdT, hta.trans (hab.le.trans (hbs.trans hsd)), hdt₁,
            hfd⟩))
        exact (lt_min hfc hfd).trans_le
          (le_apply_of_affine (hcd s hcs hsd) hcs hsd (min_le_left _ _) (min_le_right _ _))
  · exact ⟨a, hta, hat₁.le, hfa, fun s has hst₁ ↦ absurd (hat₁ ▸ hst₁) (not_le.mpr has)⟩

lemma IsPiecewiseLinearPath.exists_le_forall_lt' (hf : IsPiecewiseLinearPath f) (h : t₀ ≤ t₁)
    (h₁ : f t₁ ≤ y) : ∃ w, t₀ ≤ w ∧ w ≤ t₁ ∧ f w ≤ y ∧ ∀ s, t₀ ≤ s → s < w → y < f s := by
  rcases hf.exists_isBreakpointSet t₀ t₁ with ⟨T, hT, ht₀, ht₁⟩
  rcases (T.filter fun u ↦ t₀ ≤ u ∧ u ≤ t₁ ∧ f u ≤ y).exists_min_image id
    ⟨t₁, Finset.mem_filter.mpr ⟨ht₁, h, le_rfl, h₁⟩⟩ with ⟨a, ha, hamin⟩
  rw [Finset.mem_filter] at ha
  rcases ha with ⟨haT, hta, hat₁, hfa⟩
  rcases hta.lt_or_eq with hta | hta
  · rcases (T.filter (· < a)).exists_max_image id ⟨t₀, Finset.mem_filter.mpr ⟨ht₀, hta⟩⟩ with
      ⟨b, hb, hbmax⟩
    rw [Finset.mem_filter] at hb
    rcases hb with ⟨hbT, hba⟩
    have htb : t₀ ≤ b := hbmax t₀ (Finset.mem_filter.mpr ⟨ht₀, hta⟩)
    have hfb : y < f b := not_le.mp fun hfb ↦
      hba.not_ge (hamin b (Finset.mem_filter.mpr ⟨hbT, htb, hba.le.trans hat₁, hfb⟩))
    have haff : ∀ x, b ≤ x → x ≤ a → f x = f b + (((x : ℚ) - b) / ((a : ℚ) - b)) • (f a - f b) :=
      hT.2.2 b hbT a haT hba fun u hu ↦ (lt_or_ge u a).imp
        (fun hua ↦ hbmax u (Finset.mem_filter.mpr ⟨hu, hua⟩)) id
    have hba₁ : (b : ℚ) < a := hba
    have hfab : 0 < f b - f a := by
      linarith
    have hl₀ : 0 < (f b - y) / (f b - f a) := div_pos (by linarith) hfab
    have hl₁ : (f b - y) / (f b - f a) ≤ 1 := div_le_one_of_le₀ (by linarith) hfab.le
    have hτb : (b : ℚ) < b + (f b - y) / (f b - f a) * ((a : ℚ) - b) := by
      nlinarith
    have hτa : (b : ℚ) + (f b - y) / (f b - f a) * ((a : ℚ) - b) ≤ a := by
      nlinarith
    let w : Icc (0 : ℚ) 1 := ⟨_, b.2.1.trans hτb.le, hτa.trans a.2.2⟩
    have hw : (w : ℚ) = b + (f b - y) / (f b - f a) * ((a : ℚ) - b) := rfl
    have hbw : b < w := hτb
    have hwa : w ≤ a := hτa
    have hf (x : Icc (0 : ℚ) 1) (hbx : b ≤ x) (hxa : x ≤ a) :
        f x - y = (f a - f b) / ((a : ℚ) - b) * ((x : ℚ) - w) := by
      have hab : (a : ℚ) - b ≠ 0 := sub_ne_zero.mpr hba₁.ne'
      have hfab' : f b - f a ≠ 0 := hfab.ne'
      rw [haff x hbx hxa, smul_eq_mul, hw]
      field_simp
      ring1
    have hk : (f a - f b) / ((a : ℚ) - b) < 0 :=
      div_neg_of_neg_of_pos (by linarith) (sub_pos.mpr hba₁)
    refine ⟨w, htb.trans hbw.le, hwa.trans hat₁, ?_, fun s hts hsw ↦ ?_⟩
    · have h' : f w - y = (f a - f b) / ((a : ℚ) - b) * ((w : ℚ) - w) := hf w hbw.le hwa
      rw [sub_self, mul_zero, sub_eq_zero] at h'
      exact h'.le
    · rcases le_total b s with hbs | hsb
      · have h' : f s - y = (f a - f b) / ((a : ℚ) - b) * ((s : ℚ) - w) :=
          hf s hbs (hsw.le.trans hwa)
        have hsw₁ : (s : ℚ) < w := hsw
        nlinarith
      · rcases hT.exists_segment_around s with ⟨c, hcT, d, hdT, hcs, hsd, hcmax, hdmin, hcd⟩
        have htc : t₀ ≤ c := hcmax t₀ ht₀ hts
        have hdb : d ≤ b := hdmin b hbT hsb
        have hfc : y < f c := not_le.mp fun hfc ↦ ((hcs.trans hsb).trans_lt hba).not_ge
          (hamin c (Finset.mem_filter.mpr ⟨hcT, htc, (hcs.trans (hsb.trans hba.le)).trans hat₁,
            hfc⟩))
        have hfd : y < f d := not_le.mp fun hfd ↦ (hdb.trans_lt hba).not_ge
          (hamin d (Finset.mem_filter.mpr ⟨hdT, hts.trans hsd, (hdb.trans hba.le).trans hat₁, hfd⟩))
        exact (lt_min hfc hfd).trans_le
          (le_apply_of_affine (hcd s hcs hsd) hcs hsd (min_le_left _ _) (min_le_right _ _))
  · exact ⟨a, hta.le, hat₁, hfa, fun s hts hsa ↦ absurd (hta ▸ hts) (not_le.mpr hsa)⟩

namespace LittelmannPath

lemma isPiecewiseLinearPath_height : IsPiecewiseLinearPath (π.height i) := by
  rcases π.isPiecewiseLinearPath with ⟨S, hS⟩
  exact ⟨S, π.isBreakpointSet_height i hS⟩

variable (t) in
lemma minHeight_le_height : π.minHeight i ≤ π.height i t :=
  (π.isLeast_minHeight i).2 ⟨t, rfl⟩

lemma futureMinHeight_le_height_of_le (h : t ≤ t₁) : π.futureMinHeight i t ≤ π.height i t₁ :=
  (π.isLeast_futureMinHeight i t).2 ⟨t₁, h, rfl⟩

lemma pastMinHeight_le_height_of_le (h : t₀ ≤ t) : π.pastMinHeight i t ≤ π.height i t₀ :=
  (π.isLeast_pastMinHeight i t).2 ⟨t₀, h, rfl⟩

variable (t) in
lemma minHeight_le_futureMinHeight : π.minHeight i ≤ π.futureMinHeight i t := by
  rcases (π.isLeast_futureMinHeight i t).1 with ⟨s, -, hs⟩
  exact hs ▸ π.minHeight_le_height i s

variable (t) in
lemma minHeight_le_pastMinHeight : π.minHeight i ≤ π.pastMinHeight i t := by
  rcases (π.isLeast_pastMinHeight i t).1 with ⟨s, -, hs⟩
  exact hs ▸ π.minHeight_le_height i s

lemma monotone_futureMinHeight : Monotone (π.futureMinHeight i) := by
  intro s u hsu
  rcases (π.isLeast_futureMinHeight i u).1 with ⟨v, hv, hvu⟩
  exact hvu ▸ π.futureMinHeight_le_height_of_le i (hsu.trans hv)

lemma antitone_pastMinHeight : Antitone (π.pastMinHeight i) := by
  intro s u hsu
  rcases (π.isLeast_pastMinHeight i s).1 with ⟨v, hv, hvs⟩
  exact hvs ▸ π.pastMinHeight_le_height_of_le i ((mem_Iic.mp hv).trans hsu)

variable (t) in
lemma lowerCoeff_eq_min : π.lowerCoeff i t = min 1 (π.futureMinHeight i t - π.minHeight i) :=
  max_eq_right (le_min zero_le_one (sub_nonneg.mpr (π.minHeight_le_futureMinHeight i t)))

variable (t) in
lemma raiseCoeff_eq_max : π.raiseCoeff i t = max 0 (π.minHeight i + 1 - π.pastMinHeight i t) := by
  rw [raiseCoeff, min_eq_right]
  linarith [π.minHeight_le_pastMinHeight i t]

variable (t) in
lemma lowerCoeff_nonneg : 0 ≤ π.lowerCoeff i t :=
  le_max_left _ _

variable (t) in
lemma raiseCoeff_nonneg : 0 ≤ π.raiseCoeff i t :=
  le_max_left _ _

variable (t) in
lemma lowerCoeff_le_one : π.lowerCoeff i t ≤ 1 :=
  max_le zero_le_one (min_le_left _ _)

variable (t) in
lemma raiseCoeff_le_one : π.raiseCoeff i t ≤ 1 :=
  max_le zero_le_one (min_le_left _ _)

lemma monotone_lowerCoeff : Monotone (π.lowerCoeff i) :=
  fun _ _ hsu ↦ max_le_max le_rfl <| min_le_min le_rfl <|
    sub_le_sub_right (π.monotone_futureMinHeight i hsu) _

lemma monotone_raiseCoeff : Monotone (π.raiseCoeff i) :=
  fun _ _ hsu ↦ max_le_max le_rfl <| min_le_min le_rfl <|
    sub_le_sub_left (π.antitone_pastMinHeight i hsu) _

lemma ε_straightLinePath : (straightLinePath hx).ε i = -min 0 (P.toLinearMap x (P.coroot i)) := by
  rw [ε, minHeight_straightLinePath]

lemma φ_straightLinePath (h : 0 ≤ P.toLinearMap x (P.coroot i)) :
    (straightLinePath hx).φ i = P.toLinearMap x (P.coroot i) := by
  have h' : (straightLinePath hx).φ i - (straightLinePath hx).ε i =
      P.toLinearMap (straightLinePath hx).wt (P.coroot i) := (straightLinePath hx).φ_sub_ε i
  rwa [ε_straightLinePath, min_eq_left h, neg_zero, sub_zero, wt_straightLinePath] at h'

/-- A Littelmann path `π` has **integral minima** for the root `αᵢ` if every local minimum of its
height function `Hᵢ` on `[0, 1] ∩ ℚ` is an integer. Littelmann's **integral paths** have integral
minima for every simple root. -/
def HasIntegralMinima : Prop :=
  ∀ t, IsLocalMin (π.height i) t → ∃ n : ℤ, π.height i t = n

lemma HasIntegralMinima.exists_minHeight_eq (h : π.HasIntegralMinima i) :
    ∃ n : ℤ, π.minHeight i = n := by
  rcases (π.isLeast_minHeight i).1 with ⟨p, hp⟩
  rcases h p ((isMinOn_univ_iff.mpr fun s ↦ hp ▸ π.minHeight_le_height i s).isLocalMin
    Filter.univ_mem) with ⟨n, hn⟩
  exact ⟨n, hp ▸ hn⟩

variable [P.IsCrystallographic] (hφ : 1 ≤ π.φ i) (hε : 1 ≤ π.ε i)

variable (t) in
lemma sub_lowerCoeff_le_height_lowerPath :
    π.minHeight i - π.lowerCoeff i t ≤ (π.lowerPath i hφ).height i t := by
  have h₀ : π.minHeight i ≤ π.futureMinHeight i t := π.minHeight_le_futureMinHeight i t
  have h₁ : π.futureMinHeight i t ≤ π.height i t := π.futureMinHeight_le_height_of_le i le_rfl
  rw [height_lowerPath, lowerCoeff_eq_min]
  rcases le_total (π.futureMinHeight i t - π.minHeight i) 1 with h | h
  · rw [min_eq_right h]
    linarith
  · rw [min_eq_left h]
    linarith

lemma exists_height_lowerPath_eq (ht : 0 < π.lowerCoeff i t) :
    ∃ s ≤ t, (π.lowerPath i hφ).height i s = π.minHeight i - π.lowerCoeff i t := by
  rcases (π.isLeast_minHeight i).1 with ⟨p, hp⟩
  have hc : π.lowerCoeff i t ≤ π.futureMinHeight i t - π.minHeight i :=
    (π.lowerCoeff_eq_min i t).trans_le (min_le_right _ _)
  have hFt : π.minHeight i < π.futureMinHeight i t := by
    rw [lowerCoeff_eq_min] at ht
    exact sub_pos.mp (lt_min_iff.mp ht).2
  have hpt : p ≤ t :=
    le_of_not_gt fun htp ↦ (π.futureMinHeight_le_height_of_le i htp.le).not_gt (hp ▸ hFt)
  rcases (π.isPiecewiseLinearPath_height i).exists_eq_forall_le_of_le hpt
    (y := π.minHeight i + π.lowerCoeff i t) (by linarith [π.lowerCoeff_nonneg i t])
    (by linarith [π.futureMinHeight_le_height_of_le i (le_refl t)]) with ⟨w, -, hwt, hw, hws⟩
  have hFw : π.futureMinHeight i w = π.minHeight i + π.lowerCoeff i t := by
    refine le_antisymm (hw ▸ π.futureMinHeight_le_height_of_le i le_rfl) ?_
    rcases (π.isLeast_futureMinHeight i w).1 with ⟨v, hv, hvw⟩
    rw [← hvw]
    rcases le_total v t with hvt | htv
    · exact hws v hv hvt
    · linarith [π.futureMinHeight_le_height_of_le i htv]
  refine ⟨w, hwt, ?_⟩
  rw [height_lowerPath, lowerCoeff_eq_min π i w, hFw, add_sub_cancel_left,
    min_eq_right (π.lowerCoeff_le_one i t), hw]
  ring1

variable (t) in
lemma raiseCoeff_lowerPath : (π.lowerPath i hφ).raiseCoeff i t = π.lowerCoeff i t := by
  have hQ : π.minHeight i - π.lowerCoeff i t ≤ (π.lowerPath i hφ).pastMinHeight i t := by
    rcases ((π.lowerPath i hφ).isLeast_pastMinHeight i t).1 with ⟨s, hs, hst⟩
    rw [← hst]
    exact (sub_le_sub_left (π.monotone_lowerCoeff i hs) _).trans
      (π.sub_lowerCoeff_le_height_lowerPath i s hφ)
  rw [raiseCoeff, minHeight_lowerPath, sub_add_cancel]
  rcases (π.lowerCoeff_nonneg i t).lt_or_eq with ht | ht
  · rcases π.exists_height_lowerPath_eq i hφ ht with ⟨s, hst, hs⟩
    have hQ' : (π.lowerPath i hφ).pastMinHeight i t ≤ π.minHeight i - π.lowerCoeff i t :=
      hs ▸ (π.lowerPath i hφ).pastMinHeight_le_height_of_le i hst
    rw [le_antisymm hQ' hQ, sub_sub_cancel, min_eq_right (π.lowerCoeff_le_one i t),
      max_eq_right ht.le]
  · rw [← ht] at hQ ⊢
    exact max_eq_left (min_le_of_right_le (by linarith))

/-- **`eᵢ fᵢ π = π`**: the raising operator `eᵢ` undoes the lowering operator `fᵢ`, a crystal
axiom. -/
lemma raisePath_lowerPath (h : 1 ≤ (π.lowerPath i hφ).ε i) : (π.lowerPath i hφ).raisePath i h = π :=
  LittelmannPath.ext <| funext fun t ↦ (congrArg
    (fun c : ℚ ↦ π.toFun t - π.lowerCoeff i t • P.root i + c • P.root i)
    (π.raiseCoeff_lowerPath i t hφ)).trans (sub_add_cancel _ _)

variable (t) in
lemma add_raiseCoeff_le_height_raisePath :
    π.minHeight i + 1 + π.raiseCoeff i t ≤ (π.raisePath i hε).height i t := by
  have h₀ : π.minHeight i ≤ π.pastMinHeight i t := π.minHeight_le_pastMinHeight i t
  have h₁ : π.pastMinHeight i t ≤ π.height i t := π.pastMinHeight_le_height_of_le i le_rfl
  rw [height_raisePath, raiseCoeff_eq_max]
  rcases le_total (π.minHeight i + 1 - π.pastMinHeight i t) 0 with h | h
  · rw [max_eq_left h]
    linarith
  · rw [max_eq_right h]
    linarith

lemma exists_height_raisePath_eq (ht : π.raiseCoeff i t < 1) :
    ∃ s, t ≤ s ∧ (π.raisePath i hε).height i s = π.minHeight i + 1 + π.raiseCoeff i t := by
  rcases (π.isLeast_minHeight i).1 with ⟨q, hq⟩
  have hd : π.minHeight i + 1 - π.pastMinHeight i t ≤ π.raiseCoeff i t :=
    (le_max_right _ _).trans_eq (π.raiseCoeff_eq_max i t).symm
  have hPt : π.minHeight i < π.pastMinHeight i t := by
    linarith
  have htq : t ≤ q :=
    le_of_not_gt fun hqt ↦ (π.pastMinHeight_le_height_of_le i hqt.le).not_gt (hq ▸ hPt)
  rcases (π.isPiecewiseLinearPath_height i).exists_eq_forall_le_of_ge htq
    (y := π.minHeight i + 1 - π.raiseCoeff i t)
    (by linarith [π.pastMinHeight_le_height_of_le i (le_refl t)]) (by linarith)
    with ⟨w, htw, -, hw, hws⟩
  have hPw : π.pastMinHeight i w = π.minHeight i + 1 - π.raiseCoeff i t := by
    refine le_antisymm (hw ▸ π.pastMinHeight_le_height_of_le i le_rfl) ?_
    rcases (π.isLeast_pastMinHeight i w).1 with ⟨v, hv, hvw⟩
    rw [← hvw]
    rcases le_total t v with htv | hvt
    · exact hws v htv hv
    · linarith [π.pastMinHeight_le_height_of_le i hvt]
  refine ⟨w, htw, ?_⟩
  rw [height_raisePath, raiseCoeff_eq_max π i w, hPw, sub_sub_cancel,
    max_eq_right (π.raiseCoeff_nonneg i t), hw]
  ring1

variable (t) in
lemma lowerCoeff_raisePath : (π.raisePath i hε).lowerCoeff i t = π.raiseCoeff i t := by
  have hF : π.minHeight i + 1 + π.raiseCoeff i t ≤ (π.raisePath i hε).futureMinHeight i t := by
    rcases ((π.raisePath i hε).isLeast_futureMinHeight i t).1 with ⟨s, hs, hst⟩
    rw [← hst]
    linarith [π.monotone_raiseCoeff i hs, π.add_raiseCoeff_le_height_raisePath i s hε]
  rw [lowerCoeff, minHeight_raisePath]
  rcases (π.raiseCoeff_le_one i t).lt_or_eq with ht | ht
  · rcases π.exists_height_raisePath_eq i hε ht with ⟨s, hts, hs⟩
    have hF' : (π.raisePath i hε).futureMinHeight i t ≤ π.minHeight i + 1 + π.raiseCoeff i t :=
      hs ▸ (π.raisePath i hε).futureMinHeight_le_height_of_le i hts
    rw [le_antisymm hF' hF, add_sub_cancel_left, min_eq_right ht.le,
      max_eq_right (π.raiseCoeff_nonneg i t)]
  · rw [ht] at hF ⊢
    rw [min_eq_left (by linarith), max_eq_right zero_le_one]

/-- **`fᵢ eᵢ π = π`**: the lowering operator `fᵢ` undoes the raising operator `eᵢ`, a crystal
axiom. -/
lemma lowerPath_raisePath (h : 1 ≤ (π.raisePath i hε).φ i) : (π.raisePath i hε).lowerPath i h = π :=
  LittelmannPath.ext <| funext fun t ↦ (congrArg
    (fun c : ℚ ↦ π.toFun t + π.raiseCoeff i t • P.root i - c • P.root i)
    (π.lowerCoeff_raisePath i t hε)).trans (add_sub_cancel_right _ _)

/-- **The lowering operator `fᵢ` is Littelmann's reflection** of `π` by `sᵢ` between a time `t₀` at
which `Hᵢ` takes its minimum `mᵢ` and a time `t₁` at which `Hᵢ = mᵢ + 1`, when `Hᵢ` increases from
`t₀` to `t₁` and stays at least `mᵢ + 1` after `t₁`: this is the shape of `Hᵢ` after its last
minimum for Littelmann's integral paths, whose local minima of `Hᵢ` are integers. -/
lemma lowerPath_eq_reflect (h : t₀ ≤ t₁) (h₀ : π.height i t₀ = π.minHeight i)
    (h₁ : π.height i t₁ = π.minHeight i + 1) (hmono : MonotoneOn (π.height i) (Icc t₀ t₁))
    (hge : ∀ s, t₁ ≤ s → π.minHeight i + 1 ≤ π.height i s) :
    π.lowerPath i hφ = π.reflect i h ⟨1, by simp [h₁, h₀]⟩ := by
  have hc (s : Icc (0 : ℚ) 1) :
      π.lowerCoeff i s = π.height i (max t₀ (min s t₁)) - π.height i t₀ := by
    rcases le_total s t₀ with hs₀ | hs₀
    · have hF : π.futureMinHeight i s = π.minHeight i :=
        le_antisymm ((π.futureMinHeight_le_height_of_le i hs₀).trans_eq h₀)
          (π.minHeight_le_futureMinHeight i s)
      rw [lowerCoeff, hF, max_eq_left ((min_le_left s t₁).trans hs₀), sub_self, sub_self,
        min_eq_right zero_le_one, max_self]
    rcases le_total s t₁ with hs₁ | hs₁
    · have hF : π.futureMinHeight i s = π.height i s := by
        refine le_antisymm (π.futureMinHeight_le_height_of_le i le_rfl) ?_
        rcases (π.isLeast_futureMinHeight i s).1 with ⟨u, hu, hus⟩
        rw [← hus]
        rcases le_total u t₁ with hu₁ | hu₁
        · exact hmono ⟨hs₀, hs₁⟩ ⟨hs₀.trans hu, hu₁⟩ hu
        · linarith [hge u hu₁, hmono ⟨hs₀, hs₁⟩ ⟨h, le_rfl⟩ hs₁]
      have hs : π.height i s ≤ π.minHeight i + 1 := h₁ ▸ hmono ⟨hs₀, hs₁⟩ ⟨h, le_rfl⟩ hs₁
      rw [lowerCoeff, hF, min_eq_left hs₁, max_eq_right hs₀, h₀, min_eq_right (by linarith),
        max_eq_right (sub_nonneg.mpr (π.minHeight_le_height i s))]
    · have hF : π.minHeight i + 1 ≤ π.futureMinHeight i s := by
        rcases (π.isLeast_futureMinHeight i s).1 with ⟨u, hu, hus⟩
        exact hus ▸ hge u (hs₁.trans hu)
      rw [lowerCoeff, min_eq_right hs₁, max_eq_right h, h₁, h₀, add_sub_cancel_left,
        min_eq_left (by linarith), max_eq_right zero_le_one]
  refine LittelmannPath.ext <| funext fun s ↦ ?_
  dsimp only [lowerPath, reflect, reflectFun]
  rw [hc s]

/-- **The raising operator `eᵢ` is Littelmann's reflection** of `π` by `sᵢ` between a time `t₀` at
which `Hᵢ = mᵢ + 1` and a time `t₁` at which `Hᵢ` takes its minimum `mᵢ`, when `Hᵢ` is at least
`mᵢ + 1` before `t₀` and decreases from `t₀` to `t₁`: this is the shape of `Hᵢ` before its first
minimum for Littelmann's integral paths. -/
lemma raisePath_eq_reflect (h : t₀ ≤ t₁) (h₀ : π.height i t₀ = π.minHeight i + 1)
    (h₁ : π.height i t₁ = π.minHeight i) (hanti : AntitoneOn (π.height i) (Icc t₀ t₁))
    (hge : ∀ s, s ≤ t₀ → π.minHeight i + 1 ≤ π.height i s) :
    π.raisePath i hε = π.reflect i h ⟨-1, by simp [h₁, h₀]⟩ := by
  have hd (s : Icc (0 : ℚ) 1) :
      π.raiseCoeff i s = π.height i t₀ - π.height i (max t₀ (min s t₁)) := by
    rcases le_total s t₀ with hs₀ | hs₀
    · have hP : π.minHeight i + 1 ≤ π.pastMinHeight i s := by
        rcases (π.isLeast_pastMinHeight i s).1 with ⟨u, hu, hus⟩
        exact hus ▸ hge u ((mem_Iic.mp hu).trans hs₀)
      rw [raiseCoeff, max_eq_left ((min_le_left s t₁).trans hs₀), sub_self,
        min_eq_right (by linarith), max_eq_left (by linarith)]
    rcases le_total s t₁ with hs₁ | hs₁
    · have hP : π.pastMinHeight i s = π.height i s := by
        refine le_antisymm (π.pastMinHeight_le_height_of_le i le_rfl) ?_
        rcases (π.isLeast_pastMinHeight i s).1 with ⟨u, hu, hus⟩
        rw [← hus]
        rcases le_total t₀ u with hu₀ | hu₀
        · exact hanti ⟨hu₀, (mem_Iic.mp hu).trans hs₁⟩ ⟨hs₀, hs₁⟩ (mem_Iic.mp hu)
        · linarith [hge u hu₀, hanti ⟨le_rfl, h⟩ ⟨hs₀, hs₁⟩ hs₀]
      have hs : π.height i s ≤ π.minHeight i + 1 := h₀ ▸ hanti ⟨le_rfl, h⟩ ⟨hs₀, hs₁⟩ hs₀
      rw [raiseCoeff, hP, min_eq_left hs₁, max_eq_right hs₀, h₀,
        min_eq_right (by linarith [π.minHeight_le_height i s]), max_eq_right (by linarith)]
    · have hP : π.pastMinHeight i s = π.minHeight i :=
        le_antisymm ((π.pastMinHeight_le_height_of_le i hs₁).trans_eq h₁)
          (π.minHeight_le_pastMinHeight i s)
      rw [raiseCoeff, hP, min_eq_right hs₁, max_eq_right h, h₀, h₁, add_sub_cancel_left, min_self,
        max_eq_right zero_le_one]
  refine LittelmannPath.ext <| funext fun s ↦ ?_
  dsimp only [raisePath, reflect, reflectFun]
  rw [hd s]
  module

/-- **On integral paths, the lowering operator `fᵢ` is Littelmann's reflection**: if the local
minima of `Hᵢ` are integers and `φᵢ(π) ≥ 1`, then `fᵢ π` is the reflection of `π` by `sᵢ` between
the last time `p` at which `Hᵢ` takes its minimum `mᵢ` and the least time `x` after which
`Hᵢ ≥ mᵢ + 1`, as in Littelmann's definition of `fᵢ`. -/
lemma HasIntegralMinima.exists_lowerPath_eq_reflect (hπ : π.HasIntegralMinima i) :
    ∃ (p x : Icc (0 : ℚ) 1) (h : p ≤ x) (hint : ∃ n : ℤ, π.height i x - π.height i p = n),
      π.height i p = π.minHeight i ∧ (∀ s, p < s → π.minHeight i < π.height i s) ∧
      (∀ s, x ≤ s → π.minHeight i + 1 ≤ π.height i s) ∧
      (∀ s < x, ∃ u, s ≤ u ∧ u < x ∧ π.height i u < π.minHeight i + 1) ∧
      π.lowerPath i hφ = π.reflect i h hint := by
  rcases hπ.exists_minHeight_eq with ⟨k, hk⟩
  rcases (π.isLeast_minHeight i).1 with ⟨p, hp⟩
  have hφ' : π.minHeight i + 1 ≤ π.height i ⊤ := by
    have h' : 1 ≤ π.height i ⊤ - π.minHeight i := hφ
    linarith
  rcases (π.isPiecewiseLinearPath_height i).exists_eq_forall_le_of_lt (t₀ := p)
    (y := π.minHeight i + 1) (by linarith) hφ' with ⟨x, hpx, hx, hxge, hxlt⟩
  rcases (π.isPiecewiseLinearPath_height i).exists_le_forall_lt hpx (y := π.minHeight i) hp.le
    with ⟨q, -, hqx, hq, hqgt⟩
  have hq' : π.height i q = π.minHeight i := le_antisymm hq (π.minHeight_le_height i q)
  have hmono : MonotoneOn (π.height i) (Icc q x) := by
    intro a ha c hc hac
    by_contra hlt
    rw [not_le] at hlt
    have hac' : a < c := lt_of_le_of_ne hac fun h ↦ (h ▸ hlt).false
    have hax : a < x := hac'.trans_le hc.2
    rcases π.isPiecewiseLinearPath with ⟨S, hS⟩
    have hg : IsBreakpointSet (fun v ↦ π.height i (min x v)) (insert x S) :=
      ((π.isBreakpointSet_height i hS).mono (Finset.subset_insert _ _)).comp_min
        (Finset.mem_insert_self x S)
    rcases (hg.isLeast_inf'_max a).1 with ⟨v, hv, hvμ⟩
    have hmin (v' : Icc (0 : ℚ) 1) (hv' : v' ∈ Icc a x) : π.height i (min x v) ≤ π.height i v' := by
      have h' : π.height i (min x v) ≤ π.height i (min x v') :=
        hvμ.trans_le ((hg.isLeast_inf'_max a).2 ⟨v', hv'.1, rfl⟩)
      rwa [min_eq_right hv'.2] at h'
    rcases hxlt a hax with ⟨u', hau', hu'x, hu'⟩
    have hlt₁ : π.height i (min x v) < π.minHeight i + 1 :=
      (hmin u' ⟨hau', hu'x.le⟩).trans_lt hu'
    have hau : a < min x v := lt_of_le_of_ne (le_min hax.le hv) fun h ↦
      ((hmin c ⟨hac, hc.2⟩).trans_lt hlt).ne (congrArg (π.height i) h).symm
    have hux : min x v < x := lt_of_le_of_ne (min_le_left x v) fun h ↦
      hlt₁.ne ((congrArg (π.height i) h).trans hx)
    have hgt : π.minHeight i < π.height i (min x v) := hqgt _ (ha.1.trans_lt hau) hux.le
    rcases hπ (min x v) (IsMinOn.isLocalMin (s := Icc a x) hmin (Icc_mem_nhds hau hux)) with
      ⟨n, hn⟩
    rw [hn, hk] at hgt hlt₁
    have h₁ : k < n := by
      exact_mod_cast hgt
    have h₂ : n < k + 1 := by
      exact_mod_cast hlt₁
    omega
  refine ⟨q, x, hqx, ⟨1, by simp [hx, hq']⟩, hq', fun s hs ↦ ?_, hxge, hxlt,
    π.lowerPath_eq_reflect i hφ hqx hq' hx hmono hxge⟩
  rcases le_total s x with hsx | hxs
  · exact hqgt s hs hsx
  · linarith [hxge s hxs]

/-- **On integral paths, the raising operator `eᵢ` is Littelmann's reflection**: if the local
minima of `Hᵢ` are integers and `εᵢ(π) ≥ 1`, then `eᵢ π` is the reflection of `π` by `sᵢ` between
the greatest time `x` before which `Hᵢ ≥ mᵢ + 1` and the first time `q` at which `Hᵢ` takes its
minimum `mᵢ`, as in Littelmann's definition of `eᵢ`. -/
lemma HasIntegralMinima.exists_raisePath_eq_reflect (hπ : π.HasIntegralMinima i) :
    ∃ (x q : Icc (0 : ℚ) 1) (h : x ≤ q) (hint : ∃ n : ℤ, π.height i q - π.height i x = n),
      π.height i q = π.minHeight i ∧ (∀ s < q, π.minHeight i < π.height i s) ∧
      (∀ s, s ≤ x → π.minHeight i + 1 ≤ π.height i s) ∧
      (∀ s, x < s → ∃ u, x < u ∧ u ≤ s ∧ π.height i u < π.minHeight i + 1) ∧
      π.raisePath i hε = π.reflect i h hint := by
  rcases hπ.exists_minHeight_eq with ⟨k, hk⟩
  rcases (π.isLeast_minHeight i).1 with ⟨p, hp⟩
  have hε' : π.minHeight i + 1 ≤ π.height i ⊥ := by
    have h' : 1 ≤ -π.minHeight i := hε
    have h₀ : π.height i ⊥ = 0 := by
      rw [height, π.toFun_bot, map_zero, LinearMap.zero_apply]
    linarith
  rcases (π.isPiecewiseLinearPath_height i).exists_eq_forall_le_of_lt' (t₁ := p)
    (y := π.minHeight i + 1) hε' (by linarith) with ⟨x, hxp, hx, hxge, hxlt⟩
  rcases (π.isPiecewiseLinearPath_height i).exists_le_forall_lt' hxp (y := π.minHeight i) hp.le
    with ⟨q, hxq, -, hq, hqgt⟩
  have hq' : π.height i q = π.minHeight i := le_antisymm hq (π.minHeight_le_height i q)
  have hanti : AntitoneOn (π.height i) (Icc x q) := by
    intro a ha c hc hac
    by_contra hlt
    rw [not_le] at hlt
    have hac' : a < c := lt_of_le_of_ne hac fun h ↦ (h ▸ hlt).false
    have hxc : x < c := ha.1.trans_lt hac'
    rcases π.isPiecewiseLinearPath with ⟨S, hS⟩
    have hg : IsBreakpointSet (fun v ↦ π.height i (min c v)) (insert c S) :=
      ((π.isBreakpointSet_height i hS).mono (Finset.subset_insert _ _)).comp_min
        (Finset.mem_insert_self c S)
    rcases (hg.isLeast_inf'_max x).1 with ⟨v, hv, hvμ⟩
    have hmin (v' : Icc (0 : ℚ) 1) (hv' : v' ∈ Icc x c) : π.height i (min c v) ≤ π.height i v' := by
      have h' : π.height i (min c v) ≤ π.height i (min c v') :=
        hvμ.trans_le ((hg.isLeast_inf'_max x).2 ⟨v', hv'.1, rfl⟩)
      rwa [min_eq_right hv'.2] at h'
    rcases hxlt c hxc with ⟨u', hxu', hu'c, hu'⟩
    have hlt₁ : π.height i (min c v) < π.minHeight i + 1 :=
      (hmin u' ⟨hxu'.le, hu'c⟩).trans_lt hu'
    have hxu : x < min c v := lt_of_le_of_ne (le_min hxc.le hv) fun h ↦
      hlt₁.ne ((congrArg (π.height i) h).symm.trans hx)
    have huc : min c v < c := lt_of_le_of_ne (min_le_left c v) fun h ↦
      ((hmin a ⟨ha.1, hac⟩).trans_lt hlt).ne (congrArg (π.height i) h)
    have hgt : π.minHeight i < π.height i (min c v) := hqgt _ hxu.le (huc.trans_le hc.2)
    rcases hπ (min c v) (IsMinOn.isLocalMin (s := Icc x c) hmin (Icc_mem_nhds hxu huc)) with
      ⟨n, hn⟩
    rw [hn, hk] at hgt hlt₁
    have h₁ : k < n := by
      exact_mod_cast hgt
    have h₂ : n < k + 1 := by
      exact_mod_cast hlt₁
    omega
  refine ⟨x, q, hxq, ⟨-1, by simp [hq', hx]⟩, hq', fun s hs ↦ ?_, hxge, hxlt,
    π.raisePath_eq_reflect i hε hxq hx hq' hanti hxge⟩
  rcases le_total x s with hxs | hsx
  · exact hqgt s hxs hs
  · linarith [hxge s hsx]

lemma lower_eq_some_iff_exists : π.lower i = some π' ↔ ∃ hφ : 1 ≤ π.φ i, π.lowerPath i hφ = π' := by
  simp only [lower, Option.dite_none_right_eq_some, Option.some_inj]

lemma raise_eq_some_iff_exists : π.raise i = some π' ↔ ∃ hε : 1 ≤ π.ε i, π.raisePath i hε = π' := by
  simp only [raise, Option.dite_none_right_eq_some, Option.some_inj]

lemma lower_eq_none_iff : π.lower i = none ↔ π.φ i < 1 := by
  simp [lower]

lemma raise_eq_none_iff : π.raise i = none ↔ π.ε i < 1 := by
  simp [raise]

/-- **`fᵢ π = π'` if and only if `eᵢ π' = π`**, Kashiwara's crystal axiom for the root operators on
Littelmann paths (LMFDB `crystals.littelmann_path`). -/
lemma lower_eq_some_iff : π.lower i = some π' ↔ π'.raise i = some π := by
  rw [lower_eq_some_iff_exists, raise_eq_some_iff_exists]
  constructor
  · rintro ⟨hφ, rfl⟩
    exact ⟨by linarith [π.ε_lowerPath i hφ, π.ε_nonneg i], π.raisePath_lowerPath i hφ _⟩
  · rintro ⟨hε, rfl⟩
    exact ⟨by linarith [π'.φ_raisePath i hε, π'.φ_nonneg i], π'.lowerPath_raisePath i hε _⟩

lemma wt_of_lower_eq_some (h : π.lower i = some π') : π'.wt = π.wt - P.root i := by
  rcases (π.lower_eq_some_iff_exists i).mp h with ⟨hφ, rfl⟩
  exact π.wt_lowerPath i hφ

lemma wt_of_raise_eq_some (h : π.raise i = some π') : π'.wt = π.wt + P.root i := by
  rcases (π.raise_eq_some_iff_exists i).mp h with ⟨hε, rfl⟩
  exact π.wt_raisePath i hε

lemma ε_of_raise_eq_some (h : π.raise i = some π') : π'.ε i = π.ε i - 1 := by
  rcases (π.raise_eq_some_iff_exists i).mp h with ⟨hε, rfl⟩
  exact π.ε_raisePath i hε

lemma iterate_raise_ne_none_iff (k : ℕ) :
    (fun o : Option P.LittelmannPath ↦ o.bind (raise · i))^[k] (some π) ≠ none ↔ k ≤ π.ε i := by
  induction k generalizing π with
  | zero => simpa using π.ε_nonneg i
  | succ k ih =>
    rw [Function.iterate_succ_apply, Option.bind_some, Nat.cast_succ]
    rcases le_or_gt 1 (π.ε i) with hε | hε
    · rw [(π.raise_eq_some_iff_exists i).mpr ⟨hε, rfl⟩, ih, ε_raisePath]
      constructor <;> intro h <;> linarith
    · rw [(π.raise_eq_none_iff i).mpr hε, Function.iterate_fixed rfl]
      simp only [ne_eq, not_true_eq_false, false_iff]
      linarith [(Nat.cast_nonneg k : (0 : ℚ) ≤ k)]

lemma iterate_lower_ne_none_iff (k : ℕ) :
    (fun o : Option P.LittelmannPath ↦ o.bind (lower · i))^[k] (some π) ≠ none ↔ k ≤ π.φ i := by
  induction k generalizing π with
  | zero => simpa using π.φ_nonneg i
  | succ k ih =>
    rw [Function.iterate_succ_apply, Option.bind_some, Nat.cast_succ]
    rcases le_or_gt 1 (π.φ i) with hφ | hφ
    · rw [(π.lower_eq_some_iff_exists i).mpr ⟨hφ, rfl⟩, ih, φ_lowerPath]
      constructor <;> intro h <;> linarith
    · rw [(π.lower_eq_none_iff i).mpr hφ, Function.iterate_fixed rfl]
      simp only [ne_eq, not_true_eq_false, false_iff]
      linarith [(Nat.cast_nonneg k : (0 : ℚ) ≤ k)]

/-- The **crystal of Littelmann paths** (LMFDB `crystals.littelmann_path`) for a base `b` of the
root pairing: the Littelmann paths with the weight `wt(π) = π(1)`, Littelmann's root operators `eᵢ`
and `fᵢ` for the simple roots `αᵢ`, and the integer parts `⌊εᵢ(π)⌋` and `⌊φᵢ(π)⌋` of
`εᵢ(π) = -mᵢ` and `φᵢ(π) = Hᵢ(1) - mᵢ`, which are the numbers of times `eᵢ` and `fᵢ` can be applied
to `π`. For Littelmann's integral paths, whose local minima of `Hᵢ` are integers, `εᵢ(π)` and
`φᵢ(π)` are integers. -/
@[simps]
noncomputable def crystal : b.Crystal P.LittelmannPath where
  wt := wt
  ε j π := ⌊π.ε j⌋
  φ j π := ⌊π.φ j⌋
  e j π := π.raise j
  f j π := π.lower j
  nonempty := ⟨straightLinePath (x := 0) fun _ ↦ ⟨0, by simp⟩⟩
  isIntegralWeight_wt π := π.isIntegralWeight_one
  φ_eq j π := by
    rcases π.isIntegralWeight_one j with ⟨n, hn⟩
    have h : π.φ j = π.ε j + n := by
      rw [← hn]
      exact eq_add_of_sub_eq' (π.φ_sub_ε j)
    rw [h, Int.floor_add_intCast, Int.cast_add, ← hn]
    rfl
  f_eq_some_iff j π _ := π.lower_eq_some_iff j
  wt_of_e_eq_some j π _ h := π.wt_of_raise_eq_some j h
  ε_of_e_eq_some j π _ h := by
    rw [π.ε_of_raise_eq_some j h, Int.floor_sub_one]

/-- **On integral paths, the crystal data are Littelmann's `εᵢ(π) = -mᵢ`**: if `π` has integral
minima for a simple root `αᵢ`, then `εᵢ(π)` is an integer, the datum `εᵢ` of the crystal of
Littelmann paths. -/
lemma HasIntegralMinima.crystal_ε_eq (h : π.HasIntegralMinima j) :
    ((crystal b).ε j π : ℚ) = π.ε j := by
  rcases h.exists_minHeight_eq with ⟨n, hn⟩
  rw [crystal_ε, ε, hn, ← Int.cast_neg, Int.floor_intCast]

/-- **On integral paths, the crystal data are Littelmann's `φᵢ(π) = Hᵢ(1) - mᵢ`**: if `π` has
integral minima for a simple root `αᵢ`, then `φᵢ(π)` is an integer, the datum `φᵢ` of the crystal of
Littelmann paths. -/
lemma HasIntegralMinima.crystal_φ_eq (h : π.HasIntegralMinima j) :
    ((crystal b).φ j π : ℚ) = π.φ j := by
  have hφ : ((crystal b).φ j π : ℚ) = (crystal b).ε j π + P.toLinearMap π.wt (P.coroot j) :=
    (crystal b).φ_eq j π
  rw [hφ, h.crystal_ε_eq, ← π.φ_sub_ε j, add_sub_cancel]

/-- **The crystal of Littelmann paths is seminormal**: `eᵢᵏ π ≠ 0` if and only if `k ≤ εᵢ(π)`, and
`fᵢᵏ π ≠ 0` if and only if `k ≤ φᵢ(π)`. -/
lemma isSeminormal_crystal : (crystal b).IsSeminormal := by
  intro j π k
  rw [crystal_ε, crystal_φ, Int.le_floor, Int.le_floor, Int.cast_natCast]
  exact ⟨π.iterate_raise_ne_none_iff j k, π.iterate_lower_ne_none_iff j k⟩

/-- The **crystal `B(π)` generated by a Littelmann path** `π` (LMFDB `crystals.littelmann_path`),
for a base `b` of the root pairing: the set of the paths `f_{i₁} ⋯ f_{iₖ} π` obtained from `π` by
the lowering operators of the simple roots. For the straight-line path `π_λ` to a dominant integral
weight `λ`, Littelmann's theorem identifies it with the highest weight crystal `B(λ)`. -/
def lowerClosure : Set P.LittelmannPath :=
  {π' | ReflTransGen (fun π₁ π₂ : P.LittelmannPath ↦ ∃ j ∈ b.support, π₁.lower j = some π₂) π π'}

lemma mem_lowerClosure_self : π ∈ π.lowerClosure b :=
  ReflTransGen.refl

lemma mem_lowerClosure_of_lower_eq_some (h : π' ∈ π.lowerClosure b) {π'' : P.LittelmannPath}
    (hi : i ∈ b.support) (h' : π'.lower i = some π'') : π'' ∈ π.lowerClosure b :=
  ReflTransGen.tail h ⟨i, hi, h'⟩

/-- **The weights of `B(π)` lie in `wt(π) - Q₊`**: the weight of a path of `B(π)` is `wt(π)` minus
a sum of simple roots. -/
lemma sub_wt_mem_closure (h : π' ∈ π.lowerClosure b) :
    π.wt - π'.wt ∈ AddSubmonoid.closure (P.root '' b.support) := by
  induction h with
  | refl => exact sub_self π.wt ▸ zero_mem _
  | tail _ hr ih =>
    rcases hr with ⟨j, hj, hl⟩
    rw [wt_of_lower_eq_some _ j hl, ← sub_add]
    exact add_mem ih (AddSubmonoid.subset_closure (mem_image_of_mem P.root hj))

variable [P.IsRootSystem] in
/-- **`π` is the only path of weight `wt(π)` in `B(π)`**: the weights of the other paths of `B(π)`
are `wt(π)` minus a nonzero sum of simple roots. -/
lemma eq_of_mem_lowerClosure_of_wt_eq (h : π' ∈ π.lowerClosure b) (hwt : π'.wt = π.wt) :
    π' = π := by
  have hg (z : M) (hz : z ∈ AddSubmonoid.closure (P.root '' b.support)) :
      0 ≤ b.toWeightBasis.sumCoords z := by
    induction hz using AddSubmonoid.closure_induction with
    | mem z hz =>
      rcases hz with ⟨j, hj, rfl⟩
      rw [← b.toWeightBasis_apply ⟨j, hj⟩, Basis.sumCoords_self_apply]
      exact zero_le_one
    | zero => rw [map_zero]
    | add z z' _ _ hz hz' =>
      rw [map_add]
      exact add_nonneg hz hz'
  rcases ReflTransGen.cases_tail h with h | ⟨c, hc, j, hj, hl⟩
  · exact h
  · have h₁ : π.wt - π'.wt = π.wt - c.wt + P.root j := by
      rw [c.wt_of_lower_eq_some j hl, sub_add]
    have h₂ : b.toWeightBasis.sumCoords (P.root j) = 1 := by
      rw [← b.toWeightBasis_apply ⟨j, hj⟩, Basis.sumCoords_self_apply]
    have h₃ : 0 ≤ b.toWeightBasis.sumCoords (π.wt - c.wt) := hg _ (π.sub_wt_mem_closure b hc)
    rw [hwt, sub_self] at h₁
    have h₄ : b.toWeightBasis.sumCoords 0 = b.toWeightBasis.sumCoords (π.wt - c.wt + P.root j) :=
      congrArg b.toWeightBasis.sumCoords h₁
    rw [map_zero, map_add, h₂] at h₄
    linarith

/-- **`π` is the only possible highest weight element of `B(π)`**: every other path of `B(π)` is
`fⱼ` of a path for a simple root `αⱼ`, so `eⱼ` does not vanish on it. -/
lemma not_isHighestWeight_of_mem_lowerClosure (h : π' ∈ π.lowerClosure b) (hne : π' ≠ π) :
    ¬(crystal b).IsHighestWeight π' := by
  rcases ReflTransGen.cases_tail h with h | ⟨c, -, j, hj, hc⟩
  · exact absurd h hne
  · exact fun h' ↦ Option.some_ne_none c (((c.lower_eq_some_iff j).mp hc).symm.trans (h' ⟨j, hj⟩))

lemma raise_straightLinePath (h : 0 ≤ P.toLinearMap x (P.coroot i)) :
    (straightLinePath hx).raise i = none :=
  ((straightLinePath hx).raise_eq_none_iff i).mpr <| by
    rw [ε_straightLinePath, min_eq_left h, neg_zero]
    exact zero_lt_one

lemma isHighestWeight_straightLinePath (hdom : ∀ j ∈ b.support, 0 ≤ P.toLinearMap x (P.coroot j)) :
    (crystal b).IsHighestWeight (straightLinePath hx) :=
  fun j ↦ (crystal_e b j _).trans (raise_straightLinePath j.1 hx (hdom j.1 j.2))

/-- **The straight-line path `π_λ` is the unique highest weight element of `B(π_λ)`**: for a
dominant integral weight `λ`, a path of `B(π_λ)` is a highest weight element of the crystal of
Littelmann paths if and only if it is `π_λ`. -/
lemma isHighestWeight_iff_eq_straightLinePath
    (hdom : ∀ j ∈ b.support, 0 ≤ P.toLinearMap x (P.coroot j))
    (h : π ∈ (straightLinePath hx).lowerClosure b) :
    (crystal b).IsHighestWeight π ↔ π = straightLinePath hx :=
  ⟨fun hπ ↦ by_contra fun hne ↦
    (straightLinePath hx).not_isHighestWeight_of_mem_lowerClosure b h hne hπ,
    fun hπ ↦ hπ ▸ isHighestWeight_straightLinePath b hx hdom⟩

/-- **The `i`-string of `π_λ` has length `⟨λ, αᵢ^∨⟩`**: for an integral weight `λ` with
`⟨λ, αᵢ^∨⟩ ≥ 0`, `fᵢᵏ π_λ ≠ 0` if and only if `k ≤ ⟨λ, αᵢ^∨⟩`, as in the highest weight crystal
`B(λ)`. -/
lemma iterate_lower_straightLinePath_ne_none_iff (h : 0 ≤ P.toLinearMap x (P.coroot i)) (k : ℕ) :
    (fun o : Option P.LittelmannPath ↦ o.bind (lower · i))^[k] (some (straightLinePath hx)) ≠ none ↔
      k ≤ P.toLinearMap x (P.coroot i) := by
  rw [iterate_lower_ne_none_iff, φ_straightLinePath i hx h]

end LittelmannPath

end RootPairing
