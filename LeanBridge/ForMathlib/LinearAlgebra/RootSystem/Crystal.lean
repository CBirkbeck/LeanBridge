import LeanBridge.ForMathlib.LinearAlgebra.RootSystem.LittelmannPath
import Mathlib.LinearAlgebra.RootSystem.Base

/-!
# Crystals

Kashiwara's crystals for a base `b` of a root pairing `P` over `ℚ`, whose simple roots `αᵢ` are
indexed by `b.support`, with weights in the integral weights of the weight space `M`. A crystal is
a nonempty type `B` with a weight map `wt : B → M`, Kashiwara's raising and lowering operators
`eᵢ, fᵢ : B → B ∪ {0}` and maps `εᵢ, φᵢ : B → ℤ` satisfying Kashiwara's axioms. It is seminormal
when `εᵢ(x)` and `φᵢ(x)` count how many times `eᵢ` and `fᵢ` can be applied to `x`, and an element
is a highest weight element when every raising operator vanishes on it. A highest weight crystal of
highest weight `μ` is generated by the lowering operators from a highest weight element of weight
`μ`; every highest weight element has weight `μ`, which labels the crystal.

## Main definitions

* `RootPairing.Base.Crystal` (LMFDB `crystals.crystal`): crystals.
* `RootPairing.Base.Crystal.IsSeminormal`: seminormal crystals.
* `RootPairing.Base.Crystal.IsHighestWeight` (LMFDB `crystals.highest_weight`): highest weight
  elements.
* `RootPairing.Base.Crystal.IsHighestWeightCrystal` (LMFDB `crystals.highest_weight`): highest
  weight crystals.

## Main results

* `RootPairing.Base.Crystal.IsHighestWeightCrystal.wt_eq`: every highest weight element of a
  highest weight crystal of highest weight `μ` has weight `μ`, so `μ` labels the crystal.
-/

open Relation

namespace RootPairing.Base

variable {ι M N : Type*} [AddCommGroup M] [Module ℚ M] [AddCommGroup N] [Module ℚ N]
  {P : RootPairing ι ℚ M N} (b : P.Base) (B : Type*)

/-- A **crystal** (LMFDB `crystals.crystal`, after Kashiwara) for a base `b` of a root pairing `P`
over `ℚ`: a nonempty type `B` with a **weight map** `wt : B → M` to the integral weights and, for
every simple root `αᵢ`, the **Kashiwara raising and lowering operators** `eᵢ, fᵢ : B → B ∪ {0}`
(`none` standing for `0`) and maps `εᵢ, φᵢ : B → ℤ`, such that `φᵢ(x) = εᵢ(x) + ⟨wt(x), αᵢ^∨⟩`,
`fᵢ x = y` if and only if `eᵢ y = x`, and `eᵢ` raises the weight by `αᵢ` and lowers `εᵢ` by one.
Then `eᵢ` raises `φᵢ` by one and `fᵢ` lowers the weight by `αᵢ`, raises `εᵢ` and lowers `φᵢ` by
one, Kashiwara's other axioms. Kashiwara also allows the value `-∞` for `εᵢ` and `φᵢ` (with
`eᵢ x = fᵢ x = 0` when `φᵢ(x) = -∞`), which is excluded here: it occurs neither in the crystals of
integrable modules nor in `B(∞)`, only in auxiliary crystals such as `T_λ`. The LMFDB lists only
the data `wt`, `eᵢ` and `fᵢ`. -/
structure Crystal where
  /-- The weight map `wt : B → M`. -/
  wt : B → M
  /-- The maps `εᵢ : B → ℤ`. -/
  ε : b.support → B → ℤ
  /-- The maps `φᵢ : B → ℤ`. -/
  φ : b.support → B → ℤ
  /-- The raising operators `eᵢ : B → B ∪ {0}`. -/
  e : b.support → B → Option B
  /-- The lowering operators `fᵢ : B → B ∪ {0}`. -/
  f : b.support → B → Option B
  nonempty : Nonempty B
  isIntegralWeight_wt (x : B) : P.IsIntegralWeight (wt x)
  φ_eq (i : b.support) (x : B) : (φ i x : ℚ) = ε i x + P.toLinearMap (wt x) (P.coroot i)
  f_eq_some_iff (i : b.support) (x y : B) : f i x = some y ↔ e i y = some x
  wt_of_e_eq_some (i : b.support) {x y : B} : e i x = some y → wt y = wt x + P.root i
  ε_of_e_eq_some (i : b.support) {x y : B} : e i x = some y → ε i y = ε i x - 1

namespace Crystal

variable {b B} (C : b.Crystal B) (i : b.support) {x y : B}

lemma φ_of_e_eq_some (h : C.e i x = some y) : C.φ i y = C.φ i x + 1 := by
  have hx : (C.φ i x : ℚ) = C.ε i x + P.toLinearMap (C.wt x) (P.coroot i) := C.φ_eq i x
  have hy : (C.φ i y : ℚ) = C.ε i y + P.toLinearMap (C.wt y) (P.coroot i) := C.φ_eq i y
  rw [C.wt_of_e_eq_some i h, C.ε_of_e_eq_some i h, map_add, LinearMap.add_apply,
    P.root_coroot_two, Int.cast_sub, Int.cast_one] at hy
  exact_mod_cast (by linarith : (C.φ i y : ℚ) = C.φ i x + 1)

lemma wt_of_f_eq_some (h : C.f i x = some y) : C.wt y = C.wt x - P.root i :=
  eq_sub_of_add_eq (C.wt_of_e_eq_some i ((C.f_eq_some_iff i x y).mp h)).symm

lemma ε_of_f_eq_some (h : C.f i x = some y) : C.ε i y = C.ε i x + 1 :=
  eq_add_of_sub_eq (C.ε_of_e_eq_some i ((C.f_eq_some_iff i x y).mp h)).symm

lemma φ_of_f_eq_some (h : C.f i x = some y) : C.φ i y = C.φ i x - 1 :=
  eq_sub_of_add_eq (C.φ_of_e_eq_some i ((C.f_eq_some_iff i x y).mp h)).symm

/-- A crystal is **seminormal** if `εᵢ(x)` and `φᵢ(x)` are the numbers of times the operators `eᵢ`
and `fᵢ` can be applied to `x`: `eᵢᵏ x ≠ 0` if and only if `k ≤ εᵢ(x)`, and `fᵢᵏ x ≠ 0` if and only
if `k ≤ φᵢ(x)`. The crystals of integrable modules are seminormal. -/
def IsSeminormal : Prop :=
  ∀ i x (k : ℕ), ((fun o : Option B ↦ o.bind (C.e i))^[k] (some x) ≠ none ↔ (k : ℤ) ≤ C.ε i x) ∧
    ((fun o : Option B ↦ o.bind (C.f i))^[k] (some x) ≠ none ↔ (k : ℤ) ≤ C.φ i x)

variable (x) in
/-- An element `x` of a crystal is a **highest weight element** (LMFDB `crystals.highest_weight`)
if every raising operator vanishes on it: `eᵢ x = 0` for every simple root `αᵢ`. -/
def IsHighestWeight : Prop :=
  ∀ j, C.e j x = none

/-- A crystal is a **highest weight crystal** of highest weight `μ` (LMFDB
`crystals.highest_weight`) if it has a highest weight element `u` of weight `μ` from which every
element is obtained by the lowering operators: `x = f_{i₁} ⋯ f_{iₖ} u`. Every highest weight element
then has weight `μ` (`RootPairing.Base.Crystal.IsHighestWeightCrystal.wt_eq`), the weight that
labels the crystal. -/
def IsHighestWeightCrystal (μ : M) : Prop :=
  ∃ u, C.IsHighestWeight u ∧ C.wt u = μ ∧ ∀ x, ReflTransGen (fun y z ↦ ∃ j, C.f j y = some z) u x

/-- **Every highest weight element of a highest weight crystal of highest weight `μ` has weight
`μ`**: it is the element generating the crystal, so the weight `μ` labelling the crystal is well
defined. -/
lemma IsHighestWeightCrystal.wt_eq {μ : M} (h : C.IsHighestWeightCrystal μ)
    (hx : C.IsHighestWeight x) : C.wt x = μ := by
  rcases h with ⟨u, -, rfl, hu⟩
  rcases (hu x).cases_tail with rfl | ⟨y, -, j, hj⟩
  · rfl
  · exact (Option.some_ne_none y (((C.f_eq_some_iff j y x).mp hj).symm.trans (hx j))).elim

end Crystal

end RootPairing.Base
