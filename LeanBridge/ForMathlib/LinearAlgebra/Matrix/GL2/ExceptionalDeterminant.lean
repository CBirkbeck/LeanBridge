import Mathlib.NumberTheory.LegendreSymbol.QuadraticChar.Basic
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.Exceptional

/-!
# The determinant on exceptional subgroups of type `A4` and `A5`

The quadratic character of the determinant is a homomorphism `GL₂(𝔽_p) → {±1}` that is trivial on
the scalars, so it factors through `PGL₂(𝔽_p)`. An alternating group has no nontrivial
homomorphism to `{±1}`, being generated by its `3`-cycles; so on a subgroup `H` of `GL₂(𝔽_p)` whose
image in `PGL₂(𝔽_p)` is isomorphic to `A₄` or `A₅`, the determinant takes only square values. For
`p` odd not every element of `𝔽_pˣ` is a square, so the determinant of such an `H` is not
surjective; for `p = 2` the group `PGL₂(𝔽₂)` has order `6`, too small to contain `A₄` or `A₅`. So
the exceptional types `A4` and `A5` of Sutherland's labels (LMFDB `ec.galois_rep_modell_image`)
cannot occur for subgroups with surjective determinant, which is why they cannot occur for mod-`ℓ`
images of elliptic curves over `ℚ`.

## Main results

* `Matrix.GeneralLinearGroup.quadraticChar_det_eq_one_of_mulEquiv`: on a subgroup of `GL₂(𝔽_p)`
  whose image in `PGL₂(𝔽_p)` is isomorphic to an alternating group, the determinant takes only
  square values.
* `Matrix.GeneralLinearGroup.eq_S4_of_hasExceptionalType` (LMFDB `ec.galois_rep_modell_image`):
  an exceptional type of a subgroup of `GL₂(𝔽_p)` with surjective determinant is `S4`.
-/

open Matrix

variable {α : Type*} [Fintype α] [DecidableEq α]

lemma alternatingGroup.monoidHom_intUnits_eq_one (f : alternatingGroup α →* ℤˣ) : f = 1 :=
  MonoidHom.eq_of_eqOn_dense alternatingGroup.closure_isThreeCycles_eq_top fun g hg ↦ by
    have h3 : f g ^ 3 = 1 := by
      rw [← map_pow, ← hg.orderOf, Subgroup.orderOf_coe, pow_orderOf_eq_one, map_one]
    rwa [pow_succ, Int.units_sq, one_mul, ← MonoidHom.one_apply g] at h3

namespace Matrix.GeneralLinearGroup

variable {p : ℕ} [Fact p.Prime] {H : Subgroup (GL (Fin 2) (ZMod p))}

/-- **On a subgroup of `GL₂(𝔽_p)` whose image in `PGL₂(𝔽_p)` is an alternating group, the
determinant takes only square values**: its quadratic character is `1`. -/
lemma quadraticChar_det_eq_one_of_mulEquiv (e : projectiveImage H ≃* alternatingGroup α)
    {h : GL (Fin 2) (ZMod p)} (hh : h ∈ H) : quadraticChar (ZMod p) (det h : ZMod p) = 1 := by
  let χ : GL (Fin 2) (ZMod p) →* ℤˣ := (quadraticChar (ZMod p)).toUnitHom.comp det
  have hχ : Subgroup.center (GL (Fin 2) (ZMod p)) ≤ χ.ker := by
    rw [center_eq_range_scalar]
    rintro - ⟨u, rfl⟩
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, det_scalar, map_pow, Fintype.card_fin,
      Int.units_sq]
  let f : projectiveImage H →* ℤˣ := (QuotientGroup.lift _ χ hχ).comp (projectiveImage H).subtype
  have hf : f ⟨ProjGenLinGroup.mk h, Subgroup.mem_map_of_mem _ hh⟩ = 1 := by
    rw [← e.symm_apply_apply ⟨ProjGenLinGroup.mk h, Subgroup.mem_map_of_mem _ hh⟩]
    exact DFunLike.congr_fun (alternatingGroup.monoidHom_intUnits_eq_one
      (f.comp e.symm.toMonoidHom)) _
  exact congrArg Units.val hf

/-- **The exceptional types `A4` and `A5` do not occur with surjective determinant** (LMFDB
`ec.galois_rep_modell_image`): if the determinant maps a subgroup `H` of `GL₂(𝔽_p)` onto `𝔽_pˣ`
and the image of `H` in `PGL₂(𝔽_p)` has exceptional type `t`, then `t` is `S4`. For `p` odd the
determinant on `H` would otherwise take only square values; for `p = 2` the order `6` of
`PGL₂(𝔽₂)` leaves no room for `A₄` or `A₅`. -/
lemma eq_S4_of_hasExceptionalType (hdet : H.map det = ⊤) {t : ExceptionalType}
    (ht : HasExceptionalType H t) : t = .S4 := by
  cases t
  case S4 => rfl
  all_goals
    rcases ht with ⟨e⟩
    rcases eq_or_ne p 2 with rfl | hp
    · have h6 : Nat.card (projectiveImage H) ≤ 6 :=
        (Nat.le_of_dvd Nat.card_pos (H.card_map_dvd ProjGenLinGroup.mk)).trans <|
          H.card_le_card_group.trans_eq <| by
            rw [card_GL_field, Fin.prod_univ_two, ZMod.card]
            rfl
      rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup, Nat.card_fin] at h6
      exact absurd h6 (by decide)
    rcases quadraticChar_exists_neg_one' (F := ZMod p) (by rwa [ZMod.ringChar_zmod_n]) with ⟨u, hu⟩
    rcases (hdet ▸ Subgroup.mem_top u : u ∈ H.map det) with ⟨h, hh, rfl⟩
    rw [quadraticChar_det_eq_one_of_mulEquiv e hh] at hu
    exact absurd hu (by decide)

end Matrix.GeneralLinearGroup
