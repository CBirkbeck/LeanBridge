import Mathlib.RingTheory.Etale.Pi
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.CartanNormalizer
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.LeastPrimitiveRoot
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Diagonal.Normalizer

/-!
# The split Cartan subgroup `Cs` and its normalizer `Ns`

The LMFDB names subgroups of `GL₂(𝔽_p)` by Sutherland's labels. The split Cartan subgroup `Cs` is
the group of diagonal matrices, Tau Ceti's `TauCeti.diagonalTorus (ZMod p) 2`: it is the Cartan
subgroup of the split algebra `𝔽_p × 𝔽_p` in its standard basis. The group `Ns` is generated by
`Cs` and the matrix `!![0, 1; 1, 0]`, the matrix of the canonical involution of `𝔽_p × 𝔽_p`, so
`Ns` is the extended Cartan subgroup of that algebra: for `p > 2` it is the normalizer of `Cs`,
and for `p = 2`, where `Cs` is trivial, it contains `Cs` with index `2`. The labels `Cs.a.b`,
`Ns.a.b` and `Ns.a.b.c` name the subgroups generated by explicit matrices, normalised by the least
primitive root `r` modulo `p`; the choice of `a`, `b`, `c` minimal among those giving the same
subgroup is a labelling convention, not part of the definitions.

## Main definitions

* `Matrix.GeneralLinearGroup.swapGL`: the matrix `!![0, 1; 1, 0]`.
* `Matrix.GeneralLinearGroup.labelNs` (LMFDB `gl2.normalizer_split_cartan`): the group `Ns`.
* `Matrix.GeneralLinearGroup.labelCsAB` (LMFDB `gl2.split_cartan`): the group `Cs.a.b`.
* `Matrix.GeneralLinearGroup.labelNsAB` and `Matrix.GeneralLinearGroup.labelNsABC` (LMFDB
  `gl2.normalizer_split_cartan`): the groups `Ns.a.b` and `Ns.a.b.c`.

## Main results

* `Matrix.GeneralLinearGroup.cartanSubgroup_piBasisFun`: the Cartan subgroup of `R × R` in its
  standard basis is the group of invertible diagonal matrices.
* `Matrix.GeneralLinearGroup.isSplitCartanSubgroup_diagonalTorus`: `Cs` is a split Cartan
  subgroup.
* `Matrix.GeneralLinearGroup.labelNs_eq_extendedCartanSubgroup`: `Ns` is the extended Cartan
  subgroup of `𝔽_p × 𝔽_p`.
* `Matrix.GeneralLinearGroup.relIndex_diagonalTorus_labelNs`: `Cs` has index `2` in `Ns`.
* `Matrix.GeneralLinearGroup.labelNs_eq_normalizer`: for `p > 2`, `Ns` is the normalizer of `Cs`.
* `Matrix.GeneralLinearGroup.isSplitCartanNormalizer_labelNs`: `Ns` is the normalizer of a split
  Cartan subgroup in the LMFDB's sense, for every prime `p`.
-/

open Matrix TauCeti

namespace Matrix.GeneralLinearGroup

variable (R : Type*) [CommRing R] {g : GL (Fin 2) R} (p a b c : ℕ)

/-- The matrix `!![0, 1; 1, 0]` exchanging the two coordinates, as an element of `GL₂(R)`. -/
noncomputable def swapGL : GL (Fin 2) R :=
  permutationGL (Equiv.swap 0 1)

@[simp]
lemma coe_swapGL : (swapGL R : Matrix (Fin 2) (Fin 2) R) = !![0, 1; 1, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [swapGL]

lemma swapGL_mul_self : swapGL R * swapGL R = 1 := by
  rw [swapGL, ← map_mul, Equiv.swap_mul_self, map_one]

lemma perm_fin_two (σ : Equiv.Perm (Fin 2)) : σ = 1 ∨ σ = Equiv.swap 0 1 := by
  revert σ
  decide

lemma leftMulMatrix_piBasisFun (x : Fin 2 → R) :
    Algebra.leftMulMatrix (Pi.basisFun R (Fin 2)) x = Matrix.diagonal x := by
  ext i j
  rw [Algebra.leftMulMatrix_eq_repr_mul, Pi.basisFun_repr, Pi.basisFun_apply, Pi.mul_apply,
    Matrix.diagonal_apply]
  fin_cases i <;> fin_cases j <;> simp

lemma unitsLeftMulMatrix_piBasisFun :
    unitsLeftMulMatrix (Pi.basisFun R (Fin 2)) = diagGL.comp MulEquiv.piUnits.toMonoidHom :=
  MonoidHom.ext fun u ↦ Units.ext <| by
    rw [MonoidHom.comp_apply, diagGL_coe, coe_unitsLeftMulMatrix, leftMulMatrix_piBasisFun]
    rfl

/-- **The Cartan subgroup of the split algebra `R × R`**, in its standard basis, is the group of
invertible diagonal matrices. -/
lemma cartanSubgroup_piBasisFun : cartanSubgroup (Pi.basisFun R (Fin 2)) = diagonalTorus R 2 := by
  rw [cartanSubgroup, unitsLeftMulMatrix_piBasisFun, MonoidHom.range_comp,
    MonoidHom.range_eq_top_of_surjective _ MulEquiv.piUnits.surjective, ← MonoidHom.range_eq_map]
  rfl

lemma canonicalInvolutionGL_piBasisFun :
    canonicalInvolutionGL (Pi.basisFun R (Fin 2)) = swapGL R := by
  refine Units.ext ?_
  ext i j
  rw [coe_canonicalInvolutionGL, LinearMap.toMatrix_apply, Pi.basisFun_repr, Pi.basisFun_apply,
    canonicalInvolution_apply, Algebra.trace_eq_matrix_trace (Pi.basisFun R (Fin 2)),
    leftMulMatrix_piBasisFun, Matrix.trace_diagonal, coe_swapGL]
  fin_cases i <;> fin_cases j <;> simp

lemma isDiag_of_fin_two {M : Matrix (Fin 2) (Fin 2) R} (h₀₁ : M 0 1 = 0) (h₁₀ : M 1 0 = 0) :
    M.IsDiag := by
  intro i j hij
  fin_cases i <;> fin_cases j <;> simp_all

lemma mem_diagonalTorus_of_fin_two (h₀₁ : g 0 1 = 0) (h₁₀ : g 1 0 = 0) : g ∈ diagonalTorus R 2 :=
  mem_diagonalTorus_iff.mpr (isDiag_of_fin_two R h₀₁ h₁₀)

lemma mem_sup_zpowers_swapGL_of_fin_two (h₀₀ : g 0 0 = 0) (h₁₁ : g 1 1 = 0) :
    g ∈ diagonalTorus R 2 ⊔ Subgroup.zpowers (swapGL R) := by
  have h : g * swapGL R ∈ diagonalTorus R 2 := by
    refine mem_diagonalTorus_of_fin_two R ?_ ?_ <;>
      simp [Matrix.mul_apply, h₀₀, h₁₁]
  rw [← mul_one g, ← swapGL_mul_self R, ← mul_assoc]
  exact mul_mem (Subgroup.mem_sup_left h) (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))

lemma relIndex_diagonalTorus_sup_zpowers_swapGL [Nontrivial R] :
    (diagonalTorus R 2).relIndex (diagonalTorus R 2 ⊔ Subgroup.zpowers (swapGL R)) = 2 := by
  have h : canonicalInvolution R (Fin 2 → R) (Pi.single 0 1) ≠ Pi.single 0 1 := fun h ↦ by
    simpa [canonicalInvolution_apply, Algebra.trace_eq_matrix_trace (Pi.basisFun R (Fin 2)),
      leftMulMatrix_piBasisFun] using congr_fun h 0
  rw [← cartanSubgroup_piBasisFun, ← canonicalInvolutionGL_piBasisFun]
  exact relIndex_cartanSubgroup_extendedCartanSubgroup _
    (canonicalInvolutionGL_notMem_cartanSubgroup _ h)

/-- **The group of diagonal matrices is a split Cartan subgroup** of `GL₂(F)`: it is the Cartan
subgroup of the étale algebra `F × F` in its standard basis. -/
lemma isSplitCartanSubgroup_diagonalTorus (F : Type*) [Field F] :
    IsSplitCartanSubgroup (diagonalTorus F 2) := by
  refine ⟨⟨Fin 2 → F, inferInstance, inferInstance, inferInstance, Pi.basisFun F (Fin 2),
    (cartanSubgroup_piBasisFun F).symm⟩, 1, ?_⟩
  rintro - ⟨g, hg, rfl⟩
  simpa using hg

/-- The group `Ns` (LMFDB `gl2.normalizer_split_cartan`): the subgroup of `GL₂(𝔽_p)` generated by
the split Cartan subgroup `Cs` of diagonal matrices and the matrix `!![0, 1; 1, 0]`. It is the
extended Cartan subgroup of `𝔽_p × 𝔽_p` (`labelNs_eq_extendedCartanSubgroup`), the normalizer of
`Cs` for `p > 2` (`labelNs_eq_normalizer`), and a group of order `2` for `p = 2`. -/
noncomputable def labelNs : Subgroup (GL (Fin 2) (ZMod p)) :=
  diagonalTorus (ZMod p) 2 ⊔ Subgroup.zpowers (swapGL (ZMod p))

/-- **`Ns` is the extended Cartan subgroup of the split algebra `𝔽_p × 𝔽_p`** in its standard
basis. -/
lemma labelNs_eq_extendedCartanSubgroup :
    labelNs p = extendedCartanSubgroup (Pi.basisFun (ZMod p) (Fin 2)) := by
  rw [extendedCartanSubgroup, cartanSubgroup_piBasisFun, canonicalInvolutionGL_piBasisFun]
  rfl

lemma diagonalTorus_le_labelNs : diagonalTorus (ZMod p) 2 ≤ labelNs p :=
  le_sup_left

variable [Fact p.Prime]

/-- **`Cs` has index `2` in `Ns`**, for every prime `p`. -/
lemma relIndex_diagonalTorus_labelNs : (diagonalTorus (ZMod p) 2).relIndex (labelNs p) = 2 :=
  relIndex_diagonalTorus_sup_zpowers_swapGL (ZMod p)

/-- **For `p > 2`, `Ns` is the normalizer of `Cs`** in `GL₂(𝔽_p)`. -/
lemma labelNs_eq_normalizer (hp : p ≠ 2) :
    labelNs p = Subgroup.normalizer (diagonalTorus (ZMod p) 2 : Set (GL (Fin 2) (ZMod p))) := by
  have h₂ : 2 ≤ p := (Fact.out : p.Prime).two_le
  have : Nontrivial (ZMod p)ˣ :=
    Fintype.one_lt_card_iff_nontrivial.mp (by rw [ZMod.card_units]; omega)
  refine le_antisymm ?_ fun g hg ↦ ?_
  · rw [labelNs_eq_extendedCartanSubgroup, ← cartanSubgroup_piBasisFun]
    exact extendedCartanSubgroup_le_normalizer _
  · rcases mem_normalizer_diagonalTorus_iff_exists.mp hg with ⟨d, σ, rfl⟩
    rcases perm_fin_two σ with rfl | rfl
    · rw [map_one, mul_one]
      exact Subgroup.mem_sup_left ⟨d, rfl⟩
    · exact mul_mem (Subgroup.mem_sup_left ⟨d, rfl⟩)
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))

/-- **`Ns` is the normalizer of a split Cartan subgroup** of `GL₂(𝔽_p)` in the LMFDB's sense, for
every prime `p`. -/
lemma isSplitCartanNormalizer_labelNs : IsSplitCartanNormalizer (labelNs p) := by
  refine ⟨_, isSplitCartanSubgroup_diagonalTorus (ZMod p), ?_⟩
  split_ifs with hp
  · exact ⟨diagonalTorus_le_labelNs p, relIndex_diagonalTorus_labelNs p⟩
  · exact labelNs_eq_normalizer p hp

/-- The group `Cs.a.b` (LMFDB `gl2.split_cartan`): the subgroup of `Cs` generated by the matrices
`!![a, 0; 0, 1/a]` and `!![b, 0; 0, r/b]`, where `r` is the least primitive root modulo `p`. A
listed matrix that is not invertible (`p ∣ a` or `p ∣ b`) is not among the generators; the label
uses minimal positive integers `a` and `b`, which avoids this. -/
noncomputable def labelCsAB : Subgroup (GL (Fin 2) (ZMod p)) :=
  Subgroup.closure (Units.val ⁻¹' {!![(a : ZMod p), 0; 0, (a : ZMod p)⁻¹],
    !![(b : ZMod p), 0; 0, (ZMod.leastPrimitiveRoot p : ZMod p) / b]})

lemma labelCsAB_le : labelCsAB p a b ≤ diagonalTorus (ZMod p) 2 := by
  refine (Subgroup.closure_le _).mpr fun g hg ↦ ?_
  simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with hg | hg <;>
    exact mem_diagonalTorus_of_fin_two (ZMod p) (by simp [hg]) (by simp [hg])

/-- The group `Ns.a.b` (LMFDB `gl2.normalizer_split_cartan`): the subgroup of `Ns` generated by the
matrices `!![a, 0; 0, 1/a]` and `!![0, b; -r/b, 0]`, where `r` is the least primitive root
modulo `p`. -/
noncomputable def labelNsAB : Subgroup (GL (Fin 2) (ZMod p)) :=
  Subgroup.closure (Units.val ⁻¹' {!![(a : ZMod p), 0; 0, (a : ZMod p)⁻¹],
    !![0, (b : ZMod p); -((ZMod.leastPrimitiveRoot p : ZMod p) / b), 0]})

lemma labelNsAB_le : labelNsAB p a b ≤ labelNs p := by
  refine (Subgroup.closure_le _).mpr fun g hg ↦ ?_
  simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with hg | hg
  · exact diagonalTorus_le_labelNs p
      (mem_diagonalTorus_of_fin_two (ZMod p) (by simp [hg]) (by simp [hg]))
  · exact mem_sup_zpowers_swapGL_of_fin_two (ZMod p) (by simp [hg]) (by simp [hg])

/-- The group `Ns.a.b.c` (LMFDB `gl2.normalizer_split_cartan`): the subgroup of `Ns` generated by
the matrices `!![a, 0; 0, 1/a]`, `!![0, b; -1/b, 0]` and `!![0, c; -r/c, 0]`, where `r` is the
least primitive root modulo `p`. -/
noncomputable def labelNsABC : Subgroup (GL (Fin 2) (ZMod p)) :=
  Subgroup.closure (Units.val ⁻¹' {!![(a : ZMod p), 0; 0, (a : ZMod p)⁻¹],
    !![0, (b : ZMod p); -(b : ZMod p)⁻¹, 0],
    !![0, (c : ZMod p); -((ZMod.leastPrimitiveRoot p : ZMod p) / c), 0]})

lemma labelNsABC_le : labelNsABC p a b c ≤ labelNs p := by
  refine (Subgroup.closure_le _).mpr fun g hg ↦ ?_
  simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with hg | hg | hg
  · exact diagonalTorus_le_labelNs p
      (mem_diagonalTorus_of_fin_two (ZMod p) (by simp [hg]) (by simp [hg]))
  all_goals exact mem_sup_zpowers_swapGL_of_fin_two (ZMod p) (by simp [hg]) (by simp [hg])

end Matrix.GeneralLinearGroup
