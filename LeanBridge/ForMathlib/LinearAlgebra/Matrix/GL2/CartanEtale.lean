import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.CartanConjugate
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.CartanNormalizerIndex
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.SplitCartan
import Mathlib.FieldTheory.Finite.GaloisField
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Card
import Mathlib.RingTheory.Etale.Field
import Mathlib.RingTheory.Trace.Basic

/-!
# Cartan subgroups of étale algebras of rank `2`

Let `R` be a commutative ring and `A` a free étale `R`-algebra of rank `2` with a basis. Its Cartan
subgroup, the image of `Aˣ` in `GL₂(R)`, has index `2` in the extended Cartan subgroup, generated by
the Cartan subgroup and the matrix of the canonical involution `x ↦ Tr(x) - x` of `A` (LMFDB
`gl2.cartan`), as soon as `R` is nonzero: the canonical involution is not the identity. Over a
residue field `k` of `R` the algebra `k ⊗ A` is étale of rank `2`, so it is a separable quadratic
field extension of `k`, whose trace does not vanish, or the split algebra `k × k`, whose canonical
involution swaps the factors; if the canonical involution of `A` were the identity, then so would be
that of `k ⊗ A`, and `2 x = Tr(x)` would put `k ⊗ A` in `k` or make its trace vanish.

Over a field `F` an étale algebra of rank `2` is a product of separable field extensions, so it is
either a field or isomorphic to `F × F`. The Cartan subgroup is split, conjugate to a group of
diagonal matrices, exactly in the second case: if all the units of a field `A` acted diagonally in
some basis, the first basis vector would be an eigenvector of multiplication by an element outside
`F`. Over `𝔽_p` the two cases are `𝔽_p × 𝔽_p` and `𝔽_{p²}`, and the extended Cartan subgroup is the
normalizer of the Cartan subgroup except for the split algebra over `𝔽₂`, where the Cartan subgroup
is trivial. In the standard basis of `Fin 2 → R` the extended Cartan subgroup consists of the
diagonal and the antidiagonal matrices.

## Main definitions

* `Matrix.GeneralLinearGroup.piFinTwoAlgEquivProd`: the algebra isomorphism `F² ≃ F × F`.
* `Matrix.GeneralLinearGroup.diagonalOrAntidiagonal`: the subgroup of `GL₂(R)` of the diagonal and
  the antidiagonal matrices.

## Main results

* `Matrix.GeneralLinearGroup.exists_canonicalInvolution_ne`: the canonical involution of a free
  étale algebra of rank `2` over a nonzero ring is not the identity.
* `Matrix.GeneralLinearGroup.relIndex_cartanSubgroup_extendedCartanSubgroup_eq_two` (LMFDB
  `gl2.cartan`): the Cartan subgroup has index `2` in the extended Cartan subgroup.
* `Matrix.GeneralLinearGroup.isField_or_nonempty_algEquiv_prod`: an étale algebra of rank `2` over a
  field `F` is a field or isomorphic to `F × F`.
* `Matrix.GeneralLinearGroup.nonempty_algEquiv_prod_or_nonempty_algEquiv_galoisField` and
  `Matrix.GeneralLinearGroup.not_nonempty_algEquiv_prod_galoisField` (LMFDB `gl2.cartan`): over
  `𝔽_p` there are two such algebras, `𝔽_p × 𝔽_p` and `𝔽_{p²}`.
* `Matrix.GeneralLinearGroup.isSplitCartanSubgroup_cartanSubgroup_iff` and
  `Matrix.GeneralLinearGroup.isNonsplitCartanSubgroup_cartanSubgroup_iff` (LMFDB `gl2.cartan`): the
  Cartan subgroup is split exactly for the split algebra, and non-split exactly when `A` is a field.
* `Matrix.GeneralLinearGroup.normalizer_cartanSubgroup_eq_extendedCartanSubgroup_iff` (LMFDB
  `gl2.cartan`): over `𝔽_p` the extended Cartan subgroup is the normalizer of the Cartan subgroup,
  except when `p = 2` and `A` is split.
* `Matrix.GeneralLinearGroup.mem_extendedCartanSubgroup_piBasisFun_iff` (LMFDB `gl2.cartan`): in the
  standard basis of the split algebra `Fin 2 → R`, the extended Cartan subgroup consists of the
  diagonal and the antidiagonal matrices (for `R × R`, see
  `Matrix.GeneralLinearGroup.mem_extendedCartanSubgroup_finTwoProd_iff`).
-/

open Matrix Module TauCeti

namespace Matrix.GeneralLinearGroup

universe u v

section Field

variable {F : Type u} [Field F] {A : Type v} [CommRing A] [Algebra F A] [Algebra.Etale F A]

variable (F) in
/-- The algebra isomorphism `F² ≃ F × F`. -/
def piFinTwoAlgEquivProd : (Fin 2 → F) ≃ₐ[F] F × F :=
  AlgEquiv.ofLinearEquiv (LinearEquiv.piFinTwo F fun _ ↦ F) rfl fun _ _ ↦ rfl

/-- **An étale algebra of rank `2` over a field `F` is a field or `F × F`**: it is a product of
separable field extensions, of degrees adding up to `2`. -/
lemma isField_or_nonempty_algEquiv_prod (hA : finrank F A = 2) :
    IsField A ∨ Nonempty (A ≃ₐ[F] F × F) := by
  rcases (Algebra.Etale.iff_exists_algEquiv_prod F A).mp inferInstance with
    ⟨I, _, Ai, _, _, e, hAi⟩
  have : Fintype I := Fintype.ofFinite I
  have (i : I) : Module.Finite F (Ai i) := (hAi i).1
  have hsum : ∑ i, finrank F (Ai i) = 2 := by
    rw [← Module.finrank_pi_fintype, ← e.toLinearEquiv.finrank_eq, hA]
  have hpos (i : I) : 1 ≤ finrank F (Ai i) := Module.finrank_pos
  have hcard : Fintype.card I ≤ 2 := by
    simpa [hsum] using Finset.card_nsmul_le_sum Finset.univ (fun i ↦ finrank F (Ai i)) 1
      fun i _ ↦ hpos i
  rcases Nat.lt_or_ge (Fintype.card I) 2 with h1 | h2
  · left
    have : Nonempty I := by
      by_contra h
      rw [not_nonempty_iff] at h
      simp at hsum
    have hI : 0 < Fintype.card I := Fintype.card_pos
    have : Unique I := (Fintype.card_eq_one_iff_nonempty_unique.mp (by omega)).some
    exact MulEquiv.isField (Field.toIsField (Ai default))
      (e.toMulEquiv.trans (RingEquiv.piUnique Ai).toMulEquiv)
  · right
    have hone (i : I) : finrank F (Ai i) = 1 := by
      rcases Fintype.exists_ne_of_one_lt_card (by omega) i with ⟨j, hji⟩
      have h : finrank F (Ai i) + finrank F (Ai j) ≤ ∑ i, finrank F (Ai i) :=
        Finset.add_le_sum (f := fun i ↦ finrank F (Ai i)) (fun j _ ↦ Nat.zero_le _)
          (Finset.mem_univ i) (Finset.mem_univ j) hji.symm
      have hj : 1 ≤ finrank F (Ai j) := hpos j
      have hi : 1 ≤ finrank F (Ai i) := hpos i
      omega
    let σ : I ≃ Fin 2 := Fintype.equivFinOfCardEq (by omega)
    refine ⟨e.trans <| (AlgEquiv.piCongrRight fun i ↦ (AlgEquiv.ofBijective (Algebra.ofId F (Ai i))
      (Algebra.finrank_eq_one_iff_bijective_algebraMap.mp (hone i))).symm).trans <|
      (AlgEquiv.piCongrLeft F (fun _ ↦ F) σ).trans (piFinTwoAlgEquivProd F)⟩

lemma exists_canonicalInvolution_ne_of_field (b : Basis (Fin 2) F A) :
    ∃ x, canonicalInvolution F A x ≠ x := by
  by_cases h2 : (2 : F) = 0
  · -- In characteristic `2`, a canonical involution equal to the identity kills the trace.
    by_contra! h
    have : Nontrivial A := nontrivial_of_ne _ _ (b.ne_zero 0)
    have hA2 : (2 : A) = 0 := by rw [← map_ofNat (algebraMap F A) 2, h2, map_zero]
    have htr (x : A) : Algebra.trace F A x = 0 := by
      have hx : canonicalInvolution F A x = x := h x
      rw [canonicalInvolution_apply, sub_eq_iff_eq_add, ← two_mul, hA2, zero_mul] at hx
      exact (algebraMap F A).injective (hx.trans (map_zero _).symm)
    rcases isField_or_nonempty_algEquiv_prod (finrank_eq_card_basis b |>.trans (Fintype.card_fin 2))
      with hfield | ⟨⟨e⟩⟩
    · let _ : Field A := hfield.toField
      have : FiniteDimensional F A := .of_basis b
      have : Algebra.IsSeparable F A := (Algebra.FormallyEtale.iff_isSeparable F A).mp inferInstance
      exact Algebra.trace_ne_zero F A (LinearMap.ext htr)
    · have h : Algebra.trace F A (e.symm (1, 0)) = 0 := htr (e.symm (1, 0))
      rw [← Algebra.trace_eq_of_algEquiv e, AlgEquiv.apply_symm_apply, Algebra.trace_prod_apply]
        at h
      simp at h
  · rcases exists_unit_notMem_bot b h2 with ⟨w, hw⟩
    refine ⟨w, fun h ↦ hw (mem_bot_of_two_smul_eq_algebraMap h2 (t := Algebra.trace F A w) ?_)⟩
    rw [canonicalInvolution_apply, sub_eq_iff_eq_add] at h
    rw [two_smul, ← h]

end Field

section Ring

open TensorProduct

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

lemma trace_one_tmul_eq_algebraMap (k : Type*) [CommRing k] [Algebra R k] (b : Basis (Fin 2) R A)
    (x : A) : Algebra.trace k (k ⊗[R] A) (1 ⊗ₜ x) = algebraMap R k (Algebra.trace R A x) := by
  have : Module.Free R A := .of_basis b
  have : Module.Finite R A := .of_basis b
  rw [Algebra.trace_apply, ← Algebra.baseChange_lmul, LinearMap.trace_baseChange,
    Algebra.trace_apply]

lemma canonicalInvolution_one_tmul (k : Type*) [CommRing k] [Algebra R k] (b : Basis (Fin 2) R A)
    (x : A) : canonicalInvolution k (k ⊗[R] A) (1 ⊗ₜ x) = 1 ⊗ₜ canonicalInvolution R A x := by
  rw [canonicalInvolution_apply, canonicalInvolution_apply, trace_one_tmul_eq_algebraMap k b,
    Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply, tmul_sub,
    Algebra.algebraMap_eq_smul_one (A := k), Algebra.algebraMap_eq_smul_one (A := A), smul_tmul]

variable [Nontrivial R] [Algebra.Etale R A] in
/-- **The canonical involution of a free étale algebra of rank `2` is not the identity**, over a
nonzero commutative ring: otherwise it would be the identity over a residue field. -/
lemma exists_canonicalInvolution_ne (b : Basis (Fin 2) R A) :
    ∃ x, canonicalInvolution R A x ≠ x := by
  rcases Ideal.exists_maximal R with ⟨m, hm⟩
  let _ : Field (R ⧸ m) := Ideal.Quotient.field m
  by_contra! h
  have h' (y : (R ⧸ m) ⊗[R] A) : canonicalInvolution (R ⧸ m) ((R ⧸ m) ⊗[R] A) y = y := by
    induction y using TensorProduct.inductionOn with
    | tmul c x =>
      rw [← mul_one c, ← smul_eq_mul, ← smul_tmul', LinearMap.map_smul,
        canonicalInvolution_one_tmul _ b, h]
    | add y z hy hz => rw [map_add, hy, hz]
  rcases exists_canonicalInvolution_ne_of_field (Algebra.TensorProduct.basis (R ⧸ m) b) with
    ⟨y, hy⟩
  exact hy (h' y)

variable [Nontrivial R] [Algebra.Etale R A] in
/-- **The Cartan subgroup has index `2` in the extended Cartan subgroup** (LMFDB `gl2.cartan`), for
every free étale algebra of rank `2` with a basis over a nonzero commutative ring. -/
lemma relIndex_cartanSubgroup_extendedCartanSubgroup_eq_two (b : Basis (Fin 2) R A) :
    (cartanSubgroup b).relIndex (extendedCartanSubgroup b) = 2 := by
  rcases exists_canonicalInvolution_ne b with ⟨x, hx⟩
  exact relIndex_cartanSubgroup_extendedCartanSubgroup b
    (canonicalInvolutionGL_notMem_cartanSubgroup b hx)

lemma exists_map_conj_cartanSubgroup_eq (b b' : Basis (Fin 2) R A) :
    ∃ g : GL (Fin 2) R, (cartanSubgroup b).map (MulAut.conj g).toMonoidHom = cartanSubgroup b' := by
  let g : GL (Fin 2) R :=
    ⟨b'.toMatrix b, b.toMatrix b', b'.toMatrix_mul_toMatrix_flip b, b.toMatrix_mul_toMatrix_flip b'⟩
  refine ⟨g, ?_⟩
  rw [cartanSubgroup_map_conj]
  congr 1
  refine Basis.repr_injective (b.ext' fun j ↦ Finsupp.ext fun i ↦ ?_)
  have h : (conjBasis b g).toMatrix b i j = b'.toMatrix b i j :=
    congrFun (congrFun (toMatrix_conjBasis b g) i) j
  rwa [Basis.toMatrix_apply, Basis.toMatrix_apply] at h

lemma cartanSubgroup_basis_map {A' : Type*} [CommRing A'] [Algebra R A'] (b : Basis (Fin 2) R A)
    (e : A ≃ₐ[R] A') : cartanSubgroup (b.map e.toLinearEquiv) = cartanSubgroup b := by
  rw [cartanSubgroup, cartanSubgroup]
  refine le_antisymm ?_ ?_
  · rintro _ ⟨u, rfl⟩
    refine ⟨Units.map e.symm.toMonoidHom u, Units.ext ?_⟩
    ext i j
    simp [Algebra.leftMulMatrix_eq_repr_mul]
  · rintro _ ⟨u, rfl⟩
    refine ⟨Units.map e.toMonoidHom u, Units.ext ?_⟩
    ext i j
    simp [Algebra.leftMulMatrix_eq_repr_mul]

end Ring

section Split

variable {F : Type u} [Field F] {A : Type u} [CommRing A] [Algebra F A] (b : Basis (Fin 2) F A)

lemma not_isField_of_cartanSubgroup_le (h : cartanSubgroup b ≤ diagonalTorus F 2) : ¬IsField A := by
  intro hA
  let _ : Field A := hA.toField
  have hbot : (⊥ : Subalgebra F A) < ⊤ := by
    refine lt_top_iff_ne_top.mpr fun h₁ ↦ ?_
    have h₂ : finrank F A = 1 := Subalgebra.bot_eq_top_iff_finrank_eq_one.mp h₁
    rw [finrank_eq_card_basis b, Fintype.card_fin] at h₂
    exact absurd h₂ (by decide)
  rcases IsConcreteLE.exists_of_lt hbot with ⟨u, -, hu⟩
  have hu0 : u ≠ 0 := fun h ↦ hu (h ▸ zero_mem _)
  have hdiag : (Algebra.leftMulMatrix b u).IsDiag := by
    have hmem : unitsLeftMulMatrix b (Units.mk0 u hu0) ∈ diagonalTorus F 2 := h ⟨_, rfl⟩
    rwa [mem_diagonalTorus_iff, coe_unitsLeftMulMatrix, Units.val_mk0] at hmem
  have hcol : u * b 0 = algebraMap F A (Algebra.leftMulMatrix b u 0 0) * b 0 := by
    conv_lhs => rw [← b.sum_repr (u * b 0)]
    rw [Fin.sum_univ_two, ← Algebra.leftMulMatrix_eq_repr_mul, ← Algebra.leftMulMatrix_eq_repr_mul,
      hdiag one_ne_zero, zero_smul, add_zero, Algebra.smul_def]
  have h0 : (u - algebraMap F A (Algebra.leftMulMatrix b u 0 0)) * b 0 = 0 := by
    rw [sub_mul, hcol, sub_self]
  exact hu (Algebra.mem_bot.mpr ⟨_, (sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right
    (b.ne_zero 0))).symm⟩)

variable [Algebra.Etale F A] in
/-- **The Cartan subgroup of the split algebra is split** (LMFDB `gl2.cartan`, `gl2.split_cartan`):
for an étale algebra `A` of rank `2` over a field `F`, the Cartan subgroup is conjugate to a group
of diagonal matrices exactly when `A ≅ F × F`. -/
lemma isSplitCartanSubgroup_cartanSubgroup_iff :
    IsSplitCartanSubgroup (cartanSubgroup b) ↔ Nonempty (A ≃ₐ[F] F × F) := by
  have hA : finrank F A = 2 := finrank_eq_card_basis b |>.trans (Fintype.card_fin 2)
  refine ⟨fun h ↦ ?_, fun ⟨e⟩ ↦ ⟨⟨A, inferInstance, inferInstance, inferInstance, b, rfl⟩, ?_⟩⟩
  · rcases h.2 with ⟨g, hg⟩
    rw [cartanSubgroup_map_conj] at hg
    exact (isField_or_nonempty_algEquiv_prod hA).resolve_left
      (not_isField_of_cartanSubgroup_le _ hg)
  · let e' : A ≃ₐ[F] (Fin 2 → F) := e.trans (piFinTwoAlgEquivProd F).symm
    rcases exists_map_conj_cartanSubgroup_eq b ((Pi.basisFun F (Fin 2)).map e'.symm.toLinearEquiv)
      with ⟨g, hg⟩
    exact ⟨g, ((hg.trans (cartanSubgroup_basis_map _ _)).trans (cartanSubgroup_piBasisFun F)).le⟩

variable [Algebra.Etale F A] in
/-- **The Cartan subgroup of a field is non-split** (LMFDB `gl2.cartan`, `gl2.nonsplit_cartan`):
for an étale algebra `A` of rank `2` over a field `F`, the Cartan subgroup has no conjugate
consisting of diagonal matrices exactly when `A` is a field. -/
lemma isNonsplitCartanSubgroup_cartanSubgroup_iff :
    IsNonsplitCartanSubgroup (cartanSubgroup b) ↔ IsField A := by
  have hA : finrank F A = 2 := finrank_eq_card_basis b |>.trans (Fintype.card_fin 2)
  refine ⟨fun h ↦ (isField_or_nonempty_algEquiv_prod hA).resolve_right fun he ↦ ?_,
    fun hfield ↦ ⟨⟨A, inferInstance, inferInstance, inferInstance, b, rfl⟩, fun g hg ↦ ?_⟩⟩
  · rcases ((isSplitCartanSubgroup_cartanSubgroup_iff b).mpr he).2 with ⟨g, hg⟩
    exact h.2 g hg
  · rw [cartanSubgroup_map_conj] at hg
    exact not_isField_of_cartanSubgroup_le _ hg hfield

end Split

section Prime

variable {p : ℕ} [Fact p.Prime] {A : Type} [CommRing A] [Algebra (ZMod p) A]

lemma natCard_eq_sq_of_basis (b : Basis (Fin 2) (ZMod p) A) : Nat.card A = p ^ 2 := by
  rw [Nat.card_congr b.equivFun.toEquiv, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card,
    Fintype.card_fin]

variable [Algebra.Etale (ZMod p) A] in
/-- **The two étale algebras of rank `2` over `𝔽_p`** (LMFDB `gl2.cartan`): a free étale
`𝔽_p`-algebra of rank `2` is isomorphic to the split algebra `𝔽_p × 𝔽_p` or to the field
`𝔽_{p²}`. -/
lemma nonempty_algEquiv_prod_or_nonempty_algEquiv_galoisField (b : Basis (Fin 2) (ZMod p) A) :
    Nonempty (A ≃ₐ[ZMod p] ZMod p × ZMod p) ∨ Nonempty (A ≃ₐ[ZMod p] GaloisField p 2) := by
  rcases isField_or_nonempty_algEquiv_prod (finrank_eq_card_basis b |>.trans (Fintype.card_fin 2))
    with h | h
  · let _ : Field A := h.toField
    exact Or.inr ⟨GaloisField.algEquivGaloisField p 2 (natCard_eq_sq_of_basis b)⟩
  · exact Or.inl h

lemma not_isField_zmod_prod : ¬IsField (ZMod p × ZMod p) := fun h ↦ by
  rcases h.mul_inv_cancel (a := ((1, 0) : ZMod p × ZMod p)) (by simp) with ⟨x, hx⟩
  simpa using congrArg Prod.snd hx

/-- **The split and the non-split algebras over `𝔽_p` are not isomorphic** (LMFDB `gl2.cartan`):
`𝔽_p × 𝔽_p` is not a field. -/
lemma not_nonempty_algEquiv_prod_galoisField :
    ¬Nonempty ((ZMod p × ZMod p) ≃ₐ[ZMod p] GaloisField p 2) :=
  fun ⟨e⟩ ↦ not_isField_zmod_prod (MulEquiv.isField (Field.toIsField _) e.toMulEquiv)

lemma etale_prod : Algebra.Etale (ZMod p) (ZMod p × ZMod p) :=
  .of_equiv (piFinTwoAlgEquivProd (ZMod p))

lemma etale_galoisField : Algebra.Etale (ZMod p) (GaloisField p 2) :=
  ⟨Algebra.FormallyEtale.of_isSeparable _ _, Algebra.FinitePresentation.of_finiteType.mp
    inferInstance⟩

variable (b : Basis (Fin 2) (ZMod p) A) [Algebra.Etale (ZMod p) A] in
/-- **The normalizer of a Cartan subgroup of `GL₂(𝔽_p)` is the extended Cartan subgroup, except for
the split algebra over `𝔽₂`** (LMFDB `gl2.cartan`): for `p = 2` and `A ≅ 𝔽₂ × 𝔽₂` the Cartan
subgroup is trivial, with normalizer `GL₂(𝔽₂)` of order `6`, while the extended Cartan subgroup has
order `2`; for `A ≅ 𝔽₄` both are `GL₂(𝔽₂)`. -/
lemma normalizer_cartanSubgroup_eq_extendedCartanSubgroup_iff :
    Subgroup.normalizer (cartanSubgroup b : Set (GL (Fin 2) (ZMod p))) = extendedCartanSubgroup b ↔
      ¬(p = 2 ∧ Nonempty (A ≃ₐ[ZMod p] ZMod p × ZMod p)) := by
  by_cases hp : p = 2
  · subst hp
    have hGL : Nat.card (GL (Fin 2) (ZMod 2)) = 6 := by
      rw [card_GL_field]
      simp
    have hC : Nat.card (cartanSubgroup b) = Nat.card Aˣ :=
      (Nat.card_congr (MonoidHom.ofInjective (unitsLeftMulMatrix_injective b)).toEquiv).symm
    have hE : Nat.card (extendedCartanSubgroup b) = 2 * Nat.card Aˣ := by
      have h : (cartanSubgroup b).relIndex (extendedCartanSubgroup b) *
          Nat.card (cartanSubgroup b ⊓ extendedCartanSubgroup b : Subgroup (GL (Fin 2) (ZMod 2))) =
            Nat.card (extendedCartanSubgroup b) :=
        (cartanSubgroup b).relIndex_mul_card (extendedCartanSubgroup b)
      rwa [relIndex_cartanSubgroup_extendedCartanSubgroup_eq_two b,
        inf_of_le_left (cartanSubgroup_le_extendedCartanSubgroup b), hC, eq_comm] at h
    rcases isField_or_nonempty_algEquiv_prod (finrank_eq_card_basis b |>.trans (Fintype.card_fin 2))
      with hfield | ⟨⟨e⟩⟩
    · have hnot : ¬Nonempty (A ≃ₐ[ZMod 2] ZMod 2 × ZMod 2) :=
        fun ⟨e⟩ ↦ not_isField_zmod_prod (MulEquiv.isField hfield e.symm.toMulEquiv)
      simp only [true_and, hnot, not_false_eq_true, iff_true]
      let _ : Field A := hfield.toField
      have hunits : Nat.card Aˣ = 3 := by
        rw [Nat.card_units, natCard_eq_sq_of_basis b]
        rfl
      have hindex : (cartanSubgroup b).index = 2 := by
        have h : Nat.card (cartanSubgroup b) * (cartanSubgroup b).index =
            Nat.card (GL (Fin 2) (ZMod 2)) :=
          (cartanSubgroup b).card_mul_index
        rw [hC, hunits, hGL] at h
        omega
      have : (cartanSubgroup b).Normal := Subgroup.normal_of_index_eq_two hindex
      rw [Subgroup.normalizer_eq_top_iff.mpr this, eq_comm]
      exact Subgroup.eq_top_of_card_eq _ (by rw [hE, hunits, hGL])
    · simp only [true_and]
      refine iff_of_false (fun h ↦ ?_) fun h ↦ h ⟨e⟩
      have hunits : Nat.card Aˣ = 1 := by
        rw [Nat.card_congr (Units.mapEquiv e.toMulEquiv).toEquiv,
          Nat.card_congr MulEquiv.prodUnits.toEquiv, Nat.card_prod]
        simp
      have hbot : cartanSubgroup b = ⊥ := Subgroup.eq_bot_of_card_eq _ (hC.trans hunits)
      have hnorm : Subgroup.normalizer (cartanSubgroup b : Set (GL (Fin 2) (ZMod 2))) = ⊤ := by
        rw [hbot]
        exact Subgroup.normalizer_eq_top_iff.mpr Subgroup.normal_bot
      have h₁ :
          Nat.card (extendedCartanSubgroup b) = Nat.card (⊤ : Subgroup (GL (Fin 2) (ZMod 2))) := by
        rw [← h, hnorm]
      rw [hE, hunits, Subgroup.card_top, hGL] at h₁
      omega
  · simp only [hp, false_and, not_false_eq_true, iff_true]
    exact normalizer_cartanSubgroup b (Ring.two_ne_zero (by rwa [ZMod.ringChar_zmod_n]))

end Prime

variable {R : Type*} [CommRing R]

/-- The subgroup of `GL₂(R)` of the matrices that are diagonal or antidiagonal. -/
def diagonalOrAntidiagonal : Subgroup (GL (Fin 2) R) where
  carrier := {g | (g 0 1 = 0 ∧ g 1 0 = 0) ∨ (g 0 0 = 0 ∧ g 1 1 = 0)}
  one_mem' := Or.inl ⟨by simp, by simp⟩
  mul_mem' := by
    rintro g h (⟨hg₁, hg₂⟩ | ⟨hg₁, hg₂⟩) (⟨hh₁, hh₂⟩ | ⟨hh₁, hh₂⟩)
    · exact Or.inl ⟨by simp [mul_apply, hg₁, hh₁], by simp [mul_apply, hg₂, hh₂]⟩
    · exact Or.inr ⟨by simp [mul_apply, hg₁, hh₁], by simp [mul_apply, hg₂, hh₂]⟩
    · exact Or.inr ⟨by simp [mul_apply, hg₁, hh₂], by simp [mul_apply, hg₂, hh₁]⟩
    · exact Or.inl ⟨by simp [mul_apply, hg₁, hh₂], by simp [mul_apply, hg₂, hh₁]⟩
  inv_mem' := by
    rintro g (⟨hg₁, hg₂⟩ | ⟨hg₁, hg₂⟩)
    · exact Or.inl ⟨by simp [inv_def, adjugate_fin_two, hg₁],
        by simp [inv_def, adjugate_fin_two, hg₂]⟩
    · exact Or.inr ⟨by simp [inv_def, adjugate_fin_two, hg₂],
        by simp [inv_def, adjugate_fin_two, hg₁]⟩

/-- **The extended Cartan subgroup of the split algebra in its standard basis** (LMFDB
`gl2.cartan`): it consists of the diagonal and the antidiagonal matrices of `GL₂(R)`, the Cartan
subgroup of diagonal matrices together with its coset of antidiagonal ones. -/
lemma mem_extendedCartanSubgroup_piBasisFun_iff {g : GL (Fin 2) R} :
    g ∈ extendedCartanSubgroup (Pi.basisFun R (Fin 2)) ↔ (g 0 1 = 0 ∧ g 1 0 = 0) ∨
      (g 0 0 = 0 ∧ g 1 1 = 0) := by
  rw [extendedCartanSubgroup, cartanSubgroup_piBasisFun, canonicalInvolutionGL_piBasisFun]
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · have hle : diagonalTorus R 2 ⊔ Subgroup.zpowers (swapGL R) ≤ diagonalOrAntidiagonal := by
      refine sup_le (fun x hx ↦ Or.inl ⟨?_, ?_⟩) (Subgroup.zpowers_le.mpr (Or.inr ⟨?_, ?_⟩))
      · exact (mem_diagonalTorus_iff.mp hx) zero_ne_one
      · exact (mem_diagonalTorus_iff.mp hx) one_ne_zero
      · simp
      · simp
    exact hle h
  · rcases h with ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩
    · exact Subgroup.mem_sup_left (mem_diagonalTorus_of_fin_two R h₁ h₂)
    · exact mem_sup_zpowers_swapGL_of_fin_two R h₁ h₂

end Matrix.GeneralLinearGroup
