import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.FinTwo
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.LocalRing.Basic
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.LinearCombination
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Diagonal.Basic

/-!
# Elements of `SL₂` of a local ring as products of commutators

Let `R` be a commutative ring and `t ∈ R` with `1 + t` a unit, and let `D = diag(1 + t, 1)`. The
commutator of `!![1, y; 0, 1]` with `D` is `!![1, -t y; 0, 1]`, and similarly for lower unipotent
matrices, so the unipotent matrices with an entry in `t² R` are commutators of matrices congruent
to the identity modulo `t`. A matrix `!![a, b; c, d]` of determinant `1` with `a = 1 + r s` a unit
is the product `!![1, 0; p, 1] !![1, r; 0, 1] !![1, 0; s, 1] !![1, q; 0, 1]` with `p a = c - s` and
`q a = b - r`. So a matrix of determinant `1` congruent to the identity modulo `t⁴` is a product of
four such commutators. Over a local ring a fifth commutator handles a matrix whose corner entry is
not a unit, which can only happen when `t` is a unit; the same factorisation shows that `SL₂` of a
local ring is generated by the unipotent matrices. The upper unipotent matrices are Mathlib's
`Matrix.GeneralLinearGroup.upperRightHom`, and the diagonal matrices are Tau Ceti's
`TauCeti.diagGL`.

The number of commutators does not depend on the ring, which is what makes such decompositions
pass to infinite products of groups, such as `GL₂(ℤ̂) = ∏_ℓ GL₂(ℤ_ℓ)`.

## Main definitions

* `Matrix.GeneralLinearGroup.lowerUnipotent`: the matrix `!![1, 0; x, 1]` of `GL₂(R)`.
* `Matrix.GeneralLinearGroup.IsCongrOne`: a matrix congruent to the identity modulo `t`.

## Main results

* `Matrix.GeneralLinearGroup.exists_eq_prod_commutatorElement`: over a local ring, a matrix of
  determinant `1` congruent to the identity modulo `t⁴`, where `1 + t` is a unit, is a product of
  five commutators of matrices congruent to the identity modulo `t`.
* `Matrix.GeneralLinearGroup.mem_closure_range_upperRightHom_union_range_lowerUnipotent`: over a
  local ring, every matrix of determinant `1` is a product of unipotent matrices.
-/

open Matrix Ideal

open TauCeti (diagGL diagGL_coe)

open scoped commutatorElement

namespace Matrix.GeneralLinearGroup

variable {R : Type*} [CommRing R] {t : R} (w : R) (u : Rˣ) {g x : GL (Fin 2) R}

/-- The lower unipotent matrix `!![1, 0; w, 1]` of `GL₂(R)`. -/
def lowerUnipotent : GL (Fin 2) R :=
  ⟨!![1, 0; w, 1], !![1, 0; -w, 1], by simp [one_fin_two], by simp [one_fin_two]⟩

variable (t g) in
/-- A matrix `g` of `GL₂(R)` is **congruent to the identity modulo** `t` if all the entries of
`g - 1` are multiples of `t`. -/
def IsCongrOne : Prop :=
  ∀ i j, (g : Matrix (Fin 2) (Fin 2) R) i j - (1 : Matrix (Fin 2) (Fin 2) R) i j ∈ span {t}

lemma isCongrOne_one : IsCongrOne t 1 := by
  simp [IsCongrOne]

lemma isCongrOne_of_isUnit (ht : IsUnit t) : IsCongrOne t g :=
  fun _ _ ↦ mem_span_singleton.mpr ht.dvd

lemma IsCongrOne.of_dvd {s : R} (h : IsCongrOne t g) (hst : s ∣ t) : IsCongrOne s g :=
  fun i j ↦ span_singleton_le_span_singleton.mpr hst (h i j)

lemma det_upperRightHom : det (upperRightHom w) = 1 :=
  Units.ext (by simp)

lemma det_lowerUnipotent : det (lowerUnipotent w) = 1 :=
  Units.ext (by simp [lowerUnipotent])

lemma isCongrOne_upperRightHom : IsCongrOne t (upperRightHom (t * w)) := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp [mem_span_singleton]

lemma isCongrOne_lowerUnipotent : IsCongrOne t (lowerUnipotent (t * w)) := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp [lowerUnipotent, mem_span_singleton]

lemma isCongrOne_diagGL (ht : IsUnit (1 + t)) : IsCongrOne t (diagGL ![ht.unit, 1]) := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp

lemma isCongrOne_diagGL_one (ht : IsUnit (1 + t)) : IsCongrOne t (diagGL ![1, ht.unit]) := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp

lemma commutatorElement_upperRightHom_diagGL :
    ⁅upperRightHom w, diagGL ![u, 1]⁆ = upperRightHom ((1 - u) * w) := by
  refine Units.ext ?_
  simp only [commutatorElement_def, Units.val_mul, ← map_inv, diagGL_coe, diagonal_fin_two]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sub_mul, neg_add_eq_sub]

lemma commutatorElement_lowerUnipotent_diagGL :
    ⁅lowerUnipotent w, diagGL ![1, u]⁆ = lowerUnipotent ((1 - u) * w) := by
  refine Units.ext ?_
  simp only [commutatorElement_def, Units.val_mul, lowerUnipotent, ← map_inv, diagGL_coe,
    diagonal_fin_two]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sub_mul, ← sub_eq_add_neg]

lemma eq_lowerUnipotent_mul_upperRightHom_mul_lowerUnipotent_mul_upperRightHom
    (hx : (x : Matrix (Fin 2) (Fin 2) R).det = 1)
    (hunit : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0)) {p q r s : R}
    (ha : (x : Matrix (Fin 2) (Fin 2) R) 0 0 = 1 + r * s)
    (hp : p * (x : Matrix (Fin 2) (Fin 2) R) 0 0 = (x : Matrix (Fin 2) (Fin 2) R) 1 0 - s)
    (hq : q * (x : Matrix (Fin 2) (Fin 2) R) 0 0 = (x : Matrix (Fin 2) (Fin 2) R) 0 1 - r) :
    x = lowerUnipotent p * upperRightHom r * lowerUnipotent s * upperRightHom q := by
  refine Units.ext ?_
  rw [det_fin_two] at hx
  simp only [Units.val_mul, upperRightHom_apply, lowerUnipotent]
  ext i j
  fin_cases i <;> fin_cases j
  · simp [ha]
  · simp
    linear_combination q * ha - hq
  · simp
    linear_combination p * ha - hp
  · simp
    refine hunit.mul_left_cancel ?_
    linear_combination hx - (1 - (x : Matrix (Fin 2) (Fin 2) R) 0 0 * p * q) * ha -
      (q * (x : Matrix (Fin 2) (Fin 2) R) 0 0 + r) * hp - (x : Matrix (Fin 2) (Fin 2) R) 1 0 * hq

lemma exists_eq_prod_commutatorElement_of_isUnit (ht : IsUnit (1 + t))
    (hx : (x : Matrix (Fin 2) (Fin 2) R).det = 1)
    (hunit : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0)) {m β γ : R}
    (ha : (x : Matrix (Fin 2) (Fin 2) R) 0 0 = 1 + t ^ 4 * m)
    (hb : (x : Matrix (Fin 2) (Fin 2) R) 0 1 = t ^ 2 * β)
    (hc : (x : Matrix (Fin 2) (Fin 2) R) 1 0 = t ^ 2 * γ) :
    ∃ y z : Fin 4 → GL (Fin 2) R, (∀ k, IsCongrOne t (y k)) ∧ (∀ k, IsCongrOne t (z k)) ∧
      x = (List.ofFn fun k ↦ ⁅y k, z k⁆).prod := by
  let b : R := ↑hunit.unit⁻¹
  have hb₁ : b * (x : Matrix (Fin 2) (Fin 2) R) 0 0 = 1 := hunit.val_inv_mul
  have hu : (1 : R) - ht.unit = -t := by simp
  refine ⟨![lowerUnipotent (t * -((γ - 1) * b)), upperRightHom (t * -m),
    lowerUnipotent (t * -1), upperRightHom (t * -((β - m) * b))],
    ![diagGL ![1, ht.unit], diagGL ![ht.unit, 1], diagGL ![1, ht.unit], diagGL ![ht.unit, 1]],
    fun k ↦ ?_, fun k ↦ ?_, ?_⟩
  · fin_cases k
    exacts [isCongrOne_lowerUnipotent _, isCongrOne_upperRightHom _,
      isCongrOne_lowerUnipotent _, isCongrOne_upperRightHom _]
  · fin_cases k
    exacts [isCongrOne_diagGL_one ht, isCongrOne_diagGL ht, isCongrOne_diagGL_one ht,
      isCongrOne_diagGL ht]
  refine (eq_lowerUnipotent_mul_upperRightHom_mul_lowerUnipotent_mul_upperRightHom hx hunit
    (p := t ^ 2 * ((γ - 1) * b)) (q := t ^ 2 * ((β - m) * b)) (r := t ^ 2 * m) (s := t ^ 2)
    (by rw [ha]; ring1) (by linear_combination t ^ 2 * (γ - 1) * hb₁ - hc)
    (by linear_combination t ^ 2 * (β - m) * hb₁ - hb)).trans ?_
  simp only [List.ofFn_succ, List.ofFn_zero, List.prod_cons, List.prod_nil, mul_one,
    Matrix.cons_val_zero, Matrix.cons_val_succ, commutatorElement_upperRightHom_diagGL,
    commutatorElement_lowerUnipotent_diagGL, hu, neg_mul, mul_neg, neg_neg, pow_two, mul_assoc]

lemma det_upperRightHom_one_mul (hx : (x : Matrix (Fin 2) (Fin 2) R).det = 1) :
    ((upperRightHom 1 * x : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R).det = 1 := by
  rw [Units.val_mul, det_mul, hx, mul_one, upperRightHom_apply]
  simp

lemma upperRightHom_one_mul_apply_zero_zero :
    ((upperRightHom 1 * x : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R) 0 0 =
      (x : Matrix (Fin 2) (Fin 2) R) 0 0 + (x : Matrix (Fin 2) (Fin 2) R) 1 0 := by
  simp [mul_apply]

variable [IsLocalRing R] in
lemma isUnit_upperRightHom_one_mul_apply_zero_zero (hx : (x : Matrix (Fin 2) (Fin 2) R).det = 1)
    (hunit : ¬IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0)) :
    IsUnit (((upperRightHom 1 * x : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R) 0 0) := by
  -- The entry `x₁₀` is a unit, as `x₀₀ x₁₁ - x₀₁ x₁₀ = 1` and `x₀₀` is not.
  have hc : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 1 0) := by
    have h : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0 * (x : Matrix (Fin 2) (Fin 2) R) 1 1 +
        -((x : Matrix (Fin 2) (Fin 2) R) 0 1 * (x : Matrix (Fin 2) (Fin 2) R) 1 0)) := by
      rw [← sub_eq_add_neg, ← det_fin_two, hx]
      exact isUnit_one
    exact isUnit_of_mul_isUnit_right <| (IsUnit.neg_iff _).mp <|
      (IsLocalRing.isUnit_or_isUnit_of_isUnit_add h).resolve_left fun h ↦
        hunit (isUnit_of_mul_isUnit_left h)
  have h : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0 + (x : Matrix (Fin 2) (Fin 2) R) 1 0 +
      -(x : Matrix (Fin 2) (Fin 2) R) 0 0) := by
    rwa [add_neg_cancel_comm]
  rw [upperRightHom_one_mul_apply_zero_zero]
  exact (IsLocalRing.isUnit_or_isUnit_of_isUnit_add h).resolve_right fun h ↦
    hunit ((IsUnit.neg_iff _).mp h)

variable [IsLocalRing R] in
/-- **A matrix of determinant `1` close to the identity is a product of five commutators**: over a
local ring `R`, for `t ∈ R` with `1 + t` a unit, a matrix of `GL₂(R)` of determinant `1` congruent
to the identity modulo `t⁴` is a product of five commutators of matrices congruent to the identity
modulo `t`. When `t` is a unit, this says that every matrix of determinant `1` is a product of five
commutators of `GL₂(R)`. -/
lemma exists_eq_prod_commutatorElement (ht : IsUnit (1 + t))
    (hx : (x : Matrix (Fin 2) (Fin 2) R).det = 1) (hxt : IsCongrOne (t ^ 4) x) :
    ∃ y z : Fin 5 → GL (Fin 2) R, (∀ k, IsCongrOne t (y k)) ∧ (∀ k, IsCongrOne t (z k)) ∧
      x = (List.ofFn fun k ↦ ⁅y k, z k⁆).prod := by
  rcases mem_span_singleton.mp (hxt 0 0) with ⟨m, hm⟩
  rcases mem_span_singleton.mp (hxt 0 1) with ⟨β, hβ⟩
  rcases mem_span_singleton.mp (hxt 1 0) with ⟨γ, hγ⟩
  rw [one_apply_eq] at hm
  rw [one_apply_ne zero_ne_one, sub_zero] at hβ
  rw [one_apply_ne one_ne_zero, sub_zero] at hγ
  by_cases hunit : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0)
  · rcases exists_eq_prod_commutatorElement_of_isUnit ht hx hunit (m := m) (β := t ^ 2 * β)
      (γ := t ^ 2 * γ) (by linear_combination hm) (by simpa [← mul_assoc, ← pow_add] using hβ)
      (by simpa [← mul_assoc, ← pow_add] using hγ) with ⟨y, z, hy, hz, hyz⟩
    refine ⟨Fin.cons 1 y, Fin.cons 1 z, fun k ↦ Fin.cases isCongrOne_one hy k,
      fun k ↦ Fin.cases isCongrOne_one hz k, ?_⟩
    rw [List.ofFn_succ, List.prod_cons]
    simpa using hyz
  -- Otherwise `t` is a unit, and `!![1, 1; 0, 1] * x` has a unit entry in the corner.
  have htu : IsUnit t := by
    have h : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0 + -(t ^ 4 * m)) := by
      rw [← hm, neg_sub, add_sub_cancel]
      exact isUnit_one
    exact (isUnit_pow_iff four_ne_zero).mp <| isUnit_of_mul_isUnit_left <| (IsUnit.neg_iff _).mp <|
      (IsLocalRing.isUnit_or_isUnit_of_isUnit_add h).resolve_left hunit
  let s : R := ↑htu.unit⁻¹
  have hs : t * s = 1 := htu.mul_val_inv
  have h01 : ((upperRightHom 1 * x : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R) 0 1 =
      (x : Matrix (Fin 2) (Fin 2) R) 0 1 + (x : Matrix (Fin 2) (Fin 2) R) 1 1 := by
    simp [mul_apply]
  have h10 : ((upperRightHom 1 * x : GL (Fin 2) R) : Matrix (Fin 2) (Fin 2) R) 1 0 =
      (x : Matrix (Fin 2) (Fin 2) R) 1 0 := by
    simp [mul_apply]
  rcases exists_eq_prod_commutatorElement_of_isUnit ht (det_upperRightHom_one_mul hx)
    (isUnit_upperRightHom_one_mul_apply_zero_zero hx hunit) (m := (
    (x : Matrix (Fin 2) (Fin 2) R) 0 0 + (x : Matrix (Fin 2) (Fin 2) R) 1 0 - 1) * s ^ 4)
    (β := ((x : Matrix (Fin 2) (Fin 2) R) 0 1 + (x : Matrix (Fin 2) (Fin 2) R) 1 1) * s ^ 2)
    (γ := (x : Matrix (Fin 2) (Fin 2) R) 1 0 * s ^ 2) (by
      rw [upperRightHom_one_mul_apply_zero_zero]
      linear_combination
        -((x : Matrix (Fin 2) (Fin 2) R) 0 0 + (x : Matrix (Fin 2) (Fin 2) R) 1 0 - 1) *
          (1 + t * s + t ^ 2 * s ^ 2 + t ^ 3 * s ^ 3) * hs) (by
      rw [h01]
      linear_combination
        -((x : Matrix (Fin 2) (Fin 2) R) 0 1 + (x : Matrix (Fin 2) (Fin 2) R) 1 1) *
          (1 + t * s) * hs)
    (by
      rw [h10]
      linear_combination -(x : Matrix (Fin 2) (Fin 2) R) 1 0 * (1 + t * s) * hs) with
    ⟨y, z, -, -, hyz⟩
  refine ⟨Fin.cons (upperRightHom s) y, Fin.cons (diagGL ![ht.unit, 1]) z,
    fun _ ↦ isCongrOne_of_isUnit htu, fun _ ↦ isCongrOne_of_isUnit htu, ?_⟩
  have h1 : ((1 : R) - ht.unit) * s + 1 = 0 := by
    rw [IsUnit.unit_spec]
    linear_combination -hs
  rw [List.ofFn_succ, List.prod_cons]
  simp only [Fin.cons_zero, Fin.cons_succ, ← hyz, commutatorElement_upperRightHom_diagGL,
    ← mul_assoc]
  rw [← AddChar.map_add_eq_mul, h1, AddChar.map_zero_eq_one, one_mul]

variable [IsLocalRing R] in
/-- **`SL₂` of a local ring is generated by the unipotent matrices**: over a local ring, every
matrix of `GL₂(R)` of determinant `1` is a product of upper and lower unipotent matrices. -/
lemma mem_closure_range_upperRightHom_union_range_lowerUnipotent
    (hx : (x : Matrix (Fin 2) (Fin 2) R).det = 1) :
    x ∈ Subgroup.closure (Set.range upperRightHom ∪ Set.range lowerUnipotent) := by
  have hU (w : R) :
      upperRightHom w ∈ Subgroup.closure (Set.range upperRightHom ∪ Set.range lowerUnipotent) :=
    Subgroup.subset_closure (Or.inl ⟨w, rfl⟩)
  have hL (w : R) :
      lowerUnipotent w ∈ Subgroup.closure (Set.range upperRightHom ∪ Set.range lowerUnipotent) :=
    Subgroup.subset_closure (Or.inr ⟨w, rfl⟩)
  -- A matrix with a unit in the corner is a product of four unipotent matrices.
  have key {y : GL (Fin 2) R} (hy : (y : Matrix (Fin 2) (Fin 2) R).det = 1)
      (hunit : IsUnit ((y : Matrix (Fin 2) (Fin 2) R) 0 0)) :
      y ∈ Subgroup.closure (Set.range upperRightHom ∪ Set.range lowerUnipotent) := by
    let b : R := ↑hunit.unit⁻¹
    have hb : b * (y : Matrix (Fin 2) (Fin 2) R) 0 0 = 1 := hunit.val_inv_mul
    rw [eq_lowerUnipotent_mul_upperRightHom_mul_lowerUnipotent_mul_upperRightHom hy hunit
      (p := ((y : Matrix (Fin 2) (Fin 2) R) 1 0 - 1) * b)
      (q := ((y : Matrix (Fin 2) (Fin 2) R) 0 1 - ((y : Matrix (Fin 2) (Fin 2) R) 0 0 - 1)) * b)
      (r := (y : Matrix (Fin 2) (Fin 2) R) 0 0 - 1) (s := 1) (by ring1)
      (by linear_combination ((y : Matrix (Fin 2) (Fin 2) R) 1 0 - 1) * hb)
      (by linear_combination ((y : Matrix (Fin 2) (Fin 2) R) 0 1 -
        ((y : Matrix (Fin 2) (Fin 2) R) 0 0 - 1)) * hb)]
    exact mul_mem (mul_mem (mul_mem (hL _) (hU _)) (hL _)) (hU _)
  by_cases hunit : IsUnit ((x : Matrix (Fin 2) (Fin 2) R) 0 0)
  · exact key hx hunit
  -- Otherwise `!![1, 1; 0, 1] * x` has a unit in the corner.
  have hxx : x = upperRightHom (-1) * (upperRightHom 1 * x) := by
    rw [← mul_assoc, ← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one, one_mul]
  rw [hxx]
  exact mul_mem (hU _) (key (det_upperRightHom_one_mul hx)
    (isUnit_upperRightHom_one_mul_apply_zero_zero hx hunit))

end Matrix.GeneralLinearGroup
