import Mathlib.GroupTheory.IndexNormal
import Mathlib.RingTheory.Unramified.Field
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.Borel
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.NonsplitCartan
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.SplitCartanConjugacy

/-!
# The normalizer of a Cartan subgroup of `GL₂`

Let `F` be a field of characteristic other than `2` and `C ≤ GL₂(F)` the Cartan subgroup of an
étale `F`-algebra `A` of rank `2` with a basis, the image of `Aˣ` (LMFDB `gl2.cartan`). Its
normalizer is the extended Cartan subgroup, generated by `C` and the matrix `σ` of the canonical
involution of `A`, and contains `C` with index `2`. Indeed `A` has a unit `u` outside `F`, so `1`
and `u` span `A`, and an invertible matrix commuting with the matrix `U` of multiplication by `u` is
the matrix of multiplication by a unit of `A`. If `g` normalizes `C`, then `g U g⁻¹ = α + β U`
lies in `C`; comparing traces and determinants gives `(1 - β²) (t² - 4 n) = 0`, where `t` and `n`
are the trace and the determinant of `U`, and `t² ≠ 4 n`, as otherwise `2 u - t` would be a nonzero
nilpotent element of the reduced ring `A`. So `β = ±1`: either `g` commutes with `U`, or
`g U g⁻¹ = t - U = σ U σ` and `σ g` commutes with `U`. Conversely, a subgroup containing `C` with
index `2` normalizes `C`, so it is the normalizer of `C`.

So over `𝔽_p`, `p > 2`, every normalizer of a Cartan subgroup in the LMFDB's sense (LMFDB
`gl2.normalizer_cartan`) contains a Cartan subgroup with index `2`, not only the standard groups
`Ns` and `Nn`, and the normalizers of (split) Cartan subgroups are exactly the subgroups containing
a (split) Cartan subgroup with index `2`, as for `p = 2`, where the LMFDB defines them by that
index. The normalizer of a split Cartan subgroup of `GL₂(𝔽₂)`, which is trivial, then has order
`2`; it is a Sylow `2`-subgroup of `GL₂(𝔽₂)`, of order `6`, like the Borel subgroup of upper
triangular matrices, to which it is therefore conjugate. The normalizer of a non-split Cartan
subgroup, of order `3`, is `GL₂(𝔽₂)`.

## Main results

* `Matrix.GeneralLinearGroup.normalizer_cartanSubgroup` (LMFDB `gl2.normalizer_cartan`): in
  characteristic other than `2`, the normalizer of a Cartan subgroup is the extended Cartan
  subgroup.
* `Matrix.GeneralLinearGroup.relIndex_cartanSubgroup_normalizer` (LMFDB `gl2.normalizer_cartan`):
  a Cartan subgroup has index `2` in its normalizer.
* `Matrix.GeneralLinearGroup.IsCartanSubgroup.isExtendedCartanSubgroup_normalizer` and
  `Matrix.GeneralLinearGroup.IsCartanSubgroup.relIndex_normalizer` (LMFDB `gl2.normalizer_cartan`):
  the same for every subgroup satisfying `IsCartanSubgroup`.
* `Matrix.GeneralLinearGroup.IsCartanSubgroup.eq_normalizer_of_relIndex_eq_two` (LMFDB
  `gl2.normalizer_cartan`, `gl2.normalizer_split_cartan`): a subgroup containing a Cartan subgroup
  with index `2` is its normalizer, in characteristic other than `2`.
* `Matrix.GeneralLinearGroup.isCartanNormalizer_iff_exists_relIndex_eq_two` (LMFDB
  `gl2.normalizer_cartan`),
  `Matrix.GeneralLinearGroup.isSplitCartanNormalizer_iff_exists_relIndex_eq_two` (LMFDB
  `gl2.normalizer_split_cartan`) and
  `Matrix.GeneralLinearGroup.isNonsplitCartanNormalizer_iff_exists_relIndex_eq_two` (LMFDB
  `gl2.normalizer_nonsplit_cartan`): for every prime `p`, the normalizers of (split, non-split)
  Cartan subgroups of `GL₂(𝔽_p)` are the subgroups containing a (split, non-split) Cartan subgroup
  with index `2`.
* `Matrix.GeneralLinearGroup.IsCartanNormalizer.exists_relIndex_eq_two`,
  `Matrix.GeneralLinearGroup.IsSplitCartanNormalizer.exists_relIndex_eq_two` and
  `Matrix.GeneralLinearGroup.IsNonsplitCartanNormalizer.exists_relIndex_eq_two` (LMFDB
  `gl2.normalizer_cartan`): for every prime `p`, the normalizer of a (split, non-split) Cartan
  subgroup of `GL₂(𝔽_p)` contains a (split, non-split) Cartan subgroup with index `2`.
* `Matrix.GeneralLinearGroup.IsSplitCartanNormalizer.natCard_eq_two` and
  `Matrix.GeneralLinearGroup.IsSplitCartanNormalizer.isBorelSubgroup` (LMFDB
  `gl2.normalizer_cartan`): for `p = 2`, the normalizer of a split Cartan subgroup has order `2` and
  is conjugate to the Borel subgroup.
* `Matrix.GeneralLinearGroup.IsNonsplitCartanNormalizer.eq_top` (LMFDB `gl2.normalizer_cartan`): for
  `p = 2`, the normalizer of a non-split Cartan subgroup is `GL₂(𝔽₂)`.
-/

open Matrix Module TauCeti

namespace Matrix.GeneralLinearGroup

universe u v

variable {F : Type u} [Field F] {A : Type v} [CommRing A] [Algebra F A] {w : A} (α β : F)
  (M : Matrix (Fin 2) (Fin 2) F)

lemma exists_unit_notMem_bot (b : Basis (Fin 2) F A) (h2 : (2 : F) ≠ 0) :
    ∃ w : Aˣ, (w : A) ∉ (⊥ : Subalgebra F A) := by
  have : Nontrivial A := nontrivial_of_ne _ _ (b.ne_zero 0)
  have : Module.Free F A := .of_basis b
  have hbot : (⊥ : Subalgebra F A) < ⊤ := by
    refine lt_top_iff_ne_top.mpr fun h₁ ↦ ?_
    have h₂ : Module.finrank F A = 1 := Subalgebra.bot_eq_top_iff_finrank_eq_one.mp h₁
    rw [Module.finrank_eq_card_basis b, Fintype.card_fin] at h₂
    exact absurd h₂ (by decide)
  rcases IsConcreteLE.exists_of_lt hbot with ⟨a, -, ha⟩
  rcases exists_det_leftMulMatrix_add_algebraMap_ne_zero b a (neg_ne_zero.mpr one_ne_zero)
    (fun h ↦ h2 (by linear_combination -h)) with ⟨t, ht⟩
  refine ⟨((isUnit_iff_det_leftMulMatrix_ne_zero b _).mpr ht).unit, fun h ↦ ha ?_⟩
  rw [IsUnit.unit_spec] at h
  simpa using sub_mem h (algebraMap_mem _ t)

lemma span_pair_one_eq_top (b : Basis (Fin 2) F A) (hw : w ∉ (⊥ : Subalgebra F A)) :
    Submodule.span F {1, w} = ⊤ := by
  have : Nontrivial A := nontrivial_of_ne _ _ (b.ne_zero 0)
  have hli : LinearIndependent F ![1, w] := (LinearIndependent.pair_iff' one_ne_zero).mpr
    fun a h ↦ hw (Algebra.mem_bot.mpr ⟨a, by rw [Algebra.algebraMap_eq_smul_one, h]⟩)
  rw [← Matrix.range_cons_cons_empty 1 w ![]]
  exact hli.span_eq_top_of_card_eq_finrank (by rw [Module.finrank_eq_card_basis b])

lemma mem_bot_of_two_smul_eq_algebraMap (h2 : (2 : F) ≠ 0) {t : F}
    (h : (2 : F) • w = algebraMap F A t) : w ∈ (⊥ : Subalgebra F A) := by
  refine Algebra.mem_bot.mpr ⟨t / 2, ?_⟩
  rw [div_eq_mul_inv, mul_comm, map_mul, ← Algebra.smul_def, ← h, smul_smul, inv_mul_cancel₀ h2,
    one_smul]

lemma trace_smul_one_add_smul : (α • 1 + β • M).trace = 2 * α + β * M.trace := by
  simp
  ring1

lemma det_smul_one_add_smul : (α • 1 + β • M).det = α ^ 2 + α * β * M.trace + β ^ 2 * M.det := by
  simp [trace_fin_two, det_fin_two]
  ring1

lemma two_smul_sub_trace_smul_sq :
    ((2 : F) • M - M.trace • 1) ^ 2 = (M.trace ^ 2 - 4 * M.det) • 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [sq, Matrix.mul_apply, trace_fin_two, det_fin_two] <;> ring1

variable (b : Basis (Fin 2) F A)

lemma mem_cartanSubgroup_of_commute (hw : w ∉ (⊥ : Subalgebra F A)) {g : GL (Fin 2) F}
    (h : g.val * Algebra.leftMulMatrix b w = Algebra.leftMulMatrix b w * g.val) :
    g ∈ cartanSubgroup b := by
  have hφ (x : A) : Matrix.toLin b b g.val (w * x) = w * Matrix.toLin b b g.val x := by
    have h' : Matrix.toLin b b (g.val * Algebra.leftMulMatrix b w) =
        Matrix.toLin b b (Algebra.leftMulMatrix b w * g.val) := congr_arg _ h
    rw [toLin_mul b b b, toLin_mul b b b, Algebra.leftMulMatrix_apply, toLin_toMatrix] at h'
    exact LinearMap.congr_fun h' x
  have hmul (x : A) : Matrix.toLin b b g.val x = x * Matrix.toLin b b g.val 1 := by
    rcases Submodule.mem_span_pair.mp ((span_pair_one_eq_top b hw).ge (Submodule.mem_top (x := x)))
      with ⟨c, d, rfl⟩
    rw [map_add, map_smul, map_smul, ← mul_one w, hφ, mul_one, add_mul, smul_mul_assoc,
      smul_mul_assoc, one_mul]
  have hlmul : Algebra.lmul F A (Matrix.toLin b b g.val 1) = Matrix.toLin b b g.val :=
    LinearMap.ext fun x ↦ by rw [Algebra.coe_lmul_eq_mul, LinearMap.mul_apply', hmul x, mul_comm]
  have hL : Algebra.leftMulMatrix b (Matrix.toLin b b g.val 1) = g.val := by
    rw [Algebra.leftMulMatrix_apply, hlmul, LinearMap.toMatrix_toLin]
  have hdet : (Algebra.leftMulMatrix b (Matrix.toLin b b g.val 1)).det ≠ 0 := by
    rw [hL]
    exact det_ne_zero g
  exact ⟨((isUnit_iff_det_leftMulMatrix_ne_zero b _).mpr hdet).unit,
    Units.ext <| (coe_unitsLeftMulMatrix b _).trans hL⟩

variable [Algebra.Etale F A] in
lemma trace_sq_ne_four_mul_det (h2 : (2 : F) ≠ 0) (hw : w ∉ (⊥ : Subalgebra F A)) :
    (Algebra.leftMulMatrix b w).trace ^ 2 ≠ 4 * (Algebra.leftMulMatrix b w).det := by
  intro h
  have : IsReduced A := Algebra.FormallyUnramified.isReduced_of_field F A
  have h₀ : ((2 : F) • w - algebraMap F A (Algebra.leftMulMatrix b w).trace) ^ 2 = 0 := by
    refine Algebra.leftMulMatrix_injective b ?_
    rw [map_pow, map_sub, map_smul, AlgHom.commutes, Algebra.algebraMap_eq_smul_one,
      two_smul_sub_trace_smul_sq, h, sub_self, zero_smul, map_zero]
  exact hw <| mem_bot_of_two_smul_eq_algebraMap h2 <| sub_eq_zero.mp <| IsReduced.eq_zero _ ⟨2, h₀⟩

lemma leftMulMatrix_mul_canonicalInvolutionGL (x : Aˣ) :
    Algebra.leftMulMatrix b x * (canonicalInvolutionGL b).val = (canonicalInvolutionGL b).val *
      ((Algebra.leftMulMatrix b x).trace • 1 - Algebra.leftMulMatrix b x) := by
  have h : (canonicalInvolutionGL b * unitsLeftMulMatrix b x * canonicalInvolutionGL b).val =
      (unitsLeftMulMatrix b (Units.map (canonicalInvolutionAlgEquiv b : A →* A) x)).val :=
    congr_arg Units.val (canonicalInvolutionGL_mul_unitsLeftMulMatrix_mul b x)
  rw [Units.val_mul, Units.val_mul, coe_unitsLeftMulMatrix, coe_unitsLeftMulMatrix,
    Units.coe_map, MonoidHom.coe_ofClass, canonicalInvolutionAlgEquiv_apply,
    canonicalInvolution_apply, map_sub, AlgHom.commutes, Algebra.trace_eq_matrix_trace b,
    Algebra.algebraMap_eq_smul_one] at h
  rw [← h, ← mul_assoc, ← mul_assoc, ← Units.val_mul, canonicalInvolutionGL_mul_self,
    Units.val_one, one_mul]

variable [Algebra.Etale F A] in
/-- **The normalizer of a Cartan subgroup is the extended Cartan subgroup** (LMFDB
`gl2.normalizer_cartan`) over a field of characteristic other than `2`: an element normalizing the
Cartan subgroup of an étale algebra `A` conjugates the matrix `U` of a unit `u ∉ F` to `U` or to
`Tr(u) - U`, so it, or its product with the canonical involution, commutes with `U`, hence lies in
the Cartan subgroup. -/
lemma normalizer_cartanSubgroup (h2 : (2 : F) ≠ 0) :
    Subgroup.normalizer (cartanSubgroup b : Set (GL (Fin 2) F)) = extendedCartanSubgroup b := by
  refine le_antisymm (fun g hg ↦ ?_) (extendedCartanSubgroup_le_normalizer b)
  rcases exists_unit_notMem_bot b h2 with ⟨w, hw⟩
  rcases (Subgroup.mem_normalizer_iff.mp hg _).mp ⟨w, rfl⟩ with ⟨v, hv⟩
  rcases Submodule.mem_span_pair.mp
    ((span_pair_one_eq_top b hw).ge (Submodule.mem_top (x := (v : A)))) with ⟨α, β, hαβ⟩
  have hM : (g * unitsLeftMulMatrix b w * g⁻¹).val = α • 1 + β • Algebra.leftMulMatrix b w := by
    rw [← hv, coe_unitsLeftMulMatrix, ← hαβ, map_add, map_smul, map_smul, map_one]
  have htr : (g * unitsLeftMulMatrix b w * g⁻¹).val.trace = (Algebra.leftMulMatrix b w).trace :=
    (Matrix.trace_units_conj g _).trans (by rw [coe_unitsLeftMulMatrix])
  have hdet : (g * unitsLeftMulMatrix b w * g⁻¹).val.det = (Algebra.leftMulMatrix b w).det :=
    (Matrix.det_units_conj g _).trans (by rw [coe_unitsLeftMulMatrix])
  rw [hM, trace_smul_one_add_smul] at htr
  rw [hM, det_smul_one_add_smul] at hdet
  have hβ : β * β = 1 := by
    have h : (1 - β * β) *
        ((Algebra.leftMulMatrix b w).trace ^ 2 - 4 * (Algebra.leftMulMatrix b w).det) = 0 := by
      linear_combination 4 * hdet - (2 * α + (1 + β) * (Algebra.leftMulMatrix b w).trace) * htr
    exact (sub_eq_zero.mp ((mul_eq_zero.mp h).resolve_right
      (sub_ne_zero.mpr (trace_sq_ne_four_mul_det b h2 hw)))).symm
  have hg :
      g.val * Algebra.leftMulMatrix b w = (α • 1 + β • Algebra.leftMulMatrix b w) * g.val := by
    rw [← hM, ← coe_unitsLeftMulMatrix, ← Units.val_mul, ← Units.val_mul, inv_mul_cancel_right]
  rcases mul_self_eq_one_iff.mp hβ with rfl | rfl
  · have hα : α = 0 :=
      (mul_eq_zero.mp (by linear_combination htr : (2 : F) * α = 0)).resolve_left h2
    rw [hα, zero_smul, zero_add, one_smul] at hg
    exact cartanSubgroup_le_extendedCartanSubgroup b (mem_cartanSubgroup_of_commute b hw hg)
  · have hα : α = (Algebra.leftMulMatrix b w).trace :=
      mul_left_cancel₀ h2 (by linear_combination htr)
    rw [hα, neg_one_smul, ← sub_eq_add_neg] at hg
    have hc : (canonicalInvolutionGL b * g).val * Algebra.leftMulMatrix b w =
        Algebra.leftMulMatrix b w * (canonicalInvolutionGL b * g).val := by
      rw [Units.val_mul, mul_assoc, hg, ← mul_assoc, ← leftMulMatrix_mul_canonicalInvolutionGL,
        mul_assoc]
    rw [← canonicalInvolutionGL_mul_self_mul b (g := g)]
    exact mul_mem (canonicalInvolutionGL_mem_extendedCartanSubgroup b)
      (cartanSubgroup_le_extendedCartanSubgroup b (mem_cartanSubgroup_of_commute b hw hc))

variable [Algebra.Etale F A] in
/-- **A Cartan subgroup has index `2` in its normalizer** (LMFDB `gl2.normalizer_cartan`) over a
field of characteristic other than `2`: the normalizer is the extended Cartan subgroup, and the
canonical involution, which moves every element outside `F`, is not in the Cartan subgroup. -/
lemma relIndex_cartanSubgroup_normalizer (h2 : (2 : F) ≠ 0) :
    (cartanSubgroup b).relIndex (Subgroup.normalizer (cartanSubgroup b : Set (GL (Fin 2) F))) =
      2 := by
  rcases exists_unit_notMem_bot b h2 with ⟨w, hw⟩
  rw [normalizer_cartanSubgroup b h2]
  refine relIndex_cartanSubgroup_extendedCartanSubgroup b
    (canonicalInvolutionGL_notMem_cartanSubgroup b (x := (w : A)) fun h ↦ hw ?_)
  refine mem_bot_of_two_smul_eq_algebraMap h2 (t := Algebra.trace F A w) ?_
  rw [canonicalInvolution_apply, sub_eq_iff_eq_add] at h
  rw [two_smul, ← h]

section Predicates

variable {C : Subgroup (GL (Fin 2) F)}

/-- **The normalizer of a Cartan subgroup is an extended Cartan subgroup** (LMFDB
`gl2.normalizer_cartan`), over a field of characteristic other than `2`. -/
lemma IsCartanSubgroup.isExtendedCartanSubgroup_normalizer (hC : IsCartanSubgroup C)
    (h2 : (2 : F) ≠ 0) :
    IsExtendedCartanSubgroup (Subgroup.normalizer (C : Set (GL (Fin 2) F))) := by
  rcases hC with ⟨A, _, _, _, b, rfl⟩
  exact ⟨A, inferInstance, inferInstance, inferInstance, b, normalizer_cartanSubgroup b h2⟩

/-- **A Cartan subgroup has index `2` in its normalizer** (LMFDB `gl2.normalizer_cartan`), over a
field of characteristic other than `2`. -/
lemma IsCartanSubgroup.relIndex_normalizer (hC : IsCartanSubgroup C) (h2 : (2 : F) ≠ 0) :
    C.relIndex (Subgroup.normalizer (C : Set (GL (Fin 2) F))) = 2 := by
  rcases hC with ⟨A, _, _, _, b, rfl⟩
  exact relIndex_cartanSubgroup_normalizer b h2

/-- **A subgroup containing a Cartan subgroup with index `2` is its normalizer** (LMFDB
`gl2.normalizer_cartan`, `gl2.normalizer_split_cartan`), over a field of characteristic other than
`2`: a subgroup of index `2` is normal, and the Cartan subgroup has index `2` in its normalizer. -/
lemma IsCartanSubgroup.eq_normalizer_of_relIndex_eq_two (hC : IsCartanSubgroup C)
    (h2 : (2 : F) ≠ 0) {K : Subgroup (GL (Fin 2) F)} (hCK : C ≤ K) (hK : C.relIndex K = 2) :
    K = Subgroup.normalizer (C : Set (GL (Fin 2) F)) := by
  have : (C.subgroupOf K).Normal := Subgroup.normal_of_index_eq_two hK
  have hle : K ≤ Subgroup.normalizer (C : Set (GL (Fin 2) F)) :=
    Subgroup.le_normalizer_of_normal_subgroupOf hCK
  have h : C.relIndex K * K.relIndex (Subgroup.normalizer (C : Set (GL (Fin 2) F))) =
      C.relIndex (Subgroup.normalizer (C : Set (GL (Fin 2) F))) :=
    C.relIndex_mul_relIndex K _ hCK hle
  rw [hK, hC.relIndex_normalizer h2] at h
  exact le_antisymm hle (Subgroup.relIndex_eq_one.mp (by omega))

end Predicates

section PrimeField

variable {p : ℕ} [Fact p.Prime] {H : Subgroup (GL (Fin 2) (ZMod p))}

/-- **The normalizer of a Cartan subgroup of `GL₂(𝔽_p)` contains a Cartan subgroup with index `2`**
(LMFDB `gl2.normalizer_cartan`), for every prime `p`: for `p > 2` it is the normalizer of a Cartan
subgroup, which has index `2` in it, and for `p = 2` this is the definition. -/
lemma IsCartanNormalizer.exists_relIndex_eq_two (hH : IsCartanNormalizer H) :
    ∃ C : Subgroup (GL (Fin 2) (ZMod p)), IsCartanSubgroup C ∧ C ≤ H ∧ C.relIndex H = 2 := by
  rcases hH with ⟨C, hC, h⟩
  split_ifs at h with hp
  · exact ⟨C, hC, h⟩
  · rw [h]
    exact ⟨C, hC, Subgroup.le_normalizer, hC.relIndex_normalizer (two_ne_zero_of_ne_two p hp)⟩

/-- **The normalizer of a split Cartan subgroup of `GL₂(𝔽_p)` contains a split Cartan subgroup with
index `2`** (LMFDB `gl2.normalizer_cartan`), for every prime `p`. -/
lemma IsSplitCartanNormalizer.exists_relIndex_eq_two (hH : IsSplitCartanNormalizer H) :
    ∃ C : Subgroup (GL (Fin 2) (ZMod p)), IsSplitCartanSubgroup C ∧ C ≤ H ∧ C.relIndex H = 2 := by
  rcases hH with ⟨C, hC, h⟩
  split_ifs at h with hp
  · exact ⟨C, hC, h⟩
  · rw [h]
    exact ⟨C, hC, Subgroup.le_normalizer, hC.1.relIndex_normalizer (two_ne_zero_of_ne_two p hp)⟩

/-- **The normalizers of Cartan subgroups of `GL₂(𝔽_p)` are exactly the subgroups containing a
Cartan subgroup with index `2`** (LMFDB `gl2.normalizer_cartan`), for every prime `p`. -/
lemma isCartanNormalizer_iff_exists_relIndex_eq_two : IsCartanNormalizer H ↔
    ∃ C : Subgroup (GL (Fin 2) (ZMod p)), IsCartanSubgroup C ∧ C ≤ H ∧ C.relIndex H = 2 := by
  refine ⟨IsCartanNormalizer.exists_relIndex_eq_two, fun ⟨C, hC, hCH, hH⟩ ↦ ⟨C, hC, ?_⟩⟩
  split_ifs with hp
  · exact ⟨hCH, hH⟩
  · exact hC.eq_normalizer_of_relIndex_eq_two (two_ne_zero_of_ne_two p hp) hCH hH

/-- **The normalizers of split Cartan subgroups of `GL₂(𝔽_p)` are exactly the subgroups containing
a split Cartan subgroup with index `2`** (LMFDB `gl2.normalizer_split_cartan`), for every prime
`p`. -/
lemma isSplitCartanNormalizer_iff_exists_relIndex_eq_two : IsSplitCartanNormalizer H ↔
    ∃ C : Subgroup (GL (Fin 2) (ZMod p)), IsSplitCartanSubgroup C ∧ C ≤ H ∧
      C.relIndex H = 2 := by
  refine ⟨IsSplitCartanNormalizer.exists_relIndex_eq_two, fun ⟨C, hC, hCH, hH⟩ ↦ ⟨C, hC, ?_⟩⟩
  split_ifs with hp
  · exact ⟨hCH, hH⟩
  · exact hC.1.eq_normalizer_of_relIndex_eq_two (two_ne_zero_of_ne_two p hp) hCH hH

/-- **The normalizer of a non-split Cartan subgroup of `GL₂(𝔽_p)` contains a non-split Cartan
subgroup with index `2`** (LMFDB `gl2.normalizer_cartan`), for every prime `p`. -/
lemma IsNonsplitCartanNormalizer.exists_relIndex_eq_two (hH : IsNonsplitCartanNormalizer H) :
    ∃ C : Subgroup (GL (Fin 2) (ZMod p)), IsNonsplitCartanSubgroup C ∧ C ≤ H ∧
      C.relIndex H = 2 := by
  rcases hH with ⟨C, hC, h⟩
  split_ifs at h with hp
  · exact ⟨C, hC, h⟩
  · rw [h]
    exact ⟨C, hC, Subgroup.le_normalizer, hC.1.relIndex_normalizer (two_ne_zero_of_ne_two p hp)⟩

/-- **The normalizers of non-split Cartan subgroups of `GL₂(𝔽_p)` are exactly the subgroups
containing a non-split Cartan subgroup with index `2`** (LMFDB `gl2.normalizer_nonsplit_cartan`),
for every prime `p`. -/
lemma isNonsplitCartanNormalizer_iff_exists_relIndex_eq_two : IsNonsplitCartanNormalizer H ↔
    ∃ C : Subgroup (GL (Fin 2) (ZMod p)), IsNonsplitCartanSubgroup C ∧ C ≤ H ∧
      C.relIndex H = 2 := by
  refine ⟨IsNonsplitCartanNormalizer.exists_relIndex_eq_two, fun ⟨C, hC, hCH, hH⟩ ↦ ⟨C, hC, ?_⟩⟩
  split_ifs with hp
  · exact ⟨hCH, hH⟩
  · exact hC.1.eq_normalizer_of_relIndex_eq_two (two_ne_zero_of_ne_two p hp) hCH hH

lemma exists_map_conj_eq_of_natCard_eq_two {K K' : Subgroup (GL (Fin 2) (ZMod 2))}
    (hK : Nat.card K = 2) (hK' : Nat.card K' = 2) :
    ∃ g : GL (Fin 2) (ZMod 2), K.map (MulAut.conj g).toMonoidHom = K' := by
  have hG : Nat.card (GL (Fin 2) (ZMod 2)) = 6 := natCard_GL_fin_two_of_card_eq_two (ZMod.card 2)
  have hindex (L : Subgroup (GL (Fin 2) (ZMod 2))) (hL : Nat.card L = 2) : ¬2 ∣ L.index := by
    have h : Nat.card L * L.index = Nat.card (GL (Fin 2) (ZMod 2)) := L.card_mul_index
    rw [hL, hG] at h
    omega
  let P : Sylow 2 (GL (Fin 2) (ZMod 2)) :=
    (IsPGroup.of_card (hK.trans (pow_one 2).symm)).toSylow (hindex K hK)
  let Q : Sylow 2 (GL (Fin 2) (ZMod 2)) :=
    (IsPGroup.of_card (hK'.trans (pow_one 2).symm)).toSylow (hindex K' hK')
  have : Finite (Sylow 2 (GL (Fin 2) (ZMod 2))) := P.finite_of_finiteIndex
  rcases MulAction.exists_smul_eq (GL (Fin 2) (ZMod 2)) P Q with ⟨g, hg⟩
  exact ⟨g, congr_arg Sylow.toSubgroup hg⟩

lemma natCard_gl2Borel_two : Nat.card (GL2Borel (ZMod 2)) = 2 := by
  rw [GL2Borel.card_eq, ZMod.card]
  rfl

/-- **For `p = 2`, the normalizer of a split Cartan subgroup has order `2`** (LMFDB
`gl2.normalizer_cartan`): the split Cartan subgroups of `GL₂(𝔽₂)`, conjugates of the group of
invertible diagonal matrices, are trivial. -/
lemma IsSplitCartanNormalizer.natCard_eq_two (hH : IsSplitCartanNormalizer H) (hp : p = 2) :
    Nat.card H = 2 := by
  subst hp
  rcases hH with ⟨C, hC, h⟩
  rw [ite_eq_left rfl] at h
  rcases hC.exists_map_conj_eq with ⟨g, hg⟩
  rw [diagonalTorus_eq_bot, Subgroup.map_eq_bot_iff_of_injective _ (MulAut.conj g).injective] at hg
  rw [hg, Subgroup.relIndex_bot_left] at h
  exact h.2

/-- **For `p = 2`, the normalizer of a split Cartan subgroup is conjugate to the Borel subgroup**
(LMFDB `gl2.normalizer_cartan`): both have order `2`, so are Sylow `2`-subgroups of `GL₂(𝔽₂)`. -/
lemma IsSplitCartanNormalizer.isBorelSubgroup (hH : IsSplitCartanNormalizer H) (hp : p = 2) :
    IsBorelSubgroup H := by
  subst hp
  rcases exists_map_conj_eq_of_natCard_eq_two natCard_gl2Borel_two (hH.natCard_eq_two rfl) with
    ⟨g, hg⟩
  exact ⟨g, hg.symm⟩

/-- **For `p = 2`, the normalizer of a non-split Cartan subgroup is `GL₂(𝔽₂)`** (LMFDB
`gl2.normalizer_cartan`): the non-split Cartan subgroup is nontrivial, and twice its order divides
`6`, so it has order `3` and its normalizer order `6`. -/
lemma IsNonsplitCartanNormalizer.eq_top (hH : IsNonsplitCartanNormalizer H) (hp : p = 2) :
    H = ⊤ := by
  subst hp
  rcases hH with ⟨C, hC, h⟩
  rw [ite_eq_left rfl] at h
  have hG : Nat.card (GL (Fin 2) (ZMod 2)) = 6 := natCard_GL_fin_two_of_card_eq_two (ZMod.card 2)
  have hCH : 2 * Nat.card C = Nat.card H := by
    have h' : C.relIndex H * Nat.card (C ⊓ H : Subgroup (GL (Fin 2) (ZMod 2))) = Nat.card H :=
      C.relIndex_mul_card H
    rwa [h.2, inf_eq_left.mpr h.1] at h'
  have hC₁ : Nat.card C ≠ 1 := fun h₁ ↦ hC.2 1 <| by
    rw [Subgroup.card_eq_one.mp h₁, Subgroup.map_bot]
    exact bot_le
  have hdvd : 2 * Nat.card C ∣ 6 := by
    rw [hCH, ← hG]
    exact Subgroup.card_subgroup_dvd_card H
  rcases (Nat.dvd_prime Nat.prime_three).mp
    (Nat.dvd_of_mul_dvd_mul_left two_pos (hdvd : 2 * Nat.card C ∣ 2 * 3)) with h₁ | h₃
  · exact absurd h₁ hC₁
  · exact H.eq_top_of_card_eq (by rw [← hCH, h₃, hG])

end PrimeField

