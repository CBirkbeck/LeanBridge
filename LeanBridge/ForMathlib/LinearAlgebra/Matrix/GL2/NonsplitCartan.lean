import Mathlib.Algebra.QuadraticAlgebra.Basic
import Mathlib.RingTheory.Etale.Field
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.CartanNormalizer
import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.LeastPrimitiveRoot
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Borel
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Card

/-!
# The non-split Cartan subgroup `Cn` and its normalizer `Nn`

The LMFDB names subgroups of `GL₂(𝔽_p)` by Sutherland's labels. For `p > 2` the non-split Cartan
subgroup `Cn` consists of the matrices `!![x, ε * y; y, x]` with `(x, y) ≠ 0`, where `ε` is the
least primitive root modulo `p`; it is the image of `𝔽_{p²}ˣ = 𝔽_p[√ε]ˣ` in the basis `(1, √ε)`.
For `p = 2`, `Cn` is the unique subgroup of index `2` of `GL₂(𝔽₂)`, the image of `𝔽₄ˣ = 𝔽₂[ω]ˣ`,
`ω² = 1 + ω`, in the basis `(1, ω)`. Both are the Cartan subgroup of the quadratic algebra
`NonsplitCartanAlgebra p` in its standard basis. Its extended Cartan subgroup `Nn` is generated by
`Cn` and the matrix `!![1, 0; 0, -1]` for `p > 2`, where it is the normalizer of `Cn`, and is all
of `GL₂(𝔽₂)` for `p = 2`, as the LMFDB prescribes. The labels `Cn.a.b` and `Nn.a.b` name the
subgroups generated by explicit matrices; the choice of `a` and `b` minimal among those giving the
same subgroup is a labelling convention, not part of the definitions.

## Main definitions

* `Matrix.GeneralLinearGroup.NonsplitCartanAlgebra p`: the field `𝔽_{p²}` as `𝔽_p[ω]`, with
  `ω² = ε` for odd `p` and `ω² = 1 + ω` for `p = 2`.
* `Matrix.GeneralLinearGroup.labelCn` (LMFDB `gl2.nonsplit_cartan`): the group `Cn`.
* `Matrix.GeneralLinearGroup.labelNn` (LMFDB `gl2.normalizer_nonsplit_cartan`): the group `Nn`.
* `Matrix.GeneralLinearGroup.labelCnAB` (LMFDB `gl2.nonsplit_cartan`) and
  `Matrix.GeneralLinearGroup.labelNnAB` (LMFDB `gl2.normalizer_nonsplit_cartan`): the groups
  `Cn.a.b` and `Nn.a.b`.

## Main results

* `Matrix.GeneralLinearGroup.mem_cartanSubgroup_quadraticAlgebra_iff`: the Cartan subgroup of a
  quadratic field `K[ω]`, `ω² = a + b ω`, consists of the invertible matrices
  `!![x, a * y; y, x + b * y]`.
* `Matrix.GeneralLinearGroup.mem_labelCn_iff`: for `p > 2`, `Cn` consists of the invertible
  matrices `!![x, ε * y; y, x]`.
* `Matrix.GeneralLinearGroup.labelCn_two_eq_of_index_eq_two`: `Cn` is the unique subgroup of index
  `2` of `GL₂(𝔽₂)`.
* `Matrix.GeneralLinearGroup.isNonsplitCartanSubgroup_labelCn`: `Cn` is a non-split Cartan subgroup.
* `Matrix.GeneralLinearGroup.relIndex_labelCn_labelNn`: `Cn` has index `2` in `Nn`.
* `Matrix.GeneralLinearGroup.labelNn_eq_sup`: for `p > 2`, `Nn` is generated by `Cn` and
  `!![1, 0; 0, -1]`; `Matrix.GeneralLinearGroup.labelNn_two`: `Nn = GL₂(𝔽₂)` for `p = 2`.
* `Matrix.GeneralLinearGroup.labelNn_eq_normalizer`: for `p > 2`, `Nn` is the normalizer of `Cn`.
* `Matrix.GeneralLinearGroup.isNonsplitCartanNormalizer_labelNn`: `Nn` is the normalizer of a
  non-split Cartan subgroup in the LMFDB's sense, for every prime `p`.
-/

open Algebra Matrix TauCeti

namespace Matrix.GeneralLinearGroup

section QuadraticAlgebra

variable {R : Type*} [CommRing R] (a b : R)

lemma leftMulMatrix_quadraticAlgebra (z : QuadraticAlgebra R a b) :
    Algebra.leftMulMatrix (QuadraticAlgebra.basis a b) z =
    !![z.re, a * z.im; z.im, z.re + b * z.im] := by
  ext i j
  rw [Algebra.leftMulMatrix_eq_repr_mul, QuadraticAlgebra.basis_repr_apply]
  fin_cases i <;> fin_cases j <;> simp

lemma coe_canonicalInvolutionGL_quadraticAlgebra :
    (canonicalInvolutionGL (QuadraticAlgebra.basis a b)).val = !![1, b; 0, -1] := by
  ext i j
  rw [coe_canonicalInvolutionGL, LinearMap.toMatrix_apply, QuadraticAlgebra.basis_repr_apply,
    canonicalInvolution_apply, Algebra.trace_eq_matrix_trace (QuadraticAlgebra.basis a b),
    leftMulMatrix_quadraticAlgebra]
  fin_cases i <;> fin_cases j <;> simp [QuadraticAlgebra.re_one, QuadraticAlgebra.im_one]

end QuadraticAlgebra

/-- **The Cartan subgroup of a quadratic field** `K[ω]`, `ω² = a + b ω`, in the basis `(1, ω)`
consists of the invertible matrices `!![x, a * y; y, x + b * y]`. -/
lemma mem_cartanSubgroup_quadraticAlgebra_iff {K : Type*} [Field K] {a b : K}
    [Fact (∀ r : K, r ^ 2 ≠ a + b * r)] {g : GL (Fin 2) K} : g ∈
    cartanSubgroup (QuadraticAlgebra.basis a b) ↔ g 0 1 = a * g 1 0 ∧ g 1 1 = g 0 0 + b *
    g 1 0 := by
  refine ⟨?_, fun ⟨h₀₁, h₁₁⟩ ↦ ?_⟩
  · rintro ⟨u, rfl⟩
    simp [leftMulMatrix_quadraticAlgebra]
  · have hz : (⟨g 0 0, g 1 0⟩ : QuadraticAlgebra K a b) ≠ 0 := fun hz ↦ by
      have h₀ : g 0 0 = 0 := congr_arg QuadraticAlgebra.re hz
      have h₁ : g 1 0 = 0 := congr_arg QuadraticAlgebra.im hz
      exact det_ne_zero g (by rw [Matrix.det_fin_two, h₀, h₁]; ring1)
    refine ⟨Units.mk0 _ hz, Units.ext ?_⟩
    ext i j
    fin_cases i <;> fin_cases j <;> simp [leftMulMatrix_quadraticAlgebra, h₀₁, h₁₁]

variable (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) {g : GL (Fin 2) (ZMod p)} (a b : ℕ)

/-- The coefficient `a` of the non-split algebra `𝔽_p[ω]`, `ω² = a + b ω`, used for `Cn`: the least
primitive root `ε` modulo `p` for odd `p`, and `1` for `p = 2`. -/
noncomputable def nonsplitCartanA : ZMod p :=
  if p = 2 then 1 else (ZMod.leastPrimitiveRoot p : ZMod p)

/-- The coefficient `b` of the non-split algebra `𝔽_p[ω]`, `ω² = a + b ω`, used for `Cn`: `0` for
odd `p`, and `1` for `p = 2`. -/
noncomputable def nonsplitCartanB : ZMod p :=
  if p = 2 then 1 else 0

include hp in
lemma nonsplitCartanA_of_ne_two : nonsplitCartanA p = (ZMod.leastPrimitiveRoot p : ZMod p) :=
  ite_eq_right hp

include hp in
lemma nonsplitCartanB_of_ne_two : nonsplitCartanB p = 0 :=
  ite_eq_right hp

lemma sq_ne_nonsplitCartanA_add (r : ZMod p) :
    r ^ 2 ≠ nonsplitCartanA p + nonsplitCartanB p * r := by
  by_cases hp : p = 2
  · subst hp
    decide +revert
  · rw [nonsplitCartanA_of_ne_two p hp, nonsplitCartanB_of_ne_two p hp, zero_mul, add_zero]
    exact fun h ↦ ZMod.not_isSquare_leastPrimitiveRoot p hp ⟨r, by rw [← h, sq]⟩

instance : Fact (∀ r : ZMod p, r ^ 2 ≠ nonsplitCartanA p + nonsplitCartanB p * r) :=
  ⟨sq_ne_nonsplitCartanA_add p⟩

/-- The field `𝔽_{p²}`, as the quadratic algebra `𝔽_p[ω]` with `ω² = ε` (`ε` the least primitive
root modulo `p`) for odd `p` and `ω² = 1 + ω` for `p = 2`; `Cn` is its Cartan subgroup in the
basis `(1, ω)`. -/
abbrev NonsplitCartanAlgebra : Type :=
  QuadraticAlgebra (ZMod p) (nonsplitCartanA p) (nonsplitCartanB p)

/-- The basis `(1, ω)` of `NonsplitCartanAlgebra p`. -/
noncomputable abbrev nonsplitCartanBasis :
    Module.Basis (Fin 2) (ZMod p) (NonsplitCartanAlgebra p) :=
  QuadraticAlgebra.basis (nonsplitCartanA p) (nonsplitCartanB p)

instance : Algebra.Etale (ZMod p) (NonsplitCartanAlgebra p) where
  formallyEtale := FormallyEtale.of_isSeparable _ _
  finitePresentation := FinitePresentation.of_finiteType.mp inferInstance

/-- The group `Cn` (LMFDB `gl2.nonsplit_cartan`): the Cartan subgroup of the field
`NonsplitCartanAlgebra p = 𝔽_{p²}` in the basis `(1, ω)`. For `p > 2` it consists of the
invertible matrices `!![x, ε * y; y, x]` (`mem_labelCn_iff`); for `p = 2` it is the unique
subgroup of index `2` of `GL₂(𝔽₂)` (`labelCn_two_eq_of_index_eq_two`). -/
noncomputable def labelCn : Subgroup (GL (Fin 2) (ZMod p)) :=
  cartanSubgroup (nonsplitCartanBasis p)

include hp in
/-- **For `p > 2`, `Cn` consists of the invertible matrices `!![x, ε * y; y, x]`**, where `ε` is
the least primitive root modulo `p`. -/
lemma mem_labelCn_iff :
    g ∈ labelCn p ↔ g 1 1 = g 0 0 ∧ g 0 1 = (ZMod.leastPrimitiveRoot p : ZMod p) * g 1 0 := by
  rw [labelCn, mem_cartanSubgroup_quadraticAlgebra_iff, nonsplitCartanA_of_ne_two p hp,
    nonsplitCartanB_of_ne_two p hp, zero_mul, add_zero, and_comm]

lemma omega_ne_zero : (⟨0, 1⟩ : NonsplitCartanAlgebra p) ≠ 0 :=
  fun h ↦ one_ne_zero (congr_arg QuadraticAlgebra.im h)

/-- The matrix `!![0, a; 1, b]` of multiplication by `ω`, an element of `Cn`. -/
noncomputable def omegaGL : GL (Fin 2) (ZMod p) :=
  unitsLeftMulMatrix (nonsplitCartanBasis p) (Units.mk0 _ (omega_ne_zero p))

lemma coe_omegaGL : (omegaGL p).val = !![0, nonsplitCartanA p; 1, nonsplitCartanB p] := by
  simp [omegaGL, leftMulMatrix_quadraticAlgebra]

lemma omegaGL_mem_labelCn : omegaGL p ∈ labelCn p :=
  ⟨_, rfl⟩

/-- **`Cn` is a non-split Cartan subgroup** of `GL₂(𝔽_p)`, for every prime `p`: no conjugate of the
matrix of multiplication by `ω` is upper triangular, since it has no eigenvalue in `𝔽_p`. -/
lemma isNonsplitCartanSubgroup_labelCn : IsNonsplitCartanSubgroup (labelCn p) := by
  refine ⟨⟨NonsplitCartanAlgebra p, inferInstance, inferInstance, inferInstance, _, rfl⟩,
    fun g hg ↦ ?_⟩
  have hdiag : g * omegaGL p * g⁻¹ ∈ diagonalTorus (ZMod p) 2 :=
    hg ⟨_, omegaGL_mem_labelCn p, by simp⟩
  have hborel : g * omegaGL p * g⁻¹ ∈ GL2Borel (ZMod p) :=
    GL2Borel.mem_iff.mpr (mem_diagonalTorus_iff.mp hdiag (by decide))
  rcases GL2Borel.exists_det_sub_algebraMap_eq_zero hborel with ⟨t, ht⟩
  rw [coe_omegaGL, Matrix.det_fin_two] at ht
  refine sq_ne_nonsplitCartanA_add p t ?_
  simp [Matrix.algebraMap_matrix_apply] at ht
  linear_combination ht

lemma natCard_nonsplitCartanAlgebra : Nat.card (NonsplitCartanAlgebra p) = p ^ 2 := by
  rw [Nat.card_congr (QuadraticAlgebra.equivProd _ _), Nat.card_prod, Nat.card_zmod, sq]

lemma natCard_labelCn : Nat.card (labelCn p) = p ^ 2 - 1 := by
  rw [labelCn, cartanSubgroup,
    ← Nat.card_congr (MonoidHom.ofInjective (unitsLeftMulMatrix_injective _)).toEquiv,
    Nat.card_units, natCard_nonsplitCartanAlgebra]

lemma index_labelCn : (labelCn p).index = p * (p - 1) := by
  have h₂ : 2 ≤ p := (Fact.out : p.Prime).two_le
  have hcard : Nat.card (labelCn p) * (labelCn p).index = (p ^ 2 - 1) * (p * (p - 1)) := by
    rw [Subgroup.card_mul_index, natCard_GL_fin_two_eq_sq_sub_one_mul, ZMod.card]
  rw [natCard_labelCn] at hcard
  exact Nat.eq_of_mul_eq_mul_left (Nat.sub_pos_of_lt (Nat.one_lt_pow two_ne_zero h₂)) hcard

/-- **`Cn` is the unique subgroup of index `2` of `GL₂(𝔽₂)`**: every element of `Cn` has order
dividing `3`, so is a square, and a subgroup of index `2` contains all squares. -/
lemma labelCn_two_eq_of_index_eq_two {H : Subgroup (GL (Fin 2) (ZMod 2))} (hH : H.index = 2) :
    H = labelCn 2 := by
  have hle : labelCn 2 ≤ H := fun g hg ↦ by
    have h₃ : g ^ 3 = 1 := by
      have h₁ : (⟨g, hg⟩ : labelCn 2) ^ Nat.card (labelCn 2) = 1 := pow_card_eq_one'
      rw [natCard_labelCn] at h₁
      exact congr_arg Subtype.val h₁
    have h₄ : (g ^ 2) ^ 2 = g := by
      rw [← pow_mul, pow_succ, h₃, one_mul]
    exact h₄ ▸ Subgroup.sq_mem_of_index_two hH _
  have hcard : Nat.card H * H.index = Nat.card (GL (Fin 2) (ZMod 2)) := Subgroup.card_mul_index H
  rw [hH, natCard_GL_fin_two_eq_sq_sub_one_mul, ZMod.card] at hcard
  refine (Subgroup.eq_of_le_of_card_ge hle ?_).symm
  rw [natCard_labelCn]
  omega

/-- The group `Nn` (LMFDB `gl2.normalizer_nonsplit_cartan`): the extended Cartan subgroup of
`NonsplitCartanAlgebra p = 𝔽_{p²}` in the basis `(1, ω)`. For `p > 2` it is generated by `Cn` and
`!![1, 0; 0, -1]` (`labelNn_eq_sup`) and is the normalizer of `Cn` (`labelNn_eq_normalizer`); for
`p = 2` it is all of `GL₂(𝔽₂)` (`labelNn_two`), as the LMFDB prescribes. -/
noncomputable def labelNn : Subgroup (GL (Fin 2) (ZMod p)) :=
  extendedCartanSubgroup (nonsplitCartanBasis p)

lemma labelCn_le_labelNn : labelCn p ≤ labelNn p :=
  cartanSubgroup_le_extendedCartanSubgroup _

include hp in
lemma two_ne_zero_of_ne_two : (2 : ZMod p) ≠ 0 :=
  Ring.two_ne_zero (by rwa [ZMod.ringChar_zmod_n])

/-- **`Cn` has index `2` in `Nn`**, for every prime `p`. -/
lemma relIndex_labelCn_labelNn : (labelCn p).relIndex (labelNn p) = 2 := by
  refine relIndex_cartanSubgroup_extendedCartanSubgroup _ fun h ↦ ?_
  rw [mem_cartanSubgroup_quadraticAlgebra_iff, coe_canonicalInvolutionGL_quadraticAlgebra] at h
  simp at h
  by_cases hp : p = 2
  · subst hp
    simpa [nonsplitCartanB] using h.1
  · refine two_ne_zero_of_ne_two p hp ?_
    linear_combination -h.2

/-- **`Nn = GL₂(𝔽₂)`** for `p = 2`: `Cn` has index `2` in both. -/
lemma labelNn_two : labelNn 2 = ⊤ := by
  have h : (labelCn 2).relIndex (labelNn 2) * (labelNn 2).index = (labelCn 2).index :=
    Subgroup.relIndex_mul_index (labelCn_le_labelNn 2)
  rw [relIndex_labelCn_labelNn, index_labelCn] at h
  exact Subgroup.index_eq_one.mp (by omega)

include hp in
lemma coe_canonicalInvolutionGL_of_ne_two :
    (canonicalInvolutionGL (nonsplitCartanBasis p)).val = !![1, 0; 0, -1] := by
  rw [coe_canonicalInvolutionGL_quadraticAlgebra, nonsplitCartanB_of_ne_two p hp]

include hp in
/-- **For `p > 2`, `Nn` is generated by `Cn` and `!![1, 0; 0, -1]`.** -/
lemma labelNn_eq_sup : labelNn p = labelCn p ⊔ Subgroup.zpowers (diagGL ![1, -1]) := by
  have h : canonicalInvolutionGL (nonsplitCartanBasis p) = diagGL ![1, -1] := by
    refine Units.ext ?_
    rw [coe_canonicalInvolutionGL_of_ne_two p hp, diagGL_coe]
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  rw [labelNn, extendedCartanSubgroup, h]
  rfl

include hp in
lemma mem_labelCn_of_commute (h : g.val * (omegaGL p).val = (omegaGL p).val * g.val) :
    g ∈ labelCn p := by
  have hε : (ZMod.leastPrimitiveRoot p : ZMod p) ≠ 0 := ZMod.leastPrimitiveRoot_ne_zero p
  rw [coe_omegaGL, nonsplitCartanA_of_ne_two p hp, nonsplitCartanB_of_ne_two p hp] at h
  have h₀₀ : g 0 1 = ZMod.leastPrimitiveRoot p * g 1 0 := by
    simpa [Matrix.mul_apply] using congr_fun (congr_fun h 0) 0
  have h₀₁ : g 0 0 * ZMod.leastPrimitiveRoot p = ZMod.leastPrimitiveRoot p * g 1 1 := by
    simpa [Matrix.mul_apply] using congr_fun (congr_fun h 0) 1
  rw [mem_labelCn_iff p hp]
  exact ⟨(mul_left_cancel₀ hε ((mul_comm _ _).trans h₀₁)).symm, h₀₀⟩

include hp in
/-- **For `p > 2`, `Nn` is the normalizer of `Cn`** in `GL₂(𝔽_p)`. An element normalizing `Cn`
conjugates `ω` into `Cn` with the same trace `0` and determinant `-ε`, hence to `±ω`: in the first
case it commutes with `ω`, so lies in `Cn`, and in the second its product with `!![1, 0; 0, -1]`
does. -/
lemma labelNn_eq_normalizer :
    labelNn p = Subgroup.normalizer (labelCn p : Set (GL (Fin 2) (ZMod p))) := by
  refine le_antisymm (extendedCartanSubgroup_le_normalizer _) fun g hg ↦ ?_
  have hc : g * omegaGL p * g⁻¹ ∈ labelCn p :=
    (Subgroup.mem_normalizer_iff.mp hg _).mp (omegaGL_mem_labelCn p)
  have hω : (omegaGL p).val = !![0, (ZMod.leastPrimitiveRoot p : ZMod p); 1, 0] := by
    rw [coe_omegaGL, nonsplitCartanA_of_ne_two p hp, nonsplitCartanB_of_ne_two p hp]
  rw [mem_labelCn_iff p hp] at hc
  have htr : (g * omegaGL p * g⁻¹).val.trace = (omegaGL p).val.trace :=
    Matrix.trace_units_conj g (omegaGL p)
  have hdet : (g * omegaGL p * g⁻¹).val.det = (omegaGL p).val.det :=
    Matrix.det_units_conj g (omegaGL p)
  rw [Matrix.trace_fin_two, hc.1, hω, Matrix.trace_fin_two_of] at htr
  rw [Matrix.det_fin_two, hc.1, hc.2, hω, Matrix.det_fin_two_of] at hdet
  have h₀ : (g * omegaGL p * g⁻¹) 0 0 = 0 :=
    (mul_eq_zero.mp (by linear_combination htr : (2 : ZMod p) * _ = 0)).resolve_left
      (two_ne_zero_of_ne_two p hp)
  have hy : (g * omegaGL p * g⁻¹) 1 0 * (g * omegaGL p * g⁻¹) 1 0 = 1 :=
    mul_left_cancel₀ (ZMod.leastPrimitiveRoot_ne_zero p)
      (by linear_combination -hdet + (g * omegaGL p * g⁻¹) 0 0 * h₀)
  have hm : (g * omegaGL p * g⁻¹).val = (g * omegaGL p * g⁻¹) 1 0 • (omegaGL p).val := by
    rw [hω]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h₀, hc.1, hc.2, mul_comm]
  have hgω : g.val * (omegaGL p).val = (g * omegaGL p * g⁻¹) 1 0 • (omegaGL p).val * g.val := by
    rw [← hm, ← Units.val_mul, ← Units.val_mul, inv_mul_cancel_right]
  rcases mul_self_eq_one_iff.mp hy with hy₁ | hy₁ <;> rw [hy₁] at hgω
  · exact labelCn_le_labelNn p (mem_labelCn_of_commute p hp (by rwa [one_smul] at hgω))
  · have hσω : (canonicalInvolutionGL (nonsplitCartanBasis p)).val * (omegaGL p).val =
        -((omegaGL p).val * (canonicalInvolutionGL (nonsplitCartanBasis p)).val) := by
      rw [coe_canonicalInvolutionGL_of_ne_two p hp, hω]
      ext i j
      fin_cases i <;> fin_cases j <;> simp
    have hgσ : g * canonicalInvolutionGL (nonsplitCartanBasis p) ∈ labelCn p := by
      refine mem_labelCn_of_commute p hp ?_
      rw [Units.val_mul, Matrix.mul_assoc, hσω, Matrix.mul_neg, ← Matrix.mul_assoc, hgω,
        neg_one_smul, Matrix.neg_mul, Matrix.neg_mul, neg_neg, Matrix.mul_assoc]
    rw [← mul_one g, ← canonicalInvolutionGL_mul_self (nonsplitCartanBasis p), ← mul_assoc]
    exact mul_mem (labelCn_le_labelNn p hgσ) (canonicalInvolutionGL_mem_extendedCartanSubgroup _)

/-- **`Nn` is the normalizer of a non-split Cartan subgroup** of `GL₂(𝔽_p)` in the LMFDB's sense,
for every prime `p`. -/
lemma isNonsplitCartanNormalizer_labelNn : IsNonsplitCartanNormalizer (labelNn p) := by
  refine ⟨_, isNonsplitCartanSubgroup_labelCn p, ?_⟩
  split_ifs with hp
  · exact ⟨labelCn_le_labelNn p, relIndex_labelCn_labelNn p⟩
  · exact labelNn_eq_normalizer p hp

/-- The group `Cn.a.b` (LMFDB `gl2.nonsplit_cartan`), for `p > 2`: the subgroup of `Cn` generated by
the matrix `!![a, ε * b; b, a]`, where `ε` is the least primitive root modulo `p`. -/
noncomputable def labelCnAB : Subgroup (GL (Fin 2) (ZMod p)) :=
  Subgroup.closure
    (Units.val ⁻¹' {!![(a : ZMod p), (ZMod.leastPrimitiveRoot p : ZMod p) * b; (b : ZMod p), a]})

include hp in
lemma labelCnAB_le : labelCnAB p a b ≤ labelCn p := by
  refine (Subgroup.closure_le _).mpr fun g hg ↦ ?_
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hg
  rw [SetLike.mem_coe, mem_labelCn_iff p hp]
  simp [hg]

/-- The group `Nn.a.b` (LMFDB `gl2.normalizer_nonsplit_cartan`), for `p > 2`: the subgroup of `Nn`
generated by the matrices `!![a, ε * b; b, a]` and `!![1, 0; 0, -1]`, where `ε` is the least
primitive root modulo `p`. -/
noncomputable def labelNnAB : Subgroup (GL (Fin 2) (ZMod p)) :=
  Subgroup.closure (Units.val ⁻¹'
    {!![(a : ZMod p), (ZMod.leastPrimitiveRoot p : ZMod p) * b; (b : ZMod p), a], !![1, 0; 0, -1]})

include hp in
lemma labelNnAB_le : labelNnAB p a b ≤ labelNn p := by
  refine (Subgroup.closure_le _).mpr fun g hg ↦ ?_
  simp only [Set.mem_preimage] at hg
  rcases hg with hg | hg
  · exact labelCn_le_labelNn p ((mem_labelCn_iff p hp).mpr (by simp [hg]))
  · have h : g = canonicalInvolutionGL (nonsplitCartanBasis p) :=
      Units.ext (by rw [hg, coe_canonicalInvolutionGL_of_ne_two p hp])
    rw [SetLike.mem_coe, h]
    exact canonicalInvolutionGL_mem_extendedCartanSubgroup _

end Matrix.GeneralLinearGroup
