import LeanBridge.ForMathlib.LinearAlgebra.Matrix.GL2.LeastPrimitiveRoot
import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.Borel

/-!
# Borel subgroups of `GL_n` and the labels `B`, `B.a.b`

A Borel subgroup of a general linear group is a conjugate of the subgroup of invertible upper
triangular matrices, Tau Ceti's `TauCeti.upperTriangularGroup`, whose `2 × 2` case is
`TauCeti.GL2Borel`. The LMFDB names subgroups of `GL₂(𝔽_p)` by Sutherland's labels: `B` is
`TauCeti.GL2Borel (ZMod p)`, and `B.a.b` is the subgroup of it generated by explicit matrices,
normalised by the least primitive root `r` modulo `p`; the choice of `a` and `b` minimal among those
giving the same subgroup is a labelling convention, not part of the definition.

## Main definitions

* `Matrix.GeneralLinearGroup.IsBorelSubgroup` (LMFDB `gl2.borel`): conjugacy to the upper
  triangular subgroup.
* `Matrix.GeneralLinearGroup.lineStabilizer`: the stabilizer in `GL₂(F)` of a line of `F²`.
* `Matrix.GeneralLinearGroup.labelBAB` (LMFDB `gl2.borel`): the group `B.a.b`.

## Main results

* `Matrix.GeneralLinearGroup.IsBorelSubgroup.map_conj`: a conjugate of a Borel subgroup is a Borel
  subgroup.
* `Matrix.GeneralLinearGroup.gl2Borel_eq_lineStabilizer`: the upper triangular subgroup of `GL₂(F)`
  is the stabilizer of the line spanned by the first basis vector.
* `Matrix.GeneralLinearGroup.isBorelSubgroup_iff_exists_lineStabilizer`: the Borel subgroups of
  `GL₂(F)` are the stabilizers of the lines of `F²`.
-/

open Matrix TauCeti

namespace Matrix.GeneralLinearGroup

section Borel

variable {n : Type*} [Fintype n] [LinearOrder n] {R : Type*} [CommRing R] {H : Subgroup (GL n R)}

variable (H) in
/-- A subgroup of `GL_n(R)` is a **Borel subgroup** (LMFDB `gl2.borel`) if it is conjugate to the
subgroup `TauCeti.upperTriangularGroup n R` of invertible upper triangular matrices. -/
def IsBorelSubgroup : Prop :=
  ∃ g : GL n R, H = (upperTriangularGroup n R).map (MulAut.conj g).toMonoidHom

lemma isBorelSubgroup_upperTriangularGroup : IsBorelSubgroup (upperTriangularGroup n R) :=
  ⟨1, by ext; simp⟩

/-- **A conjugate of a Borel subgroup is a Borel subgroup.** -/
lemma IsBorelSubgroup.map_conj (hH : IsBorelSubgroup H) (g : GL n R) :
    IsBorelSubgroup (H.map (MulAut.conj g).toMonoidHom) := by
  rcases hH with ⟨h, rfl⟩
  refine ⟨g * h, ?_⟩
  rw [Subgroup.map_map, map_mul]
  rfl

end Borel

variable {F : Type*} [Field F] {v : Fin 2 → F} (p : ℕ) [Fact p.Prime] (a b : ℕ)

variable (v) in
/-- The stabilizer in `GL₂(F)` of the line spanned by a vector `v` of `F²`: the elements having
`v` as an eigenvector. -/
def lineStabilizer : Subgroup (GL (Fin 2) F) where
  carrier := {g | ∃ c : F, (g : Matrix (Fin 2) (Fin 2) F) *ᵥ v = c • v}
  one_mem' := ⟨1, by rw [Units.val_one, Matrix.one_mulVec, one_smul]⟩
  mul_mem' := by
    rintro g h ⟨c, hc⟩ ⟨d, hd⟩
    exact ⟨c * d, by rw [Units.val_mul, ← Matrix.mulVec_mulVec, hd, Matrix.mulVec_smul, hc,
      smul_smul, mul_comm]⟩
  inv_mem' := by
    rintro g ⟨c, hc⟩
    by_cases hv : v = 0
    · exact ⟨0, by rw [hv, Matrix.mulVec_zero, smul_zero]⟩
    have h₁ : v = c • ((g⁻¹ : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) *ᵥ v := by
      rw [← Matrix.mulVec_smul, ← hc, Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel,
        Units.val_one, Matrix.one_mulVec]
    have hc₀ : c ≠ 0 := by
      rintro rfl
      exact hv (by rw [h₁, zero_smul])
    refine ⟨c⁻¹, ?_⟩
    nth_rw 2 [h₁]
    rw [smul_smul, inv_mul_cancel₀ hc₀, one_smul]

lemma mem_lineStabilizer {g : GL (Fin 2) F} :
    g ∈ lineStabilizer v ↔ ∃ c : F, (g : Matrix (Fin 2) (Fin 2) F) *ᵥ v = c • v :=
  Iff.rfl

/-- **The upper triangular subgroup of `GL₂(F)` is the stabilizer of the line spanned by the first
basis vector.** -/
lemma gl2Borel_eq_lineStabilizer : GL2Borel F = lineStabilizer (Pi.single 0 1) := by
  ext g
  rw [GL2Borel.mem_iff, mem_lineStabilizer]
  refine ⟨fun h ↦ ⟨g 0 0, ?_⟩, fun ⟨c, hc⟩ ↦ ?_⟩
  · ext i
    fin_cases i <;> simp [h]
  · simpa using congr_fun hc 1

lemma lineStabilizer_mulVec (h : GL (Fin 2) F) :
    lineStabilizer ((h : Matrix (Fin 2) (Fin 2) F) *ᵥ v) =
    (lineStabilizer v).map (MulAut.conj h).toMonoidHom := by
  ext g
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply, mem_lineStabilizer, mem_lineStabilizer]
  refine exists_congr fun c ↦ ⟨fun hc ↦ ?_, fun hc ↦ ?_⟩
  · rw [Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hc,
      Matrix.mulVec_smul, Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
      Matrix.one_mulVec]
  · rw [Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec] at hc
    rw [← Matrix.one_mulVec (_ *ᵥ _), ← Units.val_one, ← mul_inv_cancel h, Units.val_mul,
      ← Matrix.mulVec_mulVec, hc, Matrix.mulVec_smul]

lemma exists_mulVec_single_eq (hv : v ≠ 0) :
    ∃ h : GL (Fin 2) F, (h : Matrix (Fin 2) (Fin 2) F) *ᵥ Pi.single 0 1 = v := by
  by_cases h₀ : v 0 = 0
  · have h₁ : v 1 ≠ 0 := fun h₁ ↦ hv (funext fun i ↦ by fin_cases i <;> assumption)
    refine ⟨mkOfDetNeZero !![v 0, 1; v 1, 0] (by simpa using h₁), ?_⟩
    ext i
    fin_cases i <;> simp
  · refine ⟨mkOfDetNeZero !![v 0, 0; v 1, 1] (by simpa using h₀), ?_⟩
    ext i
    fin_cases i <;> simp

/-- **The Borel subgroups of `GL₂(F)` are the stabilizers of the lines of `F²`** (LMFDB
`gl2.borel`), all of them conjugate to the upper triangular subgroup. -/
lemma isBorelSubgroup_iff_exists_lineStabilizer {H : Subgroup (GL (Fin 2) F)} :
    IsBorelSubgroup H ↔ ∃ v : Fin 2 → F, v ≠ 0 ∧ H = lineStabilizer v := by
  refine ⟨fun ⟨g, hg⟩ ↦ ⟨(g : Matrix (Fin 2) (Fin 2) F) *ᵥ Pi.single 0 1, fun h ↦ ?_, ?_⟩,
    fun ⟨v, hv, hH⟩ ↦ ?_⟩
  · have h₁ : (Pi.single 0 1 : Fin 2 → F) = 0 := by
      rw [← Matrix.one_mulVec (Pi.single 0 1), ← Units.val_one, ← inv_mul_cancel g, Units.val_mul,
        ← Matrix.mulVec_mulVec, h, Matrix.mulVec_zero]
    exact one_ne_zero (congr_fun h₁ 0)
  · rw [hg, lineStabilizer_mulVec, ← gl2Borel_eq_lineStabilizer]
  · rcases exists_mulVec_single_eq hv with ⟨h, rfl⟩
    rw [hH, lineStabilizer_mulVec, ← gl2Borel_eq_lineStabilizer]
    exact ⟨h, rfl⟩

/-- The group `B.a.b` (LMFDB `gl2.borel`): the subgroup of the Borel subgroup `B` of `GL₂(𝔽_p)`
generated by the matrices `!![a, 0; 0, 1/a]`, `!![b, 0; 0, r/b]` and `!![1, 1; 0, 1]`, where `r`
is the least primitive root modulo `p`. A listed matrix that is not invertible (`p ∣ a` or
`p ∣ b`) is not among the generators; the label uses minimal positive integers `a` and `b`, which
avoids this. -/
noncomputable def labelBAB : Subgroup (GL (Fin 2) (ZMod p)) :=
  Subgroup.closure (Units.val ⁻¹' {!![(a : ZMod p), 0; 0, (a : ZMod p)⁻¹],
    !![(b : ZMod p), 0; 0, (ZMod.leastPrimitiveRoot p : ZMod p) / b], !![1, 1; 0, 1]})

lemma labelBAB_le : labelBAB p a b ≤ GL2Borel (ZMod p) := by
  refine (Subgroup.closure_le _).mpr fun g hg ↦ ?_
  simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rw [SetLike.mem_coe, GL2Borel.mem_iff]
  rcases hg with hg | hg | hg <;> simp [hg]

end Matrix.GeneralLinearGroup
