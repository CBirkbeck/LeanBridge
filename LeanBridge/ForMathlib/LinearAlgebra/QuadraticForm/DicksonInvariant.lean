import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.OmegaGroup
import Mathlib.Algebra.CharP.Two
import Mathlib.LinearAlgebra.Dual.Lemmas
import TauCeti.LinearAlgebra.BilinearForm.SymplecticBasis
import TauCeti.LinearAlgebra.QuadraticForm.Prod
import TauCeti.LinearAlgebra.QuadraticForm.Transvection.Basic

/-!
# The Dickson invariant of an orthogonal group in characteristic `2`

Let `Q` be a quadratic form on a finite-dimensional vector space `V` over a field `K` of
characteristic `2` whose polar form `B` is nondegenerate, so that `V` has even dimension
(`QuadraticForm.even_finrank_of_charTwo`). The **Dickson invariant** of `g ∈ O(Q)` is the rank of
`g - 1` modulo `2`; since `dim V` is even, it is also the dimension of the fixed space of `g` modulo
`2`, the exponent of the *quasideterminant* `g ↦ (-1) ^ dim ker (g - 1)` of LMFDB `group.omega`
(`QuadraticForm.quasideterminant`). We prove that it is a homomorphism `O(Q) → ℤ/2`
(`QuadraticForm.finrank_range_mul_sub_one`), whose kernel is the group `Ω` of LMFDB `group.omega`
in characteristic `2`.

The proof uses the transvections `t_a : x ↦ x + (B(a, x) / Q(a)) a`, for `Q(a) ≠ 0`: Tau Ceti's
`TauCeti.QuadraticMap.reflection`, which in characteristic `2` is a transvection.

* For every `g ∈ O(Q)`, the ranks of `g t_a - 1` and `g - 1` have different parities
  (`QuadraticForm.finrank_range_mul_reflection_sub_one`): `g` and `g t_a` agree on the hyperplane
  `a^⊥`, and exactly one of their fixed spaces lies in `a^⊥`, according as `a` lies in the image of
  `g - 1` or not. This holds in every characteristic.
* So the parity of `rank(g - 1)` is additive on products with an element of the subgroup
  generated by the transvections.
* Every `g ∈ O(Q)`, extended by the identity to the orthogonal sum `V ⊕ H` with a hyperbolic plane
  `H`, lies in the subgroup generated by the transvections of `V ⊕ H`
  (`QuadraticForm.prodCongr_mem_closure`), by induction on `rank(g - 1)`. If the image of `g - 1`
  contains a vector `a` with `Q(a) ≠ 0`, then `rank(g t_a - 1) < rank(g - 1)`. Otherwise that image
  is totally singular, and multiplying `g` by the Siegel transformation
  `x ↦ x + B(p, x) q + B(q, x) p` (Tau Ceti's Eichler transvection `QuadraticMap.transvection`,
  in characteristic `2`) with `p, q` in the image lowers the rank, while on `V ⊕ H` a Siegel
  transformation is a product of four transvections.

Passing to `V ⊕ H`, which does not change `rank(g - 1)`, avoids the exception `O⁺(4, 2)`, which is
not generated by its own transvections. As a consequence `SO(Q) = O(Q)` in characteristic `2`
(`QuadraticForm.specialOrthogonalGroup_eq_orthogonalGroup`), and a transvection has Dickson
invariant `1`, so that for `V ≠ 0` the Dickson invariant is surjective and its kernel has index `2`.

## Main definitions

* `QuadraticForm.reflections`: the transvections of `Q`, reflections in vectors of nonzero norm.
* `QuadraticForm.dicksonInvariant` (LMFDB `group.omega`): the Dickson invariant `O(Q) →* ℤ/2`.
* `QuadraticForm.quasideterminant` (LMFDB `group.omega`): the quasideterminant
  `g ↦ (-1) ^ dim ker (g - 1)`, a homomorphism `O(Q) →* {±1}`.

## Main results

* `QuadraticForm.finrank_range_mul_reflection_sub_one`: right multiplication by a transvection
  changes the parity of `rank(g - 1)`.
* `QuadraticForm.prodCongr_mem_closure`: `g ⊕ 1` is a product of transvections of `V ⊕ H`.
* `QuadraticForm.finrank_range_mul_sub_one`: `rank(g g' - 1) ≡ rank(g - 1) + rank(g' - 1)` modulo
  `2` for `g, g' ∈ O(Q)`.
* `QuadraticForm.even_finrank_of_charTwo`: `V` has even dimension.
* `QuadraticForm.ker_polarBilin_eq_bot_of_nondegenerate`: conversely, in even dimension a
  nondegenerate quadratic form in Mathlib's sense has nondegenerate polar form.
* `QuadraticForm.specialOrthogonalGroup_eq_orthogonalGroup`: `SO(Q) = O(Q)`.
* `QuadraticForm.dicksonInvariant_eq_one_iff`, `QuadraticForm.ker_quasideterminant`: the kernel of
  the Dickson invariant consists of the `g` whose fixed space has even dimension, and is the kernel
  of the quasideterminant.
* `QuadraticForm.dicksonInvariant_reflectionOrthogonal`: a transvection has Dickson invariant `1`.
* `QuadraticForm.dicksonInvariant_surjective`, `QuadraticForm.index_ker_dicksonInvariant`: for
  `V ≠ 0` the Dickson invariant is surjective, and its kernel has index `2`.

## References

* D. E. Taylor, *The Geometry of the Classical Groups* (1992), Chapter 11.
* L. C. Grove, *Classical Groups and Geometric Algebra* (2002), Chapter 14.
-/

open Module TauCeti QuadraticMap

open LinearMap (BilinForm)

namespace QuadraticForm

variable {K V W : Type*} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  {Q : QuadraticForm K V} {Q₂ : QuadraticForm K W} {g g' : V ≃ₗ[K] V} {a p q : V}

variable (Q) in
/-- The **transvections** of a quadratic form `Q`: the reflections `x ↦ x - (B(v, x) / Q(v)) v` in
the vectors `v` of nonzero norm, `B` the polar form of `Q`, which are transvections in
characteristic `2` (Tau Ceti's `TauCeti.QuadraticMap.reflection`). -/
def reflections : Set (V ≃ₗ[K] V) :=
  {r | ∃ (v : V) (_ : Invertible (Q v)), reflection Q v = r}

lemma closure_reflections_le : Subgroup.closure (reflections Q) ≤ orthogonalGroup Q :=
  (Subgroup.closure_le _).mpr fun _ ⟨v, _, hr⟩ ↦ hr ▸ reflection_mem_orthogonalGroup Q v

lemma polar_sub_apply_eq_zero (hg : g ∈ orthogonalGroup Q) (u : V) {x : V} (hx : g x = x) :
    polar Q (g u - u) x = 0 := by
  rw [polar_sub_left, ← polar_apply_of_mem_orthogonalGroup hg u x, hx, sub_self]

lemma polar_sub_sub_eq_zero (hsing : ∀ v, Q (g v - v) = 0) (x y : V) :
    polar Q (g x - x) (g y - y) = 0 := by
  have h : g x - x + (g y - y) = g (x + y) - (x + y) := by
    rw [map_add]
    abel
  rw [polar, h, hsing, hsing, hsing, sub_zero, sub_zero]

lemma polar_sub_add_polar_sub (hg : g ∈ orthogonalGroup Q) (hsing : ∀ v, Q (g v - v) = 0)
    (u w : V) : polar Q (g u - u) w + polar Q u (g w - w) = 0 := by
  have h : polar Q (g u - u) (g w - w) = 0 := polar_sub_sub_eq_zero hsing u w
  rw [polar_sub_left, polar_sub_right, polar_sub_right, polar_apply_of_mem_orthogonalGroup hg] at h
  rw [polar_sub_left, polar_sub_right]
  linear_combination -h

lemma sub_sub_eq_zero_of_singular (hQ : (polarBilin Q).ker = ⊥) (hg : g ∈ orthogonalGroup Q)
    (hsing : ∀ v, Q (g v - v) = 0) (v : V) : g (g v - v) - (g v - v) = 0 := by
  refine (Submodule.eq_bot_iff _).mp hQ _ (LinearMap.ext fun w ↦ ?_)
  have h : polar Q (g (g v - v) - (g v - v)) w + polar Q (g v - v) (g w - w) = 0 :=
    polar_sub_add_polar_sub hg hsing (g v - v) w
  rwa [polar_sub_sub_eq_zero hsing, add_zero] at h

lemma exists_apply_ne_zero (hQ : (polarBilin Q).ker = ⊥) [Nontrivial V] : ∃ v, Q v ≠ 0 := by
  rcases exists_ne (0 : V) with ⟨v, hv⟩
  have hw : ∃ w, polar Q v w ≠ 0 :=
    not_forall.mp fun h ↦ hv <| (Submodule.eq_bot_iff _).mp hQ _ <| LinearMap.ext h
  rcases hw with ⟨w, hw⟩
  refine not_forall.mp fun h ↦ hw ?_
  rw [polar, h, h, h, sub_zero, sub_zero]

lemma prodCongr_mul : (g * g').prodCongr (1 : W ≃ₗ[K] W) = g.prodCongr 1 * g'.prodCongr 1 :=
  rfl

lemma finrank_range_one_sub_one : finrank K (((1 : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).range = 0 := by
  rw [LinearEquiv.one_eq_refl, LinearEquiv.refl_toLinearMap, ← End.one_eq_id, sub_self,
    LinearMap.range_zero, finrank_bot]

variable (K) in
lemma hyperbolicForm_one_apply_one_one : hyperbolicForm K 1 (fun _ ↦ (1, 1)) = 1 := by
  simp [hyperbolicForm_apply]

section FiniteDimensional

variable [FiniteDimensional K V] {f f' : V →ₗ[K] V}

lemma finrank_inf_ker_add_one {U : Submodule K V} {φ : V →ₗ[K] K} (h : ¬U ≤ φ.ker) :
    finrank K ↥(U ⊓ φ.ker) + 1 = finrank K U := by
  rcases IsConcreteLE.not_le_iff_exists.mp h with ⟨u, hu, hφ⟩
  have htop : U ⊔ φ.ker = ⊤ :=
    top_unique <| (LinearMap.span_singleton_sup_ker_eq_top φ hφ).ge.trans <|
      sup_le_sup_right ((Submodule.span_singleton_le_iff_mem u U).mpr hu) _
  have h₁ : finrank K ↥(U ⊔ φ.ker) + finrank K ↥(U ⊓ φ.ker) = finrank K U + finrank K φ.ker :=
    Submodule.finrank_sup_add_finrank_inf_eq U φ.ker
  have h₂ : finrank K φ.ker + 1 = finrank K V :=
    Dual.finrank_ker_add_one_of_ne_zero fun h ↦ hφ <| by simp [h]
  rw [htop, finrank_top] at h₁
  omega

variable (f f') in
lemma finrank_range_add_finrank_ker_eq :
    finrank K f.range + finrank K f.ker = finrank K f'.range + finrank K f'.ker :=
  f.finrank_range_add_finrank_ker.trans f'.finrank_range_add_finrank_ker.symm

lemma finrank_range_eq_add_one (h : finrank K f.ker + 1 = finrank K f'.ker) :
    finrank K f.range = finrank K f'.range + 1 := by
  linarith [finrank_range_add_finrank_ker_eq f f']

lemma finrank_range_lt_of_finrank_ker_lt (h : finrank K f.ker < finrank K f'.ker) :
    finrank K f'.range < finrank K f.range := by
  linarith [finrank_range_add_finrank_ker_eq f f']

lemma not_ker_sub_one_le (hQ : (polarBilin Q).ker = ⊥) (hg : g ∈ orthogonalGroup Q)
    (ha : a ∉ ((g : V →ₗ[K] V) - 1).range) : ¬((g : V →ₗ[K] V) - 1).ker ≤ (polarBilin Q a).ker := by
  rcases Submodule.exists_dual_map_eq_bot_of_notMem ha inferInstance with ⟨f, hfa, hf⟩
  let x : V :=
    (BilinForm.toDual (polarBilin Q) (BilinForm.nondegenerate_iff_ker_eq_bot.mpr hQ)).symm f
  have hx (v : V) : polar Q x v = f v := by
    rw [← polarBilin_apply_apply]
    exact BilinForm.apply_toDual_symm_apply f v
  have hfix (v : V) : polar Q x (g v) = polar Q x v := by
    have h₀ : f (((g : V →ₗ[K] V) - 1) v) = 0 := by
      rw [← Submodule.mem_bot K, ← hf]
      exact Submodule.mem_map_of_mem (LinearMap.mem_range_self _ v)
    rwa [LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply, ← hx, polar_sub_right,
      sub_eq_zero] at h₀
  intro h
  have hxk : x ∈ ((g : V →ₗ[K] V) - 1).ker := by
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply]
    refine (Submodule.eq_bot_iff _).mp hQ _ (LinearMap.ext fun w ↦ ?_)
    rw [LinearMap.zero_apply, polarBilin_apply_apply, polar_sub_left, ← g.apply_symm_apply w,
      polar_apply_of_mem_orthogonalGroup hg, hfix, sub_self]
  exact hfa <| by simpa [hx, polar_comm Q a x] using h hxk

lemma finrank_range_prodCongr_sub_one :
    finrank K ((g.prodCongr (1 : W ≃ₗ[K] W) : V × W →ₗ[K] V × W) - 1).range =
      finrank K ((g : V →ₗ[K] V) - 1).range := by
  have h :
      (g.prodCongr (1 : W ≃ₗ[K] W) : V × W →ₗ[K] V × W) - 1 = ((g : V →ₗ[K] V) - 1).prodMap 0 := by
    ext x <;> simp
  rw [h, LinearMap.range_prodMap, LinearMap.range_zero,
    (((g : V →ₗ[K] V) - 1).range.prodEquiv ⊥).finrank_eq, Module.finrank_prod, finrank_bot,
    add_zero]

end FiniteDimensional

section Transvection

variable (a) [Invertible (Q a)]

lemma ker_mul_reflection_sub_one_inf : (((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).ker ⊓
    (polarBilin Q a).ker = ((g : V →ₗ[K] V) - 1).ker ⊓ (polarBilin Q a).ker := by
  ext x
  simp only [Submodule.mem_inf, LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe,
    and_congr_left_iff]
  intro hx
  rw [LinearEquiv.mul_apply, reflection_apply_of_polar_eq_zero Q a hx]

lemma ker_mul_reflection_sub_one_le (ha : a ∉ ((g : V →ₗ[K] V) - 1).range) :
    (((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).ker ≤ (polarBilin Q a).ker := by
  intro y hy
  rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply,
    LinearEquiv.mul_apply, QuadraticMap.reflection_apply, sub_eq_zero] at hy
  rw [LinearMap.mem_ker, polarBilin_apply_apply]
  by_contra hc
  refine ha ⟨(⅟(Q a) * polar Q a y)⁻¹ • (y - (⅟(Q a) * polar Q a y) • a), ?_⟩
  rw [map_smul, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply, hy,
    sub_sub_cancel, smul_smul, inv_mul_cancel₀ (mul_ne_zero (Invertible.ne_zero _) hc), one_smul]

lemma not_ker_mul_reflection_sub_one_le (hg : g ∈ orthogonalGroup Q)
    (ha : a ∈ ((g : V →ₗ[K] V) - 1).range) :
    ¬(((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).ker ≤ (polarBilin Q a).ker := by
  rcases ha with ⟨u, hu⟩
  rw [LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply] at hu
  have hpolar : polar Q a (g u) = Q a := by
    have h₁ : g u = a + u := by
      rw [← hu, sub_add_cancel]
    have h₂ : Q (a + u) = Q a + Q u + polar Q a u := QuadraticMap.map_add Q a u
    rw [← h₁, map_app_of_mem_orthogonalGroup hg u] at h₂
    rw [h₁, polar_add_right, polar_self, two_nsmul]
    linear_combination -h₂
  intro h
  have hx : g u ∈ (((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).ker := by
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply,
      LinearEquiv.mul_apply, QuadraticMap.reflection_apply, hpolar, invOf_mul_self, one_smul, ← hu,
      sub_sub_cancel, sub_self]
  exact Invertible.ne_zero (Q a) <| hpolar ▸ h hx

lemma prodCongr_reflection_mem :
    (reflection Q a).prodCongr (1 : W ≃ₗ[K] W) ∈ reflections (Q.prod Q₂) := by
  have ha : Q.prod Q₂ (a, 0) = Q a := by
    rw [QuadraticMap.prod_apply, QuadraticMap.map_zero, add_zero]
  refine ⟨(a, 0), invertibleOfNonzero (ha ▸ Invertible.ne_zero (Q a)), ?_⟩
  ext x <;> simp [reflection_apply_eq_sub_div]

variable [FiniteDimensional K V]

lemma finrank_ker_sub_one_add_one (hg : g ∈ orthogonalGroup Q)
    (ha : a ∈ ((g : V →ₗ[K] V) - 1).range) : finrank K ((g : V →ₗ[K] V) - 1).ker + 1 =
      finrank K (((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).ker := by
  have hle : ((g : V →ₗ[K] V) - 1).ker ≤ (polarBilin Q a).ker := by
    rcases ha with ⟨u, hu⟩
    intro x hx
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply,
      sub_eq_zero] at hx
    rw [LinearMap.mem_ker, polarBilin_apply_apply, ← hu, LinearMap.sub_apply, LinearEquiv.coe_coe,
      End.one_apply]
    exact polar_sub_apply_eq_zero hg u hx
  rw [← finrank_inf_ker_add_one (not_ker_mul_reflection_sub_one_le a hg ha),
    ker_mul_reflection_sub_one_inf, inf_eq_left.mpr hle]

lemma finrank_ker_mul_reflection_sub_one_add_one (hQ : (polarBilin Q).ker = ⊥)
    (hg : g ∈ orthogonalGroup Q) (ha : a ∉ ((g : V →ₗ[K] V) - 1).range) :
    finrank K (((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).ker + 1 =
      finrank K ((g : V →ₗ[K] V) - 1).ker := by
  rw [← finrank_inf_ker_add_one (not_ker_sub_one_le hQ hg ha), ← ker_mul_reflection_sub_one_inf,
    inf_eq_left.mpr (ker_mul_reflection_sub_one_le a ha)]

/-- **Right multiplication by a transvection changes the parity of `rank(g - 1)`**, for `g` in the
orthogonal group of a quadratic form with nondegenerate polar form, in every characteristic. -/
lemma finrank_range_mul_reflection_sub_one (hQ : (polarBilin Q).ker = ⊥)
    (hg : g ∈ orthogonalGroup Q) :
    (finrank K (((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).range : ZMod 2) =
      finrank K ((g : V →ₗ[K] V) - 1).range + 1 := by
  by_cases ha : a ∈ ((g : V →ₗ[K] V) - 1).range
  · rw [finrank_range_eq_add_one (finrank_ker_sub_one_add_one a hg ha), Nat.cast_succ, add_assoc,
      CharTwo.add_self_eq_zero, add_zero]
  · rw [finrank_range_eq_add_one (finrank_ker_mul_reflection_sub_one_add_one a hQ hg ha),
      Nat.cast_succ]

lemma finrank_range_reflection_sub_one (hQ : (polarBilin Q).ker = ⊥) :
    (finrank K ((reflection Q a : V →ₗ[K] V) - 1).range : ZMod 2) = 1 := by
  rw [← one_mul (reflection Q a), finrank_range_mul_reflection_sub_one a hQ (one_mem _),
    finrank_range_one_sub_one, Nat.cast_zero, zero_add]

lemma finrank_range_mul_reflection_sub_one_eq_add (hQ : (polarBilin Q).ker = ⊥)
    (hg : g ∈ orthogonalGroup Q) :
    (finrank K (((g * reflection Q a : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).range : ZMod 2) =
      finrank K ((g : V →ₗ[K] V) - 1).range +
        finrank K ((reflection Q a : V →ₗ[K] V) - 1).range := by
  rw [finrank_range_reflection_sub_one a hQ, finrank_range_mul_reflection_sub_one a hQ hg]

end Transvection

variable [FiniteDimensional K V] in
lemma finrank_range_mul_sub_one_of_mem_closure (hQ : (polarBilin Q).ker = ⊥)
    (hg' : g' ∈ Subgroup.closure (reflections Q)) (hg : g ∈ orthogonalGroup Q) :
    (finrank K (((g * g' : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).range : ZMod 2) =
      finrank K ((g : V →ₗ[K] V) - 1).range + finrank K ((g' : V →ₗ[K] V) - 1).range := by
  induction hg' using Subgroup.closure_induction'' generalizing g with
  | mem x hx =>
    rcases hx with ⟨v, _, rfl⟩
    exact finrank_range_mul_reflection_sub_one_eq_add v hQ hg
  | inv_mem x hx =>
    rcases hx with ⟨v, _, rfl⟩
    rw [QuadraticMap.reflection_inv]
    exact finrank_range_mul_reflection_sub_one_eq_add v hQ hg
  | one => rw [mul_one, finrank_range_one_sub_one, Nat.cast_zero, add_zero]
  | mul x y hx _ ihx ihy =>
    rw [← mul_assoc, ihy (mul_mem hg (closure_reflections_le hx)), ihx hg,
      ihy (closure_reflections_le hx), add_assoc]

section Siegel

variable [CharP K 2] {w : V} {w₂ : W} (hp : Q p = 0) (hpq : polar Q p q = 0)

lemma polar_self_eq_zero_of_charTwo (v : V) : polar Q v v = 0 := by
  rw [polar_self, two_nsmul, CharTwo.add_self_eq_zero]

lemma transvection_apply_of_charTwo (hq : Q q = 0) (x : V) :
    transvection Q hp hpq x = x + polar Q p x • q + polar Q q x • p := by
  rw [transvection_apply, hq, zero_mul, zero_smul, sub_zero, sub_eq_add_neg, ← neg_smul,
    CharTwo.neg_eq, polar_comm Q x p, polar_comm Q x q]

lemma transvection_mul_self_of_charTwo : transvection Q hp hpq * transvection Q hp hpq = 1 := by
  rw [← transvection_add hp hpq hpq]
  refine transvection_eq_one_of_mem_span hp _ ?_
  rw [← two_smul K q, CharTwo.two_eq_zero, zero_smul]
  exact zero_mem _

lemma transvection_mem_closure (hq : Q q = 0) (hw : Q w = 1) (hpw : polar Q p w = 0)
    (hqw : polar Q q w = 0) : transvection Q hp hpq ∈ Subgroup.closure (reflections Q) := by
  have h₁ : Q (q + w) = 1 := by
    rw [QuadraticMap.map_add Q, hq, hw, hqw, zero_add, add_zero]
  have h₂ : Q (q + w + p) = 1 := by
    rw [QuadraticMap.map_add Q, h₁, hp, polar_add_left, polar_comm Q q p, polar_comm Q w p, hpq,
      hpw, add_zero, add_zero, add_zero]
  have h₃ : Q (w + p) = 1 := by
    rw [QuadraticMap.map_add Q, hw, hp, polar_comm Q w p, hpw, add_zero, add_zero]
  let i₁ : Invertible (Q (q + w)) := invertibleOfNonzero (h₁ ▸ one_ne_zero)
  let i₂ : Invertible (Q (q + w + p)) := invertibleOfNonzero (h₂ ▸ one_ne_zero)
  let i₃ : Invertible (Q w) := invertibleOfNonzero (hw ▸ one_ne_zero)
  let i₄ : Invertible (Q (w + p)) := invertibleOfNonzero (h₃ ▸ one_ne_zero)
  have heq : transvection Q hp hpq =
      reflection Q (q + w) * reflection Q (q + w + p) * reflection Q w * reflection Q (w + p) := by
    ext x
    simp only [LinearEquiv.mul_apply, reflection_apply_eq_sub_div, h₁, h₂, h₃, hw,
      transvection_apply_of_charTwo hp hpq hq, polar_sub_right, polar_smul_right, polar_add_left,
      polar_add_right, polar_comm Q w p, polar_comm Q q p, hpq, hpw, hqw,
      polar_self_eq_zero_of_charTwo]
    linear_combination (norm := module) (CharTwo.two_eq_zero : (2 : K) = 0) •
      ((polar Q p x + polar Q q x + polar Q w x) • (q + p) +
        (2 * polar Q w x + polar Q p x + polar Q q x) • w)
  rw [heq]
  exact mul_mem (mul_mem (mul_mem (Subgroup.subset_closure ⟨_, i₁, rfl⟩)
    (Subgroup.subset_closure ⟨_, i₂, rfl⟩)) (Subgroup.subset_closure ⟨_, i₃, rfl⟩))
      (Subgroup.subset_closure ⟨_, i₄, rfl⟩)

lemma prodCongr_transvection_mem_closure (hw₂ : Q₂ w₂ = 1) (hq : Q q = 0) :
    (transvection Q hp hpq).prodCongr (1 : W ≃ₗ[K] W) ∈
      Subgroup.closure (reflections (Q.prod Q₂)) := by
  have hp' : Q.prod Q₂ (p, 0) = 0 := by
    rw [QuadraticMap.prod_apply, hp, QuadraticMap.map_zero, add_zero]
  have hpq' : polar (Q.prod Q₂) (p, 0) (q, 0) = 0 := by
    rw [polar_prod, hpq, polar_zero_left, add_zero]
  have heq :
      (transvection Q hp hpq).prodCongr (1 : W ≃ₗ[K] W) = transvection (Q.prod Q₂) hp' hpq' := by
    ext x <;> simp [transvection_apply]
  rw [heq]
  refine transvection_mem_closure (w := (0, w₂)) hp' hpq' ?_ ?_ ?_ ?_ <;> simp [hq, hw₂]

variable [FiniteDimensional K V]

lemma finrank_range_mul_transvection_sub_one_lt (hQ : (polarBilin Q).ker = ⊥)
    (hg : g ∈ orthogonalGroup Q) (hs : ∀ v, Q (g v - v) = 0) {x y : V}
    (hxy : polar Q x (g y - y) = 1) :
    finrank K ((g * transvection Q (hs x) (polar_sub_sub_eq_zero hs x y)).toLinearMap - 1).range <
      finrank K ((g : V →ₗ[K] V) - 1).range := by
  refine finrank_range_lt_of_finrank_ker_lt <| Submodule.finrank_lt_finrank_of_lt <|
    IsConcreteLE.lt_iff_le_and_exists.mpr ⟨fun z hz ↦ ?_, x, ?_, fun hx ↦ ?_⟩
  · rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply,
      sub_eq_zero] at hz
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply,
      LinearEquiv.mul_apply, transvection_apply_of_charTwo _ _ (hs y),
      polar_sub_apply_eq_zero hg x hz, polar_sub_apply_eq_zero hg y hz, zero_smul, zero_smul,
      add_zero, add_zero, hz, sub_self]
  · have hx : polar Q (g x - x) x = 0 := by
      have h : Q (g x - x + x) = Q (g x - x) + Q x + polar Q (g x - x) x :=
        QuadraticMap.map_add Q _ _
      rwa [sub_add_cancel, map_app_of_mem_orthogonalGroup hg, hs, zero_add, left_eq_add] at h
    have h : g (g x - x) - (g x - x) = 0 := sub_sub_eq_zero_of_singular hQ hg hs x
    rw [map_sub] at h
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply,
      LinearEquiv.mul_apply, transvection_apply_of_charTwo _ _ (hs y), hx, polar_comm, hxy,
      zero_smul, add_zero, one_smul, add_sub_cancel]
    linear_combination (norm := module) h + (CharTwo.two_eq_zero : (2 : K) = 0) • (g x - x)
  · rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearEquiv.coe_coe, End.one_apply] at hx
    have h : polar Q (g x - x) y + polar Q x (g y - y) = 0 := polar_sub_add_polar_sub hg hs x y
    rw [hx, polar_zero_left, hxy, zero_add] at h
    exact one_ne_zero h

/-- **Every orthogonal automorphism is a product of transvections after adding a plane.** For a
quadratic form `Q` with nondegenerate polar form over a field of characteristic `2` and a quadratic
form `Q₂` representing `1`, the extension `g ⊕ 1` of every `g ∈ O(Q)` lies in the subgroup
generated by the transvections of `Q ⊕ Q₂`. -/
lemma prodCongr_mem_closure (hw₂ : Q₂ w₂ = 1) (hQ : (polarBilin Q).ker = ⊥)
    (hg : g ∈ orthogonalGroup Q) :
    g.prodCongr (1 : W ≃ₗ[K] W) ∈ Subgroup.closure (reflections (Q.prod Q₂)) := by
  induction hn : finrank K ((g : V →ₗ[K] V) - 1).range using Nat.strong_induction_on
    generalizing g with
  | _ n ih =>
    by_cases hsing : ∀ v, Q (g v - v) = 0
    · by_cases hg1 : g = 1
      · rw [hg1]
        exact one_mem _
      · have hy : ∃ y, g y - y ≠ 0 :=
          not_forall.mp fun h ↦ hg1 <| LinearEquiv.ext fun y ↦ sub_eq_zero.mp (h y)
        rcases hy with ⟨y, hy⟩
        have hx : ∃ x, polar Q x (g y - y) ≠ 0 := by
          refine not_forall.mp fun h ↦ hy <| (Submodule.eq_bot_iff _).mp hQ _ <|
            LinearMap.ext fun x ↦ ?_
          rw [LinearMap.zero_apply, polarBilin_apply_apply, polar_comm]
          exact h x
        rcases hx with ⟨x, hx⟩
        have hxy : polar Q ((polar Q x (g y - y))⁻¹ • x) (g y - y) = 1 := by
          rw [polar_smul_left, smul_eq_mul, inv_mul_cancel₀ hx]
        rw [← mul_one g, ← transvection_mul_self_of_charTwo (hsing _)
          (polar_sub_sub_eq_zero hsing ((polar Q x (g y - y))⁻¹ • x) y), ← mul_assoc,
          prodCongr_mul]
        exact mul_mem (ih _ (hn ▸ finrank_range_mul_transvection_sub_one_lt hQ hg hsing hxy)
          (mul_mem hg (transvection_mem_orthogonalGroup _ _)) rfl)
            (prodCongr_transvection_mem_closure _ _ hw₂ (hsing y))
    · rcases not_forall.mp hsing with ⟨u, hu⟩
      let i : Invertible (Q (g u - u)) := invertibleOfNonzero hu
      rw [← mul_one g, ← reflection_mul_self Q (g u - u), ← mul_assoc, prodCongr_mul]
      exact mul_mem (ih _ (hn ▸ (Nat.lt_succ_self _).trans_eq
        (finrank_range_eq_add_one (finrank_ker_sub_one_add_one (g u - u) hg ⟨u, rfl⟩)).symm)
          (mul_mem hg (reflection_mem_orthogonalGroup Q (g u - u))) rfl)
            (Subgroup.subset_closure <| prodCongr_reflection_mem (g u - u))

end Siegel

variable [CharP K 2] [FiniteDimensional K V]

/-- **The Dickson invariant is a homomorphism**: for `g, g'` in the orthogonal group of a quadratic
form with nondegenerate polar form over a field of characteristic `2`, the rank of `g g' - 1` is
congruent to the sum of the ranks of `g - 1` and `g' - 1` modulo `2`. -/
lemma finrank_range_mul_sub_one (hQ : (polarBilin Q).ker = ⊥) (hg : g ∈ orthogonalGroup Q)
    (hg' : g' ∈ orthogonalGroup Q) :
    (finrank K (((g * g' : V ≃ₗ[K] V) : V →ₗ[K] V) - 1).range : ZMod 2) =
      finrank K ((g : V →ₗ[K] V) - 1).range + finrank K ((g' : V →ₗ[K] V) - 1).range := by
  rw [← finrank_range_prodCongr_sub_one (W := Fin 1 → K × K), prodCongr_mul,
    finrank_range_mul_sub_one_of_mem_closure
      (ker_polarBilin_prod hQ (ker_polarBilin_hyperbolicForm K 1))
      (prodCongr_mem_closure (hyperbolicForm_one_apply_one_one K) hQ hg')
      (QuadraticMap.prodCongr_mem_orthogonalGroup hg (one_mem _)),
    finrank_range_prodCongr_sub_one, finrank_range_prodCongr_sub_one]

/-- **A quadratic form with nondegenerate polar form in characteristic `2` has even dimension**,
its polar form being alternating. -/
lemma even_finrank_of_charTwo (hQ : (polarBilin Q).ker = ⊥) : Even (finrank K V) := by
  have hB : BilinForm.IsAlt (polarBilin Q) := polar_self_eq_zero_of_charTwo
  exact hB.even_finrank (BilinForm.nondegenerate_iff_ker_eq_bot.mpr hQ)

/-- **A nondegenerate quadratic form of even dimension in characteristic `2` has nondegenerate polar
form**, for Mathlib's notion of nondegeneracy (`QuadraticMap.Nondegenerate`): the kernel of the
polar form has dimension at most `1`, and even dimension since the polar form induces a
nondegenerate alternating form on a complement. -/
lemma ker_polarBilin_eq_bot_of_nondegenerate (hQ : Q.Nondegenerate) (hV : Even (finrank K V)) :
    (polarBilin Q).ker = ⊥ := by
  rcases (polarBilin Q).ker.exists_isCompl with ⟨U, hU⟩
  have hnd : (BilinForm.restrict (polarBilin Q) U).Nondegenerate := by
    refine BilinForm.nondegenerate_iff_ker_eq_bot.mpr <| (Submodule.eq_bot_iff _).mpr fun u hu ↦ ?_
    refine Subtype.ext <| (Submodule.disjoint_def.mp hU.disjoint) u ?_ u.2
    refine LinearMap.mem_ker.mpr <| LinearMap.ext fun v ↦ ?_
    rcases Submodule.mem_sup.mp (hU.codisjoint.eq_top ▸ Submodule.mem_top : v ∈ _ ⊔ U) with
      ⟨r, hr, w, hw, rfl⟩
    rw [map_add, LinearMap.zero_apply, polarBilin_apply_apply, polar_comm, ← polarBilin_apply_apply,
      LinearMap.mem_ker.mp hr, LinearMap.zero_apply, zero_add]
    exact LinearMap.congr_fun (LinearMap.mem_ker.mp hu) ⟨w, hw⟩
  have halt : BilinForm.IsAlt (BilinForm.restrict (polarBilin Q) U) :=
    fun x ↦ polar_self_eq_zero_of_charTwo (x : V)
  have hsum : finrank K (polarBilin Q).ker + finrank K U = finrank K V :=
    Submodule.finrank_add_eq_of_isCompl hU
  have hle : finrank K (polarBilin Q).ker ≤ 1 :=
    Module.finrank_le_of_rank_le <| by exact_mod_cast hQ.rank_rad_polar_le
  rw [← Submodule.finrank_eq_zero]
  rcases hV with ⟨n, hn⟩
  rcases halt.even_finrank hnd with ⟨m, hm⟩
  omega

lemma natCast_finrank_ker_sub_one (hQ : (polarBilin Q).ker = ⊥) :
    (finrank K ((g : V →ₗ[K] V) - 1).ker : ZMod 2) = finrank K ((g : V →ₗ[K] V) - 1).range := by
  refine (eq_neg_of_add_eq_zero_left ?_).trans (ZMod.neg_eq_self_mod_two _)
  rw [← Nat.cast_add, add_comm, LinearMap.finrank_range_add_finrank_ker,
    ZMod.natCast_eq_zero_iff_even]
  exact even_finrank_of_charTwo hQ

/-- **In characteristic `2`, `SO(Q) = O(Q)`** for a quadratic form `Q` with nondegenerate polar
form: every `g ∈ O(Q)` has determinant `1`, since `g ⊕ 1` is a product of transvections
(`QuadraticForm.prodCongr_mem_closure`), each of determinant `-1 = 1`. -/
lemma specialOrthogonalGroup_eq_orthogonalGroup (hQ : (polarBilin Q).ker = ⊥) :
    specialOrthogonalGroup Q = orthogonalGroup Q := by
  refine le_antisymm (specialOrthogonalGroup_le_orthogonalGroup Q) fun g hg ↦
    mem_specialOrthogonalGroup_iff.mpr ⟨hg, ?_⟩
  have hle :
      Subgroup.closure (reflections (Q.prod (hyperbolicForm K 1))) ≤ LinearEquiv.det.ker := by
    refine (Subgroup.closure_le _).mpr fun _ ⟨v, _, hr⟩ ↦ ?_
    rw [← hr, SetLike.mem_coe, MonoidHom.mem_ker, QuadraticMap.det_reflection]
    exact Units.ext <| by rw [Units.val_neg, Units.val_one, CharTwo.neg_eq]
  have hdet : (g.prodCongr (1 : (Fin 1 → K × K) ≃ₗ[K] Fin 1 → K × K) :
      V × (Fin 1 → K × K) →ₗ[K] V × (Fin 1 → K × K)) = (g : V →ₗ[K] V).prodMap 1 := by
    ext x <;> simp
  have h : LinearEquiv.det (g.prodCongr (1 : (Fin 1 → K × K) ≃ₗ[K] Fin 1 → K × K)) = 1 :=
    hle (prodCongr_mem_closure (hyperbolicForm_one_apply_one_one K) hQ hg)
  rw [Units.ext_iff, LinearEquiv.coe_det, hdet, LinearMap.det_prodMap, map_one, mul_one] at h
  rw [Units.ext_iff, LinearEquiv.coe_det, h]

variable (hQ : (polarBilin Q).ker = ⊥)

variable (Q) in
/-- The **Dickson invariant** `D : O(Q) →* ℤ/2` (LMFDB `group.omega`) of a quadratic form `Q` with
nondegenerate polar form on a finite-dimensional vector space over a field of characteristic `2`:
`D(g)` is the rank of `g - 1` modulo `2`, a homomorphism by
`QuadraticForm.finrank_range_mul_sub_one`. The dimension being even, `D(g)` is also the dimension
of the fixed space of `g` modulo `2` (`QuadraticForm.dicksonInvariant_eq_one_iff`): `D` is the
knowl's quasideterminant `g ↦ (-1) ^ dim ker (g - 1)` (`QuadraticForm.quasideterminant`), written
additively. For odd `q` the knowl's quasideterminant is the determinant in even dimension, trivial
on `SO`, and `Ω` is the kernel of the spinor norm instead (`QuadraticForm.omegaGroup`). -/
noncomputable def dicksonInvariant : orthogonalGroup Q →* Multiplicative (ZMod 2) where
  toFun g := .ofAdd (finrank K ((g : V →ₗ[K] V) - 1).range)
  map_one' := by
    rw [OneMemClass.coe_one, finrank_range_one_sub_one, Nat.cast_zero, ofAdd_zero]
  map_mul' g g' := by
    rw [Subgroup.coe_mul, finrank_range_mul_sub_one hQ g.2 g'.2, ofAdd_add]

lemma dicksonInvariant_apply (hg : g ∈ orthogonalGroup Q) :
    dicksonInvariant Q hQ ⟨g, hg⟩ = .ofAdd (finrank K ((g : V →ₗ[K] V) - 1).range : ZMod 2) :=
  rfl

/-- **The kernel of the Dickson invariant is the kernel of the quasideterminant**
`g ↦ (-1) ^ dim ker (g - 1)` of LMFDB `group.omega`: `D(g) = 0` exactly when the fixed space of
`g` has even dimension. -/
lemma dicksonInvariant_eq_one_iff (hg : g ∈ orthogonalGroup Q) :
    dicksonInvariant Q hQ ⟨g, hg⟩ = 1 ↔ Even (finrank K ((g : V →ₗ[K] V) - 1).ker) := by
  rw [dicksonInvariant_apply, ofAdd_eq_one, ← natCast_finrank_ker_sub_one hQ,
    ZMod.natCast_eq_zero_iff_even]

variable (Q) in
/-- The **quasideterminant** `g ↦ (-1) ^ dim ker (g - 1)` (LMFDB `group.omega`) on the orthogonal
group of a quadratic form `Q` with nondegenerate polar form on a finite-dimensional vector space
over a field of characteristic `2`, `ker (g - 1)` being the fixed space of `g`: a homomorphism
`O(Q) →* {±1}` with the same kernel as the Dickson invariant
(`QuadraticForm.ker_quasideterminant`). -/
noncomputable def quasideterminant : orthogonalGroup Q →* ℤˣ where
  toFun g := (-1) ^ finrank K ((g : V →ₗ[K] V) - 1).ker
  map_one' := by
    rw [OneMemClass.coe_one, LinearEquiv.one_eq_refl, LinearEquiv.refl_toLinearMap,
      ← End.one_eq_id, sub_self, LinearMap.ker_zero, finrank_top]
    exact (even_finrank_of_charTwo hQ).neg_one_pow
  map_mul' g g' := by
    rw [← pow_add]
    refine neg_one_pow_congr ?_
    rw [← ZMod.natCast_eq_zero_iff_even, ← ZMod.natCast_eq_zero_iff_even, Nat.cast_add,
      natCast_finrank_ker_sub_one hQ, natCast_finrank_ker_sub_one hQ,
      natCast_finrank_ker_sub_one hQ, Subgroup.coe_mul, finrank_range_mul_sub_one hQ g.2 g'.2]

/-- **The quasideterminant and the Dickson invariant have the same kernel**: both consist of the
orthogonal automorphisms whose fixed space has even dimension. -/
lemma ker_quasideterminant : (quasideterminant Q hQ).ker = (dicksonInvariant Q hQ).ker :=
  Subgroup.ext fun g ↦
    (neg_one_pow_eq_one_iff_even (by decide)).trans (dicksonInvariant_eq_one_iff hQ g.2).symm

variable (a) in
/-- **A transvection has Dickson invariant `1`.** -/
lemma dicksonInvariant_reflectionOrthogonal [Invertible (Q a)] :
    dicksonInvariant Q hQ (reflectionOrthogonal Q a) = .ofAdd 1 :=
  congrArg Multiplicative.ofAdd <| finrank_range_reflection_sub_one a hQ

/-- **The Dickson invariant is surjective** on a nonzero space, a transvection having invariant
`1`. -/
lemma dicksonInvariant_surjective [Nontrivial V] : Function.Surjective (dicksonInvariant Q hQ) := by
  rcases exists_apply_ne_zero hQ with ⟨a, ha⟩
  let i : Invertible (Q a) := invertibleOfNonzero ha
  intro x
  rcases (by decide : ∀ y : ZMod 2, y = 0 ∨ y = 1) (Multiplicative.toAdd x) with h | h
  · exact ⟨1, by rw [map_one, ← ofAdd_toAdd x, h, ofAdd_zero]⟩
  · refine ⟨reflectionOrthogonal Q a, ?_⟩
    rw [dicksonInvariant_reflectionOrthogonal, ← h, ofAdd_toAdd]

/-- **The kernel of the Dickson invariant has index `2`** in `O(Q)`, on a nonzero space. -/
lemma index_ker_dicksonInvariant [Nontrivial V] : (dicksonInvariant Q hQ).ker.index = 2 := by
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr (dicksonInvariant_surjective hQ),
    Subgroup.card_top]
  exact Nat.card_zmod 2

end QuadraticForm
