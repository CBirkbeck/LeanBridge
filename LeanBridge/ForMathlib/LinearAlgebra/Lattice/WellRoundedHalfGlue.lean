import LeanBridge.ForMathlib.LinearAlgebra.Lattice.WellRounded

/-!
# Well-rounded lattices that are not generated by their minimal vectors

For `m ≥ 4` let `Lₘ` be the lattice `ℤⁿ + ℤ h`, `n = m + 1`, `h = (1/2, …, 1/2)`, with the form
`4 x · y`, an integral lattice of rank `n ≥ 5` (scaled `Dₙ*`). In the basis `e₁, …, eₘ, h` its Gram
matrix has entries `4 δᵢⱼ`, `2` and `n`, and the vector with coordinates `(c, w)` has norm
`∑ᵢ (2cᵢ + w)² + w²`. If `w` is odd every term is at least `1`, so the norm is at least `n > 4`; if
`w = 0` it is `4 ∑ cᵢ²`; if `w` is even and nonzero it is at least `w² ≥ 4`. So the minimum is `4`,
and every minimal vector has an even last coordinate: the minimal vectors `±eᵢ`, `i ≤ n`
(`eₙ = 2h - e₁ - … - eₘ`), span the sublattice `ℤⁿ` of index `2`. Hence `Lₘ` is well-rounded
(LMFDB `lattice.well_rounded`), its minimal vectors spanning a sublattice of full rank, but it is
not generated by its minimal vectors: the last coordinate modulo `2` vanishes on them but not on
`h`. So being generated by minimal vectors is strictly stronger than being well-rounded, in every
rank `n ≥ 5`.

## Main definitions

* `TauCeti.IntegralLattice.halfGlueGram`: the Gram matrix of `Lₘ`.
* `TauCeti.IntegralLattice.halfGlueLattice`: the integral lattice `Lₘ`.

## Main results

* `TauCeti.IntegralLattice.finrank_halfGlueLattice`: `Lₘ` has rank `m + 1`.
* `TauCeti.IntegralLattice.isPosDef_halfGlueLattice`: it is positive definite.
* `TauCeti.IntegralLattice.minimum_halfGlueLattice`: its minimum is `4` for `m ≥ 4`.
* `TauCeti.IntegralLattice.isWellRounded_halfGlueLattice` and
  `TauCeti.IntegralLattice.not_isGeneratedByMinimalVectors_halfGlueLattice` (LMFDB
  `lattice.well_rounded`): for `m ≥ 4` it is well-rounded but not generated by its minimal vectors.
-/

open Module

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V] {L : IntegralLattice V}

lemma integralNorm_eq_sum_repr {ι : Type*} [Fintype ι] [DecidableEq ι] (e : Basis ι ℤ L) (x : L) :
    L.integralNorm x = ∑ i, ∑ j, e.repr x i * L.gramMatrix e i j * e.repr x j := by
  rw [integralNorm_apply, gramMatrix_eq_toMatrix, ← Matrix.toBilin_apply e,
    Matrix.toBilin_toMatrix]

variable (m : ℕ)

/-- The Gram matrix of `ℤ^{m+1} + ℤ (1/2, …, 1/2)` with the form `4 x · y` in the basis
`e₁, …, eₘ, h`, `h = (1/2, …, 1/2)` indexed by `none`: the entries are `4 δᵢⱼ`, `4 eᵢ · h = 2` and
`4 h · h = m + 1`. -/
def halfGlueGram : Matrix (Option (Fin m)) (Option (Fin m)) ℤ :=
  Matrix.of fun i j ↦ match i, j with
    | none, none => m + 1
    | none, some _ => 2
    | some _, none => 2
    | some i, some j => if i = j then 4 else 0

lemma isSymm_halfGlueGram : (halfGlueGram m).IsSymm := by
  ext i j
  rcases i with _ | i <;> rcases j with _ | j <;> simp [halfGlueGram, eq_comm]

/-- The integral lattice `ℤ^{m+1} + ℤ (1/2, …, 1/2)` with the form `4 x · y`, presented by its
Gram matrix `TauCeti.IntegralLattice.halfGlueGram` in the basis `e₁, …, eₘ, h`. -/
noncomputable def halfGlueLattice : IntegralLattice (Option (Fin m) → ℚ) :=
  ofGramMatrix (Pi.basisFun ℚ (Option (Fin m))) (halfGlueGram m) (isSymm_halfGlueGram m)

/-- The basis `e₁, …, eₘ, h` of `TauCeti.IntegralLattice.halfGlueLattice`. -/
noncomputable def halfGlueBasis : Basis (Option (Fin m)) ℤ (halfGlueLattice m) :=
  ofGramMatrix.basis _ _ _

lemma sum_mul_halfGlueGram_mul {R : Type*} [CommRing R] (c : Option (Fin m) → R) :
    ∑ i, ∑ j, c i * ((halfGlueGram m i j : ℤ) : R) * c j =
      ∑ i : Fin m, (2 * c (some i) + c none) ^ 2 + c none ^ 2 := by
  classical
  have hrow (i : Fin m) : ∑ j, c (some i) * ((halfGlueGram m (some i) j : ℤ) : R) * c j =
      2 * c none * c (some i) + 4 * c (some i) ^ 2 := by
    rw [Fintype.sum_option]
    have hs : ∑ j : Fin m, c (some i) * ((halfGlueGram m (some i) (some j) : ℤ) : R) *
        c (some j) = 4 * c (some i) ^ 2 := by
      simp only [halfGlueGram, Matrix.of_apply, apply_ite (Int.cast : ℤ → R), Int.cast_zero,
        mul_ite, ite_mul, mul_zero, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
      ring1
    rw [hs]
    simp only [halfGlueGram, Matrix.of_apply]
    ring1
  have hnone : ∑ j, c none * ((halfGlueGram m none j : ℤ) : R) * c j =
      (m + 1) * c none ^ 2 + 2 * c none * ∑ i : Fin m, c (some i) := by
    rw [Fintype.sum_option, Finset.mul_sum]
    simp only [halfGlueGram, Matrix.of_apply]
    push_cast
    exact congrArg₂ _ (by ring1) (Finset.sum_congr rfl fun i _ ↦ by ring1)
  have hrhs : ∑ i : Fin m, (2 * c (some i) + c none) ^ 2 = 4 * ∑ i : Fin m, c (some i) ^ 2 +
      4 * c none * ∑ i : Fin m, c (some i) + m * c none ^ 2 := by
    rw [Finset.sum_congr rfl fun i _ ↦ (by ring1 : (2 * c (some i) + c none) ^ 2 =
      4 * c (some i) ^ 2 + 4 * c none * c (some i) + c none ^ 2), Finset.sum_add_distrib,
      Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_const,
      Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  rw [Fintype.sum_option, hnone, Finset.sum_congr rfl fun i _ ↦ hrow i, Finset.sum_add_distrib,
    ← Finset.mul_sum, ← Finset.mul_sum, hrhs]
  ring1

lemma gramMatrix_halfGlueBasis :
    (halfGlueLattice m).gramMatrix (halfGlueBasis m) = halfGlueGram m :=
  gramMatrix_ofGramMatrix _ _ _

variable {x : halfGlueLattice m} {c : Option (Fin m) → ℤ} (i : Fin m)

variable (x) in
lemma integralNorm_halfGlueLattice : (halfGlueLattice m).integralNorm x =
    ∑ i : Fin m, (2 * (halfGlueBasis m).repr x (some i) + (halfGlueBasis m).repr x none) ^ 2 +
      (halfGlueBasis m).repr x none ^ 2 := by
  rw [integralNorm_eq_sum_repr (halfGlueBasis m), gramMatrix_halfGlueBasis]
  exact_mod_cast sum_mul_halfGlueGram_mul m fun i ↦ (halfGlueBasis m).repr x i

/-- **`Lₘ` has rank `m + 1`.** -/
lemma finrank_halfGlueLattice : finrank ℤ (halfGlueLattice m) = m + 1 := by
  rw [finrank_eq_card_basis (halfGlueBasis m), Fintype.card_option, Fintype.card_fin]

/-- **`Lₘ` is positive definite.** -/
lemma isPosDef_halfGlueLattice : (halfGlueLattice m).IsPosDef := by
  let _ : DecidableEq (Option (Fin m)) := Classical.decEq _
  rw [isPosDef_iff]
  intro y hy
  rw [halfGlueLattice, ofGramMatrix_form, Matrix.toBilin_apply]
  simp only [Pi.basisFun_repr, Matrix.map_apply, eq_intCast]
  rw [sum_mul_halfGlueGram_mul]
  by_contra hle
  have hsq (j : Fin m) : (2 * y (some j) + y none) ^ 2 = 0 := by
    have hj : (2 * y (some j) + y none) ^ 2 ≤ ∑ l : Fin m, (2 * y (some l) + y none) ^ 2 :=
      Finset.single_le_sum (fun l _ ↦ sq_nonneg (2 * y (some l) + y none)) (Finset.mem_univ j)
    nlinarith [sq_nonneg (y none)]
  have hnone : y none = 0 := by
    nlinarith [Finset.sum_nonneg fun l (_ : l ∈ Finset.univ) ↦ sq_nonneg (2 * y (some l) + y none)]
  refine hy (funext fun o ↦ ?_)
  rcases o with _ | j
  · exact hnone
  · simpa [hnone] using hsq j

lemma four_le_sum_sq_add_sq (hm : 4 ≤ m) (hc : c ≠ 0) :
    4 ≤ ∑ i : Fin m, (2 * c (some i) + c none) ^ 2 + c none ^ 2 := by
  have hnn : 0 ≤ ∑ i : Fin m, (2 * c (some i) + c none) ^ 2 :=
    Finset.sum_nonneg fun i _ ↦ sq_nonneg _
  rcases Int.even_or_odd (c none) with ⟨k, hk⟩ | ⟨k, hk⟩
  · rcases eq_or_ne k 0 with rfl | hk0
    · rw [add_zero] at hk
      rcases Function.ne_iff.mp hc with ⟨o, ho⟩
      rcases o with _ | j
      · exact absurd hk ho
      · have hj : (2 * c (some j) + c none) ^ 2 ≤ ∑ l : Fin m, (2 * c (some l) + c none) ^ 2 :=
          Finset.single_le_sum (fun l _ ↦ sq_nonneg (2 * c (some l) + c none)) (Finset.mem_univ j)
        have hj1 : 0 < c (some j) ^ 2 := sq_pos_of_ne_zero ho
        rw [hk] at hj ⊢
        nlinarith
    · have hk1 : 0 < k ^ 2 := sq_pos_of_ne_zero hk0
      rw [hk] at hnn ⊢
      nlinarith
  · have hodd (j : Fin m) : 0 < (2 * c (some j) + c none) ^ 2 :=
      sq_pos_of_ne_zero (by omega)
    have hsum : Finset.univ.card • 1 ≤ ∑ j : Fin m, (2 * c (some j) + c none) ^ 2 :=
      Finset.card_nsmul_le_sum Finset.univ _ 1 fun j _ ↦ hodd j
    simp only [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hsum
    have hm' : (4 : ℤ) ≤ m := by
      exact_mod_cast hm
    nlinarith [sq_nonneg (c none)]

lemma even_of_sum_sq_add_sq_eq_four (hm : 4 ≤ m)
    (h : ∑ i : Fin m, (2 * c (some i) + c none) ^ 2 + c none ^ 2 = 4) : Even (c none) := by
  by_contra hodd
  rcases Int.not_even_iff_odd.mp hodd with ⟨k, hk⟩
  have hodd' (j : Fin m) : 0 < (2 * c (some j) + c none) ^ 2 :=
    sq_pos_of_ne_zero (by omega)
  have hsum : Finset.univ.card • 1 ≤ ∑ j : Fin m, (2 * c (some j) + c none) ^ 2 :=
    Finset.card_nsmul_le_sum Finset.univ _ 1 fun j _ ↦ hodd' j
  simp only [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at hsum
  have hm' : (4 : ℤ) ≤ m := by
    exact_mod_cast hm
  have h1 : 0 < c none ^ 2 := sq_pos_of_ne_zero (by omega)
  linarith

/-- **The minimum of `Lₘ` is `4`** for `m ≥ 4`. -/
lemma minimum_halfGlueLattice (hm : 4 ≤ m) : (halfGlueLattice m).minimum = 4 := by
  classical
  have hle (y : halfGlueLattice m) (hy : y ≠ 0) : 4 ≤ (halfGlueLattice m).integralNorm y := by
    rw [integralNorm_halfGlueLattice]
    refine four_le_sum_sq_add_sq m hm fun h ↦ hy ?_
    exact (halfGlueBasis m).repr.injective (Finsupp.ext fun o ↦ by simpa using congrFun h o)
  have hnorm : (halfGlueLattice m).integralNorm (halfGlueBasis m (some ⟨0, by omega⟩)) = 4 := by
    rw [integralNorm_halfGlueLattice]
    simp [Finsupp.single_apply]
  refine le_antisymm (Nat.sInf_le ⟨_, (halfGlueBasis m).ne_zero _, hnorm⟩) ?_
  refine le_csInf ⟨4, _, (halfGlueBasis m).ne_zero _, hnorm⟩ ?_
  rintro k ⟨y, hy, hk⟩
  have h4 : 4 ≤ (halfGlueLattice m).integralNorm y := hle y hy
  rw [hk] at h4
  exact_mod_cast h4

lemma even_repr_none_of_mem_minimalVectors (hm : 4 ≤ m)
    (hx : x ∈ (halfGlueLattice m).minimalVectors) : Even ((halfGlueBasis m).repr x none) := by
  rw [mem_minimalVectors_iff, minimum_halfGlueLattice m hm, integralNorm_halfGlueLattice] at hx
  exact even_of_sum_sq_add_sq_eq_four m hm (c := fun o ↦ (halfGlueBasis m).repr x o)
    (by exact_mod_cast hx.1)

/-- **`Lₘ` is not generated by its minimal vectors** (LMFDB `lattice.well_rounded`) for `m ≥ 4`:
the last coordinate modulo `2` vanishes at every minimal vector, but not at `h`. -/
lemma not_isGeneratedByMinimalVectors_halfGlueLattice (hm : 4 ≤ m) :
    ¬(halfGlueLattice m).IsGeneratedByMinimalVectors := by
  intro h
  let φ : halfGlueLattice m →ₗ[ℤ] ZMod 2 :=
    (Int.castAddHom (ZMod 2)).toIntLinearMap ∘ₗ (halfGlueBasis m).coord none
  have hle : (halfGlueLattice m).minimalVectorSubmodule ≤ LinearMap.ker φ := by
    rw [minimalVectorSubmodule, Submodule.span_le]
    intro y hy
    rcases even_repr_none_of_mem_minimalVectors m hm hy with ⟨k, hk⟩
    have h2 : ((k + k : ℤ) : ZMod 2) = 0 := by
      rw [← two_mul, Int.cast_mul]
      exact mul_eq_zero_of_left rfl _
    simpa [φ, hk] using h2
  simpa [φ] using hle (eq_top_iff.mp h (Submodule.mem_top (x := halfGlueBasis m none)))

/-- The minimal vector `2h - e₁ - … - eₘ` of `Lₘ`. -/
noncomputable def halfGlueVector : halfGlueLattice m :=
  (2 : ℤ) • halfGlueBasis m none - ∑ i, halfGlueBasis m (some i)

lemma repr_halfGlueVector_none : (halfGlueBasis m).repr (halfGlueVector m) none = 2 := by
  simp [halfGlueVector]

lemma repr_halfGlueVector_some : (halfGlueBasis m).repr (halfGlueVector m) (some i) = -1 := by
  simp [halfGlueVector, Finsupp.single_apply]

lemma halfGlueVector_mem_minimalVectors (hm : 4 ≤ m) :
    halfGlueVector m ∈ (halfGlueLattice m).minimalVectors := by
  rw [mem_minimalVectors_iff, minimum_halfGlueLattice m hm, integralNorm_halfGlueLattice]
  refine ⟨by simp [repr_halfGlueVector_none, repr_halfGlueVector_some], fun h0 ↦ ?_⟩
  have h2 : (halfGlueBasis m).repr (halfGlueVector m) none = 2 := repr_halfGlueVector_none m
  rw [h0, map_zero, Finsupp.zero_apply] at h2
  exact two_ne_zero h2.symm

lemma halfGlueBasis_some_mem_minimalVectors (hm : 4 ≤ m) :
    halfGlueBasis m (some i) ∈ (halfGlueLattice m).minimalVectors := by
  classical
  rw [mem_minimalVectors_iff, minimum_halfGlueLattice m hm, integralNorm_halfGlueLattice]
  refine ⟨?_, (halfGlueBasis m).ne_zero _⟩
  simp [Finsupp.single_apply]

/-- **`Lₘ` is well-rounded** (LMFDB `lattice.well_rounded`) for `m ≥ 4`: its minimal vectors
`e₁, …, eₘ` and `2h - e₁ - … - eₘ` are linearly independent, so they span a sublattice of full
rank. -/
lemma isWellRounded_halfGlueLattice (hm : 4 ≤ m) : (halfGlueLattice m).IsWellRounded := by
  classical
  let v : Option (Fin m) → halfGlueLattice m := fun o ↦ match o with
    | some i => halfGlueBasis m (some i)
    | none => halfGlueVector m
  have hv (o : Option (Fin m)) : v o ∈ (halfGlueLattice m).minimalVectors := by
    rcases o with _ | j
    · exact halfGlueVector_mem_minimalVectors m hm
    · exact halfGlueBasis_some_mem_minimalVectors m j hm
  have hli : LinearIndependent ℤ v := by
    rw [Fintype.linearIndependent_iff]
    intro g hg o
    have key (o' : Option (Fin m)) : ∑ o, g o * (halfGlueBasis m).repr (v o) o' = 0 := by
      simpa using congrArg (fun y ↦ (halfGlueBasis m).repr y o') hg
    have h0 : ∑ o, g o * (halfGlueBasis m).repr (v o) none = 0 := key none
    simp only [Fintype.sum_option, v, repr_halfGlueVector_none, Basis.repr_self,
      Finsupp.single_apply, reduceCtorEq, ↓reduceIte, mul_zero, Finset.sum_const_zero] at h0
    have hnone : g none = 0 := by
      omega
    rcases o with _ | j
    · exact hnone
    · have h1 : ∑ o, g o * (halfGlueBasis m).repr (v o) (some j) = 0 := key (some j)
      simp only [Fintype.sum_option, v, Basis.repr_self, Finsupp.single_apply, Option.some.injEq,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, hnone, zero_mul,
        zero_add] at h1
      exact h1
  let w : Option (Fin m) → (halfGlueLattice m).minimalVectorSubmodule :=
    fun o ↦ ⟨v o, Submodule.subset_span (hv o)⟩
  have hw : LinearIndependent ℤ w :=
    LinearIndependent.of_comp (halfGlueLattice m).minimalVectorSubmodule.subtype hli
  rw [isWellRounded_iff_finrank_eq]
  refine le_antisymm (Submodule.finrank_le _) ?_
  rw [finrank_halfGlueLattice]
  simpa using hw.fintype_card_le_finrank

end TauCeti.IntegralLattice
