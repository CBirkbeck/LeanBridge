import LeanBridge.ForMathlib.LinearAlgebra.Lattice.MartinetSchurmannForm
import LeanBridge.ForMathlib.LinearAlgebra.Lattice.WellRounded

/-!
# Lattices generated by their minimal vectors without a basis of them

Martinet and Schürmann's `10`-dimensional lattice `Λ` is spanned by vectors `e₁, …, e₁₀`, with the
Gram matrix `G` of `TauCeti.IntegralLattice.msGram`, and `x = c / 5`,
`c = (4, 4, 4, 2, 2, 2, 3, 3, 3, 3)`. For `k : ℕ` let `Λₖ` be its orthogonal sum with `k` vectors
`f₁, …, fₖ` of norm `72`, inside `ℚ¹⁰ ⊕ ℚᵏ`: an integral lattice of rank `10 + k`, the products
`x · eᵢ = 12` and `x · x = 72` being integers. Its vectors are the `(t / 5, w)` with
`t = 5 z + a c`, `z ∈ ℤ¹⁰`, `a ∈ ℤ`, `w ∈ ℤᵏ`, of norm `tᵀ G t / 25 + 72 w · w`, so by
`TauCeti.IntegralLattice.msT_eq_of_msQuad_le` its minimum is `72` and its minimal vectors are the
`±eᵢ`, `±x` and `±fₗ`, which span `Λₖ` by definition.

No basis of `Λₖ` consists of minimal vectors. For each of the `11 + k` pairs `±v` of minimal
vectors there is a sublattice `K_v` of `Λₖ` containing the other minimal vectors but not `v`:
`5 yᵢ ∈ cᵢ ℤ` for `v = eᵢ` (the vectors `x` and `eⱼ`, `j ≠ i`, span a sublattice of index `cᵢ`),
`y₁ ∈ ℤ` for `v = x`, and `yₗ ∈ 2 ℤ` for `v = fₗ`. A basis is contained in no `K_v`, so it meets
each of the `11 + k` pairs, but it has only `10 + k` vectors. So being strongly well-rounded is
strictly stronger than being generated by minimal vectors (LMFDB `lattice.well_rounded`), in
every rank `n ≥ 10`.

## Main definitions

* `TauCeti.IntegralLattice.martinetSchurmannLattice`: the integral lattice `Λₖ`.

## Main results

* `TauCeti.IntegralLattice.finrank_martinetSchurmannLattice`: `Λₖ` has rank `10 + k`.
* `TauCeti.IntegralLattice.isPosDef_martinetSchurmannLattice`: it is positive definite.
* `TauCeti.IntegralLattice.minimum_martinetSchurmannLattice`: its minimum is `72`.
* `TauCeti.IntegralLattice.mem_minimalVectors_martinetSchurmannLattice_iff`: its minimal vectors
  are the `±x`, `±eᵢ` and `±fₗ`.
* `TauCeti.IntegralLattice.isGeneratedByMinimalVectors_martinetSchurmannLattice` and
  `TauCeti.IntegralLattice.not_isStronglyWellRounded_martinetSchurmannLattice` (LMFDB
  `lattice.well_rounded`): it is generated by its minimal vectors, but not strongly well-rounded.

## References

* J. Martinet and A. Schürmann, *Bases of minimal vectors in lattices, III*, Int. J. Number Theory
  8 (2012), 551–567, §8.
-/

open Module

open LinearMap (BilinForm)

namespace TauCeti.IntegralLattice

lemma sum_mul_msGram_mul_pos {t : Fin 10 → ℚ} (ht : t ≠ 0) :
    0 < ∑ i, ∑ j, t i * msGram i j * t j := by
  have hid : ∑ i, ∑ j, t i * msGram i j * t j =
      22 * ((t 0 - t 1) ^ 2 + (t 0 - t 2) ^ 2 + (t 1 - t 2) ^ 2) +
        17 * ((t 3 - t 4) ^ 2 + (t 3 - t 5) ^ 2 + (t 4 - t 5) ^ 2) +
        15 * ((t 6 - t 7) ^ 2 + (t 6 - t 8) ^ 2 + (t 6 - t 9) ^ 2 + (t 7 - t 8) ^ 2 +
          (t 7 - t 9) ^ 2 + (t 8 - t 9) ^ 2) +
        (25 * (28 * (t 0 + t 1 + t 2) - 8 * (t 3 + t 4 + t 5) - 19 * (t 6 + t 7 + t 8 + t 9)) ^ 2 +
          40 * (25 * (t 3 + t 4 + t 5) - 8 * (t 6 + t 7 + t 8 + t 9)) ^ 2 +
          7315 * (t 6 + t 7 + t 8 + t 9) ^ 2) / 700 := by
    simp only [msGram, Fin.sum_univ_succ]
    simp
    ring1
  rw [hid]
  by_contra! hle
  have hsq : (t 0 - t 1) ^ 2 = 0 ∧ (t 0 - t 2) ^ 2 = 0 ∧ (t 3 - t 4) ^ 2 = 0 ∧
      (t 3 - t 5) ^ 2 = 0 ∧ (t 6 - t 7) ^ 2 = 0 ∧ (t 6 - t 8) ^ 2 = 0 ∧ (t 6 - t 9) ^ 2 = 0 ∧
      (28 * (t 0 + t 1 + t 2) - 8 * (t 3 + t 4 + t 5) - 19 * (t 6 + t 7 + t 8 + t 9)) ^ 2 = 0 ∧
      (25 * (t 3 + t 4 + t 5) - 8 * (t 6 + t 7 + t 8 + t 9)) ^ 2 = 0 ∧
      (t 6 + t 7 + t 8 + t 9) ^ 2 = 0 := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
      linarith [sq_nonneg (t 0 - t 1), sq_nonneg (t 0 - t 2), sq_nonneg (t 1 - t 2),
        sq_nonneg (t 3 - t 4), sq_nonneg (t 3 - t 5), sq_nonneg (t 4 - t 5),
        sq_nonneg (t 6 - t 7), sq_nonneg (t 6 - t 8), sq_nonneg (t 6 - t 9),
        sq_nonneg (t 7 - t 8), sq_nonneg (t 7 - t 9), sq_nonneg (t 8 - t 9),
        sq_nonneg (28 * (t 0 + t 1 + t 2) - 8 * (t 3 + t 4 + t 5) - 19 * (t 6 + t 7 + t 8 + t 9)),
        sq_nonneg (25 * (t 3 + t 4 + t 5) - 8 * (t 6 + t 7 + t 8 + t 9)),
        sq_nonneg (t 6 + t 7 + t 8 + t 9)]
  simp only [sq_eq_zero_iff] at hsq
  rcases hsq with ⟨h01, h02, h34, h35, h67, h68, h69, hA, hB, hC⟩
  refine ht (funext fun i ↦ ?_)
  fin_cases i <;> simp <;> linarith

lemma exists_eq_single_of_sum_sq_eq_one {ι : Type*} [Fintype ι] [DecidableEq ι] {w : ι → ℤ}
    (h : ∑ l, w l ^ 2 = 1) : ∃ l, w = Pi.single l 1 ∨ w = Pi.single l (-1) := by
  rcases Finset.exists_ne_zero_of_sum_ne_zero (h.trans_ne one_ne_zero) with ⟨l, -, hl⟩
  have hl0 : w l ≠ 0 := pow_ne_zero_iff two_ne_zero |>.mp hl
  have hl1 : 0 < w l ^ 2 := sq_pos_of_ne_zero hl0
  have hsplit : w l ^ 2 + ∑ l' ∈ Finset.univ.erase l, w l' ^ 2 = ∑ l', w l' ^ 2 :=
    Finset.add_sum_erase Finset.univ (fun l ↦ w l ^ 2) (Finset.mem_univ l)
  have hrest : 0 ≤ ∑ l' ∈ Finset.univ.erase l, w l' ^ 2 := Finset.sum_nonneg fun l' _ ↦ sq_nonneg _
  have hother (l' : ι) (hl' : l' ≠ l) : w l' = 0 :=
    (Finset.sum_sq_eq_zero_iff _ _).mp (by omega) l'
      (Finset.mem_erase.mpr ⟨hl', Finset.mem_univ l'⟩)
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one (w l)).mp (by omega)) with ⟨h1, h2⟩
  refine ⟨l, ?_⟩
  rcases (by omega : w l = 1 ∨ w l = -1) with hw | hw
  · refine Or.inl (funext fun l' ↦ ?_)
    rcases eq_or_ne l' l with rfl | hl'
    · simp [hw]
    · simp [hl', hother l' hl']
  · refine Or.inr (funext fun l' ↦ ?_)
    rcases eq_or_ne l' l with rfl | hl'
    · simp [hw]
    · simp [hl', hother l' hl']

variable (k : ℕ) (z z' : Fin 10 → ℤ) (a a' : ℤ) (w w' : Fin k → ℤ)

/-- The Gram matrix of `e₁, …, e₁₀, f₁, …, fₖ`: `TauCeti.IntegralLattice.msGram` and `72` times
the identity. -/
def msBlockGram : Matrix (Fin 10 ⊕ Fin k) (Fin 10 ⊕ Fin k) ℚ :=
  Matrix.fromBlocks (msGram.map (↑)) 0 0 (Matrix.diagonal fun _ ↦ 72)

lemma isSymm_toBilin'_msBlockGram : (msBlockGram k).toBilin'.IsSymm :=
  Matrix.isSymm_toBilin'_iff_isSymm.mpr <|
    .fromBlocks (msGram_isSymm.map _) Matrix.transpose_zero (Matrix.isSymm_diagonal _)

lemma toBilin'_msBlockGram (u v : Fin 10 ⊕ Fin k → ℚ) : (msBlockGram k).toBilin' u v =
    ∑ i, ∑ j, u (.inl i) * msGram i j * v (.inl j) + 72 * ∑ l, u (.inr l) * v (.inr l) := by
  simp [Matrix.toBilin'_apply, msBlockGram, Matrix.diagonal_apply, Finset.mul_sum]
  exact Finset.sum_congr rfl fun l _ ↦ by ring1

/-- The generators of `Λₖ`: `x = c / 5` for `none` and `e₁, …, e₁₀, f₁, …, fₖ`. -/
def msGenerator : Option (Fin 10 ⊕ Fin k) → Fin 10 ⊕ Fin k → ℚ
  | none => Sum.elim (fun i ↦ msGlue i / 5) 0
  | some j => Pi.single j 1

/-- The `ℤ`-span of `x, e₁, …, e₁₀, f₁, …, fₖ`. -/
def msCarrier : Submodule ℤ (Fin 10 ⊕ Fin k → ℚ) :=
  Submodule.span ℤ (Set.range (msGenerator k))

instance : (msCarrier k).IsLattice ℚ where
  fg := Submodule.fg_span (Set.finite_range _)
  span_eq_top := by
    rw [msCarrier, Submodule.span_span_of_tower, eq_top_iff, ← (Pi.basisFun ℚ _).span_eq]
    exact Submodule.span_mono (Set.range_subset_iff.mpr fun j ↦ ⟨some j, by simp [msGenerator]⟩)

/-- The vector `(t / 5, w)` with `t = 5 z + a c`. -/
def msPoint : Fin 10 ⊕ Fin k → ℚ :=
  Sum.elim (fun i ↦ msT z a i / 5) fun l ↦ w l

lemma msGenerator_none : msGenerator k none = msPoint k 0 1 0 := by
  funext j
  rcases j with i | l
  · simp [msGenerator, msPoint, msT_zero_one]
  · simp [msGenerator, msPoint]

lemma msGenerator_inl (i : Fin 10) :
    msGenerator k (some (.inl i)) = msPoint k (Pi.single i 1) 0 0 := by
  funext j
  rcases j with i' | l
  · rcases eq_or_ne i' i with rfl | hi'
    · simp [msGenerator, msPoint, msT_single_zero]
    · simp [msGenerator, msPoint, msT_single_zero, hi']
  · simp [msGenerator, msPoint]

lemma msGenerator_inr (l : Fin k) :
    msGenerator k (some (.inr l)) = msPoint k 0 0 (Pi.single l 1) := by
  funext j
  rcases j with i | l'
  · simp [msGenerator, msPoint, msT_zero_zero]
  · rcases eq_or_ne l' l with rfl | hl'
    · simp [msGenerator, msPoint]
    · simp [msGenerator, msPoint, hl']

lemma exists_eq_msPoint {v : Fin 10 ⊕ Fin k → ℚ} (hv : v ∈ msCarrier k) :
    ∃ z a w, v = msPoint k z a w := by
  rcases (Submodule.mem_span_range_iff_exists_fun ℤ).mp hv with ⟨c, rfl⟩
  refine ⟨fun i ↦ c (some (.inl i)), c none, fun l ↦ c (some (.inr l)), funext fun j ↦ ?_⟩
  rcases j with i | l
  · simp [msGenerator, msPoint, msT, Pi.single_apply]
    ring1
  · simp [msGenerator, msPoint, Pi.single_apply]

lemma toBilin'_msPoint : (msBlockGram k).toBilin' (msPoint k z a w) (msPoint k z' a' w') =
    ((∑ i, ∑ j, msT z a i * msGram i j * msT z' a' j : ℤ) : ℚ) / 25 +
      72 * ∑ l, (w l : ℚ) * w' l := by
  rw [toBilin'_msBlockGram]
  simp only [msPoint, Sum.elim_inl]
  push_cast
  rw [Finset.sum_div]
  congr 1
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [Finset.sum_div]
  exact Finset.sum_congr rfl fun j _ ↦ by ring1

lemma sum_msT_mul_msGram_mul_msT : ∑ i, ∑ j, msT z a i * msGram i j * msT z' a' j =
    25 * ∑ i, ∑ j, z i * msGram i j * z' j + 300 * (a' * ∑ i, z i + a * ∑ i, z' i) +
      1800 * a * a' := by
  simp only [msT, msGlue, msGram, Fin.sum_univ_succ]
  simp
  ring1

lemma le_dualSubmodule_msCarrier :
    msCarrier k ≤ (msBlockGram k).toBilin'.dualSubmodule (msCarrier k) := fun u hu ↦ by
  rw [BilinForm.mem_dualSubmodule]
  intro v hv
  rcases exists_eq_msPoint k hu with ⟨z, a, w, rfl⟩
  rcases exists_eq_msPoint k hv with ⟨z', a', w', rfl⟩
  rw [toBilin'_msPoint, sum_msT_mul_msGram_mul_msT, Submodule.mem_one]
  refine ⟨∑ i, ∑ j, z i * msGram i j * z' j + 12 * (a' * ∑ i, z i + a * ∑ i, z' i) +
    72 * a * a' + 72 * ∑ l, w l * w' l, ?_⟩
  rw [algebraMap_int_eq, Int.coe_castRingHom]
  push_cast
  ring1

/-- **Martinet and Schürmann's lattice `Λₖ`**, plus `k` orthogonal vectors of norm `72`: the
`ℤ`-span of `x, e₁, …, e₁₀, f₁, …, fₖ` in `ℚ¹⁰ ⊕ ℚᵏ` with the form of
`TauCeti.IntegralLattice.msBlockGram`. -/
noncomputable def martinetSchurmannLattice : IntegralLattice (Fin 10 ⊕ Fin k → ℚ) :=
  ofSubmodule (msCarrier k) (msBlockGram k).toBilin' (isSymm_toBilin'_msBlockGram k)
    (le_dualSubmodule_msCarrier k)

lemma form_martinetSchurmannLattice :
    (martinetSchurmannLattice k).form = (msBlockGram k).toBilin' :=
  rfl

/-- **`Λₖ` has rank `10 + k`.** -/
lemma finrank_martinetSchurmannLattice : finrank ℤ (martinetSchurmannLattice k) = 10 + k := by
  rw [finrank_carrier, Module.finrank_fintype_fun_eq_card, Fintype.card_sum, Fintype.card_fin,
    Fintype.card_fin]

/-- **`Λₖ` is positive definite.** -/
lemma isPosDef_martinetSchurmannLattice : (martinetSchurmannLattice k).IsPosDef := by
  rw [isPosDef_iff]
  intro u hu
  rw [form_martinetSchurmannLattice, toBilin'_msBlockGram]
  have hw : 0 ≤ ∑ l, u (.inr l) * u (.inr l) := Finset.sum_nonneg fun l _ ↦ mul_self_nonneg _
  by_cases ht : (fun i ↦ u (.inl i)) = 0
  · have ht' (i : Fin 10) : u (.inl i) = 0 := congrFun ht i
    rcases Function.ne_iff.mp hu with ⟨j, hj⟩
    rcases j with i | l
    · exact absurd (ht' i) hj
    · have hpos : 0 < ∑ l, u (.inr l) * u (.inr l) :=
        Finset.sum_pos' (fun l _ ↦ mul_self_nonneg _) ⟨l, Finset.mem_univ _, mul_self_pos.mpr hj⟩
      simp [ht']
      linarith
  · linarith [sum_mul_msGram_mul_pos ht]

variable {x : martinetSchurmannLattice k} {p q : Option (Fin 10 ⊕ Fin k)}

variable {z a w} in
lemma integralNorm_martinetSchurmannLattice (hx : (x : Fin 10 ⊕ Fin k → ℚ) = msPoint k z a w) :
    25 * (martinetSchurmannLattice k).integralNorm x = msQuad (msT z a) + 1800 * ∑ l, w l ^ 2 := by
  have h : ((martinetSchurmannLattice k).integralNorm x : ℚ) =
      ((msQuad (msT z a) : ℤ) : ℚ) / 25 + 72 * ∑ l, (w l : ℚ) * w l := by
    rw [integralNorm_apply, integralForm_cast, form_martinetSchurmannLattice, hx, toBilin'_msPoint]
    rfl
  have h25 : ((25 * (martinetSchurmannLattice k).integralNorm x : ℤ) : ℚ) =
      ((msQuad (msT z a) + 1800 * ∑ l, w l ^ 2 : ℤ) : ℚ) := by
    rw [Int.cast_mul, h]
    push_cast [sq]
    ring1
  exact_mod_cast h25

lemma seventy_two_le_integralNorm_martinetSchurmannLattice (hx : x ≠ 0) :
    72 ≤ (martinetSchurmannLattice k).integralNorm x := by
  rcases exists_eq_msPoint k x.2 with ⟨z, a, w, hzaw⟩
  have h25 :
      25 * (martinetSchurmannLattice k).integralNorm x = msQuad (msT z a) + 1800 * ∑ l, w l ^ 2 :=
    integralNorm_martinetSchurmannLattice k hzaw
  have hw : 0 ≤ ∑ l, w l ^ 2 := Finset.sum_nonneg fun l _ ↦ sq_nonneg _
  by_cases hle : msQuad (msT z a) ≤ 1800
  · rcases msT_eq_of_msQuad_le z a hle with h0 | hc | hc | ⟨i, hi | hi⟩
    · have hw1 : 1 ≤ ∑ l, w l ^ 2 := by
        by_contra! hlt
        have hw0 (l : Fin k) : w l = 0 :=
          (Finset.sum_sq_eq_zero_iff _ _).mp (by omega) l (Finset.mem_univ l)
        refine hx (Subtype.ext (hzaw.trans (funext fun j ↦ ?_)))
        rcases j with i | l
        · simp [msPoint, h0]
        · simp [msPoint, hw0]
      rw [h0, msQuad_zero] at h25
      omega
    · rw [hc, msQuad_msGlue] at h25
      omega
    · rw [hc, msQuad_neg, msQuad_msGlue] at h25
      omega
    · rw [hi, msQuad_single] at h25
      omega
    · rw [hi, msQuad_single] at h25
      omega
  · omega

lemma exists_coe_eq_msGenerator (hx : (martinetSchurmannLattice k).integralNorm x = 72) : ∃ p,
    (x : Fin 10 ⊕ Fin k → ℚ) = msGenerator k p ∨ (x : Fin 10 ⊕ Fin k → ℚ) = -msGenerator k p := by
  rcases exists_eq_msPoint k x.2 with ⟨z, a, w, hzaw⟩
  have h25 : 25 * 72 = msQuad (msT z a) + 1800 * ∑ l, w l ^ 2 :=
    hx ▸ integralNorm_martinetSchurmannLattice k hzaw
  have hw : 0 ≤ ∑ l, w l ^ 2 := Finset.sum_nonneg fun l _ ↦ sq_nonneg _
  rcases msT_eq_of_msQuad_le z a (by omega) with h0 | hc | hc | ⟨i, hi | hi⟩
  · rw [h0, msQuad_zero] at h25
    rcases exists_eq_single_of_sum_sq_eq_one (by omega : ∑ l, w l ^ 2 = 1) with ⟨l, hl | hl⟩
    · refine ⟨some (.inr l), Or.inl (hzaw.trans (funext fun j ↦ ?_))⟩
      rcases j with i | l'
      · simp [msPoint, msGenerator, h0]
      · simp [msPoint, msGenerator, hl, Pi.single_apply]
    · refine ⟨some (.inr l), Or.inr (hzaw.trans (funext fun j ↦ ?_))⟩
      rcases j with i | l'
      · simp [msPoint, msGenerator, h0]
      · simp [msPoint, msGenerator, hl, Pi.single_apply, apply_ite]
  · rw [hc, msQuad_msGlue] at h25
    have hw0 (l : Fin k) : w l = 0 :=
      (Finset.sum_sq_eq_zero_iff _ _).mp (by omega) l (Finset.mem_univ l)
    refine ⟨none, Or.inl (hzaw.trans (funext fun j ↦ ?_))⟩
    rcases j with i | l
    · simp [msPoint, msGenerator, hc]
    · simp [msPoint, msGenerator, hw0]
  · rw [hc, msQuad_neg, msQuad_msGlue] at h25
    have hw0 (l : Fin k) : w l = 0 :=
      (Finset.sum_sq_eq_zero_iff _ _).mp (by omega) l (Finset.mem_univ l)
    refine ⟨none, Or.inr (hzaw.trans (funext fun j ↦ ?_))⟩
    rcases j with i | l
    · simp [msPoint, msGenerator, hc, neg_div]
    · simp [msPoint, msGenerator, hw0]
  · rw [hi, msQuad_single] at h25
    have hw0 (l : Fin k) : w l = 0 :=
      (Finset.sum_sq_eq_zero_iff _ _).mp (by omega) l (Finset.mem_univ l)
    refine ⟨some (.inl i), Or.inl (hzaw.trans (funext fun j ↦ ?_))⟩
    rcases j with i' | l
    · rcases eq_or_ne i' i with rfl | hi'
      · simp [msPoint, msGenerator, hi]
      · simp [msPoint, msGenerator, hi, hi']
    · simp [msPoint, msGenerator, hw0]
  · rw [hi, msQuad_single] at h25
    have hw0 (l : Fin k) : w l = 0 :=
      (Finset.sum_sq_eq_zero_iff _ _).mp (by omega) l (Finset.mem_univ l)
    refine ⟨some (.inl i), Or.inr (hzaw.trans (funext fun j ↦ ?_))⟩
    rcases j with i' | l
    · rcases eq_or_ne i' i with rfl | hi'
      · simp [msPoint, msGenerator, hi]
      · simp [msPoint, msGenerator, hi, hi']
    · simp [msPoint, msGenerator, hw0]

lemma integralNorm_of_coe_eq_msGenerator (hx : (x : Fin 10 ⊕ Fin k → ℚ) = msGenerator k p) :
    (martinetSchurmannLattice k).integralNorm x = 72 := by
  rcases p with _ | i | l
  · have h25 : 25 * (martinetSchurmannLattice k).integralNorm x =
        msQuad (msT 0 1) + 1800 * ∑ l, (0 : Fin k → ℤ) l ^ 2 :=
      integralNorm_martinetSchurmannLattice k (hx.trans (msGenerator_none k))
    rw [msT_zero_one, msQuad_msGlue] at h25
    simp at h25
    omega
  · have h25 : 25 * (martinetSchurmannLattice k).integralNorm x =
        msQuad (msT (Pi.single i 1) 0) + 1800 * ∑ l, (0 : Fin k → ℤ) l ^ 2 :=
      integralNorm_martinetSchurmannLattice k (hx.trans (msGenerator_inl k i))
    rw [msT_single_zero, msQuad_single] at h25
    simp at h25
    omega
  · have h25 : 25 * (martinetSchurmannLattice k).integralNorm x =
        msQuad (msT 0 0) + 1800 * ∑ l', (Pi.single l 1 : Fin k → ℤ) l' ^ 2 :=
      integralNorm_martinetSchurmannLattice k (hx.trans (msGenerator_inr k l))
    rw [msT_zero_zero, msQuad_zero] at h25
    simp [Pi.single_apply] at h25
    omega

/-- **The minimum of `Λₖ` is `72`.** -/
lemma minimum_martinetSchurmannLattice : (martinetSchurmannLattice k).minimum = 72 := by
  let y : martinetSchurmannLattice k := ⟨msGenerator k none, Submodule.subset_span ⟨none, rfl⟩⟩
  have hy : (martinetSchurmannLattice k).integralNorm y = 72 :=
    integralNorm_of_coe_eq_msGenerator k (p := none) rfl
  have hy0 : y ≠ 0 := fun h ↦ by simp [h] at hy
  refine le_antisymm (Nat.sInf_le ⟨y, hy0, hy⟩) (le_csInf ⟨72, y, hy0, hy⟩ ?_)
  rintro n ⟨y', hy', hn⟩
  have h72 : 72 ≤ (martinetSchurmannLattice k).integralNorm y' :=
    seventy_two_le_integralNorm_martinetSchurmannLattice k hy'
  rw [hn] at h72
  exact_mod_cast h72

variable (x) in
/-- **The minimal vectors of `Λₖ`** are the `±x`, `±eᵢ` and `±fₗ`. -/
lemma mem_minimalVectors_martinetSchurmannLattice_iff : x ∈
    (martinetSchurmannLattice k).minimalVectors ↔ ∃ p, (x : Fin 10 ⊕ Fin k → ℚ) = msGenerator k p ∨
    (x : Fin 10 ⊕ Fin k → ℚ) = -msGenerator k p := by
  rw [mem_minimalVectors_iff, minimum_martinetSchurmannLattice]
  refine ⟨fun h ↦ exists_coe_eq_msGenerator k h.1, fun ⟨p, hp⟩ ↦ ?_⟩
  have h72 : (martinetSchurmannLattice k).integralNorm x = 72 := by
    rcases hp with hp | hp
    · exact integralNorm_of_coe_eq_msGenerator k hp
    · rw [← neg_neg x, QuadraticMap.map_neg]
      exact integralNorm_of_coe_eq_msGenerator k (by rw [Submodule.coe_neg, hp, neg_neg])
  exact ⟨by exact_mod_cast h72, fun h ↦ by simp [h] at h72⟩

/-- **`Λₖ` is generated by its minimal vectors** (LMFDB `lattice.well_rounded`), the vectors
`x, e₁, …, e₁₀, f₁, …, fₖ` spanning it by definition. -/
lemma isGeneratedByMinimalVectors_martinetSchurmannLattice :
    (martinetSchurmannLattice k).IsGeneratedByMinimalVectors := by
  have htop : Submodule.span ℤ (((↑) : martinetSchurmannLattice k → Fin 10 ⊕ Fin k → ℚ) ⁻¹'
      Set.range (msGenerator k)) = ⊤ :=
    Submodule.span_span_coe_preimage
  rw [IsGeneratedByMinimalVectors, eq_top_iff, ← htop]
  exact Submodule.span_mono fun y ⟨p, hp⟩ ↦
    (mem_minimalVectors_martinetSchurmannLattice_iff k y).mpr ⟨p, Or.inl hp.symm⟩

/-- The coordinate tested by `TauCeti.IntegralLattice.msSublattice`. -/
def msIndex : Option (Fin 10 ⊕ Fin k) → Fin 10 ⊕ Fin k
  | none => .inl 0
  | some j => j

/-- The modulus of `TauCeti.IntegralLattice.msSublattice`. -/
def msModulus : Option (Fin 10 ⊕ Fin k) → ℚ
  | none => 1
  | some (.inl i) => msGlue i / 5
  | some (.inr _) => 2

variable (p) in
/-- The sublattice `K_v` of the vectors `y` of `Λₖ` with `y₁ ∈ ℤ` for `v = x` (`none`),
`yᵢ ∈ (cᵢ / 5) ℤ` for `v = eᵢ` and `yₗ ∈ 2 ℤ` for `v = fₗ`. It contains the minimal vectors other
than `±v`, but not `v`. -/
noncomputable def msSublattice : Submodule ℤ (martinetSchurmannLattice k) :=
  (Submodule.span ℤ {msModulus k p}).comap
    (LinearMap.proj (msIndex k p) ∘ₗ (martinetSchurmannLattice k).carrier.subtype)

lemma mem_msSublattice_iff :
    x ∈ msSublattice k p ↔ ∃ n : ℤ, n * msModulus k p = (x : Fin 10 ⊕ Fin k → ℚ) (msIndex k p) := by
  simp [msSublattice, Submodule.mem_span_singleton]

lemma exists_mul_msModulus_eq_msGenerator (hqp : q ≠ p) :
    ∃ n : ℤ, n * msModulus k q = msGenerator k p (msIndex k q) := by
  rcases p with _ | j <;> rcases q with _ | i | l
  · exact absurd rfl hqp
  · exact ⟨1, by simp [msModulus, msGenerator, msIndex]⟩
  · exact ⟨0, by simp [msGenerator, msIndex]⟩
  · rcases eq_or_ne j (.inl 0) with rfl | hj
    · exact ⟨1, by simp [msModulus, msGenerator, msIndex]⟩
    · exact ⟨0, by simp [msGenerator, msIndex, Ne.symm hj]⟩
  · have hij : Sum.inl i ≠ j := fun h ↦ hqp (h ▸ rfl)
    exact ⟨0, by simp [msGenerator, msIndex, hij]⟩
  · have hlj : Sum.inr l ≠ j := fun h ↦ hqp (h ▸ rfl)
    exact ⟨0, by simp [msGenerator, msIndex, hlj]⟩

variable (p) in
lemma not_exists_mul_msModulus_eq_msGenerator :
    ¬∃ n : ℤ, n * msModulus k p = msGenerator k p (msIndex k p) := by
  rintro ⟨n, hn⟩
  rcases p with _ | i | l
  · have h : ((5 * n : ℤ) : ℚ) = (4 : ℤ) := by
      simp [msModulus, msGenerator, msIndex, msGlue] at hn
      push_cast
      rw [hn]
      norm_num
    have h' : 5 * n = 4 := Int.cast_injective h
    omega
  · have h : ((n * msGlue i : ℤ) : ℚ) = (5 : ℤ) := by
      simp [msModulus, msGenerator, msIndex] at hn
      push_cast
      field_simp at hn
      linarith
    have h' : n * msGlue i = 5 := Int.cast_injective h
    fin_cases i <;> simp [msGlue] at h' <;> omega
  · have h : ((2 * n : ℤ) : ℚ) = (1 : ℤ) := by
      simp [msModulus, msGenerator, msIndex] at hn
      push_cast
      linarith
    have h' : 2 * n = 1 := Int.cast_injective h
    omega

lemma mem_msSublattice_of_ne (hqp : q ≠ p) (hx : (x : Fin 10 ⊕ Fin k → ℚ) = msGenerator k p ∨
    (x : Fin 10 ⊕ Fin k → ℚ) = -msGenerator k p) : x ∈ msSublattice k q := by
  rcases exists_mul_msModulus_eq_msGenerator k hqp with ⟨n, hn⟩
  rw [mem_msSublattice_iff]
  rcases hx with hx | hx
  · exact ⟨n, by rw [hx, hn]⟩
  · refine ⟨-n, ?_⟩
    rw [hx, Pi.neg_apply, ← hn]
    push_cast
    ring1

/-- **`Λₖ` is not strongly well-rounded** (LMFDB `lattice.well_rounded`): a basis lies in none of
the sublattices `K_v`, so it meets each of the `11 + k` pairs `±v` of minimal vectors, but it has
only `10 + k` vectors. -/
lemma not_isStronglyWellRounded_martinetSchurmannLattice :
    ¬(martinetSchurmannLattice k).IsStronglyWellRounded := by
  rintro ⟨b, hb⟩
  have hout (p : Option (Fin 10 ⊕ Fin k)) : ∃ j, b j ∉ msSublattice k p := by
    by_contra! h
    have htop : (⊤ : Submodule ℤ (martinetSchurmannLattice k)) ≤ msSublattice k p := by
      rw [← b.span_eq, Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      exact h j
    exact not_exists_mul_msModulus_eq_msGenerator k p <| (mem_msSublattice_iff k).mp <|
      htop (Submodule.mem_top (x := ⟨msGenerator k p, Submodule.subset_span ⟨p, rfl⟩⟩))
  choose σ hσ using hout
  have hinj : σ.Injective := by
    intro p q hpq
    rcases (mem_minimalVectors_martinetSchurmannLattice_iff k _).mp (hb (σ p)) with ⟨r, hr⟩
    have hp : p = r := by
      by_contra hne
      exact hσ p (mem_msSublattice_of_ne k hne hr)
    have hq : q = r := by
      by_contra hne
      exact hσ q (hpq ▸ mem_msSublattice_of_ne k hne hr)
    rw [hp, hq]
  have hcard : Fintype.card (Option (Fin 10 ⊕ Fin k)) ≤
      Fintype.card (Fin (finrank ℤ (martinetSchurmannLattice k))) :=
    Fintype.card_le_of_injective σ hinj
  rw [Fintype.card_option, Fintype.card_sum, Fintype.card_fin, Fintype.card_fin, Fintype.card_fin,
    finrank_martinetSchurmannLattice] at hcard
  omega

end TauCeti.IntegralLattice
