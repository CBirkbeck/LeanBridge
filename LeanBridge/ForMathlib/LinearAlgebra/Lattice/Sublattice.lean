import TauCeti.LinearAlgebra.IntegralLattice.Characteristic.EvenSublattice
import TauCeti.LinearAlgebra.IntegralLattice.PosDef.Minimum
import TauCeti.LinearAlgebra.IntegralLattice.Unit

/-!
# Named sublattices of an integral lattice

A sublattice (LMFDB `lattice.sublattice`) of an integral lattice `L` is a subgroup `M ⊆ L` which
is itself a lattice: a `ℤ`-submodule `M` of the carrier of `L`, which Tau Ceti's
`TauCeti.IntegralLattice.restrict` makes an integral lattice for the restricted form, in the
rational span `ℚ ⊗ M` of `M` (a sublattice need not have full rank). The LMFDB names the
following ones.

* The norm 1 sublattice, generated by the vectors of norm `1` (also LMFDB
  `lattice.norm1_sublattice`). It is trivial for an even lattice, and it is all of `ℤⁿ` for the
  lattice `ℤⁿ` with the sum of squares.
* The root sublattice, generated by the vectors of norm `2`. The LMFDB knowl
  `lattice.root_sublattice` defines the root sublattice of a positive definite lattice with the
  vectors of norm at most `2` instead, which for an odd lattice can be larger.
* The min vector sublattice, generated by the minimal vectors, the nonzero vectors whose norm is
  the minimum of `L`.
* The even sublattice, generated by the vectors of even norm. These already form a submodule, Tau
  Ceti's `TauCeti.IntegralLattice.evenSubmodule`, of finite index; Tau Ceti's
  `TauCeti.IntegralLattice.evenSublattice` is the corresponding lattice in the rational span of
  `L`.
* The max diag sublattice, the maximal sublattice whose Gram matrix is diagonal, that is which has
  a basis of pairwise orthogonal vectors. A greatest such sublattice need not exist: in the root
  lattice `A₂`, with Gram matrix `(2, -1; -1, 2)`, each of the three pairs `±r` of roots gives a
  maximal one of index `2`, spanned by `r` and a vector orthogonal to `r`, and these three are
  distinct. Only the property of being a maximal such sublattice is formalised, not the choice of
  one made by the LMFDB.

## Main definitions

* `TauCeti.IntegralLattice.normOneSubmodule` (LMFDB `lattice.sublattice`,
  `lattice.norm1_sublattice`).
* `TauCeti.IntegralLattice.normTwoSubmodule` (LMFDB `lattice.sublattice`).
* `TauCeti.IntegralLattice.minimalVectors`: the minimal vectors (LMFDB `lattice.minimal_vector`).
* `TauCeti.IntegralLattice.minimalVectorSubmodule` (LMFDB `lattice.sublattice`).
* `TauCeti.IntegralLattice.IsDiagonalSubmodule`: a sublattice with a diagonal Gram matrix.
* `TauCeti.IntegralLattice.IsMaxDiagonalSubmodule` (LMFDB `lattice.sublattice`).

## Main results

* `TauCeti.IntegralLattice.IsEven.normOneSubmodule_eq_bot`: the norm 1 sublattice of an even
  lattice is trivial.
* `TauCeti.IntegralLattice.normOneSubmodule_unitLattice`: the norm 1 sublattice of `ℤⁿ` is `ℤⁿ`.
* `TauCeti.IntegralLattice.kissingNumber_eq_ncard_minimalVectors`: the kissing number counts the
  minimal vectors.
* `TauCeti.IntegralLattice.span_setOf_even_integralNorm`: the vectors of even norm generate Tau
  Ceti's `TauCeti.IntegralLattice.evenSubmodule`.
-/

open Module

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V] (L : IntegralLattice V) (M : Submodule ℤ L)

/-- The **norm 1 sublattice** (LMFDB `lattice.sublattice`, `lattice.norm1_sublattice`) of an
integral lattice `L`: the submodule of its carrier generated by the vectors of norm `1`. -/
noncomputable def normOneSubmodule : Submodule ℤ L :=
  Submodule.span ℤ (L.vectorsOfNorm 1)

/-- The **root sublattice** in the sense of LMFDB `lattice.sublattice` of an integral lattice `L`:
the submodule of its carrier generated by the vectors of norm `2`. LMFDB `lattice.root_sublattice`
uses the vectors of norm `1` and `2` instead (`TauCeti.IntegralLattice.rootSubmodule`). -/
noncomputable def normTwoSubmodule : Submodule ℤ L :=
  Submodule.span ℤ (L.vectorsOfNorm 2)

/-- The **minimal vectors** `S(L)` (LMFDB `lattice.minimal_vector`) of an integral lattice `L`:
its nonzero vectors whose norm is the minimum `min L`. This is meant for a positive definite
lattice, whose minimum is the least norm of a nonzero vector; `S(L)` then contains both `v` and
`-v` for each of the normalised minimal vectors `v` listed by the LMFDB. -/
noncomputable def minimalVectors : Set L :=
  L.vectorsOfNorm L.minimum \ {0}

/-- The **min vector sublattice** (LMFDB `lattice.sublattice`) of an integral lattice `L`: the
submodule of its carrier generated by its minimal vectors. -/
noncomputable def minimalVectorSubmodule : Submodule ℤ L :=
  Submodule.span ℤ L.minimalVectors

/-- A submodule `M` of the carrier of an integral lattice `L` is a sublattice with a **diagonal
Gram matrix** if `M` has a `ℤ`-basis of pairwise orthogonal vectors. -/
def IsDiagonalSubmodule : Prop :=
  ∃ b : Basis (Fin (finrank ℤ M)) ℤ M, Pairwise fun i j ↦ L.integralForm (b i) (b j) = 0

/-- A **max diag sublattice** (LMFDB `lattice.sublattice`) of an integral lattice `L`: a
sublattice with a diagonal Gram matrix that is maximal for inclusion among those. Such
sublattices need not be unique. -/
def IsMaxDiagonalSubmodule : Prop :=
  Maximal L.IsDiagonalSubmodule M

lemma mem_minimalVectors_iff (x : L) :
    x ∈ L.minimalVectors ↔ L.integralNorm x = L.minimum ∧ x ≠ 0 := by
  rw [minimalVectors, Set.mem_sdiff, mem_vectorsOfNorm_natCast, Set.mem_singleton_iff]

/-- **The kissing number of `L` is the number of its minimal vectors.** -/
lemma kissingNumber_eq_ncard_minimalVectors : L.kissingNumber = L.minimalVectors.ncard :=
  L.kissingNumber_def

/-- **The vectors of even norm generate Tau Ceti's even submodule**, which consists of them. -/
lemma span_setOf_even_integralNorm :
    Submodule.span ℤ {x : L | Even (L.integralNorm x)} = L.evenSubmodule :=
  le_antisymm (Submodule.span_le.mpr fun x hx ↦ (L.mem_evenSubmodule_iff x).mpr hx)
    fun x hx ↦ Submodule.subset_span ((L.mem_evenSubmodule_iff x).mp hx)

/-- **The norm 1 sublattice of `ℤⁿ` is `ℤⁿ`**, the lattice `ℤⁿ` with the sum of squares being Tau
Ceti's `unitLattice ι`, spanned by the coordinate vectors, of norm `1`. -/
lemma normOneSubmodule_unitLattice (ι : Type*) [Fintype ι] : (unitLattice ι).normOneSubmodule = ⊤ :=
  eq_top_iff.mpr <| (unitLatticeBasis ι).span_eq.ge.trans <| Submodule.span_mono <|
    Set.range_subset_iff.mpr fun i ↦ by classical simp [Pi.single_apply]

variable {L}

/-- **The norm 1 sublattice of an even lattice is trivial**, as it has no vector of odd norm. -/
lemma IsEven.normOneSubmodule_eq_bot (hL : L.IsEven) : L.normOneSubmodule = ⊥ := by
  rw [normOneSubmodule, ← Int.cast_one, hL.vectorsOfNorm_eq_empty_of_not_even L Int.not_even_one,
    Submodule.span_empty]

end TauCeti.IntegralLattice
