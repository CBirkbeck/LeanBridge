import TauCeti.LinearAlgebra.IntegralLattice.Orthogonal.Sum
import TauCeti.NumberTheory.Padics.SerreSigns
import LeanBridge.ForMathlib.LinearAlgebra.Lattice.DiscriminantConventions

/-!
# The Witt discriminant and the 2-adic unit discriminant

Two of the properties that LMFDB `lattice.discriminant` states for its conventions:

* the Witt discriminant `(-1)^(n choose 2) D` is stable under adding copies of the hyperbolic plane
  `U`: of an orthogonal sum it is the product of those of the summands, up to the sign
  `(-1)^(nm)` from their ranks `n` and `m`, and `U` has rank `2` and Witt discriminant `1`;
* the 2-adic unit discriminant `2^(-v₂(D)) D mod 8` gives the `2`-adic square class of the odd part
  `2^(-v₂(D)) D` of the discriminant: two odd integers are congruent modulo `8` exactly when their
  quotient is the square of a `2`-adic unit, by Tau Ceti's decomposition of the `2`-adic units
  `u = (-1)^ε(u) 5^ω(u) w²`, whose signs `ε` and `ω` depend only on `u mod 8`.

The knowl's third property, that the centre of the even Clifford algebra is the quadratic étale
algebra generated by a square root of the Witt discriminant, is not formalised here; it holds only
in even rank, the even Clifford algebra of a form of odd rank being central simple.

## Main results

* `TauCeti.IntegralLattice.wittDiscriminant_orthogonalSum_hyperbolicPlane` (LMFDB
  `lattice.discriminant`): adding a hyperbolic plane does not change the Witt discriminant.
* `PadicInt.intCast_eq_iff_exists_eq_mul_sq`: two odd integers are congruent modulo `8` exactly
  when they have the same `2`-adic square class.
* `TauCeti.IntegralLattice.twoAdicUnitDiscriminant_eq_iff` (LMFDB `lattice.discriminant`): the
  2-adic unit discriminant gives the `2`-adic square class of the odd part of the discriminant.
-/

open Finset Module

lemma Int.not_two_dvd_div_two_pow_padicValInt {D : ℤ} (hD : D ≠ 0) :
    ¬(2 : ℤ) ∣ D / 2 ^ padicValInt 2 D := by
  rintro ⟨c, hc⟩
  have hdvd : (2 : ℤ) ^ padicValInt 2 D ∣ D := by
    exact_mod_cast padicValInt_dvd (p := 2) D
  have hv : D = 2 ^ padicValInt 2 D * (2 * c) := by
    rw [← hc, Int.mul_ediv_cancel' hdvd]
  have h : ((2 : ℕ) : ℤ) ^ (padicValInt 2 D + 1) ∣ D :=
    ⟨c, by rwa [Nat.cast_ofNat, pow_succ, mul_assoc]⟩
  rcases (padicValInt_dvd_iff (p := 2) _ D).mp h with h | h
  · exact hD h
  · omega

namespace PadicInt

lemma exists_eq_mul_sq_of_toZModPow_eq {u v : ℤ_[2]ˣ}
    (h : toZModPow 3 (u : ℤ_[2]) = toZModPow 3 (v : ℤ_[2])) :
    ∃ w : ℤ_[2]ˣ, (u : ℤ_[2]) = v * w ^ 2 := by
  rcases TauCeti.exists_eq_neg_one_pow_mul_five_pow_mul_sq u with ⟨a, ha⟩
  rcases TauCeti.exists_eq_neg_one_pow_mul_five_pow_mul_sq v with ⟨b, hb⟩
  have hε : TauCeti.serreEps u = TauCeti.serreEps v := by
    rw [TauCeti.serreEps, TauCeti.serreEps, h]
  have hω : TauCeti.serreOmega u = TauCeti.serreOmega v := by
    rw [TauCeti.serreOmega, TauCeti.serreOmega, h]
  refine ⟨a * b⁻¹, ?_⟩
  rw [ha, hb, hε, hω, Units.val_mul]
  linear_combination (-((-1) ^ (TauCeti.serreEps v).val * 5 ^ (TauCeti.serreOmega v).val *
    (a : ℤ_[2]) ^ 2) * ((b : ℤ_[2]) * ↑b⁻¹ + 1)) * Units.mul_inv b

lemma isUnit_intCast_of_not_two_dvd {a : ℤ} (ha : ¬(2 : ℤ) ∣ a) : IsUnit (a : ℤ_[2]) :=
  isUnit_iff.mpr <| norm_intCast_eq_one_iff.mpr <| by
    simpa using Int.prime_two.coprime_iff_not_dvd.mpr ha

/-- **The residue modulo `8` of an odd integer is its `2`-adic square class**: two odd integers are
congruent modulo `8` exactly when their quotient is the square of a `2`-adic unit. -/
lemma intCast_eq_iff_exists_eq_mul_sq {a b : ℤ} (ha : ¬(2 : ℤ) ∣ a) (hb : ¬(2 : ℤ) ∣ b) :
    (a : ZMod 8) = b ↔ ∃ w : ℤ_[2]ˣ, (a : ℤ_[2]) = b * w ^ 2 := by
  refine ⟨fun h ↦ ?_, fun ⟨w, hw⟩ ↦ ?_⟩
  · rcases exists_eq_mul_sq_of_toZModPow_eq (u := (isUnit_intCast_of_not_two_dvd ha).unit)
      (v := (isUnit_intCast_of_not_two_dvd hb).unit) (by simpa using h) with ⟨w, hw⟩
    exact ⟨w, by simpa using hw⟩
  · have hsq : ∀ x : ZMod (2 ^ 3), (∃ y, x * y = 1) → x ^ 2 = 1 := by
      decide
    have h : toZModPow 3 (a : ℤ_[2]) = toZModPow 3 ((b : ℤ_[2]) * (w : ℤ_[2]) ^ 2) :=
      congrArg (toZModPow 3) hw
    rwa [map_intCast, map_mul, map_intCast, map_pow,
      hsq _ ⟨toZModPow 3 ↑w⁻¹, by rw [← map_mul, Units.mul_inv, map_one]⟩, mul_one] at h

end PadicInt

namespace TauCeti.IntegralLattice

variable {V W : Type*} [AddCommGroup V] [Module ℚ V] [AddCommGroup W] [Module ℚ W]
  (L : IntegralLattice V) (M : IntegralLattice W)

lemma wittDiscriminant_orthogonalSum : (L.orthogonalSum M).wittDiscriminant =
    (-1) ^ (finrank ℚ V * finrank ℚ W) * L.wittDiscriminant * M.wittDiscriminant := by
  have hV : FiniteDimensional ℚ V := L.finiteDimensional
  have hW : FiniteDimensional ℚ W := M.finiteDimensional
  rw [wittDiscriminant, wittDiscriminant, wittDiscriminant, determinant_orthogonalSum,
    finrank_prod, Nat.add_choose_eq, Nat.sum_antidiagonal_succ, Nat.sum_antidiagonal_succ,
    HasAntidiagonal.antidiagonal_zero, sum_singleton, Nat.choose_zero_right, Nat.choose_zero_right,
    Nat.choose_one_right, Nat.choose_one_right]
  ring1

/-- **The Witt discriminant is stable under adding a hyperbolic plane** (LMFDB
`lattice.discriminant`): `L ⊕ U` has the Witt discriminant of `L`, so adding any number of copies of
`U` does not change it. -/
lemma wittDiscriminant_orthogonalSum_hyperbolicPlane :
    (L.orthogonalSum hyperbolicPlane).wittDiscriminant = L.wittDiscriminant := by
  rw [wittDiscriminant_orthogonalSum, wittDiscriminant_hyperbolicPlane, finrank_fin_fun, mul_two,
    pow_add, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul, mul_one]

/-- **The 2-adic unit discriminant gives the `2`-adic square class of the odd part of the
discriminant** (LMFDB `lattice.discriminant`): two nondegenerate integral lattices have the same
`2`-adic unit discriminant `2^(-v₂(D)) D mod 8` exactly when the odd parts `2^(-v₂(D)) D` of their
discriminants differ by the square of a `2`-adic unit. -/
lemma twoAdicUnitDiscriminant_eq_iff [L.IsNondegenerate] [M.IsNondegenerate] :
    L.twoAdicUnitDiscriminant = M.twoAdicUnitDiscriminant ↔ ∃ w : ℤ_[2]ˣ,
      ((L.determinant / 2 ^ padicValInt 2 L.determinant : ℤ) : ℤ_[2]) =
        ((M.determinant / 2 ^ padicValInt 2 M.determinant : ℤ) : ℤ_[2]) * w ^ 2 :=
  PadicInt.intCast_eq_iff_exists_eq_mul_sq
    (Int.not_two_dvd_div_two_pow_padicValInt (L.determinant_ne_zero_iff.mpr L.form_nondegenerate))
    (Int.not_two_dvd_div_two_pow_padicValInt (M.determinant_ne_zero_iff.mpr M.form_nondegenerate))

end TauCeti.IntegralLattice
