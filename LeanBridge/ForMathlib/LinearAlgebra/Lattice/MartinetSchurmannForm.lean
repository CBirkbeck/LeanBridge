lemma lt_msQuad_of_classA_classC (hA : (z 0 + z 1 + z 2) % 3 ≠ 0)
    (hC : (z 6 + z 7 + z 8 + z 9) % 4 ≠ 0) : 1800 < msQuad (msT z a) := by
  rw [msQuad_msT]
