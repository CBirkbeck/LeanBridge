import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.LinearAlgebra.Matrix.Symmetric
import Mathlib.Tactic.IntervalCases
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-!
# The quadratic form of a lattice without a basis of minimal vectors

Martinet and Schürmann's `10`-dimensional lattice `Λ` generated by its minimal vectors but without
a basis of them has `11` pairs of minimal vectors `±e₁, …, ±e₁₀, ±x` with
`5 x = 4 (e₁ + e₂ + e₃) + 2 (e₄ + e₅ + e₆) + 3 (e₇ + e₈ + e₉ + e₁₀)`, and any Gram matrix of
the `eᵢ` in the interior of their realisation polytope works. We take the one invariant under the
permutations of `{e₁, e₂, e₃}`, `{e₄, e₅, e₆}` and `{e₇, …, e₁₀}` (the average of Martinet and
Schürmann's integral example over these permutations, times `3 / 2`): `72` on the diagonal, `6`,
`21`, `12` inside the three classes and `-8`, `-19`, `-6` between them.

A vector of `Λ` is `y = t / 5` with `t = 5 z + a c`, `z ∈ ℤ¹⁰`, `a ∈ ℤ`,
`c = (4, 4, 4, 2, 2, 2, 3, 3, 3, 3)`. Writing `D_A`, `D_B`, `D_C` for the sums of the squared
differences of the `zᵢ` in the three classes and `T_A = 5 Z_A + 12 a`, `T_B = 5 Z_B + 6 a`,
`T_C = 5 Z_C + 12 a` for the sums of the `tᵢ` (`Z` the sums of the `zᵢ`),

`tᵀ G t = 25 (22 D_A + 17 D_B + 15 D_C) + R(T_A, T_B, T_C)`,

`R = 28 u² + 38 v² + 27 w² - 16 u v - 38 u w - 12 v w` positive definite. The class sums modulo
`3`, `3` and `4` bound the `D` from below (`D_A ≥ 2` if `3 ∤ Z_A`, `D_C ≥ 3` if `Z_C` is odd,
`D_C ≥ 4` if `Z_C ≡ 2 (mod 4)`), which leaves five ternary problems for `R`, each settled by
bounding the variables with an explicit sum of squares and checking the few remaining points. The
outcome: `tᵀ G t ≥ 1800 = 25 · 72` for `t ≠ 0`, with equality exactly at `t = ±5 eᵢ` and `t = ±c`.

## Main definitions

* `TauCeti.IntegralLattice.msGram`: the Gram matrix of `e₁, …, e₁₀`.
* `TauCeti.IntegralLattice.msGlue`: the vector `c`.
* `TauCeti.IntegralLattice.msR`: the ternary form `R`.

## Main results

* `TauCeti.IntegralLattice.msQuad_msT`: the identity above.
* `TauCeti.IntegralLattice.msT_eq_of_msQuad_le`: the vectors `t ≠ 0` with `tᵀ G t ≤ 1800` are the
  `22` vectors `±5 eᵢ`, `±c`.

## References

* J. Martinet and A. Schürmann, *Bases of minimal vectors in lattices, III*, Int. J. Number Theory
  8 (2012), 551–567, §8.
-/

namespace TauCeti.IntegralLattice

variable (t z : Fin 10 → ℤ) (a u v w : ℤ) (i : Fin 10)

/-- The Gram matrix of the vectors `e₁, …, e₁₀` of Martinet and Schürmann's lattice, made invariant
under the permutations of the three classes `{e₁, e₂, e₃}`, `{e₄, e₅, e₆}`, `{e₇, …, e₁₀}`. -/
def msGram : Matrix (Fin 10) (Fin 10) ℤ :=
  !![72, 6, 6, -8, -8, -8, -19, -19, -19, -19;
     6, 72, 6, -8, -8, -8, -19, -19, -19, -19;
     6, 6, 72, -8, -8, -8, -19, -19, -19, -19;
     -8, -8, -8, 72, 21, 21, -6, -6, -6, -6;
     -8, -8, -8, 21, 72, 21, -6, -6, -6, -6;
     -8, -8, -8, 21, 21, 72, -6, -6, -6, -6;
     -19, -19, -19, -6, -6, -6, 72, 12, 12, 12;
     -19, -19, -19, -6, -6, -6, 12, 72, 12, 12;
     -19, -19, -19, -6, -6, -6, 12, 12, 72, 12;
     -19, -19, -19, -6, -6, -6, 12, 12, 12, 72]

lemma msGram_isSymm : msGram.IsSymm := by
  decide

lemma msGram_apply_self : msGram i i = 72 := by
  fin_cases i <;> rfl

/-- The vector `c = (4, 4, 4, 2, 2, 2, 3, 3, 3, 3)` with `5 x = ∑ cᵢ eᵢ`. -/
def msGlue : Fin 10 → ℤ :=
  ![4, 4, 4, 2, 2, 2, 3, 3, 3, 3]

/-- The quadratic form `tᵀ G t` of `TauCeti.IntegralLattice.msGram`. -/
def msQuad : ℤ :=
  ∑ i, ∑ j, t i * msGram i j * t j

lemma msQuad_zero : msQuad 0 = 0 := by
  simp [msQuad]

lemma msQuad_neg : msQuad (-t) = msQuad t := by
  simp [msQuad]

lemma msQuad_single : msQuad (Pi.single i a) = 72 * a ^ 2 := by
  simp [msQuad, Pi.single_apply, msGram_apply_self]
  ring1

lemma msQuad_msGlue : msQuad msGlue = 1800 := by
  simp [msQuad, msGlue, msGram, Fin.sum_univ_succ]

/-- The vector `t = 5 z + a c`, five times a vector of Martinet and Schürmann's lattice. -/
def msT : Fin 10 → ℤ :=
  fun i ↦ 5 * z i + a * msGlue i

lemma msT_zero_one : msT 0 1 = msGlue := by
  funext i
  simp [msT]

lemma msT_single_zero : msT (Pi.single i 1) 0 = Pi.single i 5 := by
  funext j
  rcases eq_or_ne j i with rfl | hj
  · simp [msT]
  · simp [msT, hj]

lemma msT_zero_zero : msT 0 0 = 0 := by
  funext i
  simp [msT]

/-- The positive definite ternary form `R(u, v, w) = 28 u² + 38 v² + 27 w² - 16 u v - 38 u w -
12 v w` of the class sums. -/
def msR : ℤ :=
  28 * u * u + 38 * v * v + 27 * w * w - 16 * u * v - 38 * u * w - 12 * v * w

lemma msR_nonneg : 0 ≤ msR u v w := by
  unfold msR
  nlinarith [sq_nonneg (28 * u - 8 * v - 19 * w), sq_nonneg (25 * v - 8 * w), sq_nonneg w]

/-- The spread `D_A` of the first class. -/
def msDA : ℤ :=
  (z 0 - z 1) ^ 2 + (z 0 - z 2) ^ 2 + (z 1 - z 2) ^ 2

/-- The spread `D_B` of the second class. -/
def msDB : ℤ :=
  (z 3 - z 4) ^ 2 + (z 3 - z 5) ^ 2 + (z 4 - z 5) ^ 2

/-- The spread `D_C` of the third class. -/
def msDC : ℤ :=
  (z 6 - z 7) ^ 2 + (z 6 - z 8) ^ 2 + (z 6 - z 9) ^ 2 + (z 7 - z 8) ^ 2 + (z 7 - z 9) ^ 2 +
    (z 8 - z 9) ^ 2

lemma msDA_nonneg : 0 ≤ msDA z := by
  unfold msDA
  positivity

lemma msDB_nonneg : 0 ≤ msDB z := by
  unfold msDB
  positivity

lemma msDC_nonneg : 0 ≤ msDC z := by
  unfold msDC
  positivity

lemma msQuad_eq : msQuad t = 22 * msDA t + 17 * msDB t + 15 * msDC t +
    msR (t 0 + t 1 + t 2) (t 3 + t 4 + t 5) (t 6 + t 7 + t 8 + t 9) := by
  simp only [msQuad, msR, msGram, msDA, msDB, msDC, Fin.sum_univ_succ]
  simp
  ring1

/-- **The norm form on Martinet and Schürmann's lattice**: for `t = 5 z + a c`,
`tᵀ G t = 25 (22 D_A + 17 D_B + 15 D_C) + R(T_A, T_B, T_C)`, with the class spreads `D` of `z` and
the class sums `T` of `t`. -/
lemma msQuad_msT : msQuad (msT z a) = 25 * (22 * msDA z + 17 * msDB z + 15 * msDC z) +
    msR (5 * (z 0 + z 1 + z 2) + 12 * a) (5 * (z 3 + z 4 + z 5) + 6 * a)
      (5 * (z 6 + z 7 + z 8 + z 9) + 12 * a) := by
  rw [msQuad_eq]
  simp only [msT, msGlue, msR, msDA, msDB, msDC]
  simp
  ring1

variable {a} {al be ga al' be' ga' TA ZA TB ZB TC ZC : ℤ}

lemma msR_le_of_classes_constant (hal : al = 5 * al' + 4 * a) (hbe : be = 5 * be' + 2 * a)
    (hga : ga = 5 * ga' + 3 * a) (h : msR (3 * al) (3 * be) (4 * ga) ≤ 1800) :
    al = 0 ∧ be = 0 ∧ ga = 0 ∨ al = 4 ∧ be = 2 ∧ ga = 3 ∨ al = -4 ∧ be = -2 ∧ ga = -3 := by
  unfold msR at h
  have h1 : al ≤ 4 := by
    nlinarith [sq_nonneg (19 * be - 4 * ga - 4 * al), sq_nonneg (12 * ga - 7 * al)]
  have h2 : -4 ≤ al := by
    nlinarith [sq_nonneg (19 * be - 4 * ga - 4 * al), sq_nonneg (12 * ga - 7 * al)]
  have h3 : be ≤ 2 := by
    nlinarith [sq_nonneg (21 * al - 19 * ga - 6 * be), sq_nonneg (79 * ga - 48 * be)]
  have h4 : -2 ≤ be := by
    nlinarith [sq_nonneg (21 * al - 19 * ga - 6 * be), sq_nonneg (79 * ga - 48 * be)]
  have h5 : ga ≤ 3 := by
    nlinarith [sq_nonneg (21 * al - 6 * be - 19 * ga), sq_nonneg (75 * be - 32 * ga)]
  have h6 : -3 ≤ ga := by
    nlinarith [sq_nonneg (21 * al - 6 * be - 19 * ga), sq_nonneg (75 * be - 32 * ga)]
  interval_cases al <;> interval_cases be <;> interval_cases ga <;> omega

lemma msR_le_of_classA (hTA : TA = 5 * ZA + 12 * a) (hZA : ZA % 3 ≠ 0) (hbe : be = 5 * be' + 2 * a)
    (hga : ga = 5 * ga' + 3 * a) (h : msR TA (3 * be) (4 * ga) ≤ 700) :
    (TA = 5 ∨ TA = -5) ∧ be = 0 ∧ ga = 0 := by
  unfold msR at h
  have h1 : TA ≤ 8 := by
    nlinarith [sq_nonneg (57 * be - 12 * ga - 4 * TA), sq_nonneg (36 * ga - 7 * TA)]
  have h2 : -8 ≤ TA := by
    nlinarith [sq_nonneg (57 * be - 12 * ga - 4 * TA), sq_nonneg (36 * ga - 7 * TA)]
  have h3 : be ≤ 1 := by
    nlinarith [sq_nonneg (7 * TA - 19 * ga - 6 * be), sq_nonneg (79 * ga - 48 * be)]
  have h4 : -1 ≤ be := by
    nlinarith [sq_nonneg (7 * TA - 19 * ga - 6 * be), sq_nonneg (79 * ga - 48 * be)]
  have h5 : ga ≤ 2 := by
    nlinarith [sq_nonneg (7 * TA - 6 * be - 19 * ga), sq_nonneg (75 * be - 32 * ga)]
  have h6 : -2 ≤ ga := by
    nlinarith [sq_nonneg (7 * TA - 6 * be - 19 * ga), sq_nonneg (75 * be - 32 * ga)]
  interval_cases TA <;> interval_cases be <;> interval_cases ga <;> omega

lemma msR_le_of_classB (hal : al = 5 * al' + 4 * a) (hTB : TB = 5 * ZB + 6 * a) (hZB : ZB % 3 ≠ 0)
    (hga : ga = 5 * ga' + 3 * a) (h : msR (3 * al) TB (4 * ga) ≤ 950) :
    al = 0 ∧ (TB = 5 ∨ TB = -5) ∧ ga = 0 := by
  unfold msR at h
  have h1 : al ≤ 3 := by
    nlinarith [sq_nonneg (19 * TB - 12 * ga - 12 * al), sq_nonneg (12 * ga - 7 * al)]
  have h2 : -3 ≤ al := by
    nlinarith [sq_nonneg (19 * TB - 12 * ga - 12 * al), sq_nonneg (12 * ga - 7 * al)]
  have h3 : TB ≤ 5 := by
    nlinarith [sq_nonneg (21 * al - 19 * ga - 2 * TB), sq_nonneg (79 * ga - 16 * TB)]
  have h4 : -5 ≤ TB := by
    nlinarith [sq_nonneg (21 * al - 19 * ga - 2 * TB), sq_nonneg (79 * ga - 16 * TB)]
  have h5 : ga ≤ 2 := by
    nlinarith [sq_nonneg (21 * al - 2 * TB - 19 * ga), sq_nonneg (25 * TB - 32 * ga)]
  have h6 : -2 ≤ ga := by
    nlinarith [sq_nonneg (21 * al - 2 * TB - 19 * ga), sq_nonneg (25 * TB - 32 * ga)]
  interval_cases al <;> interval_cases TB <;> interval_cases ga <;> omega

lemma msR_le_of_classC_odd (hal : al = 5 * al' + 4 * a) (hbe : be = 5 * be' + 2 * a)
    (hTC : TC = 5 * ZC + 12 * a) (hZC : ZC % 2 = 1) (h : msR (3 * al) (3 * be) TC ≤ 675) :
    al = 0 ∧ be = 0 ∧ (TC = 5 ∨ TC = -5) := by
  unfold msR at h
  have h1 : al ≤ 2 := by
    nlinarith [sq_nonneg (19 * be - TC - 4 * al), sq_nonneg (3 * TC - 7 * al)]
  have h2 : -2 ≤ al := by
    nlinarith [sq_nonneg (19 * be - TC - 4 * al), sq_nonneg (3 * TC - 7 * al)]
  have h3 : be ≤ 1 := by
    nlinarith [sq_nonneg (84 * al - 19 * TC - 24 * be), sq_nonneg (79 * TC - 192 * be)]
  have h4 : -1 ≤ be := by
    nlinarith [sq_nonneg (84 * al - 19 * TC - 24 * be), sq_nonneg (79 * TC - 192 * be)]
  have h5 : TC ≤ 8 := by
    nlinarith [sq_nonneg (84 * al - 24 * be - 19 * TC), sq_nonneg (75 * be - 8 * TC)]
  have h6 : -8 ≤ TC := by
    nlinarith [sq_nonneg (84 * al - 24 * be - 19 * TC), sq_nonneg (75 * be - 8 * TC)]
  interval_cases al <;> interval_cases be <;> interval_cases TC <;> omega

lemma lt_msR_of_classC_two (hal : al = 5 * al' + 4 * a) (hbe : be = 5 * be' + 2 * a)
    (hTC : TC = 5 * ZC + 12 * a) (hZC : ZC % 4 = 2) : 300 < msR (3 * al) (3 * be) TC := by
  unfold msR
  by_contra! h
  have h1 : al ≤ 1 := by
    nlinarith [sq_nonneg (19 * be - TC - 4 * al), sq_nonneg (3 * TC - 7 * al)]
  have h2 : -1 ≤ al := by
    nlinarith [sq_nonneg (19 * be - TC - 4 * al), sq_nonneg (3 * TC - 7 * al)]
  have h3 : be ≤ 1 := by
    nlinarith [sq_nonneg (84 * al - 19 * TC - 24 * be), sq_nonneg (79 * TC - 192 * be)]
  have h4 : -1 ≤ be := by
    nlinarith [sq_nonneg (84 * al - 19 * TC - 24 * be), sq_nonneg (79 * TC - 192 * be)]
  have h5 : TC ≤ 5 := by
    nlinarith [sq_nonneg (84 * al - 24 * be - 19 * TC), sq_nonneg (75 * be - 8 * TC)]
  have h6 : -5 ≤ TC := by
    nlinarith [sq_nonneg (84 * al - 24 * be - 19 * TC), sq_nonneg (75 * be - 8 * TC)]
  interval_cases al <;> interval_cases be <;> interval_cases TC <;> omega

variable {u0 u1 u2 u3 s : ℤ}

lemma eq_of_sum_sq_sub_three_eq_zero (h : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 = 0) :
    u1 = u0 ∧ u2 = u0 := by
  have h1 : u0 - u1 = 0 := sq_eq_zero_iff.mp <| by
    nlinarith [sq_nonneg (u0 - u1), sq_nonneg (u0 - u2), sq_nonneg (u1 - u2)]
  have h2 : u0 - u2 = 0 := sq_eq_zero_iff.mp <| by
    nlinarith [sq_nonneg (u0 - u1), sq_nonneg (u0 - u2), sq_nonneg (u1 - u2)]
  constructor <;> linarith

variable (u0 u1 u2) in
lemma sum_sq_sub_three_eq : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 =
    2 * ((u0 - u1) ^ 2 + (u0 - u1) * (u1 - u2) + (u1 - u2) ^ 2) := by
  ring1

lemma two_le_sum_sq_sub_three (h : (u0 + u1 + u2) % 3 ≠ 0) :
    2 ≤ (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 := by
  by_contra! hlt
  have hK : (u0 - u1) ^ 2 + (u0 - u1) * (u1 - u2) + (u1 - u2) ^ 2 ≤ 0 := by
    linarith [sum_sq_sub_three_eq u0 u1 u2]
  have h12 : u1 - u2 = 0 := sq_eq_zero_iff.mp <| by
    nlinarith [sq_nonneg (2 * (u0 - u1) + (u1 - u2)), sq_nonneg (u1 - u2)]
  have h01 : u0 - u1 = 0 := sq_eq_zero_iff.mp <| by
    nlinarith [sq_nonneg (2 * (u1 - u2) + (u0 - u1)), sq_nonneg (u0 - u1)]
  omega

lemma eq_zero_or_six_le_sum_sq_sub_three (h : (u0 + u1 + u2) % 3 = 0) : (u0 - u1) ^ 2 +
    (u0 - u2) ^ 2 + (u1 - u2) ^ 2 = 0 ∨ 6 ≤ (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 := by
  rcases Int.dvd_of_emod_eq_zero h with ⟨q, hq⟩
  have hZ : (u0 + u1 + u2) ^ 2 = 9 * q ^ 2 := by
    rw [hq]
    ring1
  have hid : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 =
      3 * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2) - (u0 + u1 + u2) ^ 2 := by
    ring1
  have hev : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 =
      2 * ((u0 - u1) ^ 2 + (u0 - u1) * (u1 - u2) + (u1 - u2) ^ 2) :=
    sum_sq_sub_three_eq u0 u1 u2
  have hnn : 0 ≤ (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 := by positivity
  omega

lemma class3_of_sum_sq_eq_two (hD : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 = 2)
    (hs : s = 1 ∨ s = -1) (hS : u0 + u1 + u2 = s) :
    u0 = s ∧ u1 = 0 ∧ u2 = 0 ∨ u0 = 0 ∧ u1 = s ∧ u2 = 0 ∨ u0 = 0 ∧ u1 = 0 ∧ u2 = s := by
  have hsq : u0 ^ 2 + u1 ^ 2 + u2 ^ 2 = 1 := by
    have hs2 : s ^ 2 = 1 := by
      rcases hs with rfl | rfl <;> norm_num
    have hid : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u1 - u2) ^ 2 =
        3 * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2) - (u0 + u1 + u2) ^ 2 := by
      ring1
    rw [hS, hs2, hD] at hid
    linarith
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one u0).mp (by linarith [sq_nonneg u1, sq_nonneg u2]))
    with ⟨h0', h0⟩
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one u1).mp (by linarith [sq_nonneg u0, sq_nonneg u2]))
    with ⟨h1', h1⟩
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one u2).mp (by linarith [sq_nonneg u0, sq_nonneg u1]))
    with ⟨h2', h2⟩
  clear hD
  interval_cases u0 <;> interval_cases u1 <;> interval_cases u2 <;> omega

variable (u0 u1 u2 u3) in
lemma sum_sq_sub_four_eq : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 +
    (u1 - u3) ^ 2 + (u2 - u3) ^ 2 = 4 * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2) -
      (u0 + u1 + u2 + u3) ^ 2 := by
  ring1

lemma eq_of_sum_sq_sub_four_eq_zero (h : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 +
    (u1 - u2) ^ 2 + (u1 - u3) ^ 2 + (u2 - u3) ^ 2 = 0) : u1 = u0 ∧ u2 = u0 ∧ u3 = u0 := by
  have h1 : u0 - u1 = 0 := sq_eq_zero_iff.mp <| by
    nlinarith [sq_nonneg (u0 - u1), sq_nonneg (u0 - u2), sq_nonneg (u0 - u3),
      sq_nonneg (u1 - u2), sq_nonneg (u1 - u3), sq_nonneg (u2 - u3)]
  have h2 : u0 - u2 = 0 := sq_eq_zero_iff.mp <| by
    nlinarith [sq_nonneg (u0 - u1), sq_nonneg (u0 - u2), sq_nonneg (u0 - u3),
      sq_nonneg (u1 - u2), sq_nonneg (u1 - u3), sq_nonneg (u2 - u3)]
  have h3 : u0 - u3 = 0 := sq_eq_zero_iff.mp <| by
    nlinarith [sq_nonneg (u0 - u1), sq_nonneg (u0 - u2), sq_nonneg (u0 - u3),
      sq_nonneg (u1 - u2), sq_nonneg (u1 - u3), sq_nonneg (u2 - u3)]
  refine ⟨?_, ?_, ?_⟩ <;> linarith

lemma three_le_sum_sq_sub_four (h : (u0 + u1 + u2 + u3) % 2 = 1) : 3 ≤ (u0 - u1) ^ 2 +
    (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 + (u2 - u3) ^ 2 := by
  rcases Int.odd_iff.mpr h with ⟨q, hq⟩
  have hZ : (u0 + u1 + u2 + u3) ^ 2 = 4 * (q ^ 2 + q) + 1 := by
    rw [hq]
    ring1
  have hnn : 0 ≤ (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 +
      (u2 - u3) ^ 2 := by
    positivity
  have hid : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 +
      (u2 - u3) ^ 2 = 4 * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2) - (u0 + u1 + u2 + u3) ^ 2 :=
    sum_sq_sub_four_eq u0 u1 u2 u3
  omega

lemma four_le_sum_sq_sub_four (h : (u0 + u1 + u2 + u3) % 4 = 2) : 4 ≤ (u0 - u1) ^ 2 +
    (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 + (u2 - u3) ^ 2 := by
  rcases (⟨(u0 + u1 + u2 + u3) / 4, by omega⟩ : ∃ q, u0 + u1 + u2 + u3 = 4 * q + 2) with ⟨q, hq⟩
  have hZ : (u0 + u1 + u2 + u3) ^ 2 = 4 * (4 * q ^ 2 + 4 * q + 1) := by
    rw [hq]
    ring1
  have hnn : 0 ≤ (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 +
      (u2 - u3) ^ 2 := by
    positivity
  have hid : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 +
      (u2 - u3) ^ 2 = 4 * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2) - (u0 + u1 + u2 + u3) ^ 2 :=
    sum_sq_sub_four_eq u0 u1 u2 u3
  rcases eq_or_lt_of_le hnn with h0 | hpos
  · rcases eq_of_sum_sq_sub_four_eq_zero h0.symm with ⟨h1, h2, h3⟩
    omega
  · omega

lemma eq_zero_or_eight_le_sum_sq_sub_four (h : (u0 + u1 + u2 + u3) % 4 = 0) : (u0 - u1) ^ 2 +
    (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 + (u2 - u3) ^ 2 = 0 ∨
      8 ≤ (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 +
        (u2 - u3) ^ 2 := by
  rcases Int.dvd_of_emod_eq_zero h with ⟨q, hq⟩
  have hZ : (u0 + u1 + u2 + u3) ^ 2 = 16 * q ^ 2 := by
    rw [hq]
    ring1
  have hpar : Even (u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2 - (u0 + u1 + u2 + u3)) := by
    have hid : u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2 - (u0 + u1 + u2 + u3) =
        u0 * (u0 - 1) + u1 * (u1 - 1) + u2 * (u2 - 1) + u3 * (u3 - 1) := by
      ring1
    rw [hid]
    exact (((Int.even_mul_pred_self u0).add (Int.even_mul_pred_self u1)).add
      (Int.even_mul_pred_self u2)).add (Int.even_mul_pred_self u3)
  rcases hpar with ⟨k, hk⟩
  have hnn : 0 ≤ (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 +
      (u2 - u3) ^ 2 := by
    positivity
  have hid : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 +
      (u2 - u3) ^ 2 = 4 * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2) - (u0 + u1 + u2 + u3) ^ 2 :=
    sum_sq_sub_four_eq u0 u1 u2 u3
  omega

lemma class4_of_sum_sq_eq_three (hD : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 +
    (u1 - u2) ^ 2 + (u1 - u3) ^ 2 + (u2 - u3) ^ 2 = 3) (hs : s = 1 ∨ s = -1)
    (hS : u0 + u1 + u2 + u3 = s) : u0 = s ∧ u1 = 0 ∧ u2 = 0 ∧ u3 = 0 ∨
      u0 = 0 ∧ u1 = s ∧ u2 = 0 ∧ u3 = 0 ∨ u0 = 0 ∧ u1 = 0 ∧ u2 = s ∧ u3 = 0 ∨
        u0 = 0 ∧ u1 = 0 ∧ u2 = 0 ∧ u3 = s := by
  have hsq : u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2 = 1 := by
    have hs2 : s ^ 2 = 1 := by
      rcases hs with rfl | rfl <;> norm_num
    have hid : (u0 - u1) ^ 2 + (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 +
        (u1 - u3) ^ 2 + (u2 - u3) ^ 2 =
          4 * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2) - (u0 + u1 + u2 + u3) ^ 2 :=
      sum_sq_sub_four_eq u0 u1 u2 u3
    rw [hS, hs2, hD] at hid
    linarith
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one u0).mp
    (by linarith [sq_nonneg u1, sq_nonneg u2, sq_nonneg u3])) with ⟨h0', h0⟩
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one u1).mp
    (by linarith [sq_nonneg u0, sq_nonneg u2, sq_nonneg u3])) with ⟨h1', h1⟩
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one u2).mp
    (by linarith [sq_nonneg u0, sq_nonneg u1, sq_nonneg u3])) with ⟨h2', h2⟩
  rcases abs_le.mp ((sq_le_one_iff_abs_le_one u3).mp
    (by linarith [sq_nonneg u0, sq_nonneg u1, sq_nonneg u2])) with ⟨h3', h3⟩
  clear hD
  interval_cases u0 <;> interval_cases u1 <;> interval_cases u2 <;> interval_cases u3 <;> omega

lemma three_le_sum_sq_sub_four_of_ne (h : (u0 + u1 + u2 + u3) % 4 ≠ 0) : 3 ≤ (u0 - u1) ^ 2 +
    (u0 - u2) ^ 2 + (u0 - u3) ^ 2 + (u1 - u2) ^ 2 + (u1 - u3) ^ 2 + (u2 - u3) ^ 2 := by
  rcases (by omega : (u0 + u1 + u2 + u3) % 2 = 1 ∨ (u0 + u1 + u2 + u3) % 4 = 2) with h' | h'
  · exact three_le_sum_sq_sub_four h'
  · exact (four_le_sum_sq_sub_four h').trans' (by norm_num)

variable {z}

lemma msT_eq_of_classes_constant (hA : (z 0 + z 1 + z 2) % 3 = 0) (hB : (z 3 + z 4 + z 5) % 3 = 0)
    (hC : (z 6 + z 7 + z 8 + z 9) % 4 = 0) (h : msQuad (msT z a) ≤ 1800) :
    msT z a = 0 ∨ msT z a = msGlue ∨ msT z a = -msGlue := by
  rw [msQuad_msT] at h
  have hR : 0 ≤ msR (5 * (z 0 + z 1 + z 2) + 12 * a) (5 * (z 3 + z 4 + z 5) + 6 * a)
      (5 * (z 6 + z 7 + z 8 + z 9) + 12 * a) :=
    msR_nonneg _ _ _
  have hDA : msDA z = 0 ∨ 6 ≤ msDA z := eq_zero_or_six_le_sum_sq_sub_three hA
  have hDB : msDB z = 0 ∨ 6 ≤ msDB z := eq_zero_or_six_le_sum_sq_sub_three hB
  have hDC : msDC z = 0 ∨ 8 ≤ msDC z := eq_zero_or_eight_le_sum_sq_sub_four hC
  have hDA0 : msDA z = 0 := hDA.resolve_right fun h6 ↦ by linarith [msDB_nonneg z, msDC_nonneg z]
  have hDB0 : msDB z = 0 := hDB.resolve_right fun h6 ↦ by linarith [msDA_nonneg z, msDC_nonneg z]
  have hDC0 : msDC z = 0 := hDC.resolve_right fun h8 ↦ by linarith [msDA_nonneg z, msDB_nonneg z]
  rcases eq_of_sum_sq_sub_three_eq_zero hDA0 with ⟨h1, h2⟩
  rcases eq_of_sum_sq_sub_three_eq_zero hDB0 with ⟨h4, h5⟩
  rcases eq_of_sum_sq_sub_four_eq_zero hDC0 with ⟨h7, h8, h9⟩
  have hle :
      msR (3 * (5 * z 0 + 4 * a)) (3 * (5 * z 3 + 2 * a)) (4 * (5 * z 6 + 3 * a)) ≤ 1800 := by
    rw [show 3 * (5 * z 0 + 4 * a) = 5 * (z 0 + z 1 + z 2) + 12 * a by rw [h1, h2]; ring1,
      show 3 * (5 * z 3 + 2 * a) = 5 * (z 3 + z 4 + z 5) + 6 * a by rw [h4, h5]; ring1,
      show 4 * (5 * z 6 + 3 * a) = 5 * (z 6 + z 7 + z 8 + z 9) + 12 * a by rw [h7, h8, h9]; ring1]
    linarith
  clear h hR hDA hDB hDC hDA0 hDB0 hDC0
  rcases msR_le_of_classes_constant rfl rfl rfl hle with ⟨ha, hb, hc⟩ | ⟨ha, hb, hc⟩ |
    ⟨ha, hb, hc⟩
  · exact Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)
  · exact Or.inr (Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega))
  · exact Or.inr (Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega))

lemma msT_eq_of_classA (hA : (z 0 + z 1 + z 2) % 3 ≠ 0) (hB : (z 3 + z 4 + z 5) % 3 = 0)
    (hC : (z 6 + z 7 + z 8 + z 9) % 4 = 0) (h : msQuad (msT z a) ≤ 1800) :
    ∃ i, msT z a = Pi.single i 5 ∨ msT z a = Pi.single i (-5) := by
  rw [msQuad_msT] at h
  have hDA : 2 ≤ msDA z := two_le_sum_sq_sub_three hA
  rcases Int.dvd_of_emod_eq_zero hB with ⟨qB, hqB⟩
  rcases Int.dvd_of_emod_eq_zero hC with ⟨qC, hqC⟩
  rw [show 5 * (z 3 + z 4 + z 5) + 6 * a = 3 * (5 * qB + 2 * a) by rw [hqB]; ring1,
    show 5 * (z 6 + z 7 + z 8 + z 9) + 12 * a = 4 * (5 * qC + 3 * a) by rw [hqC]; ring1] at h
  have hle :
      msR (5 * (z 0 + z 1 + z 2) + 12 * a) (3 * (5 * qB + 2 * a)) (4 * (5 * qC + 3 * a)) ≤ 700 := by
    linarith [msDB_nonneg z, msDC_nonneg z]
  rcases msR_le_of_classA rfl hA rfl rfl hle with ⟨hTA, hbe, hga⟩
  have h700 :
      msR (5 * (z 0 + z 1 + z 2) + 12 * a) (3 * (5 * qB + 2 * a)) (4 * (5 * qC + 3 * a)) = 700 := by
    rw [hbe, hga]
    rcases hTA with hTA | hTA <;> rw [hTA] <;> norm_num [msR]
  have hDA2 : msDA z = 2 := by
    linarith [msDB_nonneg z, msDC_nonneg z]
  have hDB0 : msDB z = 0 := by
    linarith [msDB_nonneg z, msDC_nonneg z]
  have hDC0 : msDC z = 0 := by
    linarith [msDB_nonneg z, msDC_nonneg z]
  rcases eq_of_sum_sq_sub_three_eq_zero hDB0 with ⟨h4, h5⟩
  rcases eq_of_sum_sq_sub_four_eq_zero hDC0 with ⟨h7, h8, h9⟩
  have ha5 : a = 5 * (a / 5) := by
    omega
  have hD' : (z 0 + 4 * (a / 5) - (z 1 + 4 * (a / 5))) ^ 2 +
      (z 0 + 4 * (a / 5) - (z 2 + 4 * (a / 5))) ^ 2 +
      (z 1 + 4 * (a / 5) - (z 2 + 4 * (a / 5))) ^ 2 = 2 := by
    rw [← hDA2, msDA]
    ring1
  clear h h700 hle hDA hDB0 hDC0 hDA2
  rcases hTA with hTA | hTA
  · rcases class3_of_sum_sq_eq_two hD' (Or.inl rfl) (by omega) with ⟨e0, e1, e2⟩ |
      ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩
    · exact ⟨0, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨1, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨2, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
  · rcases class3_of_sum_sq_eq_two hD' (Or.inr rfl) (by omega) with ⟨e0, e1, e2⟩ |
      ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩
    · exact ⟨0, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨1, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨2, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩

lemma msT_eq_of_classB (hA : (z 0 + z 1 + z 2) % 3 = 0) (hB : (z 3 + z 4 + z 5) % 3 ≠ 0)
    (hC : (z 6 + z 7 + z 8 + z 9) % 4 = 0) (h : msQuad (msT z a) ≤ 1800) :
    ∃ i, msT z a = Pi.single i 5 ∨ msT z a = Pi.single i (-5) := by
  rw [msQuad_msT] at h
  have hDB : 2 ≤ msDB z := two_le_sum_sq_sub_three hB
  rcases Int.dvd_of_emod_eq_zero hA with ⟨qA, hqA⟩
  rcases Int.dvd_of_emod_eq_zero hC with ⟨qC, hqC⟩
  rw [show 5 * (z 0 + z 1 + z 2) + 12 * a = 3 * (5 * qA + 4 * a) by rw [hqA]; ring1,
    show 5 * (z 6 + z 7 + z 8 + z 9) + 12 * a = 4 * (5 * qC + 3 * a) by rw [hqC]; ring1] at h
  have hle :
      msR (3 * (5 * qA + 4 * a)) (5 * (z 3 + z 4 + z 5) + 6 * a) (4 * (5 * qC + 3 * a)) ≤ 950 := by
    linarith [msDA_nonneg z, msDC_nonneg z]
  rcases msR_le_of_classB rfl rfl hB rfl hle with ⟨hal, hTB, hga⟩
  have h950 :
      msR (3 * (5 * qA + 4 * a)) (5 * (z 3 + z 4 + z 5) + 6 * a) (4 * (5 * qC + 3 * a)) = 950 := by
    rw [hal, hga]
    rcases hTB with hTB | hTB <;> rw [hTB] <;> norm_num [msR]
  have hDA0 : msDA z = 0 := by
    linarith [msDA_nonneg z, msDC_nonneg z]
  have hDB2 : msDB z = 2 := by
    linarith [msDA_nonneg z, msDC_nonneg z]
  have hDC0 : msDC z = 0 := by
    linarith [msDA_nonneg z, msDC_nonneg z]
  rcases eq_of_sum_sq_sub_three_eq_zero hDA0 with ⟨h1, h2⟩
  rcases eq_of_sum_sq_sub_four_eq_zero hDC0 with ⟨h7, h8, h9⟩
  have ha5 : a = 5 * (a / 5) := by
    omega
  have hD' : (z 3 + 2 * (a / 5) - (z 4 + 2 * (a / 5))) ^ 2 +
      (z 3 + 2 * (a / 5) - (z 5 + 2 * (a / 5))) ^ 2 +
      (z 4 + 2 * (a / 5) - (z 5 + 2 * (a / 5))) ^ 2 = 2 := by
    rw [← hDB2, msDB]
    ring1
  clear h h950 hle hDB hDA0 hDB2 hDC0
  rcases hTB with hTB | hTB
  · rcases class3_of_sum_sq_eq_two hD' (Or.inl rfl) (by omega) with ⟨e3, e4, e5⟩ |
      ⟨e3, e4, e5⟩ | ⟨e3, e4, e5⟩
    · exact ⟨3, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨4, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨5, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
  · rcases class3_of_sum_sq_eq_two hD' (Or.inr rfl) (by omega) with ⟨e3, e4, e5⟩ |
      ⟨e3, e4, e5⟩ | ⟨e3, e4, e5⟩
    · exact ⟨3, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨4, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨5, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩

lemma msT_eq_of_classC (hA : (z 0 + z 1 + z 2) % 3 = 0) (hB : (z 3 + z 4 + z 5) % 3 = 0)
    (hC : (z 6 + z 7 + z 8 + z 9) % 2 = 1) (h : msQuad (msT z a) ≤ 1800) :
    ∃ i, msT z a = Pi.single i 5 ∨ msT z a = Pi.single i (-5) := by
  rw [msQuad_msT] at h
  have hDC : 3 ≤ msDC z := three_le_sum_sq_sub_four hC
  rcases Int.dvd_of_emod_eq_zero hA with ⟨qA, hqA⟩
  rcases Int.dvd_of_emod_eq_zero hB with ⟨qB, hqB⟩
  rw [show 5 * (z 0 + z 1 + z 2) + 12 * a = 3 * (5 * qA + 4 * a) by rw [hqA]; ring1,
    show 5 * (z 3 + z 4 + z 5) + 6 * a = 3 * (5 * qB + 2 * a) by rw [hqB]; ring1] at h
  have hle : msR (3 * (5 * qA + 4 * a)) (3 * (5 * qB + 2 * a))
      (5 * (z 6 + z 7 + z 8 + z 9) + 12 * a) ≤ 675 := by
    linarith [msDA_nonneg z, msDB_nonneg z]
  rcases msR_le_of_classC_odd rfl rfl rfl hC hle with ⟨hal, hbe, hTC⟩
  have h675 : msR (3 * (5 * qA + 4 * a)) (3 * (5 * qB + 2 * a))
      (5 * (z 6 + z 7 + z 8 + z 9) + 12 * a) = 675 := by
    rw [hal, hbe]
    rcases hTC with hTC | hTC <;> rw [hTC] <;> norm_num [msR]
  have hDA0 : msDA z = 0 := by
    linarith [msDA_nonneg z, msDB_nonneg z]
  have hDB0 : msDB z = 0 := by
    linarith [msDA_nonneg z, msDB_nonneg z]
  have hDC3 : msDC z = 3 := by
    linarith [msDA_nonneg z, msDB_nonneg z]
  rcases eq_of_sum_sq_sub_three_eq_zero hDA0 with ⟨h1, h2⟩
  rcases eq_of_sum_sq_sub_three_eq_zero hDB0 with ⟨h4, h5⟩
  have ha5 : a = 5 * (a / 5) := by
    omega
  have hD' : (z 6 + 3 * (a / 5) - (z 7 + 3 * (a / 5))) ^ 2 +
      (z 6 + 3 * (a / 5) - (z 8 + 3 * (a / 5))) ^ 2 +
      (z 6 + 3 * (a / 5) - (z 9 + 3 * (a / 5))) ^ 2 +
      (z 7 + 3 * (a / 5) - (z 8 + 3 * (a / 5))) ^ 2 +
      (z 7 + 3 * (a / 5) - (z 9 + 3 * (a / 5))) ^ 2 +
      (z 8 + 3 * (a / 5) - (z 9 + 3 * (a / 5))) ^ 2 = 3 := by
    rw [← hDC3, msDC]
    ring1
  clear h h675 hle hDC hDA0 hDB0 hDC3
  rcases hTC with hTC | hTC
  · rcases class4_of_sum_sq_eq_three hD' (Or.inl rfl) (by omega) with ⟨e6, e7, e8, e9⟩ |
      ⟨e6, e7, e8, e9⟩ | ⟨e6, e7, e8, e9⟩ | ⟨e6, e7, e8, e9⟩
    · exact ⟨6, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨7, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨8, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨9, Or.inl (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
  · rcases class4_of_sum_sq_eq_three hD' (Or.inr rfl) (by omega) with ⟨e6, e7, e8, e9⟩ |
      ⟨e6, e7, e8, e9⟩ | ⟨e6, e7, e8, e9⟩ | ⟨e6, e7, e8, e9⟩
    · exact ⟨6, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨7, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨8, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩
    · exact ⟨9, Or.inr (funext fun i ↦ by fin_cases i <;> simp [msT, msGlue] <;> omega)⟩

lemma lt_msQuad_of_classC_two (hA : (z 0 + z 1 + z 2) % 3 = 0) (hB : (z 3 + z 4 + z 5) % 3 = 0)
    (hC : (z 6 + z 7 + z 8 + z 9) % 4 = 2) : 1800 < msQuad (msT z a) := by
  rw [msQuad_msT]
  have hDC : 4 ≤ msDC z := four_le_sum_sq_sub_four hC
  rcases Int.dvd_of_emod_eq_zero hA with ⟨qA, hqA⟩
  rcases Int.dvd_of_emod_eq_zero hB with ⟨qB, hqB⟩
  have hlt : 300 < msR (5 * (z 0 + z 1 + z 2) + 12 * a) (5 * (z 3 + z 4 + z 5) + 6 * a)
      (5 * (z 6 + z 7 + z 8 + z 9) + 12 * a) := by
    rw [hqA, hqB, show 5 * (3 * qA) + 12 * a = 3 * (5 * qA + 4 * a) by ring1,
      show 5 * (3 * qB) + 6 * a = 3 * (5 * qB + 2 * a) by ring1]
    exact lt_msR_of_classC_two rfl rfl rfl hC
  linarith [msDA_nonneg z, msDB_nonneg z]

lemma lt_msQuad_of_classA_classB (hA : (z 0 + z 1 + z 2) % 3 ≠ 0) (hB : (z 3 + z 4 + z 5) % 3 ≠ 0) :
    1800 < msQuad (msT z a) := by
