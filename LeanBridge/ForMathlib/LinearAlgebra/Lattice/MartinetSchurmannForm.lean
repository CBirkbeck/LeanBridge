lemma lt_msQuad_of_classB_classC (hB : (z 3 + z 4 + z 5) % 3 ≠ 0)
    (hC : (z 6 + z 7 + z 8 + z 9) % 4 ≠ 0) : 1800 < msQuad (msT z a) := by
  rw [msQuad_msT]
  have hDB : 2 ≤ msDB z := two_le_sum_sq_sub_three hB
  have hDC : 3 ≤ msDC z := three_le_sum_sq_sub_four_of_ne hC
  linarith [msDA_nonneg z, msR_nonneg (5 * (z 0 + z 1 + z 2) + 12 * a)
    (5 * (z 3 + z 4 + z 5) + 6 * a) (5 * (z 6 + z 7 + z 8 + z 9) + 12 * a)]

variable (z a) in
/-- **The minimal vectors of Martinet and Schürmann's form**: if `t = 5 z + a c` has
`tᵀ G t ≤ 1800`, then `t = 0`, `t = ±c` or `t = ±5 eᵢ`. -/
lemma msT_eq_of_msQuad_le (h : msQuad (msT z a) ≤ 1800) : msT z a = 0 ∨ msT z a = msGlue ∨
    msT z a = -msGlue ∨ ∃ i, msT z a = Pi.single i 5 ∨ msT z a = Pi.single i (-5) := by
  by_cases hA : (z 0 + z 1 + z 2) % 3 = 0 <;> by_cases hB : (z 3 + z 4 + z 5) % 3 = 0
  · rcases (by omega : (z 6 + z 7 + z 8 + z 9) % 4 = 0 ∨ (z 6 + z 7 + z 8 + z 9) % 2 = 1 ∨
      (z 6 + z 7 + z 8 + z 9) % 4 = 2) with hC | hC | hC
    · rcases msT_eq_of_classes_constant hA hB hC h with h' | h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr (Or.inl h'))
    · exact Or.inr (Or.inr (Or.inr (msT_eq_of_classC hA hB hC h)))
    · exact absurd h (lt_msQuad_of_classC_two hA hB hC).not_ge
  · by_cases hC : (z 6 + z 7 + z 8 + z 9) % 4 = 0
    · exact Or.inr (Or.inr (Or.inr (msT_eq_of_classB hA hB hC h)))
    · exact absurd h (lt_msQuad_of_classB_classC hB hC).not_ge
  · by_cases hC : (z 6 + z 7 + z 8 + z 9) % 4 = 0
    · exact Or.inr (Or.inr (Or.inr (msT_eq_of_classA hA hB hC h)))
    · exact absurd h (lt_msQuad_of_classA_classC hA hC).not_ge
  · exact absurd h (lt_msQuad_of_classA_classB hA hB).not_ge

end TauCeti.IntegralLattice
