import LeanBridge.ForMathlib.LinearAlgebra.Lattice.RootSublattice
import Mathlib.LinearAlgebra.FreeModule.Finite.Quotient

/-!
# Well-rounded lattices

Let `L` be a positive definite integral lattice, `S(L)` its set of minimal vectors (LMFDB
`lattice.minimal_vector`), the nonzero vectors whose norm is the minimum of `L`, and `M` the
sublattice they span, the min vector sublattice of LMFDB `lattice.sublattice`. Following LMFDB
`lattice.well_rounded`, `L` is well-rounded if `M` has finite index in `L`, that is if `S(L)` spans
the space of `L` (`isWellRounded_iff_finrank_eq`); `L` is generated by minimal vectors if `M = L`;
and `L` is strongly well-rounded if `S(L)` contains a basis of `L`. Each condition implies the
previous one. The knowl adds that the converse implications fail from rank `5` and `10` on
respectively; this is not formalised.

The minimum is Tau Ceti's `TauCeti.IntegralLattice.minimum`, defined for every integral lattice,
so these predicates are defined for every integral lattice too, but they are only meaningful for
positive definite ones.

## Main definitions

* `TauCeti.IntegralLattice.IsWellRounded` (LMFDB `lattice.well_rounded`).
* `TauCeti.IntegralLattice.IsGeneratedByMinimalVectors` (LMFDB `lattice.well_rounded`).
* `TauCeti.IntegralLattice.IsStronglyWellRounded` (LMFDB `lattice.well_rounded`).

## Main results

* `TauCeti.IntegralLattice.isWellRounded_iff_finrank_eq`: a lattice is well-rounded exactly when its
  minimal vectors span a sublattice of full rank.
* `TauCeti.IntegralLattice.IsStronglyWellRounded.isGeneratedByMinimalVectors` and
  `TauCeti.IntegralLattice.IsGeneratedByMinimalVectors.isWellRounded`: a strongly well-rounded
  lattice is generated by its minimal vectors, and such a lattice is well-rounded.
* `TauCeti.IntegralLattice.isStronglyWellRounded_typeARootLattice`: the lattice `Aₙ` is strongly
  well-rounded.
-/

open Module

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V] (L : IntegralLattice V)

/-- A positive definite integral lattice `L` is **well-rounded** (LMFDB `lattice.well_rounded`) if
its minimal vectors span a sublattice of finite index in `L`. -/
def IsWellRounded : Prop :=
  Finite (L ⧸ L.minimalVectorSubmodule)

/-- A positive definite integral lattice `L` is **generated by minimal vectors** (LMFDB
`lattice.well_rounded`) if its minimal vectors span `L`. -/
def IsGeneratedByMinimalVectors : Prop :=
  L.minimalVectorSubmodule = ⊤

/-- A positive definite integral lattice `L` is **strongly well-rounded** (LMFDB
`lattice.well_rounded`) if its set of minimal vectors contains a `ℤ`-basis of `L`. -/
def IsStronglyWellRounded : Prop :=
  ∃ b : Basis (Fin (finrank ℤ L)) ℤ L, ∀ i, b i ∈ L.minimalVectors

/-- **A lattice is well-rounded exactly when its minimal vectors span a sublattice of full
rank.** -/
lemma isWellRounded_iff_finrank_eq :
    L.IsWellRounded ↔ finrank ℤ L.minimalVectorSubmodule = finrank ℤ L :=
  Submodule.finiteQuotient_iff _

variable {L}

/-- **A strongly well-rounded lattice is generated by its minimal vectors.** -/
lemma IsStronglyWellRounded.isGeneratedByMinimalVectors (hL : L.IsStronglyWellRounded) :
    L.IsGeneratedByMinimalVectors :=
  hL.elim fun b hb ↦ eq_top_iff.mpr <| b.span_eq ▸ Submodule.span_mono (Set.range_subset_iff.mpr hb)

/-- **A lattice generated by its minimal vectors is well-rounded.** -/
lemma IsGeneratedByMinimalVectors.isWellRounded (hL : L.IsGeneratedByMinimalVectors) :
    L.IsWellRounded := by
  rw [IsWellRounded, hL]
  infer_instance

/-- **The lattice `Aₙ` is strongly well-rounded**: its simple roots, of norm `2`, are minimal
vectors and form a basis. -/
lemma isStronglyWellRounded_typeARootLattice (n : ℕ) :
    (typeARootLattice n).IsStronglyWellRounded := by
  have hrank : finrank ℤ (typeARootLattice n) = n := by
    rw [finrank_carrier, finrank_fin_fun]
  refine ⟨(typeASimpleRootBasis n).reindex (finCongr hrank.symm), fun i ↦ ?_⟩
  have h2 : (typeARootLattice n).integralNorm
      (typeASimpleRootBasis n ((finCongr hrank.symm).symm i)) = 2 :=
    integralNorm_typeASimpleRootBasis n _
  rw [Basis.reindex_apply, mem_minimalVectors_iff,
    (isPosDef_typeARootLattice n).minimum_eq_two (isEven_typeARootLattice n) h2]
  exact ⟨h2, (typeASimpleRootBasis n).ne_zero _⟩

end TauCeti.IntegralLattice
