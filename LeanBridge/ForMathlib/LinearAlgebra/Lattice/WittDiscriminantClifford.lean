import TauCeti.LinearAlgebra.CliffordAlgebra.Dimension
import TauCeti.RingTheory.Etale.AdjoinRoot
import LeanBridge.ForMathlib.LinearAlgebra.CliffordAlgebra.CenterDiscriminant
import LeanBridge.ForMathlib.LinearAlgebra.Lattice.DiscriminantConventions

/-!
# The Witt discriminant and the centre of the Clifford algebra

LMFDB `lattice.discriminant` motivates the sign of the Witt discriminant `δ = (-1) ^ (n choose 2) D`
of an integral lattice `L` of rank `n` and discriminant `D` by the Clifford algebra: the centre of
the even Clifford algebra of `L` is the quadratic étale algebra generated by a square root of `δ`.
For a nondegenerate lattice this holds in positive even rank. In odd rank the even Clifford
algebra is central (Tau Ceti's `TauCeti.CliffordAlgebra.isCentral_even_of_odd_finrank`), and it is
the centre of the full Clifford algebra that is generated by a square root of `δ`; in rank `0` the
claim fails. These two statements and the failure in rank `0` are proved here, for the Clifford
algebra of the rational quadratic space `L ⊗ ℚ` with the LMFDB's quadratic form `Q(v) = ⟨v, v⟩`
(LMFDB `lattice.quadratic_form`). This is Tau Ceti's `TauCeti.IntegralLattice.norm` on the ambient
space of `L`, which is `L ⊗ ℚ` by Tau Ceti's `TauCeti.IntegralLattice.rationalizationIsometry`.

The Gram determinant of `Q` in a basis of `L` is `D`, so the signed discriminant of `Q` is `δ`, and
the results of `LeanBridge.ForMathlib.LinearAlgebra.CliffordAlgebra.CenterDiscriminant` apply. The
algebra `ℚ[X] ⧸ (X² - δ)` has dimension `2` (`AdjoinRoot.finrank_X_pow_sub_C`) and is étale over
`ℚ`, since `δ ≠ 0`. Halving `Q`, as the authors who take `Q(v) = ⟨v, v⟩ / 2` do, multiplies the
Gram determinant by `2⁻ⁿ`, which gives the knowl's quadratic discriminant `2⁻ⁿ D`.

## Main results

* `TauCeti.IntegralLattice.nonempty_center_even_algEquiv_adjoinRoot` (LMFDB
  `lattice.discriminant`): for a nondegenerate lattice of positive even rank, the centre of the
  even Clifford algebra of `L ⊗ ℚ` is `ℚ[X] ⧸ (X² - δ)`.
* `TauCeti.IntegralLattice.nonempty_center_algEquiv_adjoinRoot` (LMFDB `lattice.discriminant`): for
  a nondegenerate lattice of odd rank, the centre of the Clifford algebra of `L ⊗ ℚ` is
  `ℚ[X] ⧸ (X² - δ)`.
* `TauCeti.IntegralLattice.etale_adjoinRoot_wittDiscriminant` (LMFDB `lattice.discriminant`): for a
  nondegenerate lattice, `ℚ[X] ⧸ (X² - δ)` is an étale `ℚ`-algebra.
* `TauCeti.IntegralLattice.not_nonempty_center_even_algEquiv_adjoinRoot`: in rank `0` the centre of
  the even Clifford algebra is not `ℚ[X] ⧸ (X² - δ)`.
* `TauCeti.IntegralLattice.discr_inv_two_smul_norm_rationalBasis` (LMFDB `lattice.discriminant`):
  the Gram determinant of `Q / 2` in a basis of `L` is the quadratic discriminant `2⁻ⁿ D`.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields* (2005), Chapter V, §2.
* J. Milnor and D. Husemoller, *Symmetric Bilinear Forms* (1973).
-/

open Module Polynomial

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V] (L : IntegralLattice V)

/-- **The quadratic discriminant is the Gram determinant of the halved form** (LMFDB
`lattice.discriminant`): scaling the quadratic form `Q(v) = ⟨v, v⟩` of `L` by `1 / 2` multiplies its
Gram determinant in a basis of `L` by `2⁻ⁿ`, which turns `D` into the quadratic discriminant
`2⁻ⁿ D`. -/
lemma discr_inv_two_smul_norm_rationalBasis :
    ((2⁻¹ : ℚ) • L.norm).discr L.rationalBasis = L.quadraticDiscriminant := by
  rw [QuadraticForm.discr_smul, discr_norm_rationalBasis, ← finrank_eq_card_basis L.rationalBasis,
    quadraticDiscriminant, inv_pow, div_eq_inv_mul]

/-- **In rank `0` the centre of the even Clifford algebra is not `ℚ[X] ⧸ (X² - δ)`**: there the
even Clifford algebra is `ℚ`, of dimension `1`, while `ℚ[X] ⧸ (X² - δ)` has dimension `2`. So the
Clifford sentence of LMFDB `lattice.discriminant` needs positive rank. -/
lemma not_nonempty_center_even_algEquiv_adjoinRoot (h0 : finrank ℚ V = 0) : ¬Nonempty
    (Subalgebra.center ℚ (CliffordAlgebra.even L.norm) ≃ₐ[ℚ]
      AdjoinRoot (X ^ 2 - C (L.wittDiscriminant : ℚ))) := by
  rintro ⟨e⟩
  have : FiniteDimensional ℚ V := L.finiteDimensional
  have hC : finrank ℚ (CliffordAlgebra L.norm) = 1 := by
    rw [CliffordAlgebra.finrank_eq_two_pow, h0, pow_zero]
  have : FiniteDimensional ℚ (CliffordAlgebra L.norm) := .of_finrank_pos <| hC ▸ one_pos
  have hle : finrank ℚ (Subalgebra.center ℚ (CliffordAlgebra.even L.norm)) ≤
      finrank ℚ (CliffordAlgebra L.norm) :=
    LinearMap.finrank_le_finrank_of_injective
      (f := ((CliffordAlgebra.even L.norm).val.comp (Subalgebra.center ℚ _).val).toLinearMap)
      (Subtype.val_injective.comp Subtype.val_injective)
  rw [hC, e.toLinearEquiv.finrank_eq, AdjoinRoot.finrank_X_pow_sub_C] at hle
  omega

variable [L.IsNondegenerate]

/-- **The centre of the even Clifford algebra is generated by a square root of the Witt
discriminant** (LMFDB `lattice.discriminant`): for a nondegenerate integral lattice `L` of positive
even rank and Witt discriminant `δ`, the centre of the even Clifford algebra of `L ⊗ ℚ`, with the
quadratic form `Q(v) = ⟨v, v⟩`, is isomorphic to `ℚ[X] ⧸ (X² - δ)`. -/
lemma nonempty_center_even_algEquiv_adjoinRoot (heven : Even (finrank ℚ V))
    (hpos : 0 < finrank ℚ V) : Nonempty (Subalgebra.center ℚ (CliffordAlgebra.even L.norm) ≃ₐ[ℚ]
      AdjoinRoot (X ^ 2 - C (L.wittDiscriminant : ℚ))) := by
  rw [intCast_wittDiscriminant]
  exact CliffordAlgebra.nonempty_center_even_algEquiv_adjoinRoot L.rationalBasis
    L.nondegenerate_norm heven hpos

/-- **In odd rank, the centre of the Clifford algebra is generated by a square root of the Witt
discriminant** (LMFDB `lattice.discriminant`): for a nondegenerate integral lattice `L` of odd rank
and Witt discriminant `δ`, the centre of the Clifford algebra of `L ⊗ ℚ`, with the quadratic form
`Q(v) = ⟨v, v⟩`, is isomorphic to `ℚ[X] ⧸ (X² - δ)`. -/
lemma nonempty_center_algEquiv_adjoinRoot (hodd : Odd (finrank ℚ V)) : Nonempty
    (Subalgebra.center ℚ (CliffordAlgebra L.norm) ≃ₐ[ℚ]
      AdjoinRoot (X ^ 2 - C (L.wittDiscriminant : ℚ))) := by
  rw [intCast_wittDiscriminant]
  exact CliffordAlgebra.nonempty_center_algEquiv_adjoinRoot L.rationalBasis L.nondegenerate_norm
    hodd

/-- **The quadratic algebra of the Witt discriminant is étale** (LMFDB `lattice.discriminant`): for
a nondegenerate integral lattice of Witt discriminant `δ`, the algebra `ℚ[X] ⧸ (X² - δ)` generated
by a square root of `δ` is étale over `ℚ`, since `δ ≠ 0`. -/
lemma etale_adjoinRoot_wittDiscriminant :
    Algebra.Etale ℚ (AdjoinRoot (X ^ 2 - C (L.wittDiscriminant : ℚ))) := by
  have : Algebra.IsStandardEtale ℚ (AdjoinRoot (X ^ 2 - C (L.wittDiscriminant : ℚ))) :=
    (monic_X_pow_sub_C _ two_ne_zero).isStandardEtale_adjoinRoot <|
      separable_X_pow_sub_C _ two_ne_zero <| Int.cast_ne_zero.mpr L.wittDiscriminant_ne_zero
  infer_instance

end TauCeti.IntegralLattice
