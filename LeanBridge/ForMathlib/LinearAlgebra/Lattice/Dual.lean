import TauCeti.LinearAlgebra.IntegralLattice.Ideals
import TauCeti.LinearAlgebra.IntegralLattice.Level

/-!
# The rescaled dual of an integral lattice

The dual (LMFDB `lattice.dual`) of an integral lattice `L` with bilinear form `B` is
`L^# = {v ∈ ℚL : B(v, L) ⊆ ℤ}`, Tau Ceti's `TauCeti.IntegralLattice.dualCarrier`. For a
nondegenerate lattice it is a lattice, on which `B` need not be integral. The LMFDB calls rescaled
dual of `L` the integral lattice obtained from `L^#` by the unique rescaling of `B` for which it is
a primitive integral lattice, that is one whose scale ideal, generated by the values of its
bilinear form, is `ℤ` (LMFDB `lattice.primitive`).

That rescaling is `n • B`, with `n` the least positive integer for which `n • B` is integral on
`L^#`: when `L` is nonzero, `B(L^#, L) = ℤ` forces `B(L^#, L^#) = n⁻¹ℤ`. It is the unique positive
rescaling making `L^#` a primitive integral lattice; `-n • B` is the only other one, and the
positive one, which keeps the signature of `L`, is the one formalised.

## Main definitions

* `TauCeti.IntegralLattice.dualScale`: the least positive integer `n` for which `n • B` is integral
  on the dual.
* `TauCeti.IntegralLattice.rescaledDual` (LMFDB `lattice.dual`).

## Main results

* `TauCeti.IntegralLattice.dualScale_dvd_iff`: `N • B` is integral on the dual exactly when the
  dual scale divides `N`.
* `TauCeti.IntegralLattice.scaleIdeal_rescaledDual`: the rescaled dual of a nonzero lattice is
  primitive.
* `TauCeti.IntegralLattice.eq_rescaledDual`: it is the only primitive integral lattice obtained
  from the dual by a positive rescaling of the form.
-/

open Module
open LinearMap (BilinForm)
open Submodule (IsPrincipal)

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V] (L : IntegralLattice V)

/-- The ideal of the integers `N` for which `N • B` is integral on the dual lattice. -/
def dualIntegralityIdeal : Ideal ℤ where
  carrier :=
    {N | ∀ x ∈ L.dualCarrier, ∀ y ∈ L.dualCarrier, (N : ℚ) * L.form x y ∈ (1 : Submodule ℤ ℚ)}
  zero_mem' _ _ _ _ := by
    rw [Int.cast_zero, zero_mul]
    exact zero_mem _
  add_mem' ha hb x hx y hy := by
    rw [Int.cast_add, add_mul]
    exact add_mem (ha x hx y hy) (hb x hx y hy)
  smul_mem' c N hN x hx y hy := by
    rw [smul_eq_mul, Int.cast_mul, mul_assoc]
    exact Submodule.smul_mem _ c (hN x hx y hy)

/-- The **dual scale** of an integral lattice `L` with bilinear form `B`: the nonnegative generator
`n` of the ideal of the integers `N` for which `N • B` is integral on the dual `L^#`. It is positive
when `L` is nondegenerate (`dualScale_pos`), and then the least positive such integer. -/
noncomputable def dualScale : ℕ :=
  (IsPrincipal.generator L.dualIntegralityIdeal).natAbs

/-- **`N • B` is integral on the dual lattice exactly when the dual scale divides `N`.** -/
lemma dualScale_dvd_iff (N : ℤ) : (L.dualScale : ℤ) ∣ N ↔
    ∀ x ∈ L.dualCarrier, ∀ y ∈ L.dualCarrier, (N : ℚ) * L.form x y ∈ (1 : Submodule ℤ ℚ) := by
  rw [dualScale, Int.natAbs_dvd, ← IsPrincipal.mem_iff_generator_dvd]
  rfl

variable [L.IsNondegenerate]

lemma dualScale_pos : 0 < L.dualScale := by
  refine Nat.pos_of_ne_zero fun h ↦ L.level_pos.ne' ?_
  have hdvd : (L.dualScale : ℤ) ∣ L.level :=
    (L.dualScale_dvd_iff _).mpr fun x hx y hy ↦ mul_form_mem_one_of_level_dvd dvd_rfl hx hy
  rw [h, Nat.cast_zero, zero_dvd_iff, Nat.cast_eq_zero] at hdvd
  exact hdvd

/-- The **rescaled dual** (LMFDB `lattice.dual`) of a nondegenerate integral lattice `L` with
bilinear form `B`: the dual `L^#` with the form `n • B`, where `n` is the dual scale, the least
positive integer for which `n • B` is integral on `L^#`. When `L` is nonzero this is the unique
positive rescaling of `B` for which `L^#` is a primitive integral lattice
(`scaleIdeal_rescaledDual`, `eq_rescaledDual`). -/
noncomputable def rescaledDual : IntegralLattice V where
  carrier := L.dualCarrier
  form := (L.dualScale : ℚ) • L.form
  isLattice := inferInstance
  isSymm := L.isSymm.smul _
  le_dual x hx := (BilinForm.mem_dualSubmodule _).mpr fun y hy ↦ by
    rw [LinearMap.smul_apply, LinearMap.smul_apply, smul_eq_mul]
    exact_mod_cast (L.dualScale_dvd_iff L.dualScale).mp dvd_rfl x hx y hy

lemma rescaledDual_carrier : L.rescaledDual.carrier = L.dualCarrier :=
  rfl

lemma rescaledDual_form : L.rescaledDual.form = (L.dualScale : ℚ) • L.form :=
  rfl

lemma integralForm_rescaledDual_cast (x y : L.rescaledDual) :
    (L.rescaledDual.integralForm x y : ℚ) = L.dualScale * L.form x y := by
  rw [integralForm_cast, rescaledDual_form, LinearMap.smul_apply, LinearMap.smul_apply,
    smul_eq_mul]

variable [Nontrivial L]

lemma exists_form_eq_one : ∃ x ∈ L.dualCarrier, ∃ y ∈ L.carrier, L.form x y = 1 := by
  let b : Basis (Free.ChooseBasisIndex ℤ L) ℤ L := Free.chooseBasis ℤ L
  rcases b.index_nonempty with ⟨i⟩
  refine ⟨_, (L.dualPairingEquiv.symm (b.coord i)).2, _, (b i).2, ?_⟩
  rw [← dualPairingEquiv_cast, LinearEquiv.apply_symm_apply, Basis.coord_apply, Basis.repr_self,
    Finsupp.single_eq_same, Int.cast_one]

lemma isUnit_of_forall_dvd_integralForm_rescaledDual {d : ℤ}
    (hd : ∀ x y : L.rescaledDual, d ∣ L.rescaledDual.integralForm x y) : IsUnit d := by
  have hdk (x y : L.rescaledDual) : ∃ k : ℤ, (d : ℚ) * k = L.dualScale * L.form x y :=
    (hd x y).elim fun k hk ↦ ⟨k, by exact_mod_cast hk ▸ L.integralForm_rescaledDual_cast x y⟩
  rcases L.exists_form_eq_one with ⟨x₀, hx₀, y₀, hy₀, h₀⟩
  rcases hdk ⟨x₀, hx₀⟩ ⟨y₀, L.le_dualCarrier hy₀⟩ with ⟨m, hm⟩
  rw [h₀, mul_one] at hm
  have hd0 : (d : ℚ) ≠ 0 := left_ne_zero_of_mul <| hm ▸ Nat.cast_ne_zero.mpr L.dualScale_pos.ne'
  have hdvd : (L.dualScale : ℤ) ∣ m := (L.dualScale_dvd_iff m).mpr fun x hx y hy ↦ by
    rcases hdk ⟨x, hx⟩ ⟨y, hy⟩ with ⟨k, hk⟩
    refine Submodule.mem_one.mpr ⟨k, mul_left_cancel₀ hd0 ?_⟩
    rw [eq_intCast]
    linear_combination hk - L.form x y * hm
  rcases hdvd with ⟨t, rfl⟩
  refine IsUnit.of_mul_eq_one t <| mul_left_cancel₀ (Int.natCast_ne_zero.mpr L.dualScale_pos.ne') ?_
  have hm' : d * (L.dualScale * t) = L.dualScale := by exact_mod_cast hm
  linear_combination hm'

/-- **The rescaled dual of a nonzero nondegenerate lattice is primitive**: its scale ideal is
`ℤ`. -/
lemma scaleIdeal_rescaledDual : L.rescaledDual.scaleIdeal = ⊤ := by
  rw [← Ideal.span_singleton_generator L.rescaledDual.scaleIdeal, Ideal.span_singleton_eq_top]
  exact L.isUnit_of_forall_dvd_integralForm_rescaledDual fun x y ↦
    (IsPrincipal.mem_iff_generator_dvd _).mp (L.rescaledDual.integralForm.apply_mem_scaleIdeal x y)

/-- **The rescaled dual is the only primitive integral lattice obtained from the dual by a
positive rescaling of the form.** -/
lemma eq_rescaledDual {M : IntegralLattice V} (hcarrier : M.carrier = L.dualCarrier) {c : ℚ}
    (hc : 0 < c) (hform : M.form = c • L.form) (hM : M.scaleIdeal = ⊤) : M = L.rescaledDual := by
  have hMform (x y : V) : M.form x y = c * L.form x y := by
    rw [hform, LinearMap.smul_apply, LinearMap.smul_apply, smul_eq_mul]
  rcases L.exists_form_eq_one with ⟨x₀, hx₀, y₀, hy₀, h₀⟩
  rcases Submodule.mem_one.mp (M.form_mem_one ⟨x₀, hcarrier.ge hx₀⟩
    ⟨y₀, hcarrier.ge (L.le_dualCarrier hy₀)⟩) with ⟨k, hk⟩
  rw [eq_intCast, Submodule.coe_mk, Submodule.coe_mk, hMform, h₀, mul_one] at hk
  rcases (L.dualScale_dvd_iff k).mpr fun x hx y hy ↦
    hk ▸ hMform x y ▸ M.form_mem_one ⟨x, hcarrier.ge hx⟩ ⟨y, hcarrier.ge hy⟩ with ⟨t, ht⟩
  have hle : M.scaleIdeal ≤ Ideal.span {t} := (M.integralForm.scaleIdeal_le_iff _).mpr fun x y ↦
    Ideal.mem_span_singleton.mpr ⟨L.rescaledDual.integralForm ⟨x, hcarrier.le x.2⟩
      ⟨y, hcarrier.le y.2⟩, Int.cast_injective (α := ℚ) <| by
        rw [integralForm_cast, Int.cast_mul, integralForm_rescaledDual_cast, hMform, ← hk, ht]
        push_cast
        ring1⟩
  rw [hM, top_le_iff, Ideal.span_singleton_eq_top, Int.isUnit_iff] at hle
  rcases hle with rfl | rfl
  · refine IntegralLattice.ext hcarrier (hform.trans ?_)
    rw [rescaledDual_form, ← hk, ht, mul_one, Int.cast_natCast]
  · rw [ht, mul_neg_one, Int.cast_neg, Int.cast_natCast] at hk
    exact absurd (hk ▸ hc) (neg_nonpos.mpr (Nat.cast_nonneg _)).not_gt

end TauCeti.IntegralLattice
