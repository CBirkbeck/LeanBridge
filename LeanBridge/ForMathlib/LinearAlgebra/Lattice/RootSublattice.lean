import LeanBridge.ForMathlib.LinearAlgebra.Lattice.Sublattice
import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.Basic

/-!
# The root sublattice of an integral lattice

The root sublattice (LMFDB `lattice.root_sublattice`) of a positive definite integral lattice `L` is
the sublattice of `L` spanned by its vectors of norm at most `2`: the vectors of norm `1` and `2`
(the roots of `L`) and `0`. A positive definite lattice is a root lattice if it is equal to its root
sublattice. The root sublattice is defined here for every integral lattice, as the span of the
vectors of norm `1` and `2`; for a positive definite lattice this is the span of the vectors of
norm at most `2`.

LMFDB `lattice.sublattice` calls root sublattice the span of the vectors of norm `2` only,
`TauCeti.IntegralLattice.normTwoSubmodule`. The root sublattice here is generated by that and the
norm 1 sublattice, so the two agree for an even lattice, which has no vector of norm `1`, but not
for `ℤⁿ` with `n ≥ 2`: its root sublattice is `ℤⁿ` in the sense of `lattice.root_sublattice`, and
the root lattice `Dₙ`, of index `2`, in the sense of `lattice.sublattice`.

## Main definitions

* `TauCeti.IntegralLattice.rootSubmodule` (LMFDB `lattice.root_sublattice`).
* `TauCeti.IntegralLattice.IsRootLattice` (LMFDB `lattice.root_sublattice`).

## Main results

* `TauCeti.IntegralLattice.IsPosDef.rootSubmodule_eq_span`: the root sublattice of a positive
  definite lattice is spanned by its vectors of norm at most `2`.
* `TauCeti.IntegralLattice.rootSubmodule_eq_sup`: the root sublattice is generated by the norm 1
  sublattice and the span of the vectors of norm `2`.
* `TauCeti.IntegralLattice.IsEven.rootSubmodule_eq_normTwoSubmodule`: for an even lattice, the root
  sublattices of `lattice.root_sublattice` and `lattice.sublattice` agree.
* `TauCeti.IntegralLattice.isRootLattice_typeARootLattice`: the lattice `Aₙ` is a root lattice.
-/

namespace TauCeti.IntegralLattice

variable {V : Type*} [AddCommGroup V] [Module ℚ V] (L : IntegralLattice V) (n : ℕ)

/-- The **root sublattice** (LMFDB `lattice.root_sublattice`) of an integral lattice `L`: the
submodule of its carrier generated by the vectors of norm `1` and `2`. For a positive definite
lattice this is the span of the vectors of norm at most `2` (`IsPosDef.rootSubmodule_eq_span`), as
in the LMFDB, which only defines it for positive definite lattices. -/
noncomputable def rootSubmodule : Submodule ℤ L :=
  Submodule.span ℤ (L.vectorsOfNorm 1 ∪ L.vectorsOfNorm 2)

/-- A **root lattice** (LMFDB `lattice.root_sublattice`): a positive definite integral lattice
equal to its root sublattice, that is generated by its vectors of norm `1` and `2`. -/
def IsRootLattice : Prop :=
  L.IsPosDef ∧ L.rootSubmodule = ⊤

/-- **The root sublattice is generated by the norm 1 sublattice and the span of the vectors of
norm `2`.** -/
lemma rootSubmodule_eq_sup : L.rootSubmodule = L.normOneSubmodule ⊔ L.normTwoSubmodule :=
  Submodule.span_union _ _

variable {L}

/-- **The root sublattice of a positive definite lattice is spanned by its vectors of norm at most
`2`**, as in LMFDB `lattice.root_sublattice`. -/
lemma IsPosDef.rootSubmodule_eq_span (hL : L.IsPosDef) :
    L.rootSubmodule = Submodule.span ℤ {x : L | L.integralNorm x ≤ 2} := by
  refine le_antisymm (Submodule.span_mono ?_) (Submodule.span_le.mpr fun x hx ↦ ?_)
  · rintro x (hx | hx) <;> rw [mem_vectorsOfNorm, ← integralNorm_cast] at hx
    · exact (by exact_mod_cast hx : L.integralNorm x = 1).trans_le one_le_two
    · exact (by exact_mod_cast hx : L.integralNorm x = 2).le
  · rcases eq_or_ne x 0 with rfl | hx0
    · exact Submodule.zero_mem _
    have hpos : 0 < L.integralNorm x := hL.posDef_integralNorm x hx0
    have hx' : L.integralNorm x ≤ 2 := hx
    refine Submodule.subset_span ?_
    rw [Set.mem_union, mem_vectorsOfNorm, mem_vectorsOfNorm, ← integralNorm_cast]
    have h : L.integralNorm x = 1 ∨ L.integralNorm x = 2 := by omega
    exact_mod_cast h

/-- **For an even lattice, the root sublattices of LMFDB `lattice.root_sublattice` and
`lattice.sublattice` agree.** -/
lemma IsEven.rootSubmodule_eq_normTwoSubmodule (hL : L.IsEven) :
    L.rootSubmodule = L.normTwoSubmodule := by
  rw [rootSubmodule_eq_sup, hL.normOneSubmodule_eq_bot, bot_sup_eq]

lemma integralNorm_typeASimpleRootBasis (i : Fin n) :
    (typeARootLattice n).integralNorm (typeASimpleRootBasis n i) = 2 := by
  rw [integralNorm_apply, ← gramMatrix_apply, gramMatrix_typeASimpleRootBasis,
    ← chainEntry_eq_cartanMatrix_A, chainEntry_self]

/-- **The lattice `Aₙ` is a root lattice**: it is generated by its simple roots, of norm `2`. -/
lemma isRootLattice_typeARootLattice : (typeARootLattice n).IsRootLattice := by
  refine ⟨isPosDef_typeARootLattice n, eq_top_iff.mpr <|
    (typeASimpleRootBasis n).span_eq ▸ Submodule.span_mono ?_⟩
  rintro _ ⟨i, rfl⟩
  exact Or.inr ((mem_vectorsOfNorm_natCast _).mpr (integralNorm_typeASimpleRootBasis n i))

end TauCeti.IntegralLattice
