import Mathlib.FieldTheory.KummerPolynomial
import TauCeti.LinearAlgebra.CliffordAlgebra.Even.Center
import TauCeti.LinearAlgebra.QuadraticForm.OrthogonalBasis

/-!
# The centre of a Clifford algebra is the discriminant algebra

Let `Q` be a nondegenerate quadratic form on a vector space `V` of dimension `n` over a field `K`
in which `2` is invertible, and let `d = (-1) ^ (n choose 2) disc(Q)` be its signed discriminant,
where `disc(Q)` is the Gram determinant of `Q` in a basis of `V`. The centre of the Clifford
algebra of `Q` when `n` is odd, and that of the even Clifford algebra of `Q` when `n` is even and
positive, is the quadratic algebra `K[X] ⧸ (X² - d)` generated by a square root of `d`.

Tau Ceti proves this for the signed product `(-1) ^ (n choose 2) Q(v₁) ⋯ Q(vₙ)` of an anisotropic
orthogonal basis `v₁, …, vₙ`: in even dimension as an isomorphism
(`CliffordAlgebra.adjoinRootEquivCenterEven`), in odd dimension as a description of the centre
(`CliffordAlgebra.mem_center_iff_exists_eq_add_smul_volume`). This file adds the odd-dimensional
isomorphism, and removes the choice of basis: the Gram determinants of `Q` in two bases differ by
the square of the determinant of the change of basis, and for `c ≠ 0` the algebras
`K[X] ⧸ (X² - d)` and `K[X] ⧸ (X² - c² d)` are isomorphic.

## Main definitions

* `AdjoinRoot.xPowSubCMulPowEquiv`: for `c ≠ 0`, `K[X] ⧸ (Xⁿ - a) ≃ K[X] ⧸ (Xⁿ - cⁿ a)`.
* `CliffordAlgebra.adjoinRootToCenter`: the map `K[X] ⧸ (X² - d) → center (CliffordAlgebra Q)`
  sending the root to the volume element of an orthogonal spanning list of odd length.
* `CliffordAlgebra.adjoinRootEquivCenter`: in odd dimension, this map is an isomorphism onto the
  centre of the Clifford algebra.

## Main results

* `AdjoinRoot.finrank_X_pow_sub_C`: `K[X] ⧸ (Xⁿ - a)` has dimension `n` over `K`.
* `QuadraticForm.discr_eq_det_sq_mul_discr`: the Gram determinants of a quadratic form in two
  bases differ by the square of the determinant of the change of basis.
* `CliffordAlgebra.nonempty_center_algEquiv_adjoinRoot`: in odd dimension, the centre of the
  Clifford algebra is the quadratic algebra `K[X] ⧸ (X² - d)` of the signed discriminant `d`.
* `CliffordAlgebra.nonempty_center_even_algEquiv_adjoinRoot`: in even positive dimension, so is the
  centre of the even Clifford algebra.

## References

* T. Y. Lam, *Introduction to Quadratic Forms over Fields* (2005), Chapter V, §2.
* M.-A. Knus, *Quadratic and Hermitian Forms over Rings* (1991), Chapter IV, §3.
-/

open Module Polynomial

namespace AdjoinRoot

variable {K : Type*} [Field K] (n : ℕ) (a : K) {c : K}

/-- **The dimension of `K[X] ⧸ (Xⁿ - a)`** is the degree `n` of `Xⁿ - a`, by Mathlib's
`finrank_quotient_span_eq_natDegree`. -/
lemma finrank_X_pow_sub_C : finrank K (AdjoinRoot (X ^ n - C a)) = n :=
  finrank_quotient_span_eq_natDegree.trans natDegree_X_pow_sub_C

/-- **Rescaling the root**: for `c ≠ 0`, the algebras `K[X] ⧸ (Xⁿ - a)` and `K[X] ⧸ (Xⁿ - cⁿ a)`
are isomorphic, the root of `Xⁿ - a` going to `c⁻¹` times the root of `Xⁿ - cⁿ a`. -/
noncomputable def xPowSubCMulPowEquiv (hc : c ≠ 0) :
    AdjoinRoot (X ^ n - C a) ≃ₐ[K] AdjoinRoot (X ^ n - C (c ^ n * a)) :=
  .ofAlgHom
    (liftAlgHom (X ^ n - C a) (Algebra.ofId K _) (c⁻¹ • root (X ^ n - C (c ^ n * a))) <| by
      rw [eval₂_sub, eval₂_X_pow, eval₂_C, smul_pow, root_X_pow_sub_C_pow, sub_eq_zero,
        AlgHom.coe_toRingHom, Algebra.ofId_apply, Algebra.smul_def, algebraMap_eq, ← map_mul,
        inv_pow, inv_mul_cancel_left₀ (pow_ne_zero n hc)])
    (liftAlgHom (X ^ n - C (c ^ n * a)) (Algebra.ofId K _) (c • root (X ^ n - C a)) <| by
      rw [eval₂_sub, eval₂_X_pow, eval₂_C, smul_pow, root_X_pow_sub_C_pow, sub_eq_zero,
        AlgHom.coe_toRingHom, Algebra.ofId_apply, Algebra.smul_def, algebraMap_eq, ← map_mul])
    (algHom_ext <| by simp [hc]) (algHom_ext <| by simp [hc])

lemma xPowSubCMulPowEquiv_root (hc : c ≠ 0) :
    xPowSubCMulPowEquiv n a hc (root _) = c⁻¹ • root (X ^ n - C (c ^ n * a)) := by
  rw [xPowSubCMulPowEquiv, AlgEquiv.ofAlgHom_apply, liftAlgHom_root]

end AdjoinRoot

namespace QuadraticForm

variable {R M ι : Type*} [CommRing R] [Invertible (2 : R)] [AddCommGroup M] [Module R M] [Fintype ι]
  [DecidableEq ι] (Q : QuadraticForm R M) (b w : Basis ι R M)

/-- **Change of basis for the Gram determinant**: the Gram determinants of a quadratic form in two
bases `b` and `w` differ by the square of the determinant of `w` in `b`. -/
lemma discr_eq_det_sq_mul_discr : Q.discr w = b.det w ^ 2 * Q.discr b :=
  (discr_comp b Q LinearMap.id : Q.discr w = _).trans <| by
    rw [LinearMap.toMatrix_id_eq_basis_toMatrix, ← Basis.det_apply, sq]

lemma discr_reindex {κ : Type*} [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) :
    Q.discr (b.reindex e) = Q.discr b := by
  rw [discr, discr, ← Matrix.det_submatrix_equiv_self e.symm]
  congr 1
  ext i j
  simp [toMatrix]

variable {Q w} in
lemma discr_eq_prod_of_isOrtho (hw : ∀ i j, i ≠ j → Q.IsOrtho (w i) (w j)) :
    Q.discr w = ∏ i, Q (w i) := by
  rw [discr, ← Matrix.det_diagonal]
  congr 1
  ext i j
  rw [toMatrix, LinearMap.toMatrix₂_apply, Matrix.diagonal_apply]
  split_ifs with h
  · rw [h, QuadraticMap.associated_eq_self_apply]
  · exact QuadraticMap.associated_isOrtho.mpr (hw i j h)

end QuadraticForm

namespace CliffordAlgebra

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {Q : QuadraticForm K V} {l : List V}
  (hl : l.Pairwise Q.IsOrtho) (hlen : Odd l.length) (hspan : Submodule.span K {x : V | x ∈ l} = ⊤)

/-- The algebra map `K[X] ⧸ (X² - d) → center (CliffordAlgebra Q)` sending the root to the volume
element `ω = v₁ ⋯ vₙ` of a pairwise orthogonal spanning list of odd length, whose square is
`d = (-1) ^ (n choose 2) Q(v₁) ⋯ Q(vₙ)`. -/
noncomputable def adjoinRootToCenter :
    AdjoinRoot (X ^ 2 - C ((-1 : K) ^ l.length.choose 2 * (l.map Q).prod)) →ₐ[K]
      Subalgebra.center K (CliffordAlgebra Q) :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId K _)
    ⟨(l.map (ι Q)).prod, prod_map_ι_mem_center_of_odd_length hl hlen hspan⟩ <| by
      rw [eval₂_sub, eval₂_X_pow, eval₂_C, sub_eq_zero, AlgHom.coe_toRingHom, Algebra.ofId_apply]
      exact Subtype.ext <| by simpa [sq] using prod_map_ι_sq_scalar hl

lemma adjoinRootToCenter_root :
    (adjoinRootToCenter hl hlen hspan (AdjoinRoot.root _) : CliffordAlgebra Q) =
      (l.map (ι Q)).prod :=
  congrArg Subtype.val <| AdjoinRoot.liftAlgHom_root _ _ _ _

variable [NeZero (2 : K)] in
lemma surjective_adjoinRootToCenter (hQl : ∀ v ∈ l, Q v ≠ 0) :
    Function.Surjective (adjoinRootToCenter hl hlen hspan) := by
  rintro ⟨y, hy⟩
  rcases (mem_center_iff_exists_eq_add_smul_volume hl hlen hspan hQl).mp hy with ⟨a, b, rfl⟩
  refine ⟨AdjoinRoot.of _ a + AdjoinRoot.of _ b * AdjoinRoot.root _, Subtype.ext ?_⟩
  simp [adjoinRootToCenter, Algebra.smul_def]

variable [NeZero (2 : K)] in
lemma bijective_adjoinRootToCenter (hQl : ∀ v ∈ l, Q v ≠ 0) :
    Function.Bijective (adjoinRootToCenter hl hlen hspan) := by
  rcases QuadraticMap.nondegenerate_and_length_eq_finrank_of_pairwise_isOrtho hl hspan hQl with
    ⟨hQ, hlenV⟩
  have hsurj : Function.Surjective (adjoinRootToCenter hl hlen hspan) :=
    surjective_adjoinRootToCenter hl hlen hspan hQl
  have hcenter : finrank K (Subalgebra.center K (CliffordAlgebra Q)) = 2 :=
    finrank_center_eq_two_of_odd_finrank hQ (hlenV ▸ hlen)
  have : FiniteDimensional K
      (AdjoinRoot (X ^ 2 - C ((-1 : K) ^ l.length.choose 2 * (l.map Q).prod))) :=
    (AdjoinRoot.powerBasis <| X_pow_sub_C_ne_zero two_pos _).finite
  have : FiniteDimensional K (Subalgebra.center K (CliffordAlgebra Q)) :=
    .of_finrank_pos <| hcenter ▸ two_pos
  exact ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    ((AdjoinRoot.finrank_X_pow_sub_C 2 _).trans hcenter.symm)
    (f := (adjoinRootToCenter hl hlen hspan).toLinearMap)).mpr hsurj, hsurj⟩

variable [NeZero (2 : K)] in
/-- **The centre of the Clifford algebra in odd dimension is the quadratic algebra
`K[X] ⧸ (X² - d)`.** For an anisotropic orthogonal spanning list `v₁, …, vₙ` of odd length, with
`d = (-1) ^ (n choose 2) Q(v₁) ⋯ Q(vₙ)` (the signed discriminant of `Q`, up to squares), the root of
`X² - d` goes to the volume element `ω = v₁ ⋯ vₙ`. This is the odd-dimensional companion of Tau
Ceti's `CliffordAlgebra.adjoinRootEquivCenterEven`. -/
noncomputable def adjoinRootEquivCenter (hQl : ∀ v ∈ l, Q v ≠ 0) :
    AdjoinRoot (X ^ 2 - C ((-1 : K) ^ l.length.choose 2 * (l.map Q).prod)) ≃ₐ[K]
      Subalgebra.center K (CliffordAlgebra Q) :=
  .ofBijective _ <| bijective_adjoinRootToCenter hl hlen hspan hQl

variable [NeZero (2 : K)] in
@[simp]
lemma coe_adjoinRootEquivCenter_root (hQl : ∀ v ∈ l, Q v ≠ 0) :
    (adjoinRootEquivCenter hl hlen hspan hQl (AdjoinRoot.root _) : CliffordAlgebra Q) =
      (l.map (ι Q)).prod :=
  adjoinRootToCenter_root hl hlen hspan

variable [Invertible (2 : K)] {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι K V)

lemma exists_list_pairwise_isOrtho_neg_one_pow_mul_prod_eq (hQ : Q.Nondegenerate) : ∃ l : List V,
    l.Pairwise Q.IsOrtho ∧ l.length = finrank K V ∧ Submodule.span K {x : V | x ∈ l} = ⊤ ∧
    (∀ v ∈ l, Q v ≠ 0) ∧ ∃ c : K, c ≠ 0 ∧ (-1) ^ l.length.choose 2 * (l.map Q).prod =
      c ^ 2 * ((-1) ^ (finrank K V).choose 2 * Q.discr b) := by
  have : FiniteDimensional K V := b.finiteDimensional_of_finite
  rcases hQ.exists_orthogonal_basis with ⟨o, ho, hQo⟩
  let b' : Basis (Fin (finrank K V)) K V :=
    b.reindex (Fintype.equivFinOfCardEq (finrank_eq_card_basis b).symm)
  refine ⟨List.ofFn o, List.pairwise_ofFn.mpr fun i j hij ↦ ho i j hij.ne, List.length_ofFn,
    (congrArg (Submodule.span K) <| Set.ext fun x ↦ List.mem_ofFn' o x).trans o.span_eq,
    List.forall_mem_ofFn_iff.mpr hQo, b'.det o, (b'.isUnit_det o).ne_zero, ?_⟩
  rw [List.length_ofFn, List.map_ofFn, List.prod_ofFn, Function.comp_def,
    ← QuadraticForm.discr_eq_prod_of_isOrtho ho, QuadraticForm.discr_eq_det_sq_mul_discr _ b',
    QuadraticForm.discr_reindex]
  ring1

/-- **In odd dimension, the centre of the Clifford algebra is the discriminant algebra**: for a
nondegenerate quadratic form `Q` on a space of odd dimension `n`, the centre of its Clifford
algebra is isomorphic to `K[X] ⧸ (X² - d)` for the signed discriminant
`d = (-1) ^ (n choose 2) disc(Q)`, where `disc(Q)` is the Gram determinant of `Q` in any basis. -/
lemma nonempty_center_algEquiv_adjoinRoot (hQ : Q.Nondegenerate) (hodd : Odd (finrank K V)) :
    Nonempty (Subalgebra.center K (CliffordAlgebra Q) ≃ₐ[K]
      AdjoinRoot (X ^ 2 - C ((-1) ^ (finrank K V).choose 2 * Q.discr b))) := by
  rcases exists_list_pairwise_isOrtho_neg_one_pow_mul_prod_eq b hQ with
    ⟨l, hl, hlen, hspan, hQl, c, hc, hd⟩
  exact ⟨(adjoinRootEquivCenter hl (hlen ▸ hodd) hspan hQl).symm.trans <|
    (AdjoinRoot.algEquivOfEq K _ _ <| by rw [hd]).trans
      (AdjoinRoot.xPowSubCMulPowEquiv 2 _ hc).symm⟩

/-- **In even positive dimension, the centre of the even Clifford algebra is the discriminant
algebra**: for a nondegenerate quadratic form `Q` on a space of even positive dimension `n`, the
centre of its even Clifford algebra is isomorphic to `K[X] ⧸ (X² - d)` for the signed discriminant
`d = (-1) ^ (n choose 2) disc(Q)`, where `disc(Q)` is the Gram determinant of `Q` in any basis. -/
lemma nonempty_center_even_algEquiv_adjoinRoot (hQ : Q.Nondegenerate) (heven : Even (finrank K V))
    (hpos : 0 < finrank K V) : Nonempty (Subalgebra.center K (even Q) ≃ₐ[K]
      AdjoinRoot (X ^ 2 - C ((-1) ^ (finrank K V).choose 2 * Q.discr b))) := by
  rcases exists_list_pairwise_isOrtho_neg_one_pow_mul_prod_eq b hQ with
    ⟨l, hl, hlen, hspan, hQl, c, hc, hd⟩
  exact ⟨(adjoinRootEquivCenterEven hl (hlen ▸ heven) (List.length_pos_iff.mp (hlen ▸ hpos))
    hspan hQl).symm.trans <| (AdjoinRoot.algEquivOfEq K _ _ <| by rw [hd]).trans
      (AdjoinRoot.xPowSubCMulPowEquiv 2 _ hc).symm⟩

end CliffordAlgebra
