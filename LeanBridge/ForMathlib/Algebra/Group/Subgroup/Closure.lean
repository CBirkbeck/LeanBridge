import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas

/-!
# The subgroup generated by three elements of a commutative group

In a commutative group, the subgroup generated by three elements `x`, `y` and `z` consists of the
products `x ^ a * y ^ b * z ^ c` with integers `a`, `b` and `c`, as Mathlib's
`Subgroup.mem_closure_pair` says for two elements; and additively for commutative additive groups.
-/

@[to_additive]
lemma Subgroup.mem_closure_triple {C : Type*} [CommGroup C] {x y z w : C} :
    w ∈ closure ({x, y, z} : Set C) ↔ ∃ a b c : ℤ, x ^ a * y ^ b * z ^ c = w := by
  rw [← Set.singleton_union, closure_union, mem_sup]
  simp_rw [mem_closure_singleton, mem_closure_pair, exists_exists_eq_and]
  exact ⟨fun ⟨a, _, ⟨b, c, rfl⟩, h⟩ ↦ ⟨a, b, c, by rw [mul_assoc, h]⟩,
    fun ⟨a, b, c, h⟩ ↦ ⟨a, _, ⟨b, c, rfl⟩, by rw [← mul_assoc, h]⟩⟩
