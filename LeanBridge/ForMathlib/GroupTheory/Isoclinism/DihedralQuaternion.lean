import LeanBridge.ForMathlib.GroupTheory.Isoclinism.Surjective
import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.CyclicIndexTwoClassification
import LeanBridge.ForMathlib.GroupTheory.StemExtension

/-!
# Isoclinic stem groups need not be isomorphic

The dihedral group `D₄` of order 8 (`DihedralGroup 4`) and the quaternion group `Q₈`
(`QuaternionGroup 2`) are stem groups (LMFDB `group.stem_group`): their centres `{1, r 2}` and
`{1, a 2}` are generated by the commutators `⁅r 1, sr 0⁆ = r 2` and `⁅a 1, xa 0⁆ = a 2`. They are
isoclinic (LMFDB `group.isoclinism`): both map onto `C₂ × C₂` with their centres as kernels, and
the fibre product of these two maps projects onto each of them with a kernel meeting its
commutator subgroup trivially, since all its commutators are `1` or `(r 2, a 2)`. They are not
isomorphic (`DihedralGroup.isEmpty_mulEquiv_quaternionGroup`, for `D_{2^{k-1}}` and `Q_{2^k}`). So
the stem group isoclinic to a given finite group is not unique up to isomorphism.

## Main definitions

* `DihedralGroup.reduceModTwo`, `QuaternionGroup.reduceModTwo`: the surjections of `D₄` and `Q₈`
  onto `C₂ × C₂` whose kernels are the centres.
* `Group.dihedralQuaternionPullback`: their fibre product, a subgroup of order 16 of `D₄ × Q₈`.

## Main results

* `DihedralGroup.isStemGroup_four`, `QuaternionGroup.isStemGroup_two` (LMFDB `group.stem_group`):
  `D₄` and `Q₈` are stem groups.
* `Group.isIsoclinic_dihedralGroup_quaternionGroup` (LMFDB `group.isoclinism`): `D₄` and `Q₈` are
  isoclinic.
* `Group.not_forall_nonempty_mulEquiv_of_isStemGroup` (LMFDB `group.stem_group`): isoclinic finite
  stem groups need not be isomorphic.
-/

open DihedralGroup QuaternionGroup Subgroup

open scoped commutatorElement

namespace DihedralGroup

/-- The surjection `D₄ → C₂ × C₂`, `r i ↦ (i mod 2, 0)` and `sr i ↦ (i mod 2, 1)`, from the
dihedral group of order 8; its kernel is the centre `{1, r 2}`. -/
def reduceModTwo : DihedralGroup 4 →* Multiplicative (ZMod 2 × ZMod 2) where
  toFun
    | r i => .ofAdd (ZMod.castHom (by norm_num) (ZMod 2) i, 0)
    | sr i => .ofAdd (ZMod.castHom (by norm_num) (ZMod 2) i, 1)
  map_one' := rfl
  map_mul' := by decide

/-- **The dihedral group `D₄` of order 8 is a stem group** (LMFDB `group.stem_group`): its centre
`{1, r 2}` is generated by the commutator `⁅r 1, sr 0⁆ = r 2`. -/
lemma isStemGroup_four : Group.IsStemGroup (DihedralGroup 4) := by
  rw [Group.IsStemGroup, center_eq_closure_of_even_ne_two (by decide) (by decide), zpowers_le,
    ← (by decide : ⁅(r 1 : DihedralGroup 4), sr 0⁆ = r ((4 / 2 : ℕ) : ZMod 4))]
  exact commutator_mem_commutator (mem_top _) (mem_top _)

end DihedralGroup

namespace QuaternionGroup

/-- The surjection `Q₈ → C₂ × C₂`, `a i ↦ (i mod 2, 0)` and `xa i ↦ (i mod 2, 1)`, from the
quaternion group; its kernel is the centre `{1, a 2}`. -/
def reduceModTwo : QuaternionGroup 2 →* Multiplicative (ZMod 2 × ZMod 2) where
  toFun
    | a i => .ofAdd (ZMod.castHom (by norm_num) (ZMod 2) i, 0)
    | xa i => .ofAdd (ZMod.castHom (by norm_num) (ZMod 2) i, 1)
  map_one' := rfl
  map_mul' := by decide

/-- **The quaternion group `Q₈` is a stem group** (LMFDB `group.stem_group`): its centre
`{1, a 2}` is generated by the commutator `⁅a 1, xa 0⁆ = a 2`. -/
lemma isStemGroup_two : Group.IsStemGroup (QuaternionGroup 2) := by
  intro x hx
  rcases (by decide : ∀ x : QuaternionGroup 2, a 1 * x = x * a 1 → xa 0 * x = x * xa 0 →
    x = 1 ∨ x = a 2) x (mem_center_iff.mp hx (a 1)) (mem_center_iff.mp hx (xa 0)) with rfl | rfl
  · exact one_mem _
  · rw [← (by decide : ⁅(a 1 : QuaternionGroup 2), xa 0⁆ = a 2)]
    exact commutator_mem_commutator (mem_top _) (mem_top _)

end QuaternionGroup

namespace Group

/-- The fibre product of `DihedralGroup.reduceModTwo` and `QuaternionGroup.reduceModTwo`: the
subgroup of pairs of `D₄ × Q₈` with the same image in `C₂ × C₂`, of order 16. -/
def dihedralQuaternionPullback : Subgroup (DihedralGroup 4 × QuaternionGroup 2) :=
  (DihedralGroup.reduceModTwo.comp <| MonoidHom.fst _ _).eqLocus <|
    QuaternionGroup.reduceModTwo.comp <| MonoidHom.snd _ _

lemma fst_eq_one_iff_snd_eq_one_of_mem_commutator {c : dihedralQuaternionPullback}
    (hc : c ∈ commutator dihedralQuaternionPullback) :
    (c : DihedralGroup 4 × QuaternionGroup 2).1 = 1 ↔
      (c : DihedralGroup 4 × QuaternionGroup 2).2 = 1 := by
  have hle : commutator dihedralQuaternionPullback ≤
      (closure {((r 2, a 2) : DihedralGroup 4 × QuaternionGroup 2)}).comap
        dihedralQuaternionPullback.subtype := by
    refine (commutator_def ↥dihedralQuaternionPullback).le.trans <| commutator_le.mpr ?_
    rintro ⟨⟨d, q⟩, hx⟩ - ⟨⟨d', q'⟩, hy⟩ -
    have hxy : dihedralQuaternionPullback.subtype
        ⁅(⟨(d, q), hx⟩ : dihedralQuaternionPullback), ⟨(d', q'), hy⟩⁆ = (⁅d, d'⁆, ⁅q, q'⁆) :=
      rfl
    rw [mem_comap, hxy]
    rcases (by decide : ∀ d d' : DihedralGroup 4, ∀ q q' : QuaternionGroup 2,
      DihedralGroup.reduceModTwo d = QuaternionGroup.reduceModTwo q →
      DihedralGroup.reduceModTwo d' = QuaternionGroup.reduceModTwo q' →
      ⁅d, d'⁆ = 1 ∧ ⁅q, q'⁆ = 1 ∨ ⁅d, d'⁆ = r 2 ∧ ⁅q, q'⁆ = a 2) d d' q q' hx hy with
      ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩ <;> rw [h₁, h₂]
    · exact one_mem _
    · exact subset_closure <| Set.mem_singleton _
  have hcl (x : DihedralGroup 4 × QuaternionGroup 2) (hx : x ∈ closure {(r 2, a 2)}) :
      x = 1 ∨ x = (r 2, a 2) := by
    induction hx using closure_induction with
    | mem x hx => exact Or.inr hx
    | one => exact Or.inl rfl
    | mul x y _ _ hx hy => rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> decide
    | inv x _ hx => rcases hx with rfl | rfl <;> decide
  rcases hcl c (mem_comap.mp (hle hc)) with h | h <;> rw [h] <;> decide

lemma surjective_fst_comp_subtype_dihedralQuaternionPullback :
    Function.Surjective <| (MonoidHom.fst _ _).comp dihedralQuaternionPullback.subtype := by
  intro d
  rcases (by decide : ∀ d : DihedralGroup 4, ∃ q : QuaternionGroup 2,
    DihedralGroup.reduceModTwo d = QuaternionGroup.reduceModTwo q) d with ⟨q, hq⟩
  exact ⟨⟨(d, q), hq⟩, rfl⟩

lemma surjective_snd_comp_subtype_dihedralQuaternionPullback :
    Function.Surjective <| (MonoidHom.snd _ _).comp dihedralQuaternionPullback.subtype := by
  intro q
  rcases (by decide : ∀ q : QuaternionGroup 2, ∃ d : DihedralGroup 4,
    DihedralGroup.reduceModTwo d = QuaternionGroup.reduceModTwo q) q with ⟨d, hd⟩
  exact ⟨⟨(d, q), hd⟩, rfl⟩

lemma ker_fst_comp_subtype_inf_commutator_dihedralQuaternionPullback :
    ((MonoidHom.fst _ _).comp dihedralQuaternionPullback.subtype).ker ⊓
      commutator dihedralQuaternionPullback = ⊥ :=
  eq_bot_iff.mpr fun _ ⟨h₁, h₂⟩ ↦ Subtype.ext <| Prod.ext h₁ <|
    (fst_eq_one_iff_snd_eq_one_of_mem_commutator h₂).mp h₁

lemma ker_snd_comp_subtype_inf_commutator_dihedralQuaternionPullback :
    ((MonoidHom.snd _ _).comp dihedralQuaternionPullback.subtype).ker ⊓
      commutator dihedralQuaternionPullback = ⊥ :=
  eq_bot_iff.mpr fun _ ⟨h₁, h₂⟩ ↦ Subtype.ext <| Prod.ext
    ((fst_eq_one_iff_snd_eq_one_of_mem_commutator h₂).mpr h₁) h₁

/-- **`D₄` and `Q₈` are isoclinic** (LMFDB `group.isoclinism`): both are isoclinic to the fibre
product `dihedralQuaternionPullback`, whose projections are surjective with kernels meeting its
commutator subgroup trivially. -/
lemma isIsoclinic_dihedralGroup_quaternionGroup :
    IsIsoclinic (DihedralGroup 4) (QuaternionGroup 2) :=
  (isIsoclinic_of_surjective surjective_fst_comp_subtype_dihedralQuaternionPullback
    ker_fst_comp_subtype_inf_commutator_dihedralQuaternionPullback).symm.trans <|
    isIsoclinic_of_surjective surjective_snd_comp_subtype_dihedralQuaternionPullback
      ker_snd_comp_subtype_inf_commutator_dihedralQuaternionPullback

/-- **Isoclinic stem groups need not be isomorphic** (LMFDB `group.stem_group`): the stem group
isoclinic to a given finite group is not unique up to isomorphism, as `D₄` and `Q₈` are isoclinic
stem groups which are not isomorphic. -/
lemma not_forall_nonempty_mulEquiv_of_isStemGroup : ¬∀ (G H : Type) [Group G] [Group H] [Finite G]
    [Finite H], IsStemGroup G → IsStemGroup H → IsIsoclinic G H → Nonempty (G ≃* H) := by
  intro h
  have : Fact (3 ≤ 3) := ⟨le_rfl⟩
  exact (DihedralGroup.isEmpty_mulEquiv_quaternionGroup (k := 3)).false <| Nonempty.some <|
    h _ _ DihedralGroup.isStemGroup_four QuaternionGroup.isStemGroup_two
      isIsoclinic_dihedralGroup_quaternionGroup

end Group
