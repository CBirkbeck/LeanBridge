import LeanBridge.ForMathlib.GroupTheory.Label.Subgroup
import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.CyclicIndexTwo
import Mathlib.GroupTheory.Sylow
import Mathlib.Order.Sublattice
import TauCeti.Algebra.GroupAction.PermutationRepresentation

/-!
# Subgroups that the LMFDB stores beyond its index bound

When the LMFDB does not compute the whole subgroup lattice of a finite group `G`, it still stores
some subgroups of large index (LMFDB `group.subgroups_beyond_bound`), and the reasons it gives are
mathematical facts, which we prove here.

* The Sylow `p`-subgroups are the unique subgroups of their order up to conjugacy: a subgroup has
  the order of a Sylow `p`-subgroup `P` if and only if it is conjugate to `P`
  (`Subgroup.IsConjugate`).
* The normal subgroups form a lattice, a sublattice of the lattice of subgroups.
* A subgroup can be a complement (LMFDB `group.subgroup.complement`) of several normal subgroups:
  in the Klein four group `C_2 × C_2`, the subgroup generated by `(1, 0)` is a complement of the
  normal subgroups generated by `(0, 1)` and by `(1, 1)`.
* A core-free subgroup `H` (LMFDB `group.core`) yields a transitive permutation representation
  (LMFDB `group.permutation_representation`) of degree `[G : H]`, which is faithful: `G` acts on
  the cosets of `H` with kernel the normal core of `H`.

## Main definitions

* `Subgroup.normalSublattice`: the lattice of normal subgroups.

## Main results

* `Sylow.natCard_eq_iff_isConjugate`: the subgroups of the order of a Sylow subgroup are its
  conjugates.
* `Subgroup.one_lt_ncard_setOf_normal_isComplement'_kleinFour`: a subgroup of the Klein four group
  is a complement of two normal subgroups.
* `Subgroup.faithfulSMul_quotient_iff`: `G` acts faithfully on the cosets of `H` if and only if `H`
  is core-free.
* `Subgroup.injective_permutationRepresentation`: the permutation representation on the cosets of a
  core-free subgroup is faithful.
* `Subgroup.exists_permutationRepresentation_apply_eq`: the permutation representation on the
  cosets of a subgroup is transitive.
-/

open MulAction Multiplicative

open scoped Pointwise

variable {G : Type*} [Group G] {H : Subgroup G}

namespace Sylow

variable [Finite G] {p : ℕ} [Fact p.Prime] (P : Sylow p G)

/-- **The Sylow subgroups are the unique subgroups of their order up to conjugacy** (LMFDB
`group.subgroups_beyond_bound`): in a finite group, a subgroup has the order of a Sylow
`p`-subgroup `P` if and only if it is conjugate to `P`. -/
lemma natCard_eq_iff_isConjugate : Nat.card H = Nat.card P ↔ (P : Subgroup G).IsConjugate H := by
  refine ⟨fun h ↦ ?_, fun ⟨g, hg⟩ ↦ ?_⟩
  · rcases exists_smul_eq G P (ofCard H (h.trans P.card_eq_multiplicity)) with ⟨g, hg⟩
    exact ⟨g, congrArg (fun Q : Sylow p G ↦ (Q : Subgroup G)) hg⟩
  · exact hg ▸ Nat.card_congr (Subgroup.equivSMul _ _).toEquiv.symm

end Sylow

namespace Subgroup

variable (G) in
/-- The **lattice of normal subgroups** of `G` (LMFDB `group.subgroups_beyond_bound`): the normal
subgroups are closed under `⊓` and `⊔`, so they form a sublattice of the lattice of subgroups. -/
def normalSublattice : Sublattice (Subgroup G) where
  carrier := {H | H.Normal}
  supClosed' H hH K hK := sup_normal (hH := hH) (hK := hK) H K
  infClosed' H hH K hK := normal_inf_normal (hH := hH) (hK := hK) H K

lemma mem_normalSublattice : H ∈ normalSublattice G ↔ H.Normal :=
  Iff.rfl

/-- **A subgroup can be a complement of several normal subgroups** (LMFDB
`group.subgroups_beyond_bound`): in the Klein four group `C_2 × C_2`, the subgroup generated by
`(1, 0)` is a complement of more than one normal subgroup, namely of the subgroups generated by
`(0, 1)` and by `(1, 1)`. -/
lemma one_lt_ncard_setOf_normal_isComplement'_kleinFour : 1 <
    {N : Subgroup (Multiplicative (ZMod 2 × ZMod 2)) | N.Normal ∧
      N.IsComplement' (zpowers (ofAdd (1, 0)))}.ncard := by
  have hcard : Nat.card (Multiplicative (ZMod 2 × ZMod 2)) = 4 := by
    rw [Nat.card_congr toAdd, Nat.card_prod, Nat.card_zmod]
  have hindex (y : Multiplicative (ZMod 2 × ZMod 2)) (hy : y ^ 2 = 1) (hy1 : y ≠ 1) :
      (zpowers y).index = 2 := by
    have h :
        (zpowers y).index * Nat.card (zpowers y) = Nat.card (Multiplicative (ZMod 2 × ZMod 2)) :=
      (zpowers y).index_mul_card
    rw [Nat.card_zpowers, orderOf_eq_prime hy hy1, hcard] at h
    omega
  have hcompl (y : Multiplicative (ZMod 2 × ZMod 2)) (hy : y ^ 2 = 1) (hy1 : y ≠ 1)
      (hyx : ofAdd (1, 0) ≠ y) : (zpowers y).IsComplement' (zpowers (ofAdd (1, 0))) :=
    isComplement'_zpowers_of_sq_eq_one (hindex y hy hy1)
      (fun h ↦ (eq_one_or_eq_of_mem_zpowers hy h).elim (by decide) hyx) (by decide)
  refine (Set.one_lt_ncard_iff (Set.toFinite _)).mpr ⟨zpowers (ofAdd (0, 1)),
    zpowers (ofAdd (1, 1)), ⟨inferInstance, hcompl _ (by decide) (by decide) (by decide)⟩,
    ⟨inferInstance, hcompl _ (by decide) (by decide) (by decide)⟩, fun h ↦ ?_⟩
  rcases eq_one_or_eq_of_mem_zpowers (by decide) (h ▸ mem_zpowers (ofAdd (1, 1))) with h' | h' <;>
    exact absurd h' (by decide)

/-- **`G` acts faithfully on the cosets of `H` if and only if `H` is core-free** (LMFDB
`group.subgroups_beyond_bound`, `group.core`): the kernel of the action is the normal core of
`H`. -/
lemma faithfulSMul_quotient_iff : FaithfulSMul G (G ⧸ H) ↔ H.normalCore = ⊥ := by
  rw [normalCore_eq_ker, MonoidHom.ker_eq_bot_iff]
  exact ⟨fun _ ↦ toPerm_injective, fun h ↦ ⟨fun hg ↦ h (Equiv.ext hg)⟩⟩

variable {n : ℕ}

/-- **A core-free subgroup yields a faithful permutation representation** (LMFDB
`group.subgroups_beyond_bound`, `group.permutation_representation`): if `H` has trivial normal
core, the permutation representation `G →* S_n` of the action on the `n = [G : H]` cosets of `H`,
through any enumeration `e` of the cosets, is injective. -/
lemma injective_permutationRepresentation (hH : H.normalCore = ⊥) (e : G ⧸ H ≃ Fin n) :
    Function.Injective (e.permutationRepresentation (G := G)) :=
  have : FaithfulSMul G (G ⧸ H) := faithfulSMul_quotient_iff.mpr hH
  e.permutationRepresentation_injective

/-- **The action on the cosets of a subgroup yields a transitive permutation representation**
(LMFDB `group.subgroups_beyond_bound`, `group.permutation_representation`): through any
enumeration `e` of the `n` cosets of `H`, every `i` is mapped to every `j` by some `g`. -/
lemma exists_permutationRepresentation_apply_eq (e : G ⧸ H ≃ Fin n) (i j : Fin n) :
    ∃ g : G, e.permutationRepresentation g i = j := by
  rcases exists_smul_eq G (e.symm i) (e.symm j) with ⟨g, hg⟩
  exact ⟨g, by rw [e.permutationRepresentation_apply, hg, e.apply_symm_apply]⟩

end Subgroup
