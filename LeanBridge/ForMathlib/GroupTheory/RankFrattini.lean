import LeanBridge.ForMathlib.GroupTheory.PolycyclicPresentation
import Mathlib.Algebra.Module.ZMod
import Mathlib.GroupTheory.Frattini
import Mathlib.GroupTheory.Perm.Closure
import Mathlib.GroupTheory.Perm.Fin
import Mathlib.GroupTheory.Rank
import TauCeti.Topology.Algebra.Group.Profinite.ProP.MaximalSubgroup
import TauCeti.Topology.Algebra.Group.Profinite.ProP.Rank

/-!
# Burnside's basis theorem for finite `p`-groups

The rank of a finite group is the least number of elements generating it (Mathlib's
`Group.rank`). For a finite `p`-group `G` the Frattini quotient `G ⧸ Φ(G)` is elementary abelian,
an `𝔽_p`-vector space, and its dimension is the rank of `G` (LMFDB `group.rank`). Tau Ceti proves
this for topologically finitely generated pro-`p` groups, with the pro-`p` Frattini subgroup, and
identifies both the generator rank and the pro-`p` Frattini subgroup of a finite discrete
`p`-group with `Group.rank` and `frattini`; we give `G` the discrete topology to deduce the
statement for abstract finite `p`-groups. The rank is also at most the number of generators of
any polycyclic presentation, and it can be smaller than that of all of them: `S₄` is generated by
two elements, while a polycyclic sequence of length `n` kills the `n`-th term of the derived series
and the second derived subgroup of `S₄` is not trivial.

## Main definitions

* `IsPGroup.frattiniQuotientCommGroup` (LMFDB `group.rank`): the Frattini quotient of a finite
  `p`-group, as a commutative group.
* `IsPGroup.frattiniQuotientModule` (LMFDB `group.rank`): its structure of `𝔽_p`-vector space.

## Main results

* `IsPGroup.rank_eq_finrank_quotient_frattini` (LMFDB `group.rank`): Burnside's basis theorem,
  the rank of a finite `p`-group is the `𝔽_p`-dimension of its Frattini quotient.
* `PolycyclicSequence.rank_le_length` (LMFDB `group.rank`): the rank is at most the length of a
  polycyclic sequence.
* `PolycyclicSequence.rank_lt_length_perm_fin_four` (LMFDB `group.rank`): the rank of `S₄` is
  smaller than the length of each of its polycyclic sequences.
-/

open Equiv Perm Subgroup TauCeti

open scoped commutatorElement

variable {G : Type*} [Group G]

namespace IsPGroup

variable {p : ℕ} [Fact p.Prime] [Finite G]

lemma commutator_le_frattini (hG : IsPGroup p G) : commutator G ≤ frattini G := by
  let _ : TopologicalSpace G := ⊥
  have _ : DiscreteTopology G := ⟨rfl⟩
  rw [← hG.proPFrattini_eq_frattini]
  exact commutator_le_proPFrattini Fact.out

lemma pow_mem_frattini (hG : IsPGroup p G) (g : G) : g ^ p ∈ frattini G := by
  let _ : TopologicalSpace G := ⊥
  have _ : DiscreteTopology G := ⟨rfl⟩
  rw [← hG.proPFrattini_eq_frattini]
  exact pow_mem_proPFrattini g

/-- The **Frattini quotient** `G ⧸ Φ(G)` of a finite `p`-group `G` (LMFDB `group.rank`) as a
commutative group: it is abelian, as `Φ(G)` contains the commutator subgroup. -/
abbrev frattiniQuotientCommGroup (hG : IsPGroup p G) : CommGroup (G ⧸ frattini G) :=
  { (inferInstance : Group (G ⧸ frattini G)) with
    mul_comm := isMulCommutative_iff.mp <| Normal.quotient_commutative_iff_commutator_le.mpr
      hG.commutator_le_frattini }

/-- The **`𝔽_p`-vector space** `G ⧸ Φ(G)` of a finite `p`-group `G` (LMFDB `group.rank`), written
additively: the Frattini quotient is abelian and killed by `p`, an elementary abelian `p`-group. -/
abbrev frattiniQuotientModule (hG : IsPGroup p G) :
    letI : CommGroup (G ⧸ frattini G) := hG.frattiniQuotientCommGroup
    Module (ZMod p) (Additive (G ⧸ frattini G)) :=
  letI : CommGroup (G ⧸ frattini G) := hG.frattiniQuotientCommGroup
  AddCommGroup.zmodModule fun x ↦ by
    rcases QuotientGroup.mk_surjective x.toMul with ⟨g, hg⟩
    rw [← ofMul_toMul x, ← ofMul_pow, ← hg, ← QuotientGroup.mk_pow,
      (QuotientGroup.eq_one_iff _).mpr (hG.pow_mem_frattini g), ofMul_one]

/-- **Burnside's basis theorem** (LMFDB `group.rank`): the rank of a finite `p`-group `G`, the least
number of elements generating it, is the dimension over `𝔽_p` of its Frattini quotient
`G ⧸ Φ(G)`. -/
lemma rank_eq_finrank_quotient_frattini (hG : IsPGroup p G) :
    letI : CommGroup (G ⧸ frattini G) := hG.frattiniQuotientCommGroup
    letI : Module (ZMod p) (Additive (G ⧸ frattini G)) := hG.frattiniQuotientModule
    Group.rank G = Module.finrank (ZMod p) (Additive (G ⧸ frattini G)) := by
  let _ : TopologicalSpace G := ⊥
  have _ : DiscreteTopology G := ⟨rfl⟩
  have hfg : IsTopologicallyFinitelyGenerated G := isTopologicallyFinitelyGenerated_of_fg
  rw [← topologicalGeneratorRankNat_eq_rank hfg,
    hG.isProP.topologicalGeneratorRankNat_eq_finrank_quotient_proPFrattini hfg]
  let _ : CommGroup (G ⧸ frattini G) := hG.frattiniQuotientCommGroup
  let _ : Module (ZMod p) (Additive (G ⧸ frattini G)) := hG.frattiniQuotientModule
  let e : Additive (G ⧸ proPFrattini p G) ≃+ Additive (G ⧸ frattini G) :=
    MulEquiv.toAdditive (QuotientGroup.quotientMulEquivOfEq hG.proPFrattini_eq_frattini)
  exact (e.toLinearEquiv (ZMod.map_smul e)).finrank_eq

end IsPGroup

namespace PolycyclicSequence

variable (s : PolycyclicSequence G)

variable [Group.FG G] in
/-- **The rank is at most the number of generators of a polycyclic presentation** (LMFDB
`group.rank`): the terms of a polycyclic sequence generate the group. -/
lemma rank_le_length : Group.rank G ≤ s.length := by
  classical
  refine (Group.rank_le (S := Finset.univ.image s) ?_).trans ?_
  · rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, s.closure_range]
  · exact Finset.card_image_le.trans (Finset.card_fin _).le

lemma commutator_series_le (k : Fin s.length) : ⁅s.series k, s.series k⁆ ≤ s.series (k + 1) := by
  have hle : commutator (s.series k) ≤ (s.series (k + 1)).subgroupOf (s.series k) :=
    Normal.quotient_commutative_iff_commutator_le.mp (s.isCyclic_quotient k).isMulCommutative
  rwa [subgroupOf, ← map_le_iff_le_comap, map_subtype_commutator] at hle

lemma derivedSeries_le_series (i : ℕ) : derivedSeries G i ≤ s.series i := by
  induction i with
  | zero => rw [derivedSeries_zero, s.series_zero]
  | succ i ih =>
    rcases lt_or_ge i s.length with h | h
    · exact (commutator_mono ih ih).trans (s.commutator_series_le ⟨i, h⟩)
    · rw [s.series_of_le (by omega)]
      exact (derivedSeries_antitone G i.le_succ).trans (ih.trans (s.series_of_le h).le)

end PolycyclicSequence

/-- **The rank can be smaller than the number of generators of every polycyclic presentation**
(LMFDB `group.rank`): `S₄` is generated by a `4`-cycle and a transposition, while a polycyclic
sequence of length `n` gives `G⁽ⁿ⁾ = 1` and the second derived subgroup of `S₄` is not trivial. -/
lemma PolycyclicSequence.rank_lt_length_perm_fin_four (s : PolycyclicSequence (Perm (Fin 4))) :
    Group.rank (Perm (Fin 4)) < s.length := by
  have hrank : Group.rank (Perm (Fin 4)) ≤ 2 := by
    classical
    refine (Group.rank_le (S := {finRotate 4, swap 0 (finRotate 4 0)}) ?_).trans Finset.card_le_two
    rw [Finset.coe_insert, Finset.coe_singleton]
    exact closure_cycle_adjacent_swap isCycle_finRotate support_finRotate 0
  refine hrank.trans_lt <| not_le.mp fun hs ↦ ?_
  have h : derivedSeries (Perm (Fin 4)) 2 = ⊥ := le_bot_iff.mp <|
    (derivedSeries_antitone _ hs).trans <| (s.derivedSeries_le_series _).trans <|
      (s.series_of_le le_rfl).le
  have hmem : ⁅⁅swap (0 : Fin 4) 1, swap (1 : Fin 4) 2⁆, ⁅swap (1 : Fin 4) 2, swap (2 : Fin 4) 3⁆⁆ ∈
      derivedSeries (Perm (Fin 4)) 2 :=
    commutator_mem_commutator (commutator_mem_commutator (mem_top _) (mem_top _))
      (commutator_mem_commutator (mem_top _) (mem_top _))
  rw [h, mem_bot] at hmem
  exact absurd hmem (by decide)
