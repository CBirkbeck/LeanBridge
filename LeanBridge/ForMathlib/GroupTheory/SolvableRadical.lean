import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Data.Fintype.Powerset
import Mathlib.GroupTheory.Solvable
import Mathlib.Order.Preorder.Finite

/-!
# The solvable radical of a group

## Main definitions

* `Subgroup.solvableRadical` (LMFDB `group.radical`): the subgroup generated by the normal solvable
  subgroups.

## Main results

* `Subgroup.isSolvable_sup`: the join of a normal solvable subgroup and a solvable subgroup is
  solvable.
* `Subgroup.isSolvable_solvableRadical`: the radical of a finite group is solvable, hence it is the
  largest normal solvable subgroup.
-/

open Group (isSolvable_of_ker_le_range isSolvable_of_surjective)

namespace Subgroup

variable {G : Type*} [Group G]

/-- **The join of a normal solvable subgroup and a solvable subgroup is solvable.** -/
lemma isSolvable_sup (N M : Subgroup G) [N.Normal] [Group.IsSolvable N] [Group.IsSolvable M] :
    Group.IsSolvable (N ⊔ M : Subgroup G) := by
  have hM : Group.IsSolvable (M.map (QuotientGroup.mk' N)) :=
    isSolvable_of_surjective <| (QuotientGroup.mk' N).subgroupMap_surjective M
  refine isSolvable_of_ker_le_range (inclusion le_sup_left)
    (((QuotientGroup.mk' N).comp (N ⊔ M).subtype).codRestrict (M.map (QuotientGroup.mk' N))
      fun x ↦ ?_) ?_
  · have hx : QuotientGroup.mk' N x ∈ (N ⊔ M).map (QuotientGroup.mk' N) := mem_map_of_mem _ x.2
    rwa [map_sup, QuotientGroup.map_mk'_self, bot_sup_eq] at hx
  · intro x hx
    exact ⟨⟨x, (QuotientGroup.eq_one_iff _).mp <| congrArg Subtype.val hx⟩, rfl⟩

variable (G)

/-- The **radical** (LMFDB `group.radical`), or solvable radical, of a group `G`: the subgroup
generated by all normal solvable subgroups of `G`. For a finite group it is the largest normal
solvable subgroup (`Subgroup.isSolvable_solvableRadical`). -/
def solvableRadical : Subgroup G :=
  sSup {N | N.Normal ∧ Group.IsSolvable N}

instance : (solvableRadical G).Normal :=
  sSup_normal _ fun _ h ↦ h.1

variable {G} in
lemma le_solvableRadical {N : Subgroup G} [N.Normal] [Group.IsSolvable N] :
    N ≤ solvableRadical G :=
  le_sSup ⟨inferInstance, inferInstance⟩

/-- **The radical of a finite group is solvable**, hence it is the largest normal solvable
subgroup. -/
lemma isSolvable_solvableRadical [Finite G] : Group.IsSolvable (solvableRadical G) := by
  have : Finite (Subgroup G) := .of_injective _ SetLike.coe_injective
  rcases (Set.toFinite {N : Subgroup G | N.Normal ∧ Group.IsSolvable N}).exists_maximal
    ⟨⊥, inferInstance, inferInstance⟩ with ⟨M, hM⟩
  have h : solvableRadical G = M := by
    refine le_antisymm (sSup_le fun N hN ↦ ?_) (le_sSup hM.1)
    have : N.Normal := hN.1
    have : Group.IsSolvable N := hN.2
    have : M.Normal := hM.1.1
    have : Group.IsSolvable M := hM.1.2
    exact le_sup_left.trans <| hM.2 ⟨inferInstance, isSolvable_sup N M⟩ le_sup_right
  exact h ▸ hM.1.2

end Subgroup
