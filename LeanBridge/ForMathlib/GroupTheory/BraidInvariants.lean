import LeanBridge.ForMathlib.GroupTheory.BraidEquivalence
import Mathlib.Algebra.BigOperators.Group.List.Basic
import Mathlib.Algebra.Group.Conj
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Data.List.OfFn
import Mathlib.Tactic.Group

/-!
# Invariants of the braid operations

The braid operations `Qᵢ : (…, gᵢ, gᵢ₊₁, …) ↦ (…, gᵢ₊₁, gᵢ₊₁⁻¹ gᵢ gᵢ₊₁, …)` on `n`-tuples of
elements of a group `G` preserve the product `g₁ ⋯ gₙ` and the subgroup generated by the entries,
and they permute the conjugacy classes of the entries, by the transposition of `i` and `i + 1`. So
does every element of the group they generate, with some permutation of the entries. Hence the
braid operations act on the generating vectors of `G` (tuples generating `G` with product `1`), and
braid equivalent generating vectors have the same conjugacy classes up to order: the same refined
passport up to the order of its classes (LMFDB `curve.highergenus.aut.braid_equivalence`; the knowl
says "of one refined passport", which holds only up to that reordering, since `Qᵢ` swaps the
classes of the `i`-th and `(i+1)`-st entries).

## Main results

* `Hurwitz.prod_ofFn_braidOperation`, `Hurwitz.prod_ofFn_of_mem_braidOperationGroup`: the braid
  operations preserve the product of the entries.
* `Hurwitz.closure_range_braidOperation`, `Hurwitz.closure_range_of_mem_braidOperationGroup`: they
  preserve the subgroup generated by the entries.
* `Hurwitz.isConj_braidOperation_swap`, `Hurwitz.exists_perm_isConj_of_mem_braidOperationGroup`:
  they permute the conjugacy classes of the entries.
* `Hurwitz.prod_ofFn_eq_of_braidEquivalence`, `Hurwitz.closure_range_eq_of_braidEquivalence`,
  `Hurwitz.exists_perm_isConj_of_braidEquivalence` (LMFDB
  `curve.highergenus.aut.braid_equivalence`): braid equivalent tuples have the same product,
  generate the same subgroup, and have the same conjugacy classes up to order.
-/

namespace Hurwitz

variable {G : Type*} [Group G] {n : ℕ}

lemma prod_set_set (l : List G) (i : ℕ) (h : i + 1 < l.length) {a b : G} (ha : l[i] = a)
    (hb : l[i + 1] = b) : ((l.set i b).set (i + 1) (b⁻¹ * a * b)).prod = l.prod := by
  subst ha hb
  induction l generalizing i with
  | nil => simp at h
  | cons a t ih =>
    rcases i with _ | i
    · rcases t with _ | ⟨b, t⟩
      · simp at h
      simp [mul_assoc]
    · simpa using ih i (by simp at h; omega)

variable (i : Fin (n - 1)) (g : Fin n → G)

lemma ofFn_braidOperation : List.ofFn (braidOperation i g) =
    ((List.ofFn g).set i (g ⟨i + 1, by omega⟩)).set (i + 1)
      ((g ⟨i + 1, by omega⟩)⁻¹ * g ⟨i, by omega⟩ * g ⟨i + 1, by omega⟩) := by
  refine List.ext_getElem (by simp) fun m h₁ h₂ ↦ ?_
  simp [braidOperation, braidMove, Function.update_apply, List.getElem_set, Fin.ext_iff]
  grind

/-- **The braid operation `Qᵢ` preserves the product `g₁ ⋯ gₙ`.** -/
lemma prod_ofFn_braidOperation : (List.ofFn (braidOperation i g)).prod = (List.ofFn g).prod := by
  rw [ofFn_braidOperation]
  exact prod_set_set (List.ofFn g) i (by simp; omega) (by simp) (by simp)

lemma braidOperation_apply_left : braidOperation i g ⟨i, by omega⟩ = g ⟨i + 1, by omega⟩ :=
  braidMove_apply_left ..

lemma braidOperation_apply_right : braidOperation i g ⟨i + 1, by omega⟩ =
    (g ⟨i + 1, by omega⟩)⁻¹ * g ⟨i, by omega⟩ * g ⟨i + 1, by omega⟩ :=
  braidMove_apply_right ..

lemma braidOperation_apply_of_ne {m : Fin n} (h₁ : (m : ℕ) ≠ i) (h₂ : (m : ℕ) ≠ i + 1) :
    braidOperation i g m = g m :=
  braidMove_apply_of_ne G _ g (by simpa [Fin.ext_iff] using h₁) (by simpa [Fin.ext_iff] using h₂)

/-- **The braid operation `Qᵢ` preserves the subgroup generated by the entries.** -/
lemma closure_range_braidOperation :
    Subgroup.closure (Set.range (braidOperation i g)) = Subgroup.closure (Set.range g) := by
  have hl : g ⟨i, by omega⟩ = braidOperation i g ⟨i, by omega⟩ *
      braidOperation i g ⟨i + 1, by omega⟩ * (braidOperation i g ⟨i, by omega⟩)⁻¹ := by
    rw [braidOperation_apply_left, braidOperation_apply_right]
    group
  refine le_antisymm (Subgroup.closure_le _ |>.mpr ?_) (Subgroup.closure_le _ |>.mpr ?_)
  · rintro _ ⟨m, rfl⟩
    by_cases h₁ : (m : ℕ) = i
    · rw [show m = ⟨i, by omega⟩ from Fin.ext h₁, braidOperation_apply_left]
      exact Subgroup.subset_closure ⟨_, rfl⟩
    by_cases h₂ : (m : ℕ) = i + 1
    · rw [show m = ⟨i + 1, by omega⟩ from Fin.ext h₂, braidOperation_apply_right]
      exact mul_mem (mul_mem (inv_mem (Subgroup.subset_closure ⟨_, rfl⟩))
        (Subgroup.subset_closure ⟨_, rfl⟩)) (Subgroup.subset_closure ⟨_, rfl⟩)
    rw [braidOperation_apply_of_ne i g h₁ h₂]
    exact Subgroup.subset_closure ⟨_, rfl⟩
  · rintro _ ⟨m, rfl⟩
    by_cases h₁ : (m : ℕ) = i
    · rw [show m = ⟨i, by omega⟩ from Fin.ext h₁, hl]
      exact mul_mem (mul_mem (Subgroup.subset_closure ⟨_, rfl⟩) (Subgroup.subset_closure ⟨_, rfl⟩))
        (inv_mem (Subgroup.subset_closure ⟨_, rfl⟩))
    by_cases h₂ : (m : ℕ) = i + 1
    · rw [show m = ⟨i + 1, by omega⟩ from Fin.ext h₂, ← braidOperation_apply_left i g]
      exact Subgroup.subset_closure ⟨_, rfl⟩
    rw [← braidOperation_apply_of_ne i g h₁ h₂]
    exact Subgroup.subset_closure ⟨_, rfl⟩

/-- **The braid operation `Qᵢ` swaps the conjugacy classes of the `i`-th and `(i+1)`-st
entries**: the `m`-th entry of `g` is conjugate to the `σ(m)`-th entry of `Qᵢ(g)`, for `σ` the
transposition of `i` and `i + 1`. -/
lemma isConj_braidOperation_swap (m : Fin n) :
    IsConj (g m) (braidOperation i g (Equiv.swap ⟨i, by omega⟩ ⟨i + 1, by omega⟩ m)) := by
  by_cases h₁ : (m : ℕ) = i
  · rw [show m = ⟨i, by omega⟩ from Fin.ext h₁, Equiv.swap_apply_left,
      braidOperation_apply_right]
    exact isConj_iff.mpr ⟨(g ⟨i + 1, by omega⟩)⁻¹, by group⟩
  by_cases h₂ : (m : ℕ) = i + 1
  · rw [show m = ⟨i + 1, by omega⟩ from Fin.ext h₂, Equiv.swap_apply_right,
      braidOperation_apply_left]
  rw [Equiv.swap_apply_of_ne_of_ne (by simpa [Fin.ext_iff] using h₁)
    (by simpa [Fin.ext_iff] using h₂), braidOperation_apply_of_ne i g h₁ h₂]

variable {σ : Equiv.Perm (Fin n → G)}

lemma mem_braidOperationGroup_induction {P : Equiv.Perm (Fin n → G) → Prop}
    (hQ : ∀ i, P (braidOperation i)) (h₁ : P 1) (hmul : ∀ σ τ, P σ → P τ → P (σ * τ))
    (hinv : ∀ σ, P σ → P σ⁻¹) (hσ : σ ∈ braidOperationGroup G) : P σ :=
  Subgroup.closure_induction (by rintro _ ⟨i, rfl⟩; exact hQ i) h₁
    (fun σ τ _ _ ↦ hmul σ τ) (fun σ _ ↦ hinv σ) hσ

/-- **Every element of the braid operation group preserves the product `g₁ ⋯ gₙ`.** -/
lemma prod_ofFn_of_mem_braidOperationGroup (hσ : σ ∈ braidOperationGroup G) :
    (List.ofFn (σ g)).prod = (List.ofFn g).prod := by
  refine mem_braidOperationGroup_induction (P := fun σ ↦ ∀ g : Fin n → G,
    (List.ofFn (σ g)).prod = (List.ofFn g).prod) prod_ofFn_braidOperation (fun _ ↦ rfl)
    (fun σ τ hσ hτ g ↦ (hσ (τ g)).trans (hτ g)) (fun σ hσ g ↦ ?_) hσ g
  simpa using (hσ (σ⁻¹ g)).symm

/-- **Every element of the braid operation group preserves the subgroup generated by the
entries.** -/
lemma closure_range_of_mem_braidOperationGroup (hσ : σ ∈ braidOperationGroup G) :
    Subgroup.closure (Set.range (σ g)) = Subgroup.closure (Set.range g) := by
  refine mem_braidOperationGroup_induction (P := fun σ ↦ ∀ g : Fin n → G,
    Subgroup.closure (Set.range (σ g)) = Subgroup.closure (Set.range g))
    closure_range_braidOperation (fun _ ↦ rfl) (fun σ τ hσ hτ g ↦ (hσ (τ g)).trans (hτ g))
    (fun σ hσ g ↦ ?_) hσ g
  simpa using (hσ (σ⁻¹ g)).symm

/-- **Every element of the braid operation group permutes the conjugacy classes of the
entries.** -/
lemma exists_perm_isConj_of_mem_braidOperationGroup (hσ : σ ∈ braidOperationGroup G) :
    ∃ π : Equiv.Perm (Fin n), ∀ m, IsConj (g m) (σ g (π m)) := by
  refine mem_braidOperationGroup_induction (P := fun σ ↦ ∀ g : Fin n → G,
    ∃ π : Equiv.Perm (Fin n), ∀ m, IsConj (g m) (σ g (π m)))
    (fun i g ↦ ⟨_, isConj_braidOperation_swap i g⟩) (fun _ ↦ ⟨1, fun _ ↦ IsConj.refl _⟩)
    (fun σ τ hσ hτ g ↦ ?_) (fun σ hσ g ↦ ?_) hσ g
  · rcases hτ g with ⟨π, hπ⟩
    rcases hσ (τ g) with ⟨π', hπ'⟩
    exact ⟨π' * π, fun m ↦ (hπ m).trans (hπ' (π m))⟩
  · rcases hσ (σ⁻¹ g) with ⟨π, hπ⟩
    refine ⟨π⁻¹, fun m ↦ ?_⟩
    simpa using (hπ (π⁻¹ m)).symm

variable {g} {h : Fin n → G}

/-- **Braid equivalent tuples have the same product** (LMFDB
`curve.highergenus.aut.braid_equivalence`). -/
lemma prod_ofFn_eq_of_braidEquivalence (hgh : (braidEquivalence G).r g h) :
    (List.ofFn g).prod = (List.ofFn h).prod := by
  rcases hgh with ⟨⟨σ, hσ⟩, rfl⟩
  exact prod_ofFn_of_mem_braidOperationGroup h hσ

/-- **Braid equivalent tuples generate the same subgroup** (LMFDB
`curve.highergenus.aut.braid_equivalence`). -/
lemma closure_range_eq_of_braidEquivalence (hgh : (braidEquivalence G).r g h) :
    Subgroup.closure (Set.range g) = Subgroup.closure (Set.range h) := by
  rcases hgh with ⟨⟨σ, hσ⟩, rfl⟩
  exact closure_range_of_mem_braidOperationGroup h hσ

/-- **Braid equivalent tuples have the same conjugacy classes up to order** (LMFDB
`curve.highergenus.aut.braid_equivalence`), hence the same refined passport up to the order of its
classes. -/
lemma exists_perm_isConj_of_braidEquivalence (hgh : (braidEquivalence G).r g h) :
    ∃ π : Equiv.Perm (Fin n), ∀ m, IsConj (h m) (g (π m)) := by
  rcases hgh with ⟨⟨σ, hσ⟩, rfl⟩
  exact exists_perm_isConj_of_mem_braidOperationGroup h hσ

end Hurwitz
