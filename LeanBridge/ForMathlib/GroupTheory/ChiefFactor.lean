import LeanBridge.ForMathlib.GroupTheory.ChiefSeriesJordanHolder
import Mathlib.GroupTheory.GroupAction.ConjAct
import Mathlib.GroupTheory.NoncommPiCoprod

/-!
# Chief factors and composition factors

The factors `Nᵢ₊₁ / Nᵢ` of a chief series of a finite group (LMFDB `group.chief_series`) are each
isomorphic to a product `S × ⋯ × S` of copies of a single simple group `S`. A chief factor is
isomorphic to the minimal normal subgroup `Nᵢ₊₁ / Nᵢ` of `G / Nᵢ`, so this is the statement that a
minimal normal subgroup `N` of a finite group `G` is a power of a simple group.

The proof is the classical one. Let `S` be a minimal normal subgroup of `N`. Its conjugates under
`G` are minimal normal subgroups of `N` and generate a subgroup normal in `G`, hence all of `N`.
Among the sets of conjugates generating `N`, a minimal one `J` is independent: a conjugate `U ∈ J`
meets the subgroup generated by the others in a normal subgroup of `N` contained in `U`, which is
trivial by minimality of `J`. So `N` is the internal direct product of the conjugates in `J`, each
isomorphic to `S`. Finally `S` is simple: a normal subgroup of `U ∈ J` is normalised by `U` and
centralised by the other factors, so it is normal in `N`, hence trivial or `U`.

The simple groups `Sᵢ`, with the multiplicities `kᵢ`, of the chief factors `Sᵢ ^ kᵢ` are the
composition factors of `G`. We record them as the multiplicity of each simple group `T` read off a
chief series, the number of copies of `T` in the chief factors that are powers of `T` (and `0` for a
group `T` that is not simple). A chief factor `Sᵢ ^ kᵢ` is a power `T ^ k` of a simple group `T`
only for `T ≅ Sᵢ` and `k = kᵢ`: a simple quotient of `Sᵢ ^ kᵢ` is isomorphic to `Sᵢ`, and `k` is
determined by counting. So the multiplicity of a simple group `T` is the sum of the `kᵢ` with
`Sᵢ ≅ T`, and by the Jordan–Hölder theorem for chief series it does not depend on the chief series,
which exists for every finite group.

## Main definitions

* `Subgroup.NormalSeries.compositionFactorMultiplicity` (LMFDB `group.chief_series`): the
  multiplicity of a group among the composition factors, read off a chief series.

## Main results

* `IsSimpleGroup.nonempty_mulEquiv_of_surjective_pi`: a simple quotient of a power of a simple group
  `S` is isomorphic to `S`.
* `Subgroup.NormalSeries.IsChief.compositionFactorMultiplicity_eq` (LMFDB `group.chief_series`):
  the composition factors do not depend on the chief series.
* `Subgroup.NormalSeries.IsChief.compositionFactorMultiplicity_eq_sum` (LMFDB
  `group.chief_series`): the composition factors are the simple groups `Sᵢ` of the chief factors
  `Sᵢ ^ kᵢ`, with multiplicities `kᵢ`.
* `Subgroup.NormalSeries.exists_isChief` (LMFDB `group.chief_series`): a finite group has a chief
  series.
* `Subgroup.IsMinimalNormal.exists_isSimpleGroup_mulEquiv_pi`: a minimal normal subgroup of a
  finite group is isomorphic to `S ^ k` for a simple group `S`.
* `Subgroup.NormalSeries.IsChief.exists_isSimpleGroup_mulEquiv_pi` (LMFDB `group.chief_series`):
  the chief factors of a finite group are powers of simple groups.
-/

namespace IsSimpleGroup

variable {S T : Type*} [Group S] [Group T] {k : ℕ}

lemma mul_mulSingle_mul_inv (f : Fin k → S) (i : Fin k) (s : S) :
    f * Pi.mulSingle i s * f⁻¹ = Pi.mulSingle i (f i * s * (f i)⁻¹) := by
  funext j
  by_cases h : j = i
  · subst h
    simp
  · simp [Pi.mulSingle_eq_of_ne h]

variable [IsSimpleGroup S] [IsSimpleGroup T]

/-- **A simple quotient of a power of a simple group `S` is isomorphic to `S`**: some coordinate
copy of `S` is not killed by the quotient map, so it maps injectively, and onto a nontrivial
normal subgroup of the simple quotient. -/
lemma nonempty_mulEquiv_of_surjective_pi (φ : (Fin k → S) →* T) (hφ : Function.Surjective φ) :
    Nonempty (S ≃* T) := by
  classical
  have hi : ∃ i, φ.comp (MonoidHom.mulSingle (fun _ ↦ S) i) ≠ 1 := by
    refine not_forall_not.mp fun h ↦ ?_
    have hφ1 : φ = 1 := MonoidHom.pi_ext fun i x ↦ by
      simpa using DFunLike.congr_fun (not_ne_iff.mp (h i)) x
    rcases exists_ne (1 : T) with ⟨t, ht⟩
    rcases hφ t with ⟨f, hf⟩
    rw [hφ1] at hf
    exact ht hf.symm
  rcases hi with ⟨i, hi⟩
  have hinj : Function.Injective (φ.comp (MonoidHom.mulSingle (fun _ ↦ S) i)) := by
    rcases eq_bot_or_eq_top_of_normal (φ.comp (MonoidHom.mulSingle (fun _ ↦ S) i)).ker with h | h
    · exact (MonoidHom.ker_eq_bot_iff _).mp h
    · exact absurd (MonoidHom.ker_eq_top_iff.mp h) hi
  have hn : (φ.comp (MonoidHom.mulSingle (fun _ ↦ S) i)).range.Normal := by
    refine ⟨fun x ⟨s, hs⟩ t ↦ ?_⟩
    rcases hφ t with ⟨f, rfl⟩
    refine ⟨f i * s * (f i)⁻¹, ?_⟩
    simp only [MonoidHom.coe_comp, Function.comp_apply, MonoidHom.mulSingle_apply] at hs ⊢
    rw [← mul_mulSingle_mul_inv, map_mul, map_mul, map_inv, hs]
  rcases eq_bot_or_eq_top_of_normal (φ.comp (MonoidHom.mulSingle (fun _ ↦ S) i)).range with h | h
  · exact absurd (MonoidHom.range_eq_bot_iff.mp h) hi
  · exact ⟨MulEquiv.ofBijective _ ⟨hinj, MonoidHom.range_eq_top.mp h⟩⟩

end IsSimpleGroup

namespace Subgroup

variable {G K : Type*} [Group G] [Group K]

lemma IsMinimalNormal.map_mulEquiv {S : Subgroup K} (hS : S.IsMinimalNormal) (e : K ≃* K) :
    (S.map e.toMonoidHom).IsMinimalNormal := by
  rcases (isMinimalNormal_iff S).mp hS with ⟨hn, hne, h⟩
  refine (isMinimalNormal_iff _).mpr ⟨hn.map _ e.surjective,
    (map_eq_bot_iff_of_injective _ e.injective).not.mpr hne, fun U hU hUS ↦ ?_⟩
  have hU' : U.map e.symm.toMonoidHom ≤ S := by
    rw [map_le_iff_le_comap]
    intro u hu
    rcases hUS hu with ⟨s, hs, rfl⟩
    simpa using hs
  rcases h _ (hU.map _ e.symm.surjective) hU' with h' | h'
  · left
    rwa [map_eq_bot_iff_of_injective _ e.symm.injective] at h'
  · right
    rw [← h', map_map]
    simp

variable {N : Subgroup G}

lemma IsMinimalNormal.iSup_map_conjNormal [N.Normal] (hN : N.IsMinimalNormal) {S : Subgroup N}
    (hS : S ≠ ⊥) : ⨆ g : G, S.map (MulAut.conjNormal g).toMonoidHom = ⊤ := by
  have hinv (g : G) (p : N) (hp : p ∈ ⨆ g : G, S.map (MulAut.conjNormal g).toMonoidHom) :
      MulAut.conjNormal g p ∈ ⨆ g : G, S.map (MulAut.conjNormal g).toMonoidHom := by
    refine iSup_induction _ (C := fun p ↦ MulAut.conjNormal g p ∈ _) hp (fun g' p hp ↦ ?_)
      (by simp) fun p q hp hq ↦ by simpa using mul_mem hp hq
    rcases hp with ⟨s, hs, rfl⟩
    refine mem_iSup_of_mem (g * g') ⟨s, hs, ?_⟩
    simp
  have hP : ((⨆ g : G, S.map (MulAut.conjNormal g).toMonoidHom).map N.subtype).Normal :=
    ⟨fun x ⟨p, hp, hx⟩ g ↦ ⟨MulAut.conjNormal g p, hinv g p hp, by simp [← hx]⟩⟩
  have hle : S ≤ ⨆ g : G, S.map (MulAut.conjNormal g).toMonoidHom :=
    le_iSup_of_le 1 fun s hs ↦ ⟨s, hs, by simp⟩
  rcases (isMinimalNormal_iff N).mp hN |>.2.2 _ hP (map_subtype_le _) with h | h
  · rw [map_eq_bot_iff_of_injective _ N.subtype_injective] at h
    exact absurd (eq_bot_iff.mpr (h ▸ hle)) hS
  · refine map_injective N.subtype_injective ?_
    rw [h, ← MonoidHom.range_eq_map, range_subtype]

lemma isSimpleGroup_of_isMinimalNormal_of_sup_eq_top {U C : Subgroup K} (hU : U.IsMinimalNormal)
    (hC : C.Normal) (hUC : Disjoint U C) (hsup : U ⊔ C = ⊤) : IsSimpleGroup U := by
  have : Nontrivial U := (nontrivial_iff_ne_bot U).mpr hU.prop.2
  refine { eq_bot_or_eq_top_of_normal := fun A hA ↦ ?_ }
  have hcomm (x y : K) (hx : x ∈ U) (hy : y ∈ C) : y * x * y⁻¹ = x := by
    rw [← (commute_of_normal_of_disjoint U C hU.prop.1 hC hUC x y hx hy).eq, mul_inv_cancel_right]
  have hUle : U ≤ normalizer (A.map U.subtype : Set K) := by
    have h : (normalizer (A : Set U)).map U.subtype ≤ normalizer (A.map U.subtype : Set K) :=
      le_normalizer_map U.subtype
    rwa [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype] at h
  have hCle : C ≤ normalizer (A.map U.subtype : Set K) := fun c hc ↦
    mem_normalizer_iff.mpr fun a ↦ ⟨fun ha ↦ (hcomm a c (map_subtype_le A ha) hc).symm ▸ ha,
      fun ha ↦ by
        have h : c⁻¹ * (c * a * c⁻¹) * c⁻¹⁻¹ = c * a * c⁻¹ :=
          hcomm (c * a * c⁻¹) c⁻¹ (map_subtype_le A ha) (inv_mem hc)
        rw [inv_inv, mul_assoc, mul_assoc, inv_mul_cancel, mul_one, ← mul_assoc,
          inv_mul_cancel, one_mul] at h
        exact h ▸ ha⟩
  have hn : (A.map U.subtype).Normal :=
    normalizer_eq_top_iff.mp (eq_top_iff.mpr (hsup ▸ sup_le hUle hCle))
  rcases (isMinimalNormal_iff U).mp hU |>.2.2 _ hn (map_subtype_le A) with h | h
  · exact .inl ((map_eq_bot_iff_of_injective _ U.subtype_injective).mp h)
  · refine .inr (map_injective U.subtype_injective ?_)
    rw [h, ← MonoidHom.range_eq_map, range_subtype]

open scoped Classical in
lemma dite_find_eq_of_mulEquiv {F F' T : Type*} [Group F] [Group F'] [Group T] (e : F ≃* F') :
    (if h : ∃ k, Nonempty (F ≃* (Fin k → T)) then Nat.find h else 0) =
      if h : ∃ k, Nonempty (F' ≃* (Fin k → T)) then Nat.find h else 0 := by
  have hk (k : ℕ) : Nonempty (F ≃* (Fin k → T)) ↔ Nonempty (F' ≃* (Fin k → T)) :=
    ⟨fun ⟨f⟩ ↦ ⟨e.symm.trans f⟩, fun ⟨f⟩ ↦ ⟨e.trans f⟩⟩
  by_cases h : ∃ k, Nonempty (F ≃* (Fin k → T))
  · rw [dite_eq_left h, dite_eq_left (h.imp fun k ↦ (hk k).mp)]
    exact le_antisymm (Nat.find_mono fun k ↦ (hk k).mpr) (Nat.find_mono fun k ↦ (hk k).mp)
  · rw [dite_eq_right h, dite_eq_right fun h' ↦ h (h'.imp fun k ↦ (hk k).mpr)]

namespace NormalSeries

variable {s s₁ s₂ : NormalSeries G} (T : Type*) [Group T]

open scoped Classical in
variable (s) in
/-- The **multiplicity of a group `T` among the composition factors** of `G` (LMFDB
`group.chief_series`), read off a chief series `s`: `0` if `T` is not simple, and otherwise the sum,
over the chief factors `Fᵢ = Nᵢ₊₁ / Nᵢ`, of the number `k` of copies of `T` with `Fᵢ ≅ T ^ k` (the
least such `k`, and `0` when there is none). Each chief factor of a finite group is `Sᵢ ^ kᵢ` for a
simple group `Sᵢ` (`Subgroup.NormalSeries.IsChief.exists_isSimpleGroup_mulEquiv_pi`), and for a
finite simple `T` this multiplicity is the sum of the `kᵢ` with `Sᵢ ≅ T`
(`Subgroup.NormalSeries.IsChief.compositionFactorMultiplicity_eq_sum`): the composition factors of
`G` are the `Sᵢ`, with multiplicities `kᵢ`. It does not depend on the chief series
(`Subgroup.NormalSeries.IsChief.compositionFactorMultiplicity_eq`). -/
noncomputable def compositionFactorMultiplicity : ℕ :=
  if IsSimpleGroup T then
    ∑ i, if h : ∃ k, Nonempty (s.factor i ≃* (Fin k → T)) then Nat.find h else 0
  else 0

/-- **The composition factors do not depend on the chief series** (LMFDB `group.chief_series`):
two chief series give every group the same multiplicity, their factors being isomorphic up to a
permutation by the Jordan–Hölder theorem. -/
lemma IsChief.compositionFactorMultiplicity_eq (h₁ : s₁.IsChief) (h₂ : s₂.IsChief) :
    s₁.compositionFactorMultiplicity T = s₂.compositionFactorMultiplicity T := by
  rcases h₁.exists_equiv_nonempty_mulEquiv_factor h₂ with ⟨e, he⟩
  rw [compositionFactorMultiplicity, compositionFactorMultiplicity]
  congr 1
  exact Fintype.sum_equiv e _ _ fun i ↦ dite_find_eq_of_mulEquiv (he i).some

lemma IsChief.nontrivial_factor (hs : s.IsChief) (i : Fin s.length) : Nontrivial (s.factor i) := by
  have h : ¬s i.succ ≤ s i.castSucc := fun h ↦ (hs i).prop.2 <| by
    rw [map_eq_bot_iff, QuotientGroup.ker_mk']
    exact h
  rcases IsConcreteLE.not_le_iff_exists.mp h with ⟨x, hx, hxN⟩
  refine nontrivial_of_ne (QuotientGroup.mk ⟨x, hx⟩ : s.factor i) 1 fun h' ↦ hxN ?_
  rw [QuotientGroup.eq_one_iff, mem_subgroupOf] at h'
  exact h'

open scoped Classical in
variable [IsSimpleGroup T] [Finite T] in
/-- **The composition factors are the simple groups of the chief factors, with multiplicities**
(LMFDB `group.chief_series`): if the chief factors of `G` are `Fᵢ ≅ Sᵢ ^ kᵢ` with `Sᵢ` simple, then
the multiplicity of a finite simple group `T` among the composition factors is the sum of the `kᵢ`
with `Sᵢ ≅ T`. A power `T ^ k` is isomorphic to `Fᵢ` only for `T ≅ Sᵢ`, a simple quotient of
`Sᵢ ^ kᵢ` being isomorphic to `Sᵢ`, and then only for `k = kᵢ`, by counting. -/
lemma IsChief.compositionFactorMultiplicity_eq_sum (hs : s.IsChief) {S : Fin s.length → Type*}
    [∀ i, Group (S i)] [∀ i, IsSimpleGroup (S i)] {k : Fin s.length → ℕ}
    (e : ∀ i, s.factor i ≃* (Fin (k i) → S i)) :
    s.compositionFactorMultiplicity T = ∑ i, if Nonempty (S i ≃* T) then k i else 0 := by
  rw [compositionFactorMultiplicity, ite_eq_left (inferInstance : IsSimpleGroup T)]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  have : Nontrivial (s.factor i) := hs.nontrivial_factor i
  have hcard (m : ℕ) (f : s.factor i ≃* (Fin m → T)) : Nat.card (s.factor i) = Nat.card T ^ m := by
    rw [Nat.card_congr f.toEquiv, Nat.card_fun, Nat.card_eq_fintype_card (α := Fin m),
      Fintype.card_fin]
  by_cases hST : Nonempty (S i ≃* T)
  · rcases hST with ⟨σ⟩
    have hk : ∃ m, Nonempty (s.factor i ≃* (Fin m → T)) :=
      ⟨k i, ⟨(e i).trans (MulEquiv.arrowCongr (Equiv.refl _) σ)⟩⟩
    rw [dite_eq_left hk, ite_eq_left ⟨σ⟩, Nat.find_eq_iff]
    refine ⟨⟨(e i).trans (MulEquiv.arrowCongr (Equiv.refl _) σ)⟩, fun m hm ⟨f⟩ ↦ hm.ne ?_⟩
    exact Nat.pow_right_injective Finite.one_lt_card <| (hcard m f).symm.trans <|
      hcard (k i) ((e i).trans (MulEquiv.arrowCongr (Equiv.refl _) σ))
  · rw [ite_eq_right hST, dite_eq_right]
    rintro ⟨m, ⟨f⟩⟩
    rcases m with _ | m
    · exact not_subsingleton (s.factor i) f.toEquiv.subsingleton
    · refine hST <| IsSimpleGroup.nonempty_mulEquiv_of_surjective_pi
        ((Pi.evalMonoidHom (fun _ ↦ T) 0).comp ((e i).symm.trans f).toMonoidHom) fun t ↦
          ⟨((e i).symm.trans f).symm fun _ ↦ t, ?_⟩
      simp

end NormalSeries

namespace NormalLattice

instance : BoundedOrder (NormalLattice G) :=
  Subtype.boundedOrder normal_bot normal_top

lemma isMinimalNormal_map_of_covBy {N M : NormalLattice G} (h : N ⋖ M) :
    (M.1.map (QuotientGroup.mk' N.1)).IsMinimalNormal := by
  refine (isMinimalNormal_iff _).mpr ⟨M.2.map _ (QuotientGroup.mk'_surjective _), fun h' ↦
    h.lt.not_ge ?_, fun K hK hKM ↦ ?_⟩
  · rw [map_eq_bot_iff, QuotientGroup.ker_mk'] at h'
    exact h'
  · by_cases hK1 : K = ⊥
    · exact .inl hK1
    · refine .inr ?_
      have hNL : N.1 ≤ K.comap (QuotientGroup.mk' N.1) := fun x hx ↦ by
        rw [mem_comap, QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff x).mpr hx]
        exact one_mem K
      have hNM : N.1 ≤ M.1 := h.le
      have hLM : K.comap (QuotientGroup.mk' N.1) ≤ M.1 := by
        have h' : K.comap (QuotientGroup.mk' N.1) ≤
            (M.1.map (QuotientGroup.mk' N.1)).comap (QuotientGroup.mk' N.1) :=
          comap_mono hKM
        rwa [comap_map_eq, QuotientGroup.ker_mk', sup_eq_left.mpr hNM] at h'
      have hlt : N < ⟨K.comap (QuotientGroup.mk' N.1), hK.comap _⟩ := by
        refine lt_of_le_of_ne hNL fun hN ↦ hK1 ?_
        have hN' : N.1 = K.comap (QuotientGroup.mk' N.1) := congrArg Subtype.val hN
        rw [← map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective N.1) K, ← hN']
        exact QuotientGroup.map_mk'_self _
      have hLM'' : (⟨K.comap (QuotientGroup.mk' N.1), hK.comap _⟩ : NormalLattice G) ≤ M := hLM
      have hLM' : K.comap (QuotientGroup.mk' N.1) = M.1 :=
        congrArg Subtype.val <| (lt_or_eq_of_le hLM'').resolve_left (h.2 hlt)
      rw [← map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective N.1) K, hLM']

end NormalLattice

/-- **A finite group has a chief series** (LMFDB `group.chief_series`): a maximal chain of normal
subgroups from `⊥` to `⊤`, which exists in the finite lattice of normal subgroups. -/
lemma NormalSeries.exists_isChief [Finite G] : ∃ s : NormalSeries G, s.IsChief := by
  have : Finite (Subgroup G) := Finite.of_injective _ SetLike.coe_injective
  have : Finite (NormalLattice G) := Subtype.finite
  rcases LTSeries.exists_relSeries_covBy_and_head_eq_bot_and_last_eq_bot
    (RelSeries.singleton _ (⊥ : NormalLattice G)) with ⟨t, -, -, h₀, h₁⟩
  exact ⟨NormalSeries.ofLE ⟨t.length, fun i ↦ (t i).1, fun i ↦ (t.step i).le⟩ (fun i ↦ (t i).2)
    (congrArg Subtype.val h₀) (congrArg Subtype.val h₁),
    fun i ↦ NormalLattice.isMinimalNormal_map_of_covBy (t.step i)⟩

variable [Finite G]

/-- **A minimal normal subgroup of a finite group is a power of a simple group**: it is the
internal direct product of conjugates of a minimal normal subgroup `S` of `N`, which is simple. -/
lemma IsMinimalNormal.exists_isSimpleGroup_mulEquiv_pi (hN : N.IsMinimalNormal) :
    ∃ (S : Subgroup N) (k : ℕ), IsSimpleGroup S ∧ Nonempty (N ≃* (Fin k → S)) := by
  classical
  have : N.Normal := hN.prop.1
  have : Nontrivial N := (nontrivial_iff_ne_bot N).mpr hN.prop.2
  have : Finite (Subgroup N) := Finite.of_injective _ SetLike.coe_injective
  rcases exists_minimal_le_of_wellFoundedLT (fun T : Subgroup N ↦ T.Normal ∧ T ≠ ⊥) ⊤
    ⟨normal_top, top_ne_bot⟩ with ⟨S, -, hS⟩
  rcases exists_minimal_le_of_wellFoundedLT (fun J : Set (Subgroup N) ↦
      J ⊆ Set.range (fun g : G ↦ S.map (MulAut.conjNormal g).toMonoidHom) ∧ sSup J = ⊤)
    (Set.range fun g : G ↦ S.map (MulAut.conjNormal g).toMonoidHom)
    ⟨subset_rfl, by rw [sSup_range]; exact hN.iSup_map_conjNormal hS.prop.2⟩ with ⟨J, -, hJ⟩
  have hJmin (U : Subgroup N) (hU : U ∈ J) : U.IsMinimalNormal := by
    rcases hJ.prop.1 hU with ⟨g, rfl⟩
    exact IsMinimalNormal.map_mulEquiv hS _
  have hJsup (U : Subgroup N) (hU : U ∈ J) : U ⊔ sSup (J \ {U}) = ⊤ := by
    rw [← sSup_insert, Set.insert_sdiff_singleton, Set.insert_eq_of_mem hU, hJ.prop.2]
  have hCn (U : Subgroup N) : (sSup (J \ {U})).Normal :=
    sSup_normal _ fun V hV ↦ (hJmin V hV.1).prop.1
  have hind : sSupIndep J := by
    intro U hU
    have : U.Normal := (hJmin U hU).prop.1
    have : (sSup (J \ {U})).Normal := hCn U
    rcases (isMinimalNormal_iff U).mp (hJmin U hU) |>.2.2 _
      (normal_inf_normal U (sSup (J \ {U}))) inf_le_left with h | h
    · exact disjoint_iff.mpr h
    · have htop : sSup (J \ {U}) = ⊤ := by
        rw [← hJsup U hU, sup_eq_right.mpr (inf_eq_left.mp h)]
      have hJU : J \ {U} = J :=
        hJ.eq_of_le ⟨Set.sdiff_subset.trans hJ.prop.1, htop⟩ Set.sdiff_subset
      rw [← hJU] at hU
      exact absurd rfl hU.2
  have hJne : J.Nonempty := Set.nonempty_iff_ne_empty.mpr fun h ↦
    top_ne_bot <| hJ.prop.2.symm.trans <| by rw [h, sSup_empty]
  rcases hJne with ⟨U₀, hU₀⟩
  have he (U : J) : Nonempty (S ≃* (U : Subgroup N)) := by
    rcases hJ.prop.1 U.2 with ⟨g, hg⟩
    exact ⟨(S.equivMapOfInjective _ (MulAut.conjNormal g).injective).trans
      (MulEquiv.subgroupCongr hg)⟩
  have hU₀s : IsSimpleGroup U₀ := isSimpleGroup_of_isMinimalNormal_of_sup_eq_top (hJmin U₀ hU₀)
    (hCn U₀) (hind hU₀) (hJsup U₀ hU₀)
  let _ : Fintype J := (Set.toFinite J).fintype
  have hcomm : Pairwise fun U V : J ↦
      ∀ x y : N, x ∈ (U : Subgroup N) → y ∈ (V : Subgroup N) → Commute x y :=
    fun U V hUV ↦ commute_of_normal_of_disjoint _ _ (hJmin U U.2).prop.1 (hJmin V V.2).prop.1
      (hind.pairwiseDisjoint U.2 V.2 (Subtype.coe_injective.ne hUV))
  have hbij : Function.Bijective (noncommPiCoprod hcomm) := by
    refine ⟨injective_noncommPiCoprod_of_iSupIndep ((sSupIndep_iff J).mp hind), ?_⟩
    rw [← MonoidHom.range_eq_top, noncommPiCoprod_range, ← sSup_eq_iSup', hJ.prop.2]
  exact ⟨S, Fintype.card J, (he ⟨U₀, hU₀⟩).some.isSimpleGroup,
    ⟨(MulEquiv.ofBijective _ hbij).symm.trans <|
      (MulEquiv.piCongrRight fun U ↦ (he U).some.symm).trans <|
        MulEquiv.arrowCongr (Fintype.equivFin J) (MulEquiv.refl S)⟩⟩

namespace NormalSeries

variable {s : NormalSeries G}

/-- **The chief factors of a finite group are powers of simple groups** (LMFDB
`group.chief_series`): each factor `Nᵢ₊₁ / Nᵢ` of a chief series is isomorphic to `S ^ k` for a
simple group `S`, being isomorphic to the minimal normal subgroup `Nᵢ₊₁ / Nᵢ` of `G / Nᵢ`. -/
lemma IsChief.exists_isSimpleGroup_mulEquiv_pi (hs : s.IsChief) (i : Fin s.length) :
    ∃ (S : Subgroup ((s i.succ).map (QuotientGroup.mk' (s i.castSucc)))) (k : ℕ),
      IsSimpleGroup S ∧ Nonempty (s.factor i ≃* (Fin k → S)) := by
  rcases (hs i).exists_isSimpleGroup_mulEquiv_pi with ⟨S, k, hS, ⟨e⟩⟩
  let f : s i.succ →* G ⧸ s i.castSucc :=
    (QuotientGroup.mk' (s i.castSucc)).comp (s i.succ).subtype
  have hker : f.ker = (s i.castSucc).subgroupOf (s i.succ) := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
    rfl
  have hrange : f.range = (s i.succ).map (QuotientGroup.mk' (s i.castSucc)) := by
    rw [MonoidHom.range_comp, range_subtype]
  exact ⟨S, k, hS, ⟨(QuotientGroup.quotientMulEquivOfEq hker.symm).trans <|
    (QuotientGroup.quotientKerEquivRange f).trans <| (MulEquiv.subgroupCongr hrange).trans e⟩⟩

end NormalSeries

end Subgroup
