import Mathlib.Algebra.Group.Action.End
import Mathlib.Algebra.Group.Subgroup.Actions
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.GroupTheory.GroupAction.Defs
import Mathlib.GroupTheory.Perm.Basic

/-!
# Braid operations and braid equivalence

For a group `G`, the braid operations on `n`-tuples `(g₁, …, gₙ)` of elements of `G` are the maps
`Qᵢ : (…, gᵢ, gᵢ₊₁, …) ↦ (…, gᵢ₊₁, gᵢ₊₁⁻¹ gᵢ gᵢ₊₁, …)` for `1 ≤ i ≤ n - 1` and their inverses (the
Hurwitz action of the braid group on `n` strands). Two tuples, such as two generating vectors of a
group of automorphisms of a curve, are braid equivalent if they lie in the same orbit of the group
generated by the braid operations.

The LMFDB knowl writes the `i`-th entry of `Qᵢ(g)` as `g_i+1`, a typo for `gᵢ₊₁`. It says that the
braid operations act on the generating vectors of one refined passport; as `Qᵢ` swaps the conjugacy
classes of the `i`-th and `(i+1)`-st entries, they preserve the refined passport only up to the
order of its conjugacy classes, so the action is defined here on all `n`-tuples, and braid
equivalence of two generating vectors is their equivalence in this action. That the braid operations satisfy the
braid relations, so that the action factors through Tau Ceti's `TauCeti.BraidGroup`, and that they
preserve the product `g₁ ⋯ gₙ` and the generation of `G`, are not formalised.

## Main definitions

* `Hurwitz.braidMove`: the move `(g_a, g_b) ↦ (g_b, g_b⁻¹ g_a g_b)` on two distinct entries.
* `Hurwitz.braidOperation` (LMFDB `curve.highergenus.aut.braid_equivalence`): the braid operation
  `Qᵢ`.
* `Hurwitz.braidOperationGroup`: the group generated by the braid operations.
* `Hurwitz.braidEquivalence` (LMFDB `curve.highergenus.aut.braid_equivalence`): braid equivalence,
  as an equivalence relation on `n`-tuples.
-/

namespace Hurwitz

variable (G : Type*) [Group G] {ι : Type*} [DecidableEq ι] {a b : ι} {n : ℕ}

variable {G} in
/-- The move `(…, g_a, …, g_b, …) ↦ (…, g_b, …, g_b⁻¹ g_a g_b, …)` on families of elements of a
group `G` indexed by `ι`, for distinct indices `a` and `b`, as a permutation of `ι → G`, with
inverse `(…, h_a, …, h_b, …) ↦ (…, h_a h_b h_a⁻¹, …, h_a, …)`. -/
def braidMove (hab : a ≠ b) : Equiv.Perm (ι → G) where
  toFun g := Function.update (Function.update g a (g b)) b ((g b)⁻¹ * g a * g b)
  invFun h := Function.update (Function.update h a (h a * h b * (h a)⁻¹)) b (h a)
  left_inv g := by
    funext j
    rcases eq_or_ne j b with rfl | hjb
    · simp [hab]
    rcases eq_or_ne j a with rfl | hja
    · simp [hab, mul_assoc]
    simp [hja, hjb]
  right_inv h := by
    funext j
    rcases eq_or_ne j b with rfl | hjb
    · simp [hab, mul_assoc]
    rcases eq_or_ne j a with rfl | hja
    · simp [hab]
    simp [hja, hjb]

variable (hab : a ≠ b) (g : ι → G)

lemma braidMove_apply_left : braidMove hab g a = g b := by
  simp [braidMove, hab]

lemma braidMove_apply_right : braidMove hab g b = (g b)⁻¹ * g a * g b := by
  simp [braidMove]

lemma braidMove_apply_of_ne {j : ι} (hja : j ≠ a) (hjb : j ≠ b) : braidMove hab g j = g j := by
  simp [braidMove, hja, hjb]

variable {G} in
/-- The **braid operation** `Qᵢ` (LMFDB `curve.highergenus.aut.braid_equivalence`) on `n`-tuples of
elements of a group `G`, for `0 ≤ i < n - 1` (indexing from zero):
`(…, gᵢ, gᵢ₊₁, …) ↦ (…, gᵢ₊₁, gᵢ₊₁⁻¹ gᵢ gᵢ₊₁, …)`, as a permutation of `Fin n → G`. -/
def braidOperation (i : Fin (n - 1)) : Equiv.Perm (Fin n → G) :=
  braidMove (a := ⟨i, by omega⟩) (b := ⟨i + 1, by omega⟩) <| by simp [Fin.ext_iff]

/-- The group of permutations of `Fin n → G` generated by the braid operations `Qᵢ`. -/
def braidOperationGroup : Subgroup (Equiv.Perm (Fin n → G)) :=
  Subgroup.closure (Set.range braidOperation)

/-- **Braid equivalence** (LMFDB `curve.highergenus.aut.braid_equivalence`) of `n`-tuples of
elements of a group `G`, such as generating vectors: two tuples are braid equivalent if they lie in
the same orbit of the group generated by the braid operations `Qᵢ` and their inverses. -/
def braidEquivalence : Setoid (Fin n → G) :=
  MulAction.orbitRel (braidOperationGroup G (n := n)) (Fin n → G)

end Hurwitz
