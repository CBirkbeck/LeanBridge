import LeanBridge.ForMathlib.GroupTheory.Commutator.Length
import Mathlib.Data.Matrix.Mul
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.Abel

/-!
# A commutator subgroup with an element that is not a commutator

The commutator subgroup `G'` of a group `G` is generated by the commutators, but not every element
of `G'` need be a commutator (LMFDB `group.commutator_length`). We give an example. For a
commutative ring `R` and a type `n`, the pairs `(v, w)` of a vector `v ∈ Rⁿ` and a matrix
`w ∈ Mₙ(R)` form a group under `(v, w) (v', w') = (v + v', w + w' + v v'ᵀ)`, a central extension
of `Rⁿ` by `Mₙ(R)`. The commutator of `(v, w)` and `(v', w')` is `(0, v v'ᵀ - v' vᵀ)`. For
`n = 4` the commutators therefore satisfy the Plücker relation `w₀₁ w₂₃ - w₀₂ w₁₃ + w₀₃ w₁₂ = 0`,
which the product `⁅e₀, e₁⁆ ⁅e₂, e₃⁆ = (0, e₀ e₁ᵀ - e₁ e₀ᵀ + e₂ e₃ᵀ - e₃ e₂ᵀ)` of two
commutators violates when `R` is nontrivial. Over `R = 𝔽₂` the group is finite, and its commutator
length is at least `2`.

## Main definitions

* `OuterProductGroup`: the group of pairs `(v, w)` above.
* `OuterProductGroup.single`: the element `(eᵢ, 0)`.

## Main results

* `OuterProductGroup.commutatorElement_eq`: the commutator formula.
* `OuterProductGroup.commutatorProduct_notMem_commutatorSet` (LMFDB `group.commutator_length`): the
  product `⁅e₀, e₁⁆ ⁅e₂, e₃⁆` of two commutators is not a commutator.
* `OuterProductGroup.commutatorSet_ne_commutator` (LMFDB `group.commutator_length`): not every
  element of the commutator subgroup is a commutator.
* `OuterProductGroup.one_lt_commutatorLength` (LMFDB `group.commutator_length`): over `𝔽₂` the
  group is finite of commutator length at least `2`.
-/

open Matrix Subgroup

open scoped commutatorElement

/-- The group of pairs `(v, w)` of a vector `v : n → R` and a matrix `w : Matrix n n R` over a
commutative ring `R`, with the product `(v, w) (v', w') = (v + v', w + w' + v v'ᵀ)`: a central
extension of the additive group `Rⁿ` by `Mₙ(R)` whose commutators are the matrices
`v v'ᵀ - v' vᵀ`. -/
@[ext]
structure OuterProductGroup (R n : Type*) where
  /-- The vector component. -/
  v : n → R
  /-- The matrix component. -/
  w : Matrix n n R

namespace OuterProductGroup

variable {R n : Type*}

/-- The group is the product `Rⁿ × Mₙ(R)` as a type. -/
def equivProd : OuterProductGroup R n ≃ (n → R) × (n → n → R) where
  toFun a := (a.v, a.w)
  invFun a := ⟨a.1, of a.2⟩

instance [Finite R] [Finite n] : Finite (OuterProductGroup R n) :=
  Finite.of_equiv _ equivProd.symm

variable [CommRing R] (a b : OuterProductGroup R n)

instance : Mul (OuterProductGroup R n) :=
  ⟨fun a b ↦ ⟨a.v + b.v, a.w + b.w + vecMulVec a.v b.v⟩⟩

instance : One (OuterProductGroup R n) :=
  ⟨⟨0, 0⟩⟩

instance : Inv (OuterProductGroup R n) :=
  ⟨fun a ↦ ⟨-a.v, -a.w + vecMulVec a.v a.v⟩⟩

@[simp]
lemma mul_v : (a * b).v = a.v + b.v :=
  rfl

@[simp]
lemma mul_w : (a * b).w = a.w + b.w + vecMulVec a.v b.v :=
  rfl

@[simp]
lemma one_v : (1 : OuterProductGroup R n).v = 0 :=
  rfl

@[simp]
lemma one_w : (1 : OuterProductGroup R n).w = 0 :=
  rfl

@[simp]
lemma inv_v : a⁻¹.v = -a.v :=
  rfl

@[simp]
lemma inv_w : a⁻¹.w = -a.w + vecMulVec a.v a.v :=
  rfl

instance : Group (OuterProductGroup R n) where
  mul_assoc a b c := by
    ext <;> simp [add_vecMulVec, vecMulVec_add] <;> abel
  one_mul a := by
    ext <;> simp
  mul_one a := by
    ext <;> simp
  inv_mul_cancel a := by
    ext <;> simp

/-- **The commutator formula**: `⁅(v, w), (v', w')⁆ = (0, v v'ᵀ - v' vᵀ)`. -/
lemma commutatorElement_eq : ⁅a, b⁆ = ⟨0, vecMulVec a.v b.v - vecMulVec b.v a.v⟩ := by
  ext <;> simp [commutatorElement_def, add_vecMulVec]
  abel

variable [DecidableEq n] in
/-- The element `(eᵢ, 0)`, for `eᵢ` the `i`-th standard basis vector of `Rⁿ`. -/
def single (i : n) : OuterProductGroup R n :=
  ⟨Pi.single i 1, 0⟩

lemma plucker_vecMulVec_sub_vecMulVec (x y : Fin 4 → R) :
    (vecMulVec x y - vecMulVec y x) 0 1 * (vecMulVec x y - vecMulVec y x) 2 3 -
      (vecMulVec x y - vecMulVec y x) 0 2 * (vecMulVec x y - vecMulVec y x) 1 3 +
      (vecMulVec x y - vecMulVec y x) 0 3 * (vecMulVec x y - vecMulVec y x) 1 2 = 0 := by
  simp only [sub_apply, vecMulVec_apply]
  ring1

variable (R) in
/-- The product `⁅e₀, e₁⁆ ⁅e₂, e₃⁆ = (0, e₀ e₁ᵀ - e₁ e₀ᵀ + e₂ e₃ᵀ - e₃ e₂ᵀ)` of two commutators
of `OuterProductGroup R (Fin 4)`, where `eᵢ` stands for `single i`. -/
def commutatorProduct : OuterProductGroup R (Fin 4) :=
  ⁅(single 0 : OuterProductGroup R (Fin 4)), single 1⁆ *
    ⁅(single 2 : OuterProductGroup R (Fin 4)), single 3⁆

lemma commutatorProduct_mem_commutator :
    commutatorProduct R ∈ commutator (OuterProductGroup R (Fin 4)) :=
  mul_mem (commutator_mem_commutator (mem_top _) (mem_top _))
    (commutator_mem_commutator (mem_top _) (mem_top _))

/-- **A product of two commutators that is not a commutator** (LMFDB
`group.commutator_length`): for a nontrivial commutative ring `R`, the product
`⁅e₀, e₁⁆ ⁅e₂, e₃⁆ = (0, e₀ e₁ᵀ - e₁ e₀ᵀ + e₂ e₃ᵀ - e₃ e₂ᵀ)` violates the Plücker relation
`w₀₁ w₂₃ - w₀₂ w₁₃ + w₀₃ w₁₂ = 0` satisfied by every commutator `(0, v v'ᵀ - v' vᵀ)`. -/
lemma commutatorProduct_notMem_commutatorSet [Nontrivial R] :
    commutatorProduct R ∉ commutatorSet (OuterProductGroup R (Fin 4)) := by
  rintro ⟨a, b, h⟩
  have h₁ : (commutatorProduct R).w 0 1 * (commutatorProduct R).w 2 3 -
      (commutatorProduct R).w 0 2 * (commutatorProduct R).w 1 3 +
      (commutatorProduct R).w 0 3 * (commutatorProduct R).w 1 2 = 0 := by
    rw [← h, commutatorElement_eq]
    exact plucker_vecMulVec_sub_vecMulVec a.v b.v
  simp [commutatorProduct, commutatorElement_eq, single, vecMulVec_apply] at h₁

/-- **Not every element of the commutator subgroup is a commutator** (LMFDB
`group.commutator_length`): for a nontrivial commutative ring `R`, the commutators of
`OuterProductGroup R (Fin 4)` form a proper subset of its commutator subgroup. -/
lemma commutatorSet_ne_commutator [Nontrivial R] :
    commutatorSet (OuterProductGroup R (Fin 4)) ≠ commutator (OuterProductGroup R (Fin 4)) :=
  fun h ↦ commutatorProduct_notMem_commutatorSet <| by
    rw [h, SetLike.mem_coe]
    exact commutatorProduct_mem_commutator

/-- **A finite group of commutator length at least `2`** (LMFDB `group.commutator_length`): over
`𝔽₂` the group `OuterProductGroup (ZMod 2) (Fin 4)` is finite, and its commutator subgroup has an
element that is not a commutator. -/
lemma one_lt_commutatorLength : 1 < commutatorLength (OuterProductGroup (ZMod 2) (Fin 4)) := by
  refine Nat.lt_of_not_le fun h ↦ commutatorProduct_notMem_commutatorSet (R := ZMod 2) ?_
  rcases exists_list_length_le_commutatorLength (commutatorProduct_mem_commutator (R := ZMod 2))
    with ⟨l, hl, hc, hp⟩
  rcases l with _ | ⟨c, _ | ⟨d, l⟩⟩
  · rw [← hp]
    exact one_mem_commutatorSet _
  · rw [← hp, List.prod_singleton]
    exact hc c (List.mem_singleton_self c)
  · simp at hl
    omega

end OuterProductGroup
