/-!
# The ramification of `X(Γ) → X(1)`

For a subgroup `Γ` of finite index of `SL(2, ℤ)` with `μ` cosets of `±Γ`, the map `X(Γ) → X(1)` of
compact Riemann surfaces (Tau Ceti's `Subgroup.CompactifiedQuotient`) has degree `μ`, and it can
only ramify above the images of `i`, of `ρ = e^{2πi/3}` and of the cusp `∞`, whose stabilizers in
`PSL(2, ℤ)` are generated by `S`, `S T` and `T`. The fibres above these points are the orbits of
`S`, `S T` and `T` on the cosets of `±Γ`, so the ramification degree is
`3 μ - c(S) - c(S T) - c(T)`, where `c(σ)` is the number of orbits of `σ`.

Hence the combinatorial genus `ModularGroup.genus` of LMFDB `group.sl2z.genus_subgroup` satisfies
the Riemann–Hurwitz formula `2 g - 2 = -2 μ + R` for `X(Γ) → X(1)`, the sphere `X(1)` having Euler
characteristic `2`. This is the combinatorial half of the identification of `ModularGroup.genus`
with the topological genus of `X(Γ)`. The topological half, the Riemann–Hurwitz theorem for Euler
characteristics and `H₂(X(Γ), ℤ) ≅ ℤ`, is not at the pinned Tau Ceti. Tau Ceti's main has both, but
its Riemann–Hurwitz theorem assumes that `X(Γ)`, `X(1)` and `X(1)` minus the branch values have
finite CW type, which is not proved there either.

## Main definitions

* `ModularGroup.levelOneMap`: the finite holomorphic map `X(Γ) → X(1)`.

## Main results

* `ModularGroup.ramificationDegree_levelOneMap`: the ramification degree of `X(Γ) → X(1)` in terms
  of the orbits of `S`, `S T` and `T` on the cosets of `±Γ`.
* `ModularGroup.two_mul_genus_sub_two`: the combinatorial genus satisfies the Riemann–Hurwitz
  formula for `X(Γ) → X(1)`.
-/

open Equiv MulAction OnePoint UpperHalfPlane TauCeti RiemannSurface Subgroup CompactifiedQuotient
  Fuchsian ModularGroup

open scoped MatrixGroups

namespace ModularGroup

variable {G : Type*} [Group G]

lemma card_orbitRel_zpowers {β : Type*} [MulAction G β] (b : G) :
    Nat.card (orbitRel.Quotient (zpowers b) β) = orbitCount (toPerm b : Perm β) := by
  have hp (i : ℤ) (x : β) : ((toPerm b : Perm β) ^ i) x = b ^ i • x := by
    rw [← toPermHom_apply, ← map_zpow]
    rfl
  refine Nat.card_congr (Quotient.congr (Equiv.refl _) fun x y ↦ ?_)
  rw [orbitRel_apply, Equiv.refl_apply, Equiv.refl_apply]
  refine ⟨?_, ?_⟩
  · rintro ⟨⟨_, n, rfl⟩, rfl⟩
    refine ⟨-n, ?_⟩
    rw [hp, zpow_neg]
    exact inv_smul_smul (b ^ n) y
  · rintro ⟨n, rfl⟩
    refine ⟨⟨(b ^ n)⁻¹, -n, zpow_neg b n⟩, ?_⟩
    rw [hp]
    exact inv_smul_smul (b ^ n) x

lemma eq_zpowers_of_card_prime {H : Subgroup G} {p : ℕ} (hp : p.Prime) (hc : Nat.card H = p) {b : G}
    (hb : b ∈ H) (hne : b ≠ 1) : H = zpowers b := by
  have : Fact p.Prime := ⟨hp⟩
  have h₁ : zpowers (⟨b, hb⟩ : H) = ⊤ :=
    zpowers_eq_top_of_prime_card hc fun h₀ ↦ hne (congrArg Subtype.val h₀)
  have h₂ : (zpowers (⟨b, hb⟩ : H)).map H.subtype = (⊤ : Subgroup H).map H.subtype :=
    congrArg (Subgroup.map H.subtype) h₁
  rw [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map, H.range_subtype] at h₂
  exact h₂.symm

/-- The morphism from `SL(2, ℤ)` onto the effective level-one group in `PSL(2, ℝ)`. -/
noncomputable def toLevelOne : SL(2, ℤ) →* psl2zToPSL2R.range :=
  sl2zToPSL2R.codRestrict _ fun g ↦ range_sl2zToPSL2R_eq_range_psl2zToPSL2R ▸ ⟨g, rfl⟩

lemma toLevelOne_surjective : Function.Surjective toLevelOne := fun x ↦ by
  rcases x with ⟨x, hx⟩
  have h₁ : x ∈ sl2zToPSL2R.range := by
    rwa [range_sl2zToPSL2R_eq_range_psl2zToPSL2R]
  rcases h₁ with ⟨g, rfl⟩
  exact ⟨g, rfl⟩

lemma toLevelOne_smul (g : SL(2, ℤ)) (z : ℍ) : toLevelOne g • z = g • z :=
  sl2zToPSL2R_smul g z

lemma toLevelOne_ne_one_of_notMem_center {g : SL(2, ℤ)} (hg : g ∉ Subgroup.center SL(2, ℤ)) :
    toLevelOne g ≠ 1 := fun h₀ ↦ hg <| by
  have h₁ : g ∈ sl2zToPSL2R.ker := congrArg Subtype.val h₀
  rwa [sl2zToPSL2R_ker] at h₁

variable (Γ : Subgroup SL(2, ℤ))

lemma toLevelOne_mem_iff {g : SL(2, ℤ)} :
    toLevelOne g ∈ (Γ.map sl2zToPSL2R).subgroupOf psl2zToPSL2R.range ↔
      g ∈ Γ ⊔ Subgroup.center SL(2, ℤ) := by
  have h₁ : (Γ.map sl2zToPSL2R).comap sl2zToPSL2R = Γ ⊔ Subgroup.center SL(2, ℤ) := by
    rw [Subgroup.comap_map_eq, sl2zToPSL2R_ker]
  exact Subgroup.mem_subgroupOf.trans (SetLike.ext_iff.mp h₁ g)

/-- The map from the cosets of `±Γ` in `SL(2, ℤ)` to those of the image of `Γ` in the effective
level-one group. -/
noncomputable def cosetsMap :
    Cosets Γ → psl2zToPSL2R.range ⧸ (Γ.map sl2zToPSL2R).subgroupOf psl2zToPSL2R.range :=
  Quotient.map' toLevelOne fun a b hab ↦ QuotientGroup.leftRel_apply.mpr <| by
    rw [← map_inv, ← map_mul, toLevelOne_mem_iff]
    exact QuotientGroup.leftRel_apply.mp hab

lemma cosetsMap_mk (g : SL(2, ℤ)) : cosetsMap Γ (g : Cosets Γ) = (toLevelOne g : _ ⧸ _) :=
  rfl

lemma cosetsMap_bijective : Function.Bijective (cosetsMap Γ) := by
  refine ⟨fun x y ↦ ?_, fun x ↦ ?_⟩
  · induction x using QuotientGroup.induction_on with
    | H a =>
      induction y using QuotientGroup.induction_on with
      | H b =>
        rw [cosetsMap_mk, cosetsMap_mk, QuotientGroup.eq, QuotientGroup.eq, ← map_inv, ← map_mul,
          toLevelOne_mem_iff]
        exact id
  · induction x using QuotientGroup.induction_on with
    | H a =>
      rcases toLevelOne_surjective a with ⟨g, rfl⟩
      exact ⟨g, rfl⟩

lemma cosetsMap_smul (a : SL(2, ℤ)) (x : Cosets Γ) :
    cosetsMap Γ (a • x) = toLevelOne a • cosetsMap Γ x := by
  induction x using QuotientGroup.induction_on with
  | H g => exact (cosetsMap_mk Γ (a * g)).trans (congrArg _ (map_mul toLevelOne a g))

lemma orbitCount_toPerm_cosets (a : SL(2, ℤ)) : orbitCount (toPerm a : Perm (Cosets Γ)) =
    orbitCount (toPerm (toLevelOne a) :
      Perm (psl2zToPSL2R.range ⧸ (Γ.map sl2zToPSL2R).subgroupOf psl2zToPSL2R.range)) := by
  rw [← orbitCount_permCongr (Equiv.ofBijective _ (cosetsMap_bijective Γ))]
  congr 1
  refine Equiv.ext fun x ↦ ?_
  rcases (cosetsMap_bijective Γ).surjective x with ⟨y, rfl⟩
  simp [cosetsMap_smul]

lemma S_notMem_center : S ∉ Subgroup.center SL(2, ℤ) := fun h₀ ↦ by
  have h₁ : (T * S).1 0 0 = (S * T).1 0 0 := congrArg (fun g : SL(2, ℤ) ↦ g.1 0 0)
    (Subgroup.mem_center_iff.mp h₀ T)
  simp [coe_S, coe_T] at h₁

lemma S_mul_T_notMem_center : S * T ∉ Subgroup.center SL(2, ℤ) := fun h₀ ↦ by
  have h₁ : (T * (S * T)).1 0 0 = (S * T * T).1 0 0 := congrArg (fun g : SL(2, ℤ) ↦ g.1 0 0)
    (Subgroup.mem_center_iff.mp h₀ T)
  simp [coe_S, coe_T] at h₁

lemma stabilizer_levelOne_I : stabilizer psl2zToPSL2R.range I = zpowers (toLevelOne S) := by
  refine eq_zpowers_of_card_prime Nat.prime_two card_stabilizer_psl2zToPSL2RRange_I ?_
    (toLevelOne_ne_one_of_notMem_center S_notMem_center)
  exact (mem_stabilizer_iff.mpr ((toLevelOne_smul S I).trans
    (stabilizer_I.mpr (by simp))))

lemma stabilizer_levelOne_ρ : stabilizer psl2zToPSL2R.range ρ = zpowers (toLevelOne (S * T)) := by
  refine eq_zpowers_of_card_prime Nat.prime_three card_stabilizer_psl2zToPSL2RRange_ρ ?_
    (toLevelOne_ne_one_of_notMem_center S_mul_T_notMem_center)
  exact (mem_stabilizer_iff.mpr ((toLevelOne_smul (S * T) ρ).trans
    (stabilizer_ρ.mpr (by simp))))

lemma stabilizer_levelOne_infty :
    stabilizer psl2zToPSL2R.range (∞ : OnePoint ℝ) = zpowers (toLevelOne T) :=
  cuspDatumInfty.zpowers_generator.symm

lemma card_cosets_levelOne :
    Nat.card (psl2zToPSL2R.range ⧸ (Γ.map sl2zToPSL2R).subgroupOf psl2zToPSL2R.range) =
      Nat.card (Cosets Γ) :=
  (Nat.card_congr (Equiv.ofBijective _ (cosetsMap_bijective Γ))).symm

lemma card_fiber_I : Nat.card {y : (Γ.map sl2zToPSL2R).CompactifiedQuotient //
    compactifiedQuotientMap (map_sl2zToPSL2R_le_range Γ) y = .ofQuotient (Quotient.mk'' I)} =
      orbitCount (toPerm S : Perm (Cosets Γ)) := by
  rw [card_fiber_compactifiedQuotientMap_eq_card_stabilizerOrbitRelQuotient,
    stabilizer_levelOne_I, card_orbitRel_zpowers, orbitCount_toPerm_cosets]

lemma card_fiber_ρ : Nat.card {y : (Γ.map sl2zToPSL2R).CompactifiedQuotient //
    compactifiedQuotientMap (map_sl2zToPSL2R_le_range Γ) y = .ofQuotient (Quotient.mk'' ρ)} =
      orbitCount (toPerm (S * T) : Perm (Cosets Γ)) := by
  rw [card_fiber_compactifiedQuotientMap_eq_card_stabilizerOrbitRelQuotient,
    stabilizer_levelOne_ρ, card_orbitRel_zpowers, orbitCount_toPerm_cosets]

lemma card_fiber_of_stabilizer_eq_bot {z : ℍ} (hz : stabilizer psl2zToPSL2R.range z = ⊥) :
    Nat.card {y : (Γ.map sl2zToPSL2R).CompactifiedQuotient //
      compactifiedQuotientMap (map_sl2zToPSL2R_le_range Γ) y = .ofQuotient (Quotient.mk'' z)} =
        Nat.card (Cosets Γ) := by
  rw [card_fiber_compactifiedQuotientMap_eq_card_stabilizerOrbitRelQuotient, hz,
    Nat.card_congr MulAction.orbitRelQuotientBotEquiv, card_cosets_levelOne]

variable [Γ.FiniteIndex]

lemma isFiniteRelIndex_map : (Γ.map sl2zToPSL2R).IsFiniteRelIndex psl2zToPSL2R.range :=
  ⟨(relIndex_map_sl2zToPSL2R Γ).trans_ne Nat.card_pos.ne'⟩

lemma card_fiber_cusp : Nat.card {y : (Γ.map sl2zToPSL2R).CompactifiedQuotient //
    compactifiedQuotientMap (map_sl2zToPSL2R_le_range Γ) y = .ofCusp cuspOrbitInfty} =
      orbitCount (toPerm T : Perm (Cosets Γ)) := by
  have : (Γ.map sl2zToPSL2R).IsFiniteRelIndex psl2zToPSL2R.range := isFiniteRelIndex_map Γ
  rw [← Nat.card_congr (cuspOrbitFiberEquivCompactifiedFiber (map_sl2zToPSL2R_le_range Γ) _),
    Nat.card_congr (cuspOrbitFiberEquivBoundaryOrbitFiber (map_sl2zToPSL2R_le_range Γ) _),
    orbitCount_toPerm_cosets, ← card_orbitRel_zpowers, ← stabilizer_levelOne_infty]
  exact (Nat.card_congr (stabilizerOrbitRelQuotientEquivOrbitRelMapFiber
    (map_sl2zToPSL2R_le_range Γ) (∞ : OnePoint ℝ))).symm

/-- The finite holomorphic map `X(Γ) → X(1)` of compact Riemann surfaces. -/
noncomputable def levelOneMap : FiniteHolomorphicMap (Γ.map sl2zToPSL2R).CompactifiedQuotient
    psl2zToPSL2R.range.CompactifiedQuotient :=
  haveI : (Γ.map sl2zToPSL2R).IsFiniteRelIndex psl2zToPSL2R.range := isFiniteRelIndex_map Γ
  compactifiedQuotientFiniteHolomorphicMap (map_sl2zToPSL2R_le_range Γ)

lemma card_fiber_levelOneMap (y : psl2zToPSL2R.range.CompactifiedQuotient) :
    ((levelOneMap Γ).finite_fiber y).toFinset.card =
      Nat.card {x : (Γ.map sl2zToPSL2R).CompactifiedQuotient //
        compactifiedQuotientMap (map_sl2zToPSL2R_le_range Γ) x = y} :=
  (Set.ncard_eq_toFinset_card _ _).symm.trans (Nat.card_coe_set_eq _).symm

lemma sum_localMultiplicity_levelOneMap (y : psl2zToPSL2R.range.CompactifiedQuotient) :
    Nat.card {x : (Γ.map sl2zToPSL2R).CompactifiedQuotient //
      compactifiedQuotientMap (map_sl2zToPSL2R_le_range Γ) x = y} +
      ∑ x ∈ ((levelOneMap Γ).finite_fiber y).toFinset, (localMultiplicity (levelOneMap Γ) x - 1) =
        Nat.card (Cosets Γ) := by
  rw [← card_fiber_levelOneMap, card_fiber_add_sum_localMultiplicity_sub_one]
  exact degree_compactifiedQuotientMap_eq_natCard_cosets Γ

lemma I_orbit_ne_ρ_orbit :
    Quotient.mk (orbitRel psl2zToPSL2R.range ℍ) I ≠ Quotient.mk (orbitRel psl2zToPSL2R.range ℍ) ρ :=
  fun h₀ ↦ by
    have h₁ : (Quotient.mk'' I : orbitRel.Quotient SL(2, ℤ) ℍ) = Quotient.mk'' ρ :=
      quotientMk_psl2zToPSL2RRange_eq_iff_quotientMk_sl_eq.mp h₀
    have h₂ : ellipticOrder (Quotient.mk'' I : orbitRel.Quotient SL(2, ℤ) ℍ) =
        ellipticOrder (Quotient.mk'' ρ : orbitRel.Quotient SL(2, ℤ) ℍ) := congrArg ellipticOrder h₁
    rw [ellipticOrder_I, ellipticOrder_ρ] at h₂
    omega

/-- **The ramification degree of `X(Γ) → X(1)`** is `3 μ - c(S) - c(S T) - c(T)`, where `c(σ)` is
the number of orbits of `σ` on the `μ` cosets of `±Γ`. -/
lemma ramificationDegree_levelOneMap : ramificationDegree (levelOneMap Γ) +
    orbitCount (toPerm S : Perm (Cosets Γ)) + orbitCount (toPerm (S * T) : Perm (Cosets Γ)) +
      orbitCount (toPerm T : Perm (Cosets Γ)) = 3 * Nat.card (Cosets Γ) := by
  classical
  let yI : psl2zToPSL2R.range.CompactifiedQuotient := .ofQuotient (Quotient.mk'' I)
  let yρ : psl2zToPSL2R.range.CompactifiedQuotient := .ofQuotient (Quotient.mk'' ρ)
  let yc : psl2zToPSL2R.range.CompactifiedQuotient := .ofCusp cuspOrbitInfty
  have hI : orbitCount (toPerm S : Perm (Cosets Γ)) +
      ∑ x ∈ ((levelOneMap Γ).finite_fiber yI).toFinset,
        (localMultiplicity (levelOneMap Γ) x - 1) = Nat.card (Cosets Γ) :=
    (card_fiber_I Γ) ▸ sum_localMultiplicity_levelOneMap Γ yI
  have hρ : orbitCount (toPerm (S * T) : Perm (Cosets Γ)) +
      ∑ x ∈ ((levelOneMap Γ).finite_fiber yρ).toFinset,
        (localMultiplicity (levelOneMap Γ) x - 1) = Nat.card (Cosets Γ) :=
    (card_fiber_ρ Γ) ▸ sum_localMultiplicity_levelOneMap Γ yρ
  have hc : orbitCount (toPerm T : Perm (Cosets Γ)) +
      ∑ x ∈ ((levelOneMap Γ).finite_fiber yc).toFinset,
        (localMultiplicity (levelOneMap Γ) x - 1) = Nat.card (Cosets Γ) :=
    (card_fiber_cusp Γ) ▸ sum_localMultiplicity_levelOneMap Γ yc
  have hsupp : Function.support (fun x ↦ localMultiplicity (levelOneMap Γ) x - 1) ⊆
      ↑(((levelOneMap Γ).finite_fiber yI).toFinset ∪ ((levelOneMap Γ).finite_fiber yρ).toFinset ∪
        ((levelOneMap Γ).finite_fiber yc).toFinset) := by
    intro x hx
    have hx₁ : localMultiplicity (levelOneMap Γ) x - 1 ≠ 0 := hx
    have hm (y : psl2zToPSL2R.range.CompactifiedQuotient) (h : levelOneMap Γ x = y) :
        x ∈ ((levelOneMap Γ).finite_fiber y).toFinset :=
      ((levelOneMap Γ).finite_fiber y).mem_toFinset.mpr h
    have key : levelOneMap Γ x = yI ∨ levelOneMap Γ x = yρ ∨ levelOneMap Γ x = yc := by
      rcases hy : levelOneMap Γ x with p | C
      · rcases Quotient.exists_rep p with ⟨z, rfl⟩
        by_cases hzI : Quotient.mk (orbitRel psl2zToPSL2R.range ℍ) z = Quotient.mk _ I
        · exact Or.inl (congrArg _ hzI)
        by_cases hzρ : Quotient.mk (orbitRel psl2zToPSL2R.range ℍ) z = Quotient.mk _ ρ
        · exact Or.inr (Or.inl (congrArg _ hzρ))
        have hb : stabilizer psl2zToPSL2R.range z = ⊥ :=
          (stabilizer_psl2zToPSL2RRange_eq_bot_iff z).mpr ⟨hzI, hzρ⟩
        have h₁ : Nat.card {x : (Γ.map sl2zToPSL2R).CompactifiedQuotient //
              compactifiedQuotientMap (map_sl2zToPSL2R_le_range Γ) x =
                .ofQuotient (Quotient.mk'' z)} +
            ∑ x ∈ ((levelOneMap Γ).finite_fiber (.ofQuotient (Quotient.mk'' z))).toFinset,
              (localMultiplicity (levelOneMap Γ) x - 1) = Nat.card (Cosets Γ) :=
          sum_localMultiplicity_levelOneMap Γ (.ofQuotient (Quotient.mk'' z))
        rw [card_fiber_of_stabilizer_eq_bot Γ hb] at h₁
        have h₂ : ∑ x ∈ ((levelOneMap Γ).finite_fiber (.ofQuotient (Quotient.mk'' z))).toFinset,
            (localMultiplicity (levelOneMap Γ) x - 1) = 0 := by
          omega
        exact (hx₁ ((Finset.sum_eq_zero_iff.mp h₂) x (hm _ hy))).elim
      · exact Or.inr (Or.inr (congrArg _ (Subsingleton.elim C cuspOrbitInfty)))
    rcases key with h | h | h
    · exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_union_left _ (hm _ h)))
    · exact Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_union_right _ (hm _ h)))
    · exact Finset.mem_coe.mpr (Finset.mem_union_right _ (hm _ h))
  have hmem {x : (Γ.map sl2zToPSL2R).CompactifiedQuotient}
      {y : psl2zToPSL2R.range.CompactifiedQuotient}
      (hx : x ∈ ((levelOneMap Γ).finite_fiber y).toFinset) : levelOneMap Γ x = y :=
    ((levelOneMap Γ).finite_fiber y).mem_toFinset.mp hx
  have hd₁ : Disjoint ((levelOneMap Γ).finite_fiber yI).toFinset
      ((levelOneMap Γ).finite_fiber yρ).toFinset :=
    Finset.disjoint_left.mpr fun x hx hx' ↦ I_orbit_ne_ρ_orbit
      (ofQuotient.inj ((hmem hx).symm.trans (hmem hx')))
  have hd₂ : Disjoint (((levelOneMap Γ).finite_fiber yI).toFinset ∪
      ((levelOneMap Γ).finite_fiber yρ).toFinset) ((levelOneMap Γ).finite_fiber yc).toFinset := by
    refine Finset.disjoint_left.mpr fun x hx hx' ↦ ?_
    rcases Finset.mem_union.mp hx with h | h <;> exact nomatch (hmem h).symm.trans (hmem hx')
  rw [ramificationDegree_def, finsum_eq_sum_of_support_subset _ hsupp, Finset.sum_union hd₂,
    Finset.sum_union hd₁]
  omega

/-- **The combinatorial genus satisfies the Riemann–Hurwitz formula for `X(Γ) → X(1)`**:
`2 g - 2 = -2 μ + R`, with `R` the ramification degree, the sphere `X(1)` having Euler
characteristic `2`. -/
lemma two_mul_genus_sub_two :
    2 * (genus Γ : ℤ) - 2 = ramificationDegree (levelOneMap Γ) - 2 * Nat.card (Cosets Γ) := by
  have h₁ : 2 - 2 * (genus Γ : ℤ) = orbitCount (toPerm S : Perm (Cosets Γ)) +
      orbitCount (toPerm (S * T) : Perm (Cosets Γ)) + orbitCount (toPerm T : Perm (Cosets Γ)) -
        Nat.card (Cosets Γ) := two_sub_two_mul_genus Γ
  have h₂ : ramificationDegree (levelOneMap Γ) + orbitCount (toPerm S : Perm (Cosets Γ)) +
      orbitCount (toPerm (S * T) : Perm (Cosets Γ)) + orbitCount (toPerm T : Perm (Cosets Γ)) =
        3 * Nat.card (Cosets Γ) := ramificationDegree_levelOneMap Γ
  omega

end ModularGroup
