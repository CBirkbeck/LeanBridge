import Mathlib.GroupTheory.Nilpotent
import Mathlib.Order.SupClosed

/-!
# The Fitting subgroup

The Fitting subgroup `Fit(G)` of a group `G` is its largest normal nilpotent subgroup. We define it
as the supremum of all normal nilpotent subgroups, which is always normal and contains every normal
nilpotent subgroup. That it is itself nilpotent rests on Fitting's theorem: the join of two normal
nilpotent subgroups is nilpotent. We prove it for finite groups, where it shows that `Fit(G)` is
the largest normal nilpotent subgroup, as the LMFDB knowl asserts (for infinite groups the supremum
need not be nilpotent, and a largest normal nilpotent subgroup need not exist).

## Main definitions

* `Subgroup.fittingSubgroup` (LMFDB `group.fitting_subgroup`): the Fitting subgroup.

## Main results

* `Group.isNilpotent_of_sup_eq_top`: a finite group generated by two normal nilpotent subgroups is
  nilpotent.
* `Subgroup.isNilpotent_sup`: **Fitting's theorem**, the join of two normal nilpotent subgroups of a
  finite group is nilpotent.
* `Subgroup.le_fittingSubgroup`: every normal nilpotent subgroup lies in the Fitting subgroup.
* `Subgroup.isNilpotent_fittingSubgroup`: the Fitting subgroup of a finite group is nilpotent.
-/

open Group

variable {G : Type*} [Group G]

namespace Subgroup

lemma isPGroup_map_sylow {p : ℕ} (N : Subgroup G) (A : Sylow p N) :
    IsPGroup p (A.map N.subtype : Subgroup G) :=
  A.isPGroup.map N.subtype

lemma not_dvd_relIndex_map_sylow [Finite G] {p : ℕ} [Fact p.Prime] (N : Subgroup G)
    (A : Sylow p N) : ¬p ∣ (A.map N.subtype : Subgroup G).relIndex N := by
  rw [relIndex, subgroupOf, comap_map_eq_self_of_injective N.subtype_injective]
  exact A.not_dvd_index

end Subgroup

open Subgroup

/-- **A finite group generated by two normal nilpotent subgroups is nilpotent.** For each prime
`p`, the join of the Sylow `p`-subgroups of the two subgroups is a normal `p`-subgroup of index
prime to `p`, hence the unique Sylow `p`-subgroup. -/
lemma Group.isNilpotent_of_sup_eq_top [Finite G] {N M : Subgroup G} [N.Normal] [M.Normal]
    [IsNilpotent N] [IsNilpotent M] (h : N ⊔ M = ⊤) : IsNilpotent G := by
  refine (isNilpotent_of_finite_tfae.out 1 4).mpr fun p hp P => ?_
  have : Fact p.Prime := hp
  let A : Sylow p N := Classical.arbitrary _
  let B : Sylow p M := Classical.arbitrary _
  have : (A : Subgroup N).Characteristic := Sylow.characteristic_of_normal A inferInstance
  have : (B : Subgroup M).Characteristic := Sylow.characteristic_of_normal B inferInstance
  let S : Subgroup G := A.map N.subtype ⊔ B.map M.subtype
  have hS : IsPGroup p S :=
    (isPGroup_map_sylow N A).to_sup_of_normal_left (isPGroup_map_sylow M B)
  have hSN : S ≤ S ⊔ N := le_sup_left
  have hindex : S.index = S.relIndex N * (S ⊔ N).relIndex M := by
    rw [← relIndex_top_right, ← sup_top_eq S, ← h, ← sup_assoc,
      ← relIndex_mul_relIndex _ _ _ hSN le_sup_left, relIndex_sup_left, relIndex_sup_left]
  have hpS : ¬p ∣ S.index := by
    rw [hindex, hp.out.prime.dvd_mul, not_or]
    exact ⟨fun hd => not_dvd_relIndex_map_sylow N A <| hd.trans <| relIndex_dvd_of_le_left N
      le_sup_left, fun hd => not_dvd_relIndex_map_sylow M B <| hd.trans <|
        relIndex_dvd_of_le_left M <| le_sup_right.trans hSN⟩
  let Q : Sylow p G := hS.toSylow hpS
  have hQ : Q.Normal := inferInstanceAs S.Normal
  let u : Unique (Sylow p G) := Sylow.unique_of_normal Q hQ
  rw [Subsingleton.elim P Q]
  exact hQ

namespace Subgroup

/-- **Fitting's theorem**: the join of two normal nilpotent subgroups of a finite group is
nilpotent. -/
lemma isNilpotent_sup [Finite G] {N M : Subgroup G} [N.Normal] [M.Normal] [IsNilpotent N]
    [IsNilpotent M] : IsNilpotent ↥(N ⊔ M) := by
  have : IsNilpotent (N.subgroupOf (N ⊔ M)) :=
    nilpotent_of_mulEquiv (subgroupOfEquivOfLe le_sup_left).symm
  have : IsNilpotent (M.subgroupOf (N ⊔ M)) :=
    nilpotent_of_mulEquiv (subgroupOfEquivOfLe le_sup_right).symm
  exact isNilpotent_of_sup_eq_top <| codisjoint_iff.mp <| codisjoint_subgroupOf_sup N M

variable (G) in
/-- The **Fitting subgroup** `Fit(G)` of a group `G` (LMFDB `group.fitting_subgroup`): the
supremum of the normal nilpotent subgroups of `G`. For a finite group it is nilpotent
(`Subgroup.isNilpotent_fittingSubgroup`), so it is the largest normal nilpotent subgroup, the
LMFDB's definition. -/
def fittingSubgroup : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ IsNilpotent N}

instance : (fittingSubgroup G).Normal :=
  sSup_normal _ fun _ hN => hN.1

/-- Every normal nilpotent subgroup lies in the Fitting subgroup. -/
lemma le_fittingSubgroup (N : Subgroup G) [N.Normal] [IsNilpotent N] : N ≤ fittingSubgroup G :=
  le_sSup ⟨inferInstance, inferInstance⟩

/-- The **Fitting subgroup of a finite group is nilpotent**, by Fitting's theorem: it is the
largest normal nilpotent subgroup. -/
lemma isNilpotent_fittingSubgroup [Finite G] : IsNilpotent (fittingSubgroup G) := by
  have hs : SupClosed {N : Subgroup G | N.Normal ∧ IsNilpotent N} := by
    rintro N ⟨hN, hN'⟩ M ⟨hM, hM'⟩
    exact ⟨inferInstance, isNilpotent_sup⟩
  exact (hs.sSup_mem (Set.toFinite _) ⟨inferInstance, inferInstance⟩ le_rfl).2

end Subgroup
