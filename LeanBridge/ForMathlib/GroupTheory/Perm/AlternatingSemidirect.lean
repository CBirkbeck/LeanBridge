import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The symmetric group as a semidirect product

For a finite type `α` with two distinct elements `a ≠ b`, the transposition `(a b)` generates a
subgroup of order `2` of the symmetric group `S_n = Perm α` which is a complement of the alternating
group `A_n`, since `(a b)` is odd. So `S_n = A_n ⋊ C_2`, with `C_2` acting on `A_n` by conjugation
by `(a b)` (LMFDB `group.symmetric`).

## Main definitions

* `alternatingGroup.swapConjAction`: the action of `C_2` on `A_n` by conjugation by a
  transposition.
* `alternatingGroup.semidirectProductMulEquiv` (LMFDB `group.symmetric`): the isomorphism
  `A_n ⋊ C_2 ≃* S_n`.

## Main results

* `alternatingGroup.isComplement'_zpowers_swap` (LMFDB `group.symmetric`): the subgroup generated
  by a transposition is a complement of the alternating group.
-/

open Equiv Perm Subgroup

namespace alternatingGroup

variable {α : Type*} [DecidableEq α] [Fintype α] {a b : α}

lemma nat_card_zpowers_swap (hab : a ≠ b) : Nat.card (zpowers (swap a b)) = 2 := by
  rw [Nat.card_zpowers, (swap_isSwap_iff.mpr hab).orderOf]

lemma disjoint_zpowers_swap (hab : a ≠ b) : Disjoint (alternatingGroup α) (zpowers (swap a b)) := by
  rw [disjoint_def]
  rintro - hx ⟨k, rfl⟩
  rw [mem_alternatingGroup, map_zpow, sign_swap hab] at hx
  rcases Int.even_or_odd k with hk | hk
  · rw [← orderOf_dvd_iff_zpow_eq_one, (swap_isSwap_iff.mpr hab).orderOf]
    exact even_iff_two_dvd.mp hk
  · rw [hk.neg_one_zpow] at hx
    exact absurd hx (by decide)

/-- **The subgroup generated by a transposition is a complement of the alternating group**
(LMFDB `group.symmetric`): it has order `2`, the index of `A_n`, and meets `A_n` trivially, a
transposition being odd. -/
lemma isComplement'_zpowers_swap (hab : a ≠ b) :
    (alternatingGroup α).IsComplement' (zpowers (swap a b)) := by
  have : Nontrivial α := nontrivial_of_ne a b hab
  refine isComplement'_of_card_mul_and_disjoint ?_ (disjoint_zpowers_swap hab)
  rw [nat_card_zpowers_swap hab, mul_comm, two_mul_nat_card_alternatingGroup]

/-- The isomorphism `C_2 ≃* ⟨(a b)⟩` sending the generator of `C_2` to the transposition
`(a b)`. -/
noncomputable def zmodTwoMulEquivZpowersSwap (hab : a ≠ b) :
    Multiplicative (ZMod 2) ≃* zpowers (swap a b) :=
  zmodMulEquivOfGenerator (g := ⟨swap a b, mem_zpowers _⟩)
    (fun ⟨_, k, hk⟩ ↦ ⟨k, Subtype.ext hk⟩) (nat_card_zpowers_swap hab)

lemma zmodTwoMulEquivZpowersSwap_ofAdd_one (hab : a ≠ b) :
    (zmodTwoMulEquivZpowersSwap hab (.ofAdd 1) : Perm α) = swap a b := by
  rw [zmodTwoMulEquivZpowersSwap, zmodMulEquivOfGenerator_apply_ofAdd_one]

/-- The action of `C_2` on the alternating group `A_n` in which the generator of `C_2` acts by
conjugation by the transposition `(a b)`. -/
noncomputable def swapConjAction (hab : a ≠ b) :
    Multiplicative (ZMod 2) →* MulAut (alternatingGroup α) :=
  MulAut.conjNormal.comp <|
    (zpowers (swap a b)).subtype.comp (zmodTwoMulEquivZpowersSwap hab).toMonoidHom

lemma swapConjAction_ofAdd_one_apply (hab : a ≠ b) (x : alternatingGroup α) :
    (swapConjAction hab (.ofAdd 1) x : Perm α) = swap a b * x * (swap a b)⁻¹ := by
  simp [swapConjAction, zmodTwoMulEquivZpowersSwap_ofAdd_one hab]

/-- **The symmetric group is a semidirect product `S_n = A_n ⋊ C_2`** (LMFDB `group.symmetric`),
for `C_2` acting on the alternating group `A_n` by conjugation by a transposition `(a b)`: the
isomorphism sends `(x, g)` to `x (a b)ᵏ` for `g` the `k`-th power of the generator of `C_2`. -/
noncomputable def semidirectProductMulEquiv (hab : a ≠ b) :
    alternatingGroup α ⋊[swapConjAction hab] Multiplicative (ZMod 2) ≃* Perm α :=
  (SemidirectProduct.congr (.refl _) (zmodTwoMulEquivZpowersSwap hab)
    fun _ ↦ MulEquiv.ext fun _ ↦ Subtype.ext rfl).trans <|
      SemidirectProduct.mulEquivSubgroup <| isComplement'_zpowers_swap hab

lemma semidirectProductMulEquiv_apply (hab : a ≠ b) (x : alternatingGroup α)
    (g : Multiplicative (ZMod 2)) :
    semidirectProductMulEquiv hab ⟨x, g⟩ = x * zmodTwoMulEquivZpowersSwap hab g :=
  rfl

end alternatingGroup
