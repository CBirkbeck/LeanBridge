import LeanBridge.ForMathlib.GroupTheory.Perm.MalleConstants

/-!
# The index of a rational conjugacy class

The index `ind(g) = n - c(g)` of a permutation (LMFDB `gg.index`, `Equiv.Perm.permIndex`) only
depends on the orbits of the cyclic group generated by `g`, and is invariant under conjugation. A
power `gⁿ` with `n` coprime to the order of `g` generates the same cyclic group, so the index is
constant on the rational conjugacy classes (LMFDB `group.division`). This defines the index
`ind(C)` of a rational conjugacy class `C` of a permutation group `G`, and Malle's constant `b(G)`
(LMFDB `gg.malle_b`, `Subgroup.malleB`) is the number of rational conjugacy classes `C` with
`ind(C) = a(G)⁻¹`, that is, the number of non-identity rational conjugacy classes of minimal
index. For the trivial group `a(G) = 0` (LMFDB `gg.malle_a`), `a(G)⁻¹` is not defined (Lean's
`0⁻¹ = 0` would count the class of the identity), and `b(G) = 0` is the number of non-identity
classes.

## Main definitions

* `RatConjClasses.permIndex` (LMFDB `gg.malle_b`): the index `ind(C)` of a rational conjugacy class.

## Main results

* `Equiv.Perm.permIndex_zpow_of_gcd_eq_one`: `ind(gⁿ) = ind(g)` for `n` coprime to the order of `g`.
* `IsRationallyConj.permIndex_coe_eq`: rationally conjugate elements of a permutation group have the
  same index.
* `Subgroup.malleB_eq_card_ne_mk_one` (LMFDB `gg.malle_b`): `b(G)` is the number of non-identity
  rational conjugacy classes of `G` of minimal index.
* `Subgroup.malleB_eq_card_permIndex_eq_malleA_inv` (LMFDB `gg.malle_b`):
  `b(G) = #{C ∈ CL_ℚ(G) : ind(C) = a(G)⁻¹}` for a nontrivial permutation group of a finite set.
-/

open Equiv TauCeti

variable {α : Type*}

namespace Equiv.Perm

variable {σ : Perm α}

lemma permIndex_conj (g : Perm α) : (g * σ * g⁻¹).permIndex = σ.permIndex :=
  congrArg (Nat.card α - ·) (orbitCount_conj g σ)

@[simp]
lemma permIndex_one : (1 : Perm α).permIndex = 0 :=
  (congrArg (Nat.card α - ·) orbitCount_one).trans (Nat.sub_self _)

lemma sameCycle_zpow_iff_of_gcd_eq_one {n : ℤ} (hn : n.gcd (orderOf σ) = 1) {x y : α} :
    (σ ^ n).SameCycle x y ↔ σ.SameCycle x y := by
  refine ⟨SameCycle.of_zpow, fun h ↦ ?_⟩
  rw [← zpow_zpow_gcdA hn] at h
  exact h.of_zpow

lemma orbitCount_zpow_of_gcd_eq_one {n : ℤ} (hn : n.gcd (orderOf σ) = 1) :
    orbitCount (σ ^ n) = orbitCount σ :=
  Nat.card_congr <| Quotient.congr (ra := SameCycle.setoid (σ ^ n)) (rb := SameCycle.setoid σ)
    (Equiv.refl α) fun _ _ ↦ sameCycle_zpow_iff_of_gcd_eq_one hn

/-- **`ind(gⁿ) = ind(g)` for `n` coprime to the order of `g`**: `gⁿ` generates the same cyclic group
as `g`, so it has the same orbits. -/
lemma permIndex_zpow_of_gcd_eq_one {n : ℤ} (hn : n.gcd (orderOf σ) = 1) :
    (σ ^ n).permIndex = σ.permIndex :=
  congrArg (Nat.card α - ·) (orbitCount_zpow_of_gcd_eq_one hn)

end Equiv.Perm

lemma IsRationallyConj.permIndex_eq {x y : Perm α} (h : IsRationallyConj x y) :
    x.permIndex = y.permIndex := by
  rcases h with ⟨n, hn, h⟩
  rcases isConj_iff.mp h with ⟨c, rfl⟩
  rw [Perm.permIndex_conj, Perm.permIndex_zpow_of_gcd_eq_one hn]

/-- **Rationally conjugate elements of a permutation group have the same index** (LMFDB
`gg.malle_b`, `gg.index`). -/
lemma IsRationallyConj.permIndex_coe_eq {G : Subgroup (Perm α)} {x y : G}
    (h : IsRationallyConj x y) : (x : Perm α).permIndex = (y : Perm α).permIndex := by
  rcases h with ⟨n, hn, h⟩
  exact permIndex_eq ⟨n, by rwa [Subgroup.orderOf_coe], by simpa using G.subtype.map_isConj h⟩

namespace RatConjClasses

lemma mk_eq_mk_one_iff {G : Type*} [Group G] {x : G} : mk x = mk 1 ↔ x = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ h ▸ rfl⟩
  rcases (Quotient.exact h : IsRationallyConj x 1).symm with ⟨n, -, h⟩
  rwa [one_zpow, isConj_one_right] at h

variable {G : Subgroup (Perm α)}

/-- The **index** `ind(C)` (LMFDB `gg.malle_b`, `gg.index`) of a rational conjugacy class `C` of a
permutation group `G`: the index of any of its elements, which does not depend on the element
(`IsRationallyConj.permIndex_coe_eq`). -/
noncomputable def permIndex : RatConjClasses G → ℕ :=
  Quotient.lift (fun x : G ↦ (x : Perm α).permIndex) fun _ _ ↦ IsRationallyConj.permIndex_coe_eq

@[simp]
lemma permIndex_mk (x : G) : (mk x).permIndex = (x : Perm α).permIndex :=
  rfl

end RatConjClasses

namespace Subgroup

variable (G : Subgroup (Perm α))

lemma image_mk_minPermIndexElements : RatConjClasses.mk '' G.minPermIndexElements =
    {C | C ≠ RatConjClasses.mk 1 ∧ C.permIndex = G.minPermIndex} := by
  refine Set.ext fun C ↦ ⟨?_, fun ⟨hC, hC'⟩ ↦ ?_⟩
  · rintro ⟨g, ⟨hg, hg'⟩, rfl⟩
    exact ⟨RatConjClasses.mk_eq_mk_one_iff.not.mpr hg, hg'⟩
  · rcases Quotient.exists_rep C with ⟨g, rfl⟩
    exact ⟨g, ⟨fun hg ↦ hC (hg ▸ rfl), hC'⟩, rfl⟩

/-- **Malle's constant `b(G)` is the number of non-identity rational conjugacy classes of `G` of
minimal index** (LMFDB `gg.malle_b`). -/
lemma malleB_eq_card_ne_mk_one : G.malleB =
    Nat.card {C : RatConjClasses G // C ≠ RatConjClasses.mk 1 ∧ C.permIndex = G.minPermIndex} := by
  rw [malleB, image_mk_minPermIndexElements]
  rfl

variable [Finite α]

lemma minPermIndex_pos (hG : G ≠ ⊥) : 0 < G.minPermIndex := by
  rcases ne_bot_iff_exists_ne_one.mp hG with ⟨g₀, hg₀⟩
  rcases Nat.sInf_mem (s := (fun g : G ↦ (g : Perm α).permIndex) '' {g | g ≠ 1})
    ⟨_, g₀, hg₀, rfl⟩ with ⟨g, hg, hg'⟩
  rw [minPermIndex, ← hg']
  exact Nat.sub_pos_of_lt <| orbitCount_lt_card_of_ne_one <| by simpa using hg

/-- **Malle's constant `b(G)` counts the rational conjugacy classes `C` of `G` with
`ind(C) = a(G)⁻¹`** (LMFDB `gg.malle_b`), for a nontrivial permutation group `G` of a finite set:
`a(G)⁻¹` is then the least index of a non-identity element, which the class of the identity, of
index `0`, does not have. For the trivial group `a(G)⁻¹` is not defined, and `b(G) = 0` is the
number of non-identity classes (`Subgroup.malleB_eq_card_ne_mk_one`). -/
lemma malleB_eq_card_permIndex_eq_malleA_inv (hG : G ≠ ⊥) :
    G.malleB = Nat.card {C : RatConjClasses G // (C.permIndex : ℚ) = G.malleA⁻¹} := by
  rw [malleB_eq_card_ne_mk_one]
  refine Nat.card_congr <| Equiv.subtypeEquivRight fun C ↦ ?_
  rw [malleA, inv_inv, Nat.cast_inj]
  refine ⟨fun h ↦ h.2, fun h ↦ ⟨fun hC ↦ (G.minPermIndex_pos hG).ne ?_, h⟩⟩
  rw [← h, hC, RatConjClasses.permIndex_mk, OneMemClass.coe_one, Perm.permIndex_one]

end Subgroup
