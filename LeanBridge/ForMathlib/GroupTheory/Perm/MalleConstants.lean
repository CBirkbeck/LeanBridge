import LeanBridge.ForMathlib.GroupTheory.RationalConjugacy
import TauCeti.GroupTheory.Perm.SwapFactors

/-!
# Malle's constants and concentrated permutation groups

Let `G` be a group of permutations of a finite set `α` with `n` elements, a subgroup of `S_n`. The
index of a permutation `g` is `ind(g) = n - c(g)`, where `c(g)` is its number of orbits (Tau Ceti's
`TauCeti.orbitCount`), LMFDB `gg.index`; it is the least number of transpositions whose product is
`g` (Tau Ceti's `Equiv.Perm.isLeast_card_sub_orbitCount`), and it vanishes exactly at the identity.
Malle's constants record the least index `ind(G)` of a non-identity element of `G`: `a(G)` is its
inverse, and `b(G)` the number of rational conjugacy classes (LeanBridge's `RatConjClasses`) of `G`
of index `ind(G)`. The group `G` is concentrated if the elements of index `ind(G)` generate a proper
subgroup, and semiconcentrated if one of them has a proper normal closure.

## Main definitions

* `Equiv.Perm.permIndex`: the index `ind(g) = n - c(g)` of a permutation.
* `Subgroup.minPermIndex`: the least index of a non-identity element.
* `Subgroup.malleA` (LMFDB `gg.malle_a`): Malle's constant `a(G)`.
* `Subgroup.malleB` (LMFDB `gg.malle_b`): Malle's constant `b(G)`.
* `Subgroup.IsConcentrated` (LMFDB `gg.concentrated`): concentrated permutation groups.
* `Subgroup.IsSemiconcentrated` (LMFDB `gg.semiconcentrated`): semiconcentrated permutation groups.

## Main results

* `Subgroup.malleA_bot`: `a(G) = 0` for the trivial group.
-/

open Equiv TauCeti

variable {α : Type*}

namespace Equiv.Perm

/-- The **index** of a permutation `g` of a finite set `α` (LMFDB `gg.index`):
`ind(g) = |α| - c(g)`, where `c(g)` is the number of orbits of `g`, the least number of
transpositions whose product is `g` (`Equiv.Perm.isLeast_card_sub_orbitCount`). -/
noncomputable def permIndex (g : Perm α) : ℕ :=
  Nat.card α - orbitCount g

end Equiv.Perm

namespace Subgroup

variable (G : Subgroup (Perm α))

/-- The least index `ind(G)` of a non-identity element of a permutation group `G` (LMFDB
`gg.malle_a`), and `0` when `G` is trivial. -/
noncomputable def minPermIndex : ℕ :=
  sInf ((fun g : G ↦ (g : Perm α).permIndex) '' {g | g ≠ 1})

/-- The non-identity elements of `G` of least index `ind(G)`, the **elements of minimal index** of
LMFDB `gg.concentrated`. -/
def minPermIndexElements : Set G :=
  {g | g ≠ 1 ∧ (g : Perm α).permIndex = G.minPermIndex}

/-- **Malle's constant** `a(G) = 1 / min {ind(g) | g ∈ G, g ≠ 1}` (LMFDB `gg.malle_a`) of a
permutation group `G`, and `0` when `G` is trivial (`Subgroup.malleA_bot`). -/
noncomputable def malleA : ℚ :=
  (G.minPermIndex : ℚ)⁻¹

/-- **`a(G) = 0` for the trivial group.** -/
lemma malleA_bot : malleA (⊥ : Subgroup (Perm α)) = 0 := by
  have h : {g : (⊥ : Subgroup (Perm α)) | g ≠ 1} = ∅ :=
    Set.eq_empty_of_forall_notMem fun g hg ↦ hg (Subsingleton.elim g 1)
  simp [malleA, minPermIndex, h]

/-- **Malle's constant** `b(G)` (LMFDB `gg.malle_b`) of a permutation group `G`: the number of
rational conjugacy classes (`RatConjClasses`) of `G` of index `ind(G) = a(G)⁻¹`, that is, of the
rational conjugacy classes that meet `minPermIndexElements`. Rationally conjugate elements have the
same index, so these classes consist of non-identity elements of minimal index; `b(G) = 0` for
trivial `G`. -/
noncomputable def malleB : ℕ :=
  Nat.card (RatConjClasses.mk '' G.minPermIndexElements)

/-- A permutation group `G` is **concentrated** (LMFDB `gg.concentrated`) if it is transitive and
the subgroup generated by its non-identity elements of minimal index (`minPermIndexElements`) is a
proper subgroup of `G`. The identity, of index `0`, is excluded, as it must be for the notion to be
meaningful. -/
def IsConcentrated : Prop :=
  MulAction.IsPretransitive G α ∧ closure G.minPermIndexElements ≠ ⊤

/-- A permutation group `G` is **semiconcentrated** (LMFDB `gg.semiconcentrated`) if it is
transitive and some non-identity element of minimal index (`minPermIndexElements`) has a normal
closure, the least normal subgroup of `G` containing it, which is a proper subgroup of `G`. -/
def IsSemiconcentrated : Prop :=
  MulAction.IsPretransitive G α ∧ ∃ g ∈ G.minPermIndexElements, normalClosure {g} ≠ ⊤

end Subgroup
