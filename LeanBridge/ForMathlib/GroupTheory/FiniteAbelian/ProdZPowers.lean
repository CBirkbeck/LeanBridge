import Mathlib.GroupTheory.FiniteAbelian.Basic

/-!
# Finite commutative groups as internal direct products of cyclic subgroups

The structure theorem (Mathlib's `CommGroup.equiv_prod_multiplicative_zmod_of_finite`) gives an
abstract isomorphism of a finite commutative group `G` with a product of cyclic groups. Pulling the
standard generators of the factors back to `G` gives elements `g_i` of `G` such that `G` is the
internal direct product of the cyclic subgroups they generate: the map `∏ᵢ ⟨g_i⟩ → G` sending
`(x_i)` to `∏ᵢ x_i` is bijective. In particular the `g_i` generate `G`.

## Main results

* `CommGroup.exists_bijective_prod_zpowers`: a finite commutative group is the internal direct
  product of the cyclic subgroups generated by suitable elements.
* `CommGroup.closure_range_eq_top_of_surjective_prod_zpowers`: elements whose cyclic subgroups
  multiply onto `G` generate `G`.
-/

open Subgroup

namespace CommGroup

variable {G : Type*} [CommGroup G]

variable (G) in
/-- **A finite commutative group is the internal direct product of the cyclic subgroups generated by
suitable elements `g_i`**: the map `∏ᵢ ⟨g_i⟩ → G`, `(x_i) ↦ ∏ᵢ x_i`, is bijective. -/
lemma exists_bijective_prod_zpowers [Finite G] : ∃ (ι : Type) (_ : Fintype ι) (g : ι → G),
    Function.Bijective fun x : (Π i, zpowers (g i)) ↦ ∏ i, (x i : G) := by
  classical
  rcases equiv_prod_multiplicative_zmod_of_finite G with ⟨ι, hι, n, -, ⟨e⟩⟩
  let g (i : ι) : G := e.symm <| Pi.mulSingle i <| Multiplicative.ofAdd 1
  have hpow (i : ι) (z : ℤ) : e.symm (Pi.mulSingle i (Multiplicative.ofAdd 1 ^ z)) = g i ^ z := by
    rw [Pi.mulSingle_zpow, map_zpow]
  let Ψ (c : Π i, Multiplicative (ZMod (n i))) (i : ι) : zpowers (g i) :=
    ⟨e.symm (Pi.mulSingle i (c i)), mem_zpowers_iff.mpr ⟨ZMod.cast (c i).toAdd, by
      rw [← hpow, ← ofAdd_zsmul, zsmul_one, ZMod.intCast_zmod_cast, ofAdd_toAdd]⟩⟩
  have hΨ : Function.Bijective Ψ := by
    refine ⟨fun c c' h ↦ funext fun i ↦ Pi.mulSingle_injective i <| e.symm.injective <|
      congrArg Subtype.val <| congrFun h i, fun x ↦ ?_⟩
    choose z hz using fun i ↦ mem_zpowers_iff.mp (x i).2
    exact ⟨fun i ↦ Multiplicative.ofAdd 1 ^ z i,
      funext fun i ↦ Subtype.ext <| (hpow i (z i)).trans (hz i)⟩
  have h : (fun x : (Π i, zpowers (g i)) ↦ ∏ i, (x i : G)) ∘ Ψ = e.symm := funext fun c ↦
    (map_prod e.symm _ _).symm.trans <| congrArg e.symm <| Finset.univ_prod_mulSingle c
  exact ⟨ι, hι, g, (hΨ.of_comp_iff _).mp <| h ▸ e.symm.bijective⟩

/-- **Elements `g_i` such that `G` is the product of the cyclic subgroups `⟨g_i⟩` generate `G`.** -/
lemma closure_range_eq_top_of_surjective_prod_zpowers {ι : Type*} [Fintype ι] {g : ι → G}
    (h : Function.Surjective fun x : (Π i, zpowers (g i)) ↦ ∏ i, (x i : G)) :
    closure (Set.range g) = ⊤ := by
  refine eq_top_iff.mpr fun y _ ↦ ?_
  rcases h y with ⟨x, rfl⟩
  exact prod_mem fun i _ ↦ zpowers_le.mpr (subset_closure <| Set.mem_range_self i) (x i).2

end CommGroup
