import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices
import TauCeti.Combinatorics.PermutationTriple.EulerCharacteristic

/-!
# The genus of a subgroup of the modular group

The genus of a subgroup `Γ` of finite index of `SL(2, ℤ)` is the genus of the compact Riemann
surface `X(Γ)` obtained by adjoining the cusps of `Γ` to `Γ \ ℍ` (Tau Ceti's
`Subgroup.CompactifiedQuotient` of the image of `Γ` in `PSL(2, ℝ)`). The map `X(Γ) → X(1)` to the
sphere `X(1)` has degree `μ`, the number of cosets of `±Γ = Γ ⊔ {±1}` in `SL(2, ℤ)`, and is branched
only over the images of `i`, of `e^{2πi/3}` and of the cusp `∞`, with monodromy the action of `S`,
`(S T)⁻¹` and `T` on these cosets. The Riemann–Hurwitz formula then reads

`2 - 2 g = c(S) + c(S T) + c(T) - μ`,

where `c(σ)` is the number of orbits of `σ` on the cosets. This is the genus of the permutation
triple `(S, (S T)⁻¹, T)`, Tau Ceti's `PermutationTriple.genus`, which we take as the definition.
Tau Ceti defines the genus of a function field and of a scheme, but not of a compact Riemann
surface, and does not identify `X(Γ)` with an algebraic curve, so the identification of this
number with the topological genus of `X(Γ)` is not proved here.

## Main definitions

* `ModularGroup.cosetPermutationTriple`: the permutation triple of the action of `S`, `(S T)⁻¹` and
  `T` on the cosets of `±Γ`.
* `ModularGroup.genus` (LMFDB `group.sl2z.genus_subgroup`).

## Main results

* `ModularGroup.isConnected_cosetPermutationTriple`: the triple is connected, since `S` and `S T`
  generate `SL(2, ℤ)`, so that its genus has its geometric meaning.
* `ModularGroup.two_sub_two_mul_genus`: the Riemann–Hurwitz formula above.
-/

open Equiv MulAction TauCeti
open scoped MatrixGroups

namespace ModularGroup

lemma closure_S_mul_T_inv : Subgroup.closure {S, (S * T)⁻¹} = ⊤ := by
  refine eq_top_iff.mpr <| SpecialLinearGroup.SL2Z_generators ▸ (Subgroup.closure_le _).mpr ?_
  rintro _ (rfl | rfl)
  · exact Subgroup.subset_closure (Set.mem_insert _ _)
  · simpa using mul_mem (inv_mem (Subgroup.subset_closure (Set.mem_insert _ _)))
      (inv_mem (Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl) :
        (S * T)⁻¹ ∈ Subgroup.closure {S, (S * T)⁻¹}))

variable (Γ : Subgroup SL(2, ℤ))

/-- The cosets of `±Γ = Γ ⊔ {±1}` in `SL(2, ℤ)`, the centre of `SL(2, ℤ)` being `{±1}`. The group
`SL(2, ℤ)` acts on them through `PSL(2, ℤ)`, and they are the cosets of the image of `Γ` in
`PSL(2, ℤ)`. -/
abbrev Cosets : Type :=
  SL(2, ℤ) ⧸ (Γ ⊔ Subgroup.center SL(2, ℤ))

variable [Γ.FiniteIndex]

instance : Finite (Cosets Γ) :=
  haveI : (Γ ⊔ Subgroup.center SL(2, ℤ)).FiniteIndex := Γ.finiteIndex_of_le le_sup_left
  inferInstance

/-- The permutation triple of the action of `S`, `(S * T)⁻¹` and `T` on the cosets of `±Γ`, numbered
by `Finite.equivFin`: the monodromy of the covering `X(Γ) → X(1)` around the images of `i`, of
`e^{2πi/3}` and of the cusp `∞`. -/
noncomputable def cosetPermutationTriple : PermutationTriple (Nat.card (Cosets Γ)) :=
  PermutationTriple.ofTwo ((Finite.equivFin (Cosets Γ)).permCongrHom (toPerm S))
    ((Finite.equivFin (Cosets Γ)).permCongrHom (toPerm (S * T)⁻¹))

lemma cosetPermutationTriple_σinf :
    (cosetPermutationTriple Γ).σinf = (Finite.equivFin (Cosets Γ)).permCongrHom (toPerm T) := by
  rw [cosetPermutationTriple, PermutationTriple.ofTwo_σinf, ← map_mul, ← map_inv,
    ← toPermHom_apply, ← toPermHom_apply, ← toPermHom_apply, ← map_mul, ← map_inv, mul_inv_rev,
    inv_inv, inv_mul_cancel_left]

/-- **The permutation triple of `±Γ` is connected**: its monodromy group is the image of
`SL(2, ℤ)`, which is generated by `S` and `S T`, and acts transitively on the cosets. -/
lemma isConnected_cosetPermutationTriple : (cosetPermutationTriple Γ).IsConnected := by
  refine ⟨Nat.card_pos.ne', ⟨fun i j ↦ ?_⟩⟩
  let φ : SL(2, ℤ) →* Perm (Fin (Nat.card (Cosets Γ))) :=
    (Finite.equivFin (Cosets Γ)).permCongrHom.toMonoidHom.comp (toPermHom SL(2, ℤ) (Cosets Γ))
  have hφ : φ.range = (cosetPermutationTriple Γ).monodromyGroup := by
    rw [MonoidHom.range_eq_map, ← closure_S_mul_T_inv, MonoidHom.map_closure, Set.image_pair]
    rfl
  rcases exists_smul_eq SL(2, ℤ) ((Finite.equivFin _).symm i) ((Finite.equivFin _).symm j) with
    ⟨g, hg⟩
  refine ⟨⟨φ g, hφ ▸ ⟨g, rfl⟩⟩, ?_⟩
  simp [φ, hg]

/-- The **genus** of a subgroup `Γ` of finite index of the modular group `SL(2, ℤ)` (LMFDB
`group.sl2z.genus_subgroup`): the genus of the compactification `X(Γ)` of `Γ \ ℍ`, computed by the
Riemann–Hurwitz formula from the action of `S`, `S T` and `T` on the cosets of `±Γ`
(`ModularGroup.two_sub_two_mul_genus`).

This formula is the definition here. Its identification with the topological genus of `X(Γ)`, the
Riemann surface Tau Ceti builds as `Subgroup.CompactifiedQuotient`, needs the genus of a compact
Riemann surface and the Riemann–Hurwitz theorem, which are not available. -/
noncomputable def genus : ℕ :=
  (cosetPermutationTriple Γ).genus

/-- **Riemann–Hurwitz formula for `X(Γ) → X(1)`**: `2 - 2 g = c(S) + c(S T) + c(T) - μ`, where
`c(σ)` is the number of orbits of `σ` on the `μ` cosets of `±Γ`. -/
lemma two_sub_two_mul_genus : 2 - 2 * (genus Γ : ℤ) = orbitCount (toPerm S : Perm (Cosets Γ)) +
    orbitCount (toPerm (S * T) : Perm (Cosets Γ)) + orbitCount (toPerm T : Perm (Cosets Γ)) -
      Nat.card (Cosets Γ) := by
  rw [genus, (isConnected_cosetPermutationTriple Γ).two_sub_two_mul_genus,
    PermutationTriple.eulerChar_def, cosetPermutationTriple_σinf]
  simp only [cosetPermutationTriple, PermutationTriple.ofTwo_σ0, PermutationTriple.ofTwo_σ1,
    permCongrHom_coe, orbitCount_permCongr]
  rw [← toPermHom_apply SL(2, ℤ) (Cosets Γ) (S * T)⁻¹, map_inv, Perm.orbitCount_inv,
    toPermHom_apply]

lemma genus_top : genus ⊤ = 0 := by
  have h : Nat.card (Cosets (⊤ : Subgroup SL(2, ℤ))) = 1 := by
    simp
  rw [genus, ← PermutationTriple.genus_transport (finCongr h),
    PermutationTriple.genus_of_degree_one]

end ModularGroup
