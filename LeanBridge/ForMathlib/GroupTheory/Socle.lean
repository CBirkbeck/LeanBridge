import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# The socle of a group

## Main definitions

* `Subgroup.socle` (LMFDB `group.socle`): the subgroup generated by the minimal normal subgroups.
-/

namespace Subgroup

variable (G : Type*) [Group G]

/-- The **socle** `soc(G)` of a group `G` (LMFDB `group.socle`): the subgroup generated by the
minimal normal subgroups of `G`, the nontrivial normal subgroups `N` such that every normal subgroup
of `G` contained in `N` is `⊥` or `N`. It is `⊥` when there are none. -/
def socle : Subgroup G :=
  sSup {N | N.Normal ∧ N ≠ ⊥ ∧ ∀ H : Subgroup G, H.Normal → H ≤ N → H = ⊥ ∨ H = N}

instance : (socle G).Normal :=
  sSup_normal _ fun _ h ↦ h.1

variable {G}

lemma le_socle {N : Subgroup G} [N.Normal] (hN : N ≠ ⊥)
    (h : ∀ H : Subgroup G, H.Normal → H ≤ N → H = ⊥ ∨ H = N) : N ≤ socle G :=
  le_sSup ⟨inferInstance, hN, h⟩

end Subgroup
