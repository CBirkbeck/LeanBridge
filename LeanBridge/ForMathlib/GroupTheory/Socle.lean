import LeanBridge.ForMathlib.GroupTheory.MinimalNormal
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# The socle of a group

## Main definitions

* `Subgroup.socle` (LMFDB `group.socle`): the subgroup generated by the minimal normal subgroups.
-/

namespace Subgroup

variable (G : Type*) [Group G]

/-- The **socle** `soc(G)` of a group `G` (LMFDB `group.socle`): the subgroup generated by the
minimal normal subgroups of `G` (`Subgroup.IsMinimalNormal`). It is `⊥` when there are none. -/
def socle : Subgroup G :=
  sSup {N | N.IsMinimalNormal}

instance : (socle G).Normal :=
  sSup_normal _ fun _ h ↦ h.1.1

variable {G}

lemma le_socle {N : Subgroup G} (hN : N.IsMinimalNormal) : N ≤ socle G :=
  le_sSup hN

end Subgroup
