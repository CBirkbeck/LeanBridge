import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.GL2Dickson

/-!
# Generators of the subgroups of `GL₂(𝔽_p)` named by Sutherland's labels

Sutherland's labels of classes `B`, `Cs` and `Ns` (arXiv:1504.07618v7, §6.4) name subgroups of
`GL₂(𝔽_p)` by generators: `!![a, 0; 0, 1/a]` for the determinant-one diagonal part, and elements of
determinant `r`, `r` the least positive integer generating the determinant of the group. This file
proves that every subgroup of the right shape is generated in this way (Sutherland's Lemma 3.3 and
Lemma 3.4 for the Borel and split Cartan cases).

## Main definitions

* `Matrix.GeneralLinearGroup.detOneDiag`: the homomorphism `u ↦ !![u, 0; 0, 1/u]`.

## Main results

* `Matrix.GeneralLinearGroup.exists_zpowers_det_eq`: the unit `r` generates the determinant of a
  subgroup of index `d`.
* `Matrix.GeneralLinearGroup.exists_mem_iff_mem_zpowers_detOneDiag`: the determinant-one diagonal
  part of a subgroup is generated by some `!![a, 0; 0, 1/a]`, `a` of the right order.
* `Matrix.GeneralLinearGroup.le_of_det_ker_le`: a subgroup with the determinant-one part of `K` and
  an element whose determinant generates that of `K` contains `K`.
* `Matrix.GeneralLinearGroup.exists_eq_labelCsABD`, `Matrix.GeneralLinearGroup.exists_eq_labelBABD`:
  subgroups of `Cs`, and subgroups of `B` containing `!![1, 1; 0, 1]`, are named by `Cs.a.b[d]` and
  `B.a.b[d]`.
* `Matrix.GeneralLinearGroup.exists_eq_labelNsABD`,
  `Matrix.GeneralLinearGroup.exists_eq_labelNsABCD`: subgroups of `Ns` not in `Cs` are named by
  `Ns.a.b[d]` or by `Ns.a.b.c[d]`.
-/

open Matrix MulAction TauCeti

open scoped MatrixGroups Pointwise

namespace Matrix.GeneralLinearGroup

variable {p : ℕ} [Fact p.Prime] {K C : Subgroup (GL (Fin 2) (ZMod p))} {k x : GL (Fin 2) (ZMod p)}
  (u : (ZMod p)ˣ)

variable (p) in
/-- The homomorphism `u ↦ !![u, 0; 0, 1/u]`, onto the determinant-one part of the group of diagonal
matrices of `GL₂(𝔽_p)`. -/
noncomputable def detOneDiag : (ZMod p)ˣ →* GL (Fin 2) (ZMod p) where
  toFun u := diagGL ![u, u⁻¹]
  map_one' := by
    rw [← map_one diagGL]
    congr 1
    funext i
    fin_cases i <;> simp
  map_mul' u v := by
    rw [← map_mul]
    congr 1
    funext i
    fin_cases i <;> simp [mul_comm]

lemma val_detOneDiag : (detOneDiag p u).val = !![(u : ZMod p), 0; 0, (u : ZMod p)⁻¹] := by
  simp only [detOneDiag, MonoidHom.coe_mk]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [-ZMod.inv_coe_unit]

lemma detOneDiag_injective : Function.Injective (detOneDiag p) :=
  (injective_iff_map_eq_one _).mpr fun u hu ↦ Units.ext <| by
    have h : (detOneDiag p u).val 0 0 = (1 : GL (Fin 2) (ZMod p)).val 0 0 := by
      rw [hu]
    simpa [val_detOneDiag, -ZMod.inv_coe_unit] using h

lemma detOneDiag_mem_diagonalTorus : detOneDiag p u ∈ diagonalTorus (ZMod p) 2 :=
  mem_diagonalTorus_of_fin_two (ZMod p) (by simp [val_detOneDiag, -ZMod.inv_coe_unit])
    (by simp [val_detOneDiag, -ZMod.inv_coe_unit])

lemma detOneDiag_mem_det_ker : detOneDiag p u ∈ (det : GL (Fin 2) (ZMod p) →* (ZMod p)ˣ).ker :=
  MonoidHom.mem_ker.mpr <| Units.ext <| by
    rw [val_det_apply, val_detOneDiag, Matrix.det_fin_two_of]
    simp [-ZMod.inv_coe_unit]

lemma exists_eq_detOneDiag (hx : x ∈ diagonalTorus (ZMod p) 2)
    (hdet : x ∈ (det : GL (Fin 2) (ZMod p) →* (ZMod p)ˣ).ker) :
    ∃ u : (ZMod p)ˣ, x = detOneDiag p u := by
  have h₀₁ : x 0 1 = 0 := mem_diagonalTorus_iff.mp hx (by decide)
  have h₁₀ : x 1 0 = 0 := mem_diagonalTorus_iff.mp hx (by decide)
  have hd : x 0 0 * x 1 1 = 1 := by
    have h : (det x).val = 1 := by
      rw [MonoidHom.mem_ker.mp hdet, Units.val_one]
    rwa [val_det_apply, Matrix.det_fin_two, h₀₁, h₁₀, zero_mul, sub_zero] at h
  refine ⟨Units.mkOfMulEqOne _ _ hd, Units.ext ?_⟩
  rw [val_detOneDiag]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [h₀₁, h₁₀, eq_inv_of_mul_eq_one_right hd]

lemma natCard_inf_torus_inf_ker :
    Nat.card ↥(K ⊓ diagonalTorus (ZMod p) 2 ⊓ (det : GL (Fin 2) (ZMod p) →* (ZMod p)ˣ).ker) =
      Nat.card (K.comap (detOneDiag p)) := by
  refine (Nat.card_congr (Equiv.ofBijective (fun u : K.comap (detOneDiag p) ↦
    (⟨detOneDiag p u, ⟨u.2, detOneDiag_mem_diagonalTorus _⟩, detOneDiag_mem_det_ker _⟩ :
      ↥(K ⊓ diagonalTorus (ZMod p) 2 ⊓ (det : GL (Fin 2) (ZMod p) →* (ZMod p)ˣ).ker)))
    ⟨fun u v h ↦ Subtype.ext <| detOneDiag_injective <| congrArg Subtype.val h, fun x ↦ ?_⟩)).symm
  rcases exists_eq_detOneDiag x.2.1.2 x.2.2 with ⟨u, hu⟩
  exact ⟨⟨u, by rw [Subgroup.mem_comap, ← hu]; exact x.2.1.1⟩, Subtype.ext hu.symm⟩

variable (K) in
/-- **The determinant-one diagonal part of a subgroup of `GL₂(𝔽_p)` is generated by some
`!![a, 0; 0, 1/a]`**, with `a` a positive integer of order the order of this part: Sutherland's
integer `a` of `B.a.b[d]`, `Cs.a.b[d]`, `Ns.a.b[d]`, `Ns.a.b.c[d]` (`IsDetOneDiagGen`). -/
lemma exists_mem_iff_mem_zpowers_detOneDiag :
    ∃ u₀ : (ZMod p)ˣ, 0 < (u₀ : ZMod p).val ∧ IsDetOneDiagGen p (u₀ : ZMod p).val K ∧
      ∀ u, detOneDiag p u ∈ K ↔ u ∈ Subgroup.zpowers u₀ := by
  rcases (K.comap (detOneDiag p)).isCyclic_iff_exists_zpowers_eq_top.mp inferInstance with ⟨g, hg⟩
  refine ⟨g, ZMod.val_pos.mpr g.ne_zero, ?_, fun u ↦ by rw [hg, Subgroup.mem_comap]⟩
  rw [IsDetOneDiagGen, natCard_inf_torus_inf_ker, ZMod.natCast_zmod_val, orderOf_units, ← hg,
    Nat.card_zpowers]

/-- **The unit `r` generates the determinant of a subgroup of index `d`.** Here `r` is
`ZMod.leastGenOfIndex p d`, Sutherland's least positive integer generating the subgroup of index `d`
of `𝔽_pˣ`. -/
lemma exists_zpowers_det_eq (D : Subgroup (ZMod p)ˣ) :
    ∃ R : (ZMod p)ˣ, (R : ZMod p) = (ZMod.leastGenOfIndex p D.index : ZMod p) ∧
      Subgroup.zpowers R = D := by
  have hd : D.index ∣ p - 1 := by
    have h : D.index ∣ Nat.card (ZMod p)ˣ := D.index_dvd_card
    rwa [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient, Nat.totient_prime Fact.out] at h
  have hp : p - 1 ≠ 0 := Nat.sub_ne_zero_of_lt (Fact.out : p.Prime).one_lt
  have hord : orderOf (ZMod.leastGenOfIndex p D.index : ZMod p) = (p - 1) / D.index :=
    ZMod.orderOf_leastGenOfIndex p D.index hd
  have hpos : 0 < (p - 1) / D.index := Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hp) hd)
    (Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite)
  have hne : (ZMod.leastGenOfIndex p D.index : ZMod p) ≠ 0 := by
    intro h0
    rw [h0, orderOf_zero] at hord
    omega
  refine ⟨Units.mk0 _ hne, rfl, ?_⟩
  rw [IsCyclic.subgroup_eq_iff_index_eq]
  have hcard : Nat.card (Subgroup.zpowers (Units.mk0 _ hne)) * (Subgroup.zpowers
      (Units.mk0 (ZMod.leastGenOfIndex p D.index : ZMod p) hne)).index = p - 1 := by
    rw [Subgroup.card_mul_index, Nat.card_eq_fintype_card, ZMod.card_units_eq_totient,
      Nat.totient_prime Fact.out]
  rw [Nat.card_zpowers, ← orderOf_units, Units.val_mk0, hord] at hcard
  exact Nat.eq_of_mul_eq_mul_left hpos (hcard.trans (Nat.div_mul_cancel hd).symm)

variable (K) in
lemma exists_mem_det_eq : ∃ R : (ZMod p)ˣ, (R : ZMod p) =
    (ZMod.leastGenOfIndex p (K.map det).index : ZMod p) ∧ Subgroup.zpowers R = K.map det :=
  exists_zpowers_det_eq _

/-- **A subgroup containing the determinant-one part of `K` and an element of `K` whose determinant
generates that of `K` contains `K`.** -/
lemma le_of_det_ker_le {w : GL (Fin 2) (ZMod p)} (hw : w ∈ C)
    (hdet : Subgroup.zpowers (det w) = K.map det) (hker : K ⊓ det.ker ≤ C) (hwK : w ∈ K) :
    K ≤ C := by
  intro k hk
  rcases Subgroup.mem_zpowers_iff.mp (hdet ▸ Subgroup.mem_map_of_mem _ hk :
    det k ∈ Subgroup.zpowers (det w)) with ⟨j, hj⟩
  have h₁ : k * (w ^ j)⁻¹ ∈ C :=
    hker <| Subgroup.mem_inf.mpr ⟨mul_mem hk (inv_mem (zpow_mem hwK _)),
      MonoidHom.mem_ker.mpr <| by rw [map_mul, map_inv, map_zpow, ← hj, mul_inv_cancel]⟩
  have h₂ : k = (k * (w ^ j)⁻¹) * w ^ j := by
    rw [inv_mul_cancel_right]
  rw [h₂]
  exact mul_mem h₁ (zpow_mem hw _)

lemma det_ker_diag_le {u₀ : (ZMod p)ˣ} (hu₀ : ∀ u, detOneDiag p u ∈ K ↔ u ∈ Subgroup.zpowers u₀)
    (hC : detOneDiag p u₀ ∈ C) (hk : k ∈ K) (hkd : k ∈ diagonalTorus (ZMod p) 2)
    (hk₁ : k ∈ (det : GL (Fin 2) (ZMod p) →* (ZMod p)ˣ).ker) : k ∈ C := by
  rcases exists_eq_detOneDiag hkd hk₁ with ⟨u, rfl⟩
  rcases Subgroup.mem_zpowers_iff.mp ((hu₀ u).mp hk) with ⟨j, rfl⟩
  rw [map_zpow]
  exact zpow_mem hC j

lemma mem_preimage_of_val_eq {M : Matrix (Fin 2) (Fin 2) (ZMod p)}
    {S : Set (Matrix (Fin 2) (Fin 2) (ZMod p))} (hx : x.val = M) (hM : M ∈ S) :
    x ∈ Subgroup.closure (Units.val ⁻¹' S) :=
  Subgroup.subset_closure <| Set.mem_preimage.mpr (hx ▸ hM)

/-- **A subgroup of `Cs` is generated by `!![a, 0; 0, 1/a]` and `!![b, 0; 0, r/b]`** for positive
integers `a`, `b`, with `a` fixed by the determinant-one part, so it is the group `Cs.a.b[d]`
(Sutherland, arXiv:1504.07618v7, §6.4). -/
lemma exists_eq_labelCsABD (hK : K ≤ diagonalTorus (ZMod p) 2) :
    ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ IsDetOneDiagGen p a K ∧ K = labelCsABD p (K.map det).index a b := by
  rcases exists_mem_iff_mem_zpowers_detOneDiag K with ⟨u₀, ha, hgen, hu₀⟩
  rcases exists_mem_det_eq K with ⟨R, hR, hRK⟩
  rcases (hRK ▸ Subgroup.mem_zpowers R : R ∈ K.map det) with ⟨w, hw, hwR⟩
  have h₀₁ : w 0 1 = 0 := mem_diagonalTorus_iff.mp (hK hw) (by decide)
  have h₁₀ : w 1 0 = 0 := mem_diagonalTorus_iff.mp (hK hw) (by decide)
  have hRv : w 0 0 * w 1 1 = R := by
    rw [← hwR, val_det_apply, Matrix.det_fin_two, h₀₁, zero_mul, sub_zero]
  have h₀₀ : w 0 0 ≠ 0 := fun h ↦ R.ne_zero (by rw [← hRv, h, zero_mul])
  refine ⟨_, (w 0 0).val, ha, ZMod.val_pos.mpr h₀₀, hgen, le_antisymm ?_ ?_⟩
  · refine le_of_det_ker_le (w := w) ?_ (by rw [hwR, hRK]) ?_ hw
    · refine mem_preimage_of_val_eq (M := !![((w 0 0).val : ZMod p), 0; 0, _]) ?_ (Or.inr rfl)
      rw [ZMod.natCast_zmod_val, ← hR, ← hRv]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [h₀₁, h₁₀, h₀₀]
    · refine fun k hk ↦ det_ker_diag_le hu₀ ?_ hk.1 (hK hk.1) hk.2
      refine mem_preimage_of_val_eq (M := !![((u₀ : ZMod p).val : ZMod p), 0; 0, _]) ?_ (Or.inl rfl)
      rw [ZMod.natCast_zmod_val, val_detOneDiag]
  · refine (Subgroup.closure_le _).mpr fun x hx ↦ ?_
    rcases hx with hx | hx
    · have hx' : x = detOneDiag p u₀ := Units.ext <| by
        rw [hx, ZMod.natCast_zmod_val, val_detOneDiag]
      rw [hx']
      exact (hu₀ u₀).mpr (Subgroup.mem_zpowers u₀)
    · have hx' : x = w := Units.ext <| by
        rw [Set.mem_singleton_iff.mp hx, ZMod.natCast_zmod_val, ← hR, ← hRv]
        ext i j
        fin_cases i <;> fin_cases j <;> simp [h₀₁, h₁₀, h₀₀]
      exact hx' ▸ hw

lemma mul_upperRightHom_mem_diagonalTorus (hk : k ∈ GL2Borel (ZMod p)) :
    k * upperRightHom (-(k 0 1 / k 0 0)) ∈ diagonalTorus (ZMod p) 2 := by
  have h₁₀ : k 1 0 = 0 := GL2Borel.mem_iff.mp hk
  have h₀₀ : k 0 0 ≠ 0 := by
    intro h₀₀
    have hdet : k.val.det ≠ 0 := (isUnits_det_units k).ne_zero
    rw [Matrix.det_fin_two, h₀₀, h₁₀] at hdet
    simp at hdet
  refine mem_diagonalTorus_of_fin_two (ZMod p) ?_ ?_
  · simp [Matrix.mul_apply]
    field_simp
    ring1
  · simp [Matrix.mul_apply, h₁₀]

/-- **A subgroup of the Borel group `B` containing `t = !![1, 1; 0, 1]` is generated by
`!![a, 0; 0, 1/a]`, `!![b, 0; 0, r/b]` and `t`** for positive integers `a`, `b`, with `a` fixed by
the determinant-one diagonal part, so it is the group `B.a.b[d]` (Lemma 3.3 of Sutherland,
arXiv:1504.07618v7, and §6.4). -/
lemma exists_eq_labelBABD (hK : K ≤ GL2Borel (ZMod p)) (ht : upperRightHom 1 ∈ K) :
    ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ IsDetOneDiagGen p a K ∧ K = labelBABD p (K.map det).index a b := by
  have hup (e : ZMod p) : upperRightHom e ∈ K :=
    upperRightHom_mem_of_mem one_ne_zero ht e
  rcases exists_mem_iff_mem_zpowers_detOneDiag K with ⟨u₀, ha, hgen, hu₀⟩
  rcases exists_mem_det_eq K with ⟨R, hR, hRK⟩
  rcases (hRK ▸ Subgroup.mem_zpowers R : R ∈ K.map det) with ⟨w₀, hw₀, hw₀R⟩
  have hdetup (e : ZMod p) : det (upperRightHom e) = 1 := Units.ext <| by
    rw [val_det_apply, val_upperRightHom, Matrix.det_fin_two_of]
    simp
  let w : GL (Fin 2) (ZMod p) := w₀ * upperRightHom (-(w₀ 0 1 / w₀ 0 0))
  have hw : w ∈ K := mul_mem hw₀ (hup _)
  have hwd : w ∈ diagonalTorus (ZMod p) 2 := mul_upperRightHom_mem_diagonalTorus (hK hw₀)
  have hwR : det w = R := by
    rw [map_mul, hw₀R, hdetup, mul_one]
  have h₀₁ : w 0 1 = 0 := mem_diagonalTorus_iff.mp hwd (by decide)
  have h₁₀ : w 1 0 = 0 := mem_diagonalTorus_iff.mp hwd (by decide)
  have hRv : w 0 0 * w 1 1 = R := by
    rw [← hwR, val_det_apply, Matrix.det_fin_two, h₀₁, zero_mul, sub_zero]
  have h₀₀ : w 0 0 ≠ 0 := fun h ↦ R.ne_zero (by rw [← hRv, h, zero_mul])
  have hwM : w.val = !![((w 0 0).val : ZMod p), 0;
      0, (ZMod.leastGenOfIndex p (K.map det).index : ZMod p) / ((w 0 0).val : ZMod p)] := by
    rw [ZMod.natCast_zmod_val, ← hR, ← hRv]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h₀₁, h₁₀, h₀₀]
  have hu₀M : (detOneDiag p u₀).val = !![((u₀ : ZMod p).val : ZMod p), 0;
      0, ((u₀ : ZMod p).val : ZMod p)⁻¹] := by
    rw [ZMod.natCast_zmod_val, val_detOneDiag]
  have htM : (upperRightHom (1 : ZMod p)).val = !![1, 1; 0, 1] := val_upperRightHom 1
  refine ⟨_, (w 0 0).val, ha, ZMod.val_pos.mpr h₀₀, hgen, le_antisymm ?_ ?_⟩
  · have htC : upperRightHom (1 : ZMod p) ∈ labelBABD p (K.map det).index (u₀ : ZMod p).val
        (w 0 0).val := mem_preimage_of_val_eq htM (Or.inr (Or.inr rfl))
    refine le_of_det_ker_le (w := w) (mem_preimage_of_val_eq hwM (Or.inr (Or.inl rfl)))
      (by rw [hwR, hRK]) (fun k hk ↦ ?_) hw
    have h₁ : k * upperRightHom (-(k 0 1 / k 0 0)) ∈ labelBABD p (K.map det).index
        (u₀ : ZMod p).val (w 0 0).val := det_ker_diag_le hu₀
      (mem_preimage_of_val_eq hu₀M (Or.inl rfl)) (mul_mem hk.1 (hup _))
      (mul_upperRightHom_mem_diagonalTorus (hK hk.1)) (MonoidHom.mem_ker.mpr <| by
        rw [map_mul, hdetup, mul_one]
        exact hk.2)
    have h₂ : k = (k * upperRightHom (-(k 0 1 / k 0 0))) *
        (upperRightHom (-(k 0 1 / k 0 0)))⁻¹ := by
      rw [mul_inv_cancel_right]
    rw [h₂]
    exact mul_mem h₁ (inv_mem (upperRightHom_mem_of_mem one_ne_zero htC _))
  · refine (Subgroup.closure_le _).mpr fun x hx ↦ ?_
    rcases hx with hx | hx | hx
    · have hx' : x = detOneDiag p u₀ := Units.ext (hx.trans hu₀M.symm)
      rw [hx']
      exact (hu₀ u₀).mpr (Subgroup.mem_zpowers u₀)
    · exact (Units.ext (hx.trans hwM.symm) : x = w) ▸ hw
    · exact (Units.ext (hx.trans htM.symm) : x = upperRightHom 1) ▸ ht

lemma exists_upperRightHom_conj_of_le_borel (hK : K ≤ GL2Borel (ZMod p)) (hxK : x ∈ K)
    (hx : orderOf x = p) :
    ∃ K' ∈ subgroupConjClass p K, K' ≤ GL2Borel (ZMod p) ∧ upperRightHom 1 ∈ K' := by
  have h₁₀ : x 1 0 = 0 := GL2Borel.mem_iff.mp (hK hxK)
  have h₀₀ : x 0 0 = 1 := by
    have h : ((x.val - 1) * (x.val - 1)) 0 0 = 0 := by
      rw [mul_self_sub_one_eq_zero hx]
      rfl
    simp [Matrix.mul_apply, h₁₀] at h
    exact sub_eq_zero.mp h
  rcases exists_eq_upperRightHom hx (by
    ext i
    fin_cases i <;> simp [h₀₀, h₁₀]) with ⟨s, hs, rfl⟩
  let t : GL (Fin 2) (ZMod p) := diagGL ![(Units.mk0 s hs)⁻¹, 1]
  have ht : t ∈ GL2Borel (ZMod p) := GL2Borel.mem_iff.mpr (by simp [t])
  refine ⟨_, map_conj_mem_subgroupConjClass K t, ?_, ?_⟩
  · rintro - ⟨k, hk, rfl⟩
    exact mul_mem (mul_mem ht (hK hk)) (inv_mem ht)
  · have h₁ : MulAut.conj t (upperRightHom s) = upperRightHom 1 := by
      refine Units.ext ?_
      simp only [MulAut.conj_apply, Units.val_mul, t, ← map_inv, diagGL_coe]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [hs, -ZMod.inv_coe_unit]
    exact h₁ ▸ Subgroup.mem_map_of_mem _ hxK

/-- **A subgroup of `Ns` not in `Cs` whose determinant-one part lies in `Cs` is generated by
`!![a, 0; 0, 1/a]` and `!![0, b; -r/b, 0]`** for positive integers `a`, `b`, with `a` fixed by the
determinant-one diagonal part: it is the group `Ns.a.b[d]` (Sutherland, arXiv:1504.07618v7,
§6.4). -/
lemma exists_eq_labelNsABD (hK : K ≤ labelNs p) (hne : ¬K ≤ diagonalTorus (ZMod p) 2)
    (hker : K ⊓ det.ker ≤ diagonalTorus (ZMod p) 2) :
    ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ IsDetOneDiagGen p a K ∧ K = labelNsABD p (K.map det).index a b := by
  rcases exists_mem_iff_mem_zpowers_detOneDiag K with ⟨u₀, ha, hgen, hu₀⟩
  rcases exists_mem_det_eq K with ⟨R, hR, hRK⟩
  rcases (hRK ▸ Subgroup.mem_zpowers R : R ∈ K.map det) with ⟨w, hw, hwR⟩
  have hwd : w ∉ diagonalTorus (ZMod p) 2 := by
    intro hwd
    rcases Set.not_subset.mp hne with ⟨x, hx, hxd⟩
    rcases Subgroup.mem_zpowers_iff.mp (hRK ▸ Subgroup.mem_map_of_mem _ hx :
      det x ∈ Subgroup.zpowers R) with ⟨j, hj⟩
    have h₁ : x * (w ^ j)⁻¹ ∈ diagonalTorus (ZMod p) 2 :=
      hker <| Subgroup.mem_inf.mpr ⟨mul_mem hx (inv_mem (zpow_mem hw _)),
        MonoidHom.mem_ker.mpr <| by rw [map_mul, map_inv, map_zpow, hwR, hj, mul_inv_cancel]⟩
    refine hxd ?_
    have h₂ : x = (x * (w ^ j)⁻¹) * w ^ j := by
      rw [inv_mul_cancel_right]
    rw [h₂]
    exact mul_mem h₁ (zpow_mem hwd _)
  have hw₀₀ : w 0 0 = 0 := apply_zero_zero_of_mem_labelNs (hK hw) hwd
  have hw₁₁ : w 1 1 = 0 := apply_one_one_of_mem_labelNs (hK hw) hwd
  have hRv : -(w 0 1 * w 1 0) = R := by
    rw [← hwR, val_det_apply, Matrix.det_fin_two, hw₀₀, zero_mul, zero_sub]
  have h₀₁ : w 0 1 ≠ 0 := fun h ↦ R.ne_zero (by rw [← hRv, h, zero_mul, neg_zero])
  have hwM : w.val = !![0, ((w 0 1).val : ZMod p); -((ZMod.leastGenOfIndex p
      (K.map det).index : ZMod p) / ((w 0 1).val : ZMod p)), 0] := by
    rw [ZMod.natCast_zmod_val, ← hR, ← hRv]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hw₀₀, hw₁₁]
    field_simp
  have hu₀M : (detOneDiag p u₀).val = !![((u₀ : ZMod p).val : ZMod p), 0;
      0, ((u₀ : ZMod p).val : ZMod p)⁻¹] := by
    rw [ZMod.natCast_zmod_val, val_detOneDiag]
  refine ⟨_, (w 0 1).val, ha, ZMod.val_pos.mpr h₀₁, hgen, le_antisymm ?_ ?_⟩
  · exact le_of_det_ker_le (w := w) (mem_preimage_of_val_eq hwM (Or.inr rfl)) (by rw [hwR, hRK])
      (fun k hk ↦ det_ker_diag_le hu₀ (mem_preimage_of_val_eq hu₀M (Or.inl rfl)) hk.1 (hker hk)
        hk.2) hw
  · refine (Subgroup.closure_le _).mpr fun x hx ↦ ?_
    rcases hx with hx | hx
    · have hx' : x = detOneDiag p u₀ := Units.ext (hx.trans hu₀M.symm)
      rw [hx']
      exact (hu₀ u₀).mpr (Subgroup.mem_zpowers u₀)
    · exact (Units.ext (hx.trans hwM.symm) : x = w) ▸ hw

/-- **A subgroup of `Ns` whose determinant-one part does not lie in `Cs` is generated by
`!![a, 0; 0, 1/a]`, `!![0, b; -1/b, 0]` and `!![0, c; -r/c, 0]`** for positive integers `a`, `b`,
`c`, with `a` fixed by the determinant-one diagonal part: it is the group `Ns.a.b.c[d]` (Sutherland,
arXiv:1504.07618v7, §6.4). -/
lemma exists_eq_labelNsABCD (hK : K ≤ labelNs p) (hker : ¬K ⊓ det.ker ≤ diagonalTorus (ZMod p) 2) :
    ∃ a b c : ℕ, 0 < a ∧ 0 < b ∧ 0 < c ∧ IsDetOneDiagGen p a K ∧
      K = labelNsABCD p (K.map det).index a b c := by
  rcases exists_mem_iff_mem_zpowers_detOneDiag K with ⟨u₀, ha, hgen, hu₀⟩
  rcases exists_mem_det_eq K with ⟨R, hR, hRK⟩
  rcases Set.not_subset.mp hker with ⟨y, ⟨hy, hy₁⟩, hyd⟩
  have hyR : det y = 1 := MonoidHom.mem_ker.mp hy₁
  have hy₀₀ : y 0 0 = 0 := apply_zero_zero_of_mem_labelNs (hK hy) hyd
  have hy₁₁ : y 1 1 = 0 := apply_one_one_of_mem_labelNs (hK hy) hyd
  have hyv : -(y 0 1 * y 1 0) = 1 := by
    have h : (det y).val = 1 := by
      rw [hyR, Units.val_one]
    rwa [val_det_apply, Matrix.det_fin_two, hy₀₀, zero_mul, zero_sub] at h
  have hy₀₁ : y 0 1 ≠ 0 := fun h ↦ by
    rw [h, zero_mul, neg_zero] at hyv
    exact zero_ne_one hyv
  have hyM : y.val = !![0, ((y 0 1).val : ZMod p); -((y 0 1).val : ZMod p)⁻¹, 0] := by
    rw [ZMod.natCast_zmod_val]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hy₀₀, hy₁₁]
    field_simp
    linear_combination -hyv
  have hex : ∃ w ∈ K, det w = R ∧ w 0 0 = 0 ∧ w 1 1 = 0 := by
    rcases (hRK ▸ Subgroup.mem_zpowers R : R ∈ K.map det) with ⟨z, hz, hzR⟩
    rcases mem_labelNs_iff.mp (hK hz) with hzd | hzd
    · exact ⟨z * y, mul_mem hz hy, by rw [map_mul, hzR, hyR, mul_one],
        by simp [Matrix.mul_apply, hy₀₀, hzd.1], by simp [Matrix.mul_apply, hy₁₁, hzd.2]⟩
    · exact ⟨z, hz, hzR, hzd.1, hzd.2⟩
  rcases hex with ⟨w, hw, hwR, hw₀₀, hw₁₁⟩
  have hRv : -(w 0 1 * w 1 0) = R := by
    rw [← hwR, val_det_apply, Matrix.det_fin_two, hw₀₀, zero_mul, zero_sub]
  have h₀₁ : w 0 1 ≠ 0 := fun h ↦ R.ne_zero (by rw [← hRv, h, zero_mul, neg_zero])
  have hwM : w.val = !![0, ((w 0 1).val : ZMod p); -((ZMod.leastGenOfIndex p
      (K.map det).index : ZMod p) / ((w 0 1).val : ZMod p)), 0] := by
    rw [ZMod.natCast_zmod_val, ← hR, ← hRv]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hw₀₀, hw₁₁]
    field_simp
  have hu₀M : (detOneDiag p u₀).val = !![((u₀ : ZMod p).val : ZMod p), 0;
      0, ((u₀ : ZMod p).val : ZMod p)⁻¹] := by
    rw [ZMod.natCast_zmod_val, val_detOneDiag]
  refine ⟨_, (y 0 1).val, (w 0 1).val, ha, ZMod.val_pos.mpr hy₀₁, ZMod.val_pos.mpr h₀₁, hgen,
    le_antisymm ?_ ?_⟩
  · have hyC : y ∈ labelNsABCD p (K.map det).index (u₀ : ZMod p).val (y 0 1).val (w 0 1).val :=
      mem_preimage_of_val_eq hyM (Or.inr (Or.inl rfl))
    have hdiag {k : GL (Fin 2) (ZMod p)} (hk : k ∈ K ⊓ det.ker)
        (hkd : k ∈ diagonalTorus (ZMod p) 2) :
        k ∈ labelNsABCD p (K.map det).index (u₀ : ZMod p).val (y 0 1).val (w 0 1).val :=
      det_ker_diag_le hu₀ (mem_preimage_of_val_eq hu₀M (Or.inl rfl)) hk.1 hkd hk.2
    refine le_of_det_ker_le (w := w) (mem_preimage_of_val_eq hwM (Or.inr (Or.inr rfl)))
      (by rw [hwR, hRK]) (fun k hk ↦ ?_) hw
    rcases mem_labelNs_iff.mp (hK hk.1) with hkd | hkd
    · exact hdiag hk (mem_diagonalTorus_of_fin_two _ hkd.1 hkd.2)
    · have h₁ : k * y ∈ labelNsABCD p (K.map det).index (u₀ : ZMod p).val (y 0 1).val (w 0 1).val :=
        hdiag ⟨mul_mem hk.1 hy, mul_mem hk.2 hy₁⟩ (mem_diagonalTorus_of_fin_two _
          (by simp [Matrix.mul_apply, hkd.1, hy₁₁]) (by simp [Matrix.mul_apply, hkd.2, hy₀₀]))
      have h₂ : k = (k * y) * y⁻¹ := by
        rw [mul_inv_cancel_right]
      rw [h₂]
      exact mul_mem h₁ (inv_mem hyC)
  · refine (Subgroup.closure_le _).mpr fun x hx ↦ ?_
    rcases hx with hx | hx | hx
    · have hx' : x = detOneDiag p u₀ := Units.ext (hx.trans hu₀M.symm)
      rw [hx']
      exact (hu₀ u₀).mpr (Subgroup.mem_zpowers u₀)
    · exact (Units.ext (hx.trans hyM.symm) : x = y) ▸ hy
    · exact (Units.ext (hx.trans hwM.symm) : x = w) ▸ hw

end Matrix.GeneralLinearGroup
