import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.Metabelian
import Mathlib.GroupTheory.Nilpotent
import Mathlib.GroupTheory.SpecificGroups.Quaternion

/-!
# `p`-groups of `p`-rank one are metabelian

The `p`-rank of a finite group is the largest `n` such that the group has an elementary abelian
subgroup of order `p ^ n`. A finite `p`-group of `p`-rank at most one is metabelian (LMFDB
`group.metabelian`; the knowl says "groups of `p`-rank one", which is false for groups that are not
`p`-groups: `A₅` has `3`-rank one).

The proof does not use the classification of these groups as the cyclic and the generalised
quaternion groups. Let `G` be a finite `p`-group and `A` a maximal abelian normal subgroup of `G`.
Then `A` is its own centraliser: otherwise the image of the centraliser `C` of `A` in `G ⧸ A` is a
nontrivial normal subgroup of a `p`-group, so it contains a nontrivial central element `x A`, and
the preimage of the subgroup generated by `x A` is an abelian normal subgroup properly containing
`A`. So `G ⧸ A` embeds in the automorphism group of `A`. If `G` has `p`-rank at most one, then the
elements of order dividing `p` of an abelian subgroup form a subgroup of order at most `p`, which
makes the abelian subgroup cyclic. So `A` is cyclic, its automorphism group is abelian, and the
commutator subgroup of `G` lies in `A`.

## Main definitions

* `Group.pRank`: the `p`-rank of a group.

## Main results

* `IsPGroup.centralizer_le_of_maximal`: a maximal abelian normal subgroup of a finite `p`-group
  contains its centraliser.
* `IsPGroup.isMetabelian_of_forall_normal_isCyclic`: a finite `p`-group whose abelian normal
  subgroups are cyclic is metabelian.
* `IsPGroup.isCyclic_of_pRank_le_one`: in a finite `p`-group of `p`-rank at most one, every abelian
  subgroup is cyclic.
* `IsPGroup.isMetabelian_of_pRank_le_one` (LMFDB `group.metabelian`): a finite `p`-group of `p`-rank
  at most one is metabelian.
* `QuaternionGroup.pRank_two` (LMFDB `group.metabelian`): the dicyclic groups, the generalised
  quaternion groups among them, have `2`-rank one.
* `Group.pRank_multiplicative_zmod` (LMFDB `group.metabelian`): the cyclic group of order `p` has
  `p`-rank one.
-/

open Group Subgroup

open scoped IsMulCommutative commutatorElement

variable {p : ℕ} {G : Type*} [Group G]

private lemma natCard_le_pow_of_forall_pow_pow_eq_one {B : Type*} [CommGroup B] [Finite B] (k : ℕ)
    (h : ∀ b : B, b ^ p ^ k = 1) (hp : ∀ T : Subgroup B, (∀ t ∈ T, t ^ p = 1) → Nat.card T ≤ p) :
    Nat.card B ≤ p ^ k := by
  induction k generalizing B with
  | zero =>
    have hB : Subsingleton B := ⟨fun a b ↦ by simpa using (h a).trans (h b).symm⟩
    exact (Finite.card_le_one_iff_subsingleton.mpr hB).trans_eq (pow_zero p).symm
  | succ k ih =>
    let f : B →* B := powMonoidHom (p ^ k)
    have hr : Nat.card f.range ≤ p := hp f.range <| by
      rintro - ⟨b, rfl⟩
      rw [powMonoidHom_apply, ← pow_mul, ← pow_succ, h b]
    have hk : Nat.card f.ker ≤ p ^ k :=
      ih (fun b ↦ Subtype.ext <| MonoidHom.mem_ker.mp b.2) fun T hT ↦
        f.ker.card_subtype T ▸ hp (T.map f.ker.subtype) (by
          rintro - ⟨t, ht, rfl⟩
          exact congrArg Subtype.val (hT t ht))
    rw [← card_ker_mul_card_range f, pow_succ]
    exact Nat.mul_le_mul hk hr

variable (p G) in
/-- The **`p`-rank** of a finite group `G`: the largest `n` such that `G` has an elementary abelian
`p`-subgroup of order `p ^ n`, that is, an abelian subgroup of order `p ^ n` all of whose elements
`h` satisfy `h ^ p = 1`. This is the rank that the LMFDB knowl `group.metabelian` means by "groups
of `p`-rank one"; it is not the minimal number of generators of LMFDB `group.rank`, for which the
`p`-groups of rank one are the cyclic ones. When the orders of the elementary abelian
`p`-subgroups of `G` are unbounded, it takes the junk value `0`. -/
noncomputable def Group.pRank : ℕ :=
  sSup {n | ∃ H : Subgroup G, IsMulCommutative H ∧ (∀ h ∈ H, h ^ p = 1) ∧ Nat.card H = p ^ n}

namespace Group

variable [Fact p.Prime] {n r : ℕ} {H : Subgroup G}

lemma pRank_le (h : ∀ K : Subgroup G, IsMulCommutative K → (∀ k ∈ K, k ^ p = 1) →
    Nat.card K ≤ p ^ r) : pRank p G ≤ r :=
  csSup_le' fun _ ⟨K, hK, hKp, hn⟩ ↦
    (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).mp <| hn ▸ h K hK hKp

variable [Finite G]

lemma le_pRank [IsMulCommutative H] (hH : ∀ h ∈ H, h ^ p = 1) (hn : Nat.card H = p ^ n) :
    n ≤ pRank p G :=
  le_csSup ⟨Nat.card G, fun m ⟨K, _, _, hK⟩ ↦
    (m.lt_pow_self (Fact.out : p.Prime).one_lt).le.trans <| hK ▸ K.card_le_card_group⟩
    ⟨H, inferInstance, hH, hn⟩

lemma natCard_le_pow_pRank [IsMulCommutative H] (hH : ∀ h ∈ H, h ^ p = 1) :
    Nat.card H ≤ p ^ pRank p G := by
  rcases IsPGroup.iff_card.mp (fun h : H ↦ ⟨1, by simpa using Subtype.ext (hH h h.2)⟩ :
    IsPGroup p H) with ⟨m, hm⟩
  exact hm ▸ Nat.pow_le_pow_right (Fact.out : p.Prime).pos (le_pRank hH hm)

lemma one_le_pRank (h : p ∣ Nat.card G) : 1 ≤ pRank p G := by
  rcases exists_prime_orderOf_dvd_card' p h with ⟨g, hg⟩
  refine le_pRank (H := zpowers g) (fun x hx ↦ ?_) (by rw [Nat.card_zpowers, hg, pow_one])
  rcases mem_zpowers_iff.mp hx with ⟨k, rfl⟩
  rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, ← hg, pow_orderOf_eq_one,
    one_zpow]

end Group

namespace IsPGroup

variable [Finite G] [Fact p.Prime]

/-- **A maximal abelian normal subgroup of a finite `p`-group contains its centraliser**, so it is
its own centraliser. -/
lemma centralizer_le_of_maximal (hG : IsPGroup p G) {A : Subgroup G}
    (hA : Maximal (fun A : Subgroup G ↦ A.Normal ∧ IsMulCommutative A) A) :
    centralizer (A : Set G) ≤ A := by
  have hAn : A.Normal := hA.prop.1
  have hAc : IsMulCommutative A := hA.prop.2
  have hQ : Group.IsNilpotent (G ⧸ A) := (hG.to_quotient A).isNilpotent
  by_contra hC
  have hCn : ((centralizer (A : Set G)).map (QuotientGroup.mk' A)).Normal :=
    normal_centralizer.map _ (QuotientGroup.mk'_surjective A)
  have hC' : (centralizer (A : Set G)).map (QuotientGroup.mk' A) ≠ ⊥ := by
    rwa [Ne, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
  rcases ne_bot_iff_exists_ne_one.mp (IsNilpotent.inf_center_ne_bot_of_normal hC') with
    ⟨⟨x, hxC, hxZ⟩, hx⟩
  let B : Subgroup G := (zpowers x).comap (QuotientGroup.mk' A)
  have hBn : B.Normal := (normal_of_le_center <| zpowers_le.mpr hxZ).comap _
  have hBC : B ≤ centralizer (A : Set G) := fun b hb ↦ by
    rcases zpowers_le.mpr hxC hb with ⟨c, hc, hcb⟩
    simpa using mul_mem hc <| le_centralizer A <| QuotientGroup.eq.mp hcb
  have hBc : IsMulCommutative B := by
    let f : B →* zpowers x :=
      ((QuotientGroup.mk' A).comp B.subtype).codRestrict (zpowers x) fun b ↦ b.2
    refine f.isMulCommutative_of_isCyclic_of_ker_le_center fun b hb ↦ mem_center_iff.mpr fun c ↦ ?_
    have hbA : (b : G) ∈ A :=
      (QuotientGroup.eq_one_iff _).mp <| congrArg Subtype.val <| MonoidHom.mem_ker.mp hb
    exact Subtype.ext (mem_centralizer_iff.mp (hBC c.2) b hbA).symm
  have hAB : A ≤ B := (QuotientGroup.ker_mk' A).ge.trans <| MonoidHom.ker_le_comap _ _
  rcases QuotientGroup.mk'_surjective A x with ⟨y, rfl⟩
  exact hx <| Subtype.ext <| (QuotientGroup.eq_one_iff y).mpr <|
    hA.le_of_ge ⟨hBn, hBc⟩ hAB <| mem_comap.mpr <| mem_zpowers _

/-- **A finite `p`-group whose abelian normal subgroups are cyclic is metabelian**: a maximal
abelian normal subgroup `A` is its own centraliser, so the quotient by `A` embeds in the
automorphism group of the cyclic group `A`, which is abelian. -/
lemma isMetabelian_of_forall_normal_isCyclic (hG : IsPGroup p G)
    (h : ∀ A : Subgroup G, A.Normal → IsMulCommutative A → IsCyclic A) : IsMetabelian G := by
  rcases Finite.exists_le_maximal (p := fun A : Subgroup G ↦ A.Normal ∧ IsMulCommutative A)
    (a := ⊥) ⟨inferInstance, inferInstance⟩ with ⟨A, -, hA⟩
  have hAn : A.Normal := hA.prop.1
  have hAc : IsMulCommutative A := hA.prop.2
  have hAcyc : IsCyclic A := h A hAn hAc
  have hle : commutator G ≤ A := by
    refine (commutator_le.mpr fun g _ k _ ↦ mem_centralizer_iff.mpr fun a ha ↦ ?_).trans
      (hG.centralizer_le_of_maximal hA)
    have hc : MulAut.conjNormal ⁅g, k⁆ = (1 : MulAut A) := by
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact (IsCyclic.mulAutMulEquiv A).injective <| by rw [map_mul, map_mul, mul_comm]
    exact eq_mul_inv_iff_mul_eq.mp <| ((MulAut.conjNormal_apply ⁅g, k⁆ (⟨a, ha⟩ : A)).symm.trans <|
      congrArg (fun σ : MulAut A ↦ ((σ ⟨a, ha⟩ : A) : G)) hc).symm
  exact ⟨.of_setLike_mul_comm fun x hx y hy ↦ setLike_mul_comm (hle hx) (hle hy)⟩

/-- **In a finite `p`-group of `p`-rank at most one, every abelian subgroup is cyclic**: its
elements of order dividing `p` form a subgroup of order at most `p`. -/
lemma isCyclic_of_pRank_le_one (hG : IsPGroup p G) (hr : Group.pRank p G ≤ 1) (A : Subgroup G)
    [IsMulCommutative A] : IsCyclic A := by
  rcases iff_card.mp (hG.to_subgroup A) with ⟨n, hn⟩
  rcases (Nat.dvd_prime_pow Fact.out).mp (hn ▸ Group.exponent_dvd_nat_card (G := A)) with
    ⟨k, -, hk⟩
  refine .of_exponent_eq_card <|
    (Nat.le_of_dvd Nat.card_pos Group.exponent_dvd_nat_card).antisymm ?_
  rw [hk]
  refine natCard_le_pow_of_forall_pow_pow_eq_one k (fun a ↦ hk ▸ Monoid.pow_exponent_eq_one a)
    fun T hT ↦ A.card_subtype T ▸ ?_
  have hT' : ∀ t ∈ T.map A.subtype, t ^ p = 1 := by
    rintro - ⟨t, ht, rfl⟩
    exact congrArg Subtype.val (hT t ht)
  exact (Group.natCard_le_pow_pRank hT').trans <|
    (Nat.pow_le_pow_right (Fact.out : p.Prime).pos hr).trans_eq (pow_one p)

/-- **`p`-groups of `p`-rank one are metabelian** (LMFDB `group.metabelian`): a finite `p`-group of
`p`-rank at most one, that is, without an elementary abelian subgroup of order `p ^ 2`, has an
abelian commutator subgroup. -/
lemma isMetabelian_of_pRank_le_one (hG : IsPGroup p G) (hr : Group.pRank p G ≤ 1) :
    IsMetabelian G :=
  hG.isMetabelian_of_forall_normal_isCyclic fun A _ _ ↦ hG.isCyclic_of_pRank_le_one hr A

end IsPGroup

namespace QuaternionGroup

variable (n : ℕ) [NeZero n]

private lemma natCast_ne_zero_aux : (n : ZMod (2 * n)) ≠ 0 := by
  rw [Ne, ZMod.natCast_eq_zero_iff]
  intro h
  have hn : 0 < n := NeZero.pos n
  have hle : 2 * n ≤ n := Nat.le_of_dvd hn h
  omega

lemma isPGroup_two_pow (k : ℕ) : IsPGroup 2 (QuaternionGroup (2 ^ k)) :=
  .of_card (n := k + 2) <| by
    rw [Nat.card_eq_fintype_card, card]
    ring1

variable {n} in
lemma eq_one_or_eq_a_of_sq_eq_one {g : QuaternionGroup n} (hg : g ^ 2 = 1) : g = 1 ∨ g = a n := by
  rcases g with i | i
  · rw [sq, a_mul_a, one_def, a.injEq] at hg
    have hi : ((2 * i.val : ℕ) : ZMod (2 * n)) = 0 := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, Nat.cast_ofNat, two_mul i, hg]
    rcases (Nat.mul_dvd_mul_iff_left two_pos).mp ((ZMod.natCast_eq_zero_iff _ _).mp hi) with
      ⟨c, hc⟩
    have hc' : c = 0 ∨ c = 1 := by
      by_contra! h
      have hlt : i.val < 2 * n := i.val_lt
      have hle : n * 2 ≤ n * c := Nat.mul_le_mul_left n (by omega)
      omega
    rcases hc' with rfl | rfl
    · exact .inl <| congrArg a <| (ZMod.val_eq_zero i).mp <| hc.trans (mul_zero n)
    · exact .inr <| congrArg a <| by rw [← ZMod.natCast_zmod_val i, hc, mul_one]
  · rw [xa_sq, one_def, a.injEq] at hg
    exact absurd hg (natCast_ne_zero_aux n)

/-- **The dicyclic groups have `2`-rank one** (LMFDB `group.metabelian`): the only element of
order `2` of `QuaternionGroup n` is `a n`, the `n`-th power of `a 1`. Among them, the generalised
quaternion groups `QuaternionGroup (2 ^ k)` are `2`-groups (`isPGroup_two_pow`), to which
`IsPGroup.isMetabelian_of_pRank_le_one` applies. -/
lemma pRank_two : Group.pRank 2 (QuaternionGroup n) = 1 := by
  refine (Group.pRank_le fun H _ hH ↦ ?_).antisymm <| Group.one_le_pRank <| by
    rw [Nat.card_eq_fintype_card, card]
    exact Dvd.intro (2 * n) (by ring1)
  have hs : (H : Set (QuaternionGroup n)) ⊆ {1, a n} := fun g hg ↦
    eq_one_or_eq_a_of_sq_eq_one (hH g hg)
  rw [pow_one]
  exact (Set.ncard_le_ncard hs).trans <| (Set.ncard_insert_le _ _).trans_eq <| by
    rw [Set.ncard_singleton]

end QuaternionGroup

/-- **The cyclic group of order `p` has `p`-rank one** (LMFDB `group.metabelian`). -/
lemma Group.pRank_multiplicative_zmod [Fact p.Prime] : pRank p (Multiplicative (ZMod p)) = 1 := by
  refine (pRank_le fun H _ _ ↦ ?_).antisymm <| one_le_pRank <| by simp
  simpa using H.card_le_card_group
