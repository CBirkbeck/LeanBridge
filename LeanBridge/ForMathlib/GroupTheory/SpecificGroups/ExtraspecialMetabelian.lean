import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.MetabelianExamples
import TauCeti.GroupTheory.SpecificGroups.Heisenberg
import TauCeti.Topology.Algebra.Group.Profinite.ProP.MaximalSubgroup

/-!
# Extraspecial `p`-groups are metabelian

A `p`-group is extraspecial when its centre, its commutator subgroup and its Frattini subgroup
coincide and have order `p`. Its commutator subgroup is central, so it is metabelian (LMFDB
`group.metabelian`). The Heisenberg group over `𝔽_p`, of order `p ^ 3`, is extraspecial: its
centre and its commutator subgroup are the `z`-axis, and so is its Frattini subgroup, since the
Frattini subgroup of a finite `p`-group is generated by the `p`-th powers and the commutators.

## Main definitions

* `IsExtraspecial`: the extraspecial `p`-groups.

## Main results

* `IsExtraspecial.isMetabelian` (LMFDB `group.metabelian`): extraspecial groups are metabelian.
* `IsPGroup.frattini_eq_closure_sup_commutator`: the Frattini subgroup of a finite `p`-group is
  generated by the `p`-th powers and the commutators.
* `TauCeti.HeisenbergGroup.isExtraspecial_zmod`: the Heisenberg group over `𝔽_p` is extraspecial.
-/

open Subgroup TauCeti

open scoped commutatorElement

variable {p : ℕ} {G : Type*} [Group G]

variable (p G) in
/-- A group `G` is an **extraspecial `p`-group**, for a prime `p`, if it is a `p`-group whose
centre has order `p` and is both the commutator subgroup and the Frattini subgroup of `G` (LMFDB
`group.metabelian`). -/
structure IsExtraspecial : Prop where
  isPGroup : IsPGroup p G
  natCard_center : Nat.card (center G) = p
  commutator_eq_center : commutator G = center G
  frattini_eq_center : frattini G = center G

/-- **Extraspecial groups are metabelian** (LMFDB `group.metabelian`): the commutator subgroup is
the centre. -/
lemma IsExtraspecial.isMetabelian (h : IsExtraspecial p G) : IsMetabelian G :=
  isMetabelian_of_commutator_le_center h.commutator_eq_center.le

/-- **The Frattini subgroup of a finite `p`-group is generated by the `p`-th powers and the
commutators.** -/
lemma IsPGroup.frattini_eq_closure_sup_commutator [Finite G] [Fact p.Prime] (hG : IsPGroup p G) :
    frattini G = closure (Set.range fun g : G ↦ g ^ p) ⊔ commutator G := by
  let _ : TopologicalSpace G := ⊥
  have _ : DiscreteTopology G := ⟨rfl⟩
  rw [← hG.proPFrattini_eq_frattini, proPFrattini_eq_topologicalClosure Fact.out]
  exact SetLike.coe_injective (closure_discrete _)

namespace TauCeti.HeisenbergGroup

variable {R : Type*} [Ring R]

private lemma center_eq_zAxis_aux : center (HeisenbergGroup R) = zAxis := by
  refine zAxis_le_center.antisymm' fun a ha ↦ ⟨?_, ?_⟩
  · simpa using (congrArg z (mem_center_iff.mp ha ⟨0, 1, 0⟩)).symm
  · simpa using congrArg z (mem_center_iff.mp ha ⟨1, 0, 0⟩)

private lemma commutator_eq_zAxis_aux : commutator (HeisenbergGroup R) = zAxis := by
  refine (commutator_le.mpr fun a _ b _ ↦ commutatorElement_mem_zAxis a b).antisymm fun c hc ↦ ?_
  have h : c = ⁅(⟨c.z, 0, 0⟩ : HeisenbergGroup R), ⟨0, 1, 0⟩⁆ := by
    rw [commutatorElement_eq]
    ext <;> simp [hc.1, hc.2]
  rw [h]
  exact commutator_mem_commutator (mem_top _) (mem_top _)

private lemma natCard_zAxis_aux : Nat.card (zAxis : Subgroup (HeisenbergGroup R)) = Nat.card R :=
  Nat.card_congr ⟨fun a ↦ a.1.z, fun z ↦ ⟨⟨0, 0, z⟩, rfl, rfl⟩,
    fun a ↦ Subtype.ext <| by ext <;> simp [a.2.1, a.2.2], fun _ ↦ rfl⟩

variable (p) [Fact p.Prime] in
/-- **The Heisenberg group over `𝔽_p` is extraspecial**: its centre, its commutator subgroup and
its Frattini subgroup are the `z`-axis, of order `p`. -/
lemma isExtraspecial_zmod : IsExtraspecial p (HeisenbergGroup (ZMod p)) where
  isPGroup := isPGroup_zmod p
  natCard_center := by rw [center_eq_zAxis_aux, natCard_zAxis_aux, Nat.card_zmod]
  commutator_eq_center := commutator_eq_zAxis_aux.trans center_eq_zAxis_aux.symm
  frattini_eq_center := by
    rw [(isPGroup_zmod p).frattini_eq_closure_sup_commutator, commutator_eq_zAxis_aux,
      center_eq_zAxis_aux, sup_eq_right, closure_le]
    rintro - ⟨a, rfl⟩
    exact pow_char_mem_zAxis p a

end TauCeti.HeisenbergGroup
