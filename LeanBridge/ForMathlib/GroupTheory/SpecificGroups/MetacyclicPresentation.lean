import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.ModularMaximalCyclic
import Mathlib.GroupTheory.PresentedGroup
import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.GroupTheory.SpecificGroups.Quaternion

/-!
# Presentations of the dihedral, dicyclic, semi-dihedral and other-dihedral groups

A group generated by two elements `x` and `y` with `x ^ m = 1`, `y x y⁻¹ = x ^ e` and
`y ^ 2 = x ^ t` consists of the `2m` elements `x ^ i y ^ j` with `0 ≤ i < m` and `j ∈ {0, 1}`,
since this set contains `1` and is stable under multiplication on the left by `x`, `y` and their
inverses. So a group of order `2m` generated by two such elements is presented by these relations:
the presented group maps onto it and has at most `2m` elements. This gives the presentations of the
LMFDB:

* `Dₙ = ⟨g, h | gⁿ = h² = 1, hg = g⁻¹h⟩` (LMFDB `group.dihedral`), whose elements are the `gⁱ hʲ`;
* `Dicₙ = ⟨a, b | a²ⁿ, aⁿ b⁻², b a b⁻¹ a⟩` (LMFDB `group.dicyclic`, `group.generalized_quaternion`),
  Mathlib's `QuaternionGroup n`;
* `SD_{2^k} = ⟨r, s | r^{2^{k-1}} = s² = 1, s r s = r^{2^{k-2}-1}⟩` (LMFDB `group.semi_dihedral`);
* `OD_{2^k} = ⟨r, s | r^{2^{k-1}} = s² = 1, s r s = r^{2^{k-2}+1}⟩` (LMFDB `group.other_dihedral`).

## Main definitions

* `DihedralGroup.relators`, `DihedralGroup.presentedGroupMulEquiv` (LMFDB `group.dihedral`): the
  presentation of `Dₙ`.
* `QuaternionGroup.relators`, `QuaternionGroup.presentedGroupMulEquiv` (LMFDB `group.dicyclic`,
  `group.generalized_quaternion`): the presentation of `Dicₙ`.
* `ZMod.involutionRelators`, `ZMod.involutionPresentedGroupMulEquiv`: the presentation
  `⟨r, s | rᴺ = s² = 1, s r s = r ^ c⟩` of `C_N ⋊ C_2` with `C_2` acting by `x ↦ x ^ c`.
* `SemiDihedralGroup.presentedGroupMulEquiv` (LMFDB `group.semi_dihedral`) and
  `OtherDihedralGroup.presentedGroupMulEquiv` (LMFDB `group.other_dihedral`): the presentations of
  `SD_{2^k}` and `OD_{2^k}`.

## Main results

* `surjective_pow_mul_pow`: a group generated by `x` and `y` with `x ^ m = 1`, `y x y⁻¹ = x ^ e`
  and `y ^ 2 = x ^ t` consists of the elements `x ^ i y ^ j` with `i < m` and `j < 2`.
* `bijective_of_closure_map_eq_top`: a homomorphism from such a group onto a group of order at
  least `2m` generated by the images of `x` and `y` is an isomorphism.
* `DihedralGroup.bijective_r_one_pow_mul_sr_zero_pow` (LMFDB `group.dihedral`): the elements of
  `Dₙ` are the `2n` distinct `gⁱ hʲ`.
-/

open Multiplicative PresentedGroup SemidirectProduct Subgroup ZMod

variable {H : Type*} [Group H] {x y : H} {m N c : ℕ} {e t : ℤ} {u : (ZMod N)ˣ} (hu : u ^ 2 = 1)

lemma exists_zpow_mul_pow_eq (hyx : y * x * y⁻¹ = x ^ e) (hy : y ^ 2 = x ^ t)
    (hgen : closure {x, y} = ⊤) (h : H) : ∃ i : ℤ, ∃ j < 2, x ^ i * y ^ j = h := by
  have hconj (i : ℤ) : y * x ^ i = x ^ (e * i) * y := by
    rw [zpow_mul, ← hyx, conj_zpow, inv_mul_cancel_right]
  have hyinv : y⁻¹ = y * x ^ (-t) := by
    rw [zpow_neg, ← hy, pow_two, mul_inv_rev, mul_inv_cancel_left]
  have hymul (i : ℤ) (j : ℕ) (hj : j < 2) :
      ∃ i' : ℤ, ∃ j' < 2, x ^ i' * y ^ j' = y * (x ^ i * y ^ j) := by
    interval_cases j
    · exact ⟨e * i, 1, by norm_num, by rw [pow_zero, mul_one, pow_one, hconj]⟩
    · exact ⟨e * i + t, 0, by norm_num, by
        rw [pow_zero, mul_one, pow_one, ← mul_assoc, hconj, mul_assoc, ← pow_two, hy, ← zpow_add]⟩
  have hmem : h ∈ closure {x, y} := hgen ▸ mem_top h
  induction hmem using closure_induction_left with
  | one => exact ⟨0, 0, by norm_num, by simp⟩
  | mul_left z hz w _ ih =>
    rcases ih with ⟨i, j, hj, rfl⟩
    rcases hz with rfl | rfl
    · exact ⟨1 + i, j, hj, by rw [zpow_one_add, mul_assoc]⟩
    · exact hymul i j hj
  | inv_mul_cancel z hz w _ ih =>
    rcases ih with ⟨i, j, hj, rfl⟩
    rcases hz with rfl | rfl
    · exact ⟨-1 + i, j, hj, by rw [zpow_add, zpow_neg_one, mul_assoc]⟩
    · rcases hymul (-t + i) j hj with ⟨i', j', hj', h'⟩
      exact ⟨i', j', hj', by rw [h', hyinv, zpow_add]; simp only [mul_assoc]⟩

/-- **A group generated by `x` and `y` with `x ^ m = 1`, `y x y⁻¹ = x ^ e` and `y ^ 2 = x ^ t`
consists of the elements `x ^ i y ^ j` with `i < m` and `j < 2`**: this set contains `1` and is
stable under multiplication on the left by `x`, `y` and their inverses. -/
lemma surjective_pow_mul_pow (hm : m ≠ 0) (hx : x ^ m = 1) (hyx : y * x * y⁻¹ = x ^ e)
    (hy : y ^ 2 = x ^ t) (hgen : closure {x, y} = ⊤) :
    Function.Surjective fun p : Fin m × Fin 2 ↦ x ^ (p.1 : ℕ) * y ^ (p.2 : ℕ) := fun h ↦ by
  rcases exists_zpow_mul_pow_eq hyx hy hgen h with ⟨i, j, hj, rfl⟩
  have hm' : (0 : ℤ) < m := by exact_mod_cast Nat.pos_of_ne_zero hm
  have h0 : 0 ≤ i % m := Int.emod_nonneg i hm'.ne'
  have hlt : i % m < m := Int.emod_lt_of_pos i hm'
  refine ⟨(⟨(i % m).toNat, by omega⟩, ⟨j, hj⟩), ?_⟩
  dsimp only
  rw [← zpow_natCast, Int.toNat_of_nonneg h0, ← zpow_eq_zpow_emod' i hx]

lemma finite_of_closure_eq_top (hm : m ≠ 0) (hx : x ^ m = 1) (hyx : y * x * y⁻¹ = x ^ e)
    (hy : y ^ 2 = x ^ t) (hgen : closure {x, y} = ⊤) : Finite H :=
  Finite.of_surjective _ (surjective_pow_mul_pow hm hx hyx hy hgen)

lemma nat_card_le_of_closure_eq_top (hm : m ≠ 0) (hx : x ^ m = 1) (hyx : y * x * y⁻¹ = x ^ e)
    (hy : y ^ 2 = x ^ t) (hgen : closure {x, y} = ⊤) : Nat.card H ≤ 2 * m := by
  have h : Nat.card H ≤ Nat.card (Fin m × Fin 2) :=
    Nat.card_le_card_of_surjective _ (surjective_pow_mul_pow hm hx hyx hy hgen)
  rwa [Nat.card_prod, Nat.card_fin, Nat.card_fin, mul_comm] at h

/-- **A homomorphism from a group generated by `x` and `y` with `x ^ m = 1`, `y x y⁻¹ = x ^ e` and
`y ^ 2 = x ^ t` onto a group of order at least `2m` generated by the images of `x` and `y` is
bijective**: its source has at most `2m` elements. -/
lemma bijective_of_closure_map_eq_top {C : Type*} [Group C] (hm : m ≠ 0) (hx : x ^ m = 1)
    (hyx : y * x * y⁻¹ = x ^ e) (hy : y ^ 2 = x ^ t) (hgen : closure {x, y} = ⊤) (f : H →* C)
    (hC : closure {f x, f y} = ⊤) (hcard : 2 * m ≤ Nat.card C) : Function.Bijective f :=
  have : Finite H := finite_of_closure_eq_top hm hx hyx hy hgen
  (MonoidHom.range_eq_top.mp <| by rw [MonoidHom.range_eq_map, ← hgen, MonoidHom.map_closure,
    Set.image_pair, hC]).bijective_of_nat_card_le <|
      (nat_card_le_of_closure_eq_top hm hx hyx hy hgen).trans hcard

lemma PresentedGroup.closure_of_zero_of_one (rels : Set (FreeGroup (Fin 2))) :
    closure {PresentedGroup.of 0, PresentedGroup.of 1} = (⊤ : Subgroup (PresentedGroup rels)) := by
  rw [← PresentedGroup.closure_range_of]
  congr 1
  ext g
  simp [eq_comm]

namespace DihedralGroup

variable (n : ℕ)

/-- The relators `gⁿ`, `h²` and `hg (g⁻¹h)⁻¹` of the presentation
`Dₙ = ⟨g, h | gⁿ = h² = 1, hg = g⁻¹h⟩` of the dihedral group (LMFDB `group.dihedral`), with
`g = FreeGroup.of 0` and `h = FreeGroup.of 1`. -/
def relators : Set (FreeGroup (Fin 2)) :=
  {.of 0 ^ n, .of 1 ^ 2, .of 1 * .of 0 * ((.of 0)⁻¹ * .of 1)⁻¹}

lemma lift_relators : ∀ w ∈ relators n, FreeGroup.lift ![(r 1 : DihedralGroup n), sr 0] w = 1 := by
  rintro w (rfl | rfl | rfl)
  · simp
  · simp [pow_two]
  · simp

lemma presented_of_zero_pow : (PresentedGroup.of 0 : PresentedGroup (relators n)) ^ n = 1 :=
  (map_pow _ _ n).symm.trans (PresentedGroup.one_of_mem (Set.mem_insert _ _))

lemma presented_of_one_sq :
    (PresentedGroup.of 1 : PresentedGroup (relators n)) ^ 2 = PresentedGroup.of 0 ^ (0 : ℤ) :=
  ((map_pow _ _ 2).symm.trans (PresentedGroup.one_of_mem
    (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))).trans (zpow_zero _).symm

lemma presented_conj : (PresentedGroup.of 1 * PresentedGroup.of 0 * (PresentedGroup.of 1)⁻¹ :
    PresentedGroup (relators n)) = PresentedGroup.of 0 ^ (-1 : ℤ) := by
  have h : (of 1 * of 0 * ((of 0)⁻¹ * of 1)⁻¹ : PresentedGroup (relators n)) = 1 :=
    one_of_mem (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
  rw [zpow_neg_one, mul_inv_eq_iff_eq_mul]
  exact mul_inv_eq_one.mp h

lemma sr_zero_mul_r_one_mul_inv : (sr 0 * r 1 * (sr 0)⁻¹ : DihedralGroup n) = r 1 ^ (-1 : ℤ) := by
  simp

lemma sr_zero_sq : (sr 0 : DihedralGroup n) ^ 2 = r 1 ^ (0 : ℤ) := by
  simp [pow_two]

variable [NeZero n]

lemma closure_r_one_sr_zero : closure {r 1, sr 0} = (⊤ : Subgroup (DihedralGroup n)) := by
  refine eq_top_iff.mpr fun g _ ↦ ?_
  have hr (i : ZMod n) : r i ∈ closure {r 1, sr (0 : ZMod n)} := by
    rw [← ZMod.natCast_zmod_val i, ← r_one_pow]
    exact pow_mem (subset_closure (Set.mem_insert _ _)) _
  rcases g with i | i
  · exact hr i
  · rw [← zero_add i, ← sr_mul_r]
    exact mul_mem (subset_closure (Set.mem_insert_of_mem _ rfl)) (hr i)

/-- **The presentation `Dₙ = ⟨g, h | gⁿ = h² = 1, hg = g⁻¹h⟩` of the dihedral group** (LMFDB
`group.dihedral`), for `n ≠ 0`: the isomorphism sends `g` to the rotation `r 1` and `h` to the
reflection `sr 0`. -/
noncomputable def presentedGroupMulEquiv : PresentedGroup (relators n) ≃* DihedralGroup n :=
  MulEquiv.ofBijective (PresentedGroup.toGroup (lift_relators n)) <|
    bijective_of_closure_map_eq_top (NeZero.ne n) (presented_of_zero_pow n) (presented_conj n)
      (presented_of_one_sq n) (PresentedGroup.closure_of_zero_of_one _) _
      (by simpa using closure_r_one_sr_zero n) nat_card.ge

/-- **The elements of `Dₙ` are the `gⁱ hʲ` with `0 ≤ i < n` and `j ∈ {0, 1}`, all distinct**
(LMFDB `group.dihedral`): `Dₙ = {e, g, …, gⁿ⁻¹, h, gh, …, gⁿ⁻¹h}` for `g = r 1` and `h = sr 0`. -/
lemma bijective_r_one_pow_mul_sr_zero_pow : Function.Bijective fun p : Fin n × Fin 2 ↦
    (r 1 : DihedralGroup n) ^ (p.1 : ℕ) * sr 0 ^ (p.2 : ℕ) :=
  (surjective_pow_mul_pow (NeZero.ne n) r_one_pow_n (sr_zero_mul_r_one_mul_inv n)
    (sr_zero_sq n) (closure_r_one_sr_zero n)).bijective_of_nat_card_le <| by
      rw [Nat.card_prod, Nat.card_fin, Nat.card_fin, nat_card, mul_comm]

end DihedralGroup

namespace QuaternionGroup

variable (n : ℕ)

/-- The relators `a²ⁿ`, `aⁿ b⁻²` and `b a b⁻¹ a` of the presentation
`Dicₙ = ⟨a, b | a²ⁿ, aⁿ b⁻², b a b⁻¹ a⟩` of the dicyclic group of order `4n` (LMFDB
`group.dicyclic`), with `a = FreeGroup.of 0` and `b = FreeGroup.of 1`. -/
def relators : Set (FreeGroup (Fin 2)) :=
  {.of 0 ^ (2 * n), .of 0 ^ n * .of 1 ^ (-2 : ℤ), .of 1 * .of 0 * (.of 1)⁻¹ * .of 0}

lemma natCast_add_natCast : (n + n : ZMod (2 * n)) = 0 := by
  rw [← two_mul]
  exact_mod_cast ZMod.natCast_self (2 * n)

lemma xa_zero_inv : (xa 0 : QuaternionGroup n)⁻¹ = xa n :=
  inv_eq_of_mul_eq_one_right <| by rw [xa_mul_xa, sub_zero, natCast_add_natCast, a_zero]

lemma lift_relators :
    ∀ w ∈ relators n, FreeGroup.lift ![(a 1 : QuaternionGroup n), xa 0] w = 1 := by
  rintro w (rfl | rfl | rfl)
  · simp
  · simp
  · simp [xa_zero_inv, natCast_add_natCast]

lemma presented_of_zero_pow : (PresentedGroup.of 0 : PresentedGroup (relators n)) ^ (2 * n) = 1 :=
  (map_pow _ _ _).symm.trans (PresentedGroup.one_of_mem (Set.mem_insert _ _))

lemma presented_of_one_sq :
    (PresentedGroup.of 1 : PresentedGroup (relators n)) ^ 2 = PresentedGroup.of 0 ^ (n : ℤ) := by
  have h : (of 0 : PresentedGroup (relators n)) ^ n * of 1 ^ (-2 : ℤ) = 1 :=
    one_of_mem (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
  rw [zpow_natCast]
  refine ((mul_eq_one_iff_eq_inv.mp h).trans ?_).symm
  rw [← zpow_neg, neg_neg]
  rfl

lemma presented_conj : (PresentedGroup.of 1 * PresentedGroup.of 0 * (PresentedGroup.of 1)⁻¹ :
    PresentedGroup (relators n)) = PresentedGroup.of 0 ^ (-1 : ℤ) := by
  have h : (of 1 * of 0 * (of 1)⁻¹ * of 0 : PresentedGroup (relators n)) = 1 :=
    one_of_mem (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
  rw [zpow_neg_one]
  exact mul_eq_one_iff_eq_inv.mp h

lemma xa_zero_mul_a_one_mul_inv : (xa 0 * a 1 * (xa 0)⁻¹ : QuaternionGroup n) = a 1 ^ (-1 : ℤ) := by
  simp only [xa_mul_a, xa_zero_inv, xa_mul_xa, zero_add, natCast_add_natCast, zero_sub,
    zpow_neg_one]
  exact (inv_eq_of_mul_eq_one_right (by rw [a_mul_a, add_neg_cancel, a_zero])).symm

lemma xa_zero_sq : (xa 0 : QuaternionGroup n) ^ 2 = a 1 ^ (n : ℤ) := by
  rw [xa_sq, zpow_natCast, a_one_pow]

variable [NeZero n]

lemma closure_a_one_xa_zero : closure {a 1, xa 0} = (⊤ : Subgroup (QuaternionGroup n)) := by
  refine eq_top_iff.mpr fun g _ ↦ ?_
  have ha (i : ZMod (2 * n)) : a i ∈ closure {a 1, xa (0 : ZMod (2 * n))} := by
    rw [← ZMod.natCast_zmod_val i, ← a_one_pow]
    exact pow_mem (subset_closure (Set.mem_insert _ _)) _
  rcases g with i | i
  · exact ha i
  · rw [← zero_add i, ← xa_mul_a]
    exact mul_mem (subset_closure (Set.mem_insert_of_mem _ rfl)) (ha i)

/-- **The presentation `Dicₙ = ⟨a, b | a²ⁿ, aⁿ b⁻², b a b⁻¹ a⟩` of Mathlib's
`QuaternionGroup n`** (LMFDB `group.dicyclic`, `group.generalized_quaternion`), for `n ≠ 0`: the
isomorphism sends `a` to `a 1` and `b` to `xa 0`. -/
noncomputable def presentedGroupMulEquiv : PresentedGroup (relators n) ≃* QuaternionGroup n :=
  MulEquiv.ofBijective (PresentedGroup.toGroup (lift_relators n)) <|
    bijective_of_closure_map_eq_top (mul_ne_zero two_ne_zero (NeZero.ne n))
      (presented_of_zero_pow n) (presented_conj n) (presented_of_one_sq n)
      (PresentedGroup.closure_of_zero_of_one _) _ (by simpa using closure_a_one_xa_zero n) <| by
        rw [Nat.card_eq_fintype_card, QuaternionGroup.card]
        omega

end QuaternionGroup

namespace ZMod

variable (N c) in
/-- The relators `rᴺ`, `s²` and `s r s (r ^ c)⁻¹` of the presentation
`⟨r, s | rᴺ = s² = 1, s r s = r ^ c⟩` (LMFDB `group.semi_dihedral`, `group.other_dihedral`), with
`r = FreeGroup.of 0` and `s = FreeGroup.of 1`. -/
def involutionRelators : Set (FreeGroup (Fin 2)) :=
  {.of 0 ^ N, .of 1 ^ 2, .of 1 * .of 0 * .of 1 * (.of 0 ^ c)⁻¹}

lemma involutionMulAut_ofAdd_one : involutionMulAut u hu (ofAdd 1) = unitMulAut u :=
  pow_one _

variable [NeZero N] in
lemma ofAdd_one_pow_val (g : Multiplicative (ZMod N)) : ofAdd (1 : ZMod N) ^ g.toAdd.val = g := by
  rw [← ofAdd_nsmul, nsmul_one, ZMod.natCast_zmod_val, ofAdd_toAdd]

lemma inr_ofAdd_one_sq :
    (inr (ofAdd 1) : Multiplicative (ZMod N) ⋊[involutionMulAut u hu] Multiplicative (ZMod 2)) ^ 2 =
      inl (ofAdd 1) ^ (0 : ℤ) := by
  rw [← map_pow, zpow_zero, show (ofAdd 1 : Multiplicative (ZMod 2)) ^ 2 = 1 from rfl, map_one]

lemma inr_mul_inl_mul_inv (hc : (c : ZMod N) = u) :
    (inr (ofAdd 1) * inl (ofAdd 1) * (inr (ofAdd 1))⁻¹ :
      Multiplicative (ZMod N) ⋊[involutionMulAut u hu] Multiplicative (ZMod 2)) =
      inl (ofAdd 1) ^ (c : ℤ) := by
  rw [← map_inv, ← inl_aut, involutionMulAut_ofAdd_one, unitMulAut_apply, toAdd_ofAdd, mul_one,
    zpow_natCast, ← map_pow, ← ofAdd_nsmul, nsmul_one, hc]

lemma inl_ofAdd_one_pow :
    (inl (ofAdd 1) : Multiplicative (ZMod N) ⋊[involutionMulAut u hu] Multiplicative (ZMod 2)) ^ N =
      1 := by
  rw [← map_pow, ← ofAdd_nsmul, nsmul_one, ZMod.natCast_self, ofAdd_zero, map_one]

lemma inr_ofAdd_one_inv :
    (inr (ofAdd 1) : Multiplicative (ZMod N) ⋊[involutionMulAut u hu] Multiplicative (ZMod 2))⁻¹ =
      inr (ofAdd 1) := by
  rw [← map_inv]
  rfl

lemma lift_involutionRelators (hc : (c : ZMod N) = u) : ∀ w ∈ involutionRelators N c,
    FreeGroup.lift ![(inl (ofAdd 1) :
      Multiplicative (ZMod N) ⋊[involutionMulAut u hu] Multiplicative (ZMod 2)), inr (ofAdd 1)] w =
        1 := by
  rintro w (rfl | rfl | rfl)
  · simp [inl_ofAdd_one_pow hu]
  · simpa using inr_ofAdd_one_sq hu
  · simp only [map_mul, map_inv, map_pow, FreeGroup.lift_apply_of, Matrix.cons_val_zero,
      Matrix.cons_val_one]
    rw [mul_inv_eq_one, ← zpow_natCast, ← inr_mul_inl_mul_inv hu hc, inr_ofAdd_one_inv]

variable [NeZero N]

lemma closure_inl_inr : closure {inl (ofAdd 1), inr (ofAdd 1)} =
    (⊤ : Subgroup (Multiplicative (ZMod N) ⋊[involutionMulAut u hu] Multiplicative (ZMod 2))) := by
  refine eq_top_iff.mpr fun g _ ↦ ?_
  rw [← inl_left_mul_inr_right g, ← ofAdd_one_pow_val g.left, ← ofAdd_one_pow_val g.right,
    map_pow, map_pow]
  exact mul_mem (pow_mem (subset_closure (Set.mem_insert _ _)) _)
    (pow_mem (subset_closure (Set.mem_insert_of_mem _ rfl)) _)

end ZMod

namespace PresentedGroup

lemma involution_of_zero_pow : (of 0 : PresentedGroup (involutionRelators N c)) ^ N = 1 :=
  (map_pow _ _ N).symm.trans (one_of_mem (Set.mem_insert _ _))

lemma involution_of_one_sq : (of 1 : PresentedGroup (involutionRelators N c)) ^ 2 = 1 :=
  (map_pow _ _ 2).symm.trans (one_of_mem (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))

lemma involution_conj : (of 1 * of 0 * (of 1)⁻¹ : PresentedGroup (involutionRelators N c)) =
    of 0 ^ (c : ℤ) := by
  have h : (of 1 * of 0 * of 1 * (of 0 ^ c)⁻¹ : PresentedGroup (involutionRelators N c)) = 1 :=
    one_of_mem (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
  rw [inv_eq_of_mul_eq_one_right ((pow_two _).symm.trans involution_of_one_sq), zpow_natCast]
  exact mul_inv_eq_one.mp h

end PresentedGroup

namespace ZMod

variable [NeZero N]

/-- **The presentation `⟨r, s | rᴺ = s² = 1, s r s = r ^ c⟩` of `C_N ⋊ C_2`**, the generator of
`C_2` acting on `C_N` by `x ↦ x ^ u` for a unit `u = c` of `ZMod N` with `u ^ 2 = 1` (LMFDB
`group.semi_dihedral`, `group.other_dihedral`): the isomorphism sends `r` to the generator of `C_N`
and `s` to that of `C_2`. -/
noncomputable def involutionPresentedGroupMulEquiv (hc : (c : ZMod N) = u) :
    PresentedGroup (involutionRelators N c) ≃*
      Multiplicative (ZMod N) ⋊[involutionMulAut u hu] Multiplicative (ZMod 2) :=
  MulEquiv.ofBijective (PresentedGroup.toGroup (lift_involutionRelators hu hc)) <|
    bijective_of_closure_map_eq_top (NeZero.ne N) PresentedGroup.involution_of_zero_pow
      PresentedGroup.involution_conj
      (PresentedGroup.involution_of_one_sq.trans (zpow_zero _).symm)
      (PresentedGroup.closure_of_zero_of_one _) _ (by simpa using closure_inl_inr hu) <| by
        rw [SemidirectProduct.card, Nat.card_congr toAdd, Nat.card_congr toAdd, Nat.card_zmod,
          Nat.card_zmod, mul_comm]

end ZMod

variable (k : ℕ) [Fact (3 ≤ k)]

lemma natCast_two_pow_sub_one_eq :
    ((2 ^ (k - 2) - 1 : ℕ) : ZMod (2 ^ (k - 1))) = semiDihedralUnit k := by
  rw [Nat.cast_sub Nat.one_le_two_pow, Nat.cast_pow, Nat.cast_ofNat, Nat.cast_one]
  rfl

lemma natCast_two_pow_add_one_eq :
    ((2 ^ (k - 2) + 1 : ℕ) : ZMod (2 ^ (k - 1))) = otherDihedralUnit k := by
  rw [Nat.cast_add, Nat.cast_pow, Nat.cast_ofNat, Nat.cast_one]
  rfl

/-- **The presentation `SD_{2^k} = ⟨r, s | r^{2^{k-1}} = s² = 1, s r s = r^{2^{k-2}-1}⟩` of the
semi-dihedral group** (LMFDB `group.semi_dihedral`). -/
noncomputable def SemiDihedralGroup.presentedGroupMulEquiv :
    PresentedGroup (involutionRelators (2 ^ (k - 1)) (2 ^ (k - 2) - 1)) ≃* SemiDihedralGroup k :=
  involutionPresentedGroupMulEquiv _ (natCast_two_pow_sub_one_eq k)

/-- **The presentation `OD_{2^k} = ⟨r, s | r^{2^{k-1}} = s² = 1, s r s = r^{2^{k-2}+1}⟩` of the
other-dihedral group** (LMFDB `group.other_dihedral`). -/
noncomputable def OtherDihedralGroup.presentedGroupMulEquiv :
    PresentedGroup (involutionRelators (2 ^ (k - 1)) (2 ^ (k - 2) + 1)) ≃* OtherDihedralGroup k :=
  involutionPresentedGroupMulEquiv _ (natCast_two_pow_add_one_eq k)
