import Mathlib.FieldTheory.Finite.GaloisField
import LeanBridge.ForMathlib.GroupTheory.SpecificGroups.GL2LabelGenerators

/-!
# Subgroups of the normalizer of the non-split Cartan subgroup of `GL₂(𝔽_p)`

For odd `p`, the normalizer `Nn` of the non-split Cartan subgroup `Cn` of `GL₂(𝔽_p)` is
`Cn ∪ γ Cn`, with `γ = !![1, 0; 0, -1]`. This file proves Sutherland's Lemma 3.13 and Corollary 3.17
(arXiv:1504.07618v7) in the form needed for his labels: a subgroup `K` of `Nn` not in `Cn`, with
`K ∩ Cn` generated by `c = !![a, ε b; b, a]`, is conjugate to `Nn.a.b = ⟨c, γ⟩` if the sets
`det(K ∩ Cn)` and `-det(K \ Cn)` meet, and to `Nn.a.b.e = ⟨c, γ δ ^ e⟩` for every generator `δ` of
`Cn` otherwise, where `e = [Z : K ∩ Z]`. The key is Hilbert's Theorem 90 for `Cn = 𝔽_{p²}ˣ`: two
elements of `Nn \ Cn` with the same determinant are conjugate by an element of `Cn`.

## Main definitions

* `Matrix.GeneralLinearGroup.gammaGL`: the matrix `γ = !![1, 0; 0, -1]`.

## Main results

* `Matrix.GeneralLinearGroup.exists_mem_labelCn_gamma_conj_eq`: Hilbert's Theorem 90 for `Cn`.
* `Matrix.GeneralLinearGroup.exists_mem_labelCn_det_eq`: the norm from `Cn` to `𝔽_pˣ` is surjective.
* `Matrix.GeneralLinearGroup.exists_conj_eq_of_det_eq`: elements of `Nn \ Cn` with the same
  determinant are conjugate by an element of `Cn`.
* `Matrix.GeneralLinearGroup.labelNnAB_mem_subgroupConjClass`: the group `Nn.a.b` in the case where
  `det(K ∩ Cn)` and `-det(K \ Cn)` meet (Lemma 3.13 (2a) of Sutherland, arXiv:1504.07618v7).
* `Matrix.GeneralLinearGroup.exists_labelNnABC_eq_map_conj`: the group `Nn.a.b.e` in the case where
  they are disjoint (Lemma 3.13 (2b) and Corollary 3.17).
-/

open Matrix MulAction TauCeti

open scoped MatrixGroups Pointwise

namespace Matrix.GeneralLinearGroup

variable {p : ℕ} [Fact p.Prime] {K C : Subgroup (GL (Fin 2) (ZMod p))}
  {g x z c w δ : GL (Fin 2) (ZMod p)}

variable (p) in
/-- The matrix `γ = !![1, 0; 0, -1]`, which generates `Nn` modulo `Cn` for odd `p`. -/
noncomputable abbrev gammaGL : GL (Fin 2) (ZMod p) :=
  diagGL ![1, -1]

variable (p) in
lemma val_gammaGL : (gammaGL p).val = !![1, 0; 0, -1] := by
  rw [diagGL_coe]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

variable (p) in
lemma gammaGL_mul_self : gammaGL p * gammaGL p = 1 := by
  refine Units.ext ?_
  rw [Units.val_mul, val_gammaGL]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

variable (p) in
lemma det_gammaGL : det (gammaGL p) = -1 := Units.ext <| by
  rw [val_det_apply, val_gammaGL, Matrix.det_fin_two_of]
  simp

lemma gammaGL_notMem_labelCn (hp : p ≠ 2) : gammaGL p ∉ labelCn p := fun h ↦ by
  have h₁ : gammaGL p 1 1 = gammaGL p 0 0 := ((mem_labelCn_iff p hp).mp h).1
  rw [val_gammaGL] at h₁
  have h₂ : (2 : ZMod p) = 0 := by
    simp at h₁
    linear_combination -h₁
  exact two_ne_zero_of_ne_two p hp h₂

variable (c) in
lemma gamma_conj_val : (gammaGL p * c * gammaGL p).val = !![c 0 0, -c 0 1; -c 1 0, c 1 1] := by
  rw [Units.val_mul, Units.val_mul, val_gammaGL]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Matrix.vecMul, dotProduct]

lemma gamma_conj_mem_labelCn (hp : p ≠ 2) (hc : c ∈ labelCn p) :
    gammaGL p * c * gammaGL p ∈ labelCn p := by
  rw [mem_labelCn_iff p hp] at hc ⊢
  rw [gamma_conj_val]
  simp [hc.1, hc.2]

lemma mul_comm_of_mem_labelCn {y : GL (Fin 2) (ZMod p)} (hx : x ∈ labelCn p) (hy : y ∈ labelCn p) :
    x * y = y * x := by
  rcases hx with ⟨u, rfl⟩
  rcases hy with ⟨v, rfl⟩
  rw [← map_mul, mul_comm, map_mul]

lemma mem_labelNn_iff (hp : p ≠ 2) : g ∈ labelNn p ↔ g ∈ labelCn p ∨ gammaGL p * g ∈ labelCn p := by
  refine ⟨fun hg ↦ ?_, ?_⟩
  · rw [labelNn_eq_sup p hp, Subgroup.zpowers_eq_closure, ← Subgroup.closure_eq (labelCn p),
      ← Subgroup.closure_union] at hg
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with hx | hx
      · exact Or.inl hx
      · rw [Set.mem_singleton_iff.mp hx, gammaGL_mul_self]
        exact Or.inr (one_mem _)
    | one => exact Or.inl (one_mem _)
    | mul x y _ _ hx hy =>
      rcases hx with hx | hx <;> rcases hy with hy | hy
      · exact Or.inl (mul_mem hx hy)
      · refine Or.inr ?_
        have h : gammaGL p * (x * y) = (gammaGL p * x * gammaGL p) * (gammaGL p * y) := by
          simp only [mul_assoc, ← mul_assoc (gammaGL p) (gammaGL p), gammaGL_mul_self, one_mul]
        exact h ▸ mul_mem (gamma_conj_mem_labelCn hp hx) hy
      · exact Or.inr (by simpa only [mul_assoc] using mul_mem hx hy)
      · refine Or.inl ?_
        have h : x * y = (gammaGL p * (gammaGL p * x) * gammaGL p) * (gammaGL p * y) := by
          simp only [mul_assoc, ← mul_assoc (gammaGL p) (gammaGL p), gammaGL_mul_self, one_mul]
        exact h ▸ mul_mem (gamma_conj_mem_labelCn hp hx) hy
    | inv x _ hx =>
      rcases hx with hx | hx
      · exact Or.inl (inv_mem hx)
      · refine Or.inr ?_
        have hinv : (gammaGL p * x)⁻¹ = x⁻¹ * gammaGL p :=
          inv_eq_of_mul_eq_one_right (by rw [mul_assoc, mul_inv_cancel_left, gammaGL_mul_self])
        have h : gammaGL p * x⁻¹ = gammaGL p * (gammaGL p * x)⁻¹ * gammaGL p := by
          rw [hinv, mul_assoc, mul_assoc, gammaGL_mul_self, mul_one]
        exact h ▸ gamma_conj_mem_labelCn hp (inv_mem hx)
  · rintro (hg | hg)
    · exact labelCn_le_labelNn p hg
    · have h : g = gammaGL p * (gammaGL p * g) := by
        rw [← mul_assoc, gammaGL_mul_self, one_mul]
      rw [h, labelNn_eq_sup p hp]
      exact mul_mem (Subgroup.mem_sup_right (Subgroup.mem_zpowers _)) (Subgroup.mem_sup_left hg)

/-- **Hilbert's Theorem 90 for `Cn`**, for odd `p`: an element `c` of `Cn = 𝔽_{p²}ˣ` of norm
`det c = 1` is `w̄ / w` for some `w ∈ Cn`, where `w̄ = γ w γ` is the conjugate of `w`: take
`w = 1 + c̄` if `c ≠ -1`, and `w = ω` otherwise. -/
lemma exists_mem_labelCn_gamma_conj_eq (hp : p ≠ 2) (hc : c ∈ labelCn p) (hdet : det c = 1) :
    ∃ w ∈ labelCn p, gammaGL p * w * gammaGL p = c * w := by
  have hc' : c 1 1 = c 0 0 ∧ c 0 1 = (ZMod.leastPrimitiveRoot p : ZMod p) * c 1 0 :=
    (mem_labelCn_iff p hp).mp hc
  have hN : c 0 0 * c 0 0 - (ZMod.leastPrimitiveRoot p : ZMod p) * (c 1 0 * c 1 0) = 1 := by
    have h : (det c).val = 1 := by
      rw [hdet, Units.val_one]
    rw [val_det_apply, Matrix.det_fin_two, hc'.1, hc'.2] at h
    linear_combination h
  have hε₀ : (ZMod.leastPrimitiveRoot p : ZMod p) ≠ 0 := ZMod.leastPrimitiveRoot_ne_zero p
  have h2 : (2 : ZMod p) ≠ 0 := two_ne_zero_of_ne_two p hp
  by_cases ha : 1 + c 0 0 = 0
  · have ha' : c 0 0 = -1 := by
      linear_combination ha
    have hb : c 1 0 = 0 := by
      rw [ha'] at hN
      refine mul_self_eq_zero.mp (mul_left_cancel₀ hε₀ ?_)
      linear_combination -hN
    have hω : (omegaGL p).val = !![0, (ZMod.leastPrimitiveRoot p : ZMod p); 1, 0] := by
      rw [coe_omegaGL, nonsplitCartanA_of_ne_two p hp, nonsplitCartanB_of_ne_two p hp]
    refine ⟨omegaGL p, omegaGL_mem_labelCn p, Units.ext ?_⟩
    rw [gamma_conj_val, Units.val_mul, hω]
    have hcM : c.val = !![-1, 0; 0, -1] := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [hc'.1, hc'.2, ha', hb]
    rw [hcM]
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  · have hdetw : (!![1 + c 0 0, -((ZMod.leastPrimitiveRoot p : ZMod p) * c 1 0);
        -c 1 0, 1 + c 0 0] : Matrix (Fin 2) (Fin 2) (ZMod p)).det ≠ 0 := by
      rw [Matrix.det_fin_two_of]
      have h : (1 + c 0 0) * (1 + c 0 0) -
          -((ZMod.leastPrimitiveRoot p : ZMod p) * c 1 0) * -c 1 0 = 2 * (1 + c 0 0) := by
        linear_combination hN
      rw [h]
      exact mul_ne_zero h2 ha
    refine ⟨mkOfDetNeZero _ hdetw, (mem_labelCn_iff p hp).mpr (by simp), Units.ext ?_⟩
    rw [gamma_conj_val, Units.val_mul]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, hc'.1, hc'.2] <;>
      first | ring1 | linear_combination -hN

/-- **Elements of `Nn \ Cn` with the same determinant are conjugate by an element of `Cn`**, for odd
`p`, by Hilbert's Theorem 90. -/
lemma exists_conj_eq_of_det_eq (hp : p ≠ 2) (hx : x ∈ labelNn p) (hxC : x ∉ labelCn p)
    (hz : z ∈ labelNn p) (hzC : z ∉ labelCn p) (hdet : det x = det z) :
    ∃ w ∈ labelCn p, MulAut.conj w⁻¹ x = z := by
  have hc₁ : gammaGL p * x ∈ labelCn p := ((mem_labelNn_iff hp).mp hx).resolve_left hxC
  have hc₂ : gammaGL p * z ∈ labelCn p := ((mem_labelNn_iff hp).mp hz).resolve_left hzC
  rcases exists_mem_labelCn_gamma_conj_eq hp (mul_mem hc₁ (inv_mem hc₂))
    (by simp [hdet]) with ⟨w, hw, hwc⟩
  refine ⟨w, hw, ?_⟩
  have hkey : x * w = w * z := by
    have h₁ : gammaGL p * (w * z) = (gammaGL p * w * gammaGL p) * (gammaGL p * z) := by
      simp only [mul_assoc, ← mul_assoc (gammaGL p) (gammaGL p), gammaGL_mul_self, one_mul]
    have h₂ : gammaGL p * (x * w) = gammaGL p * x * w := by
      rw [mul_assoc]
    refine mul_left_cancel (a := gammaGL p) ?_
    rw [h₁, h₂, hwc, mul_assoc, mul_assoc, mul_comm_of_mem_labelCn hw hc₂, ← mul_assoc, ← mul_assoc,
      mul_assoc _ _ (gammaGL p * z), inv_mul_cancel, mul_one]
  rw [MulAut.conj_apply, inv_inv, mul_assoc, hkey, inv_mul_cancel_left]

/-- **The norm from `Cn` to `𝔽_pˣ` is surjective**: Mathlib's `FiniteField.unitsMap_norm_surjective`
for `𝔽_{p²}`. -/
lemma exists_mem_labelCn_det_eq (u : (ZMod p)ˣ) : ∃ c ∈ labelCn p, det c = u := by
  have : Finite (NonsplitCartanAlgebra p) := Finite.of_equiv _ (QuadraticAlgebra.equivProd _ _).symm
  rcases FiniteField.unitsMap_norm_surjective (ZMod p) (NonsplitCartanAlgebra p) u with ⟨z, rfl⟩
  exact ⟨_, ⟨z, rfl⟩, Units.ext (val_det_unitsLeftMulMatrix _ z)⟩

lemma mem_zpowers_det_of_zpowers_eq (hδ : Subgroup.zpowers δ = labelCn p) (u : (ZMod p)ˣ) :
    u ∈ Subgroup.zpowers (det δ) := by
  rcases exists_mem_labelCn_det_eq u with ⟨c', hc', rfl⟩
  rcases Subgroup.mem_zpowers_iff.mp (hδ ▸ hc' : c' ∈ Subgroup.zpowers δ) with ⟨m, rfl⟩
  exact ⟨m, (map_zpow _ _ _).symm⟩

lemma map_conj_inf_eq (hC : ∀ y ∈ C, y * w = w * y) :
    K.map (MulAut.conj w).toMonoidHom ⊓ C = K ⊓ C := by
  ext y
  simp only [Subgroup.mem_inf, and_congr_left_iff]
  intro hy
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply, mul_assoc, hC y hy, ← mul_assoc,
    inv_mul_cancel, one_mul]

lemma forall_neg_det_notMem_map_conj_iff (hw : w ∈ C) (hC : ∀ y ∈ C, y * w = w * y) :
    (∀ x ∈ K.map (MulAut.conj w).toMonoidHom, x ∉ C →
      -det x ∉ (K.map (MulAut.conj w).toMonoidHom ⊓ C).map det) ↔ ∀ x ∈ K, x ∉ C →
        -det x ∉ (K ⊓ C).map det := by
  have hnorm {y : GL (Fin 2) (ZMod p)} : MulAut.conj w y ∈ C ↔ y ∈ C := by
    constructor
    · intro h
      simpa [mul_assoc] using mul_mem (mul_mem (inv_mem hw) h) hw
    · intro h
      exact mul_mem (mul_mem hw h) (inv_mem hw)
  have hdet (y : GL (Fin 2) (ZMod p)) : det (MulAut.conj w y) = det y := by
    simp
  rw [map_conj_inf_eq hC]
  constructor
  · intro h x hx hxC
    rw [← hdet x]
    exact h _ (Subgroup.mem_map_of_mem _ hx) (hnorm.not.mpr hxC)
  · rintro h - ⟨x, hx, rfl⟩ hxC
    rw [MulEquiv.coe_toMonoidHom, hdet]
    exact h x hx (hnorm.not.mp hxC)

lemma map_conj_inf_labelCn (hw : w ∈ labelCn p) :
    K.map (MulAut.conj w).toMonoidHom ⊓ labelCn p = K ⊓ labelCn p :=
  map_conj_inf_eq fun _ hy ↦ mul_comm_of_mem_labelCn hy hw

lemma eq_inf_labelCn_sup_zpowers (hp : p ≠ 2) (hK : K ≤ labelNn p) (hz : z ∈ K)
    (hzC : z ∉ labelCn p) : K = (K ⊓ labelCn p) ⊔ Subgroup.zpowers z := by
  refine le_antisymm (fun k hk ↦ ?_) (sup_le inf_le_left (Subgroup.zpowers_le.mpr hz))
  by_cases hkC : k ∈ labelCn p
  · exact Subgroup.mem_sup_left ⟨hk, hkC⟩
  · have hc₁ : gammaGL p * k ∈ labelCn p := ((mem_labelNn_iff hp).mp (hK hk)).resolve_left hkC
    have hc₂ : gammaGL p * z ∈ labelCn p := ((mem_labelNn_iff hp).mp (hK hz)).resolve_left hzC
    have h : k = (k * z⁻¹) * z := by
      rw [inv_mul_cancel_right]
    have hkz : k * z⁻¹ ∈ labelCn p := by
      have hinv : (gammaGL p * z)⁻¹ = z⁻¹ * gammaGL p :=
        inv_eq_of_mul_eq_one_right (by rw [mul_assoc, mul_inv_cancel_left, gammaGL_mul_self])
      have h₁ : k * z⁻¹ = gammaGL p * ((gammaGL p * k) * (gammaGL p * z)⁻¹) * gammaGL p := by
        rw [hinv]
        simp only [mul_assoc, gammaGL_mul_self, mul_one, ← mul_assoc (gammaGL p) (gammaGL p),
          one_mul]
      rw [h₁]
      exact gamma_conj_mem_labelCn hp (mul_mem hc₁ (inv_mem hc₂))
    rw [h]
    exact mul_mem (Subgroup.mem_sup_left (Subgroup.mem_inf.mpr ⟨mul_mem hk (inv_mem hz), hkz⟩))
      (Subgroup.mem_sup_right (Subgroup.mem_zpowers z))

lemma val_eq_of_mem_labelCn (hp : p ≠ 2) (hc : c ∈ labelCn p) :
    c.val = !![((c 0 0).val : ZMod p), (ZMod.leastPrimitiveRoot p : ZMod p) *
      ((c 1 0).val : ZMod p); ((c 1 0).val : ZMod p), ((c 0 0).val : ZMod p)] := by
  have hc' : c 1 1 = c 0 0 ∧ c 0 1 = (ZMod.leastPrimitiveRoot p : ZMod p) * c 1 0 :=
    (mem_labelCn_iff p hp).mp hc
  rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hc'.1, hc'.2]

lemma labelCnAB_val_eq_zpowers (hp : p ≠ 2) (hc : c ∈ labelCn p) :
    labelCnAB p (c 0 0).val (c 1 0).val = Subgroup.zpowers c := by
  rw [labelCnAB, ← val_eq_of_mem_labelCn hp hc, ← Set.image_singleton,
    Set.preimage_image_eq _ Units.val_injective, ← Subgroup.zpowers_eq_closure]

lemma labelNnAB_val_eq_sup (hp : p ≠ 2) (hc : c ∈ labelCn p) :
    labelNnAB p (c 0 0).val (c 1 0).val = Subgroup.zpowers c ⊔ Subgroup.zpowers (gammaGL p) := by
  rw [labelNnAB, ← val_eq_of_mem_labelCn hp hc, ← val_gammaGL, ← Set.image_pair,
    Set.preimage_image_eq _ Units.val_injective, Subgroup.zpowers_eq_closure,
    Subgroup.zpowers_eq_closure, ← Subgroup.closure_union, Set.singleton_union]

lemma labelNnABC_val_eq_sup (hp : p ≠ 2) (hc : c ∈ labelCn p) (e : ℕ) :
    labelNnABC p (c 0 0).val (c 1 0).val e δ = Subgroup.zpowers c ⊔
      Subgroup.zpowers (gammaGL p * δ ^ e) := by
  rw [labelNnABC, ← val_eq_of_mem_labelCn hp hc, ← Set.image_singleton,
    Set.preimage_image_eq _ Units.val_injective, ← Subgroup.zpowers_eq_closure]

lemma gammaGL_mem_labelNn (hp : p ≠ 2) : gammaGL p ∈ labelNn p := by
  rw [labelNn_eq_sup p hp]
  exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)

lemma map_conj_le_labelNn (hK : K ≤ labelNn p) (hw : w ∈ labelCn p) :
    K.map (MulAut.conj w).toMonoidHom ≤ labelNn p := by
  rintro - ⟨k, hk, rfl⟩
  have hw' : w ∈ labelNn p := labelCn_le_labelNn p hw
  exact mul_mem (mul_mem hw' (hK hk)) (inv_mem hw')

/-- **Case (2a) of Lemma 3.13 of Sutherland** (arXiv:1504.07618v7): a subgroup `K` of `Nn` with
`K ∩ Cn = ⟨c⟩`, for which `det(K ∩ Cn)` and `-det(K \ Cn)` meet, is conjugate to `⟨c, γ⟩`, which is
the group `Nn.a.b` for `c = !![a, ε b; b, a]`. -/
lemma labelNnAB_mem_subgroupConjClass (hp : p ≠ 2) (hK : K ≤ labelNn p) (hcC : c ∈ labelCn p)
    (hc : K ⊓ labelCn p = Subgroup.zpowers c) (hxK : x ∈ K) (hxC : x ∉ labelCn p)
    (hxdet : -det x ∈ (K ⊓ labelCn p).map det) :
    labelNnAB p (c 0 0).val (c 1 0).val ∈ subgroupConjClass p K := by
  rcases hxdet with ⟨h, hh, hhx⟩
  have hhK : h ∈ K := hh.1
  have hhC : h ∈ labelCn p := hh.2
  have hx'C : x * h⁻¹ ∉ labelCn p := fun hx' ↦ hxC <| by
    simpa using mul_mem hx' hhC
  have hdet : det (x * h⁻¹) = det (gammaGL p) := by
    rw [map_mul, map_inv, hhx, det_gammaGL, inv_neg, mul_neg, mul_inv_cancel]
  have hx'K : x * h⁻¹ ∈ K := mul_mem hxK (inv_mem hhK)
  have hγ : gammaGL p ∉ labelCn p := gammaGL_notMem_labelCn hp
  rcases exists_conj_eq_of_det_eq hp (hK hx'K) hx'C (gammaGL_mem_labelNn hp) hγ hdet with
    ⟨w, hw, hwx⟩
  have hK' : K.map (MulAut.conj w⁻¹).toMonoidHom =
      Subgroup.zpowers c ⊔ Subgroup.zpowers (gammaGL p) := by
    rw [eq_inf_labelCn_sup_zpowers hp (map_conj_le_labelNn hK (inv_mem hw))
      (hwx ▸ Subgroup.mem_map_of_mem _ hx'K) hγ, map_conj_inf_labelCn (inv_mem hw), hc]
  rw [labelNnAB_val_eq_sup hp hcC, ← hK']
  exact map_conj_mem_subgroupConjClass K _

lemma relIndex_inf_center_eq_index_comap_scalar :
    (K ⊓ Subgroup.center (GL (Fin 2) (ZMod p))).relIndex (Subgroup.center (GL (Fin 2) (ZMod p))) =
      (K.comap (scalar (Fin 2))).index := by
  rw [Subgroup.inf_relIndex_right, Subgroup.index_comap, center_eq_range_scalar]

lemma mul_self_eq_scalar_of_trace_eq_zero (hx : x.val.trace = 0) :
    x * x = scalar (Fin 2) (-det x) := Units.ext <| by
  rw [Units.val_mul, ← sq, sq_eq_trace_smul_sub_det_smul_one_fin_two, hx, zero_smul, zero_sub]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

lemma trace_eq_zero_of_mem_labelNn (hp : p ≠ 2) (hx : x ∈ labelNn p) (hxC : x ∉ labelCn p) :
    x.val.trace = 0 := by
  have h : (gammaGL p * x) 1 1 = (gammaGL p * x) 0 0 :=
    ((mem_labelCn_iff p hp).mp (((mem_labelNn_iff hp).mp hx).resolve_left hxC)).1
  have h₀₀ : (gammaGL p * x).val 0 0 = x 0 0 := by
    rw [Units.val_mul, val_gammaGL]
    simp [Matrix.mul_apply]
  have h₁₁ : (gammaGL p * x).val 1 1 = -x 1 1 := by
    rw [Units.val_mul, val_gammaGL]
    simp [Matrix.mul_apply]
  rw [h₀₀, h₁₁] at h
  rw [Matrix.trace_fin_two]
  linear_combination -h

lemma exists_mul_sq_eq_pow_relIndex {g₀ t : (ZMod p)ˣ} (hgen : ∀ u, u ∈ Subgroup.zpowers g₀)
    (ht : scalar (Fin 2) t ∈ K) (hns : ∀ u, scalar (Fin 2) u ∈ K → u ^ 2 ≠ t) :
    ∃ s, scalar (Fin 2) s ∈ K ∧ t * s ^ 2 = g₀ ^ (K ⊓ Subgroup.center _).relIndex
      (Subgroup.center _) := by
  generalize he : (K ⊓ Subgroup.center _).relIndex (Subgroup.center _) = e
  have hindex : (K.comap (scalar (Fin 2))).index = e :=
    relIndex_inf_center_eq_index_comap_scalar.symm.trans he
  have hζ : Subgroup.zpowers (g₀ ^ e) = K.comap (scalar (Fin 2)) := by
    rw [IsCyclic.subgroup_eq_iff_index_eq, hindex]
    have hcard : Nat.card (Subgroup.zpowers (g₀ ^ e)) * (Subgroup.zpowers (g₀ ^ e)).index =
        Nat.card (ZMod p)ˣ := Subgroup.card_mul_index _
    have hord : orderOf g₀ = Nat.card (ZMod p)ˣ := orderOf_eq_card_of_forall_mem_zpowers hgen
    have hdvd : e ∣ Nat.card (ZMod p)ˣ := hindex ▸ Subgroup.index_dvd_card _
    have hpos : 0 < Nat.card (ZMod p)ˣ := Nat.card_pos
    rw [Nat.card_zpowers, orderOf_pow, hord, Nat.gcd_eq_right hdvd] at hcard
    exact Nat.eq_of_mul_eq_mul_left (Nat.div_pos (Nat.le_of_dvd hpos hdvd)
      (Nat.pos_of_dvd_of_pos hdvd hpos)) (hcard.trans (Nat.div_mul_cancel hdvd).symm)
  have hscalar {u : (ZMod p)ˣ} (hu : u ∈ Subgroup.zpowers (g₀ ^ e)) : scalar (Fin 2) u ∈ K := by
    rw [hζ] at hu
    exact hu
  have ht' : t ∈ Subgroup.zpowers (g₀ ^ e) := by
    rw [hζ]
    exact ht
  rcases Subgroup.mem_zpowers_iff.mp ht' with ⟨k, hk⟩
  rcases Int.even_or_odd' k with ⟨m, rfl | rfl⟩
  · refine absurd ?_ (hns ((g₀ ^ e) ^ m) (hscalar (zpow_mem (Subgroup.mem_zpowers _) m)))
    rw [← hk]
    group
  · refine ⟨(g₀ ^ e) ^ (-m), hscalar (zpow_mem (Subgroup.mem_zpowers _) _), ?_⟩
    rw [← hk]
    group

/-- **Case (2b) of Lemma 3.13 and Corollary 3.17 of Sutherland** (arXiv:1504.07618v7): a subgroup
`K` of `Nn` not in `Cn` with `K ∩ Cn = ⟨c⟩`, for which `det(K ∩ Cn)` and `-det(K \ Cn)` are
disjoint, is conjugate to `⟨c, γ δ ^ e⟩` by an element of `Cn`, for every generator `δ` of `Cn` and
`e = [Z : K ∩ Z]`: this is the group `Nn.a.b.e` for `c = !![a, ε b; b, a]`. -/
lemma exists_labelNnABC_eq_map_conj (hp : p ≠ 2) (hK : K ≤ labelNn p) (hcC : c ∈ labelCn p)
    (hc : K ⊓ labelCn p = Subgroup.zpowers c) (hne : ¬K ≤ labelCn p) (hdisj : IsNnDetDisjoint p K)
    (hδ : Subgroup.zpowers δ = labelCn p) : ∃ w ∈ labelCn p, labelNnABC p (c 0 0).val (c 1 0).val
      ((K ⊓ Subgroup.center _).relIndex (Subgroup.center _)) δ =
        K.map (MulAut.conj w⁻¹).toMonoidHom := by
  rcases Set.not_subset.mp hne with ⟨x, hxK, hxC⟩
  have hδC : δ ∈ labelCn p := hδ ▸ Subgroup.mem_zpowers δ
  have hxx : x * x = scalar (Fin 2) (-det x) :=
    mul_self_eq_scalar_of_trace_eq_zero (trace_eq_zero_of_mem_labelNn hp (hK hxK) hxC)
  rcases exists_mul_sq_eq_pow_relIndex (mem_zpowers_det_of_zpowers_eq hδ)
    (hxx ▸ mul_mem hxK hxK : scalar (Fin 2) (-det x) ∈ K)
    (fun u hu hut ↦ hdisj x hxK hxC ⟨scalar (Fin 2) u, Subgroup.mem_inf.mpr
      ⟨hu, scalar_mem_labelCn hp u⟩, by rw [det_scalar, Fintype.card_fin, hut]⟩) with ⟨s, hs, hts⟩
  generalize (K ⊓ Subgroup.center _).relIndex (Subgroup.center _) = e at hts ⊢
  have hz₁ : gammaGL p * (gammaGL p * δ ^ e) = δ ^ e := by
    rw [← mul_assoc, gammaGL_mul_self, one_mul]
  have hzN : gammaGL p * δ ^ e ∈ labelNn p :=
    (mem_labelNn_iff hp).mpr <| Or.inr <| by
      rw [hz₁]
      exact pow_mem hδC e
  have hzC : gammaGL p * δ ^ e ∉ labelCn p := fun h ↦ gammaGL_notMem_labelCn hp <| by
    simpa using mul_mem h (inv_mem (pow_mem hδC e))
  have hx'K : x * scalar (Fin 2) s ∈ K := mul_mem hxK hs
  have hx'C : x * scalar (Fin 2) s ∉ labelCn p := fun h ↦ hxC <| by
    simpa using mul_mem h (inv_mem (scalar_mem_labelCn hp s))
  have hdet : det (x * scalar (Fin 2) s) = det (gammaGL p * δ ^ e) := by
    rw [map_mul, map_mul, det_gammaGL, det_scalar, Fintype.card_fin, map_pow, ← hts, neg_mul,
      neg_mul, one_mul, neg_neg]
  rcases exists_conj_eq_of_det_eq hp (hK hx'K) hx'C hzN hzC hdet with ⟨w, hw, hwx⟩
  refine ⟨w, hw, ?_⟩
  rw [labelNnABC_val_eq_sup hp hcC, eq_inf_labelCn_sup_zpowers hp
    (map_conj_le_labelNn hK (inv_mem hw)) (hwx ▸ Subgroup.mem_map_of_mem _ hx'K) hzC,
    map_conj_inf_labelCn (inv_mem hw), hc]

lemma isNnDetDisjoint_map_conj_iff (hw : w ∈ labelCn p) :
    IsNnDetDisjoint p (K.map (MulAut.conj w).toMonoidHom) ↔ IsNnDetDisjoint p K :=
  forall_neg_det_notMem_map_conj_iff hw fun _ hy ↦ mul_comm_of_mem_labelCn hy hw

end Matrix.GeneralLinearGroup
