import LeanBridge.ForMathlib.GroupTheory.SubnormalSeries
import Mathlib.Algebra.Order.BigOperators.Group.LocallyFinite
import Mathlib.GroupTheory.PresentedGroup
import TauCeti.GroupTheory.Solvable

/-!
# Polycyclic presentations of finite groups

A polycyclic series of a group `G` is a subnormal series `G = G_0 ⊵ G_1 ⊵ ⋯ ⊵ G_n = 1` whose
factors `G_i / G_{i+1}` are cyclic, and a polycyclic sequence is a sequence `g_0, …, g_{n-1}` with
`G_i / G_{i+1}` generated by `g_i G_{i+1}`; then `G_i = ⟨g_i, …, g_{n-1}⟩`, so that a polycyclic
sequence determines its series. The orders `r_i` of the factors are the relative orders. The terms
of the sequence satisfy relations `g_i ^ r_i = ∏_{k > i} g_k ^ a_{i,k}` and
`g_j⁻¹ g_i g_j = ∏_{k > j} g_k ^ b_{i,j,k}` for `j < i`, and when `G` is finite these relations
present `G`: this is its polycyclic presentation. Every finite solvable group has a polycyclic
sequence.

The LMFDB indexes the sequence from `1`, and chooses one polycyclic presentation of each group by a
list of criteria; that choice is a database convention, which is not formalised here. It presents
abelian groups instead as quotients of free abelian groups, that is, by generators and relations as
`ℤ`-modules: these presentations are Mathlib's `Module.Presentation ℤ`.

## Main definitions

* `Subgroup.closureFrom`: the subgroup `⟨g_i, …, g_{n-1}⟩` generated by the terms of a sequence from
  index `i` on.
* `Subgroup.SubnormalSeries.IsPolycyclic` (LMFDB `group.presentation`): polycyclic series.
* `PolycyclicPresentation.prodFrom`: the product `∏_{k ≥ i} g_k ^ e_k`.
* `PolycyclicPresentation.relators` (LMFDB `group.presentation`): the relators of a polycyclic
  presentation.
* `PolycyclicSequence` (LMFDB `group.presentation`): polycyclic sequences.
* `PolycyclicSequence.series` (LMFDB `group.presentation`): the polycyclic series of a polycyclic
  sequence.
* `PolycyclicSequence.relOrder` (LMFDB `group.presentation`): its relative orders.
* `PolycyclicSequence.toSubnormalSeries` (LMFDB `group.normal_series`): the polycyclic series, as
  a subnormal series.
* `PolycyclicSequence.presentationEquiv` (LMFDB `group.presentation`): the isomorphism between the
  group defined by the polycyclic presentation of a polycyclic sequence of a finite group and the
  group.
* `PolycyclicSequence.consSeq` and `PolycyclicSequence.cons`: the extension of a polycyclic
  sequence of a normal subgroup.

## Main results

* `PolycyclicPresentation.finite_presentedGroup` and
  `PolycyclicPresentation.card_presentedGroup_le`: a polycyclic presentation defines a finite
  group, of order at most the product of its relative orders.
* `PolycyclicSequence.isCyclic_quotient`: the factors of the polycyclic series of a polycyclic
  sequence are cyclic.
* `PolycyclicSequence.isPolycyclic_toSubnormalSeries`: the polycyclic series of a polycyclic
  sequence is a polycyclic series.
* `PolycyclicSequence.card_eq_prod_relOrder`: the order of a group is the product of the relative
  orders.
* `PolycyclicSequence.exists_relations`: a polycyclic sequence satisfies the relations of a
  polycyclic presentation.
* `PolycyclicSequence.bijective_toGroup`: for a finite group, these relations present the group.
* `PolycyclicSequence.nonempty_of_isSolvable`: every finite solvable group has a polycyclic
  sequence.
-/

open Group Subgroup

variable {G H : Type*} [Group G] [Group H] {n : ℕ}

namespace Subgroup

variable (g : Fin n → G) {i j : ℕ} (k : Fin n) {x : G} {N : Subgroup G}
  (hx : x ∈ normalizer (N : Set G))

variable (i) in
/-- The subgroup `⟨g_i, …, g_{n-1}⟩` generated by the terms of a sequence `g` from index `i` on. -/
def closureFrom : Subgroup G :=
  closure {y | ∃ l : Fin n, i ≤ l ∧ g l = y}

lemma mem_closureFrom (h : i ≤ k) : g k ∈ closureFrom g i :=
  subset_closure ⟨k, h, rfl⟩

lemma closureFrom_mono (h : i ≤ j) : closureFrom g j ≤ closureFrom g i :=
  closure_mono fun _ ⟨l, hl, hy⟩ ↦ ⟨l, h.trans hl, hy⟩

lemma closureFrom_zero : closureFrom g 0 = closure (Set.range g) := by
  simp [closureFrom, Set.range]

lemma closureFrom_of_le (h : n ≤ i) : closureFrom g i = ⊥ := by
  rw [closureFrom, closure_eq_bot_iff]
  rintro _ ⟨l, hl, -⟩
  omega

lemma closureFrom_eq_sup : closureFrom g k = zpowers (g k) ⊔ closureFrom g (k + 1) := by
  rw [zpowers_eq_closure, closureFrom, closureFrom, ← closure_union]
  congr 1
  ext y
  constructor
  · rintro ⟨l, hl, rfl⟩
    rcases hl.eq_or_lt with h | h
    · exact Or.inl (congrArg g (Fin.ext h.symm))
    · exact Or.inr ⟨l, h, rfl⟩
  · rintro (rfl | ⟨l, hl, rfl⟩)
    · exact ⟨k, le_rfl, rfl⟩
    · exact ⟨l, by omega, rfl⟩

lemma normal_subgroupOf_map (f : H →* G) {A B : Subgroup H} (hAB : A ≤ B)
    (h : (A.subgroupOf B).Normal) : ((A.map f).subgroupOf (B.map f)).Normal :=
  (normal_subgroupOf_iff_le_normalizer (map_mono hAB)).mpr <|
    (map_mono ((normal_subgroupOf_iff_le_normalizer hAB).mp h)).trans (le_normalizer_map f)

include hx in
lemma exists_zpow_mul_eq_of_mem_sup {z : G} (hz : z ∈ zpowers x ⊔ N) :
    ∃ m : ℤ, ∃ y ∈ N, x ^ m * y = z := by
  have hconj (m : ℤ) (y : G) (hy : y ∈ N) : x ^ m * y * (x ^ m)⁻¹ ∈ N :=
    (mem_normalizer_iff.mp (zpow_mem hx m) y).mp hy
  let S : Subgroup G :=
    { carrier := {z | ∃ m : ℤ, ∃ y ∈ N, x ^ m * y = z}
      mul_mem' := by
        rintro _ _ ⟨m, y, hy, rfl⟩ ⟨m', y', hy', rfl⟩
        refine ⟨m + m', (x ^ m')⁻¹ * y * x ^ m' * y', mul_mem ?_ hy', ?_⟩
        · simpa using hconj (-m') y hy
        · rw [zpow_add]
          group
      one_mem' := ⟨0, 1, one_mem N, by rw [zpow_zero, one_mul]⟩
      inv_mem' := by
        rintro _ ⟨m, y, hy, rfl⟩
        refine ⟨-m, x ^ m * y⁻¹ * (x ^ m)⁻¹, hconj m _ (inv_mem hy), ?_⟩
        group }
  have hle : zpowers x ⊔ N ≤ S :=
    sup_le (zpowers_le.mpr ⟨1, 1, one_mem N, by rw [zpow_one, mul_one]⟩)
      fun y hy ↦ ⟨0, y, hy, by rw [zpow_zero, one_mul]⟩
  exact hle hz

include hx in
lemma isCyclic_quotient_of_eq_sup {K : Subgroup G} [(N.subgroupOf K).Normal] (hxK : x ∈ K)
    (h : K = zpowers x ⊔ N) : IsCyclic (K ⧸ N.subgroupOf K) := by
  refine ⟨⟨QuotientGroup.mk ⟨x, hxK⟩, fun q ↦ ?_⟩⟩
  rcases QuotientGroup.mk_surjective q with ⟨⟨z, hz⟩, rfl⟩
  rcases exists_zpow_mul_eq_of_mem_sup hx (h ▸ hz) with ⟨m, y, hy, rfl⟩
  refine ⟨m, ?_⟩
  dsimp only
  rw [← QuotientGroup.mk_zpow, QuotientGroup.eq]
  simpa [mem_subgroupOf] using hy

namespace SubnormalSeries

/-- A subnormal series `⊥ = H₀ ⊴ H₁ ⊴ ⋯ ⊴ Hₖ = ⊤` is **polycyclic** (LMFDB `group.presentation`),
or a polycyclic series, if its factors `Hᵢ₊₁ / Hᵢ` are cyclic. -/
def IsPolycyclic (s : SubnormalSeries G) : Prop :=
  ∀ i : Fin s.length, IsCyclic (s i.succ ⧸ (s i.castSucc).subgroupOf (s i.succ))

end SubnormalSeries

end Subgroup

namespace PolycyclicPresentation

variable (g : Fin n → G) (e : Fin n → ℤ)

/-- The product `∏_{k ≥ i} g_k ^ e_k` of the powers of the terms of a sequence `g` from index `i`
on, in increasing order of `k`. -/
def prodFrom (i : ℕ) : G :=
  if h : i < n then g ⟨i, h⟩ ^ e ⟨i, h⟩ * prodFrom (i + 1) else 1
termination_by n - i

variable {i : ℕ} (k : Fin n) (r : Fin n → ℕ) (hr : ∀ j, r j ≠ 0)
  (hpow : ∀ j : Fin n, g j ^ r j ∈ closureFrom g (j + 1))
  (hconj : ∀ j l : Fin n, l < j → (g l)⁻¹ * g j * g l ∈ closureFrom g (l + 1))

lemma prodFrom_of_lt (h : i < n) : prodFrom g e i = g ⟨i, h⟩ ^ e ⟨i, h⟩ * prodFrom g e (i + 1) := by
  rw [prodFrom, dite_eq_left h]

lemma prodFrom_of_le (h : n ≤ i) : prodFrom g e i = 1 := by
  rw [prodFrom, dite_eq_right (by omega)]

variable (i) in
lemma map_prodFrom (f : G →* H) : f (prodFrom g e i) = prodFrom (f ∘ g) e i := by
  induction h : n - i generalizing i with
  | zero =>
    rw [prodFrom_of_le g e (i := i) (by omega), prodFrom_of_le (f ∘ g) e (i := i) (by omega),
      map_one]
  | succ m ih =>
    rw [prodFrom_of_lt g e (i := i) (by omega), prodFrom_of_lt (f ∘ g) e (i := i) (by omega),
      map_mul, map_zpow, ih (i + 1) (by omega), Function.comp_apply]

variable (i) in
lemma lift_prodFrom : FreeGroup.lift g (prodFrom FreeGroup.of e i) = prodFrom g e i := by
  rw [map_prodFrom]
  congr 1
  funext l
  exact FreeGroup.lift_apply_of

lemma prodFrom_congr {e' : Fin n → ℤ} (h : ∀ l : Fin n, i ≤ l → e l = e' l) :
    prodFrom g e i = prodFrom g e' i := by
  induction hn : n - i generalizing i with
  | zero => rw [prodFrom_of_le g e (i := i) (by omega), prodFrom_of_le g e' (i := i) (by omega)]
  | succ m ih =>
    rw [prodFrom_of_lt g e (i := i) (by omega), prodFrom_of_lt g e' (i := i) (by omega),
      h ⟨i, by omega⟩ le_rfl, ih (fun l hl ↦ h l (by omega)) (by omega)]

variable (i) in
lemma prodFrom_mem_closureFrom : prodFrom g e i ∈ closureFrom g i := by
  induction h : n - i generalizing i with
  | zero =>
    rw [prodFrom_of_le g e (i := i) (by omega)]
    exact one_mem _
  | succ m ih =>
    rw [prodFrom_of_lt g e (i := i) (by omega)]
    exact mul_mem (zpow_mem (mem_closureFrom g ⟨i, by omega⟩ le_rfl) _)
      (closureFrom_mono g (Nat.le_succ i) (ih (i + 1) (by omega)))

include hconj in
lemma inv_mul_mul_mem_closureFrom {y : G} (hy : y ∈ closureFrom g (k + 1)) :
    (g k)⁻¹ * y * g k ∈ closureFrom g (k + 1) := by
  induction hy using closure_induction with
  | mem y hy =>
    rcases hy with ⟨l, hl, rfl⟩
    exact hconj l k (Fin.lt_def.mpr (by omega))
  | one =>
    rw [mul_one, inv_mul_cancel]
    exact one_mem _
  | mul y z _ _ hy hz =>
    have h : (g k)⁻¹ * (y * z) * g k = (g k)⁻¹ * y * g k * ((g k)⁻¹ * z * g k) := by group
    rw [h]
    exact mul_mem hy hz
  | inv y _ hy =>
    have h : (g k)⁻¹ * y⁻¹ * g k = ((g k)⁻¹ * y * g k)⁻¹ := by group
    rw [h]
    exact inv_mem hy

include hr hpow hconj in
lemma mem_normalizer_closureFrom : g k ∈ normalizer (closureFrom g (k + 1) : Set G) := by
  have hpowconj (m : ℕ) {y : G} (hy : y ∈ closureFrom g (k + 1)) :
      (g k ^ m)⁻¹ * y * g k ^ m ∈ closureFrom g (k + 1) := by
    induction m with
    | zero => simpa using hy
    | succ m ih =>
      have h :
          (g k ^ (m + 1))⁻¹ * y * g k ^ (m + 1) = (g k)⁻¹ * ((g k ^ m)⁻¹ * y * g k ^ m) * g k := by
        group
      rw [h]
      exact inv_mul_mul_mem_closureFrom g k hconj ih
  rw [mem_normalizer_iff'']
  refine fun y ↦ ⟨inv_mul_mul_mem_closureFrom g k hconj, fun hy ↦ ?_⟩
  rcases Nat.exists_eq_add_one_of_ne_zero (hr k) with ⟨m, hm⟩
  have h : y = g k ^ r k * ((g k ^ m)⁻¹ * ((g k)⁻¹ * y * g k) * g k ^ m) * (g k ^ r k)⁻¹ := by
    rw [hm]
    group
  rw [h]
  exact mul_mem (mul_mem (hpow k) (hpowconj m hy)) (inv_mem (hpow k))

include hr hpow hconj in
variable (i) in
lemma encard_closureFrom_le : ENat.card (closureFrom g i) ≤ (∏ l ∈ Finset.Ico i n, if h : l < n then
    r ⟨l, h⟩ else 1 : ℕ) := by
  induction h : n - i generalizing i with
  | zero =>
    rw [closureFrom_of_le g (by omega), Finset.Ico_eq_empty_of_le (by omega), Finset.prod_empty,
      ENat.card_eq_coe_natCard, card_bot]
  | succ m ih =>
    have hi : i < n := by omega
    let ii : Fin n := ⟨i, hi⟩
    have hsup : closureFrom g i = zpowers (g ii) ⊔ closureFrom g (i + 1) := closureFrom_eq_sup g ii
    have hpos : (0 : ℤ) < r ii := by exact_mod_cast Nat.pos_of_ne_zero (hr ii)
    let F : Fin (r ii) × closureFrom g (i + 1) → closureFrom g i := fun p ↦
      ⟨g ii ^ (p.1 : ℕ) * p.2,
        hsup.ge (mul_mem (mem_sup_left (pow_mem (mem_zpowers _) _)) (mem_sup_right p.2.2))⟩
    have hF : Function.Surjective F := by
      rintro ⟨z, hz⟩
      rw [hsup] at hz
      rcases exists_zpow_mul_eq_of_mem_sup (mem_normalizer_closureFrom g ii r hr hpow hconj) hz
        with ⟨t, y, hy, rfl⟩
      have h₀ : 0 ≤ t % (r ii : ℤ) := Int.emod_nonneg t hpos.ne'
      have h₁ : t % (r ii : ℤ) < r ii := Int.emod_lt_of_pos t hpos
      refine ⟨(⟨(t % (r ii : ℤ)).toNat, by omega⟩,
        ⟨(g ii ^ r ii) ^ (t / (r ii : ℤ)) * y, mul_mem (zpow_mem (hpow ii) _) hy⟩), ?_⟩
      apply Subtype.ext
      simp only [F]
      rw [← mul_assoc, ← zpow_natCast, Int.toNat_of_nonneg h₀, ← zpow_natCast (g ii) (r ii),
        ← zpow_mul, ← zpow_add, Int.emod_add_mul_ediv]
    refine (ENat.card_le_card_of_injective (Function.injective_surjInv hF)).trans ?_
    rw [ENat.card_prod, ENat.card_eq_coe_fintype_card, Fintype.card_fin,
      Finset.prod_eq_prod_Ico_succ_bot hi, dite_eq_left hi, Nat.cast_mul]
    exact mul_le_mul_right (ih (i + 1) (by omega)) _

/-- The relators of the **polycyclic presentation** (LMFDB `group.presentation`) on generators
`x_0, …, x_{n-1}` with relative orders `r`, power exponents `a` and conjugation exponents `b`: the
relations `x_i ^ r_i = ∏_{k > i} x_k ^ a_{i,k}` and `x_j⁻¹ x_i x_j = ∏_{k > j} x_k ^ b_{i,j,k}` for
`j < i`, the products being taken in increasing order of `k`. For a polycyclic sequence of a
finite group, with its relative orders, they present the group
(`PolycyclicSequence.presentationEquiv`). -/
def relators (a : Fin n → Fin n → ℤ) (b : Fin n → Fin n → Fin n → ℤ) : Set (FreeGroup (Fin n)) :=
  Set.range (fun l ↦ FreeGroup.of l ^ r l * (prodFrom FreeGroup.of (a l) (l + 1))⁻¹) ∪
    {w | ∃ l m : Fin n, m < l ∧ w = (FreeGroup.of m)⁻¹ * FreeGroup.of l * FreeGroup.of m *
      (prodFrom FreeGroup.of (b l m) (m + 1))⁻¹}

variable {r} {a : Fin n → Fin n → ℤ} {b : Fin n → Fin n → Fin n → ℤ}

variable (i) in
lemma mk_prodFrom : PresentedGroup.mk (relators r a b) (prodFrom FreeGroup.of e i) = prodFrom
    PresentedGroup.of e i :=
  map_prodFrom FreeGroup.of e i _

include hr in
lemma encard_presentedGroup_le : ENat.card (PresentedGroup (relators r a b)) ≤ (∏ l, r l : ℕ) := by
  have hpow' (l : Fin n) : PresentedGroup.of l ^ r l ∈ closureFrom (PresentedGroup.of (rels :=
      relators r a b)) (l + 1) := by
    have h : PresentedGroup.mk (relators r a b) (FreeGroup.of l ^ r l) = PresentedGroup.mk (relators
        r a b) (prodFrom FreeGroup.of (a l) (l + 1)) :=
      PresentedGroup.mk_eq_mk_of_mul_inv_mem (Or.inl ⟨l, rfl⟩)
    rw [map_pow, mk_prodFrom] at h
    exact h ▸ prodFrom_mem_closureFrom _ _ _
  have hconj' (l m : Fin n) (hml : m < l) : (PresentedGroup.of m)⁻¹ * PresentedGroup.of l *
      PresentedGroup.of m ∈ closureFrom (PresentedGroup.of (rels := relators r a b)) (m + 1) := by
    have h : PresentedGroup.mk (relators r a b) ((FreeGroup.of m)⁻¹ * FreeGroup.of l * FreeGroup.of
        m) = PresentedGroup.mk (relators r a b) (prodFrom FreeGroup.of (b l m) (m + 1)) :=
      PresentedGroup.mk_eq_mk_of_mul_inv_mem (Or.inr ⟨l, m, hml, rfl⟩)
    rw [map_mul, map_mul, map_inv, mk_prodFrom] at h
    exact h ▸ prodFrom_mem_closureFrom _ _ _
  rw [← ENat.card_congr topEquiv.toEquiv, ← PresentedGroup.closure_range_of, ← closureFrom_zero]
  refine (encard_closureFrom_le _ 0 r hr hpow' hconj').trans_eq ?_
  rw [← Finset.range_eq_Ico, ← Fin.prod_univ_eq_prod_range]
  simp

include hr in
/-- **A polycyclic presentation defines a finite group**: by descending induction,
`⟨x_k, …, x_{n-1}⟩` is the union of the cosets `x_k ^ t ⟨x_{k+1}, …, x_{n-1}⟩` for `0 ≤ t < r_k`,
since the relations make `x_k` normalise `⟨x_{k+1}, …, x_{n-1}⟩`. -/
lemma finite_presentedGroup : Finite (PresentedGroup (relators r a b)) :=
  ENat.card_lt_top.mp <| (encard_presentedGroup_le hr).trans_lt <| ENat.natCast_lt_top _

include hr in
/-- **A polycyclic presentation defines a group of order at most the product of the relative
orders.** -/
lemma card_presentedGroup_le : Nat.card (PresentedGroup (relators r a b)) ≤ ∏ l, r l := by
  have : Finite (PresentedGroup (relators r a b)) := finite_presentedGroup hr
  exact_mod_cast (ENat.card_eq_coe_natCard _).symm.trans_le (encard_presentedGroup_le hr)

end PolycyclicPresentation

open PolycyclicPresentation

variable (G) in
/-- A **polycyclic sequence** of `G` (LMFDB `group.presentation`), indexed from `0`: elements
`g_0, …, g_{n-1}` of `G` such that the subgroups `G_i = ⟨g_i, …, g_{n-1}⟩` form a subnormal series
`G = G_0 ⊵ G_1 ⊵ ⋯ ⊵ G_n = 1`. This is a polycyclic series (`Subgroup.SubnormalSeries.IsPolycyclic`,
`PolycyclicSequence.isPolycyclic_toSubnormalSeries`), its factors `G_i / G_{i+1}` being the cyclic
groups generated by the `g_i G_{i+1}`; conversely, a polycyclic sequence of a polycyclic series
`(G_i)` has `G_i = ⟨g_i, …, g_{n-1}⟩`. -/
structure PolycyclicSequence where
  /-- The length `n` of the sequence. -/
  length : ℕ
  /-- The terms `g_0, …, g_{n-1}` of the sequence. -/
  toFun : Fin length → G
  /-- The terms of a polycyclic sequence generate the group. -/
  closure_range : closure (Set.range toFun) = ⊤
  /-- Each `G_{i+1}` is normal in `G_i`. -/
  normal (i : Fin length) : ((closureFrom toFun (i + 1)).subgroupOf (closureFrom toFun i)).Normal

namespace PolycyclicSequence

instance : CoeFun (PolycyclicSequence G) fun s ↦ Fin s.length → G :=
  ⟨toFun⟩

variable (s : PolycyclicSequence G) {i j : ℕ} (k : Fin s.length)

variable (i) in
/-- The **polycyclic series** `G = G_0 ⊵ G_1 ⊵ ⋯ ⊵ G_n = 1` of a polycyclic sequence (LMFDB
`group.presentation`): `G_i = ⟨g_i, …, g_{n-1}⟩`, and `G_i = 1` for `i ≥ n`. -/
def series : Subgroup G :=
  closureFrom s i

instance : ((s.series (k + 1)).subgroupOf (s.series k)).Normal :=
  s.normal k

/-- The **relative orders** of a polycyclic sequence (LMFDB `group.presentation`): the orders
`r_i = [G_i : G_{i+1}]` of the cyclic factors of its polycyclic series. -/
noncomputable def relOrder : ℕ :=
  (s.series (k + 1)).relIndex (s.series k)

lemma series_zero : s.series 0 = ⊤ :=
  (closureFrom_zero s).trans s.closure_range

lemma series_of_le (h : s.length ≤ i) : s.series i = ⊥ :=
  closureFrom_of_le s h

lemma series_le (h : i ≤ j) : s.series j ≤ s.series i :=
  closureFrom_mono s h

lemma mem_series (h : i ≤ k) : s k ∈ s.series i :=
  mem_closureFrom s k h

lemma series_eq_sup : s.series k = zpowers (s k) ⊔ s.series (k + 1) :=
  closureFrom_eq_sup s k

lemma mem_normalizer : s k ∈ normalizer (s.series (k + 1) : Set G) :=
  (normal_subgroupOf_iff_le_normalizer (s.series_le (Nat.le_succ k))).mp (s.normal k) <|
    s.mem_series k le_rfl

/-- **The factors of the polycyclic series of a polycyclic sequence are cyclic**: `G_i / G_{i+1}` is
generated by `g_i G_{i+1}`. -/
lemma isCyclic_quotient : IsCyclic (s.series k ⧸ (s.series (k + 1)).subgroupOf (s.series k)) :=
  isCyclic_quotient_of_eq_sup (s.mem_normalizer k) (s.mem_series k le_rfl) (s.series_eq_sup k)

/-- The polycyclic series of a polycyclic sequence, as a subnormal series
`1 = G_n ⊴ G_{n-1} ⊴ ⋯ ⊴ G_0 = G` (LMFDB `group.normal_series`). -/
def toSubnormalSeries : SubnormalSeries G where
  length := s.length
  toFun l := s.series (s.length - l)
  step l := by
    refine ⟨s.series_le (by simp; omega), ?_⟩
    have h :
        ((s.series (s.length - (l + 1) + 1)).subgroupOf (s.series (s.length - (l + 1)))).Normal :=
      s.normal ⟨s.length - (l + 1), by omega⟩
    simp only [Fin.val_castSucc]
    rwa [show s.length - (l : ℕ) = s.length - (l + 1) + 1 by omega]
  head_eq_bot := s.series_of_le (by simp)
  last_eq_top := by simp [RelSeries.last, series_zero]

/-- **The polycyclic series of a polycyclic sequence is a polycyclic series.** -/
lemma isPolycyclic_toSubnormalSeries : s.toSubnormalSeries.IsPolycyclic := fun l ↦ by
  have hl : (l : ℕ) < s.length := l.2
  have hk : s.length - (l + 1) < s.length := by omega
  have h : s.length - (l + 1) + 1 = s.length - l := by omega
  have hN : s ⟨_, hk⟩ ∈ normalizer (s.series (s.length - l) : Set G) :=
    h ▸ s.mem_normalizer ⟨_, hk⟩
  have hK : s.series (s.length - (l + 1)) = zpowers (s ⟨_, hk⟩) ⊔ s.series (s.length - l) :=
    h ▸ s.series_eq_sup ⟨_, hk⟩
  have : ((s.series (s.length - l)).subgroupOf (s.series (s.length - (l + 1)))).Normal :=
    s.toSubnormalSeries.normal_subgroupOf l
  exact (isCyclic_quotient_of_eq_sup hN (s.mem_series ⟨_, hk⟩ le_rfl) hK :)

variable (i) in
lemma card_series : Nat.card (s.series i) = ∏ l ∈ Finset.Ico i s.length, if h : l < s.length then
    s.relOrder ⟨l, h⟩ else 1 := by
  induction h : s.length - i generalizing i with
  | zero =>
    rw [s.series_of_le (by omega), card_bot, Finset.Ico_eq_empty_of_le (by omega),
      Finset.prod_empty]
  | succ m ih =>
    have hi : i < s.length := by omega
    have hcard : (s.series (i + 1)).relIndex (s.series i) * Nat.card ↥(s.series (i + 1) ⊓ s.series
        i) = Nat.card (s.series i) :=
      relIndex_mul_card _ _
    rw [inf_of_le_left (s.series_le (Nat.le_succ i))] at hcard
    rw [Finset.prod_eq_prod_Ico_succ_bot hi, dite_eq_left hi, ← ih (i + 1) (by omega), ← hcard]
    rfl

/-- **The order of a group is the product of the relative orders of a polycyclic sequence.** -/
lemma card_eq_prod_relOrder : Nat.card G = ∏ l, s.relOrder l := by
  rw [← card_top, ← s.series_zero, card_series, ← Finset.range_eq_Ico,
    ← Fin.prod_univ_eq_prod_range]
  simp

lemma mem_series_iff {x : G} : x ∈ s.series i ↔ ∃ e : Fin s.length → ℤ, prodFrom s e i = x := by
  refine ⟨fun hx ↦ ?_, fun ⟨e, he⟩ ↦ he ▸ prodFrom_mem_closureFrom s e i⟩
  induction h : s.length - i generalizing i x with
  | zero =>
    rw [s.series_of_le (by omega), mem_bot] at hx
    exact ⟨0, hx ▸ prodFrom_of_le s 0 (by omega)⟩
  | succ m ih =>
    have hi : i < s.length := by omega
    have hx' : x ∈ zpowers (s ⟨i, hi⟩) ⊔ s.series (i + 1) := s.series_eq_sup ⟨i, hi⟩ ▸ hx
    rcases exists_zpow_mul_eq_of_mem_sup (s.mem_normalizer ⟨i, hi⟩) hx' with ⟨t, y, hy, rfl⟩
    have hy' : y ∈ s.series (i + 1) := hy
    rcases ih hy' (by omega) with ⟨e, rfl⟩
    refine ⟨Function.update e ⟨i, hi⟩ t, ?_⟩
    rw [prodFrom_of_lt s _ hi, Function.update_self]
    refine congrArg _ (prodFrom_congr s _ fun l hl ↦ Function.update_of_ne (fun hli ↦ ?_) _ _)
    subst hli
    simp at hl

/-- **A polycyclic sequence satisfies the relations of a polycyclic presentation** (LMFDB
`group.presentation`) with its relative orders: `g_i ^ r_i = ∏_{k > i} g_k ^ a_{i,k}` and
`g_j⁻¹ g_i g_j = ∏_{k > j} g_k ^ b_{i,j,k}` for `j < i`, for some exponents `a` and `b`. -/
lemma exists_relations : ∃ (a : Fin s.length → Fin s.length → ℤ) (b : Fin s.length → Fin s.length →
    Fin s.length → ℤ), (∀ l, s l ^ s.relOrder l = prodFrom s (a l) (l + 1)) ∧ ∀ l m, m < l → (s
    m)⁻¹ * s l * s m = prodFrom s (b l m) (m + 1) := by
  have hpow (l : Fin s.length) : ∃ e, prodFrom s e (l + 1) = s l ^ s.relOrder l := by
    refine s.mem_series_iff.mp ?_
    have h : (⟨s l, s.mem_series l le_rfl⟩ : s.series l) ^ s.relOrder l ∈ (s.series (l +
        1)).subgroupOf (s.series l) :=
      pow_index_mem _ _
    rwa [mem_subgroupOf, SubgroupClass.coe_pow] at h
  have hconj (l m : Fin s.length) : ∃ e, m < l → prodFrom s e (m + 1) = (s m)⁻¹ * s l * s m := by
    by_cases hml : m < l
    · rcases s.mem_series_iff.mp ((mem_normalizer_iff''.mp (s.mem_normalizer m) (s l)).mp
        (s.mem_series l hml)) with ⟨e, he⟩
      exact ⟨e, fun _ ↦ he⟩
    · exact ⟨0, fun h ↦ absurd h hml⟩
  choose a ha using hpow
  choose b hb using hconj
  exact ⟨a, b, fun l ↦ (ha l).symm, fun l m hml ↦ (hb l m hml).symm⟩

variable {s} {a : Fin s.length → Fin s.length → ℤ}
  {b : Fin s.length → Fin s.length → Fin s.length → ℤ}
  (ha : ∀ l, s l ^ s.relOrder l = prodFrom s (a l) (l + 1))
  (hb : ∀ l m, m < l → (s m)⁻¹ * s l * s m = prodFrom s (b l m) (m + 1))

include ha hb in
lemma lift_eq_one : ∀ w ∈ relators s.relOrder a b, FreeGroup.lift s w = 1 := by
  rintro _ (⟨l, rfl⟩ | ⟨l, m, hml, rfl⟩)
  · rw [map_mul, map_pow, map_inv, lift_prodFrom, FreeGroup.lift_apply_of, ha, mul_inv_cancel]
  · rw [map_mul, map_mul, map_mul, map_inv, map_inv, lift_prodFrom, FreeGroup.lift_apply_of,
      FreeGroup.lift_apply_of, hb l m hml, mul_inv_cancel]

include ha hb in
/-- **The polycyclic presentation of a polycyclic sequence of a finite group presents the group**:
the homomorphism from the group defined by the polycyclic presentation to `G`, sending the
generators to the terms of the sequence, is bijective. It is onto since the sequence generates `G`,
and the presented group has at most `∏ r_i = |G|` elements. -/
lemma bijective_toGroup [Finite G] :
    Function.Bijective (PresentedGroup.toGroup (lift_eq_one ha hb)) := by
  have hr (l : Fin s.length) : s.relOrder l ≠ 0 :=
    (isFiniteRelIndex_of_finiteIndex (H := s.series (l + 1)) (K := s.series l)).relIndex_ne_zero
  have : Finite (PresentedGroup (relators s.relOrder a b)) := finite_presentedGroup hr
  have hsurj : Function.Surjective (PresentedGroup.toGroup (lift_eq_one ha hb)) := by
    rw [← MonoidHom.range_eq_top, eq_top_iff, ← s.closure_range, closure_le]
    rintro _ ⟨l, rfl⟩
    exact ⟨PresentedGroup.of l, by simp⟩
  exact hsurj.bijective_of_nat_card_le <|
    (card_presentedGroup_le hr).trans s.card_eq_prod_relOrder.ge

/-- The isomorphism between the group defined by the polycyclic presentation of a polycyclic
sequence of a finite group and the group (LMFDB `group.presentation`). -/
noncomputable def presentationEquiv [Finite G] : PresentedGroup (relators s.relOrder a b) ≃* G :=
  MulEquiv.ofBijective _ (bijective_toGroup ha hb)

variable {N : Subgroup G} (t : PolycyclicSequence N) (g₀ : G)

/-- The sequence `(g₀, t_0, …, t_{m-1})` of `G` obtained from a sequence `t` of a subgroup `N` and
an element `g₀`. -/
def consSeq : Fin (t.length + 1) → G :=
  Fin.cons g₀ fun l ↦ (t l : G)

lemma closureFrom_consSeq_succ :
    closureFrom (t.consSeq g₀) (i + 1) = (closureFrom t i).map N.subtype := by
  rw [closureFrom, closureFrom, MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨l, hl, rfl⟩
    rcases Fin.eq_zero_or_eq_succ l with rfl | ⟨l, rfl⟩
    · simp at hl
    · exact ⟨t l, ⟨l, by simpa using hl, rfl⟩, by simp [consSeq]⟩
  · rintro ⟨_, ⟨l, hl, rfl⟩, rfl⟩
    exact ⟨l.succ, by simpa using hl, by simp [consSeq]⟩

lemma closureFrom_consSeq_one : closureFrom (t.consSeq g₀) 1 = N := by
  rw [t.closureFrom_consSeq_succ g₀ (i := 0), closureFrom_zero, t.closure_range,
    ← MonoidHom.range_eq_map, range_subtype]

lemma closureFrom_consSeq_zero (h : zpowers g₀ ⊔ N = ⊤) : closureFrom (t.consSeq g₀) 0 = ⊤ := by
  have h₀ : closureFrom (t.consSeq g₀) 0 = zpowers g₀ ⊔ closureFrom (t.consSeq g₀) 1 :=
    closureFrom_eq_sup _ 0
  rw [h₀, closureFrom_consSeq_one, h]

/-- The polycyclic sequence `(g₀, t_0, …, t_{m-1})` of `G` obtained from a polycyclic sequence `t`
of a normal subgroup `N` and an element `g₀` with `⟨g₀⟩ N = G`. -/
def cons [N.Normal] (h : zpowers g₀ ⊔ N = ⊤) : PolycyclicSequence G where
  length := t.length + 1
  toFun := t.consSeq g₀
  closure_range := by
    rw [← closureFrom_zero, t.closureFrom_consSeq_zero g₀ h]
  normal l := by
    induction l using Fin.cases with
    | zero =>
      rw [Fin.val_zero, zero_add, closureFrom_consSeq_one, t.closureFrom_consSeq_zero g₀ h]
      infer_instance
    | succ l =>
      rw [Fin.val_succ, closureFrom_consSeq_succ, closureFrom_consSeq_succ]
      exact normal_subgroupOf_map N.subtype (closureFrom_mono t (Nat.le_succ l)) (t.normal l)

/-- **Every finite solvable group has a polycyclic sequence**, hence a polycyclic presentation
(LMFDB `group.presentation`): a nontrivial finite solvable group has a normal subgroup `N` of prime
index, and a polycyclic sequence of `N` extends to one of `G` by any element outside `N`. -/
lemma nonempty_of_isSolvable [Finite G] [Group.IsSolvable G] : Nonempty (PolycyclicSequence G) := by
  induction h : Nat.card G using Nat.strong_induction_on generalizing G with
  | _ m ih =>
    rcases subsingleton_or_nontrivial G with hG | hG
    · exact ⟨⟨0, Fin.elim0, Subsingleton.elim _ _, nofun⟩⟩
    · rcases IsSolvable.exists_normal_index_prime G with ⟨N, hN, hp⟩
      have hcard : Nat.card N < m := by
        rw [← h, ← card_mul_index N]
        exact lt_mul_of_one_lt_right Nat.card_pos hp.one_lt
      rcases ih _ hcard rfl with ⟨t⟩
      rcases IsConcreteLE.exists_of_lt (lt_top_iff_ne_top.mpr fun hN' ↦ hp.one_lt.ne'
        (index_eq_one.mpr hN')) with ⟨g₀, -, hg₀⟩
      have hrel : N.relIndex (zpowers g₀ ⊔ N) * (zpowers g₀ ⊔ N).index = N.index :=
        relIndex_mul_index le_sup_right
      have hsup : zpowers g₀ ⊔ N = ⊤ := by
        rcases hp.eq_one_or_self_of_dvd _ (Dvd.intro _ hrel) with h₁ | h₁
        · exact absurd (relIndex_eq_one.mp h₁ (mem_sup_left (mem_zpowers g₀))) hg₀
        · rw [h₁, mul_eq_left₀ hp.ne_zero] at hrel
          exact index_eq_one.mp hrel
      exact ⟨t.cons g₀ hsup⟩

end PolycyclicSequence
