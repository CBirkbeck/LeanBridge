import TauCeti.FieldTheory.GaloisGroups.Blocks
import TauCeti.FieldTheory.IntermediateField.Lift
import TauCeti.FieldTheory.IntermediateField.Map

/-!
# Primitivity of the Galois action on the roots, in every degree

Let `f` be an irreducible separable polynomial over a field `K`, let `G` be its Galois group,
acting on the roots of `f` in its splitting field, and let `F = K(α)` be a field obtained by
adjoining a root `α` of `f` to `K`. The action of `G` is primitive exactly when `F / K` has no
proper intermediate fields (LMFDB `gg.group_action_invariants`), that is when every intermediate
field of `F / K` is `K` or `F`.

Tau Ceti proves this for `deg f > 1` and a root `α` in the splitting field, in the form that `F` is
an atom of the lattice of intermediate fields of the splitting field
(`TauCeti.isPreprimitive_iff_isAtom_adjoin_simple`). Through Tau Ceti's identification of the
intermediate fields of `F / K` with those of the splitting field below `F`
(`IntermediateField.liftOrderIso`), this says that the intermediate fields of `F / K` form a simple
order. In degree `1` both sides hold: the action on a single root is primitive, and `F = K`. The
statement then holds for a root `α` in any extension of `K`, since `K(α)` is isomorphic over `K` to
the field generated by a root in the splitting field, both roots having the minimal polynomial
`f / lc(f)`.

## Main results

* `Polynomial.Gal.isPreprimitive_iff_forall_eq_bot_or_eq_top` (LMFDB
  `gg.group_action_invariants`): the Galois group of an irreducible separable polynomial acts
  primitively on its roots exactly when the field generated by a root has no proper intermediate
  fields.

## References

* H. Wielandt, *Finite Permutation Groups*, Theorem 7.5.
* J. D. Dixon and B. Mortimer, *Permutation Groups*, Section 1.5.
-/

open IntermediateField Module MulAction

namespace Polynomial.Gal

variable {K : Type*} [Field K] {f : K[X]}

private lemma forall_eq_bot_or_eq_top_congr {A B : Type*} [PartialOrder A] [BoundedOrder A]
    [PartialOrder B] [BoundedOrder B] (e : A ≃o B) :
    (∀ a : A, a = ⊥ ∨ a = ⊤) ↔ ∀ b : B, b = ⊥ ∨ b = ⊤ := by
  rw [e.surjective.forall]
  simp

private lemma isPreprimitive_iff_of_mem_rootSet (hf : Irreducible f) (hsep : f.Separable)
    (x : f.rootSet f.SplittingField) : IsPreprimitive f.Gal (f.rootSet f.SplittingField) ↔
      ∀ L : IntermediateField K K⟮(x : f.SplittingField)⟯, L = ⊥ ∨ L = ⊤ := by
  have hx : finrank K K⟮(x : f.SplittingField)⟯ = f.natDegree := by
    rw [adjoin.finrank (.of_finite K _), ← minpoly.eq_of_irreducible hf (mem_rootSet.mp x.2).2,
      natDegree_mul_C (inv_ne_zero (leadingCoeff_ne_zero.mpr hf.ne_zero))]
  rcases lt_or_ge 1 f.natDegree with h | h
  · have : Nontrivial (IntermediateField K K⟮(x : f.SplittingField)⟯) :=
      nontrivial_of_ne ⊥ ⊤ fun hbot ↦ h.ne' <| hx ▸ bot_eq_top_iff_finrank_eq_one.mp hbot
    rw [TauCeti.isPreprimitive_iff_isAtom_adjoin_simple hf hsep h x,
      ← Set.isSimpleOrder_Iic_iff_isAtom,
      ← (liftOrderIso K⟮(x : f.SplittingField)⟯).isSimpleOrder_iff]
    exact ⟨fun hs ↦ hs.eq_bot_or_eq_top, fun hs ↦ ⟨hs⟩⟩
  · have : Subsingleton (f.rootSet f.SplittingField) := by
      rwa [← Fintype.card_le_one_iff_subsingleton,
        card_rootSet_eq_natDegree hsep (SplittingField.splits f)]
    have hbot : (⊥ : IntermediateField K K⟮(x : f.SplittingField)⟯) = ⊤ :=
      bot_eq_top_iff_finrank_eq_one.mpr <| hx.trans <| h.antisymm hf.natDegree_pos
    exact iff_of_true .of_subsingleton fun L ↦ .inl <| (subsingleton_of_bot_eq_top hbot).elim L ⊥

/-- **The Galois group of an irreducible separable polynomial `f` acts primitively on its roots
exactly when the field `K(α)` generated by a root `α` has no proper intermediate fields** (LMFDB
`gg.group_action_invariants`), that is when every intermediate field of `K(α) / K` is `K` or
`K(α)`. Here `α` is a root of `f` in any extension of `K`, and the statement holds in every degree:
in degree `1` the action on the single root is primitive and `K(α) = K`. -/
lemma isPreprimitive_iff_forall_eq_bot_or_eq_top {E : Type*} [Field E] [Algebra K E] {α : E}
    (hf : Irreducible f) (hsep : f.Separable) (hα : aeval α f = 0) :
    IsPreprimitive f.Gal (f.rootSet f.SplittingField) ↔
      ∀ L : IntermediateField K K⟮α⟯, L = ⊥ ∨ L = ⊤ := by
  rcases Fintype.card_pos_iff.mp <|
    (card_rootSet_eq_natDegree hsep (SplittingField.splits f)).symm ▸ hf.natDegree_pos with ⟨x⟩
  have hαx : minpoly K α = minpoly K (x : f.SplittingField) :=
    (minpoly.eq_of_irreducible hf hα).symm.trans <|
      minpoly.eq_of_irreducible hf (mem_rootSet.mp x.2).2
  rw [isPreprimitive_iff_of_mem_rootSet hf hsep x]
  refine (forall_eq_bot_or_eq_top_congr <| orderIsoMapComap <|
    (adjoin.powerBasis (IsAlgebraic.isIntegral ⟨f, hf.ne_zero, hα⟩)).equivOfMinpoly
      (adjoin.powerBasis (.of_finite K (x : f.SplittingField))) ?_).symm
  rw [adjoin.powerBasis_gen, adjoin.powerBasis_gen, minpoly_gen, minpoly_gen, hαx]

end Polynomial.Gal
