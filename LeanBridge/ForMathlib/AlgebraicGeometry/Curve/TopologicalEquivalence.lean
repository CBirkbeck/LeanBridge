import Mathlib.AlgebraicTopology.SingularHomology.Basic
import Mathlib.Algebra.Category.ModuleCat.Colimits
import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
import Mathlib.Topology.Category.TopCat.Basic

/-!
# Topological equivalence of group actions on a compact Riemann surface

Two actions `φ₁, φ₂ : G ↪ Aut(X)` of a group `G` on a compact Riemann surface `X` are topologically
equivalent if `φ₂(g) = h φ₁(ω(g)) h⁻¹` for all `g ∈ G`, for an automorphism `ω` of `G` and an
orientation preserving homeomorphism `h : X → X`.

A homeomorphism of a compact connected oriented surface preserves the orientation exactly when it
acts as the identity on `H₂(X; ℤ) ≅ ℤ`, which it does by `±1`: we take this as the definition, with
Mathlib's singular homology. The automorphisms of `X` are homeomorphisms, and the definition only
uses this: the actions are homomorphisms `G → Homeo(X)` from a group to the homeomorphisms of a
topological space; for a group of automorphisms of a Riemann surface they are injective and land
in the biholomorphisms. The equivalent description by surjections `Γ → G` from a Fuchsian group is
not formalised.

## Main definitions

* `Homeomorph.IsOrientationPreserving`: homeomorphisms acting trivially on `H₂(X; ℤ)`.
* `Homeomorph.TopologicallyEquivalent` (LMFDB `curve.highergenus.aut.topological_equivalence`):
  topological equivalence of two actions.

## Main results

* `Homeomorph.topologicallyEquivalent_refl`: an action is topologically equivalent to itself.
-/

open AlgebraicTopology CategoryTheory

namespace Homeomorph

variable {X : Type} [TopologicalSpace X] {G : Type*} [Group G]

/-- A homeomorphism `h : X → X` is **orientation preserving** if it acts as the identity on the
second singular homology group `H₂(X; ℤ)`. For a compact connected oriented surface, where
`H₂(X; ℤ) ≅ ℤ` is generated by the fundamental class, this is the usual notion. -/
def IsOrientationPreserving (h : X ≃ₜ X) : Prop :=
  ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).map
    (TopCat.ofHom (h : C(X, X)) : TopCat.of X ⟶ TopCat.of X) = 𝟙 _

lemma isOrientationPreserving_refl : (Homeomorph.refl X).IsOrientationPreserving :=
  ((singularHomologyFunctor (ModuleCat.{0} ℤ) 2).obj (ModuleCat.of ℤ ℤ)).map_id (TopCat.of X)

/-- Two actions `φ₁, φ₂ : G → Homeo(X)` of a group `G` on a space `X`, such as two embeddings of
`G` in the automorphism group of a compact Riemann surface, are **topologically equivalent** (LMFDB
`curve.highergenus.aut.topological_equivalence`) if `φ₂(g) = h φ₁(ω(g)) h⁻¹` for all `g ∈ G`, for
an automorphism `ω` of `G` and an orientation preserving homeomorphism `h : X → X`. -/
def TopologicallyEquivalent (φ₁ φ₂ : G →* (X ≃ₜ X)) : Prop :=
  ∃ (ω : MulAut G) (h : X ≃ₜ X), h.IsOrientationPreserving ∧
    ∀ g, φ₂ g = (h.symm.trans (φ₁ (ω g))).trans h

/-- **An action is topologically equivalent to itself.** -/
lemma topologicallyEquivalent_refl (φ : G →* (X ≃ₜ X)) : TopologicallyEquivalent φ φ :=
  ⟨1, .refl X, isOrientationPreserving_refl, fun _ ↦ rfl⟩

end Homeomorph
