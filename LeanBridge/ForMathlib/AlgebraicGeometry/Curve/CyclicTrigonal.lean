import LeanBridge.ForMathlib.AlgebraicGeometry.Curve.Basic
import Mathlib.FieldTheory.Galois.Basic

/-!
# Cyclic trigonal curves

An algebraic curve `X` over a field `k` is cyclic trigonal (LMFDB `ag.cyclic_trigonal`) if some
subgroup `H` of order three of its automorphism group has quotient curve `X / H` isomorphic to
`ℙ¹`; a generator of such an `H` is a trigonal automorphism. The knowl's definition is
`AlgebraicGeometry.Scheme.IsCyclicTrigonalCurve`, in
`LeanBridge.ForMathlib.AlgebraicGeometry.Curve.CyclicTrigonalQuotient`.

This file is a function-field model of it: automorphisms of `X` are replaced by `k`-automorphisms
of the function field `k(X)`, and the condition on `X / H` by the condition that the fixed field
`k(X)ᴴ` be a rational function field `k(t)` with `t` transcendental over `k`. The model can differ
from the knowl when `X` is not regular and proper: it holds for the affine line `𝔸¹` over a field
with a primitive cube root of unity `ζ`, with `H` generated by `x ↦ ζx` and fixed field `k(x³)`,
while `𝔸¹ / H ≅ 𝔸¹` is not `ℙ¹`.

## Main definitions

* `TauCeti.IsCyclicTrigonalFunctionField`: a field extension with a subgroup of order three of its
  automorphism group whose fixed field is a rational function field.
* `TauCeti.IsTrigonalAutomorphism`: a generator of such a subgroup.
* `AlgebraicGeometry.Scheme.IsCyclicTrigonalCurveOver`: an algebraic curve with cyclic trigonal
  function field.

## Main results

* `TauCeti.isCyclicTrigonalFunctionField_iff_exists_isTrigonalAutomorphism`: a function field is
  cyclic trigonal if and only if it has a trigonal automorphism.
-/

open scoped IntermediateField

namespace TauCeti

variable (k : Type*) {F : Type*} [Field k] [Field F] [Algebra k F]

variable (F) in
/-- A field extension `F / k`, such as the function field `k(X)` of a curve `X` over `k`, is
**cyclic trigonal** if some subgroup `H` of order three of its automorphism group has a rational
function field `k(t)`, with `t` transcendental over `k`, as fixed field: a function-field model of
LMFDB `ag.cyclic_trigonal`, whose definition is `AlgebraicGeometry.Scheme.IsCyclicTrigonalCurve`. -/
def IsCyclicTrigonalFunctionField : Prop :=
  ∃ H : Subgroup (F ≃ₐ[k] F), Nat.card H = 3 ∧
    ∃ t : F, Transcendental k t ∧ IntermediateField.fixedField H = k⟮t⟯

/-- A **trigonal automorphism** of a field extension `F / k`, such as the function field of a curve
over `k`, in the function-field model of LMFDB `ag.cyclic_trigonal`: an automorphism `σ` of order
three that generates a subgroup `H` exhibiting `F` as cyclic trigonal, whose fixed field is a
rational function field `k(t)`. For curves, the knowl's notion is
`AlgebraicGeometry.Scheme.IsTrigonalAutomorphism`. -/
def IsTrigonalAutomorphism (σ : F ≃ₐ[k] F) : Prop :=
  orderOf σ = 3 ∧ ∃ t : F, Transcendental k t ∧ IntermediateField.fixedField (.zpowers σ) = k⟮t⟯

/-- **A field extension is cyclic trigonal if and only if it has a trigonal automorphism.** -/
lemma isCyclicTrigonalFunctionField_iff_exists_isTrigonalAutomorphism :
    IsCyclicTrigonalFunctionField k F ↔ ∃ σ : F ≃ₐ[k] F, IsTrigonalAutomorphism k σ := by
  refine ⟨fun ⟨H, hH, ht⟩ ↦ ?_, fun ⟨σ, hσ, ht⟩ ↦ ⟨_, Nat.card_zpowers σ ▸ hσ, ht⟩⟩
  have : Fact (Nat.Prime (Nat.card H)) := ⟨hH ▸ Nat.prime_three⟩
  rcases (isCyclic_of_prime_card rfl).exists_generator (α := H) with ⟨σ, hσ⟩
  have ho : orderOf (σ : F ≃ₐ[k] F) = 3 :=
    (Subgroup.orderOf_coe σ).trans <| (orderOf_eq_card_of_forall_mem_zpowers hσ).trans hH
  have : Finite H := Nat.finite_of_card_ne_zero <| by omega
  have he : Subgroup.zpowers (σ : F ≃ₐ[k] F) = H :=
    Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr σ.2) <| by
      rw [hH, Nat.card_zpowers, ho]
  exact ⟨σ, ho, by rwa [he]⟩

end TauCeti

namespace AlgebraicGeometry.Scheme

universe u

variable (K : Type u) [Field K] (X : Scheme.{u}) [X.Over (Spec (.of K))]

/-- An algebraic curve `X` over `K` whose function field `K(X)` is cyclic trigonal
(`TauCeti.IsCyclicTrigonalFunctionField`): a function-field model of a **cyclic trigonal curve**
(LMFDB `ag.cyclic_trigonal`), with automorphisms of `K(X)` in place of those of `X` and the fixed
field `K(X)ᴴ` in place of the quotient curve `X / H`. It can differ from the knowl's definition,
`AlgebraicGeometry.Scheme.IsCyclicTrigonalCurve`, when `X` is not regular and proper: it holds for
the affine line with `x ↦ ζx`, `ζ` a primitive cube root of unity. -/
class IsCyclicTrigonalCurveOver : Prop extends X.IsAlgebraicCurveOver K where
  /-- The function field is cyclic trigonal. -/
  isCyclicTrigonalFunctionField :
    haveI : IsIntegral X := IsVarietyOver.isIntegral K
    TauCeti.IsCyclicTrigonalFunctionField K X.functionField

end AlgebraicGeometry.Scheme
