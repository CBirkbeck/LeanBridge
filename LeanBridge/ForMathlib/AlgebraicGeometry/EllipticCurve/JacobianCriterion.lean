import Mathlib.RingTheory.Kaehler.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
import Mathlib.RingTheory.Spectrum.Prime.FreeLocus
import TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Eval
import TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Formula.Derivation
import TauCeti.AlgebraicGeometry.EllipticCurve.Affine.Singular
import TauCeti.RingTheory.Derivation.DualNumber

/-!
# The discriminant of a Weierstrass equation and smoothness

The discriminant `Δ` of a Weierstrass equation `y² + a₁xy + a₃y = x³ + a₂x² + a₄x + a₆` over a field
`F` (LMFDB `ec.discriminant`) is Mathlib's `WeierstrassCurve.Δ`, which is
`-b₂²b₈ - 8b₄³ - 27b₆² + 9b₂b₄b₆` in Mathlib's `b₂, b₄, b₆, b₈`. The knowl states that `Δ ≠ 0`
exactly when the equation defines a smooth curve: in the sense of LMFDB `ag.curve.smooth` and
`ag.singular_point`, that its extension to an algebraic closure `F̄` is non-singular at all of its
points, a point being non-singular when the module of differentials is locally free there. This
file proves it (`WeierstrassCurve.Δ_ne_zero_iff_freeLocus_baseChange_eq_univ`): for the coordinate
ring `R = F̄[x, y] / (W(x, y))` of the affine curve over `F̄`, `Δ ≠ 0` exactly when the free locus
of `Ω[R⁄F̄]` (Mathlib's `Module.freeLocus`, the primes of `R` at which `Ω[R⁄F̄]` localises to a free
module) is the whole spectrum of `R`. The points of a variety in LMFDB `ag.variety` are those of
`F̄²` on the curve, so the file also proves it point by point
(`WeierstrassCurve.Δ_ne_zero_iff_forall_equation_mem_freeLocus_baseChange`): `Δ ≠ 0` exactly when
`Ω[R⁄F̄]` is locally free at the kernel of evaluation at every solution `(x, y) ∈ F̄²`.

The heart is the Jacobian criterion for the Weierstrass cubic over any field `L`
(`WeierstrassCurve.Affine.mem_freeLocus_iff`): `Ω[R⁄L]` is free at a prime `P` of the coordinate
ring `R` exactly when the partial derivatives `W_X` and `W_Y` do not both lie in `P`. Both
directions use derivations of `R`, built from first-order points: a point `(a, b)` of the curve
over an `R`-algebra `S` and a tangent vector `(u, v)` with `W_X(a, b) u + W_Y(a, b) v = 0` give the
point `(a + εu, b + εv)` over the dual numbers `S[ε]`, hence an algebra homomorphism `R → S[ε]`
(Tau Ceti's `WeierstrassCurve.Affine.CoordinateRing.evalAlgHom`), whose `ε`-component is a
derivation (`WeierstrassCurve.Affine.derivationOfValues`, through Tau Ceti's
`TauCeti.derivationToDualNumberEquivLift`).

* If `W_Y ∉ P`, the localisation of `Ω[R⁄L]` at `P` is generated by `dx`, because
  `W_X dx + W_Y dy = 0` (Tau Ceti's differential of the Weierstrass equation), and the Hamiltonian
  derivation `x ↦ W_Y`, `y ↦ -W_X` sends `dx` to a unit, so the localisation is free of rank one.
  Likewise if `W_X ∉ P`.
* If `W_X, W_Y ∈ P`, the two derivations `R → κ(P)` with values `(1, 0)` and `(0, 1)` on `(x, y)`
  show that the fibre of `Ω[R⁄L]` at `P` has dimension at least two. A free localisation would
  have that rank, but it is generated by `dx` and `dy` subject to the nontrivial relation
  `W_X dx + W_Y dy = 0`, since `W_X` and `W_Y` do not both vanish on the curve, so its rank is at
  most one.

When `Δ ≠ 0` no point over any field is singular (Tau Ceti's
`WeierstrassCurve.Affine.IsSingular.Δ_eq_zero`); when `Δ = 0` over a perfect field there is a
rational singular point (Tau Ceti's `WeierstrassCurve.Affine.exists_isSingular_of_Δ_eq_zero`), whose
maximal ideal is not in the free locus. The knowl's closing clause, that the projective closure is
then an elliptic curve, is Mathlib's `WeierstrassCurve.IsElliptic` (`Δ` a unit) in the Weierstrass
model of elliptic curves; Tau Ceti's `WeierstrassCurve.toEllipticCurveGeom` makes that projective
closure an elliptic curve over `Spec F` in the sense of schemes.

## Main definitions

* `WeierstrassCurve.Affine.derivationOfValues`: the derivation of the coordinate ring with values
  `u` and `v` on `x` and `y`, for `W_X u + W_Y v = 0`.
* `WeierstrassCurve.Affine.hamiltonianDerivation`: the derivation `x ↦ W_Y`, `y ↦ -W_X`.

## Main results

* `WeierstrassCurve.Affine.mem_freeLocus_iff`: the Jacobian criterion for the Weierstrass cubic.
* `WeierstrassCurve.Affine.Δ_ne_zero_iff_freeLocus_eq_univ`: over a perfect field, `Δ ≠ 0` exactly
  when the module of differentials is locally free at every point of the spectrum of the
  coordinate ring.
* `WeierstrassCurve.Affine.Δ_ne_zero_iff_forall_equation_mem_freeLocus`: over a perfect field,
  `Δ ≠ 0` exactly when the module of differentials is locally free at every rational point.
* `WeierstrassCurve.Δ_ne_zero_iff_freeLocus_baseChange_eq_univ` (LMFDB `ec.discriminant`):
  `Δ ≠ 0` exactly when the curve is smooth, non-singular at every point over an algebraically
  closed extension.
* `WeierstrassCurve.Δ_ne_zero_iff_forall_equation_mem_freeLocus_baseChange` (LMFDB
  `ec.discriminant`): the same with the points `(x, y) ∈ K²` of the curve over an algebraically
  closed extension `K`, the points of LMFDB `ag.variety`.
-/

open Polynomial TrivSqZeroExt KaehlerDifferential AdjoinRoot IsLocalization WeierstrassCurve Affine

open scoped TensorProduct

namespace Module

variable {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M] {c₁ c₂ : A} {u w : M}

lemma free_of_span_singleton_eq_top {ω : M} (hω : Submodule.span A {ω} = ⊤) (ℓ : M →ₗ[A] A)
    (hℓ : IsUnit (ℓ ω)) : Free A M := by
  have hinj : Function.Injective ℓ := by
    refine (injective_iff_map_eq_zero ℓ).mpr fun m hm ↦ ?_
    rcases Submodule.mem_span_singleton.mp (hω ▸ Submodule.mem_top : m ∈ Submodule.span A {ω})
      with ⟨a, rfl⟩
    rw [map_smul, smul_eq_mul, hℓ.mul_left_eq_zero] at hm
    rw [hm, zero_smul]
  have hsurj : Function.Surjective ℓ := fun a ↦
    ⟨(a * ↑hℓ.unit⁻¹) • ω, by rw [map_smul, smul_eq_mul, mul_assoc, hℓ.val_inv_mul, mul_one]⟩
  exact Free.of_equiv (LinearEquiv.ofBijective ℓ ⟨hinj, hsurj⟩).symm

lemma eq_neg_inv_mul_smul_of_smul_add_smul_eq_zero (hc₂ : IsUnit c₂) (h : c₁ • u + c₂ • w = 0) :
    w = (-(↑hc₂.unit⁻¹ * c₁)) • u := by
  rw [← one_smul A w, ← hc₂.val_inv_mul, mul_smul, eq_neg_of_add_eq_zero_right h, smul_neg,
    neg_smul, mul_smul]

lemma two_le_finrank_of_surjective_liftBaseChange [Nontrivial A] {K : Type*} [Field K]
    [Algebra A K] [Free A M] [Module.Finite A M] {Φ : M →ₗ[A] K × K}
    (hΦ : Function.Surjective (Φ.liftBaseChange K)) : 2 ≤ finrank A M := by
  have h : finrank K (LinearMap.range (Φ.liftBaseChange K)) ≤ finrank K (K ⊗[A] M) :=
    LinearMap.finrank_range_le _
  rwa [LinearMap.range_eq_top.mpr hΦ, finrank_top, finrank_baseChange, finrank_prod,
    finrank_self] at h

lemma finrank_le_one_of_smul_add_smul_eq_zero [IsDomain A] [Free A M]
    (hspan : Submodule.span A {u, w} = ⊤) (hc : c₁ • u + c₂ • w = 0) (hc₂ : c₂ ≠ 0) :
    finrank A M ≤ 1 := by
  have hw : c₂ • w = -(c₁ • u) := eq_neg_of_add_eq_zero_right hc
  have hmem (z : M) : c₂ • z ∈ Submodule.span A {u} := by
    rcases Submodule.mem_span_pair.mp (hspan ▸ Submodule.mem_top : z ∈ Submodule.span A {u, w})
      with ⟨a, b, rfl⟩
    exact Submodule.mem_span_singleton.mpr ⟨a * c₂ - b * c₁, by
      linear_combination (norm := module) -b • hw⟩
  have hg : Function.Injective ((c₂ • LinearMap.id).codRestrict (Submodule.span A {u}) hmem) :=
    fun z z' h ↦ smul_right_injective M hc₂ (congrArg Subtype.val h)
  refine (LinearMap.finrank_le_finrank_of_injective hg).trans <|
    (finrank_span_le_card ({u} : Set M)).trans ?_
  simp

end Module

namespace WeierstrassCurve.Affine

variable {L : Type*} [Field L] (W : WeierstrassCurve.Affine L) {S : Type*} [CommRing S]
  [Algebra L S] (f : W.CoordinateRing →ₐ[L] S)

lemma equation_inl_add_inr {a b u v : S} (h : (W⁄S).toAffine.Equation a b)
    (h' : (W⁄S).toAffine.polynomialX.evalEval a b * u +
      (W⁄S).toAffine.polynomialY.evalEval a b * v = 0) :
    (W⁄(DualNumber S)).toAffine.Equation (inl a + inr u) (inl b + inr v) := by
  rw [equation_iff] at h ⊢
  rw [evalEval_polynomialX, evalEval_polynomialY] at h'
  simp only [WeierstrassCurve.baseChange, map_a₁, map_a₂, map_a₃, map_a₄, map_a₆] at h h' ⊢
  refine TrivSqZeroExt.ext ?_ ?_
  · simp [algebraMap_eq_inl']
    linear_combination h
  · simp [algebraMap_eq_inl']
    linear_combination h'

lemma algHom_mk_polynomialX : f (CoordinateRing.mk W W.polynomialX) =
    (W⁄S).toAffine.polynomialX.evalEval (f (AdjoinRoot.of W.polynomial X))
      (f (AdjoinRoot.root W.polynomial)) := by
  rw [CoordinateRing.algHom_mk_eq_evalEval, ← map_polynomialX]
  rfl

lemma algHom_mk_polynomialY : f (CoordinateRing.mk W W.polynomialY) =
    (W⁄S).toAffine.polynomialY.evalEval (f (AdjoinRoot.of W.polynomial X))
      (f (AdjoinRoot.root W.polynomial)) := by
  rw [CoordinateRing.algHom_mk_eq_evalEval, ← map_polynomialY]
  rfl

variable (S) [Algebra W.CoordinateRing S] [IsScalarTower L W.CoordinateRing S]

/-- The **derivation of the coordinate ring with prescribed values** `u` and `v` on the coordinate
functions `x` and `y`, with values in an algebra `S` over the coordinate ring `R`, for values
satisfying the differentiated Weierstrass equation `W_X(x, y) u + W_Y(x, y) v = 0` in `S`. It is
the `ε`-component of the point `(x + εu, y + εv)` of the curve over the dual numbers `S[ε]`, a
derivation by Tau Ceti's `TauCeti.derivationToDualNumberEquivLift`. Conversely the values of every
derivation satisfy this equation, which is the differential of the Weierstrass equation. -/
noncomputable def derivationOfValues (u v : S)
    (h : algebraMap W.CoordinateRing S (CoordinateRing.mk W W.polynomialX) * u +
      algebraMap W.CoordinateRing S (CoordinateRing.mk W W.polynomialY) * v = 0) :
    Derivation L W.CoordinateRing S :=
  letI φ : W.CoordinateRing →ₐ[L] DualNumber S := CoordinateRing.evalAlgHom
    (W.equation_inl_add_inr
      (CoordinateRing.equation_of_algHom (IsScalarTower.toAlgHom L W.CoordinateRing S))
      (by rwa [← algHom_mk_polynomialX, ← algHom_mk_polynomialY]))
  (TauCeti.derivationToDualNumberEquivLift L W.CoordinateRing S).symm
    ⟨φ, CoordinateRing.algHom_ext (by simp [φ]) (by simp [φ])⟩

variable {S} {u v : S}
  (huv : algebraMap W.CoordinateRing S (CoordinateRing.mk W W.polynomialX) * u +
    algebraMap W.CoordinateRing S (CoordinateRing.mk W W.polynomialY) * v = 0)

lemma derivationOfValues_X : W.derivationOfValues S u v huv (AdjoinRoot.of W.polynomial X) = u :=
  (TauCeti.derivationToDualNumberEquivLift_symm_apply _ _).trans <| by
    rw [CoordinateRing.evalAlgHom_of_X, snd_add, snd_inl, snd_inr, zero_add]

lemma derivationOfValues_root :
    W.derivationOfValues S u v huv (AdjoinRoot.root W.polynomial) = v :=
  (TauCeti.derivationToDualNumberEquivLift_symm_apply _ _).trans <| by
    rw [CoordinateRing.evalAlgHom_root, snd_add, snd_inl, snd_inr, zero_add]

/-- The **Hamiltonian derivation** of the coordinate ring of a Weierstrass curve: `x ↦ W_Y(x, y)`
and `y ↦ -W_X(x, y)`, which kills the Weierstrass equation. -/
noncomputable def hamiltonianDerivation : Derivation L W.CoordinateRing W.CoordinateRing :=
  W.derivationOfValues W.CoordinateRing (CoordinateRing.mk W W.polynomialY)
    (-CoordinateRing.mk W W.polynomialX) (by
      rw [Algebra.algebraMap_self, RingHom.id_apply, RingHom.id_apply]
      ring1)

lemma span_D_eq_top : Submodule.span W.CoordinateRing
    {D L W.CoordinateRing (AdjoinRoot.of W.polynomial X),
      D L W.CoordinateRing (AdjoinRoot.root W.polynomial)} = ⊤ := by
  refine eq_top_iff.mpr <| (span_range_derivation L W.CoordinateRing).ge.trans <|
    Submodule.span_le.mpr ?_
  rintro _ ⟨r, rfl⟩
  induction r using AdjoinRoot.induction_on with
  | ih p =>
    induction p using Polynomial.induction_on with
    | C a =>
      rw [AdjoinRoot.mk_C]
      induction a using Polynomial.induction_on with
      | C c =>
        rw [← Polynomial.algebraMap_eq, ← RingHom.comp_apply, ← AdjoinRoot.algebraMap_eq',
          Derivation.map_algebraMap]
        exact zero_mem _
      | add a b ha hb =>
        rw [map_add, map_add]
        exact add_mem ha hb
      | monomial n c ih =>
        rw [pow_succ, ← mul_assoc, map_mul, Derivation.leibniz]
        exact add_mem (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
          (Submodule.smul_mem _ _ ih)
    | add p q hp hq =>
      rw [map_add, map_add]
      exact add_mem hp hq
    | monomial n a ih =>
      rw [pow_succ, ← mul_assoc, map_mul, AdjoinRoot.mk_X, Derivation.leibniz]
      exact add_mem (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
        (Submodule.smul_mem _ _ ih)

lemma mk_polynomialX_eq : CoordinateRing.mk W W.polynomialX =
    (W⁄W.CoordinateRing).toAffine.polynomialX.evalEval (AdjoinRoot.of W.polynomial X)
      (AdjoinRoot.root W.polynomial) :=
  W.algHom_mk_polynomialX (AlgHom.id L W.CoordinateRing)

lemma mk_polynomialY_eq : CoordinateRing.mk W W.polynomialY =
    (W⁄W.CoordinateRing).toAffine.polynomialY.evalEval (AdjoinRoot.of W.polynomial X)
      (AdjoinRoot.root W.polynomial) :=
  W.algHom_mk_polynomialY (AlgHom.id L W.CoordinateRing)

lemma mk_polynomialX_smul_D_add_mk_polynomialY_smul_D :
    CoordinateRing.mk W W.polynomialX • D L W.CoordinateRing (AdjoinRoot.of W.polynomial X) +
      CoordinateRing.mk W W.polynomialY • D L W.CoordinateRing (AdjoinRoot.root W.polynomial) =
        0 := by
  rw [mk_polynomialX_eq, mk_polynomialY_eq]
  exact Equation.evalEval_polynomialX_smul_add_evalEval_polynomialY_smul_eq_zero
    (D L W.CoordinateRing) (CoordinateRing.equation_X_root W)

lemma mk_polynomialX_ne_zero_or_mk_polynomialY_ne_zero :
    CoordinateRing.mk W W.polynomialX ≠ 0 ∨ CoordinateRing.mk W W.polynomialY ≠ 0 := by
  by_contra! h
  rw [mk_polynomialX_eq, mk_polynomialY_eq, evalEval_polynomialX, evalEval_polynomialY] at h
  simp only [WeierstrassCurve.baseChange, map_a₁, map_a₂, map_a₃, map_a₄] at h
  have h3 : ∀ i, ![W.a₁, 2, W.a₃] i = 0 :=
    Fintype.linearIndependent_iff.mp (CoordinateRing.linearIndependent_X_root_one (W := W)) _ (by
      simp [Fin.sum_univ_three, Algebra.smul_def]
      rw [map_ofNat]
      linear_combination h.2)
  have h2 : (2 : W.CoordinateRing) = 0 := by
    rw [← map_ofNat (algebraMap L W.CoordinateRing) 2]
    simpa using h3 1
  have ha₁ : W.a₁ = 0 := by simpa using h3 0
  have hx : AdjoinRoot.of W.polynomial (X ^ 2 + C W.a₄) = 0 := by
    rw [map_add, map_pow, ← Polynomial.algebraMap_eq, ← RingHom.comp_apply,
      ← AdjoinRoot.algebraMap_eq']
    rw [ha₁, map_zero] at h
    linear_combination -h.1 - ((AdjoinRoot.of W.polynomial X) ^ 2 +
      algebraMap L W.CoordinateRing W.a₂ * AdjoinRoot.of W.polynomial X) * h2
  exact X_pow_add_C_ne_zero two_pos W.a₄ <| of.injective_of_degree_ne_zero
    (by rw [W.degree_polynomial]; decide) (hx.trans (map_zero _).symm)

variable (P : Ideal W.CoordinateRing) [P.IsPrime]

lemma span_tmul_D_eq_top : Submodule.span (Localization.AtPrime P)
    {(1 : Localization.AtPrime P) ⊗ₜ[W.CoordinateRing]
      D L W.CoordinateRing (AdjoinRoot.of W.polynomial X),
      (1 : Localization.AtPrime P) ⊗ₜ[W.CoordinateRing]
        D L W.CoordinateRing (AdjoinRoot.root W.polynomial)} = ⊤ := by
  simpa [W.span_D_eq_top] using (Submodule.baseChange_span (R := W.CoordinateRing)
    (Localization.AtPrime P) {D L W.CoordinateRing (AdjoinRoot.of W.polynomial X),
      D L W.CoordinateRing (AdjoinRoot.root W.polynomial)}).symm

lemma algebraMap_smul_tmul_D_add :
    algebraMap W.CoordinateRing (Localization.AtPrime P) (CoordinateRing.mk W W.polynomialX) •
        ((1 : Localization.AtPrime P) ⊗ₜ[W.CoordinateRing]
          D L W.CoordinateRing (AdjoinRoot.of W.polynomial X)) +
      algebraMap W.CoordinateRing (Localization.AtPrime P) (CoordinateRing.mk W W.polynomialY) •
        ((1 : Localization.AtPrime P) ⊗ₜ[W.CoordinateRing]
          D L W.CoordinateRing (AdjoinRoot.root W.polynomial)) = 0 := by
  rw [algebraMap_smul, algebraMap_smul, ← TensorProduct.tmul_smul, ← TensorProduct.tmul_smul,
    ← TensorProduct.tmul_add, W.mk_polynomialX_smul_D_add_mk_polynomialY_smul_D,
    TensorProduct.tmul_zero]

lemma free_of_mk_polynomialY_notMem (hY : CoordinateRing.mk W W.polynomialY ∉ P) :
    Module.Free (Localization.AtPrime P)
      ((Localization.AtPrime P) ⊗[W.CoordinateRing] KaehlerDifferential L W.CoordinateRing) := by
  have hunit : IsUnit (algebraMap W.CoordinateRing (Localization.AtPrime P)
      (CoordinateRing.mk W W.polynomialY)) :=
    (AtPrime.isUnit_to_map_iff _ P _).mpr hY
  refine Module.free_of_span_singleton_eq_top
    (ω := (1 : Localization.AtPrime P) ⊗ₜ[W.CoordinateRing]
      D L W.CoordinateRing (AdjoinRoot.of W.polynomial X)) ?_
    ((Algebra.linearMap W.CoordinateRing (Localization.AtPrime P) ∘ₗ
      W.hamiltonianDerivation.liftKaehlerDifferential).liftBaseChange _) ?_
  · rw [eq_top_iff, ← W.span_tmul_D_eq_top P, Submodule.span_le]
    rintro _ (rfl | rfl)
    · exact Submodule.mem_span_singleton_self _
    · exact Submodule.mem_span_singleton.mpr ⟨_,
        (Module.eq_neg_inv_mul_smul_of_smul_add_smul_eq_zero hunit
          (W.algebraMap_smul_tmul_D_add P)).symm⟩
  · rw [LinearMap.liftBaseChange_tmul, one_smul, LinearMap.comp_apply,
      Derivation.liftKaehlerDifferential_comp_D, hamiltonianDerivation, derivationOfValues_X,
      Algebra.linearMap_apply]
    exact hunit

lemma free_of_mk_polynomialX_notMem (hX : CoordinateRing.mk W W.polynomialX ∉ P) :
    Module.Free (Localization.AtPrime P)
      ((Localization.AtPrime P) ⊗[W.CoordinateRing] KaehlerDifferential L W.CoordinateRing) := by
  have hunit : IsUnit (algebraMap W.CoordinateRing (Localization.AtPrime P)
      (CoordinateRing.mk W W.polynomialX)) :=
    (AtPrime.isUnit_to_map_iff _ P _).mpr hX
  refine Module.free_of_span_singleton_eq_top
    (ω := (1 : Localization.AtPrime P) ⊗ₜ[W.CoordinateRing]
      D L W.CoordinateRing (AdjoinRoot.root W.polynomial)) ?_
    ((Algebra.linearMap W.CoordinateRing (Localization.AtPrime P) ∘ₗ
      W.hamiltonianDerivation.liftKaehlerDifferential).liftBaseChange _) ?_
  · rw [eq_top_iff, ← W.span_tmul_D_eq_top P, Submodule.span_le]
    rintro _ (rfl | rfl)
    · exact Submodule.mem_span_singleton.mpr ⟨_,
        (Module.eq_neg_inv_mul_smul_of_smul_add_smul_eq_zero hunit
          ((add_comm _ _).trans (W.algebraMap_smul_tmul_D_add P))).symm⟩
    · exact Submodule.mem_span_singleton_self _
  · rw [LinearMap.liftBaseChange_tmul, one_smul, LinearMap.comp_apply,
      Derivation.liftKaehlerDifferential_comp_D, hamiltonianDerivation, derivationOfValues_root,
      Algebra.linearMap_apply, map_neg]
    exact hunit.neg

lemma not_free_of_mem (hX : CoordinateRing.mk W W.polynomialX ∈ P)
    (hY : CoordinateRing.mk W W.polynomialY ∈ P) : ¬Module.Free (Localization.AtPrime P)
      ((Localization.AtPrime P) ⊗[W.CoordinateRing] KaehlerDifferential L W.CoordinateRing) := by
  intro hfree
  have h0X : algebraMap W.CoordinateRing P.ResidueField (CoordinateRing.mk W W.polynomialX) = 0 :=
    Ideal.algebraMap_residueField_eq_zero.mpr hX
  have h0Y : algebraMap W.CoordinateRing P.ResidueField (CoordinateRing.mk W W.polynomialY) = 0 :=
    Ideal.algebraMap_residueField_eq_zero.mpr hY
  have hfin : Module.Finite (Localization.AtPrime P)
      ((Localization.AtPrime P) ⊗[W.CoordinateRing] KaehlerDifferential L W.CoordinateRing) :=
    Module.finite_def.mpr (W.span_tmul_D_eq_top P ▸ Submodule.fg_span (Set.toFinite _))
  let Φ :
      KaehlerDifferential L W.CoordinateRing →ₗ[W.CoordinateRing] P.ResidueField × P.ResidueField :=
    (W.derivationOfValues P.ResidueField 1 0 (by rw [h0X, h0Y]; ring1)).liftKaehlerDifferential.prod
      (W.derivationOfValues P.ResidueField 0 1 (by rw [h0X, h0Y]; ring1)).liftKaehlerDifferential
  have h2 : 2 ≤ Module.finrank (Localization.AtPrime P)
      ((Localization.AtPrime P) ⊗[W.CoordinateRing] KaehlerDifferential L W.CoordinateRing) :=
    Module.two_le_finrank_of_surjective_liftBaseChange (Φ := Φ.liftBaseChange _) fun z ↦
      ⟨z.1 ⊗ₜ ((1 : Localization.AtPrime P) ⊗ₜ
          D L W.CoordinateRing (AdjoinRoot.of W.polynomial X)) + z.2 ⊗ₜ
            ((1 : Localization.AtPrime P) ⊗ₜ D L W.CoordinateRing (AdjoinRoot.root W.polynomial)),
        by simp [Φ, derivationOfValues_X, derivationOfValues_root]⟩
  have hinj : Function.Injective (algebraMap W.CoordinateRing (Localization.AtPrime P)) :=
    IsLocalization.injective _ P.primeCompl_le_nonZeroDivisors
  rcases W.mk_polynomialX_ne_zero_or_mk_polynomialY_ne_zero with hX₀ | hY₀
  · exact absurd (Module.finrank_le_one_of_smul_add_smul_eq_zero
      (by rw [Set.pair_comm]; exact W.span_tmul_D_eq_top P)
      ((add_comm _ _).trans (W.algebraMap_smul_tmul_D_add P)) ((map_ne_zero_iff _ hinj).mpr hX₀))
      (by omega)
  · exact absurd (Module.finrank_le_one_of_smul_add_smul_eq_zero (W.span_tmul_D_eq_top P)
      (W.algebraMap_smul_tmul_D_add P) ((map_ne_zero_iff _ hinj).mpr hY₀)) (by omega)

/-- **The Jacobian criterion for a Weierstrass curve** (LMFDB `ag.singular_point` for the
Weierstrass cubic): over a field `L`, the module of differentials `Ω[R⁄L]` of the coordinate ring
`R` of the affine curve is locally free at a point `p` of `Spec R` exactly when the partial
derivatives `W_X` and `W_Y` of the Weierstrass polynomial do not both vanish at `p`, that is, when
the Jacobian matrix `(W_X, W_Y)` has rank one, the codimension of the curve in the plane. -/
lemma mem_freeLocus_iff (p : PrimeSpectrum W.CoordinateRing) :
    p ∈ Module.freeLocus W.CoordinateRing (KaehlerDifferential L W.CoordinateRing) ↔
      CoordinateRing.mk W W.polynomialX ∉ p.asIdeal ∨
        CoordinateRing.mk W W.polynomialY ∉ p.asIdeal := by
  rw [Module.mem_freeLocus_iff_tensor p (Localization.AtPrime p.asIdeal)]
  refine ⟨fun h ↦ ?_, fun h ↦ h.elim (W.free_of_mk_polynomialX_notMem p.asIdeal)
    (W.free_of_mk_polynomialY_notMem p.asIdeal)⟩
  by_contra! hp
  exact W.not_free_of_mem p.asIdeal hp.1 hp.2 h

lemma freeLocus_eq_univ_of_Δ_ne_zero (hΔ : W.Δ ≠ 0) :
    Module.freeLocus W.CoordinateRing (KaehlerDifferential L W.CoordinateRing) = Set.univ := by
  refine Set.eq_univ_of_forall fun p ↦ (W.mem_freeLocus_iff p).mpr ?_
  by_contra! hp
  have hsing : (W⁄p.asIdeal.ResidueField).toAffine.IsSingular
      (algebraMap W.CoordinateRing p.asIdeal.ResidueField (AdjoinRoot.of W.polynomial X))
      (algebraMap W.CoordinateRing p.asIdeal.ResidueField (AdjoinRoot.root W.polynomial)) :=
    ⟨CoordinateRing.equation_of_algHom (IsScalarTower.toAlgHom L _ _),
      (W.algHom_mk_polynomialX (IsScalarTower.toAlgHom L _ _)).symm.trans
        (Ideal.algebraMap_residueField_eq_zero.mpr hp.1),
      (W.algHom_mk_polynomialY (IsScalarTower.toAlgHom L _ _)).symm.trans
        (Ideal.algebraMap_residueField_eq_zero.mpr hp.2)⟩
  exact hΔ ((map_eq_zero_iff _ (algebraMap L _).injective).mp
    ((WeierstrassCurve.map_Δ W _).symm.trans hsing.Δ_eq_zero))

lemma Δ_ne_zero_of_forall_equation_mem_freeLocus [PerfectField L]
    (h : ∀ (x y : L) (hxy : (W⁄L).toAffine.Equation x y),
      ⟨RingHom.ker (CoordinateRing.evalAlgHom hxy), RingHom.ker_isPrime _⟩ ∈
        Module.freeLocus W.CoordinateRing (KaehlerDifferential L W.CoordinateRing)) : W.Δ ≠ 0 := by
  intro hΔ
  rcases exists_isSingular_of_Δ_eq_zero W hΔ with ⟨a, b, hab⟩
  have heq : (W⁄L).toAffine.Equation a b := hab.1
  have hX : CoordinateRing.mk W W.polynomialX ∈ RingHom.ker (CoordinateRing.evalAlgHom heq) := by
    rw [RingHom.mem_ker, algHom_mk_polynomialX, CoordinateRing.evalAlgHom_of_X,
      CoordinateRing.evalAlgHom_root]
    exact hab.2.1
  have hY : CoordinateRing.mk W W.polynomialY ∈ RingHom.ker (CoordinateRing.evalAlgHom heq) := by
    rw [RingHom.mem_ker, algHom_mk_polynomialY, CoordinateRing.evalAlgHom_of_X,
      CoordinateRing.evalAlgHom_root]
    exact hab.2.2
  exact ((W.mem_freeLocus_iff _).mp (h a b heq)).elim (· hX) (· hY)

/-- **A Weierstrass curve over a perfect field is smooth exactly when its discriminant is
nonzero**: `Δ ≠ 0` exactly when the module of differentials of its coordinate ring is locally free
at every point of the spectrum of the coordinate ring. -/
lemma Δ_ne_zero_iff_freeLocus_eq_univ [PerfectField L] : W.Δ ≠ 0 ↔
    Module.freeLocus W.CoordinateRing (KaehlerDifferential L W.CoordinateRing) = Set.univ :=
  ⟨W.freeLocus_eq_univ_of_Δ_ne_zero, fun h ↦ W.Δ_ne_zero_of_forall_equation_mem_freeLocus
    fun _ _ _ ↦ h ▸ Set.mem_univ _⟩

/-- **A Weierstrass curve over a perfect field is non-singular at all of its points exactly when
its discriminant is nonzero**: `Δ ≠ 0` exactly when, for every solution `(x, y)` of the Weierstrass
equation over `L`, the module of differentials of the coordinate ring is locally free at the point
`(x, y)`, the kernel of evaluation at `(x, y)`. -/
lemma Δ_ne_zero_iff_forall_equation_mem_freeLocus [PerfectField L] : W.Δ ≠ 0 ↔
    ∀ (x y : L) (h : (W⁄L).toAffine.Equation x y),
      ⟨RingHom.ker (CoordinateRing.evalAlgHom h), RingHom.ker_isPrime _⟩ ∈
        Module.freeLocus W.CoordinateRing (KaehlerDifferential L W.CoordinateRing) :=
  ⟨fun hΔ _ _ _ ↦ W.freeLocus_eq_univ_of_Δ_ne_zero hΔ ▸ Set.mem_univ _,
    W.Δ_ne_zero_of_forall_equation_mem_freeLocus⟩

end WeierstrassCurve.Affine

namespace WeierstrassCurve

variable {F : Type*} [Field F] (W : WeierstrassCurve F) (K : Type*) [Field K] [Algebra F K]
  [IsAlgClosed K]

/-- **A Weierstrass equation defines a smooth curve exactly when its discriminant is nonzero**
(LMFDB `ec.discriminant`, with smoothness in the sense of `ag.curve.smooth` and
`ag.singular_point`): for a Weierstrass curve `W` over a field `F` and an algebraically closed
extension `K` of `F`, an algebraic closure for instance, `Δ ≠ 0` exactly when the affine curve
`W⁄K` is non-singular at all of its points, its module of differentials being locally free at
every point of the spectrum of its coordinate ring. -/
lemma Δ_ne_zero_iff_freeLocus_baseChange_eq_univ : W.Δ ≠ 0 ↔
    Module.freeLocus (W⁄K).toAffine.CoordinateRing
      (KaehlerDifferential K (W⁄K).toAffine.CoordinateRing) = Set.univ := by
  have hΔ : (W⁄K).toAffine.Δ = algebraMap F K W.Δ := map_Δ W (algebraMap F K)
  rw [← (W⁄K).toAffine.Δ_ne_zero_iff_freeLocus_eq_univ, hΔ, ne_eq, ne_eq,
    map_eq_zero_iff _ (algebraMap F K).injective]

/-- **A Weierstrass equation defines a curve that is non-singular at all of its points exactly
when its discriminant is nonzero**, with points as in LMFDB `ag.variety` (LMFDB `ec.discriminant`):
for a Weierstrass curve `W` over a field `F` and an algebraically closed extension `K` of `F`,
`Δ ≠ 0` exactly when, at every point `(x, y) ∈ K²` of the affine curve `W⁄K`, that is, at the kernel
of evaluation at `(x, y)`, the module of differentials of its coordinate ring is locally free. -/
lemma Δ_ne_zero_iff_forall_equation_mem_freeLocus_baseChange : W.Δ ≠ 0 ↔
    ∀ (x y : K) (h : (W⁄K).toAffine.Equation x y),
      ⟨RingHom.ker (CoordinateRing.evalAlgHom (W := (W⁄K).toAffine) h), RingHom.ker_isPrime _⟩ ∈
        Module.freeLocus (W⁄K).toAffine.CoordinateRing
          (KaehlerDifferential K (W⁄K).toAffine.CoordinateRing) :=
  (W.Δ_ne_zero_iff_freeLocus_baseChange_eq_univ K).trans <|
    (W⁄K).toAffine.Δ_ne_zero_iff_freeLocus_eq_univ.symm.trans
      (W⁄K).toAffine.Δ_ne_zero_iff_forall_equation_mem_freeLocus

end WeierstrassCurve
