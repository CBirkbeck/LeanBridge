import Mathlib.AlgebraicGeometry.EllipticCurve.IsomOfJ
import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.Dual.Degree
import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.Hom.ComplexMultiplication

/-!
# Complex multiplication

An elliptic curve `W` over a field `K` has complex multiplication (CM) if its endomorphism ring
`End(W)`, the ring `TauCeti.Isogeny.Hom W W` of endomorphisms defined over `K`, is larger than
`ℤ`. It has potential complex multiplication if its geometric endomorphism ring is larger than
`ℤ`, which is Tau Ceti's `WeierstrassCurve.HasGeometricCM`.

In characteristic zero, the endomorphism ring of a curve with complex multiplication is an order
`ℤ[α]` in an imaginary quadratic field, and its discriminant is the CM discriminant. In terms of
endomorphisms, it is the discriminant `t² - 4n` of the characteristic polynomial `X² - t X + n` of
`α`, where `n = deg α` and `t = deg (α + 1) - deg α - 1` is the trace of `α`
(`TauCeti.Isogeny.Hom.mul_self_eq_polar_smul_sub_degree`).

## Main definitions

* `WeierstrassCurve.HasCM` (LMFDB `ec.complex_multiplication`): the endomorphism ring over `K` is
  larger than `ℤ`.
* `WeierstrassCurve.cmDiscriminant` (LMFDB `ec.complex_multiplication`): the discriminant of the
  endomorphism ring over `K`, when it is generated by one endomorphism.
* `WeierstrassCurve.geometricCMDiscriminant` (LMFDB `ec.complex_multiplication`): the discriminant
  of the geometric endomorphism ring, for curves with potential complex multiplication.

## Main results

* `WeierstrassCurve.HasCM.hasGeometricCM`: complex multiplication implies potential complex
  multiplication.
* `WeierstrassCurve.cmDiscriminant_eq`: the CM discriminant is `t² - 4n` for every generator of the
  endomorphism ring.
* `WeierstrassCurve.cmDiscriminant_neg`: the CM discriminant of a curve with complex
  multiplication by an order `ℤ[α]` is negative.
* `WeierstrassCurve.hasGeometricCM_iff_of_j_eq`: potential complex multiplication depends only on
  the `j`-invariant.
-/

open TauCeti TauCeti.Isogeny

namespace WeierstrassCurve

variable {K : Type*} [Field K] (W : WeierstrassCurve K) [W.IsElliptic]

/-- An elliptic curve `W` over `K` has **complex multiplication** (LMFDB
`ec.complex_multiplication`), or CM, if its endomorphism ring, the ring of endomorphisms of `W`
defined over `K` (`TauCeti.Isogeny.Hom`), is larger than `ℤ`: some endomorphism over `K` is not
multiplication by an integer. Potential complex multiplication, where the geometric endomorphism
ring is larger than `ℤ`, is Tau Ceti's `WeierstrassCurve.HasGeometricCM`. -/
def HasCM : Prop :=
  ∃ f : Hom W.toAffine W.toAffine, f ∉ Set.range ((↑) : ℤ → Hom W.toAffine W.toAffine)

variable {W} {α β : Hom W.toAffine W.toAffine} (hα : Submodule.span ℤ {1, α} = ⊤) (hW : W.HasCM)
  (a b : ℤ) {N m : ℤ}

include hW in
/-- **Complex multiplication implies potential complex multiplication**: an endomorphism over `K`
stays an endomorphism over a separable closure of `K`. -/
lemma HasCM.hasGeometricCM : W.HasGeometricCM :=
  hW.elim fun _ hf ↦ hasGeometricCM_of_notMem_range_intCast hf

local notation "Q" => Hom.degreeForm W.toAffine W.toAffine

private lemma degreeForm_one : Q 1 = 1 := by
  rw [Hom.degreeForm_apply, Hom.one_def, Hom.degree_id, Nat.cast_one]

variable (α) in
private lemma degreeForm_add_smul :
    Q (a • 1 + b • α) = a ^ 2 + a * b * QuadraticMap.polar Q α 1 + b ^ 2 * Q α := by
  simp only [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, QuadraticMap.polar_smul_left,
    QuadraticMap.polar_smul_right, degreeForm_one]
  rw [QuadraticMap.polar_comm _ 1 α]
  ring1

variable (α) in
private lemma discr_add_smul : QuadraticMap.polar Q (a • 1 + b • α) 1 ^ 2 - 4 * Q (a • 1 + b • α) =
    b ^ 2 * (QuadraticMap.polar Q α 1 ^ 2 - 4 * Q α) := by
  simp only [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, QuadraticMap.polar_add_left,
    QuadraticMap.polar_smul_left, QuadraticMap.polar_smul_right, QuadraticMap.polar_self,
    degreeForm_one]
  rw [QuadraticMap.polar_comm _ 1 α]
  ring1

variable (m) in
private lemma discr_smul_one :
    QuadraticMap.polar Q (m • 1) 1 ^ 2 - 4 * Q (m • 1 : Hom W.toAffine W.toAffine) = 0 := by
  simpa using discr_add_smul (1 : Hom W.toAffine W.toAffine) m 0

private lemma mem_range_intCast_of_zsmul (hN : N ≠ 0) (h : N • β = m • 1) : ∃ n : ℤ, β = n • 1 := by
  rcases Hom.mem_range_of_zsmul_mem_range
    (Int.castRingHom (Hom W.toAffine W.toAffine)).injective_int hN
    ⟨m, by rw [h, eq_intCast, zsmul_one]⟩ with ⟨n, hn⟩
  exact ⟨n, by rw [← hn, eq_intCast, zsmul_one]⟩

include hα in
private lemma discr_eq_of_span_eq_top (hβ : Submodule.span ℤ {1, β} = ⊤) :
    QuadraticMap.polar Q β 1 ^ 2 - 4 * Q β = QuadraticMap.polar Q α 1 ^ 2 - 4 * Q α := by
  rcases Submodule.mem_span_pair.mp (Submodule.eq_top_iff'.mp hα β) with ⟨a, b, hab⟩
  rcases Submodule.mem_span_pair.mp (Submodule.eq_top_iff'.mp hβ α) with ⟨c, d, hcd⟩
  by_cases hbd : b * d = 1
  · rw [← hab, discr_add_smul, Int.isUnit_sq (.of_mul_eq_one d hbd), one_mul]
  · have h : (1 - b * d) • β = (a + b * c) • 1 := by
      rw [sub_smul, one_smul, sub_eq_iff_eq_add, add_smul, add_assoc, mul_smul, mul_smul,
        ← smul_add, hcd, hab]
    rcases mem_range_intCast_of_zsmul (sub_ne_zero.mpr (Ne.symm hbd)) h with ⟨n, rfl⟩
    rw [← hcd, smul_smul, ← add_smul, discr_smul_one, discr_smul_one]

include hα hW in
private lemma not_exists_eq_smul_one : ¬∃ m : ℤ, α = m • 1 := by
  rintro ⟨m, rfl⟩
  rcases hW with ⟨f, hf⟩
  rcases Submodule.mem_span_pair.mp (Submodule.eq_top_iff'.mp hα f) with ⟨a, b, rfl⟩
  exact hf ⟨a + b * m, by rw [smul_smul, ← add_smul, zsmul_one]⟩

open scoped Classical in
variable (W) in
/-- The **CM discriminant** (LMFDB `ec.complex_multiplication`) of an elliptic curve `W` over `K`:
the discriminant of its endomorphism ring over `K` (`TauCeti.Isogeny.Hom`) when that ring is
generated by one endomorphism `α`, as is any order `ℤ[α]` in an imaginary quadratic field. It is
the discriminant `t² - 4n` of the characteristic polynomial `X² - t X + n` of `α`, where `n` is the
degree of `α` and `t = deg (α + 1) - deg α - 1` is its trace; it does not depend on the generator
(`cmDiscriminant_eq`). It is `0` when the endomorphism ring is `ℤ`, and also, as a convention,
when the endomorphism ring is not generated by one endomorphism. -/
noncomputable def cmDiscriminant : ℤ :=
  if h : ∃ α : Hom W.toAffine W.toAffine, Submodule.span ℤ {1, α} = ⊤ then
    QuadraticMap.polar Q h.choose 1 ^ 2 - 4 * Q h.choose
  else 0

include hα in
/-- **The CM discriminant is `t² - 4n` for every generator `α` of the endomorphism ring**, where
`n = deg α` and `t = deg (α + 1) - deg α - 1`. -/
lemma cmDiscriminant_eq : W.cmDiscriminant = QuadraticMap.polar Q α 1 ^ 2 - 4 * Q α := by
  have h : ∃ α : Hom W.toAffine W.toAffine, Submodule.span ℤ {1, α} = ⊤ := ⟨α, hα⟩
  rw [cmDiscriminant, dite_eq_left h]
  exact discr_eq_of_span_eq_top hα h.choose_spec

include hα hW in
/-- **The CM discriminant of a curve with complex multiplication by an order `ℤ[α]` is negative**:
the degree is a positive definite quadratic form on the endomorphism ring, which is the norm form
of the imaginary quadratic order. -/
lemma cmDiscriminant_neg : W.cmDiscriminant < 0 := by
  have hv : (-QuadraticMap.polar Q α 1) • 1 + (2 : ℤ) • α ≠ 0 := by
    rw [neg_smul, neg_add_eq_sub, sub_ne_zero]
    exact fun h2 ↦ not_exists_eq_smul_one hα hW <| mem_range_intCast_of_zsmul two_ne_zero h2
  have hQ : 0 < Q ((-QuadraticMap.polar Q α 1) • 1 + (2 : ℤ) • α) := Hom.degreeForm_posDef _ hv
  rw [degreeForm_add_smul] at hQ
  rw [cmDiscriminant_eq hα]
  linarith

lemma cmDiscriminant_eq_zero_of_not_hasCM (h : ¬W.HasCM) : W.cmDiscriminant = 0 := by
  by_cases hα : ∃ α : Hom W.toAffine W.toAffine, Submodule.span ℤ {1, α} = ⊤
  · rcases hα with ⟨α, hα⟩
    rcases not_not.mp (not_exists.mp h α) with ⟨m, rfl⟩
    rw [cmDiscriminant_eq hα, ← zsmul_one, discr_smul_one]
  · rw [cmDiscriminant, dite_eq_right hα]

variable (W) in
/-- The **CM discriminant of the geometric endomorphism ring** (LMFDB
`ec.complex_multiplication`) of an elliptic curve `W` over `K`: the CM discriminant
(`cmDiscriminant`) of the base change of `W` to a separable closure of `K`, whose endomorphism ring
is the geometric endomorphism ring `WeierstrassCurve.GeometricEnd W`. It is nonzero only for curves
with potential complex multiplication, and it is the discriminant the LMFDB lists for the curves
over `ℚ` with potential complex multiplication. -/
noncomputable def geometricCMDiscriminant : ℤ :=
  (W.baseChange (SeparableClosure K)).cmDiscriminant

lemma hasGeometricCM_iff_hasCM_baseChange :
    W.HasGeometricCM ↔ (W.baseChange (SeparableClosure K)).HasCM :=
  Iff.rfl

variable (C : VariableChange K)

include hW in
lemma HasCM.smul : (C • W).HasCM := by
  rcases hW with ⟨f, hf⟩
  let ι : Hom W.toAffine (C • W).toAffine := Hom.ofIsogeny (variableChangeIsogeny C rfl)
  let ι' : Hom (C • W).toAffine W.toAffine :=
    Hom.ofIsogeny (variableChangeIsogeny C⁻¹ (inv_smul_smul C W))
  have hι : ι'.comp ι = Hom.id W.toAffine := by
    rw [Hom.ofIsogeny_comp_ofIsogeny, variableChangeIsogeny_inv_comp, Hom.id_def]
  refine ⟨ι.comp (f.comp ι'), fun ⟨n, hn⟩ ↦ hf ⟨n, ?_⟩⟩
  have hf' : ι'.comp ((n : Hom (C • W).toAffine (C • W).toAffine).comp ι) = f := by
    rw [hn, Hom.comp_assoc, ← Hom.comp_assoc, ← Hom.comp_assoc, hι, Hom.id_comp, Hom.comp_assoc,
      hι, Hom.comp_id]
  rw [← hf', ← zsmul_one (R := Hom (C • W).toAffine (C • W).toAffine), Hom.one_def,
    Hom.zsmul_comp, Hom.id_comp, Hom.comp_zsmul, hι, ← Hom.one_def, zsmul_one]

lemma hasCM_smul_iff : (C • W).HasCM ↔ W.HasCM :=
  ⟨fun h ↦ by simpa using h.smul C⁻¹, (·.smul C)⟩

variable {W' : WeierstrassCurve K} [W'.IsElliptic]

/-- **Potential complex multiplication depends only on the `j`-invariant**: over a separable
closure, curves with the same `j`-invariant are isomorphic, and isomorphic curves have isomorphic
endomorphism rings. -/
lemma hasGeometricCM_iff_of_j_eq (hj : W.j = W'.j) : W.HasGeometricCM ↔ W'.HasGeometricCM := by
  rcases exists_variableChange_of_j_eq (W.baseChange (SeparableClosure K))
    (W'.baseChange (SeparableClosure K)) (by simp only [baseChange, map_j, hj]) with ⟨C, hC⟩
  rw [hasGeometricCM_iff_hasCM_baseChange, hasGeometricCM_iff_hasCM_baseChange, ← hasCM_smul_iff C]
  simp only [hC]

end WeierstrassCurve
