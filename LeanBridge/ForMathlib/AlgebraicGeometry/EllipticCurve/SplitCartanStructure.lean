import LeanBridge.ForMathlib.AlgebraicGeometry.EllipticCurve.GaloisRep.Basic
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.ArithCurve
import LeanBridge.ForMathlib.NumberTheory.ModularCurve.SplitCartanCurve

/-!
# Split Cartan and arithmetic level structures on elliptic curves

Let `W` be an elliptic curve over a field `F`, `K` an extension of `F` (in the LMFDB a separable
closure, so that `K ≃ₐ[F] K` is the absolute Galois group of `F`), and `E[N]` the `N`-torsion of
`W` over `K`, on which `K ≃ₐ[F] K` acts by the mod-`N` Galois representation. The LMFDB describes
the non-cuspidal `F`-points of three modular curves by Galois-stable data on `E[N]`:

* `X_sp(N)` (`modcurve.xsp`): triples `(E, C, D)` with `C` and `D` Galois-stable cyclic subgroups
  of `E[N]` such that `E[N] = C ⊕ D`;
* `X_sp⁺(N)` (`modcurve.xsp_plus`): pairs `(E, {C, D})` with `C` and `D` cyclic subgroups of
  `E[N]` such that `E[N] = C ⊕ D` and the unordered pair `{C, D}` is Galois-stable;
* `X_arith(N)` (`modcurve.xarith`): triples `(E, φ, P)` with `P` a point of exact order `N` and
  `φ` a cyclic `N`-isogeny such that `E[N]` is generated by `P` and `ker φ`. Over `F`, `P` is
  `F`-rational and `φ` is defined over `F`, that is, its kernel is Galois-stable; `φ` is recorded
  by its kernel, as in `LeanBridge.ForMathlib.AlgebraicGeometry.EllipticCurve.LevelStructure`.

The knowls write `E[N] ≃ C ⊕ D`, which must be read as an internal direct sum, `IsCompl C D` here:
as an abstract isomorphism it would hold for any two cyclic subgroups of order `N`, even `C = D`.

These are the structures cut out by the subgroups `Cs(N)` (diagonal), `Ns(N)` (diagonal and
antidiagonal) and `!![1, 0; 0, *]` of `GL₂(ℤ/Nℤ)`: for a basis `(P, Q)` of `E[N]` over `ℤ/Nℤ`, the
mod-`N` representation in this basis takes values in `Cs(N)`, `Ns(N)` or `!![1, 0; 0, *]` if and
only if `(⟨P⟩, ⟨Q⟩)`, `{⟨P⟩, ⟨Q⟩}` or `(⟨Q⟩, P)` is such a structure. Conversely, when `E[N]` is
free of rank `2` over `ℤ/Nℤ`, as it is for `K` separably closed and `N` invertible in `K`
(`WeierstrassCurve.nonempty_basis_torsionBy`), every such structure comes from a basis, and its
cyclic subgroups have order `N`. Hence `W` carries such a structure if and only if its mod-`N` image
lies, in some basis, in the corresponding subgroup: this is how a rational point of the modular
curve of its inverse image in `GL₂(ℤ̂)` arises (LMFDB `modcurve.level_structure`). The modular
curves themselves, their cusps and the bijection between their points and isomorphism classes of
these structures are not formalised; nor is the second moduli description of `X_arith(N)`, by
symplectic isomorphisms `μ_N × ℤ/Nℤ ≃ E[N]`.

## Main definitions

* `WeierstrassCurve.IsGaloisStableTorsion`: a subgroup of `E[N]` is Galois-stable.
* `WeierstrassCurve.IsSplitCartanLevelStructure` (LMFDB `modcurve.xsp`): the triples `(E, C, D)`.
* `WeierstrassCurve.IsSplitCartanPlusLevelStructure` (LMFDB `modcurve.xsp_plus`): the pairs
  `(E, {C, D})`.
* `WeierstrassCurve.IsArithLevelStructure` (LMFDB `modcurve.xarith`): the triples `(E, φ, P)`.
* `Module.Basis.ofSupEqTop`: the basis `(P, Q)` of a free `ℤ/Nℤ`-module of rank `2` generated by
  `P` and `Q`.

## Main results

* `IsCompl.natCard_eq_of_isAddCyclic`: complementary cyclic subgroups of a free `ℤ/Nℤ`-module of
  rank `2` have order `N`.
* `WeierstrassCurve.range_modGaloisRepresentationGL_le_diagonalTorus_iff`,
  `WeierstrassCurve.range_modGaloisRepresentationGL_le_extendedCartanSubgroup_iff` and
  `WeierstrassCurve.range_modGaloisRepresentationGL_le_arithSubgroup_iff`: the mod-`N` image in a
  basis `(P, Q)` lies in `Cs(N)`, `Ns(N)` or `!![1, 0; 0, *]` if and only if `(⟨P⟩, ⟨Q⟩)`,
  `{⟨P⟩, ⟨Q⟩}` or `(⟨Q⟩, P)` is a level structure of the corresponding kind.
* `WeierstrassCurve.exists_isSplitCartanLevelStructure_iff`,
  `WeierstrassCurve.exists_isSplitCartanPlusLevelStructure_iff` and
  `WeierstrassCurve.exists_isArithLevelStructure_iff`: over a separably closed field in which `N` is
  invertible, `W` carries such a level structure if and only if its mod-`N` image lies, in some
  basis, in the corresponding subgroup.
-/

open Matrix GeneralLinearGroup TauCeti

open scoped WeierstrassCurve

section ZModModule

variable {N : ℕ} {V : Type*} [AddCommGroup V] [Module (ZMod N) V] {a : ZMod N} {x : V}

lemma ZMod.zmultiples_smul_of_isUnit (ha : IsUnit a) :
    AddSubgroup.zmultiples (a • x) = AddSubgroup.zmultiples x := by
  rcases ha with ⟨u, rfl⟩
  have h : ((u⁻¹ : (ZMod N)ˣ) : ZMod N) • (u : ZMod N) • x ∈
      AddSubgroup.zmultiples ((u : ZMod N) • x) :=
    ZMod.smul_mem (AddSubgroup.mem_zmultiples _) _
  rw [smul_smul, Units.inv_mul, one_smul] at h
  exact le_antisymm (AddSubgroup.zmultiples_le.mpr (ZMod.smul_mem (AddSubgroup.mem_zmultiples x) _))
    (AddSubgroup.zmultiples_le.mpr h)

namespace Module.Basis

variable {P Q : V}

lemma surjective_linearCombination (h : AddSubgroup.zmultiples P ⊔ AddSubgroup.zmultiples Q = ⊤) :
    Function.Surjective (Fintype.linearCombination (ZMod N) ![P, Q]) := by
  intro v
  rcases AddSubgroup.mem_sup.mp (h ▸ AddSubgroup.mem_top v) with ⟨x, hx, y, hy, rfl⟩
  rcases AddSubgroup.mem_zmultiples_iff.mp hx with ⟨k, rfl⟩
  rcases AddSubgroup.mem_zmultiples_iff.mp hy with ⟨m, rfl⟩
  exact ⟨![k, m], by simp [Fintype.linearCombination_apply, Int.cast_smul_eq_zsmul]⟩

lemma bijective_linearCombination [NeZero N] (b : Basis (Fin 2) (ZMod N) V)
    (h : AddSubgroup.zmultiples P ⊔ AddSubgroup.zmultiples Q = ⊤) :
    Function.Bijective (Fintype.linearCombination (ZMod N) ![P, Q]) :=
  ⟨(surjective_linearCombination h).injective_of_finite b.equivFun.symm.toEquiv,
    surjective_linearCombination h⟩

variable (b : Basis (Fin 2) (ZMod N) V) (i : Fin 2)

variable {i} in
lemma mem_zmultiples_iff {j : Fin 2} (hij : i ≠ j) {v : V} :
    v ∈ AddSubgroup.zmultiples (b i) ↔ b.repr v j = 0 := by
  refine ⟨fun hv ↦ ?_, fun hv ↦ ?_⟩
  · rcases AddSubgroup.mem_zmultiples_iff.mp hv with ⟨k, rfl⟩
    rw [map_zsmul, b.repr_self, Finsupp.smul_apply, Finsupp.single_eq_of_ne hij.symm, smul_zero]
  · rw [← b.sum_repr v, Fin.sum_univ_two]
    fin_cases i <;> fin_cases j <;> simp_all [ZMod.smul_mem]

lemma isCompl_zmultiples :
    IsCompl (AddSubgroup.zmultiples (b 0)) (AddSubgroup.zmultiples (b 1)) := by
  refine ⟨AddSubgroup.disjoint_def.mpr fun {v} h₀ h₁ ↦ b.ext_elem fun i ↦ ?_,
    codisjoint_iff.mpr (eq_top_iff.mpr fun v _ ↦ ?_)⟩
  · fin_cases i
    · simpa using (b.mem_zmultiples_iff one_ne_zero).mp h₁
    · simpa using (b.mem_zmultiples_iff zero_ne_one).mp h₀
  · rw [← b.sum_repr v, Fin.sum_univ_two]
    exact AddSubgroup.add_mem_sup (ZMod.smul_mem (AddSubgroup.mem_zmultiples (b 0)) _)
      (ZMod.smul_mem (AddSubgroup.mem_zmultiples (b 1)) _)

lemma addOrderOf_eq : addOrderOf (b i) = N := by
  refine Nat.dvd_antisymm (addOrderOf_dvd_iff_nsmul_eq_zero.mpr ?_) ?_
  · rw [← Nat.cast_smul_eq_nsmul (ZMod N), ZMod.natCast_self, zero_smul]
  · have h : b.repr ((addOrderOf (b i) : ZMod N) • b i) i = 0 := by
      rw [Nat.cast_smul_eq_nsmul, addOrderOf_nsmul_eq_zero, map_zero, Finsupp.coe_zero,
        Pi.zero_apply]
    rw [map_smul, b.repr_self, Finsupp.smul_apply, Finsupp.single_eq_same, smul_eq_mul,
      mul_one] at h
    exact (ZMod.natCast_eq_zero_iff _ _).mp h

lemma natCard_zmultiples : Nat.card (AddSubgroup.zmultiples (b i)) = N := by
  rw [Nat.card_zmultiples, b.addOrderOf_eq i]

variable [NeZero N] (h : AddSubgroup.zmultiples P ⊔ AddSubgroup.zmultiples Q = ⊤)

/-- The **basis `(P, Q)`** of a free `ℤ/Nℤ`-module of rank `2`, with a basis `b`, generated by `P`
and `Q`: the map `(ℤ/Nℤ)² → V`, `(x, y) ↦ x • P + y • Q`, is onto, hence bijective as both sides
have `N²` elements. -/
noncomputable def ofSupEqTop : Basis (Fin 2) (ZMod N) V :=
  (Pi.basisFun (ZMod N) (Fin 2)).map (LinearEquiv.ofBijective _ (b.bijective_linearCombination h))

lemma ofSupEqTop_apply_zero : b.ofSupEqTop h 0 = P := by
  simp [ofSupEqTop]

lemma ofSupEqTop_apply_one : b.ofSupEqTop h 1 = Q := by
  simp [ofSupEqTop]

end Module.Basis

/-- **Complementary cyclic subgroups of a free `ℤ/Nℤ`-module of rank `2` have order `N`**: they are
the lines through the two vectors of a basis. -/
lemma IsCompl.natCard_eq_of_isAddCyclic [NeZero N] (hb : Nonempty (Module.Basis (Fin 2) (ZMod N) V))
    {C D : AddSubgroup V} [IsAddCyclic C] [IsAddCyclic D] (hCD : IsCompl C D) : Nat.card C = N := by
  rcases hb with ⟨b⟩
  rcases (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq_top C).mp inferInstance with ⟨P, rfl⟩
  rcases (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq_top D).mp inferInstance with ⟨Q, rfl⟩
  rw [← b.ofSupEqTop_apply_zero hCD.sup_eq_top]
  exact (b.ofSupEqTop hCD.sup_eq_top).natCard_zmultiples 0

namespace Matrix.GeneralLinearGroup

variable (b : Module.Basis (Fin 2) (ZMod N) V) (φ : LinearMap.GeneralLinearGroup (ZMod N) V)
  (i j : Fin 2)

lemma toLin'_symm_apply_apply : (toLin' b).symm φ i j = b.repr (φ.val (b j)) i := by
  rw [coe_toLin'_symm, LinearMap.toMatrix_apply]

lemma val_apply_eq_add :
    φ.val (b j) = (toLin' b).symm φ 0 j • b 0 + (toLin' b).symm φ 1 j • b 1 := by
  rw [toLin'_symm_apply_apply, toLin'_symm_apply_apply,
    ← Fin.sum_univ_two (fun i ↦ b.repr _ i • b i), b.sum_repr]

lemma toLin'_symm_mem_diagonalTorus_iff : (toLin' b).symm φ ∈ diagonalTorus (ZMod N) 2 ↔
    φ.val (b 0) ∈ AddSubgroup.zmultiples (b 0) ∧ φ.val (b 1) ∈ AddSubgroup.zmultiples (b 1) := by
  rw [b.mem_zmultiples_iff zero_ne_one, b.mem_zmultiples_iff one_ne_zero,
    ← toLin'_symm_apply_apply, ← toLin'_symm_apply_apply, mem_diagonalTorus_iff]
  exact ⟨fun h ↦ ⟨h one_ne_zero, h zero_ne_one⟩,
    fun ⟨h₁₀, h₀₁⟩ ↦ isDiag_of_fin_two (ZMod N) h₀₁ h₁₀⟩

lemma toLin'_symm_mem_arithSubgroup_iff : (toLin' b).symm φ ∈ arithSubgroup (ZMod N) ↔
    φ.val (b 0) = b 0 ∧ φ.val (b 1) ∈ AddSubgroup.zmultiples (b 1) := by
  have h : φ.val (b 0) = b 0 ↔ b.repr (φ.val (b 0)) 0 = 1 ∧ b.repr (φ.val (b 0)) 1 = 0 := by
    simp [b.ext_elem_iff]
  rw [mem_arithSubgroup_iff, b.mem_zmultiples_iff one_ne_zero, h, toLin'_symm_apply_apply,
    toLin'_symm_apply_apply, toLin'_symm_apply_apply, and_right_comm, and_assoc]

variable {b φ i j} in
lemma toLin'_symm_eq_zero_of_zmultiples_eq {k : Fin 2} (hik : i ≠ k)
    (h : AddSubgroup.zmultiples (φ.val (b j)) = AddSubgroup.zmultiples (b i)) :
    (toLin' b).symm φ k j = 0 := by
  rw [toLin'_symm_apply_apply, ← b.mem_zmultiples_iff hik, ← h]
  exact AddSubgroup.mem_zmultiples _

lemma toLin'_symm_mem_extendedCartanSubgroup_iff : (toLin' b).symm φ ∈
    extendedCartanSubgroup (Pi.basisFun (ZMod N) (Fin 2)) ↔
    (AddSubgroup.zmultiples (b 0)).map φ.val.toAddMonoidHom = AddSubgroup.zmultiples (b 0) ∧
    (AddSubgroup.zmultiples (b 1)).map φ.val.toAddMonoidHom = AddSubgroup.zmultiples (b 1) ∨
    (AddSubgroup.zmultiples (b 0)).map φ.val.toAddMonoidHom = AddSubgroup.zmultiples (b 1) ∧
    (AddSubgroup.zmultiples (b 1)).map φ.val.toAddMonoidHom = AddSubgroup.zmultiples (b 0) := by
  have hdet : IsUnit ((toLin' b).symm φ 0 0 * (toLin' b).symm φ 1 1 -
      (toLin' b).symm φ 0 1 * (toLin' b).symm φ 1 0) :=
    det_fin_two (((toLin' b).symm φ : Matrix (Fin 2) (Fin 2) (ZMod N))) ▸
      isUnits_det_units ((toLin' b).symm φ)
  rw [extendedCartanSubgroup_piBasisFun_eq_diagonalAntidiagonal, mem_diagonalAntidiagonal_iff,
    AddMonoidHom.map_zmultiples, AddMonoidHom.map_zmultiples, LinearMap.toAddMonoidHom_coe]
  refine ⟨?_, ?_⟩
  · rintro (⟨h₀₁, h₁₀⟩ | ⟨h₀₀, h₁₁⟩)
    · rw [h₀₁, h₁₀, mul_zero, sub_zero] at hdet
      rw [val_apply_eq_add, val_apply_eq_add, h₀₁, h₁₀, zero_smul, add_zero, zero_smul, zero_add,
        ZMod.zmultiples_smul_of_isUnit (isUnit_of_mul_isUnit_left hdet),
        ZMod.zmultiples_smul_of_isUnit (isUnit_of_mul_isUnit_right hdet)]
      exact Or.inl ⟨rfl, rfl⟩
    · rw [h₀₀, h₁₁, zero_mul, zero_sub, IsUnit.neg_iff] at hdet
      rw [val_apply_eq_add, val_apply_eq_add, h₀₀, h₁₁, zero_smul, zero_add, zero_smul, add_zero,
        ZMod.zmultiples_smul_of_isUnit (isUnit_of_mul_isUnit_right hdet),
        ZMod.zmultiples_smul_of_isUnit (isUnit_of_mul_isUnit_left hdet)]
      exact Or.inr ⟨rfl, rfl⟩
  · rintro (⟨h₀, h₁⟩ | ⟨h₀, h₁⟩)
    · exact Or.inl ⟨toLin'_symm_eq_zero_of_zmultiples_eq one_ne_zero h₁,
        toLin'_symm_eq_zero_of_zmultiples_eq zero_ne_one h₀⟩
    · exact Or.inr ⟨toLin'_symm_eq_zero_of_zmultiples_eq one_ne_zero h₀,
        toLin'_symm_eq_zero_of_zmultiples_eq zero_ne_one h₁⟩

end Matrix.GeneralLinearGroup

end ZModModule

namespace WeierstrassCurve

variable {F K : Type*} [Field F] [Field K] [DecidableEq K] [Algebra F K] (W : WeierstrassCurve F)
  (N : ℕ) (C D : AddSubgroup (AddSubgroup.torsionBy (W⁄K).toAffine.Point (N : ℤ)))
  (P : AddSubgroup.torsionBy (W⁄K).toAffine.Point (N : ℤ))

/-- A subgroup `C` of the `N`-torsion `E[N]` of `W` over `K` is **Galois-stable**: every
`σ : K ≃ₐ[F] K`, acting through the mod-`N` Galois representation, maps `C` into `C`, hence onto
`C` as `σ⁻¹` does too. For `K` a separable closure of `F` this is stability under `Gal(F^s/F)`. -/
def IsGaloisStableTorsion : Prop :=
  ∀ σ : K ≃ₐ[F] K, ∀ P ∈ C, (W.modGaloisRepresentation N σ).val P ∈ C

/-- An **`X_sp(N)`-level structure** `(C, D)` on `W` over `F` (LMFDB `modcurve.xsp`): two
Galois-stable cyclic subgroups `C` and `D` of `E[N]` such that `E[N] = C ⊕ D`, an internal direct
sum. The non-cuspidal `F`-points of `X_sp(N)` parametrize the triples `(E, C, D)`. When `E[N]` is
free of rank `2` over `ℤ/Nℤ`, `C` and `D` have order `N` (`IsCompl.natCard_eq_of_isAddCyclic`), and
such a structure exists if and only if the mod-`N` image of `W` lies, in some basis, in the split
Cartan subgroup (`exists_isSplitCartanLevelStructure_iff`). -/
def IsSplitCartanLevelStructure : Prop :=
  IsAddCyclic C ∧ IsAddCyclic D ∧ IsCompl C D ∧ W.IsGaloisStableTorsion N C ∧
    W.IsGaloisStableTorsion N D

/-- An **`X_sp⁺(N)`-level structure** `{C, D}` on `W` over `F` (LMFDB `modcurve.xsp_plus`): two
cyclic subgroups `C` and `D` of `E[N]` such that `E[N] = C ⊕ D`, an internal direct sum, and the
unordered pair `{C, D}` is Galois-stable, that is, every `σ : K ≃ₐ[F] K` either fixes `C` and `D`
or exchanges them; neither `C` nor `D` need be Galois-stable. The non-cuspidal `F`-points of
`X_sp⁺(N)` parametrize the pairs `(E, {C, D})`; the condition is symmetric in `C` and `D`. Such a
structure exists if and only if the mod-`N` image of `W` lies, in some basis, in the extended split
Cartan subgroup (`exists_isSplitCartanPlusLevelStructure_iff`). -/
def IsSplitCartanPlusLevelStructure : Prop :=
  IsAddCyclic C ∧ IsAddCyclic D ∧ IsCompl C D ∧ ∀ σ : K ≃ₐ[F] K,
    C.map (W.modGaloisRepresentation N σ).val.toAddMonoidHom = C ∧
    D.map (W.modGaloisRepresentation N σ).val.toAddMonoidHom = D ∨
    C.map (W.modGaloisRepresentation N σ).val.toAddMonoidHom = D ∧
    D.map (W.modGaloisRepresentation N σ).val.toAddMonoidHom = C

/-- An **`X_arith(N)`-level structure** `(φ, P)` on `W` over `F` (LMFDB `modcurve.xarith`), in the
first moduli description of the knowl: an `F`-rational point `P` of `E[N]` of exact order `N` and a
cyclic `N`-isogeny `φ` defined over `F`, recorded by its kernel `C`, a Galois-stable cyclic subgroup
of order `N`, such that `E[N]` is generated by `P` and `C`. The non-cuspidal `F`-points of
`X_arith(N)` parametrize the triples `(E, φ, P)`. Such a structure exists if and only if the
mod-`N` image of `W` lies, in some basis, in the group `!![1, 0; 0, *]`
(`exists_isArithLevelStructure_iff`). -/
def IsArithLevelStructure : Prop :=
  addOrderOf P = N ∧ IsAddCyclic C ∧ Nat.card C = N ∧ AddSubgroup.zmultiples P ⊔ C = ⊤ ∧
    (∀ σ : K ≃ₐ[F] K, (W.modGaloisRepresentation N σ).val P = P) ∧ W.IsGaloisStableTorsion N C

variable {W N C D}

lemma IsSplitCartanLevelStructure.symm (h : W.IsSplitCartanLevelStructure N C D) :
    W.IsSplitCartanLevelStructure N D C :=
  ⟨h.2.1, h.1, h.2.2.1.symm, h.2.2.2.2, h.2.2.2.1⟩

lemma IsSplitCartanPlusLevelStructure.symm (h : W.IsSplitCartanPlusLevelStructure N C D) :
    W.IsSplitCartanPlusLevelStructure N D C :=
  ⟨h.2.1, h.1, h.2.2.1.symm, fun σ ↦ (h.2.2.2 σ).imp And.symm And.symm⟩

variable (W N)

lemma isGaloisStableTorsion_zmultiples_iff : W.IsGaloisStableTorsion N (AddSubgroup.zmultiples P) ↔
    ∀ σ : K ≃ₐ[F] K, (W.modGaloisRepresentation N σ).val P ∈ AddSubgroup.zmultiples P := by
  refine ⟨fun h σ ↦ h σ P (AddSubgroup.mem_zmultiples P), fun h σ Q hQ ↦ ?_⟩
  rcases AddSubgroup.mem_zmultiples_iff.mp hQ with ⟨k, rfl⟩
  rw [map_zsmul]
  exact zsmul_mem (h σ) k

variable (b : Module.Basis (Fin 2) (ZMod N) (AddSubgroup.torsionBy (W⁄K).toAffine.Point (N : ℤ)))

/-- **The mod-`N` image of `W` in a basis `(P, Q)` of `E[N]` lies in the split Cartan subgroup
`Cs(N)`** of diagonal matrices **if and only if `(⟨P⟩, ⟨Q⟩)` is an `X_sp(N)`-level structure.** -/
lemma range_modGaloisRepresentationGL_le_diagonalTorus_iff :
    (W.modGaloisRepresentationGL N b).range ≤ diagonalTorus (ZMod N) 2 ↔
    W.IsSplitCartanLevelStructure N (AddSubgroup.zmultiples (b 0))
    (AddSubgroup.zmultiples (b 1)) := by
  refine ⟨fun h ↦ ⟨inferInstance, inferInstance, b.isCompl_zmultiples,
    (W.isGaloisStableTorsion_zmultiples_iff N _).mpr fun σ ↦
      ((toLin'_symm_mem_diagonalTorus_iff b _).mp (h ⟨σ, rfl⟩)).1,
    (W.isGaloisStableTorsion_zmultiples_iff N _).mpr fun σ ↦
      ((toLin'_symm_mem_diagonalTorus_iff b _).mp (h ⟨σ, rfl⟩)).2⟩, ?_⟩
  rintro ⟨-, -, -, h₀, h₁⟩ _ ⟨σ, rfl⟩
  exact (toLin'_symm_mem_diagonalTorus_iff b _).mpr ⟨(W.isGaloisStableTorsion_zmultiples_iff N _).mp
    h₀ σ, (W.isGaloisStableTorsion_zmultiples_iff N _).mp h₁ σ⟩

/-- **The mod-`N` image of `W` in a basis `(P, Q)` of `E[N]` lies in the extended split Cartan
subgroup `Ns(N)`** of diagonal and antidiagonal matrices **if and only if `{⟨P⟩, ⟨Q⟩}` is an
`X_sp⁺(N)`-level structure.** -/
lemma range_modGaloisRepresentationGL_le_extendedCartanSubgroup_iff :
    (W.modGaloisRepresentationGL N b).range ≤
    extendedCartanSubgroup (Pi.basisFun (ZMod N) (Fin 2)) ↔
    W.IsSplitCartanPlusLevelStructure N (AddSubgroup.zmultiples (b 0))
    (AddSubgroup.zmultiples (b 1)) := by
  refine ⟨fun h ↦ ⟨inferInstance, inferInstance, b.isCompl_zmultiples, fun σ ↦
    (toLin'_symm_mem_extendedCartanSubgroup_iff b _).mp (h ⟨σ, rfl⟩)⟩, ?_⟩
  rintro ⟨-, -, -, h⟩ _ ⟨σ, rfl⟩
  exact (toLin'_symm_mem_extendedCartanSubgroup_iff b _).mpr (h σ)

/-- **The mod-`N` image of `W` in a basis `(P, Q)` of `E[N]` lies in the group `!![1, 0; 0, *]` if
and only if `(⟨Q⟩, P)` is an `X_arith(N)`-level structure.** -/
lemma range_modGaloisRepresentationGL_le_arithSubgroup_iff :
    (W.modGaloisRepresentationGL N b).range ≤ arithSubgroup (ZMod N) ↔
    W.IsArithLevelStructure N (AddSubgroup.zmultiples (b 1)) (b 0) := by
  refine ⟨fun h ↦ ⟨b.addOrderOf_eq 0, inferInstance, b.natCard_zmultiples 1,
    b.isCompl_zmultiples.sup_eq_top, fun σ ↦ ((toLin'_symm_mem_arithSubgroup_iff b _).mp
      (h ⟨σ, rfl⟩)).1, (W.isGaloisStableTorsion_zmultiples_iff N _).mpr fun σ ↦
      ((toLin'_symm_mem_arithSubgroup_iff b _).mp (h ⟨σ, rfl⟩)).2⟩, ?_⟩
  rintro ⟨-, -, -, -, h₀, h₁⟩ _ ⟨σ, rfl⟩
  exact (toLin'_symm_mem_arithSubgroup_iff b _).mpr
    ⟨h₀ σ, (W.isGaloisStableTorsion_zmultiples_iff N _).mp h₁ σ⟩

variable [IsSepClosed K] [W.IsElliptic] [NeZero N]

/-- **`W` carries an `X_sp(N)`-level structure if and only if its mod-`N` image lies, in some basis
of `E[N]`, in the split Cartan subgroup `Cs(N)`**, over a separably closed field in which `N` is
invertible: the generators of the two cyclic subgroups form a basis. -/
lemma exists_isSplitCartanLevelStructure_iff (hN : (N : K) ≠ 0) :
    (∃ C D, W.IsSplitCartanLevelStructure (K := K) N C D) ↔
    ∃ b, (W.modGaloisRepresentationGL (K := K) N b).range ≤ diagonalTorus (ZMod N) 2 := by
  refine ⟨?_, fun ⟨b, hb⟩ ↦
    ⟨_, _, (W.range_modGaloisRepresentationGL_le_diagonalTorus_iff N b).mp hb⟩⟩
  rintro ⟨C, D, hC, hD, hCD, hsC, hsD⟩
  rcases (W⁄K).nonempty_basis_torsionBy N hN with ⟨b⟩
  rcases (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq_top C).mp hC with ⟨P, rfl⟩
  rcases (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq_top D).mp hD with ⟨Q, rfl⟩
  refine ⟨b.ofSupEqTop hCD.sup_eq_top,
    (W.range_modGaloisRepresentationGL_le_diagonalTorus_iff N _).mpr ?_⟩
  rw [b.ofSupEqTop_apply_zero, b.ofSupEqTop_apply_one]
  exact ⟨hC, hD, hCD, hsC, hsD⟩

/-- **`W` carries an `X_sp⁺(N)`-level structure if and only if its mod-`N` image lies, in some
basis of `E[N]`, in the extended split Cartan subgroup `Ns(N)`**, over a separably closed field in
which `N` is invertible. -/
lemma exists_isSplitCartanPlusLevelStructure_iff (hN : (N : K) ≠ 0) :
    (∃ C D, W.IsSplitCartanPlusLevelStructure (K := K) N C D) ↔ ∃ b,
    (W.modGaloisRepresentationGL (K := K) N b).range ≤
    extendedCartanSubgroup (Pi.basisFun (ZMod N) (Fin 2)) := by
  refine ⟨?_, fun ⟨b, hb⟩ ↦
    ⟨_, _, (W.range_modGaloisRepresentationGL_le_extendedCartanSubgroup_iff N b).mp hb⟩⟩
  rintro ⟨C, D, hC, hD, hCD, hs⟩
  rcases (W⁄K).nonempty_basis_torsionBy N hN with ⟨b⟩
  rcases (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq_top C).mp hC with ⟨P, rfl⟩
  rcases (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq_top D).mp hD with ⟨Q, rfl⟩
  refine ⟨b.ofSupEqTop hCD.sup_eq_top,
    (W.range_modGaloisRepresentationGL_le_extendedCartanSubgroup_iff N _).mpr ?_⟩
  rw [b.ofSupEqTop_apply_zero, b.ofSupEqTop_apply_one]
  exact ⟨hC, hD, hCD, hs⟩

/-- **`W` carries an `X_arith(N)`-level structure if and only if its mod-`N` image lies, in some
basis of `E[N]`, in the group `!![1, 0; 0, *]`**, over a separably closed field in which `N` is
invertible: the point and a generator of the kernel form a basis. -/
lemma exists_isArithLevelStructure_iff (hN : (N : K) ≠ 0) :
    (∃ C P, W.IsArithLevelStructure (K := K) N C P) ↔
    ∃ b, (W.modGaloisRepresentationGL (K := K) N b).range ≤ arithSubgroup (ZMod N) := by
  refine ⟨?_, fun ⟨b, hb⟩ ↦
    ⟨_, _, (W.range_modGaloisRepresentationGL_le_arithSubgroup_iff N b).mp hb⟩⟩
  rintro ⟨C, P, hP, hC, hcard, hsup, hfix, hs⟩
  rcases (W⁄K).nonempty_basis_torsionBy N hN with ⟨b⟩
  rcases (AddSubgroup.isAddCyclic_iff_exists_zmultiples_eq_top C).mp hC with ⟨Q, rfl⟩
  refine ⟨b.ofSupEqTop hsup, (W.range_modGaloisRepresentationGL_le_arithSubgroup_iff N _).mpr ?_⟩
  rw [b.ofSupEqTop_apply_zero, b.ofSupEqTop_apply_one]
  exact ⟨hP, hC, hcard, hsup, hfix, hs⟩

end WeierstrassCurve
