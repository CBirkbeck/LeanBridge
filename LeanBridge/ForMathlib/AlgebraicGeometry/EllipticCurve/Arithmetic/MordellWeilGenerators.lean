import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import TauCeti.AlgebraicGeometry.EllipticCurve.MordellWeil.PointModTorsion.Basic

/-!
# Mordell–Weil generators of an elliptic curve

The Mordell–Weil group `E(K)` of an elliptic curve over a number field is a finitely generated
abelian group (Tau Ceti's `WeierstrassCurve.Affine.fg_point_of_numberField`), so
`E(K) ≅ ℤ ^ r × E(K)_tors` for the rank `r` of `E(K)` and its finite torsion subgroup. The LMFDB
describes `E(K)` by a minimal `ℤ`-basis, its **Mordell–Weil generators** (LMFDB `ec.mw_generators`):
`r` **non-torsion generators**, points whose classes form a `ℤ`-basis of `E(K)/E(K)_tors`, and
**torsion generators**, a `ℤ`-basis of `E(K)_tors`: points which generate `E(K)_tors` and of which
an integral combination vanishes only when each of its terms does, so that `E(K)_tors` is the direct
sum of the cyclic subgroups they generate. The set is minimal: no `ℤ`-basis of `E(K)_tors` has
fewer points. This minimal number is that of the invariant factors of `E(K)_tors`, which is also
the minimal number of generators of `E(K)_tors`, and it is at most two, as `E(K)_tors` embeds in
`(ℚ/ℤ)²`; neither fact is formalised here.

The definitions are stated over any field `F`, for families of points indexed by `Fin r` and
`Fin s`.

## Main definitions

* `WeierstrassCurve.Affine.IsTorsionBasis`: the family `T` is a `ℤ`-basis of `E(F)_tors`.
* `WeierstrassCurve.Affine.IsMordellWeilGenerators`: the families `P` and `T` are Mordell–Weil
  generators, with non-torsion generators `P` and torsion generators `T` (LMFDB `ec.mw_generators`).

## Main results

* `WeierstrassCurve.Affine.IsMordellWeilGenerators.closure_eq_top`: Mordell–Weil generators
  generate `E(F)`.
* `WeierstrassCurve.Affine.IsMordellWeilGenerators.finrank_eq`: the number of non-torsion
  generators is the rank of `E(F)`.
* `WeierstrassCurve.Affine.exists_isMordellWeilGenerators`: when `E(F)` is finitely generated, for
  instance over a number field, it has Mordell–Weil generators.
-/

open Module Submodule

namespace WeierstrassCurve.Affine

variable {F : Type*} [Field F] [DecidableEq F] {W : Affine F} {r s : ℕ} {P : Fin r → W.Point}
  {T : Fin s → W.Point}

variable (T) in
/-- The family `T` of points of `W` is a **`ℤ`-basis of the torsion subgroup** `E(F)_tors`: the
`T j` generate `E(F)_tors`, and an integral combination of them vanishes only when each of its terms
does, so that `E(F)_tors` is the direct sum of the cyclic subgroups generated by the `T j`. -/
structure IsTorsionBasis : Prop where
  closure_eq_torsion : AddSubgroup.closure (Set.range T) = AddCommGroup.torsion W.Point
  zsmul_eq_zero_of_sum_eq_zero (b : Fin s → ℤ) : ∑ j, b j • T j = 0 → ∀ j, b j • T j = 0

variable (P T) in
/-- The families `P` and `T` of points of `W` are **Mordell–Weil generators** of `E(F)` (LMFDB
`ec.mw_generators`), with **non-torsion generators** `P` and **torsion generators** `T`: the
classes of the `P i` form a `ℤ`-basis of `E(F)/E(F)_tors`, the `T j` form a `ℤ`-basis of the
torsion subgroup `E(F)_tors` (`WeierstrassCurve.Affine.IsTorsionBasis`), and no `ℤ`-basis of
`E(F)_tors` has fewer than `s` points. Together the `P i` and the `T j` thus form a minimal
`ℤ`-basis of `E(F)`. -/
structure IsMordellWeilGenerators : Prop where
  linearIndependent : LinearIndependent ℤ ((torsion ℤ W.Point).mkQ ∘ P)
  span_eq_top : span ℤ (Set.range ((torsion ℤ W.Point).mkQ ∘ P)) = ⊤
  isTorsionBasis : IsTorsionBasis T
  le_of_isTorsionBasis (t : ℕ) (T' : Fin t → W.Point) : IsTorsionBasis T' → s ≤ t

lemma IsTorsionBasis.isOfFinAddOrder (h : IsTorsionBasis T) (j : Fin s) :
    IsOfFinAddOrder (T j) := by
  rw [← AddCommGroup.mem_torsion, ← h.closure_eq_torsion]
  exact AddSubgroup.subset_closure ⟨j, rfl⟩

namespace IsMordellWeilGenerators

variable (h : IsMordellWeilGenerators P T)

include h

lemma not_isOfFinAddOrder (i : Fin r) : ¬IsOfFinAddOrder (P i) := by
  intro hP
  refine h.linearIndependent.ne_zero i ?_
  rw [Function.comp_apply, ← LinearMap.mem_ker, ker_mkQ, ← mem_toAddSubgroup, torsion_int]
  exact hP

/-- **The number of non-torsion generators is the rank** of `E(F)/E(F)_tors`, that of `E(F)`. -/
lemma finrank_eq : finrank ℤ (PointModTorsion W) = r := by
  rw [finrank_eq_card_basis (Basis.mk h.linearIndependent h.span_eq_top.ge), Fintype.card_fin]

/-- **Mordell–Weil generators generate** `E(F)`. -/
lemma closure_eq_top : AddSubgroup.closure (Set.range P ∪ Set.range T) = ⊤ := by
  refine eq_top_iff.mpr fun Q _ ↦ ?_
  rcases (mem_span_range_iff_exists_fun ℤ).mp
    (h.span_eq_top ▸ mem_top : (torsion ℤ W.Point).mkQ Q ∈ _) with ⟨c, hc⟩
  have hQ : Q - ∑ i, c i • P i ∈ AddCommGroup.torsion W.Point := by
    rw [← torsion_int, mem_toAddSubgroup, ← ker_mkQ (torsion ℤ W.Point), LinearMap.mem_ker,
      map_sub, map_sum, ← hc]
    simp
  rw [← sub_add_cancel Q (∑ i, c i • P i)]
  exact add_mem (AddSubgroup.closure_mono Set.subset_union_right
    (h.isTorsionBasis.closure_eq_torsion ▸ hQ))
    (sum_mem fun i _ ↦ zsmul_mem (AddSubgroup.subset_closure (Or.inl ⟨i, rfl⟩)) _)

end IsMordellWeilGenerators

private lemma exists_independent_closure_eq_top (G : Type*) [AddCommGroup G] [Finite G] : ∃ (s : ℕ)
    (g : Fin s → G), AddSubgroup.closure (Set.range g) = ⊤ ∧ ∀ b : Fin s → ℤ, ∑ j, b j • g j = 0 → ∀
    j, b j • g j = 0 := by
  classical
  rcases AddCommGroup.equiv_directSum_zmod_of_finite' G with ⟨ι, _, n, -, ⟨e⟩⟩
  let σ : Fin (Fintype.card ι) ≃ ι := (Fintype.equivFin ι).symm
  refine ⟨Fintype.card ι, fun j ↦ e.symm (DirectSum.of _ (σ j) 1), eq_top_iff.mpr fun x _ ↦ ?_,
    fun b hb j ↦ ?_⟩
  · rw [← e.symm_apply_apply x, ← DirectSum.sum_univ_of (e x), map_sum]
    refine sum_mem fun i _ ↦ ?_
    rw [← ZMod.intCast_zmod_cast (e x i), ← zsmul_one, map_zsmul, map_zsmul]
    refine zsmul_mem (AddSubgroup.subset_closure ?_) _
    exact ⟨σ.symm i,
      congrArg (fun k ↦ e.symm (DirectSum.of (fun i ↦ ZMod (n i)) k 1)) (σ.apply_symm_apply i)⟩
  · have h : ∑ x, b x • DirectSum.of (fun i ↦ ZMod (n i)) (σ x) 1 = 0 := by
      simpa using congrArg e hb
    have hj : ∑ x, (b x • DirectSum.of (fun i ↦ ZMod (n i)) (σ x) 1) (σ j) = 0 := by
      rw [← DirectSum.sum_apply, h, DirectSum.zero_apply]
    rw [Finset.sum_eq_single j (fun x _ hx ↦ ?_) (by simp), DFinsupp.smul_apply,
      DirectSum.of_eq_same] at hj
    · dsimp only
      rw [← map_zsmul, ← map_zsmul, hj, map_zero, map_zero]
    · rw [DFinsupp.smul_apply, DirectSum.of_eq_of_ne _ _ _ (σ.injective.ne hx.symm), smul_zero]

lemma exists_isTorsionBasis [Module.Finite ℤ W.Point] :
    ∃ (s : ℕ) (T : Fin s → W.Point), IsTorsionBasis T := by
  have : Finite (torsion ℤ W.Point) := finite_of_fg_torsion _ torsion_isTorsion
  have : Finite (AddCommGroup.torsion W.Point) := by
    rw [← torsion_int]
    exact this
  rcases exists_independent_closure_eq_top (AddCommGroup.torsion W.Point) with ⟨s, g, hg, hind⟩
  refine ⟨s, fun j ↦ g j, ⟨le_antisymm ((AddSubgroup.closure_le _).mpr
    (Set.range_subset_iff.mpr fun j ↦ (g j).2)) fun x hx ↦ ?_, fun b hb j ↦ ?_⟩⟩
  · have hx' : (⟨x, hx⟩ : AddCommGroup.torsion W.Point) ∈ AddSubgroup.closure (Set.range g) :=
      hg ▸ AddSubgroup.mem_top _
    have hmap :
        x ∈ (AddSubgroup.closure (Set.range g)).map (AddCommGroup.torsion W.Point).subtype :=
      AddSubgroup.mem_map_of_mem _ hx'
    rwa [AddMonoidHom.map_closure, ← Set.range_comp] at hmap
  · have hj : b j • g j = 0 := hind b (Subtype.ext (by simpa using hb)) j
    simpa using congrArg Subtype.val hj

/-- **Existence of Mordell–Weil generators**: if `E(F)` is finitely generated, for instance over a
number field by the Mordell–Weil theorem, then it has Mordell–Weil generators. -/
lemma exists_isMordellWeilGenerators [Module.Finite ℤ W.Point] :
    ∃ (r s : ℕ) (P : Fin r → W.Point) (T : Fin s → W.Point), IsMordellWeilGenerators P T := by
  classical
  have : Module.Free ℤ (PointModTorsion W) := free_of_finite_type_torsion_free'
  choose P hP using fun i ↦ (torsion ℤ W.Point).mkQ_surjective (finBasis ℤ (PointModTorsion W) i)
  have hP' : (torsion ℤ W.Point).mkQ ∘ P = finBasis ℤ (PointModTorsion W) := funext hP
  have hex : ∃ (t : ℕ) (T : Fin t → W.Point), IsTorsionBasis T := exists_isTorsionBasis
  rcases Nat.find_spec hex with ⟨T, hT⟩
  refine ⟨_, Nat.find hex, P, T, ⟨?_, ?_, hT, fun t T' hT' ↦ Nat.find_min' hex ⟨T', hT'⟩⟩⟩
  · rw [hP']
    exact (finBasis ℤ (PointModTorsion W)).linearIndependent
  · rw [hP', (finBasis ℤ (PointModTorsion W)).span_eq]

end WeierstrassCurve.Affine
