import TauCeti.AlgebraicGeometry.EllipticCurve.MordellWeil.FinitelyGenerated
import TauCeti.AlgebraicGeometry.EllipticCurve.MordellWeil.PointModTorsion.Basic

/-!
# Points modulo torsion in rank zero

Let `W` be an elliptic curve over a number field `K`. The group `E(K)/E(K)_tors` (Tau Ceti's
`WeierstrassCurve.Affine.PointModTorsion`) is finitely generated by the Mordell–Weil theorem and
torsion-free, hence free; so when the rank of `E(K)` is `0` it is trivial
(`WeierstrassCurve.Affine.subsingleton_pointModTorsion_of_finrank_eq_zero`), as the LMFDB knowl
`ec.regulator` says in its rank-zero case.

## Main results

* `WeierstrassCurve.Affine.subsingleton_pointModTorsion_of_finrank_eq_zero` (LMFDB
  `ec.regulator`): in rank zero, `E(K)/E(K)_tors = 0`.
-/

open Module

namespace WeierstrassCurve.Affine

variable {K : Type*} [Field K] [NumberField K] [DecidableEq K] (W : Affine K) [W.IsElliptic]

/-- **In rank zero, `E(K)/E(K)_tors` is trivial** (LMFDB `ec.regulator`): a finitely generated
torsion-free abelian group of rank zero is zero. -/
lemma subsingleton_pointModTorsion_of_finrank_eq_zero (h : finrank ℤ (PointModTorsion W) = 0) :
    Subsingleton (PointModTorsion W) :=
  (finrank_eq_zero_iff_of_free ℤ _).mp h

end WeierstrassCurve.Affine
