import LeanBridge.ForMathlib.AlgebraicGeometry.Variety.LinearSystemMap
import LeanBridge.ForMathlib.AlgebraicGeometry.Variety.PluricanonicalMap
import TauCeti.AlgebraicGeometry.LineBundle.TensorProduct
import TauCeti.AlgebraicGeometry.Modules.Differentials.Rank
import TauCeti.AlgebraicGeometry.Morphisms.Smooth.RelativeDimension
import TauCeti.AlgebraicGeometry.VectorBundle.Determinant

/-!
# The Kodaira dimension through the pluricanonical rational maps

Let `X` be an integral scheme over a field `k` whose canonical sheaf `K` is invertible, as when `X`
is smooth over `k`, for instance a nonsingular variety. The global sections of `K^{⊗d}` define the
`d`-th pluricanonical map, the rational map `φ_d : X ⇢ ℙ(H⁰(X, K^{⊗d}))`, and the Kodaira dimension
(LMFDB `ag.kodaira_dimension`) is the supremum over `d ≥ 1` of the dimensions of the images
`φ_d(X)`, with `⊥` for the LMFDB's `-1`, when all these images are empty. The definitions use all of
`H⁰(X, K^{⊗d})`, finite-dimensional or not: no finiteness is assumed in them.

The dimension of `φ_d(X)` is the transcendence degree of the subfield of `k(X)` generated by the
ratios of the global sections of `K^{⊗d}`, when `H⁰(X, K^{⊗d})` is finite-dimensional, so that this
Kodaira dimension agrees with `AlgebraicGeometry.Scheme.pluricanonicalKodairaDimension`. That
finiteness is classical for `X` proper, the knowl's implicit assumption, as it writes
`ℙ(H⁰(X, K^{⊗d})) ≅ ℙ^{P_d - 1}`. It is not proved here: it is a hypothesis of the comparison only.

Iitaka's theorem, which identifies the Kodaira dimension with the growth order of the plurigenera
(`AlgebraicGeometry.Scheme.kodairaDimension`), is not part of the knowl and is not proved.

## Main definitions

* `AlgebraicGeometry.Scheme.pluricanonicalRationalMap` (LMFDB `ag.kodaira_dimension`): the rational
  map `φ_d`.
* `AlgebraicGeometry.Scheme.pluricanonicalImage`: the image `φ_d(X)`.
* `AlgebraicGeometry.Scheme.pluricanonicalImageDimension`: its dimension.
* `AlgebraicGeometry.Scheme.kodairaDimensionOfPluricanonicalMaps` (LMFDB `ag.kodaira_dimension`):
  the Kodaira dimension `κ(X) = sup_d dim φ_d(X)`.

## Main results

* `AlgebraicGeometry.Scheme.isInvertible_canonicalSheaf_of_smooth`: the canonical sheaf of a smooth
  irreducible scheme is invertible.
* `AlgebraicGeometry.Scheme.kodairaDimensionOfPluricanonicalMaps_eq_bot_iff`: `κ(X) = ⊥` exactly
  when `K^{⊗d}` has no nonzero global section for every `d ≥ 1`.
* `AlgebraicGeometry.Scheme.pluricanonicalImageDimension_eq`: `dim φ_d(X)` is the transcendence
  degree of the field of ratios of the global sections of `K^{⊗d}`.
* `AlgebraicGeometry.Scheme.kodairaDimensionOfPluricanonicalMaps_eq`: this Kodaira dimension is
  `AlgebraicGeometry.Scheme.pluricanonicalKodairaDimension`.
-/

open CategoryTheory TauCeti AlgebraicGeometry MonoidalCategory

namespace AlgebraicGeometry.Scheme

universe u

variable (k : Type u) [Field k] (X : Scheme.{u}) [X.Over (Spec (.of k))]

/-- **The canonical sheaf of a smooth irreducible scheme is invertible.** -/
lemma isInvertible_canonicalSheaf_of_smooth (n : ℕ) [IrreducibleSpace X]
    [SmoothOfRelativeDimension n (X ↘ Spec (.of k))] :
    SheafOfModules.isInvertible X (X.canonicalSheaf k) := by
  have hn : ((topologicalKrullDim X).unbotD 0).toNat = n := by
    rw [topologicalKrullDim_eq_of_smoothOfRelativeDimension (n := n) (X ↘ Spec (.of k))]
    rfl
  have : Smooth (X ↘ Spec (.of k)) := SmoothOfRelativeDimension.smooth n (X ↘ Spec (.of k))
  let E : FiniteLocallyFreeSheaf.FixedRank X n :=
    ⟨FiniteLocallyFreeSheaf.relativeDifferentials k X,
      FiniteLocallyFreeSheaf.rank_relativeDifferentials_apply k n⟩
  have h : ((FiniteLocallyFreeSheaf.determinant X n).obj E).obj = X.canonicalSheaf k := by
    rw [canonicalSheaf, hn]
    rfl
  exact h ▸ inferInstance

namespace Modules

variable {X} (M : X.Modules) [SheafOfModules.isInvertible X M]

instance (d : ℕ) : SheafOfModules.isInvertible X (M.tensorPow d) := by
  induction d with
  | zero =>
    exact ObjectProperty.prop_of_iso _ (InvertibleSheaf.trivialObjIsoUnit X)
      (inferInstance : SheafOfModules.isInvertible X (InvertibleSheaf.trivial X).obj)
  | succ d ih =>
    exact ObjectProperty.prop_of_iso _
      (InvertibleSheaf.tensorProductObjIso ⟨M.tensorPow d, ih⟩ ⟨M, inferInstance⟩)
      (inferInstance : SheafOfModules.isInvertible X (InvertibleSheaf.tensorProduct
        ⟨M.tensorPow d, ih⟩ ⟨M, inferInstance⟩).obj)

end Modules

variable (d : ℕ)

lemma plurigenus_eq_zero_iff [Module.Finite k Γ((X.canonicalSheaf k).tensorPow d, ⊤)] :
    X.plurigenus k d = 0 ↔ Subsingleton Γ((X.canonicalSheaf k).tensorPow d, ⊤) := by
  rw [plurigenus, (Modules.cohomologyZeroBaseLinearEquiv k X _).finrank_eq, Module.finrank_zero_iff]

variable [IsIntegral X]

lemma pluricanonicalImageDim_eq_zero [Subsingleton Γ((X.canonicalSheaf k).tensorPow d, ⊤)] :
    X.pluricanonicalImageDim k d = 0 := by
  have h : X.pluricanonicalImageField k d = ⊥ := by
    refine (IntermediateField.adjoin_le_iff.mpr ?_).antisymm bot_le
    rintro a ⟨s, t, ht, -⟩
    exact (ht (by rw [Subsingleton.elim t 0, map_zero])).elim
  rw [pluricanonicalImageDim, h, trdeg_eq_zero, map_zero]

variable [SheafOfModules.isInvertible X (X.canonicalSheaf k)]

/-- The `d`-th **pluricanonical map** `φ_d : X ⇢ ℙ(H⁰(X, K^{⊗d}))` (LMFDB `ag.kodaira_dimension`) of
an integral scheme `X` over a field `k` whose canonical sheaf `K` is invertible, as when `X` is
smooth (`AlgebraicGeometry.Scheme.isInvertible_canonicalSheaf_of_smooth`): the rational map defined
by the global sections of `K^{⊗d}`, which exists when `K^{⊗d}` has a nonzero global section `t` and
does not depend on it (`AlgebraicGeometry.Scheme.Modules.sectionsRationalMap_eq`). -/
noncomputable def pluricanonicalRationalMap {t : Γ((X.canonicalSheaf k).tensorPow d, ⊤)}
    (ht : t ≠ 0) : X ⤏ ((X.canonicalSheaf k).tensorPow d).SectionsProj k :=
  Modules.sectionsRationalMap _ k ht

/-- The **image `φ_d(X)` of the `d`-th pluricanonical map** (LMFDB `ag.kodaira_dimension`), a closed
subset of `ℙ(H⁰(X, K^{⊗d}))`: the closure of the image of the rational map `φ_d`, empty if `K^{⊗d}`
has no nonzero global sections. -/
noncomputable def pluricanonicalImage : Set (((X.canonicalSheaf k).tensorPow d).SectionsProj k) :=
  Modules.sectionsImage _ k

/-- The **dimension of the image `φ_d(X)` of the `d`-th pluricanonical map** (LMFDB
`ag.kodaira_dimension`), with `⊥` for the empty image. -/
noncomputable def pluricanonicalImageDimension : WithBot ℕ∞ :=
  topologicalKrullDim (pluricanonicalImage k X d)

/-- The **Kodaira dimension** `κ(X)` (LMFDB `ag.kodaira_dimension`) of an integral scheme `X` over a
field `k` with invertible canonical sheaf, typically a smooth projective variety, as the knowl
defines it: the supremum over `d ≥ 1` of the dimensions of the images `φ_d(X)` of the pluricanonical
maps. It is `⊥`, recorded by the LMFDB as `-1`, exactly when `K^{⊗d}` has no nonzero global section
for every `d ≥ 1`, since `φ_d(X)` is then empty
(`AlgebraicGeometry.Scheme.kodairaDimensionOfPluricanonicalMaps_eq_bot_iff`). The knowl lets `d`
range over `ℤ≥0`, but `P₀ = h⁰(X, 𝒪_X) ≥ 1` for a nonempty proper variety, so its condition that
`P_d = 0` for all `d` is read for `d ≥ 1`. -/
noncomputable def kodairaDimensionOfPluricanonicalMaps : WithBot ℕ∞ :=
  ⨆ (n : ℕ) (_ : 1 ≤ n), pluricanonicalImageDimension k X n

lemma pluricanonicalImageDimension_eq_bot [Subsingleton Γ((X.canonicalSheaf k).tensorPow d, ⊤)] :
    pluricanonicalImageDimension k X d = ⊥ := by
  rw [pluricanonicalImageDimension, pluricanonicalImage, Modules.sectionsImage_eq_empty]
  refine Order.krullDim_eq_bot_iff.mpr ⟨fun Z ↦ ?_⟩
  rcases Z.isIrreducible'.nonempty with ⟨x, -⟩
  exact x.2.elim

lemma pluricanonicalImageDimension_ne_bot {t : Γ((X.canonicalSheaf k).tensorPow d, ⊤)}
    (ht : t ≠ 0) : pluricanonicalImageDimension k X d ≠ ⊥ := by
  rw [pluricanonicalImageDimension, pluricanonicalImage, Modules.sectionsImage_eq_closure _ k ht]
  refine Order.krullDim_eq_bot_iff.not.mpr (not_isEmpty_iff.mpr ?_)
  exact ⟨⟨closure {⟨_, subset_closure rfl⟩}, isIrreducible_singleton.closure, isClosed_closure⟩⟩

/-- **The Kodaira dimension is `⊥`, the LMFDB's `-1`, exactly when `K^{⊗d}` has no nonzero global
section for every `d ≥ 1`.** -/
lemma kodairaDimensionOfPluricanonicalMaps_eq_bot_iff :
    kodairaDimensionOfPluricanonicalMaps k X = ⊥ ↔
      ∀ n, 1 ≤ n → Subsingleton Γ((X.canonicalSheaf k).tensorPow n, ⊤) := by
  refine ⟨fun h n hn ↦ ?_, fun h ↦ le_bot_iff.mp (iSup₂_le fun n hn ↦ ?_)⟩
  · refine not_nontrivial_iff_subsingleton.mp fun hn₀ ↦ ?_
    rcases exists_ne (0 : Γ((X.canonicalSheaf k).tensorPow n, ⊤)) with ⟨t, ht⟩
    exact pluricanonicalImageDimension_ne_bot k X n ht
      (le_bot_iff.mp (h ▸ le_iSup₂_of_le n hn le_rfl))
  · have : Subsingleton Γ((X.canonicalSheaf k).tensorPow n, ⊤) := h n hn
    exact (pluricanonicalImageDimension_eq_bot k X n).le

/-- **The dimension of the image of the `d`-th pluricanonical map is the transcendence degree of the
field generated by the ratios of the global sections of `K^{⊗d}`**, the dimension
`AlgebraicGeometry.Scheme.pluricanonicalImageDim`, when `H⁰(X, K^{⊗d})` is finite-dimensional and
nonzero. -/
lemma pluricanonicalImageDimension_eq [Module.Finite k Γ((X.canonicalSheaf k).tensorPow d, ⊤)]
    {t : Γ((X.canonicalSheaf k).tensorPow d, ⊤)} (ht : t ≠ 0) :
    pluricanonicalImageDimension k X d = X.pluricanonicalImageDim k d :=
  Modules.topologicalKrullDim_sectionsImage _ k ht

/-- **The Kodaira dimension defined through the images of the pluricanonical maps is the one defined
through the fields of ratios of pluricanonical sections**, when the spaces `H⁰(X, K^{⊗d})` are
finite-dimensional over `k`, as they are for `X` proper. -/
lemma kodairaDimensionOfPluricanonicalMaps_eq
    [∀ d : ℕ, Module.Finite k Γ((X.canonicalSheaf k).tensorPow d, ⊤)] :
    kodairaDimensionOfPluricanonicalMaps k X = X.pluricanonicalKodairaDimension k := by
  unfold pluricanonicalKodairaDimension
  split_ifs with h
  · refine le_bot_iff.mp (iSup₂_le fun n hn ↦ ?_)
    have : Subsingleton Γ((X.canonicalSheaf k).tensorPow n, ⊤) :=
      (plurigenus_eq_zero_iff k X n).mp (h n hn)
    exact (pluricanonicalImageDimension_eq_bot k X n).le
  · refine le_antisymm (iSup₂_le fun n hn ↦ ?_) ?_
    · rcases subsingleton_or_nontrivial Γ((X.canonicalSheaf k).tensorPow n, ⊤) with hn₀ | hn₀
      · exact (pluricanonicalImageDimension_eq_bot k X n).le.trans bot_le
      · rcases exists_ne (0 : Γ((X.canonicalSheaf k).tensorPow n, ⊤)) with ⟨t, ht⟩
        rw [pluricanonicalImageDimension_eq k X n ht]
        exact WithBot.coe_le_coe.mpr (le_iSup₂_of_le n hn le_rfl)
    · push Not at h
      rcases h with ⟨n₀, hn₀, hP⟩
      have hn₁ : Nontrivial Γ((X.canonicalSheaf k).tensorPow n₀, ⊤) :=
        not_subsingleton_iff_nontrivial.mp fun hs ↦ hP ((plurigenus_eq_zero_iff k X n₀).mpr hs)
      rcases exists_ne (0 : Γ((X.canonicalSheaf k).tensorPow n₀, ⊤)) with ⟨t, ht⟩
      have h₀ : pluricanonicalImageDimension k X n₀ ≤ kodairaDimensionOfPluricanonicalMaps k X :=
        le_iSup₂_of_le n₀ hn₀ le_rfl
      rw [pluricanonicalImageDimension_eq k X n₀ ht] at h₀
      rcases WithBot.ne_bot_iff_exists.mp (ne_bot_of_le_ne_bot WithBot.coe_ne_bot h₀) with ⟨c, hc⟩
      rw [← hc]
      refine WithBot.coe_le_coe.mpr (iSup₂_le fun n hn ↦ ?_)
      rcases subsingleton_or_nontrivial Γ((X.canonicalSheaf k).tensorPow n, ⊤) with hn₂ | hn₂
      · rw [pluricanonicalImageDim_eq_zero k X n]
        exact zero_le
      · rcases exists_ne (0 : Γ((X.canonicalSheaf k).tensorPow n, ⊤)) with ⟨t', ht'⟩
        refine WithBot.coe_le_coe.mp ?_
        rw [hc, ← pluricanonicalImageDimension_eq k X n ht']
        exact le_iSup₂_of_le n hn le_rfl

end AlgebraicGeometry.Scheme
