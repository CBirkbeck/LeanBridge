import LeanBridge.ForMathlib.AlgebraicGeometry.Scheme.PointClosure
import Mathlib.AlgebraicGeometry.Birational.RationalMap
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import TauCeti.AlgebraicGeometry.LineBundle.Germ
import TauCeti.AlgebraicGeometry.Modules.Stalk
import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.ChartEquality
import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.GlobalCoordinates
import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.Naturality
import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.SymmetricAlgebra
import TauCeti.AlgebraicGeometry.Scheme.FunctionField

/-!
# The rational map defined by the global sections of a line bundle

Let `M` be an invertible sheaf on an integral scheme `X` over a field `k`, and let
`ℙ(H⁰(X, M)) = Proj (Sym_k H⁰(X, M))` be the projective space with the global sections of `M` as its
homogeneous coordinates. A nonzero global section `t` gives a ratio `s / t` in the function field
`k(X)` for every global section `s`, the rational function `a` with `s = a t` at the generic point.
These ratios are regular on a dense open subset of `X`, on which they are homogeneous coordinates of
a morphism to `ℙ(H⁰(X, M))`, by Mathlib's `AlgebraicGeometry.Proj.fromOfGlobalSections`. This is the
rational map `X ⇢ ℙ(H⁰(X, M))`, `x ↦ [s₀(x) : ⋯ : s_n(x)]`, and it does not depend on `t`.

The closure of its image is the closure of the image `ξ` of the generic point of `X`, and the
residue field of `ξ` is the subfield of `k(X)` generated over `k` by the ratios of the global
sections. So when `H⁰(X, M)` is finite-dimensional over `k`, the dimension of the image is the
transcendence degree of the field of ratios, by
`AlgebraicGeometry.Scheme.topologicalKrullDim_closure_singleton`.

## Main definitions

* `AlgebraicGeometry.Scheme.RationalMap.imageClosure`: the image of a rational map from an
  irreducible scheme, as a closed subset of the target.
* `AlgebraicGeometry.Scheme.Modules.sectionRatio`: the ratio `s / t` of two global sections.
* `AlgebraicGeometry.Scheme.Modules.SectionsProj`: the projective space `ℙ(H⁰(X, M))`.
* `AlgebraicGeometry.Scheme.Modules.sectionsRationalMap`: the rational map `X ⇢ ℙ(H⁰(X, M))`.
* `AlgebraicGeometry.Scheme.Modules.sectionsImage`: the image of this rational map.
* `AlgebraicGeometry.Scheme.Modules.sectionsImageField`: the field generated by the ratios of the
  global sections.

## Main results

* `AlgebraicGeometry.Scheme.RationalMap.imageClosure_toRationalMap`: the image of a rational map is
  the closure of the image of any partial map representing it.
* `AlgebraicGeometry.Scheme.Modules.sectionsGenericMap_eq` and
  `AlgebraicGeometry.Scheme.Modules.sectionsRationalMap_eq`: the rational map does not depend on the
  nonzero section `t`.
* `AlgebraicGeometry.Scheme.Modules.fieldRange_sectionsGenericMap`: the residue field of the image
  of the generic point is the field of ratios.
* `AlgebraicGeometry.Scheme.Modules.trdeg_residueField_sectionsGenericMap`: the two fields have the
  same transcendence degree over `k`.
* `AlgebraicGeometry.Scheme.Modules.topologicalKrullDim_sectionsImage`: the dimension of the image
  is the transcendence degree of the field of ratios when `H⁰(X, M)` is finite-dimensional.
-/

open CategoryTheory TauCeti AlgebraicGeometry Opposite HomogeneousLocalization SymmetricAlgebra

universe u

namespace AlgebraicGeometry.Scheme

variable {X Y : Scheme.{u}}

lemma topIso_inv_fromSpecStalkOfMem_appTop (W : X.Opens) (x : X) (hx : x ∈ W) :
    W.topIso.inv ≫ (W.fromSpecStalkOfMem x hx).appTop =
      X.presheaf.germ W x hx ≫ (ΓSpecIso (X.presheaf.stalk x)).inv := by
  have h : W.fromSpecStalkOfMem x hx ≫ W.toSpecΓ = Spec.map (X.presheaf.germ W x hx) :=
    W.fromSpecStalkOfMem_toSpecΓ x hx
  rw [Opens.toSpecΓ, ← Category.assoc, toSpecΓ_naturality, Category.assoc, ← Spec.map_comp,
    ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp] at h
  rw [← Spec.map_injective h, Category.assoc, Iso.hom_inv_id, Category.comp_id]

namespace RationalMap

/-- The **image** of a rational map `f : X ⇢ Y` from an irreducible scheme: the closure in `Y` of
the image of `f`, that is, of the image under any partial map representing `f`
(`AlgebraicGeometry.Scheme.RationalMap.imageClosure_toRationalMap`). -/
noncomputable def imageClosure [IrreducibleSpace X] (f : X ⤏ Y) : Set Y :=
  closure (Set.range f.fromFunctionField)

/-- **The image of a rational map is the closure of the image of any partial map representing
it.** -/
lemma imageClosure_toRationalMap [IrreducibleSpace X] (g : X.PartialMap Y) :
    g.toRationalMap.imageClosure = closure (Set.range g.hom) := by
  have hη : genericPoint X ∈ g.domain :=
    (genericPoint_specializes _).mem_open g.domain.2 g.dense_domain.nonempty.choose_spec
  let h : Spec X.functionField ⟶ g.domain := g.domain.fromSpecStalkOfMem (genericPoint X) hη
  have hd : Dense (Set.range h) := by
    have hs : Dense ({genericPoint X} : Set X) :=
      dense_iff_closure_eq.mpr (genericPoint_spec X).def
    refine (hs.preimage g.domain.ι.isOpenEmbedding.isOpenMap).mono fun y hy ↦
      ⟨IsLocalRing.closedPoint _, g.domain.ι.isOpenEmbedding.injective ?_⟩
    have h₁ : (h ≫ g.domain.ι) (IsLocalRing.closedPoint X.functionField) =
        X.fromSpecStalk _ (IsLocalRing.closedPoint X.functionField) := by
      rw [Opens.fromSpecStalkOfMem_ι]
    exact (h₁.trans Scheme.fromSpecStalk_closedPoint).trans (Set.mem_singleton_iff.mp hy).symm
  have hr : Set.range g.toRationalMap.fromFunctionField = g.hom '' Set.range h := by
    rw [← Set.range_comp]
    rfl
  rw [imageClosure, hr]
  exact (closure_mono (Set.image_subset_range _ _)).antisymm
    (closure_minimal (g.hom.continuous.range_subset_closure_image_dense hd) isClosed_closure)

lemma imageClosure_eq_closure_singleton [IsIntegral X] (f : X ⤏ Y) :
    f.imageClosure = closure {f.fromFunctionField (IsLocalRing.closedPoint X.functionField)} := by
  refine congrArg closure (Set.ext fun y ↦ ⟨?_, ?_⟩)
  · rintro ⟨p, rfl⟩
    rw [Subsingleton.elim p (IsLocalRing.closedPoint X.functionField)]
    rfl
  · rintro rfl
    exact ⟨_, rfl⟩

end RationalMap

end AlgebraicGeometry.Scheme

namespace TauCeti.SymmetricAlgebra

lemma ι_mem_irrelevant {V : Type*} (k : Type*) [Field k] [AddCommGroup V] [Module k V] (s : V) :
    SymmetricAlgebra.ι k V s ∈ (HomogeneousIdeal.irrelevant (homogeneousSubmodule k V)).toIdeal :=
  HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos (ι_mem_homogeneousSubmodule k V s)

end TauCeti.SymmetricAlgebra

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}} [IsIntegral X] (M : X.Modules) [SheafOfModules.isInvertible X M]
  {t : Γ(M, ⊤)}

lemma germ_ne_zero (ht : t ≠ 0) : M.presheaf.germ ⊤ (genericPoint X) trivial t ≠ 0 := fun h ↦
  ht <| InvertibleSheaf.germ_injective_of_isIntegral ⟨M, inferInstance⟩ (genericPoint X) trivial <|
    h.trans (map_zero _).symm

lemma exists_germ_eq_smul_germ (ht : t ≠ 0) (s : Γ(M, ⊤)) : ∃ a : X.functionField,
    M.presheaf.germ ⊤ (genericPoint X) trivial s =
      a • M.presheaf.germ ⊤ (genericPoint X) trivial t := by
  rcases exists_mem_trivialization M (genericPoint X) with ⟨U, e, hU⟩
  let g : M.presheaf.stalk (genericPoint X) :=
    M.presheaf.germ U (genericPoint X) hU (trivializationGenerator M e)
  have key (s : Γ(M, ⊤)) :
      ∃ c : X.functionField, M.presheaf.germ ⊤ (genericPoint X) trivial s = c • g := by
    let s' : Γ(M, U) := M.presheaf.map (homOfLE le_top : U ⟶ ⊤).op s
    refine ⟨X.presheaf.germ U (genericPoint X) hU (trivializationCoordinate M e (𝟙 U) s'), ?_⟩
    have hs : s' = trivializationCoordinate M e (𝟙 U) s' •
        M.presheaf.map (𝟙 U).op (trivializationGenerator M e) :=
      eq_trivializationCoordinate_smul_map_trivializationGenerator M e (𝟙 U) s'
    rw [op_id, M.presheaf.map_id, ConcreteCategory.id_apply] at hs
    rw [← germ_smul, ← hs]
    exact (M.presheaf.germ_res_apply (homOfLE le_top : U ⟶ ⊤) (genericPoint X) hU s).symm
  rcases key t with ⟨c, hc⟩
  rcases key s with ⟨c', hc'⟩
  have hc₀ : c ≠ 0 := fun h ↦ germ_ne_zero M ht <| by
    rw [hc, h, zero_smul]
  exact ⟨c' / c, by rw [hc, hc', smul_smul, div_mul_cancel₀ _ hc₀]⟩

variable (k : Type u) [Field k] [X.Over (Spec (.of k))] (ht : t ≠ 0) (s : Γ(M, ⊤))

/-- The **ratio `s / t`** of two global sections of an invertible sheaf `M` on an integral scheme,
with `t ≠ 0`: the rational function `a` with `s = a t` at the generic point. -/
noncomputable def sectionRatio : X.functionField :=
  (exists_germ_eq_smul_germ M ht s).choose

lemma germ_eq_sectionRatio_smul : M.presheaf.germ ⊤ (genericPoint X) trivial s =
    sectionRatio M ht s • M.presheaf.germ ⊤ (genericPoint X) trivial t :=
  (exists_germ_eq_smul_germ M ht s).choose_spec

lemma sectionRatio_eq_iff (a : X.functionField) : sectionRatio M ht s = a ↔
    M.presheaf.germ ⊤ (genericPoint X) trivial s =
      a • M.presheaf.germ ⊤ (genericPoint X) trivial t := by
  refine ⟨fun h ↦ h ▸ germ_eq_sectionRatio_smul M ht s, fun h ↦ ?_⟩
  have h₀ : (sectionRatio M ht s - a) • M.presheaf.germ ⊤ (genericPoint X) trivial t = 0 := by
    rw [sub_smul, ← germ_eq_sectionRatio_smul, h, sub_self]
  exact sub_eq_zero.mp <| (smul_eq_zero.mp h₀).resolve_right (germ_ne_zero M ht)

@[simp]
lemma sectionRatio_self : sectionRatio M ht t = 1 :=
  (sectionRatio_eq_iff M ht t 1).mpr (one_smul _ _).symm

variable {s} in
lemma sectionRatio_ne_zero (hs : s ≠ 0) : sectionRatio M ht s ≠ 0 :=
  fun h ↦ germ_ne_zero M hs <| by
    rw [germ_eq_sectionRatio_smul M ht s, h, zero_smul]

variable {t' : Γ(M, ⊤)} (ht' : t' ≠ 0)

lemma sectionRatio_mul_sectionRatio :
    sectionRatio M ht' s * sectionRatio M ht t' = sectionRatio M ht s := by
  refine ((sectionRatio_eq_iff M ht s _).mpr ?_).symm
  rw [mul_smul, ← germ_eq_sectionRatio_smul, ← germ_eq_sectionRatio_smul]

/-- The ratio `s ↦ s / t`, as a `k`-linear map from the global sections of `M` to `k(X)`. -/
noncomputable def sectionRatioₗ : Γ(M, ⊤) →ₗ[k] X.functionField where
  toFun := sectionRatio M ht
  map_add' s s' := by
    rw [sectionRatio_eq_iff, add_smul, ← germ_eq_sectionRatio_smul, ← germ_eq_sectionRatio_smul,
      map_add]
  map_smul' r s := by
    have h₁ : M.presheaf.germ ⊤ (genericPoint X) trivial (r • s) =
        algebraMap k X.functionField r • M.presheaf.germ ⊤ (genericPoint X) trivial s := by
      rw [base_smul_globalSections]
      exact germ_smul M (genericPoint X) ⊤ trivial (baseRingToGlobalSections k X r) s
    rw [sectionRatio_eq_iff, RingHom.id_apply, h₁, germ_eq_sectionRatio_smul M ht s, smul_smul,
      Algebra.smul_def]

@[simp]
lemma sectionRatioₗ_apply : sectionRatioₗ M k ht s = sectionRatio M ht s :=
  rfl

/-- The projective space `ℙ(H⁰(X, M)) = Proj (Sym_k H⁰(X, M))` of a sheaf of modules `M` on a scheme
over a field `k`, with the global sections of `M` as its homogeneous coordinates. -/
noncomputable abbrev SectionsProj : Scheme.{u} :=
  Proj (homogeneousSubmodule k Γ(M, ⊤))

/-- The homogeneous coordinates of the rational map defined by the global sections of `M`, at the
generic point, normalised so that the coordinate at a nonzero section `t` is one. -/
noncomputable def sectionCoordinates : SymmetricAlgebra k Γ(M, ⊤) →ₐ[k] X.functionField :=
  SymmetricAlgebra.lift (sectionRatioₗ M k ht)

@[simp]
lemma sectionCoordinates_ι :
    sectionCoordinates M k ht (SymmetricAlgebra.ι k Γ(M, ⊤) s) = sectionRatio M ht s := by
  rw [sectionCoordinates, SymmetricAlgebra.lift_ι_apply, sectionRatioₗ_apply]

lemma map_irrelevant_sectionCoordinates :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule k Γ(M, ⊤))).toIdeal.map
      (sectionCoordinates M k ht).toRingHom = ⊤ :=
  (Ideal.eq_top_iff_one _).mpr <| by
    have h : (sectionCoordinates M k ht).toRingHom (SymmetricAlgebra.ι k Γ(M, ⊤) t) ∈
        (HomogeneousIdeal.irrelevant (homogeneousSubmodule k Γ(M, ⊤))).toIdeal.map
          (sectionCoordinates M k ht).toRingHom :=
      Ideal.mem_map_of_mem _ (ι_mem_irrelevant k t)
    rwa [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, sectionCoordinates_ι, sectionRatio_self] at h

/-- The value at the generic point of the rational map `X ⇢ ℙ(H⁰(X, M))` defined by the global
sections of an invertible sheaf `M`: the morphism `Spec k(X) ⟶ ℙ(H⁰(X, M))` with homogeneous
coordinates the ratios `s / t`. -/
noncomputable def sectionsGenericMap : Spec X.functionField ⟶ SectionsProj M k :=
  Proj.fromOfGlobalSections (homogeneousSubmodule k Γ(M, ⊤))
    ((Scheme.ΓSpecIso X.functionField).inv.hom.comp (sectionCoordinates M k ht).toRingHom)
    (by rw [← Ideal.map_map, map_irrelevant_sectionCoordinates, Ideal.map_top])

/-- **The generic value of the rational map defined by the global sections of `M` does not depend on
the nonzero section used to normalise its coordinates**: two normalisations differ by a unit. -/
lemma sectionsGenericMap_eq : sectionsGenericMap M k ht = sectionsGenericMap M k ht' := by
  let c : (Γ(Spec X.functionField, ⊤) : Type u)ˣ :=
    (Units.mk0 (sectionRatio M ht t') (sectionRatio_ne_zero M ht ht')).map
      (Scheme.ΓSpecIso X.functionField).inv.hom.toMonoidHom
  refine ProjectiveSpectrum.fromOfGlobalSections_eq_of_unit_rescaling
    (homogeneousSubmodule k Γ(M, ⊤)) _ _ c (fun n a ha ↦ ?_) _
  have h : sectionCoordinates M k ht a = sectionRatio M ht t' ^ n * sectionCoordinates M k ht' a :=
    AlgHom.apply_eq_pow_mul_of_forall_ι_eq _ _ _ (fun m ↦ by
      rw [sectionCoordinates_ι, sectionCoordinates_ι, mul_comm, sectionRatio_mul_sectionRatio]) ha
  simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, h, map_mul, map_pow]
  rfl

lemma exists_germ_eq_sectionRatio : ∃ (W : X.Opens) (hW : genericPoint X ∈ W), ∀ s : Γ(M, ⊤),
    ∃ r : Γ(X, W), X.presheaf.germ W (genericPoint X) hW r = sectionRatio M ht s := by
  rcases exists_mem_trivialization M (genericPoint X) with ⟨U, e, hU⟩
  let coord (s : Γ(M, ⊤)) : Γ(X, U) :=
    trivializationCoordinate M e (𝟙 U) (M.presheaf.map (homOfLE le_top : U ⟶ ⊤).op s)
  let g : M.presheaf.stalk (genericPoint X) :=
    M.presheaf.germ U (genericPoint X) hU (trivializationGenerator M e)
  have key (s : Γ(M, ⊤)) : M.presheaf.germ ⊤ (genericPoint X) trivial s =
      (X.presheaf.germ U (genericPoint X) hU (coord s) : X.functionField) • g := by
    have hs : M.presheaf.map (homOfLE le_top : U ⟶ ⊤).op s = trivializationCoordinate M e (𝟙 U)
        (M.presheaf.map (homOfLE le_top : U ⟶ ⊤).op s) •
          M.presheaf.map (𝟙 U).op (trivializationGenerator M e) :=
      eq_trivializationCoordinate_smul_map_trivializationGenerator M e (𝟙 U) _
    rw [op_id, M.presheaf.map_id, ConcreteCategory.id_apply] at hs
    refine (M.presheaf.germ_res_apply (homOfLE le_top : U ⟶ ⊤) (genericPoint X) hU s).symm.trans ?_
    rw [hs]
    exact germ_smul M (genericPoint X) U hU _ _
  have hc₀ : (X.presheaf.germ U (genericPoint X) hU (coord t) : X.functionField) ≠ 0 := fun h ↦
    germ_ne_zero M ht <| by
      rw [key t, h, zero_smul]
  have hW : genericPoint X ∈ X.basicOpen (coord t) :=
    (X.mem_basicOpen (coord t) (genericPoint X) hU).mpr (isUnit_iff_ne_zero.mpr hc₀)
  refine ⟨X.basicOpen (coord t), hW, fun s ↦ ?_⟩
  let i : X.basicOpen (coord t) ⟶ U := homOfLE (X.basicOpen_le (coord t))
  have hu : IsUnit (X.presheaf.map i.op (coord t)) := X.toRingedSpace.isUnit_res_basicOpen (coord t)
  refine ⟨X.presheaf.map i.op (coord s) * ↑hu.unit⁻¹, ?_⟩
  have h₁ (c : Γ(X, U)) : X.presheaf.germ _ (genericPoint X) hW (X.presheaf.map i.op c) =
      X.presheaf.germ U (genericPoint X) hU c :=
    X.presheaf.germ_res_apply i (genericPoint X) hW c
  refine ((sectionRatio_eq_iff M ht s _).mpr ?_).symm
  rw [key s, key t, smul_smul, map_mul, h₁, mul_assoc]
  have h₂ : X.presheaf.germ _ (genericPoint X) hW (↑hu.unit⁻¹ : Γ(X, X.basicOpen (coord t))) *
      X.presheaf.germ U (genericPoint X) hU (coord t) = 1 := by
    rw [← h₁, ← map_mul, hu.val_inv_mul, map_one]
  rw [h₂, mul_one]

/-- A dense open subset on which the ratios `s / t` of the global sections of `M` by a nonzero
section `t` are regular. -/
noncomputable def sectionsDomain : X.Opens :=
  (exists_germ_eq_sectionRatio M ht).choose

lemma genericPoint_mem_sectionsDomain : genericPoint X ∈ sectionsDomain M ht :=
  (exists_germ_eq_sectionRatio M ht).choose_spec.choose

lemma exists_germ_sectionsDomain_eq : ∃ r : Γ(X, sectionsDomain M ht),
    X.presheaf.germ _ (genericPoint X) (genericPoint_mem_sectionsDomain M ht) r =
      sectionRatio M ht s :=
  (exists_germ_eq_sectionRatio M ht).choose_spec.choose_spec s

instance : Nonempty (sectionsDomain M ht) :=
  ⟨⟨genericPoint X, genericPoint_mem_sectionsDomain M ht⟩⟩

variable (W : X.Opens) [Nonempty W]

variable {W} in
lemma germToFunctionField_mem_range (r : k) :
    algebraMap k X.functionField r ∈ Set.range (X.germToFunctionField W) := by
  rw [Scheme.algebraMap_functionField_eq_baseRingToFunctionField,
    Scheme.baseRingToFunctionField_eq_comp_appLE k X W]
  exact ⟨_, rfl⟩

variable (X) in
/-- The `k`-subalgebra of `k(X)` of the rational functions regular on a nonempty open `W`. -/
noncomputable def regularFunctions : Subalgebra k X.functionField where
  carrier := Set.range (X.germToFunctionField W)
  mul_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨a * b, map_mul _ a b⟩
  add_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨a + b, map_add _ a b⟩
  algebraMap_mem' := germToFunctionField_mem_range k

variable (X) in
/-- The rational functions regular on a nonempty open `W` are the regular functions on `W`. -/
noncomputable def regularFunctionsEquiv : Γ(X, W) ≃+* regularFunctions X k W :=
  RingEquiv.ofBijective ((X.germToFunctionField W).hom.codRestrict (regularFunctions X k W)
    fun r ↦ ⟨r, rfl⟩)
    ⟨fun _ _ h ↦ X.germToFunctionField_injective W (congrArg Subtype.val h),
      fun ⟨_, r, hr⟩ ↦ ⟨r, Subtype.ext hr⟩⟩

lemma germToFunctionField_regularFunctionsEquiv_symm (r : regularFunctions X k W) :
    X.germToFunctionField W ((regularFunctionsEquiv X k W).symm r) = r :=
  congrArg Subtype.val ((regularFunctionsEquiv X k W).apply_symm_apply r)

/-- The homogeneous coordinates `s / t` of the rational map defined by the global sections of `M`,
as a ring homomorphism to the regular functions on its domain. -/
noncomputable def sectionsDomainCoordinates :
    SymmetricAlgebra k Γ(M, ⊤) →+* Γ((sectionsDomain M ht).toScheme, ⊤) :=
  (sectionsDomain M ht).topIso.inv.hom.comp <|
    (regularFunctionsEquiv X k (sectionsDomain M ht)).symm.toRingHom.comp <|
      (SymmetricAlgebra.lift ((sectionRatioₗ M k ht).codRestrict
        (regularFunctions X k (sectionsDomain M ht)).toSubmodule
        (exists_germ_sectionsDomain_eq M ht))).toRingHom

variable (a : SymmetricAlgebra k Γ(M, ⊤))

lemma germToFunctionField_sectionsDomainCoordinates : X.germToFunctionField (sectionsDomain M ht)
    ((sectionsDomain M ht).topIso.hom (sectionsDomainCoordinates M k ht a)) =
      sectionCoordinates M k ht a := by
  have h : (regularFunctions X k (sectionsDomain M ht)).val.comp
      (SymmetricAlgebra.lift ((sectionRatioₗ M k ht).codRestrict
        (regularFunctions X k (sectionsDomain M ht)).toSubmodule
        (exists_germ_sectionsDomain_eq M ht))) = sectionCoordinates M k ht :=
    SymmetricAlgebra.algHom_ext <| LinearMap.ext fun s ↦
      (congrArg Subtype.val (SymmetricAlgebra.lift_ι_apply _ s)).trans
        (sectionCoordinates_ι M k ht s).symm
  have h₂ (y : Γ(X, sectionsDomain M ht)) :
      (sectionsDomain M ht).topIso.hom ((sectionsDomain M ht).topIso.inv y) = y :=
    Iso.inv_hom_id_apply _ y
  exact (congrArg _ (h₂ _)).trans
    ((germToFunctionField_regularFunctionsEquiv_symm k _ _).trans congr($h a))

lemma map_irrelevant_sectionsDomainCoordinates :
    (HomogeneousIdeal.irrelevant (homogeneousSubmodule k Γ(M, ⊤))).toIdeal.map
      (sectionsDomainCoordinates M k ht) = ⊤ :=
  (Ideal.eq_top_iff_one _).mpr <| by
    have h : sectionsDomainCoordinates M k ht (SymmetricAlgebra.ι k Γ(M, ⊤) t) ∈
        (HomogeneousIdeal.irrelevant (homogeneousSubmodule k Γ(M, ⊤))).toIdeal.map
          (sectionsDomainCoordinates M k ht) :=
      Ideal.mem_map_of_mem _ (ι_mem_irrelevant k t)
    have h₁ : sectionsDomainCoordinates M k ht (SymmetricAlgebra.ι k Γ(M, ⊤) t) = 1 := by
      refine (sectionsDomain M ht).topIso.commRingCatIsoToRingEquiv.injective
        (X.germToFunctionField_injective (sectionsDomain M ht) ?_)
      refine (germToFunctionField_sectionsDomainCoordinates M k ht _).trans ?_
      rw [sectionCoordinates_ι, sectionRatio_self, map_one, map_one]
    rwa [h₁] at h

/-- The partial map from `X` to `ℙ(H⁰(X, M))` defined by the global sections of an invertible sheaf
`M`, on a dense open subset where a nonzero section `t` does not vanish. -/
noncomputable def sectionsPartialMap : X.PartialMap (SectionsProj M k) where
  domain := sectionsDomain M ht
  dense_domain := (sectionsDomain M ht).isOpen.dense
    ⟨genericPoint X, genericPoint_mem_sectionsDomain M ht⟩
  hom := Proj.fromOfGlobalSections (homogeneousSubmodule k Γ(M, ⊤))
    (sectionsDomainCoordinates M k ht) (map_irrelevant_sectionsDomainCoordinates M k ht)

lemma fromFunctionField_sectionsPartialMap :
    (sectionsPartialMap M k ht).fromFunctionField = sectionsGenericMap M k ht := by
  refine (Proj.fromOfGlobalSections_naturality _ _ _ _).trans ?_
  congr 1
  refine RingHom.ext fun a ↦ ?_
  have h : ((sectionsDomain M ht).topIso.inv ≫ ((sectionsDomain M ht).fromSpecStalkOfMem
      (genericPoint X) (genericPoint_mem_sectionsDomain M ht)).appTop)
        ((sectionsDomain M ht).topIso.hom (sectionsDomainCoordinates M k ht a)) =
      (X.presheaf.germ (sectionsDomain M ht) (genericPoint X)
        (genericPoint_mem_sectionsDomain M ht) ≫ (ΓSpecIso (X.presheaf.stalk (genericPoint X))).inv)
        ((sectionsDomain M ht).topIso.hom (sectionsDomainCoordinates M k ht a)) :=
    ConcreteCategory.congr_hom (topIso_inv_fromSpecStalkOfMem_appTop (sectionsDomain M ht)
      (genericPoint X) (genericPoint_mem_sectionsDomain M ht)) _
  have h₂ : (sectionsDomain M ht).topIso.inv
      ((sectionsDomain M ht).topIso.hom (sectionsDomainCoordinates M k ht a)) =
      sectionsDomainCoordinates M k ht a :=
    Iso.hom_inv_id_apply _ _
  rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, h₂] at h
  refine h.trans (congrArg _ ?_)
  exact germToFunctionField_sectionsDomainCoordinates M k ht a

/-- The rational map `X ⇢ ℙ(H⁰(X, M))` defined by the global sections of an invertible sheaf `M` on
an integral scheme `X` over `k`, given a nonzero section `t`: it sends `x` to the point with
homogeneous coordinates `(s / t)(x)`, for `s` in `H⁰(X, M)`, where `t(x) ≠ 0`. It does not depend on
`t` (`AlgebraicGeometry.Scheme.Modules.sectionsRationalMap_eq`). -/
noncomputable def sectionsRationalMap : X ⤏ SectionsProj M k :=
  (sectionsPartialMap M k ht).toRationalMap

lemma fromFunctionField_sectionsRationalMap :
    (sectionsRationalMap M k ht).fromFunctionField = sectionsGenericMap M k ht :=
  (RationalMap.fromFunctionField_toRationalMap _).trans
    (fromFunctionField_sectionsPartialMap M k ht)

/-- **The rational map defined by the global sections of `M` does not depend on the nonzero section
`t` used to write it down.** -/
lemma sectionsRationalMap_eq : sectionsRationalMap M k ht = sectionsRationalMap M k ht' :=
  RationalMap.eq_of_fromFunctionField_eq _ _ <| by
    rw [fromFunctionField_sectionsRationalMap, fromFunctionField_sectionsRationalMap,
      sectionsGenericMap_eq M k ht ht']

lemma isUnit_sectionCoordinates :
    IsUnit ((sectionCoordinates M k ht).toRingHom (SymmetricAlgebra.ι k Γ(M, ⊤) t)) := by
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, sectionCoordinates_ι, sectionRatio_self]
  exact isUnit_one

lemma sectionsGenericMap_eq_awayι : sectionsGenericMap M k ht =
    Spec.map (CommRingCat.ofHom (Away.lift (homogeneousSubmodule k Γ(M, ⊤))
      (sectionCoordinates M k ht).toRingHom (isUnit_sectionCoordinates M k ht))) ≫
      Proj.awayι (homogeneousSubmodule k Γ(M, ⊤)) (SymmetricAlgebra.ι k Γ(M, ⊤) t)
        (SymmetricAlgebra.ι_mem_homogeneousSubmodule k Γ(M, ⊤) t) one_pos :=
  Proj.fromOfGlobalSections_Spec_eq_awayLift _ (map_irrelevant_sectionCoordinates M k ht) one_pos
    _ _

lemma sectionsGenericMap_over : sectionsGenericMap M k ht ≫ SectionsProj M k ↘ Spec (.of k) =
    Spec.map (CommRingCat.ofHom (algebraMap k X.functionField)) := by
  rw [sectionsGenericMap_eq_awayι, Category.assoc, SymmetricAlgebra.over_eq_projToSpec,
    SymmetricAlgebra.awayι_projToSpec, ← Spec.map_comp]
  congr 1
  refine CommRingCat.hom_ext (RingHom.ext fun c ↦ ?_)
  exact (Away.lift_algebraMap
    (sectionCoordinates M k ht).toRingHom (isUnit_sectionCoordinates M k ht)
    (algebraMap k (homogeneousSubmodule k Γ(M, ⊤) 0) c)).trans
    ((sectionCoordinates M k ht).commutes c)

/-- The **function field of the image of the rational map defined by the global sections** of `M`:
the subfield of `k(X)` generated over `k` by the ratios of the global sections of `M`. -/
noncomputable def sectionsImageField : IntermediateField k X.functionField :=
  IntermediateField.adjoin k {a | ∃ s t : Γ(M, ⊤),
    M.presheaf.germ ⊤ (genericPoint X) trivial t ≠ 0 ∧
    M.presheaf.germ ⊤ (genericPoint X) trivial s = a • M.presheaf.germ ⊤ (genericPoint X) trivial t}

lemma sectionCoordinates_mem_sectionsImageField :
    sectionCoordinates M k ht a ∈ sectionsImageField M k := by
  induction a using SymmetricAlgebra.induction with
  | algebraMap r =>
    rw [AlgHom.commutes]
    exact (sectionsImageField M k).algebraMap_mem r
  | ι s =>
    rw [sectionCoordinates_ι]
    exact IntermediateField.subset_adjoin _ _
      ⟨s, t, germ_ne_zero M ht, germ_eq_sectionRatio_smul M ht s⟩
  | mul a b ha hb =>
    rw [map_mul]
    exact mul_mem ha hb
  | add a b ha hb =>
    rw [map_add]
    exact add_mem ha hb

lemma awayLift_mem_sectionsImageField
    (b : Away (homogeneousSubmodule k Γ(M, ⊤)) (SymmetricAlgebra.ι k Γ(M, ⊤) t)) :
    Away.lift (homogeneousSubmodule k Γ(M, ⊤)) (sectionCoordinates M k ht).toRingHom
      (isUnit_sectionCoordinates M k ht) b ∈ sectionsImageField M k := by
  rcases Away.mk_surjective (homogeneousSubmodule k Γ(M, ⊤))
    (SymmetricAlgebra.ι_mem_homogeneousSubmodule k Γ(M, ⊤) t) b with ⟨n, x, hx, rfl⟩
  rw [Away.lift_mk]
  refine mul_mem (sectionCoordinates_mem_sectionsImageField M k ht x) ?_
  rw [Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val, IsUnit.unit_spec]
  exact inv_mem (pow_mem (sectionCoordinates_mem_sectionsImageField M k ht _) n)

/-- **The residue field of the image of the generic point under the rational map defined by the
global sections of `M` is the field generated by the ratios of these sections.** -/
lemma fieldRange_sectionsGenericMap :
    (fieldPointAlgHom k (sectionsGenericMap M k ht) (sectionsGenericMap_over M k ht)).fieldRange =
      sectionsImageField M k := by
  let Ψ : CommRingCat.of (Away (homogeneousSubmodule k Γ(M, ⊤)) (SymmetricAlgebra.ι k Γ(M, ⊤) t)) ⟶
      .of X.functionField := CommRingCat.ofHom (Away.lift (homogeneousSubmodule k Γ(M, ⊤))
        (sectionCoordinates M k ht).toRingHom (isUnit_sectionCoordinates M k ht))
  have hr (a : X.functionField) : a ∈ (fieldPointAlgHom k (sectionsGenericMap M k ht)
      (sectionsGenericMap_over M k ht)).fieldRange ↔ ∃ b c, Ψ c ≠ 0 ∧ a = Ψ b / Ψ c := by
    have h₁ : a ∈ Set.range (fieldPointMap (sectionsGenericMap M k ht)) ↔
        ∃ b c, Ψ c ≠ 0 ∧ a = Ψ b / Ψ c := by
      rw [sectionsGenericMap_eq_awayι]
      exact range_fieldPointMap_specMap_comp Ψ _ a
    exact h₁
  refine le_antisymm (fun a ha ↦ ?_) ((IntermediateField.adjoin_le_iff).mpr ?_)
  · rcases (hr a).mp ha with ⟨b, c, -, rfl⟩
    exact div_mem (awayLift_mem_sectionsImageField M k ht b)
      (awayLift_mem_sectionsImageField M k ht c)
  · have hs (s : Γ(M, ⊤)) : sectionRatio M ht s ∈ (fieldPointAlgHom k (sectionsGenericMap M k ht)
        (sectionsGenericMap_over M k ht)).fieldRange := by
      refine (hr _).mpr ⟨Away.mk (homogeneousSubmodule k Γ(M, ⊤))
        (SymmetricAlgebra.ι_mem_homogeneousSubmodule k Γ(M, ⊤) t) 1
        (SymmetricAlgebra.ι k Γ(M, ⊤) s) (by simp), 1, ?_, ?_⟩
      · simp
      · rw [map_one, div_one]
        refine Eq.trans ?_ (Away.lift_mk
          (sectionCoordinates M k ht).toRingHom (isUnit_sectionCoordinates M k ht) _ 1 _ _).symm
        rw [Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val, IsUnit.unit_spec]
        simp
    rintro a ⟨s, t', ht', ha⟩
    have ht'₀ : t' ≠ 0 := fun h ↦ ht' (by rw [h, map_zero])
    have h₁ : sectionRatio M ht'₀ s = a := (sectionRatio_eq_iff M ht'₀ s a).mpr ha
    have h₂ : sectionRatio M ht'₀ s * sectionRatio M ht t' = sectionRatio M ht s :=
      sectionRatio_mul_sectionRatio M ht s ht'₀
    rw [h₁] at h₂
    rw [eq_div_of_mul_eq (sectionRatio_ne_zero M ht ht'₀) h₂]
    exact div_mem (hs s) (hs t')

/-- **The transcendence degree of the residue field of the image of the generic point under the
rational map defined by the global sections of `M` is that of the field of their ratios.** -/
lemma trdeg_residueField_sectionsGenericMap : Algebra.trdeg k ((SectionsProj M k).residueField
    (sectionsGenericMap M k ht (IsLocalRing.closedPoint X.functionField))) =
      Algebra.trdeg k (sectionsImageField M k) := by
  rw [trdeg_residueField_eq_trdeg_fieldRange k (sectionsGenericMap M k ht)
    (sectionsGenericMap_over M k ht), fieldRange_sectionsGenericMap]

/-- The **image of the rational map defined by the global sections** of an invertible sheaf `M`, a
closed subset of `ℙ(H⁰(X, M))`: the closure of the image of the rational map, empty if `M` has no
nonzero global sections. -/
noncomputable def sectionsImage : Set (SectionsProj M k) :=
  ⋃ (t : Γ(M, ⊤)) (ht : t ≠ 0), (sectionsRationalMap M k ht).imageClosure

lemma sectionsImage_eq : sectionsImage M k = (sectionsRationalMap M k ht).imageClosure := by
  refine (Set.iUnion₂_subset fun t' ht' ↦ ?_).antisymm
    (Set.subset_iUnion₂_of_subset t ht subset_rfl)
  rw [sectionsRationalMap_eq M k ht' ht]

lemma sectionsImage_eq_closure : sectionsImage M k =
    closure {sectionsGenericMap M k ht (IsLocalRing.closedPoint X.functionField)} := by
  rw [sectionsImage_eq M k ht, RationalMap.imageClosure_eq_closure_singleton,
    fromFunctionField_sectionsRationalMap]

lemma sectionsImage_eq_empty [Subsingleton Γ(M, ⊤)] : sectionsImage M k = ∅ :=
  Set.iUnion_eq_empty.mpr fun _ ↦ Set.iUnion_eq_empty.mpr fun ht ↦ (ht (Subsingleton.elim _ _)).elim

/-- **The dimension of the image of the rational map defined by the global sections of `M` is the
transcendence degree of the field generated by their ratios**, when `H⁰(X, M)` is finite-dimensional
over `k`, as it is for `X` proper. -/
lemma topologicalKrullDim_sectionsImage [Module.Finite k Γ(M, ⊤)] (h : t ≠ 0) :
    topologicalKrullDim (sectionsImage M k) =
      ((Algebra.trdeg k (sectionsImageField M k)).toENat : ℕ∞) := by
  rw [sectionsImage_eq_closure M k h, topologicalKrullDim_closure_singleton_eq_toENat _ k,
    trdeg_residueField_sectionsGenericMap]

end AlgebraicGeometry.Scheme.Modules
