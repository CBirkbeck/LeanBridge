import Mathlib.LinearAlgebra.Projectivization.Basic
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import TauCeti.RingTheory.MvPolynomial.Homogeneous

/-!
# Projective algebraic sets and projective varieties

LMFDB `ag.variety` defines projective varieties classically, as subsets of projective space
`ℙⁿ(K̄)` over an algebraic closure `K̄` of a field `K`: a projective algebraic set is the zero locus
of a homogeneous ideal of `K̄[x₀, …, xₙ]`, a projective variety over `K̄` is a projective algebraic
set whose defining ideal is prime, and a projective variety over `K` is one whose defining ideal is
generated by homogeneous polynomials with coefficients in `K`.

The field `K̄` is any field `L` with an algebra structure over `K`, an algebraic closure of `K` for
the LMFDB, and projective space is `ℙ(L^σ)`, Mathlib's `Projectivization` of `σ → L`, with
`σ = Fin (n + 1)` for `ℙⁿ`. A homogeneous polynomial vanishes at a point of `ℙ(L^σ)` if it vanishes
at one, equivalently at every, nonzero vector of that line. The projective zero locus of a set of
polynomials is defined by evaluating at the representative `Projectivization.rep` of each point;
for the elements of a homogeneous ideal this does not depend on the representative. The defining
ideal of a set of points is the ideal generated by the homogeneous polynomials vanishing on it,
which is a homogeneous ideal.

## Main definitions

* `MvPolynomial.projectiveZeroLocus`: the zero locus in `ℙ(L^σ)` of a set of polynomials.
* `MvPolynomial.projectiveVanishingIdeal`: the defining ideal of a set of points of `ℙ(L^σ)`.
* `MvPolynomial.IsProjectiveAlgebraicSet` (LMFDB `ag.variety`).
* `MvPolynomial.IsProjectiveVariety` (LMFDB `ag.variety`).
* `MvPolynomial.IsProjectiveVarietyOver` (LMFDB `ag.variety`).

## Main results

* `MvPolynomial.mk_mem_projectiveZeroLocus_iff`: a point lies on the zero locus of a homogeneous
  ideal if and only if every element of the ideal vanishes at any given nonzero vector
  representing the point.
* `MvPolynomial.isProjectiveAlgebraicSet_iff`: a projective algebraic set is the zero locus of its
  defining ideal.
-/

namespace MvPolynomial

open scoped LinearAlgebra.Projectivization

attribute [local instance] gradedAlgebra

variable {σ K L : Type*} [Field K] [Field L] [Algebra K L] {S : Set (MvPolynomial σ L)}
  {I : Ideal (MvPolynomial σ L)} (hI : I.IsHomogeneous (homogeneousSubmodule σ L))
  {V : Set (ℙ L (σ → L))} {v : σ → L} (hv : v ≠ 0)

lemma eval_eq_zero_of_mem_span (h : ∀ g ∈ S, eval v g = 0) {f : MvPolynomial σ L}
    (hf : f ∈ Ideal.span S) : eval v f = 0 :=
  (Ideal.span_le.mpr h : Ideal.span S ≤ RingHom.ker (eval v)) hf

include hI in
lemma span_setOf_isHomogeneous_of_isHomogeneous :
    Ideal.span {f | f ∈ I ∧ ∃ n, f.IsHomogeneous n} = I := by
  refine le_antisymm (Ideal.span_le.mpr fun f hf ↦ hf.1)
    (hI.toIdeal_homogeneousCore_eq_self.ge.trans (Ideal.span_mono ?_))
  rintro _ ⟨⟨f, n, hf⟩, hfI, rfl⟩
  exact ⟨hfI, n, hf⟩

variable (S) in
/-- The **projective zero locus** of a set `S` of polynomials over `L`: the points of projective
space `ℙ(L^σ)` at which every polynomial of `S` vanishes, evaluated at the representative
`Projectivization.rep` of the point. For the elements of a homogeneous ideal, or more generally
for homogeneous polynomials, it does not depend on the choice of representative. -/
def projectiveZeroLocus : Set (ℙ L (σ → L)) :=
  {p | ∀ f ∈ S, eval p.rep f = 0}

lemma mem_projectiveZeroLocus_iff {p : ℙ L (σ → L)} :
    p ∈ projectiveZeroLocus S ↔ ∀ f ∈ S, eval p.rep f = 0 :=
  Iff.rfl

lemma projectiveZeroLocus_anti_mono {T : Set (MvPolynomial σ L)} (h : S ⊆ T) :
    projectiveZeroLocus T ⊆ projectiveZeroLocus S :=
  fun _ hp f hf ↦ hp f (h hf)

lemma projectiveZeroLocus_span :
    projectiveZeroLocus (Ideal.span S : Set _) = projectiveZeroLocus S :=
  (projectiveZeroLocus_anti_mono Ideal.subset_span).antisymm fun _ hp _ ↦
    eval_eq_zero_of_mem_span hp

lemma mk_mem_projectiveZeroLocus_iff_of_forall_isHomogeneous
    (hS : ∀ f ∈ S, ∃ n, f.IsHomogeneous n) :
    Projectivization.mk L v hv ∈ projectiveZeroLocus S ↔ ∀ f ∈ S, eval v f = 0 := by
  rcases Projectivization.exists_smul_eq_mk_rep L v hv with ⟨a, ha⟩
  refine forall₂_congr fun f hf ↦ ?_
  rcases hS f hf with ⟨n, hn⟩
  rw [← ha, Units.smul_def, hn.eval_smul, smul_eq_mul, mul_eq_zero, or_iff_right]
  exact pow_ne_zero n a.ne_zero

include hI in
/-- A point of `ℙ(L^σ)` lies on the zero locus of a homogeneous ideal `I` if and only if every
element of `I` vanishes at a given nonzero vector representing it. -/
lemma mk_mem_projectiveZeroLocus_iff :
    Projectivization.mk L v hv ∈ projectiveZeroLocus I ↔ ∀ f ∈ I, eval v f = 0 := by
  rw [← span_setOf_isHomogeneous_of_isHomogeneous hI, projectiveZeroLocus_span]
  refine (mk_mem_projectiveZeroLocus_iff_of_forall_isHomogeneous hv fun _ hf ↦ ?_).trans
    ⟨fun h _ ↦ eval_eq_zero_of_mem_span h, fun h f hf ↦ h f (Ideal.subset_span hf)⟩
  exact hf.2

variable (V) in
/-- The **defining ideal** `I(V)` of a set `V` of points of `ℙ(L^σ)`: the ideal generated by the
homogeneous polynomials vanishing on `V`. -/
noncomputable def projectiveVanishingIdeal : Ideal (MvPolynomial σ L) :=
  Ideal.span {f | (∃ n, f.IsHomogeneous n) ∧ ∀ p ∈ V, eval p.rep f = 0}

lemma isHomogeneous_projectiveVanishingIdeal :
    (projectiveVanishingIdeal V).IsHomogeneous (homogeneousSubmodule σ L) :=
  Ideal.homogeneous_span _ _ fun _ hf ↦ hf.1

lemma subset_projectiveZeroLocus_projectiveVanishingIdeal :
    V ⊆ projectiveZeroLocus (projectiveVanishingIdeal V) :=
  fun p hp ↦ projectiveZeroLocus_span.ge fun _ hf ↦ hf.2 p hp

include hI in
lemma le_projectiveVanishingIdeal_projectiveZeroLocus :
    I ≤ projectiveVanishingIdeal (projectiveZeroLocus I) :=
  (span_setOf_isHomogeneous_of_isHomogeneous hI).ge.trans <| Ideal.span_mono fun g hg ↦
    ⟨hg.2, fun _ hp ↦ hp g hg.1⟩

variable (V) in
/-- A **projective algebraic set** (LMFDB `ag.variety`): a subset `V` of projective space `ℙ(L^σ)`
which is the zero locus of a homogeneous ideal `I` of `L[xᵢ | i ∈ σ]`. -/
def IsProjectiveAlgebraicSet : Prop :=
  ∃ I : Ideal (MvPolynomial σ L), I.IsHomogeneous (homogeneousSubmodule σ L) ∧
    projectiveZeroLocus I = V

/-- A projective algebraic set is the zero locus of its defining ideal. -/
lemma isProjectiveAlgebraicSet_iff :
    IsProjectiveAlgebraicSet V ↔ projectiveZeroLocus (projectiveVanishingIdeal V) = V := by
  refine ⟨?_, fun h ↦ ⟨_, isHomogeneous_projectiveVanishingIdeal, h⟩⟩
  rintro ⟨I, hI, rfl⟩
  exact (projectiveZeroLocus_anti_mono <| le_projectiveVanishingIdeal_projectiveZeroLocus
    hI).antisymm subset_projectiveZeroLocus_projectiveVanishingIdeal

variable (V) in
/-- A **projective variety** over `L` (LMFDB `ag.variety`, for `L` an algebraic closure `K̄`): a
projective algebraic set whose defining ideal, a homogeneous ideal, is prime. -/
def IsProjectiveVariety : Prop :=
  IsProjectiveAlgebraicSet V ∧ (projectiveVanishingIdeal V).IsPrime

variable (K V) in
/-- A **projective variety over `K`** (LMFDB `ag.variety`): a projective variety `V` over `L = K̄`
whose defining ideal can be generated by homogeneous polynomials with coefficients in `K`. -/
def IsProjectiveVarietyOver : Prop :=
  IsProjectiveVariety V ∧ ∃ S : Set (MvPolynomial σ K), (∀ f ∈ S, ∃ n, f.IsHomogeneous n) ∧
    Ideal.span (map (algebraMap K L) '' S) = projectiveVanishingIdeal V

lemma IsProjectiveVarietyOver.isProjectiveVariety (h : IsProjectiveVarietyOver K V) :
    IsProjectiveVariety V :=
  h.1

end MvPolynomial
