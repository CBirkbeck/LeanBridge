import LeanBridge.ForMathlib.AlgebraicGeometry.HilbertModularSurface.KodairaDimension
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.RingTheory.AlgebraicIndependent.Basic
import TauCeti.AlgebraicGeometry.Modules.Stalk
import TauCeti.AlgebraicGeometry.Scheme.BaseAlgebra

/-!
# The Kodaira dimension through the pluricanonical maps

Let `X` be an integral scheme over a field `k`, typically a smooth projective variety, with
canonical sheaf `K` (`AlgebraicGeometry.Scheme.canonicalSheaf`). For `d ≥ 1` the global sections
`s₀, …, s_n` of `K^{⊗d}` define the `d`-th pluricanonical map, the rational map
`φ_d : X ⇢ ℙ(H⁰(X, K^{⊗d}))`, `x ↦ [s₀(x) : ⋯ : s_n(x)]`. The function field of its image
`φ_d(X)` is the subfield `k(s_i / s_j)` of `k(X)` generated by the ratios of the sections, so that
`dim φ_d(X)` is the transcendence degree of this subfield over `k`. The Kodaira dimension (LMFDB
`ag.kodaira_dimension`) is `-∞`, recorded by the LMFDB as `-1`, if the plurigenera
`P_d = h⁰(X, K^{⊗d})` all vanish, and `sup_d dim φ_d(X)` otherwise.

Here the ratio `s / t` of two global sections of `K^{⊗d}` is computed at the generic point: it is
the rational function `a` with `s = a t` in the stalk of `K^{⊗d}` at the generic point, a vector
space over `k(X)` of dimension one when `K^{⊗d}` is invertible, as when `X` is smooth. The
rational maps to projective space themselves, and the identification of the function field of
`φ_d(X)` with the field generated by the ratios, are not formalised.

LeanBridge's `AlgebraicGeometry.Scheme.kodairaDimension` is instead the growth order of the
plurigenera; the two agree for smooth projective varieties by Iitaka's theorem, which is not
formalised. The knowl lets `d` range over `ℤ≥0`, but `P₀ = h⁰(X, 𝒪_X) ≥ 1` for a nonempty proper
variety, so its condition that `P_d = 0` for all `d` is read here for `d ≥ 1`.

## Main definitions

* `AlgebraicGeometry.Scheme.pluricanonicalRatios`: the ratios of the global sections of `K^{⊗d}`.
* `AlgebraicGeometry.Scheme.pluricanonicalImageField`: the function field `k(s_i / s_j)` of the
  image of the `d`-th pluricanonical map.
* `AlgebraicGeometry.Scheme.pluricanonicalImageDim`: the dimension `dim φ_d(X)` of that image.
* `AlgebraicGeometry.Scheme.pluricanonicalKodairaDimension` (LMFDB `ag.kodaira_dimension`): the
  Kodaira dimension `κ(X)`, with `⊥` for `-∞`.

## Main results

* `AlgebraicGeometry.Scheme.pluricanonicalImageDim_le`: `dim φ_d(X) ≤ trdeg_k k(X)`.
* `AlgebraicGeometry.Scheme.pluricanonicalKodairaDimension_eq_bot_iff`: `κ(X) = -∞` exactly when
  all the plurigenera `P_d` with `d ≥ 1` vanish.
* `AlgebraicGeometry.Scheme.kodairaDimension_eq_neg_one_of_pluricanonicalKodairaDimension_eq_bot`:
  the growth-order Kodaira dimension is then `-1` too.
* `AlgebraicGeometry.Scheme.pluricanonicalKodairaDimension_le`: `κ(X) ≤ trdeg_k k(X)`, which is
  the dimension of `X` when `X` is a variety.
-/

namespace AlgebraicGeometry.Scheme

universe u

variable (k : Type u) [Field k] (X : Scheme.{u}) [X.Over (Spec (.of k))] [IsIntegral X] (d : ℕ)

/-- The **ratios of the global sections** of the `d`-th tensor power `K^{⊗d}` of the canonical sheaf
of an integral scheme `X` over `k`: the rational functions `a` with `s = a t` at the generic point,
for global sections `s` and `t` of `K^{⊗d}` with `t` nonzero at the generic point. When `K^{⊗d}` is
invertible, they are the ratios `s / t` of the coordinates of the `d`-th pluricanonical map. -/
def pluricanonicalRatios : Set X.functionField :=
  letI M : X.Modules := (X.canonicalSheaf k).tensorPow d
  {a | ∃ s t : Γ(M, ⊤), M.presheaf.germ ⊤ (genericPoint X) trivial t ≠ 0 ∧
    M.presheaf.germ ⊤ (genericPoint X) trivial s = a • M.presheaf.germ ⊤ (genericPoint X) trivial t}

/-- The **function field of the image of the `d`-th pluricanonical map**
`φ_d : X ⇢ ℙ(H⁰(X, K^{⊗d}))` (LMFDB `ag.kodaira_dimension`): the subfield `k(s_i / s_j)` of `k(X)`
generated over `k` by the ratios of the global sections of `K^{⊗d}`
(`AlgebraicGeometry.Scheme.pluricanonicalRatios`). -/
noncomputable def pluricanonicalImageField : IntermediateField k X.functionField :=
  IntermediateField.adjoin k (X.pluricanonicalRatios k d)

/-- The **dimension `dim φ_d(X)` of the image of the `d`-th pluricanonical map** (LMFDB
`ag.kodaira_dimension`): the transcendence degree over `k` of its function field
(`AlgebraicGeometry.Scheme.pluricanonicalImageField`). -/
noncomputable def pluricanonicalImageDim : ℕ∞ :=
  (Algebra.trdeg k (X.pluricanonicalImageField k d)).toENat

open scoped Classical in
/-- The **Kodaira dimension** `κ(X)` (LMFDB `ag.kodaira_dimension`) of an integral scheme `X` over
`k`, typically a smooth projective variety, defined through the pluricanonical maps: `-∞`, written
`⊥` and recorded by the LMFDB as `-1`, if the plurigenera `P_d = h⁰(X, K^{⊗d})` vanish for all
`d ≥ 1`, and otherwise the supremum over `d ≥ 1` of the dimensions `dim φ_d(X)` of the images of the
pluricanonical maps (`AlgebraicGeometry.Scheme.pluricanonicalImageDim`). -/
noncomputable def pluricanonicalKodairaDimension : WithBot ℕ∞ :=
  if ∀ n, 1 ≤ n → X.plurigenus k n = 0 then ⊥
  else ↑(⨆ (n : ℕ) (_ : 1 ≤ n), X.pluricanonicalImageDim k n)

/-- **The image of a pluricanonical map has dimension at most `trdeg_k k(X)`**, which is the
dimension of `X` when `X` is a variety, as its function field is a subfield of `k(X)`. -/
lemma pluricanonicalImageDim_le :
    X.pluricanonicalImageDim k d ≤ (Algebra.trdeg k X.functionField).toENat :=
  Cardinal.toENat.monotone' <| trdeg_le_of_injective _
    (X.pluricanonicalImageField k d).val.injective

/-- **The Kodaira dimension is `-∞` exactly when all the plurigenera `P_d` with `d ≥ 1` vanish.** -/
lemma pluricanonicalKodairaDimension_eq_bot_iff :
    X.pluricanonicalKodairaDimension k = ⊥ ↔ ∀ n, 1 ≤ n → X.plurigenus k n = 0 := by
  unfold pluricanonicalKodairaDimension
  split_ifs with h
  · exact iff_of_true rfl h
  · exact iff_of_false WithBot.coe_ne_bot h

/-- **The two Kodaira dimensions agree when they are `-∞`**: if the Kodaira dimension defined
through the pluricanonical maps is `-∞`, then so is the growth order of the plurigenera
(`AlgebraicGeometry.Scheme.kodairaDimension`), recorded as `-1`. -/
lemma kodairaDimension_eq_neg_one_of_pluricanonicalKodairaDimension_eq_bot
    (h : X.pluricanonicalKodairaDimension k = ⊥) : X.kodairaDimension k = -1 :=
  kodairaDimension_eq_neg_one <| Filter.eventually_atTop.mpr
    ⟨1, (X.pluricanonicalKodairaDimension_eq_bot_iff k).mp h⟩

/-- **The Kodaira dimension is at most `trdeg_k k(X)`**, which is the dimension of `X` when `X` is a
variety. -/
lemma pluricanonicalKodairaDimension_le :
    X.pluricanonicalKodairaDimension k ≤ ↑(Algebra.trdeg k X.functionField).toENat := by
  unfold pluricanonicalKodairaDimension
  split_ifs
  · exact bot_le
  · exact WithBot.coe_le_coe.mpr (iSup₂_le fun n _ ↦ X.pluricanonicalImageDim_le k n)

end AlgebraicGeometry.Scheme
