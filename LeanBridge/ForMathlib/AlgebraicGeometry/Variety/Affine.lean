import Mathlib.RingTheory.Nullstellensatz

/-!
# Affine algebraic sets and affine varieties

LMFDB `ag.variety` defines affine varieties classically, as subsets of affine space `𝔸ⁿ(K̄)` over
an algebraic closure `K̄` of a field `K`: an affine algebraic set is a zero locus `V(I)` of an ideal
`I` of `K̄[x₁, …, xₙ]`, its defining ideal `I(V)` is the ideal of polynomials vanishing on it, an
affine variety over `K̄` is an affine algebraic set whose defining ideal is prime, and an affine
variety over `K` is one whose defining ideal is generated by polynomials with coefficients in `K`.

The zero locus and the defining ideal are Mathlib's `MvPolynomial.zeroLocus` and
`MvPolynomial.vanishingIdeal`. The field `K̄` is any field `L` with an algebra structure over `K`,
an algebraic closure of `K` for the LMFDB, and affine space is `σ → L`, with `σ = Fin n` for the
LMFDB.

The defining ideal of an affine variety over `K` is generated by the polynomials over `K` that
vanish on it, `isAffineVarietyOver_iff`. By the Nullstellensatz, the zero locus of an ideal over
`K` whose extension to `L = K̄` is prime is an affine variety over `K`,
`isAffineVarietyOver_zeroLocus`, and every affine variety over `K` is of this form,
`isAffineVarietyOver_iff_exists_zeroLocus`.

## Main definitions

* `MvPolynomial.IsAffineAlgebraicSet` (LMFDB `ag.variety`).
* `MvPolynomial.IsAffineVariety` (LMFDB `ag.variety`).
* `MvPolynomial.IsAffineVarietyOver` (LMFDB `ag.variety`).

## Main results

* `MvPolynomial.isAffineVarietyOver_iff`: an affine variety over `L` is an affine variety over `K`
  if and only if its defining ideal is generated by the polynomials over `K` that vanish on it.
* `MvPolynomial.isAffineVarietyOver_zeroLocus`: over an algebraically closed field `L`, the zero
  locus of an ideal over `K` whose extension to `L` is prime is an affine variety over `K`.
* `MvPolynomial.isAffineVarietyOver_iff_exists_zeroLocus`: over an algebraically closed field `L`,
  the affine varieties over `K` are exactly these zero loci.
-/

namespace MvPolynomial

variable {σ K L : Type*} [Field K] [Field L] [Algebra K L] {V : Set (σ → L)}
  (I : Ideal (MvPolynomial σ L)) (P : Ideal (MvPolynomial σ K))

variable (V) in
/-- An **affine algebraic set** (LMFDB `ag.variety`): a subset `V` of affine space `σ → L` of the
form `V(I) = {P | f(P) = 0 for all f ∈ I}` for an ideal `I` of `L[xᵢ | i ∈ σ]`. -/
def IsAffineAlgebraicSet : Prop :=
  ∃ I : Ideal (MvPolynomial σ L), zeroLocus L I = V

lemma isAffineAlgebraicSet_zeroLocus : IsAffineAlgebraicSet (zeroLocus L I) :=
  ⟨I, rfl⟩

lemma isAffineAlgebraicSet_iff : IsAffineAlgebraicSet V ↔ zeroLocus L (vanishingIdeal L V) = V := by
  refine ⟨?_, fun h ↦ ⟨_, h⟩⟩
  rintro ⟨I, rfl⟩
  exact (zeroLocus_anti_mono <| le_vanishingIdeal_zeroLocus I).antisymm <|
    zeroLocus_vanishingIdeal_le _

variable (V) in
/-- An **affine variety** over `L` (LMFDB `ag.variety`, for `L` an algebraic closure `K̄`): an
affine algebraic set whose defining ideal `I(V) = vanishingIdeal L V` is prime. In particular it is
nonempty, since the defining ideal of the empty set is the unit ideal. -/
def IsAffineVariety : Prop :=
  IsAffineAlgebraicSet V ∧ (vanishingIdeal L V).IsPrime

variable (K V) in
/-- An **affine variety over `K`** (LMFDB `ag.variety`): an affine variety `V` over `L = K̄` whose
defining ideal can be generated by polynomials with coefficients in `K`. -/
def IsAffineVarietyOver : Prop :=
  IsAffineVariety V ∧ ∃ S : Set (MvPolynomial σ K), Ideal.span (map (algebraMap K L) '' S) =
    vanishingIdeal L V

lemma IsAffineVarietyOver.isAffineVariety (h : IsAffineVarietyOver K V) : IsAffineVariety V :=
  h.1

variable (K) in
lemma comap_vanishingIdeal :
    (vanishingIdeal L V).comap (map (algebraMap K L)) = vanishingIdeal K V :=
  Ideal.ext fun p ↦ forall₂_congr fun x _ ↦ aeval_map_algebraMap L x p ▸ Iff.rfl

/-- An affine variety `V` over `L` is an affine variety over `K` if and only if its defining ideal
is generated by the polynomials with coefficients in `K` that vanish on `V`. -/
lemma isAffineVarietyOver_iff : IsAffineVarietyOver K V ↔ IsAffineVariety V ∧ (vanishingIdeal K
    V).map (map (algebraMap K L)) = vanishingIdeal L V := by
  refine and_congr_right fun _ ↦ ⟨?_, fun h ↦ ⟨_, h⟩⟩
  rintro ⟨S, hS⟩
  refine (Ideal.map_le_iff_le_comap.mpr (comap_vanishingIdeal K).ge).antisymm ?_
  rw [← hS, ← Ideal.map_span]
  refine Ideal.map_mono (Ideal.span_le.mpr fun s hs ↦ ?_)
  rw [SetLike.mem_coe, ← comap_vanishingIdeal K, Ideal.mem_comap, ← hS]
  exact Ideal.subset_span ⟨s, hs, rfl⟩

lemma isAffineVarietyOver_self : IsAffineVarietyOver L V ↔ IsAffineVariety V :=
  ⟨IsAffineVarietyOver.isAffineVariety, fun h ↦ ⟨h, vanishingIdeal L V, by simp [map_id]⟩⟩

lemma zeroLocus_map : zeroLocus L (P.map (map (algebraMap K L))) = zeroLocus L P := by
  ext x
  simp [Ideal.map, zeroLocus_span, aeval_def]

variable [IsAlgClosed L] [Finite σ]

lemma isAffineVariety_zeroLocus [I.IsPrime] : IsAffineVariety (zeroLocus L I) :=
  ⟨isAffineAlgebraicSet_zeroLocus I, by rwa [IsPrime.vanishingIdeal_zeroLocus]⟩

/-- Over an algebraically closed field `L`, the zero locus of an ideal `P` over `K` whose extension
to `L` is prime is an affine variety over `K`, with defining ideal that extension. -/
lemma isAffineVarietyOver_zeroLocus (hP : (P.map (map (algebraMap K L))).IsPrime) :
    IsAffineVarietyOver K (zeroLocus L P) := by
  rw [← zeroLocus_map]
  exact ⟨isAffineVariety_zeroLocus _, P, (IsPrime.vanishingIdeal_zeroLocus (P.map _)).symm⟩

/-- Over an algebraically closed field `L`, the affine varieties over `K` are exactly the zero loci
of the ideals over `K` whose extension to `L` is prime. -/
lemma isAffineVarietyOver_iff_exists_zeroLocus : IsAffineVarietyOver K V ↔ ∃ P : Ideal (MvPolynomial
    σ K), (P.map (map (algebraMap K L))).IsPrime ∧ zeroLocus L P = V := by
  refine ⟨fun h ↦ ?_, fun ⟨P, hP, hPV⟩ ↦ hPV ▸ isAffineVarietyOver_zeroLocus P hP⟩
  rcases isAffineVarietyOver_iff.mp h with ⟨⟨hV, hV'⟩, hKV⟩
  exact ⟨vanishingIdeal K V, hKV ▸ hV', (zeroLocus_map _).symm.trans <|
    hKV ▸ isAffineAlgebraicSet_iff.mp hV⟩

end MvPolynomial
