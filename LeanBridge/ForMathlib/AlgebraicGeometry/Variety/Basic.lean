import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
import Mathlib.AlgebraicGeometry.Morphisms.Separated
import Mathlib.CategoryTheory.Comma.Over.Pullback
import TauCeti.AlgebraicGeometry.Geometrically.Integral

/-!
# Algebraic varieties as schemes

LMFDB `ag.variety` defines affine and projective varieties over a field `K` classically: subsets of
affine or projective space over an algebraic closure `K̄` whose defining ideal is prime and
generated by polynomials with coefficients in `K` (`MvPolynomial.IsAffineVarietyOver` and
`MvPolynomial.IsProjectiveVarietyOver`). Their scheme-theoretic counterpart, which also covers the
varieties that are neither affine nor projective, is a scheme over `K` that is geometrically
integral, separated and of finite type over `K`.

Geometric integrality is what the classical definition over `K` amounts to: if the defining ideal
`I(V) ⊆ K̄[x]` is prime and generated by `I(V) ∩ K[x]`, then the coordinate ring
`K[x] ⧸ I(V) ∩ K[x]` of the corresponding scheme over `K` stays a domain after extending scalars to
`K̄`, and conversely. Affine and projective schemes are separated, and of finite type when given by
finitely many variables. This comparison with the classical definitions is not formalised.

A variety over `K` is integral, and its base change along any morphism `Spec L ⟶ Spec K` from the
spectrum of a field, in particular along a field extension `L / K`, is a variety over `L`. The point
`Spec K` is a variety over `K`.

## Main definitions

* `AlgebraicGeometry.Scheme.IsVarietyOver` (LMFDB `ag.variety`).
-/

namespace AlgebraicGeometry.Scheme

open CategoryTheory Limits
open TauCeti.AlgebraicGeometry (geometricallyIntegral_of_isIso)

universe u

variable {K L : Type u} [Field K] [Field L] {X : Scheme.{u}} [X.Over (Spec (.of K))]

variable (K) in
/-- An **algebraic variety** over a field `K` (LMFDB `ag.variety`), as a scheme: a scheme over `K`
that is geometrically integral, separated and of finite type (quasi-compact and locally of finite
type) over `K`. -/
class IsVarietyOver : Prop extends GeometricallyIntegral (X ↘ Spec (.of K)),
    IsSeparated (X ↘ Spec (.of K)), LocallyOfFiniteType (X ↘ Spec (.of K)),
    QuasiCompact (X ↘ Spec (.of K))

variable [X.IsVarietyOver K]

variable (K) in
include K in
lemma IsVarietyOver.isIntegral : IsIntegral X :=
  GeometricallyIntegral.isIntegral_of_subsingleton (X ↘ Spec (.of K))

instance : (X.asOver (Spec (.of K))).left.IsVarietyOver K :=
  ‹X.IsVarietyOver K›

instance : (Spec (.of K)).IsVarietyOver K where
  toGeometricallyIntegral := geometricallyIntegral_of_isIso _

instance (Y : Over (Spec (.of K))) [Y.left.IsVarietyOver K] (g : Spec (.of L) ⟶ Spec (.of K)) :
    ((Over.pullback g).obj Y).left.IsVarietyOver L where
  toGeometricallyIntegral :=
    inferInstanceAs (GeometricallyIntegral (pullback.snd (Y.left ↘ Spec (.of K)) g))
  toIsSeparated := inferInstanceAs (IsSeparated (pullback.snd (Y.left ↘ Spec (.of K)) g))
  toLocallyOfFiniteType :=
    inferInstanceAs (LocallyOfFiniteType (pullback.snd (Y.left ↘ Spec (.of K)) g))
  toQuasiCompact := inferInstanceAs (QuasiCompact (pullback.snd (Y.left ↘ Spec (.of K)) g))

end AlgebraicGeometry.Scheme
