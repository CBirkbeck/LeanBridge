import LeanBridge.ForMathlib.AlgebraicGeometry.AbelianVariety.FiniteField.CyclicPoints
import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Mordell–Weil generators of an abelian variety

The Mordell–Weil group `A(K)` of an abelian variety `A` over a number field `K` is a finitely
generated abelian group (the Mordell–Weil theorem, not formalised here), so that
`A(K) ≅ ℤ ^ r × A(K)_tors` for the rank `r` of `A(K)` and its finite torsion subgroup. The LMFDB
describes `A(K)` by a minimal `ℤ`-basis, its **Mordell–Weil generators** (LMFDB `g2c.mw_generator`):
`r` points whose classes form a `ℤ`-basis of `A(K)/A(K)_tors`, and a `ℤ`-basis of `A(K)_tors` of
the least possible size, points which generate `A(K)_tors` and of which an integral combination
vanishes only when each of its terms does. The points `A(K)` are the morphisms `Spec K ⟶ A` over
`Spec K` (`TauCeti.AlgebraicGeometry.AbelianVariety.RationalPoint`), a commutative group under the
group law of `A`, written additively here as `Additive A.RationalPoint`. For elliptic curves these
are LeanBridge's `WeierstrassCurve.Affine.IsMordellWeilGenerators`.

When `A` is the Jacobian of a genus 2 curve `X`, the LMFDB writes a point of `A(ℚ)` as the class of
a divisor `D₀ - nD_∞` on `X`, with `D₀` given by its Mumford representation, which is formalised at
the level of equations by `HyperellipticEquation.IsMumfordPair`. The Jacobian is only characterised
here by its functor of points (`TauCeti.AlgebraicGeometry.AbelianVariety.IsJacobian`), and the
divisor classes of `X` are not related to its points, so neither is the Mumford representation.

## Main definitions

* `TauCeti.AlgebraicGeometry.AbelianVariety.IsTorsionBasis`: the family `T` is a `ℤ`-basis of
  `A(K)_tors`.
* `TauCeti.AlgebraicGeometry.AbelianVariety.IsMordellWeilGenerators` (LMFDB `g2c.mw_generator`):
  the families `P` and `T` are Mordell–Weil generators of `A(K)`.

## Main results

* `TauCeti.AlgebraicGeometry.AbelianVariety.IsMordellWeilGenerators.closure_eq_top`: Mordell–Weil
  generators generate `A(K)`.
* `TauCeti.AlgebraicGeometry.AbelianVariety.IsMordellWeilGenerators.finrank_eq`: the number of
  non-torsion generators is the rank of `A(K)`.
* `TauCeti.AlgebraicGeometry.AbelianVariety.exists_isMordellWeilGenerators`: when `A(K)` is finitely
  generated, it has Mordell–Weil generators.
-/

open CategoryTheory MonObj Module Submodule

namespace TauCeti.AlgebraicGeometry.AbelianVariety

universe u

variable {K : Type u} [Field K] {A : AbelianVariety K} {r s : ℕ}
  {P : Fin r → Additive A.RationalPoint} {T : Fin s → Additive A.RationalPoint}

variable (T) in
/-- The family `T` of points of an abelian variety `A` over `K` is a **`ℤ`-basis of the torsion
subgroup** `A(K)_tors` of its Mordell–Weil group: the `T j` generate `A(K)_tors`, and an integral
combination of them vanishes only when each of its terms does, so that `A(K)_tors` is the direct sum
of the cyclic subgroups generated by the `T j`. -/
structure IsTorsionBasis : Prop where
  closure_eq_torsion :
    AddSubgroup.closure (Set.range T) = AddCommGroup.torsion (Additive A.RationalPoint)
  zsmul_eq_zero_of_sum_eq_zero (b : Fin s → ℤ) : ∑ j, b j • T j = 0 → ∀ j, b j • T j = 0

variable (P T) in
/-- The families `P` and `T` of points of an abelian variety `A` over `K` are **Mordell–Weil
generators** of its Mordell–Weil group `A(K)` (LMFDB `g2c.mw_generator`), with non-torsion
generators `P` and torsion generators `T`: the classes of the `P i` form a `ℤ`-basis of
`A(K)/A(K)_tors`, the `T j` form a `ℤ`-basis of the torsion subgroup `A(K)_tors`
(`TauCeti.AlgebraicGeometry.AbelianVariety.IsTorsionBasis`), and no `ℤ`-basis of `A(K)_tors` has
fewer than `s` points. Together the `P i` and the `T j` thus form a minimal `ℤ`-basis of `A(K)`. -/
structure IsMordellWeilGenerators : Prop where
  linearIndependent : LinearIndependent ℤ ((torsion ℤ (Additive A.RationalPoint)).mkQ ∘ P)
  span_eq_top : span ℤ (Set.range ((torsion ℤ (Additive A.RationalPoint)).mkQ ∘ P)) = ⊤
  isTorsionBasis : IsTorsionBasis T
  le_of_isTorsionBasis (t : ℕ) (T' : Fin t → Additive A.RationalPoint) : IsTorsionBasis T' → s ≤ t

lemma IsTorsionBasis.isOfFinAddOrder (h : IsTorsionBasis T) (j : Fin s) :
    IsOfFinAddOrder (T j) := by
  rw [← AddCommGroup.mem_torsion, ← h.closure_eq_torsion]
  exact AddSubgroup.subset_closure ⟨j, rfl⟩

namespace IsMordellWeilGenerators

lemma not_isOfFinAddOrder (h : IsMordellWeilGenerators P T) (i : Fin r) :
    ¬IsOfFinAddOrder (P i) := by
  intro hP
  refine h.linearIndependent.ne_zero i ?_
  rw [Function.comp_apply, ← LinearMap.mem_ker, ker_mkQ, ← mem_toAddSubgroup, torsion_int]
  exact hP

/-- **The number of non-torsion generators is the rank** of `A(K)/A(K)_tors`, that of `A(K)`. -/
lemma finrank_eq (h : IsMordellWeilGenerators P T) :
    finrank ℤ (Additive A.RationalPoint ⧸ torsion ℤ (Additive A.RationalPoint)) = r := by
  rw [finrank_eq_card_basis (Basis.mk h.linearIndependent h.span_eq_top.ge), Fintype.card_fin]

/-- **Mordell–Weil generators generate** `A(K)`. -/
lemma closure_eq_top (h : IsMordellWeilGenerators P T) :
    AddSubgroup.closure (Set.range P ∪ Set.range T) = ⊤ := by
  refine eq_top_iff.mpr fun Q _ ↦ ?_
  rcases (mem_span_range_iff_exists_fun ℤ).mp
    (h.span_eq_top ▸ mem_top : (torsion ℤ (Additive A.RationalPoint)).mkQ Q ∈ _) with ⟨c, hc⟩
  have hQ : Q - ∑ i, c i • P i ∈ AddCommGroup.torsion (Additive A.RationalPoint) := by
    rw [← torsion_int, mem_toAddSubgroup, ← ker_mkQ (torsion ℤ (Additive A.RationalPoint)),
      LinearMap.mem_ker, map_sub, map_sum, ← hc]
    simp
  rw [← sub_add_cancel Q (∑ i, c i • P i)]
  exact add_mem (AddSubgroup.closure_mono Set.subset_union_right
    (h.isTorsionBasis.closure_eq_torsion ▸ hQ))
    (sum_mem fun i _ ↦ zsmul_mem (AddSubgroup.subset_closure (Or.inl ⟨i, rfl⟩)) _)

end IsMordellWeilGenerators

private lemma exists_independent_closure_eq_top (G : Type*) [AddCommGroup G] [Finite G] :
    ∃ (s : ℕ) (g : Fin s → G), AddSubgroup.closure (Set.range g) = ⊤ ∧
      ∀ b : Fin s → ℤ, ∑ j, b j • g j = 0 → ∀ j, b j • g j = 0 := by
  classical
  rcases AddCommGroup.equiv_directSum_zmod_of_finite' G with ⟨κ, _, n, -, ⟨e⟩⟩
  let σ : Fin (Fintype.card κ) ≃ κ := (Fintype.equivFin κ).symm
  refine ⟨Fintype.card κ, fun j ↦ e.symm (DirectSum.of _ (σ j) 1), eq_top_iff.mpr fun x _ ↦ ?_,
    fun b hb j ↦ ?_⟩
  · rw [← e.symm_apply_apply x, ← DirectSum.sum_univ_of (e x), map_sum]
    refine sum_mem fun i _ ↦ ?_
    rw [← ZMod.intCast_zmod_cast (e x i), ← zsmul_one, map_zsmul, map_zsmul]
    refine zsmul_mem (AddSubgroup.subset_closure ?_) _
    exact ⟨σ.symm i,
      congrArg (fun k ↦ e.symm (DirectSum.of (fun i ↦ ZMod (n i)) k 1)) (σ.apply_symm_apply i)⟩
  · have h : ∑ x, b x • DirectSum.of (fun i ↦ ZMod (n i)) (σ x) 1 = 0 := by
      simpa using congrArg e hb
    have hj : ∑ x, (b x • DirectSum.of (fun i ↦ ZMod (n i)) (σ x) 1) (σ j) = 0 := by
      rw [← DirectSum.sum_apply, h, DirectSum.zero_apply]
    rw [Finset.sum_eq_single j (fun x _ hx ↦ ?_) (by simp), DFinsupp.smul_apply,
      DirectSum.of_eq_same] at hj
    · dsimp only
      rw [← map_zsmul, ← map_zsmul, hj, map_zero, map_zero]
    · rw [DFinsupp.smul_apply, DirectSum.of_eq_of_ne _ _ _ (σ.injective.ne hx.symm), smul_zero]

variable (A) in
lemma exists_isTorsionBasis [Module.Finite ℤ (Additive A.RationalPoint)] :
    ∃ (s : ℕ) (T : Fin s → Additive A.RationalPoint), IsTorsionBasis T := by
  have : Finite (torsion ℤ (Additive A.RationalPoint)) := finite_of_fg_torsion _ torsion_isTorsion
  have : Finite (AddCommGroup.torsion (Additive A.RationalPoint)) := by
    rw [← torsion_int]
    exact this
  rcases exists_independent_closure_eq_top (AddCommGroup.torsion (Additive A.RationalPoint)) with
    ⟨s, g, hg, hind⟩
  refine ⟨s, fun j ↦ g j, ⟨le_antisymm ((AddSubgroup.closure_le _).mpr
    (Set.range_subset_iff.mpr fun j ↦ (g j).2)) fun x hx ↦ ?_, fun b hb j ↦ ?_⟩⟩
  · have hx' : (⟨x, hx⟩ : AddCommGroup.torsion (Additive A.RationalPoint)) ∈
        AddSubgroup.closure (Set.range g) :=
      hg ▸ AddSubgroup.mem_top _
    have hmap : x ∈ (AddSubgroup.closure (Set.range g)).map
        (AddCommGroup.torsion (Additive A.RationalPoint)).subtype :=
      AddSubgroup.mem_map_of_mem _ hx'
    rwa [AddMonoidHom.map_closure, ← Set.range_comp] at hmap
  · have hj : b j • g j = 0 := hind b (Subtype.ext (by simpa using hb)) j
    simpa using congrArg Subtype.val hj

variable (A) in
/-- **Existence of Mordell–Weil generators**: if the Mordell–Weil group `A(K)` of an abelian variety
`A` over `K` is finitely generated, for instance over a number field by the Mordell–Weil theorem,
then it has Mordell–Weil generators. -/
lemma exists_isMordellWeilGenerators [Module.Finite ℤ (Additive A.RationalPoint)] :
    ∃ (r s : ℕ) (P : Fin r → Additive A.RationalPoint) (T : Fin s → Additive A.RationalPoint),
      IsMordellWeilGenerators P T := by
  classical
  have : Module.Free ℤ (Additive A.RationalPoint ⧸ torsion ℤ (Additive A.RationalPoint)) :=
    free_of_finite_type_torsion_free'
  choose P hP using fun i ↦ (torsion ℤ (Additive A.RationalPoint)).mkQ_surjective
    (finBasis ℤ (Additive A.RationalPoint ⧸ torsion ℤ (Additive A.RationalPoint)) i)
  have hP' : (torsion ℤ (Additive A.RationalPoint)).mkQ ∘ P =
      finBasis ℤ (Additive A.RationalPoint ⧸ torsion ℤ (Additive A.RationalPoint)) :=
    funext hP
  have hex : ∃ (t : ℕ) (T : Fin t → Additive A.RationalPoint), IsTorsionBasis T :=
    exists_isTorsionBasis A
  rcases Nat.find_spec hex with ⟨T, hT⟩
  refine ⟨_, Nat.find hex, P, T, ⟨?_, ?_, hT, fun t T' hT' ↦ Nat.find_min' hex ⟨T', hT'⟩⟩⟩
  · rw [hP']
    exact (finBasis ℤ _).linearIndependent
  · rw [hP', (finBasis ℤ _).span_eq]

end TauCeti.AlgebraicGeometry.AbelianVariety
