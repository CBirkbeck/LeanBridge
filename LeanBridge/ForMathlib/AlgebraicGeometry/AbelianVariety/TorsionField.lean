import LeanBridge.ForMathlib.AlgebraicGeometry.AbelianVariety.GaloisRepresentation
import Mathlib.FieldTheory.Galois.Infinite

/-!
# The torsion fields of an abelian variety

The `m`-torsion field `K(A[m])` of an abelian variety `A` over a field `K` is the smallest extension
of `K` in a separable closure `Kˢ` over which the `m`-torsion `A[m] = A(Kˢ)[m]` of the points of `A`
is rational: the fixed field of the kernel of the mod-`m` Galois representation `G_K → Aut(A[m])`
of `A`. It is a Galois extension of `K`, as this kernel is a closed normal subgroup of the absolute
Galois group `G_K = Gal(Kˢ / K)`. For `m = 2` it is the 2-torsion field (LMFDB
`g2c.two_torsion_field`), in particular that of the Jacobian of a genus 2 curve.

For the Jacobian of a hyperelliptic curve `y² = f(x)`, the 2-torsion field is the splitting field
of `f`, since `A[2]` is generated by the classes of the differences of the Weierstrass points; this
is not formalised, as Jacobians are only characterised here by their functor of points
(`TauCeti.AlgebraicGeometry.AbelianVariety.IsJacobian`). The LMFDB displays the 2-torsion field of
an abelian variety over a number field by a number field of minimal degree and absolute
discriminant with the same Galois closure, a data convention.

## Main definitions

* `TauCeti.AlgebraicGeometry.AbelianVariety.torsionField` (LMFDB `g2c.two_torsion_field` for
  `m = 2`): the `m`-torsion field.

## Main results

* `TauCeti.AlgebraicGeometry.AbelianVariety.torsionField_le_iff`: the `m`-torsion field is the
  smallest intermediate field `L` of `Kˢ / K` such that `Gal(Kˢ / L)` fixes every point of `A[m]`.
* `TauCeti.AlgebraicGeometry.AbelianVariety.isGalois_torsionField`: the `m`-torsion field is a
  Galois extension of `K`.
* `TauCeti.AlgebraicGeometry.AbelianVariety.finiteDimensional_torsionField`: the `m`-torsion field
  is a finite extension of `K` when `A[m]` is finite.
-/

open IntermediateField

universe u

namespace TauCeti.AlgebraicGeometry.AbelianVariety

variable {K : Type u} [Field K] (A : AbelianVariety K) (m : ℕ)

/-- The **`m`-torsion field** `K(A[m])` of an abelian variety `A` over `K` (LMFDB
`g2c.two_torsion_field` for `m = 2`): the fixed field in the separable closure `Kˢ` of the kernel of
the mod-`m` Galois representation of `A` (`TauCeti.AlgebraicGeometry.AbelianVariety.torsionRep`),
the subgroup of `G_K = Gal(Kˢ / K)` fixing every point of `A[m] = A(Kˢ)[m]`. It is the smallest
intermediate field of `Kˢ / K` over which `A[m]` is rational
(`TauCeti.AlgebraicGeometry.AbelianVariety.torsionField_le_iff`), and a Galois extension of `K`
(`TauCeti.AlgebraicGeometry.AbelianVariety.isGalois_torsionField`), as the knowl states. The points
are taken over `Kˢ`: when the characteristic of `K` divides `m`, some points of `A[m]` over an
algebraic closure may only be defined over inseparable extensions, and the knowl's Galois extension
is this one. -/
noncomputable def torsionField : IntermediateField K (SeparableClosure K) :=
  fixedField (A.torsionRep m).ker

lemma mem_ker_torsionRep_iff (σ : AbsoluteGaloisGroup K) :
    σ ∈ (A.torsionRep m).ker ↔ ∀ x : A.TorsionCoeff K m, σ • x = x := by
  rw [MonoidHom.mem_ker, LinearMap.ext_iff]
  rfl

lemma coe_ker_torsionRep : ((A.torsionRep m).ker : Set (AbsoluteGaloisGroup K)) =
    ⋂ x : A.TorsionCoeff K m, (MulAction.stabilizer (AbsoluteGaloisGroup K) x : Set _) := by
  ext σ
  simp only [SetLike.mem_coe, mem_ker_torsionRep_iff, Set.mem_iInter, MulAction.mem_stabilizer_iff]

lemma isClosed_ker_torsionRep : IsClosed ((A.torsionRep m).ker : Set (AbsoluteGaloisGroup K)) := by
  rw [coe_ker_torsionRep]
  exact isClosed_iInter fun x ↦ Subgroup.isClosed_of_isOpen _ (stabilizer_isOpen _ x)

/-- **The `m`-torsion field is the smallest extension over which `A[m]` is rational**: an
intermediate field `L` of `Kˢ / K` contains the `m`-torsion field of `A` exactly when every point of
`A[m] = A(Kˢ)[m]` is fixed by `Gal(Kˢ / L)`. -/
lemma torsionField_le_iff (L : IntermediateField K (SeparableClosure K)) :
    A.torsionField m ≤ L ↔ ∀ σ ∈ L.fixingSubgroup, ∀ x : A.TorsionCoeff K m, σ • x = x := by
  refine ⟨fun hL σ hσ ↦ ?_, fun h ↦ ?_⟩
  · have hσ' : σ ∈ (A.torsionField m).fixingSubgroup := fixingSubgroup_le hL hσ
    rw [torsionField, InfiniteGalois.fixingSubgroup_fixedField ⟨_, A.isClosed_ker_torsionRep m⟩]
      at hσ'
    exact (A.mem_ker_torsionRep_iff m σ).mp hσ'
  · rw [← InfiniteGalois.fixedField_fixingSubgroup L]
    exact fixedField_le fun σ hσ ↦ (A.mem_ker_torsionRep_iff m σ).mpr (h σ hσ)

/-- **The `m`-torsion field is a Galois extension** of `K`: it is the fixed field of a closed normal
subgroup of `G_K`, the kernel of the mod-`m` Galois representation. -/
lemma isGalois_torsionField : IsGalois K (A.torsionField m) := by
  rw [← InfiniteGalois.normal_iff_isGalois, torsionField,
    InfiniteGalois.fixingSubgroup_fixedField ⟨_, A.isClosed_ker_torsionRep m⟩]
  exact (A.torsionRep m).normal_ker

/-- **The `m`-torsion field is a finite extension** of `K` when `A[m]` is finite, as it is for every
`m ≠ 0`, the kernel of multiplication by `m` being a finite group scheme (not formalised here): the
kernel of the mod-`m` Galois representation is then an open subgroup of `G_K`, the intersection of
the finitely many open stabilisers of the points of `A[m]`. -/
lemma finiteDimensional_torsionField [Finite (A.TorsionCoeff K m)] :
    FiniteDimensional K (A.torsionField m) := by
  have h : IsOpen ((A.torsionRep m).ker : Set (AbsoluteGaloisGroup K)) := by
    rw [coe_ker_torsionRep]
    exact isOpen_iInter_of_finite (stabilizer_isOpen _)
  rw [← InfiniteGalois.isOpen_iff_finite, torsionField,
    InfiniteGalois.fixingSubgroup_fixedField ⟨_, A.isClosed_ker_torsionRep m⟩]
  exact h

end TauCeti.AlgebraicGeometry.AbelianVariety
